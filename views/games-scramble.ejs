<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        .status-bar { height: env(safe-area-inset-top, 0px); }
        .page-content { padding: 0 1rem 1.75rem; max-width: 560px; margin: 0 auto; }

        .game-layout { display: grid; grid-template-columns: 1fr; grid-template-areas: "stats" "main" "side"; }
        .layout-stats { grid-area: stats; min-width: 0; }
        .game-main { grid-area: main; min-width: 0; }
        .game-side { grid-area: side; min-width: 0; }
        @media (min-width: 980px) {
            .page-content { max-width: 1020px; }
            .game-layout { grid-template-columns: minmax(0, 1fr) 350px; grid-template-areas: "stats stats" "main side"; column-gap: 1.4rem; }
            .game-main { max-width: 560px; margin: 0 auto; width: 100%; }
            .game-side .panel { margin-top: 0; }
        }

        .game-top { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; margin: 0.4rem 0 0.8rem; }
        .game-title { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.02em; }
        .game-title span { display: block; font-size: 0.66rem; font-weight: 600; color: var(--text-muted); letter-spacing: 0; margin-top: 1px; }
        .time-badge {
            display: flex; align-items: center; gap: 6px;
            background: var(--surface-solid); border: 1px solid var(--border-solid);
            padding: 7px 12px; border-radius: 999px; font-size: 0.78rem; font-weight: 800;
            color: var(--text-primary);
        }
        .time-badge.warn { color: var(--danger); border-color: var(--danger); background: var(--danger-soft); animation: pulse 1s infinite; }
        @keyframes pulse { 50% { transform: scale(1.04); } }

        .stat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin-bottom: 0.8rem; }
        .stat-box { background: var(--surface-solid); border: 1px solid var(--border-solid); border-radius: 13px; padding: 0.5rem 0.3rem; text-align: center; }
        .stat-box b { display: block; font-size: 1.05rem; font-weight: 800; line-height: 1.1; color: var(--text-primary); }
        .stat-box span { display: block; font-size: 0.53rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-muted); font-weight: 700; margin-top: 2px; }
        #statScore { color: var(--brand); }
        #statStreak { color: var(--warning); }

        .scramble-card {
            position: relative; overflow: hidden;
            background: linear-gradient(140deg, #064e3b 0%, #047857 55%, #10b981 100%);
            border-radius: var(--radius-xl);
            padding: 1.25rem 1rem;
            color: #fff;
            box-shadow: 0 16px 40px rgba(5, 150, 105, 0.3);
            text-align: center;
        }
        .scramble-card::before {
            content: ''; position: absolute; width: 180px; height: 180px; border-radius: 50%;
            right: -60px; top: -80px; background: rgba(255, 255, 255, 0.12);
        }
        .word-tiles { display: flex; flex-wrap: wrap; gap: 5px; justify-content: center; min-height: 50px; position: relative; z-index: 1; }
        .tile {
            width: 38px; height: 44px; display: grid; place-items: center;
            border-radius: 10px; background: rgba(255, 255, 255, 0.17);
            border: 1px solid rgba(255, 255, 255, 0.24);
            font-size: 1.15rem; font-weight: 800; text-transform: uppercase;
            animation: tileIn 0.3s var(--ease-spring) both;
        }
        @keyframes tileIn { from { opacity: 0; transform: translateY(8px) scale(0.8); } }
        .hint-text { margin-top: 0.8rem; font-size: 0.72rem; opacity: 0.9; min-height: 1.1em; position: relative; z-index: 1; }
        .word-progress { margin-top: 0.35rem; font-size: 0.6rem; opacity: 0.72; text-transform: uppercase; letter-spacing: 0.08em; position: relative; z-index: 1; }

        .answer-row { display: flex; gap: 6px; margin-top: 0.85rem; }
        #scrambleInput {
            flex: 1; min-width: 0;
            border: 1.5px solid var(--border-solid);
            background: var(--surface-solid);
            color: var(--text-primary);
            font-family: inherit; font-size: 1rem; font-weight: 800;
            letter-spacing: 0.08em; text-transform: uppercase;
            padding: 0.8rem 0.9rem; border-radius: 12px; outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        #scrambleInput:focus { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-light); }
        #submitBtn {
            border: none; border-radius: 12px; padding: 0 1.1rem;
            background: var(--brand-gradient); color: #fff; font-family: inherit;
            font-weight: 800; font-size: 0.78rem; cursor: pointer;
            transition: transform 0.12s;
        }
        #submitBtn:active { transform: scale(0.95); }

        .action-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; margin-top: 0.6rem; }
        .act-btn {
            border: 1px solid var(--border-solid); border-radius: 11px;
            padding: 0.68rem 0.4rem; font-family: inherit; font-size: 0.68rem;
            font-weight: 800; cursor: pointer; display: flex; align-items: center;
            justify-content: center; gap: 5px; background: var(--surface-solid); color: var(--text-secondary);
            transition: transform 0.12s;
        }
        .act-btn:active { transform: scale(0.96); }
        .act-btn.hint { background: var(--warning-soft); color: var(--warning); border-color: transparent; }
        .act-btn.skip { background: var(--danger-soft); color: var(--danger); border-color: transparent; }
        .act-btn.new { background: var(--brand-gradient); color: #fff; border-color: transparent; }

        .panel { margin-top: 1rem; background: var(--surface-solid); border: 1px solid var(--border-solid); border-radius: var(--radius-lg); overflow: hidden; }
        .panel-head { display: flex; align-items: center; justify-content: space-between; padding: 0.7rem 0.85rem; border-bottom: 1px solid var(--border); font-size: 0.78rem; font-weight: 800; }
        .panel-head i { color: var(--brand); margin-right: 5px; }
        .panel-head small { font-size: 0.6rem; color: var(--text-muted); font-weight: 600; }
        .hist-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.85rem; border-bottom: 1px solid var(--border); font-size: 0.7rem; }
        .hist-row:last-child { border-bottom: none; }
        .hist-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); flex: 0 0 7px; }
        .hist-main { flex: 1; color: var(--text-secondary); font-weight: 600; }
        .hist-score { font-weight: 800; color: var(--brand); }
        .empty-hist { padding: 1.1rem 0.85rem; text-align: center; font-size: 0.72rem; color: var(--text-muted); }
        @media (min-width: 431px) { .app-shell { border-left: 1px solid var(--glass-border); border-right: 1px solid var(--glass-border); margin: 0 auto; } }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="status-bar"></div>
    <div class="header-nav">
        <a href="/games" class="back-circle"><i class="fas fa-arrow-left"></i></a>
        <div class="header-title">Word Scramble</div>
    </div>
    <div class="page-content">
        <div class="game-top">
            <div class="game-title">Word Scramble<span>Unscramble academic terms</span></div>
            <div class="time-badge" id="timeBadge"><i class="fas fa-stopwatch"></i><span id="sCrTime">60</span>s</div>
        </div>

        <div class="game-layout">
            <div class="layout-stats">
                <div class="stat-grid">
                    <div class="stat-box"><b id="statBest">0</b><span>Best</span></div>
                    <div class="stat-box"><b id="statPlays">0</b><span>Played</span></div>
                    <div class="stat-box"><b id="statScore">0</b><span>Score</span></div>
                </div>
            </div>

            <div class="game-main">
                <div class="scramble-card">
                    <div class="word-tiles" id="scrambleWord"></div>
                    <div class="hint-text" id="hint">Tap Start when you are ready.</div>
                    <div class="word-progress" id="wordProgress">0 solved · streak 0</div>
                </div>

                <div class="answer-row">
                    <input id="scrambleInput" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="Type the word…" disabled>
                    <button id="submitBtn">Check</button>
                </div>
                <div class="action-row">
                    <button class="act-btn hint" id="hintBtn"><i class="fas fa-lightbulb"></i> Hint</button>
                    <button class="act-btn skip" id="skipBtn"><i class="fas fa-forward"></i> Skip</button>
                    <button class="act-btn new" id="newBtn"><i class="fas fa-play"></i> Start</button>
                </div>
            </div>

            <aside class="game-side">
                <div class="panel">
                    <div class="panel-head"><span><i class="fas fa-clock-rotate-left"></i>Recent games</span><small id="histCount"></small></div>
                    <div id="historyList"><div class="empty-hist">Loading…</div></div>
                </div>
            </aside>
        </div>
    </div>
    <%- include('partials/bottom-nav', { activeNav: 'study' }) %>
</div>

<script>
(function () {
    'use strict';
    var WORDS = [
        { w: 'CALCULUS', h: 'Maths branch with derivatives and integrals' },
        { w: 'PHOTOSYNTHESIS', h: 'How plants make food from light' },
        { w: 'MITOCHONDRIA', h: 'The powerhouse of the cell' },
        { w: 'NEURON', h: 'Basic signalling cell of the brain' },
        { w: 'RELATIVITY', h: "Einstein's famous theory" },
        { w: 'GRAVITY', h: 'Force that pulls objects together' },
        { w: 'OSMOSIS', h: 'Water movement across a membrane' },
        { w: 'ENZYME', h: 'Protein that speeds up reactions' },
        { w: 'PROTON', h: 'Positively charged particle in a nucleus' },
        { w: 'MITOSIS', h: 'Cell division producing identical cells' },
        { w: 'TECTONIC', h: 'Relating to the plates of the Earth' },
        { w: 'ALGORITHM', h: 'Step-by-step problem-solving procedure' },
        { w: 'VARIABLE', h: 'A symbol that represents a value' },
        { w: 'MOLECULE', h: 'Two or more atoms chemically bonded' },
        { w: 'ENERGY', h: 'The capacity to do work' },
        { w: 'THEOREM', h: 'A proven mathematical statement' },
        { w: 'LOGIC', h: 'Correct reasoning, step by step' },
        { w: 'BOND', h: 'A chemical link between atoms' },
        { w: 'QUADRATIC', h: 'An equation of degree two' },
        { w: 'DERIVATIVE', h: 'Rate of change in calculus' },
        { w: 'INTEGRAL', h: 'Area under a curve in calculus' },
        { w: 'CORROSION', h: 'Rusting of metals over time' },
        { w: 'PHOTON', h: 'A particle of light' },
        { w: 'GENETICS', h: 'Study of heredity and genes' },
        { w: 'VELOCITY', h: 'Speed in a given direction' },
        { w: 'DENSITY', h: 'Mass per unit volume' },
        { w: 'CATALYST', h: 'Speeds up a reaction without being used up' },
        { w: 'ELECTRON', h: 'Negatively charged particle' },
        { w: 'CHROMOSOME', h: 'Thread-like structure carrying genes' },
        { w: 'PHYSICS', h: 'Study of matter, energy and forces' }
    ];
    var DURATION = 60;
    var BASE_HINT_COST = 4;

    var pool = [], current = null, used = [];
    var score = 0, streak = 0, bestStreak = 0, solved = 0, skipped = 0, hintsUsed = 0;
    var timeLeft = DURATION, timer = null, playing = false, wordStarted = 0;
    var hintShown = false;

    var input = document.getElementById('scrambleInput');
    var wordEl = document.getElementById('scrambleWord');
    var hintEl = document.getElementById('hint');
    var timeEl = document.getElementById('sCrTime');
    var timeBadge = document.getElementById('timeBadge');
    var progressEl = document.getElementById('wordProgress');

    function shuffleWord(w) {
        var arr = w.split('');
        for (var i = arr.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
        }
        var out = arr.join('');
        if (out === w && w.length > 1) return shuffleWord(w);
        return out;
    }

    function renderTiles(word) {
        wordEl.innerHTML = word.split('').map(function (ch, i) {
            return '<div class="tile" style="animation-delay:' + (i * 0.035) + 's">' + ch + '</div>';
        }).join('');
    }

    function nextWord() {
        if (!pool.length) pool = WORDS.slice();
        var idx = Math.floor(Math.random() * pool.length);
        current = pool.splice(idx, 1)[0];
        used.push(current.w);
        hintShown = false;
        wordStarted = Date.now();
        renderTiles(shuffleWord(current.w));
        hintEl.textContent = 'Hint: ' + current.h;
        input.value = '';
        input.disabled = false;
        input.focus();
        updateProgress();
    }

    function updateProgress() {
        document.getElementById('statScore').textContent = score;
        progressEl.textContent = solved + ' solved · streak ' + streak + ' · ' + skipped + ' skipped';
    }

    function fmtTime(s) { return s >= 0 ? String(s) : '0'; }

    function tick() {
        if (!playing) return;
        timeLeft--;
        timeEl.textContent = fmtTime(timeLeft);
        timeBadge.classList.toggle('warn', timeLeft <= 10);
        if (timeLeft <= 0) endGame();
    }

    function startGame() {
        clearInterval(timer);
        pool = WORDS.slice();
        score = 0; streak = 0; bestStreak = 0; solved = 0; skipped = 0; hintsUsed = 0;
        timeLeft = DURATION;
        playing = true;
        timeEl.textContent = timeLeft;
        timeBadge.classList.remove('warn');
        document.getElementById('statScore').textContent = '0';
        updateProgress();
        nextWord();
        timer = setInterval(tick, 1000);
        document.getElementById('newBtn').innerHTML = '<i class="fas fa-rotate"></i> Restart';
    }

    function checkAnswer() {
        if (!playing || !current) return;
        var val = input.value.trim().toUpperCase().replace(/[^A-Z]/g, '');
        if (!val) return;
        if (val === current.w) {
            var elapsed = Math.floor((Date.now() - wordStarted) / 1000);
            var pts = Math.max(5, 25 - elapsed * 2) + streak * 2 + (hintShown ? 0 : 5);
            score += pts;
            solved++;
            streak++;
            bestStreak = Math.max(bestStreak, streak);
            input.value = '';
            updateProgress();
            showToast('+' + pts + ' points!', 'success');
            setTimeout(function () { if (playing) nextWord(); }, 220);
        } else {
            streak = 0;
            input.classList.add('shake');
            setTimeout(function () { input.classList.remove('shake'); }, 320);
            updateProgress();
        }
    }

    function hint() {
        if (!playing || !current) return;
        hintShown = true;
        hintsUsed++;
        score = Math.max(0, score - BASE_HINT_COST);
        var remaining = current.w.slice(0, Math.min(3, current.w.length));
        input.value = remaining;
        input.focus();
        input.setSelectionRange(remaining.length, remaining.length);
        hintEl.textContent = 'Starts with "' + remaining + '" · -' + BASE_HINT_COST + ' pts';
        updateProgress();
    }

    function skip() {
        if (!playing || !current) return;
        skipped++;
        streak = 0;
        timeLeft = Math.max(1, timeLeft - 5);
        timeEl.textContent = timeLeft;
        nextWord();
    }

    function showToast(text, icon) {
        if (window.Swal) {
            Swal.fire({ toast: true, position: 'top-end', icon: icon || 'success', title: text, showConfirmButton: false, timer: 900, timerProgressBar: true });
        }
    }

    function endGame() {
        if (!playing) return;
        playing = false;
        clearInterval(timer);
        input.disabled = true;
        timeEl.textContent = '0';
        document.getElementById('newBtn').innerHTML = '<i class="fas fa-play"></i> Play again';
        saveResult(score, function () {
            Swal.fire({
                icon: score > 0 ? 'success' : 'info',
                title: "Time's up!",
                html: '<div style="font-size:0.9rem;line-height:1.8">' +
                      '<b style="font-size:1.8rem;color:var(--brand)">' + score + '</b> points<br>' +
                      solved + ' words solved · best streak ' + bestStreak +
                      '</div>',
                confirmButtonText: 'Play again',
                confirmButtonColor: '#047857',
                showCancelButton: true,
                cancelButtonText: 'Games hub'
            }).then(function (res) {
                if (res.isConfirmed) startGame();
                else window.location.href = '/games';
            });
        });
    }

    function saveResult(finalScore, cb) {
        fetch('/api/games/result', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                game: 'scramble', score: finalScore, outcome: 'completed', duration: DURATION,
                metadata: { solved: solved, skipped: skipped, bestStreak: bestStreak, hints: hintsUsed }
            })
        }).then(function () { loadStats(); }).catch(function () {}).finally(function () { if (cb) cb(); });
    }

    function loadStats() {
        fetch('/api/games/stats', { headers: { Accept: 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
            .then(function (data) {
                var s = (data.stats || []).find(function (x) { return x.game === 'scramble'; }) || { plays: 0, best_score: 0 };
                document.getElementById('statBest').textContent = s.best_score || 0;
                document.getElementById('statPlays').textContent = s.plays || 0;

                var recent = (data.recent || []).filter(function (r) { return r.game === 'scramble'; }).slice(0, 6);
                var list = document.getElementById('historyList');
                document.getElementById('histCount').textContent = recent.length ? recent.length + ' recent' : '';
                if (!recent.length) {
                    list.innerHTML = '<div class="empty-hist">No games yet. Start playing to build your history.</div>';
                    return;
                }
                list.innerHTML = recent.map(function (r) {
                    var m = r.metadata || {};
                    var when = new Date(r.created_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
                    return '<div class="hist-row"><span class="hist-dot"></span>' +
                        '<div class="hist-main">' + (m.solved || 0) + ' solved · streak ' + (m.bestStreak || 0) + ' · ' + when + '</div>' +
                        '<span class="hist-score">' + Number(r.score || 0) + '</span></div>';
                }).join('');
            })
            .catch(function () {
                document.getElementById('historyList').innerHTML = '<div class="empty-hist">Could not load history.</div>';
            });
    }

    document.getElementById('submitBtn').addEventListener('click', checkAnswer);
    input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); checkAnswer(); }
    });
    document.getElementById('hintBtn').addEventListener('click', hint);
    document.getElementById('skipBtn').addEventListener('click', skip);
    document.getElementById('newBtn').addEventListener('click', startGame);

    var style = document.createElement('style');
    style.textContent = '@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-5px)}75%{transform:translateX(5px)}} .shake{animation:shake .3s ease}';
    document.head.appendChild(style);

    loadStats();
})();
</script>
</body>
</html>
