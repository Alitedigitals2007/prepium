<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        :root { 
            --sub: var(--text-secondary); 
        }
        
        .app-shell { 
            box-shadow: 0 0 60px rgba(0,0,0,0.05);
            padding-bottom: 110px;
        }

        .header-main { 
            padding: 2.5rem 1.5rem 1.5rem;
            background: linear-gradient(180deg, var(--brand-soft) 0%, var(--surface-solid) 100%);
            border-bottom: 1px solid var(--bg);
        }
        .user-profile { display: flex; align-items: center; justify-content: space-between; }
        .profile-left { display: flex; align-items: center; gap: 15px; }
        .avatar-circle { 
            width: 52px; height: 52px; 
            background: var(--bg); color: var(--brand); border: 2px solid var(--border-solid);
            border-radius: 18px; display: flex; align-items: center; justify-content: center; 
            font-weight: 800; font-size: 1.3rem;
        }
        
        .welcome-msg h1 { margin: 0; font-size: 1.35rem; font-weight: 800; letter-spacing: -0.5px; }
        .brand-subtitle { font-size: 0.72rem; font-weight: 700; color: var(--brand); text-transform: uppercase; margin-top: 3px; display: block; }

        /* Actions Block */
        .action-row {
            display: flex;
            gap: 12px;
            padding: 1.5rem;
        }
        .btn-action {
            flex: 1;
            padding: 12px;
            border-radius: 16px;
            font-size: 0.85rem;
            font-weight: 800;
            border: none;
            cursor: pointer;
            text-align: center;
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .btn-add { background: var(--brand); color: white; }
        .btn-extract { background: var(--warning-soft); color: var(--warning); }
        .btn-print { background: var(--brand-soft); color: var(--brand); }

        /* Modal Overlay for inputting dynamic schedules */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.6);
            z-index: 2000;
            display: none;
            align-items: flex-end;
            justify-content: center;
        }
        .modal-body {
            background: var(--surface-solid);
            width: 100%;
            max-width: 430px;
            border-top-left-radius: 32px;
            border-top-right-radius: 32px;
            padding: 2rem 1.5rem;
            box-sizing: border-box;
            transform: translateY(100%);
            transition: transform 0.3s ease-out;
        }
        .modal-overlay.open { display: flex; }
        .modal-overlay.open .modal-body { transform: translateY(0); }


        .form-input { 
            width: 100%; padding: 14px; border-radius: 14px; border: 1px solid var(--border-solid); 
            font-size: 0.9rem; font-family: inherit; font-weight: 600;
        }
        .modal-actions { display: flex; gap: 12px; margin-top: 1.5rem; }

        /* Timetable Listing */
        .timetable-content { padding: 0 1.5rem; }
        .day-group { margin-bottom: 1.5rem; }
        .day-label { font-size: 1rem; font-weight: 800; color: var(--text); margin-bottom: 12px; display: block; }
        
        .time-slot {
            background: var(--surface-solid)fff;
            border: 1px solid var(--bg);
            padding: 1.2rem;
            border-radius: 22px;
            margin-bottom: 12px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.01);
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .slot-hour {
            font-size: 0.78rem; font-weight: 800; color: var(--brand);
            background: var(--brand-soft); padding: 6px 12px; border-radius: 12px; white-space: nowrap;
        }
        .slot-info { flex: 1; }
        .slot-info b { font-size: 0.92rem; font-weight: 800; color: var(--text); display: block; }
        .slot-info p { font-size: 0.72rem; color: var(--sub); margin: 3px 0 0; font-weight: 600; }

        /* Extracted Course Edit Cards */
        .extracted-card {
            background: var(--surface); border-radius: 16px; padding: 14px; margin-bottom: 10px;
            border: 1px solid var(--border-solid); position: relative; display: flex; gap: 10px; align-items: flex-start;
        }
        .extracted-fields { flex: 1; min-width: 0; }
        .ef-row { display: flex; gap: 8px; margin-bottom: 6px; }
        .ef-group { display: flex; flex-direction: column; gap: 2px; }
        .ef-group label { font-size: 0.6rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; }
        .ef-input {
            width: 100%; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border-solid);
            font-size: 0.78rem; font-family: inherit; font-weight: 600; background: var(--surface-solid);
            box-sizing: border-box; transition: border-color 0.2s;
        }
        .ef-input:focus { outline: none; border-color: var(--brand); }
        .ef-remove {
            background: var(--danger-soft); border: 1px solid #fecaca; color: var(--danger);
            width: 36px; height: 36px; border-radius: 10px; cursor: pointer;
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
            transition: 0.2s;
        }
        .ef-remove:active { transform: scale(0.9); }

        /* Today's Schedule Box */
        .today-box {
            margin: 0 1.5rem 1rem;
            background: linear-gradient(135deg, var(--text-primary) 0%, #1e293b 100%);
            border-radius: 24px;
            padding: 18px 20px;
            color: white;
            box-shadow: 0 8px 32px rgba(15,23,42,0.2);
        }
        .today-box .today-date { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; opacity: 0.6; }
        .today-box .today-day { font-size: 1.35rem; font-weight: 800; margin: 2px 0 4px; }
        .today-box .today-status { font-size: 0.82rem; font-weight: 600; opacity: 0.85; display: flex; align-items: center; gap: 8px; }
        .today-box .today-status .live-dot {
            width: 8px; height: 8px; border-radius: 50%; background: #22c55e;
            display: inline-block; animation: pulse-dot 1.5s ease-in-out infinite;
        }
        @keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:0.3} }
        .today-box .today-slot {
            background: rgba(255,255,255,0.1); border-radius: 14px; padding: 12px 14px;
            margin-top: 10px; display: flex; align-items: center; gap: 12px;
            border: 1px solid rgba(255,255,255,0.08);
        }
        .today-box .today-slot .ts-hour {
            font-size: 0.7rem; font-weight: 800; color: var(--text-muted);
            background: rgba(255,255,255,0.06); padding: 4px 10px; border-radius: 8px; white-space: nowrap;
        }
        .today-box .today-slot .ts-name { flex: 1; font-weight: 700; font-size: 0.9rem; }
        .today-box .today-slot .ts-venue { font-size: 0.65rem; opacity: 0.6; font-weight: 600; }
        .today-box .today-slot .ts-live {
            background: #22c55e; color: white; font-size: 0.55rem; font-weight: 800;
            padding: 3px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.5px;
        }
        .today-box .today-empty {
            margin-top: 10px; font-size: 0.78rem; opacity: 0.5; font-weight: 600;
            display: flex; align-items: center; gap: 8px;
        }

        .time-slot.now {
            border-color: var(--brand);
            background: rgba(0, 98, 255, 0.04);
            box-shadow: 0 0 0 1px var(--brand), 0 4px 16px rgba(37,99,235,0.08);
        }
        .time-slot.now .slot-hour {
            background: var(--brand);
            color: white;
        }
        .time-slot.upcoming {
            border-color: var(--warning-soft);
            background: var(--surface-solid)beb;
        }

        /* PDF Preview & Printable Section Header */
        #pdf-preview { padding: 1rem 0; }
        .pdf-brand-head { display: none; text-align: center; border-bottom: 2px dashed var(--border-solid); padding-bottom: 15px; margin-bottom: 20px; }
        .pdf-brand-head h2 { font-size: 1.6rem; font-weight: 800; color: var(--text); margin: 0; letter-spacing: -1px; }
        .pdf-brand-head h2 span { color: var(--brand); }
        .pdf-brand-head p { font-size: 0.8rem; font-weight: 600; color: var(--sub); margin: 4px 0 0; }

    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/sidebar') %>

    <div class="app-shell" id="full-schedule">
        <header class="header-main">
            <div class="user-profile">
                <div class="profile-left">
                    <div class="avatar-circle">
                        <%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div class="welcome-msg">
                        <h1>Day Planner</h1>
                        <span class="brand-subtitle">Prepium Schedule Engine</span>
                    </div>
                </div>
            </div>
        </header>

        <div class="action-row">
            <button class="btn-action btn-add" onclick="openModal()"><i>âž•</i> Add Course</button>
            <button class="btn-action btn-extract" onclick="openExtractModal()">
                <i class="fas fa-magic"></i> AI Extract
            </button>
            <button class="btn-action btn-print" onclick="printTimetable()"><i>ðŸ“¥</i> Download PDF</button>
        </div>

        <div id="todayBox" class="today-box">
            <div class="today-date" id="todayDate"></div>
            <div class="today-day" id="todayDay"></div>
            <div class="today-status" id="todayStatus"><span class="live-dot"></span> Loading schedule...</div>
            <div id="todaySlotContainer"></div>
        </div>

        <div class="timetable-content" id="pdf-preview">
            <div class="pdf-brand-head" id="pdf-header">
                <h2>Prepium<span>.</span></h2>
                <p>Personalized Study & Lecture Timetable</p><button class="btn-action edit-slot" onclick="toggleEdit(event)">Edit</button></button>
            </div>

            <% 
                const weekDays = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']; 
                weekDays.forEach(day => {
                    const daySlots = slots.filter(s => s.day === day);
                    if (daySlots.length > 0) {
            %>
                <div class="day-group">
                    <span class="day-label"><%= day %></span>
                    <% daySlots.forEach(slot => { %>
                        <div class="time-slot">
                            <span class="slot-hour"><%= slot.start_time %></span>
                            <div class="slot-info">
                                <b><%= slot.course %></b>
                                <p>
                                    <% if (slot.course_code) { %><span style="font-weight:700;"><%= slot.course_code %></span> &middot; <% } %>
                                    <%= slot.unit %> Credits
                                    &middot; <i class="fas fa-location-dot" style="font-size:0.6rem;"></i> <%= slot.venue %>
                                    &middot; <%= slot.start_time %>-<%= slot.end_time %>
                                </p><button class="btn-action edit-slot" onclick="toggleEdit(event)">Edit</button></button>
                            </div>
                            <form action="/timetable/delete/<%= slot.id %>" method="POST" style="margin:0;" onsubmit="return confirm('Delete this slot?')">
                                <button type="submit" style="background:none; border:none; color:var(--danger); font-size:1rem; cursor:pointer; padding:4px;"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    <% }); %>
                </div>
            <% }}); %>
            
            <% if (slots.length === 0) { %>
                <p style="text-align: center; color: var(--sub); font-size: 0.85rem; padding: 2rem 0;">Your timetable is empty. Click "+ Add Course" to populate it.</p><button class="btn-action edit-slot" onclick="toggleEdit(event)">Edit</button></button>
            <% } %>
        </div>

        <div class="modal-overlay" id="add-modal" onclick="closeModal(event)">
            <div class="modal-body" onclick="event.stopPropagation()">
                <h3 style="margin-top:0; margin-bottom:1.2rem; font-size:1.15rem; font-weight:800;">Register New Course Slot</h3>
                <form action="/timetable/add" method="POST">
                    <div class="form-group">
                        <label>Course Title</label>
                        <input type="text" name="course" class="form-input" placeholder="e.g. Physics" required>
                    </div>
                    <div class="form-group">
                        <label>Course Code</label>
                        <input type="text" name="course_code" class="form-input" placeholder="e.g. PHY 302">
                    </div>
                    <div class="form-group" style="display:flex; gap:12px;">
                        <div style="flex:1;">
                            <label>Credit Unit</label>
                            <input type="number" name="unit" class="form-input" value="3" min="1" max="6">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Day of the Week</label>
                        <select name="day" class="form-input" required>
                            <option value="Monday">Monday</option>
                            <option value="Tuesday">Tuesday</option>
                            <option value="Wednesday">Wednesday</option>
                            <option value="Thursday">Thursday</option>
                            <option value="Friday">Friday</option>
                            <option value="Saturday">Saturday</option>
                            <option value="Sunday">Sunday</option>
                        </select>
                    </div>
                    <div class="form-group" style="display:flex; gap:12px;">
                        <div style="flex:1;">
                            <label>Start Time</label>
                            <input type="time" name="start_time" class="form-input" required>
                        </div>
                        <div style="flex:1;">
                            <label>End Time</label>
                            <input type="time" name="end_time" class="form-input" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Lecture Venue / Room</label>
                        <input type="text" name="venue" class="form-input" placeholder="e.g. LLT, Faculty of Science" required>
                    </div>
                    
                    <div class="modal-actions">
                        <button type="button" class="btn-action btn-print" onclick="closeModal(null)">Cancel</button>
                        <button type="submit" class="btn-action btn-add">Save Class</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Extract Timetable Modal (with Course Wizard) -->
        <div class="modal-overlay" id="extract-modal" onclick="if(event.target===this)closeExtractModal()">
            <div class="modal-body" onclick="event.stopPropagation()">
                <!-- Step indicator -->
                <div style="display:flex; gap:8px; margin-bottom:1.2rem;">
                    <div id="wizStep1Dot" style="flex:1; height:4px; background:var(--brand); border-radius:4px;"></div>
                    <div id="wizStep2Dot" style="flex:1; height:4px; background:var(--border-solid); border-radius:4px;"></div>
                </div>

                <!-- Step 1: Course Setup Wizard -->
                <div id="wizardStep1">
                    <h3 style="margin-top:0; margin-bottom:0.5rem; font-size:1.15rem; font-weight:800;">Set Up Your Courses</h3>
                    <p style="font-size:0.8rem; color:var(--text-secondary); margin-bottom:1rem;">
                        Add the courses you're taking this semester so the AI can match them accurately.
                    </p><button class="btn-action edit-slot" onclick="toggleEdit(event)">Edit</button></button>

                    <div style="display:flex; gap:8px; margin-bottom:12px;">
                        <input type="text" id="wizCourseName" class="form-input" placeholder="Course name (e.g. Physics)" style="flex:2;">
                        <input type="text" id="wizCourseCode" class="form-input" placeholder="Code (e.g. PHY 302)" style="flex:1;">
                        <input type="number" id="wizCourseUnit" class="form-input" placeholder="Unit" value="3" min="1" max="6" style="flex:0.5;">
                        <button class="btn-action btn-add" onclick="addWizardCourse()" style="flex:0; padding:12px 16px;">+</button>
                    </div>

                    <div id="wizardCourseList" style="max-height:180px; overflow-y:auto; margin-bottom:1rem;">
<p style="font-size:0.8rem; color:var(--text-secondary); text-align:center; padding:1rem;" id="wizEmptyMsg">No courses added yet. Add at least one course above.</p><button class="btn-action edit-slot" onclick="toggleEdit(event)">Edit</button></button>
                    </div>

                    <div class="modal-actions">
                        <button type="button" class="btn-action btn-print" onclick="closeExtractModal()">Cancel</button>
                        <button class="btn-action btn-add" onclick="wizardNextStep()" id="wizNextBtn" disabled>Continue to Upload</button>
                    </div>
                </div>

                <!-- Step 2: Upload & Extract -->
                <div id="wizardStep2" style="display:none;">
                    <h3 style="margin-top:0; margin-bottom:0.5rem; font-size:1.15rem; font-weight:800;">AI Timetable Extraction</h3>
                    <p style="font-size:0.8rem; color:var(--text-secondary); margin-bottom:0.5rem;">
                        Upload your timetable file. The AI will use your <strong id="wizCourseCount">0</strong> courses for accurate matching.
                    </p><button class="btn-action edit-slot" onclick="toggleEdit(event)">Edit</button></button>
                    <p style="font-size:0.72rem; color:var(--text-muted); margin-bottom:1rem;">
                        <span id="wizCourseTags" style="display:flex; gap:4px; flex-wrap:wrap;"></span>
                    </p><button class="btn-action edit-slot" onclick="toggleEdit(event)">Edit</button></button>

                    <div style="border:2px dashed var(--border-solid); border-radius:16px; padding:2rem; text-align:center; margin-bottom:1rem; background:var(--surface);" id="dropZone">
                        <i class="fas fa-cloud-upload-alt" style="font-size:2rem; color:var(--text-muted); display:block; margin-bottom:0.5rem;"></i>
                        <p style="font-size:0.85rem; color:var(--text-secondary); margin:0;">Drop your timetable file here</p><button class="btn-action edit-slot" onclick="toggleEdit(event)">Edit</button></button>
                        <p style="font-size:0.72rem; color:var(--text-muted); margin:4px 0 12px;">or click to browse (JPG, PNG, PDF, DOC)</p><button class="btn-action edit-slot" onclick="toggleEdit(event)">Edit</button></button>
                        <input type="file" id="fileInput" accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx,.txt" style="display:none;" onchange="uploadForExtraction(this.files[0])">
                        <button class="btn-action btn-extract" onclick="document.getElementById('fileInput').click()" style="display:inline-flex; width:auto; padding:10px 24px;">
                            <i class="fas fa-folder-open"></i> Browse Files
                        </button>
                    </div>
                    <div id="extractStatus" style="display:none; padding:1rem; text-align:center; color:var(--text-secondary);">
                        <i class="fas fa-spinner fa-spin" style="font-size:1.5rem; display:block; margin-bottom:0.5rem;"></i>
                        <span id="extractStatusText">Processing with AI...</span>
                    </div>
                    <div id="extractedCourses" style="display:none; margin-bottom:1rem;">
                        <p style="font-size:0.85rem; font-weight:700; margin-bottom:0.5rem;">Extracted Courses (<span id="extractedCount">0</span>)</p><button class="btn-action edit-slot" onclick="toggleEdit(event)">Edit</button></button>
                        <div id="extractedList" style="max-height:300px; overflow-y:auto;"></div>
                        <div class="modal-actions" style="margin-top:1rem; flex-direction:column; gap:8px;">
                            <button class="btn-action btn-add" onclick="saveExtractedCourses()" style="width:100%;"><i class="fas fa-check"></i> Save All to Timetable</button>
                            <div style="display:flex; gap:8px;">
                                <button type="button" class="btn-action btn-print" onclick="closeExtractModal()" style="flex:1;">Cancel</button>
                                <button class="btn-action btn-extract" onclick="retryExtraction()" style="flex:1;"><i class="fas fa-redo"></i> Retry</button>
                            </div>
                        </div>
                    </div>

                    <div style="text-align:center; margin-top:0.5rem;">
                        <button class="btn-action btn-print" onclick="wizardPrevStep()" style="display:inline-flex; width:auto; padding:8px 16px; font-size:0.75rem;">
                            <i class="fas fa-arrow-left"></i> Back to Courses
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <%- include('partials/bottom-nav', { activeNav: 'dashboard' }) %>
    </div>

    <script>
        function openModal() {
            const modal = document.getElementById('add-modal');
            modal.classList.add('open');
        }

        function closeModal(e) {
            if (!e || e.target === document.getElementById('add-modal')) {
                document.getElementById('add-modal').classList.remove('open');
            }
        }

        function printTimetable() {
            const element = document.getElementById('pdf-preview');
            const pdfHeader = document.getElementById('pdf-header');
            
            // Show print-only header
            pdfHeader.style.display = 'block';

            const opt = {
                margin:       10,
                filename:     'Prepium_Timetable.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(element).save().then(() => {
                pdfHeader.style.display = 'none';
            });
        }

        // ===== COURSE WIZARD + AI EXTRACTION =====
        let extractedCourses = [];
        let wizardCourses = [];

        function openExtractModal() {
            document.getElementById('extract-modal').classList.add('open');
            document.getElementById('extractedCourses').style.display = 'none';
            document.getElementById('extractStatus').style.display = 'none';
            document.getElementById('wizardStep1').style.display = 'block';
            document.getElementById('wizardStep2').style.display = 'none';
            document.getElementById('wizStep1Dot').style.background = 'var(--brand)';
            document.getElementById('wizStep2Dot').style.background = 'var(--border)';
            extractedCourses = [];
            wizardCourses = [];
            renderWizardCourses();
            document.getElementById('wizNextBtn').disabled = true;
        }

        function closeExtractModal() {
            document.getElementById('extract-modal').classList.remove('open');
        }

        // â”€â”€â”€ Wizard Step 1: Course Management â”€â”€â”€
        function addWizardCourse() {
            const name = document.getElementById('wizCourseName').value.trim();
            const code = document.getElementById('wizCourseCode').value.trim();
            const unit = parseInt(document.getElementById('wizCourseUnit').value) || 3;
            if (!name) { alert('Enter a course name'); return; }
            wizardCourses.push({ course_name: name, course_code: code, unit: unit });
            document.getElementById('wizCourseName').value = '';
            document.getElementById('wizCourseCode').value = '';
            document.getElementById('wizCourseUnit').value = '3';
            renderWizardCourses();
        }

        function removeWizardCourse(index) {
            wizardCourses.splice(index, 1);
            renderWizardCourses();
        }

        function renderWizardCourses() {
            const list = document.getElementById('wizardCourseList');
            const empty = document.getElementById('wizEmptyMsg');
            const nextBtn = document.getElementById('wizNextBtn');
            if (wizardCourses.length === 0) {
                list.innerHTML = '<p style="font-size:0.8rem; color:#94a3b8; text-align:center; padding:1rem;" id="wizEmptyMsg">No courses added yet. Add at least one course above.</p><button class="btn-action edit-slot" onclick="toggleEdit(event)">Edit</button></button>';
                nextBtn.disabled = true;
            } else {
                list.innerHTML = wizardCourses.map((c, i) => `
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 12px; background:var(--surface); border-radius:12px; margin-bottom:6px; border:1px solid var(--border);">
                        <div>
                            <strong style="font-size:0.85rem;">${c.course_name}</strong>
                            <span style="font-size:0.72rem; color:var(--text-secondary); margin-left:6px;">${c.course_code} &middot; ${c.unit} Credits</span>
                        </div>
                        <button onclick="removeWizardCourse(${i})" style="background:none; border:none; color:var(--danger); cursor:pointer; padding:4px 8px;"><i class="fas fa-times"></i></button>
                    </div>
                `).join('');
                nextBtn.disabled = false;
            }
        }

        // â”€â”€â”€ Wizard Step Navigation â”€â”€â”€
        function wizardNextStep() {
            if (wizardCourses.length === 0) { alert('Add at least one course first.'); return; }
            // Save courses to backend for persistence
            fetch('/api/user-courses/bulk', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ courses: wizardCourses })
            }).catch(() => {});
            document.getElementById('wizardStep1').style.display = 'none';
            document.getElementById('wizardStep2').style.display = 'block';
            document.getElementById('wizStep1Dot').style.background = '#22c55e';
            document.getElementById('wizStep2Dot').style.background = 'var(--brand)';
            document.getElementById('wizCourseCount').textContent = wizardCourses.length;
            document.getElementById('wizCourseTags').innerHTML = wizardCourses.map(c => 
                `<span style="background:var(--brand-soft); color:var(--brand); padding:2px 10px; border-radius:10px; font-size:0.65rem; font-weight:700;">${c.course_code || c.course_name}</span>`
            ).join('');
        }

        function wizardPrevStep() {
            document.getElementById('wizardStep1').style.display = 'block';
            document.getElementById('wizardStep2').style.display = 'none';
            document.getElementById('wizStep1Dot').style.background = 'var(--brand)';
            document.getElementById('wizStep2Dot').style.background = 'var(--border)';
        }

        // Drag and drop support
        document.addEventListener('DOMContentLoaded', function() {
            const dropZone = document.getElementById('dropZone');
            if (dropZone) {
                dropZone.addEventListener('dragover', function(e) {
                    e.preventDefault();
                    this.style.borderColor = 'var(--brand)';
                    this.style.background = 'var(--brand-soft)';
                });
                dropZone.addEventListener('dragleave', function(e) {
                    e.preventDefault();
                    this.style.borderColor = 'var(--border)';
                    this.style.background = '#fafafa';
                });
                dropZone.addEventListener('drop', function(e) {
                    e.preventDefault();
                    this.style.borderColor = 'var(--border)';
                    this.style.background = '#fafafa';
                    if (e.dataTransfer.files.length > 0) {
                        uploadForExtraction(e.dataTransfer.files[0]);
                    }
                });
            }

            // Enter key to add course in wizard
            document.getElementById('wizCourseUnit').addEventListener('keydown', function(e) {
                if (e.key === 'Enter') { e.preventDefault(); addWizardCourse(); }
            });
        });

        function uploadForExtraction(file) {
            if (!file) return;

            const formData = new FormData();
            formData.append('timetable_file', file);
            formData.append('knownCourses', JSON.stringify(wizardCourses));

            document.getElementById('extractStatus').style.display = 'block';
            document.getElementById('extractStatusText').textContent = 'Processing with AI models...';
            document.getElementById('dropZone').style.display = 'none';
            document.getElementById('extractedCourses').style.display = 'none';

            fetch('/timetable/extract', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                document.getElementById('extractStatus').style.display = 'none';

                if (data.success && data.courses && data.courses.length > 0) {
                    extractedCourses = data.courses;
                    document.getElementById('extractedCount').textContent = data.courses.length;
                    renderExtractedCourses();
                    document.getElementById('extractedCourses').style.display = 'block';
                    document.getElementById('dropZone').style.display = 'block';
                } else {
                    alert('AI could not extract any courses. Try a clearer image or PDF.\n' + (data.message || ''));
                    document.getElementById('dropZone').style.display = 'block';
                }
            })
            .catch(err => {
                document.getElementById('extractStatus').style.display = 'none';
                document.getElementById('dropZone').style.display = 'block';
                alert('Upload failed. Please try again.');
                console.error(err);
            });
        }

        function renderExtractedCourses() {
            const list = document.getElementById('extractedList');
            list.innerHTML = extractedCourses.map((c, i) => `
                <div class="extracted-card" data-index="${i}">
                    <div class="extracted-fields">
                        <div class="ef-row">
                            <div class="ef-group" style="flex:1;">
                                <label>Course</label>
                                <input type="text" value="${escapeHtml(c.course_name || '')}" onchange="updateExtractedCourse(${i},'course_name',this.value)" class="ef-input">
                            </div>
                            <div class="ef-group" style="flex:0.6;">
                                <label>Code</label>
                                <input type="text" value="${escapeHtml(c.course_code || '')}" onchange="updateExtractedCourse(${i},'course_code',this.value)" class="ef-input">
                            </div>
                            <div class="ef-group" style="flex:0.3;">
                                <label>Unit</label>
                                <input type="number" value="${c.unit || 3}" onchange="updateExtractedCourse(${i},'unit',this.value)" class="ef-input" min="1" max="6">
                            </div>
                        </div>
                        <div class="ef-row">
                            <div class="ef-group" style="flex:1.2;">
                                <label>Day</label>
                                <select onchange="updateExtractedCourse(${i},'day',this.value)" class="ef-input">
                                    ${['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'].map(d => 
                                        `<option ${d === c.day ? 'selected' : ''}>${d}</option>`
                                    ).join('')}
                                </select>
                            </div>
                            <div class="ef-group" style="flex:0.6;">
                                <label>Start</label>
                                <input type="time" value="${c.start_time || '09:00'}" onchange="updateExtractedCourse(${i},'start_time',this.value)" class="ef-input">
                            </div>
                            <div class="ef-group" style="flex:0.6;">
                                <label>End</label>
                                <input type="time" value="${c.end_time || '10:00'}" onchange="updateExtractedCourse(${i},'end_time',this.value)" class="ef-input">
                            </div>
                        </div>
                        <div class="ef-row">
                            <div class="ef-group" style="flex:1;">
                                <label>Venue</label>
                                <input type="text" value="${escapeHtml(c.venue || '')}" onchange="updateExtractedCourse(${i},'venue',this.value)" class="ef-input" placeholder="Room / Hall">
                            </div>
                        </div>
                    </div>
                    <button onclick="removeExtractedCourse(${i})" class="ef-remove" title="Remove"><i class="fas fa-trash"></i></button>
                </div>
            `).join('');
        }

        function updateExtractedCourse(index, field, value) {
            if (field === 'unit') value = parseInt(value) || 3;
            extractedCourses[index][field] = value;
        }

        function removeExtractedCourse(index) {
            extractedCourses.splice(index, 1);
            document.getElementById('extractedCount').textContent = extractedCourses.length;
            if (extractedCourses.length === 0) {
                document.getElementById('extractedCourses').style.display = 'none';
                document.getElementById('dropZone').style.display = 'block';
                return;
            }
            renderExtractedCourses();
        }

        function retryExtraction() {
            document.getElementById('extractedCourses').style.display = 'none';
            document.getElementById('dropZone').style.display = 'block';
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        /* â”€â”€ Today Box + Now Indicator â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
        function initTodayBox() {
            var days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
            var now = new Date();
            var dayName = days[now.getDay()];
            var dateStr = now.toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' });

            document.getElementById('todayDate').textContent = dateStr;
            document.getElementById('todayDay').textContent = dayName;

            var dayGroup = document.querySelector('.day-group');
            if (!dayGroup) {
                document.getElementById('todayStatus').innerHTML = 'No classes scheduled today';
                document.getElementById('todaySlotContainer').innerHTML = '<div class="today-empty"><i class="fas fa-calendar-check"></i> Rest day — no classes today</div>';
                return;
            }

            // Find today's day group
            var groups = document.querySelectorAll('.day-group');
            var todayGroup = null;
            var todayLabel = '';
            groups.forEach(function(g) {
                var label = g.querySelector('.day-label');
                if (label && label.textContent.trim() === dayName) {
                    todayGroup = g;
                    todayLabel = label.textContent.trim();
                }
            });

            if (!todayGroup) {
                document.getElementById('todayStatus').innerHTML = 'No classes today';
                document.getElementById('todaySlotContainer').innerHTML = '<div class="today-empty"><i class="fas fa-calendar-check"></i> Rest day — no classes scheduled</div>';
                return;
            }

            // Get current time as minutes
            var nowMin = now.getHours() * 60 + now.getMinutes();

            // Find today's slots
            var slots = todayGroup.querySelectorAll('.time-slot');
            var currentSlot = null;
            var nextSlot = null;
            var currentEndMin = 0;

            slots.forEach(function(s) {
                var hourEl = s.querySelector('.slot-hour');
                if (!hourEl) return;
                var timeText = hourEl.textContent.trim();
                // timeText format: "HH:MM"
                var parts = timeText.split(':');
                if (parts.length < 2) return;
                var startH = parseInt(parts[0]), startM = parseInt(parts[1]);
                var startMin = startH * 60 + startM;

                // Find end time from slot-info p
                var infoEl = s.querySelector('.slot-info p');
                var endMin = startMin + 60; // default 1h
                if (infoEl) {
                    var infoText = infoEl.textContent;
                    var timeMatch = infoText.match(/(\d{1,2}:\d{2})\s*-\s*(\d{1,2}:\d{2})/);
                    if (timeMatch && timeMatch[2]) {
                        var endParts = timeMatch[2].split(':');
                        endMin = parseInt(endParts[0]) * 60 + parseInt(endParts[1]);
                    }
                }

                if (nowMin >= startMin && nowMin < endMin) {
                    currentSlot = s;
                    currentEndMin = endMin;
                } else if (nowMin < startMin && !nextSlot) {
                    nextSlot = s;
                }
            });

            var container = document.getElementById('todaySlotContainer');
            container.innerHTML = '';

            if (currentSlot) {
                // Highlight current slot
                currentSlot.classList.add('now');

                var name = currentSlot.querySelector('.slot-info b');
                var infoP = currentSlot.querySelector('.slot-info p');
                var hourEl = currentSlot.querySelector('.slot-hour');

                var timeLeft = Math.max(0, currentEndMin - nowMin);
                var timeStr = timeLeft >= 60 ? Math.floor(timeLeft/60)+'h '+ (timeLeft%60)+'m' : timeLeft+'m';

                document.getElementById('todayStatus').innerHTML =
                    '<span class="live-dot"></span> <strong>Now</strong> \u2014 ' + timeStr + ' remaining';

                container.innerHTML =
                    '<div class="today-slot">' +
                    '<span class="ts-hour">' + (hourEl ? hourEl.textContent : '') + '</span>' +
                    '<div style="flex:1"><div class="ts-name">' + (name ? name.textContent : 'Class') + '</div>' +
                    '<div class="ts-venue">' + (infoP ? infoP.textContent.trim() : '') + '</div></div>' +
                    '<span class="ts-live">Live</span></div>';
            } else if (nextSlot) {
                nextSlot.classList.add('upcoming');
                var name = nextSlot.querySelector('.slot-info b');
                var hourEl = nextSlot.querySelector('.slot-hour');

                var nextParts = hourEl.textContent.trim().split(':');
                var nextStartMin = parseInt(nextParts[0])*60 + parseInt(nextParts[1]);
                var minsUntil = nextStartMin - nowMin;
                var untilStr = minsUntil >= 60 ? Math.floor(minsUntil/60)+'h '+ (minsUntil%60)+'m' : minsUntil+'m';

                document.getElementById('todayStatus').innerHTML =
                    '<i class="fas fa-clock" style="font-size:0.75rem;opacity:0.6"></i> Next class in ' + untilStr;

                container.innerHTML =
                    '<div class="today-slot">' +
                    '<span class="ts-hour">' + (hourEl ? hourEl.textContent : '') + '</span>' +
                    '<div style="flex:1"><div class="ts-name">' + (name ? name.textContent : 'Class') + '</div>' +
                    '<div class="ts-venue">Upcoming</div></div></div>';
            } else {
                document.getElementById('todayStatus').innerHTML =
                    '<i class="fas fa-check-circle" style="font-size:0.75rem;opacity:0.6"></i> All classes done for today';
                container.innerHTML = '<div class="today-empty"><i class="fas fa-check-circle"></i> You\u2019re all done for today</div>';
            }

            // Refresh every 30s
            setTimeout(initTodayBox, 30000);
        }

        document.addEventListener('DOMContentLoaded', initTodayBox);

        function saveExtractedCourses() {
            if (extractedCourses.length === 0) return;

            fetch('/timetable/save-extracted', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ courses: extractedCourses })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    closeExtractModal();
                    window.location.reload();
                } else {
                    alert('Failed to save: ' + (data.message || ''));
                }
            })
            .catch(err => {
                alert('Error saving courses.');
                console.error(err);
            });
        }
    </script>
</body>
</html>