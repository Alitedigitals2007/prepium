<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        .status-bar { height: env(safe-area-inset-top, 0px); }
        .page-content { padding: 0 1.1rem 2rem; max-width: 720px; margin: 0 auto; }

        .xp-hero {
            background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 45%, #7c3aed 100%);
            color: #fff; border-radius: var(--radius-xl);
            padding: 1.1rem 1.2rem; margin: 0.5rem 0 1rem;
            box-shadow: 0 16px 40px rgba(37, 99, 235, 0.3);
            display: flex; align-items: center; gap: 1rem;
        }
        .xp-level {
            width: 64px; height: 64px; flex: 0 0 64px; border-radius: 50%;
            background: rgba(255,255,255,0.16); border: 2px solid rgba(255,255,255,0.35);
            display: grid; place-items: center; text-align: center;
        }
        .xp-level b { font-size: 1.35rem; font-weight: 800; line-height: 1; }
        .xp-level span { font-size: 0.5rem; text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.85; }
        .xp-info { flex: 1; min-width: 0; }
        .xp-info h2 { font-size: 1rem; font-weight: 800; }
        .xp-info p { font-size: 0.68rem; opacity: 0.85; margin-top: 1px; }
        .xp-bar { height: 8px; border-radius: 99px; background: rgba(255,255,255,0.22); margin-top: 0.55rem; overflow: hidden; }
        .xp-bar i { display: block; height: 100%; border-radius: 99px; background: #fff; transition: width 0.6s var(--ease-out); }

        .tabs { display: flex; gap: 6px; background: var(--surface-solid); border: 1px solid var(--border-solid); padding: 4px; border-radius: 14px; margin-bottom: 1rem; }
        .tab-btn { flex: 1; border: none; background: transparent; font-family: inherit; font-size: 0.72rem; font-weight: 800; color: var(--text-muted); padding: 0.55rem 0.4rem; border-radius: 10px; cursor: pointer; position: relative; transition: all 0.2s var(--ease-out); }
        .tab-btn.active { background: var(--brand-gradient); color: #fff; box-shadow: 0 3px 10px rgba(37, 99, 235, 0.28); }
        .tab-badge { position: absolute; top: -4px; right: 6px; min-width: 16px; height: 16px; padding: 0 4px; border-radius: 99px; background: #ef4444; color: #fff; font-size: 0.56rem; font-weight: 800; display: grid; place-items: center; }

        .search-wrap { position: relative; margin-bottom: 0.8rem; }
        .search-wrap i { position: absolute; left: 0.9rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.85rem; }
        .search-wrap input {
            width: 100%; padding: 0.75rem 0.9rem 0.75rem 2.4rem;
            border: 1.5px solid var(--border-solid); border-radius: 13px;
            background: var(--surface-solid); color: var(--text-primary);
            font-family: inherit; font-size: 0.85rem; outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        .search-wrap input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-light); }

        .person-row { display: flex; align-items: center; gap: 0.7rem; background: var(--surface-solid); border: 1px solid var(--border-solid); border-radius: 14px; padding: 0.6rem 0.75rem; margin-bottom: 0.5rem; }
        .avatar { width: 42px; height: 42px; flex: 0 0 42px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-weight: 800; font-size: 0.9rem; text-transform: uppercase; }
        .p-main { flex: 1; min-width: 0; }
        .p-name { font-size: 0.82rem; font-weight: 800; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .p-sub { font-size: 0.62rem; color: var(--text-muted); margin-top: 1px; }
        .p-actions { display: flex; gap: 5px; flex: 0 0 auto; }
        .p-btn { border: none; border-radius: 9px; padding: 0.42rem 0.7rem; font-family: inherit; font-size: 0.62rem; font-weight: 800; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; transition: transform 0.12s; }
        .p-btn:active { transform: scale(0.94); }
        .p-btn.go { background: var(--brand-gradient); color: #fff; }
        .p-btn.ok { background: var(--success-soft); color: var(--success); }
        .p-btn.no { background: var(--danger-soft); color: var(--danger); }
        .p-btn.ghost { background: var(--bg); color: var(--text-secondary); border: 1px solid var(--border-solid); }
        .rel-chip { font-size: 0.55rem; font-weight: 800; padding: 2px 7px; border-radius: 99px; text-transform: uppercase; letter-spacing: 0.05em; background: var(--brand-soft); color: var(--brand); }

        .lb-row { display: flex; align-items: center; gap: 0.7rem; background: var(--surface-solid); border: 1px solid var(--border-solid); border-radius: 14px; padding: 0.6rem 0.75rem; margin-bottom: 0.5rem; }
        .lb-row.me { border-color: var(--brand); background: var(--brand-soft); }
        .lb-rank { width: 30px; height: 30px; flex: 0 0 30px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; font-size: 0.78rem; background: var(--bg); color: var(--text-secondary); }
        .lb-rank.r1 { background: linear-gradient(135deg, #fbbf24, #f59e0b); color: #fff; }
        .lb-rank.r2 { background: linear-gradient(135deg, #cbd5e1, #94a3b8); color: #fff; }
        .lb-rank.r3 { background: linear-gradient(135deg, #d97706, #b45309); color: #fff; }
        .lb-xp { text-align: right; }
        .lb-xp b { font-size: 0.85rem; font-weight: 800; color: var(--brand); display: block; line-height: 1.1; }
        .lb-xp span { font-size: 0.55rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
        .lvl-chip { font-size: 0.55rem; font-weight: 800; padding: 2px 7px; border-radius: 99px; background: var(--brand-soft); color: var(--brand); }

        .empty-note { padding: 1.6rem 1rem; text-align: center; color: var(--text-muted); font-size: 0.76rem; }
        .empty-note i { display: block; font-size: 1.4rem; margin-bottom: 0.45rem; opacity: 0.5; }
        .section-label { font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin: 0.9rem 0 0.5rem; }
        @media (min-width: 431px) { .app-shell { border-left: 1px solid var(--glass-border); border-right: 1px solid var(--glass-border); margin: 0 auto; } }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="status-bar"></div>
    <div class="header-nav">
        <a href="/dashboard" class="back-circle"><i class="fas fa-arrow-left"></i></a>
        <div class="header-title">Friends</div>
    </div>
    <div class="page-content">
        <div class="xp-hero">
            <div class="xp-level"><div><b id="myLevel">1</b><br><span>Level</span></div></div>
            <div class="xp-info">
                <h2 id="myXp">0 XP</h2>
                <p id="xpNext">Earn XP by playing games</p>
                <div class="xp-bar"><i id="xpBar" style="width:0%"></i></div>
            </div>
        </div>

        <div class="tabs">
            <button class="tab-btn active" data-tab="friends">Friends</button>
            <button class="tab-btn" data-tab="requests">Requests<span class="tab-badge" id="reqBadge" style="display:none">0</span></button>
            <button class="tab-btn" data-tab="leaderboard">Leaderboard</button>
        </div>

        <div id="tab-friends">
            <div class="search-wrap">
                <i class="fas fa-magnifying-glass"></i>
                <input type="text" id="searchInput" placeholder="Search students by name, email or code…" autocomplete="off">
            </div>
            <div id="searchResults"></div>
            <div class="section-label">My friends</div>
            <div id="friendsList"><div class="empty-note"><i class="fas fa-spinner fa-spin"></i>Loading…</div></div>
        </div>

        <div id="tab-requests" style="display:none">
            <div class="section-label">Received</div>
            <div id="reqIn"></div>
            <div class="section-label">Sent</div>
            <div id="reqOut"></div>
        </div>

        <div id="tab-leaderboard" style="display:none">
            <div class="section-label">XP ranking · you + your friends</div>
            <div id="lbList"><div class="empty-note"><i class="fas fa-spinner fa-spin"></i>Loading…</div></div>
        </div>
    </div>
    <%- include('partials/bottom-nav', { activeNav: 'study' }) %>
</div>

<script>
(function () {
    'use strict';
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return {'&':'&'+'amp;','<':'&'+'lt;','>':'&'+'gt;','"':'&'+'quot;',"'":'&#39;'}[c]; }); }
    function avatarColor(id) { return 'hsl(' + ((id * 137.5) % 360) + ', 62%, 45%)'; }
    function initials(name) { return String(name || '?').trim().split(/\s+/).slice(0, 2).map(function (w) { return w.charAt(0); }).join(''); }

    function showTab(tab) {
        document.querySelectorAll('.tab-btn').forEach(function (b) { b.classList.toggle('active', b.dataset.tab === tab); });
        ['friends', 'requests', 'leaderboard'].forEach(function (t) {
            document.getElementById('tab-' + t).style.display = t === tab ? '' : 'none';
        });
    }
    document.querySelectorAll('.tab-btn').forEach(function (b) {
        b.addEventListener('click', function () { showTab(b.dataset.tab); });
    });

    fetch('/api/games/stats', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
        .then(function (d) {
            var xp = d.xp || 0, level = d.level || 1;
            var cur = d.current_level_xp || 0, next = d.next_level_xp || 100;
            document.getElementById('myLevel').textContent = level;
            document.getElementById('myXp').textContent = xp.toLocaleString() + ' XP';
            var pct = Math.max(0, Math.min(100, Math.round(((xp - cur) / Math.max(1, next - cur)) * 100)));
            document.getElementById('xpBar').style.width = pct + '%';
            document.getElementById('xpNext').textContent = (next - xp).toLocaleString() + ' XP to level ' + (level + 1);
        }).catch(function () {});

    function loadFriends() {
        fetch('/api/friends', { headers: { Accept: 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                var list = document.getElementById('friendsList');
                var friends = d.friends || [];
                if (!friends.length) {
                    list.innerHTML = '<div class="empty-note"><i class="fas fa-user-group"></i>No friends yet — search above to add some.</div>';
                    return;
                }
                list.innerHTML = friends.map(function (f) {
                    return '<div class="person-row">' +
                        '<div class="avatar" style="background:' + avatarColor(f.id) + '">' + esc(initials(f.fullname)) + '</div>' +
                        '<div class="p-main"><div class="p-name">' + esc(f.fullname) + '</div>' +
                        '<div class="p-sub">Level ' + (f.level || 1) + ' · ' + (f.xp || 0).toLocaleString() + ' XP</div></div>' +
                        '<div class="p-actions">' +
                        '<button class="p-btn go" onclick="openChat(' + f.id + ')"><i class="fas fa-comment"></i> Chat</button>' +
                        '<button class="p-btn no" onclick="removeFriend(' + f.id + ')"><i class="fas fa-user-minus"></i></button>' +
                        '</div></div>';
                }).join('');
            })
            .catch(function () {
                document.getElementById('friendsList').innerHTML = '<div class="empty-note">Could not load friends.</div>';
            });
    }

    var searchTimer = null;
    document.getElementById('searchInput').addEventListener('input', function (e) {
        clearTimeout(searchTimer);
        var q = e.target.value.trim();
        if (q.length < 2) { document.getElementById('searchResults').innerHTML = ''; return; }
        searchTimer = setTimeout(function () {
            fetch('/api/friends/search?q=' + encodeURIComponent(q), { headers: { Accept: 'application/json' } })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    var box = document.getElementById('searchResults');
                    var results = d.results || [];
                    if (!results.length) { box.innerHTML = '<div class="empty-note">No students found for "' + esc(q) + '".</div>'; return; }
                    box.innerHTML = '<div class="section-label">Search results</div>' + results.map(function (u) {
                        var action;
                        if (u.relationship === 'friends') action = '<span class="rel-chip">Friends</span>';
                        else if (u.relationship === 'request_sent') action = '<span class="rel-chip">Requested</span>';
                        else if (u.relationship === 'request_received') action = '<button class="p-btn ok" onclick="acceptFriend(' + u.id + ')"><i class="fas fa-check"></i> Accept</button>';
                        else action = '<button class="p-btn go" onclick="addFriend(' + u.id + ')"><i class="fas fa-user-plus"></i> Add</button>';
                        return '<div class="person-row">' +
                            '<div class="avatar" style="background:' + avatarColor(u.id) + '">' + esc(initials(u.fullname)) + '</div>' +
                            '<div class="p-main"><div class="p-name">' + esc(u.fullname) + '</div>' +
                            '<div class="p-sub">Level ' + u.level + ' · ' + esc(u.email) + '</div></div>' +
                            '<div class="p-actions">' + action + '</div></div>';
                    }).join('');
                })
                .catch(function () {});
        }, 300);
    });

    function loadRequests() {
        fetch('/api/friends/requests', { headers: { Accept: 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                var incoming = d.incoming || [], outgoing = d.outgoing || [];
                var badge = document.getElementById('reqBadge');
                badge.style.display = incoming.length ? '' : 'none';
                badge.textContent = incoming.length;
                var inEl = document.getElementById('reqIn');
                inEl.innerHTML = incoming.length ? incoming.map(function (u) {
                    return '<div class="person-row">' +
                        '<div class="avatar" style="background:' + avatarColor(u.id) + '">' + esc(initials(u.fullname)) + '</div>' +
                        '<div class="p-main"><div class="p-name">' + esc(u.fullname) + '</div><div class="p-sub">' + esc(u.email) + '</div></div>' +
                        '<div class="p-actions">' +
                        '<button class="p-btn ok" onclick="acceptFriend(' + u.id + ')"><i class="fas fa-check"></i> Accept</button>' +
                        '<button class="p-btn no" onclick="removeFriend(' + u.id + ')"><i class="fas fa-xmark"></i></button>' +
                        '</div></div>';
                }).join('') : '<div class="empty-note">No pending requests.</div>';
                var outEl = document.getElementById('reqOut');
                outEl.innerHTML = outgoing.length ? outgoing.map(function (u) {
                    return '<div class="person-row">' +
                        '<div class="avatar" style="background:' + avatarColor(u.id) + '">' + esc(initials(u.fullname)) + '</div>' +
                        '<div class="p-main"><div class="p-name">' + esc(u.fullname) + '</div><div class="p-sub">Waiting for response</div></div>' +
                        '<div class="p-actions"><button class="p-btn ghost" onclick="removeFriend(' + u.id + ')">Cancel</button></div></div>';
                }).join('') : '<div class="empty-note">No sent requests.</div>';
            })
            .catch(function () {});
    }

    function loadLeaderboard() {
        fetch('/api/friends/leaderboard', { headers: { Accept: 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                var board = d.leaderboard || [];
                var el = document.getElementById('lbList');
                if (!board.length) { el.innerHTML = '<div class="empty-note">Play games to earn XP.</div>'; return; }
                el.innerHTML = board.map(function (row) {
                    var medal = row.rank <= 3 ? ' r' + row.rank : '';
                    var trophy = row.rank === 1 ? ' 🥇' : row.rank === 2 ? ' 🥈' : row.rank === 3 ? ' 🥉' : '';
                    return '<div class="lb-row' + (row.is_me ? ' me' : '') + '">' +
                        '<div class="lb-rank' + medal + '">' + row.rank + '</div>' +
                        '<div class="avatar" style="background:' + avatarColor(row.id) + '">' + esc(initials(row.fullname)) + '</div>' +
                        '<div class="p-main"><div class="p-name">' + esc(row.fullname) + (row.is_me ? ' (You)' : '') + trophy + '</div>' +
                        '<div class="p-sub"><span class="lvl-chip">Lv ' + row.level + '</span> · ' + row.plays + ' games</div></div>' +
                        '<div class="lb-xp"><b>' + row.xp.toLocaleString() + '</b><span>XP</span></div>' +
                        '</div>';
                }).join('');
            })
            .catch(function () {
                document.getElementById('lbList').innerHTML = '<div class="empty-note">Could not load leaderboard.</div>';
            });
    }

    window.addFriend = function (id) {
        fetch('/api/friends/request', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ friendId: id }) })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d.accepted) { Swal.fire({ icon: 'success', title: 'You are now friends!', confirmButtonColor: '#2563eb' }); }
                else { Swal.fire({ icon: 'success', title: 'Request sent', toast: true, position: 'top', timer: 1800, showConfirmButton: false }); }
                document.getElementById('searchInput').dispatchEvent(new Event('input'));
                loadRequests();
                loadFriends();
            })
            .catch(function () { Swal.fire({ icon: 'error', title: 'Could not send request', confirmButtonColor: '#2563eb' }); });
    };

    window.acceptFriend = function (id) {
        fetch('/api/friends/accept', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ friendId: id }) })
            .then(function (r) { return r.json(); })
            .then(function () {
                Swal.fire({ icon: 'success', title: 'Friend added', toast: true, position: 'top', timer: 1800, showConfirmButton: false });
                loadRequests();
                loadFriends();
                loadLeaderboard();
            })
            .catch(function () {});
    };

    window.removeFriend = function (id) {
        Swal.fire({ icon: 'warning', title: 'Remove this friend?', showCancelButton: true, confirmButtonText: 'Remove', confirmButtonColor: '#dc2626' })
            .then(function (res) {
                if (!res.isConfirmed) return;
                fetch('/api/friends/remove', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ friendId: id }) })
                    .then(function () { loadFriends(); loadRequests(); loadLeaderboard(); });
            });
    };

    window.openChat = function (id) {
        fetch('/api/chat/conversations', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ userId: id }) })
            .then(function (r) { return r.json(); })
            .then(function (d) { if (d.success) window.location.href = '/chat/' + d.id; })
            .catch(function () {});
    };

    var params = new URLSearchParams(window.location.search);
    var tab = params.get('tab');
    if (tab === 'leaderboard' || tab === 'requests') showTab(tab);

    loadFriends();
    loadRequests();
    loadLeaderboard();
})();
</script>
</body>
</html>
