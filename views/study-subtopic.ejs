}

function fmtTime(secs){var m=Math.floor(secs/60),s=secs%60;return(m<10?'0':'')+m+':'+(s<10?'0':'')+s;}
function toggleSessionTimer(){
    var btn=document.getElementById('stToggle');
    if(stRunning){clearInterval(stInterval);stRunning=false;btn.innerHTML='<i class="fas fa-play"></i>';btn.className='st-btn play';return;}
    if(!stSessionId){fetch('/api/study/sessions/start',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({courseId:courseId,subtopicId:subtopicId,courseName:subtopicName})}).then(function(r){return r.json();}).then(function(d){if(d.success&&d.session){stSessionId=d.session.id;document.getElementById('stStopBtn').style.display='block';startTimer(btn);}});return;}
    startTimer(btn);
}
function startTimer(btn){stRunning=true;btn.innerHTML='<i class="fas fa-pause"></i>';btn.className='st-btn pause';stInterval=setInterval(function(){stSeconds++;document.getElementById('stDisplay').textContent=fmtTime(stSeconds);},1000);}
function endSubtopICSession(){
    if(!stSessionId)return;if(stInterval)clearInterval(stInterval);stRunning=false;
    fetch('/api/study/sessions/end',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({sessionId:stSessionId,elapsedSeconds:stSeconds})}).then(function(r){return r.json();}).then(function(d){
        if(d.success){stSessionId=null;stSeconds=0;document.getElementById('stDisplay').textContent='00:00';document.getElementById('stToggle').innerHTML='<i class="fas fa-play"></i>';document.getElementById('stToggle').className='st-btn play';document.getElementById('stStopBtn').style.display='none';}
    });
}

(function autoInit(){
    var raw=<%- JSON.stringify(typeof subtopic !== "undefined" && subtopic ? (subtopic.content || '') : '') %>;
    if(raw){
        var e=document.getElementById('explainEmpty'),w=document.getElementById('explanationWrap');
        if(e)e.style.display='none';if(w)w.style.display='block';
        document.getElementById('explanationText').innerHTML=explainRender(raw);
        setTimeout(function(){
            try{if(window.MathJax&&MathJax.typesetPromise)MathJax.typesetPromise([document.getElementById('explanationText')]).catch(function(){});}catch(e){}
            diagramRender(document.getElementById('explanationText'));
        },400);
        setTimeout(function(){try{if(window.MathJax&&MathJax.typesetPromise)MathJax.typesetPromise([document.getElementById('explanationText')]).catch(function(){});}catch(e){}},1500);
    }
})();
</script>
