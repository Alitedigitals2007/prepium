<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | <%= (subtopic.subtopic_name || subtopic.title) %></title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .status-bar { height: env(safe-area-inset-top, 0px); }
        .page-content { padding: 0 1.5rem; }
        .subtopic-title { font-size: 1.3rem; font-weight: 800; margin: 1rem 0 0.3rem; letter-spacing: -0.3px; }
        .breadcrumb { font-size: 0.7rem; font-weight: 600; color: var(--text-sub); margin-bottom: 1.25rem; }
        .session-timer-bar { display: flex; align-items: center; gap: 10px; background: #1e293b; border-radius: 14px; padding: 10px 16px; margin-bottom: 1rem; color: white; }
        .session-timer-bar .st-time { font-size: 1.1rem; font-weight: 800; font-variant-numeric: tabular-nums; flex: 1; }
        .session-timer-bar .st-btn { width: 36px; height: 36px; border-radius: 50%; border: none; cursor: pointer; font-size: 0.85rem; display: flex; align-items: center; justify-content: center; transition: var(--transition); }
        .session-timer-bar .st-btn:active { transform: scale(0.9); }
        .session-timer-bar .st-btn.play { background: #22c55e; color: white; }
        .session-timer-bar .st-btn.pause { background: #f59e0b; color: white; }
        .session-timer-bar .st-btn.stop { background: #ef4444; color: white; }
        .breadcrumb a { color: var(--brand); text-decoration: none; }
        .content-card { background: linear-gradient(135deg, #fefce8 0%, #fef3c7 50%, #fef9c3 100%); border: 1.5px solid #fde68a; border-radius: 22px; padding: 24px; margin-bottom: 1rem; box-shadow: 0 4px 20px rgba(245,158,11,0.12); }
        .content-card .exp-header { display: flex; align-items: center; gap: 10px; font-size: 0.9rem; font-weight: 800; color: #92400e; margin-bottom: 14px; padding-bottom: 12px; border-bottom: 2px dashed #fde68a; }
        .content-card .body-text { font-size: 0.85rem; font-weight: 500; line-height: 1.8; color: #78350f; white-space: pre-wrap; }
        .content-card .body-text p { margin: 0 0 10px; }
        .gen-btn { width: 100%; padding: 14px; border-radius: 14px; border: none; background: var(--brand-gradient); color: white; font-family: inherit; font-weight: 700; font-size: 0.85rem; cursor: pointer; margin-bottom: 1rem; display: flex; align-items: center; justify-content: center; gap: 8px; }
        .gen-btn:active { transform: scale(0.98); }
        .chat-box { background: white; border: 1.5px solid var(--border); border-radius: 14px; overflow: hidden; }
        .chat-messages { max-height: 320px; overflow-y: auto; padding: 12px 14px; }
        .chat-msg { margin-bottom: 8px; display: flex; gap: 8px; }
        .chat-msg.ai { flex-direction: row; }
        .chat-msg.user { flex-direction: row-reverse; }
        .chat-msg .bubble { max-width: 82%; padding: 10px 13px; border-radius: 12px; font-size: 0.8rem; font-weight: 500; line-height: 1.5; }
        .chat-msg.ai .bubble { background: #f1f5f9; border: 1px solid var(--border); }
        .chat-msg.user .bubble { background: var(--brand); color: white; }
        .chat-input-row { display: flex; gap: 8px; padding: 10px; border-top: 1px solid var(--border); }
        .chat-input-row input { flex: 1; padding: 11px 13px; border: 1.5px solid #e2e8f0; border-radius: 10px; font-family: inherit; font-size: 0.8rem; font-weight: 600; outline: none; }
        .chat-input-row input:focus { border-color: var(--brand); }
        .chat-input-row button { width: 42px; height: 42px; border-radius: 10px; border: none; background: var(--brand-gradient); color: white; cursor: pointer; font-size: 0.85rem; }
        .tab-bar { display: flex; gap: 6px; margin-bottom: 1rem; background: #f1f5f9; border-radius: 12px; padding: 4px; }
        .tab-pill { flex: 1; padding: 10px; border-radius: 8px; background: transparent; border: none; cursor: pointer; font-family: inherit; font-weight: 700; font-size: 0.72rem; color: var(--text-sub); transition: var(--transition); display: flex; align-items: center; justify-content: center; gap: 5px; }
        .tab-pill.active { background: white; color: var(--text-dark); box-shadow: var(--shadow-sm); }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .fc-card { background: white; border: 1px solid var(--border); border-radius: 14px; padding: 2rem 1.2rem; text-align: center; min-height: 160px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; transition: var(--transition); margin-bottom: 10px; }
        .fc-card:active { transform: scale(0.98); }
        .fc-front { font-size: 0.95rem; font-weight: 700; }
        .fc-back { font-size: 0.85rem; font-weight: 600; color: var(--text-sub); display: none; }
        .fc-card.flipped .fc-front { display: none; }
        .fc-card.flipped .fc-back { display: block; }
        .fc-nav { display: flex; gap: 8px; justify-content: center; margin-bottom: 10px; }
        .fc-nav button { padding: 10px 18px; border-radius: 10px; border: 1px solid var(--border); background: white; font-family: inherit; font-weight: 700; font-size: 0.75rem; cursor: pointer; }
        .yt-card { background: white; border: 1px solid var(--border); border-radius: 14px; padding: 14px; margin-bottom: 8px; cursor: pointer; display: flex; align-items: center; gap: 12px; }
        .yt-card:active { transform: scale(0.98); }
        .yt-card i { font-size: 1.5rem; color: #ff0000; }
        .yt-card h4 { font-size: 0.82rem; font-weight: 700; margin: 0; }
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="status-bar"></div>
    <div class="header-nav">
        <a href="javascript:history.back()" class="back-circle"><i class="fas fa-arrow-left"></i></a>
        <div class="header-title"><%= (subtopic.subtopic_name || subtopic.title) %></div>
        <div style="width:42px"></div>
    </div>

    <div class="page-content">
        <div class="breadcrumb">
            <a href="/study">Study</a> &rsaquo;
            <% if (course) { %><a href="/study/course/<%= course.id %>"><%= course.course_name %></a> &rsaquo; <% } %>
            <%= (subtopic.subtopic_name || subtopic.title) %>
        </div>

        <div class="session-timer-bar" id="sessionTimerBar">
            <i class="fas fa-clock"></i>
            <span class="st-time" id="stDisplay">00:00</span>
            <button class="st-btn play" id="stToggle" onclick="toggleSessionTimer()"><i class="fas fa-play"></i></button>
            <button class="st-btn stop" id="stStopBtn" onclick="endSubtopICSession()" style="display:none;"><i class="fas fa-stop"></i></button>
        </div>

        <div class="tab-bar">
            <button class="tab-pill active" onclick="switchTab('videos', this)"><i class="fas fa-video"></i> Videos</button>
            <button class="tab-pill" onclick="switchTab('flashcards', this)"><i class="fas fa-layer-group"></i> Flashcards</button>
            <button class="tab-pill" onclick="switchTab('chat', this)"><i class="fas fa-robot"></i> Chat</button>
            <button class="tab-pill" onclick="startQuiz()"><i class="fas fa-question-circle"></i> Quiz</button>
        </div>

        <div class="tab-content active" id="tab-videos">
            <div id="videoList"></div>
        </div>
        <div class="tab-content" id="tab-flashcards">
            <div class="fc-nav">
                <button onclick="genFlashcards()"><i class="fas fa-magic"></i> Generate</button>
                <button onclick="prevCard()"><i class="fas fa-chevron-left"></i></button>
                <button onclick="nextCard()"><i class="fas fa-chevron-right"></i></button>
            </div>
            <div id="fcContainer"><div style="text-align:center;padding:2rem;color:var(--text-muted);font-weight:600;">Load or generate flashcards</div></div>
        </div>
        <div class="tab-content" id="tab-chat">
            <div class="chat-box">
                <div class="chat-messages" id="chatMessages">
                    <div style="text-align:center;padding:2rem;color:var(--text-muted);font-weight:600;font-size:0.78rem;"><i class="fas fa-comments" style="display:block;font-size:1.5rem;margin-bottom:6px;color:#e2e8f0"></i>Ask anything about this subtopic</div>
                </div>
                <div class="chat-input-row">
                    <input type="text" id="chatInput" placeholder="Ask a question..." onkeydown="if(event.key==='Enter')sendChatMsg()">
                    <button onclick="sendChatMsg()"><i class="fas fa-paper-plane"></i></button>
                </div>
            </div>
        </div>

        <button class="gen-btn" id="genContentBtn" onclick="generateContent()"><i class="fas fa-magic"></i> Generate Explanation</button>

        <div id="contentDisplay" class="content-card" style="display:none;">
            <div class="exp-header"><i class="fas fa-lightbulb" style="color:#f59e0b;font-size:1.2rem"></i> <span>Explanation</span></div>
            <div class="body-text" id="explanationText"></div>
        </div>
    </div>

    <div style="height:60px"></div>
    <%- include('partials/bottom-nav', { activeNav: 'study' }) %>
</div>

<script>
var subtopicId = <%= subtopic.id %>;
var subtopicName = '<%= (subtopic.subtopic_name || subtopic.title || "").replace(/'/g, "\\'") %>';
var courseId = <%= course ? course.id : 0 %>;
var flashcards = [];
var currentCard = 0;
var stInterval = null;
var stSeconds = 0;
var stRunning = false;
var stSessionId = null;
var subGradients = [
    ['#667eea', '#764ba2'], ['#f093fb', '#f5576c'], ['#4facfe', '#00f2fe'],
    ['#43e97b', '#38f9d7'], ['#fa709a', '#fee140'], ['#a18cd1', '#fbc2eb'],
    ['#fccb90', '#d57eeb'], ['#e0c3fc', '#8ec5fc'], ['#30cfd0', '#330867'],
    ['#ffecd2', '#fcb69f'], ['#89f7fe', '#66a6ff'], ['#f5576c', '#ff6f91']
];
function getCardColor(t) { var h=0; for(var i=0;i<(t||'').length;i++){h=((h<<5)-h)+t.charCodeAt(i);h|=0;} return subGradients[Math.abs(h)%subGradients.length]; }
function subCardSvg(c,cs) {
    var ch=(c.front||'?').charAt(0).toUpperCase();
    return '<svg width="100%" height="80" viewBox="0 0 300 80" style="border-radius:14px 14px 0 0;display:block">' +
        '<defs><linearGradient id="sg' + c.id + '" x1="0%" y1="0%" x2="100%" y2="100%">' +
        '<stop offset="0%" style="stop-color:' + cs[0] + '"/>' +
        '<stop offset="100%" style="stop-color:' + cs[1] + '"/></linearGradient></defs>' +
        '<rect width="300" height="80" rx="14" fill="url(#sg' + c.id + ')" opacity="0.12"/>' +
        '<circle cx="230" cy="20" r="30" fill="' + cs[0] + '" opacity="0.06"/>' +
        '<circle cx="60" cy="60" r="20" fill="' + cs[1] + '" opacity="0.06"/>' +
        '<text x="18" y="54" font-family="Plus Jakarta Sans,sans-serif" font-size="42" font-weight="800" fill="' + cs[0] + '" opacity="0.15">' + ch + '</text></svg>';
}

function aiCleanText(t) {
  if (!t) return '';
  return (t + '')
    .replace(/```[a-zA-Z]*\n?/g, '')
    .replace(/```/g, '')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/__([^_]+)__/g, '$1')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/^\s*#{1,6}\s*/gm, '')
    .replace(/^\s*[-*+]\s+/gm, '\u2022 ')
    .replace(/^\s*(\d+)\.\s+/gm, '$1) ')
    .replace(/^>\s?/gm, '')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '$1 ($2)')
    .replace(/\\\(([^)]+)\\\)/g, '($1)')
    .replace(/\\\[(.+?)\\\]/g, '[$1]')
    .replace(/\$/g, '')
    .replace(/\r\n/g, '\n')
    .replace(/\n{3,}/g, '\n\n')
    .trim();
}

function explainRender(t) {
  var clean = aiCleanText(t);
  var lines = clean.split('\n').filter(function(l) { return l.trim(); });
  var html = '';
  var inList = false;
  lines.forEach(function(line) {
    var esc = line.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    var m = esc.match(/^(\d+)\)\s(.+)/);
    if (m) {
      if (!inList) { html += '<div style="margin:0 0 10px">'; inList = true; }
      html += '<div style="display:flex;gap:10px;margin:0 0 6px;align-items:flex-start"><span style="background:linear-gradient(135deg,#f59e0b,#d97706);color:white;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:800;flex-shrink:0;margin-top:2px">' + m[1] + '</span><span style="flex:1;line-height:1.6">' + m[2] + '</span></div>';
      return;
    }
    if (inList) { html += '</div>'; inList = false; }
    if (esc.match(/^(key point|tip|example|note|important)/i)) {
      var tag = esc.split(':')[0];
      var rest = esc.substring(tag.length + 1).trim();
      var colors = { 'key point': ['#3b82f6','#eff6ff','#93c5fd'], 'tip': ['#10b981','#ecfdf5','#6ee7b7'], 'example': ['#8b5cf6','#f5f3ff','#a78bfa'], 'note': ['#f59e0b','#fffbeb','#fcd34d'], 'important': ['#ef4444','#fef2f2','#fca5a5'] };
      var c = colors[tag.toLowerCase()] || ['#6b7280','#f3f4f6','#d1d5db'];
      html += '<div style="margin:0 0 10px;padding:10px 14px;background:' + c[1] + ';border-left:4px solid ' + c[0] + ';border-radius:8px;font-size:0.82rem;line-height:1.6;color:#374151"><strong style="color:' + c[0] + '">' + tag + ':</strong> ' + (rest || esc) + '</div>';
    } else {
      html += '<p style="margin:0 0 10px;line-height:1.7">' + esc + '</p>';
    }
  });
  if (inList) html += '</div>';
  return html;
}

function generateContent() {
    var btn = document.getElementById('genContentBtn');
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';
    btn.disabled = true;
    fetch('/api/study/subtopic/' + subtopicId + '/content', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
        if (d.success) {
            document.getElementById('contentDisplay').style.display = 'block';
            document.getElementById('explanationText').innerHTML = explainRender(d.content);
        } else {
            Swal.fire({ icon: 'error', text: d.error });
        }
    }).catch(function(e) {
        Swal.fire({ icon: 'error', text: e.message });
    }).finally(function() {
        btn.innerHTML = '<i class="fas fa-magic"></i> Regenerate';
        btn.disabled = false;
    });
}

function switchTab(tab, btn) {
    document.querySelectorAll('.tab-pill').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    document.querySelectorAll('.tab-content').forEach(function(t) { t.classList.remove('active'); });
    document.getElementById('tab-' + tab).classList.add('active');
    if (tab === 'videos') loadVideos();
    if (tab === 'flashcards') loadFlashcards();
}

function loadVideos() {
    var container = document.getElementById('videoList');
    fetch('/api/study/youtube/search', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: subtopicName })
    }).then(function(r) { return r.json(); })
    .then(function(d) {
        container.innerHTML = '';
        if (d.success && d.html) {
            container.innerHTML = d.html;
        } else if (d.terms && d.terms.length > 0) {
            d.terms.forEach(function(t) {
                container.innerHTML += '<div class="yt-card" onclick="window.open(\'https://www.youtube.com/results?search_query=' + encodeURIComponent(t) + '\',\'_blank\')">' +
                    '<i class="fab fa-youtube"></i><div><h4>' + escapeHtml(t) + '</h4></div></div>';
            });
        } else {
            container.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-muted);font-weight:600;">No videos found</div>';
        }
    });
}

function loadFlashcards() {
    var url = '/api/study/flashcards?courseId=' + courseId + (subtopicId ? '&subtopicId=' + subtopicId : '');
    fetch(url)
    .then(function(r) { return r.json().catch(function(){ return { flashcards: [] }; }); })
    .then(function(d) {
        if (d.flashcards && d.flashcards.length > 0) {
            flashcards = d.flashcards;
            currentCard = 0;
            showCard();
        }
    }).catch(function(e){ console.warn('flashcards load failed', e); });
}

function showCard() {
    if (flashcards.length === 0) {
        document.getElementById('fcContainer').innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-muted);font-weight:600;">No flashcards yet. Generate some!</div>';
        return;
    }
    var c = flashcards[currentCard];
    var cs = getCardColor(c.front);
    document.getElementById('fcContainer').innerHTML = '<div class="fc-card" onclick="this.classList.toggle(\'flipped\')" style="padding:0;overflow:hidden">' +
        subCardSvg(c, cs) +
        '<div style="padding:12px 16px 16px">' +
        '<div class="fc-front" style="font-size:0.95rem;font-weight:700;line-height:1.5;color:var(--text-dark)">' + escapeHtml(c.front || '(empty)') + '</div>' +
        '<div class="fc-back" style="font-size:0.88rem;font-weight:600;color:var(--text-sub);line-height:1.5">' + escapeHtml(c.back || '(empty)') + '</div>' +
        '</div>' +
        '<div class="tap-hint" style="display:block;padding:0 16px 10px;font-size:0.6rem;color:var(--text-muted);font-weight:600">Tap to flip</div></div>' +
        '<div style="text-align:center;font-size:0.7rem;font-weight:600;color:var(--text-sub);margin-top:4px">' + (currentCard + 1) + ' / ' + flashcards.length + '</div>';
}

function prevCard() { if (currentCard > 0) { currentCard--; showCard(); } }
function nextCard() { if (currentCard < flashcards.length - 1) { currentCard++; showCard(); } }

function genFlashcards() {
    Swal.fire({ title: 'Generating...', html: 'AI is creating flashcards', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); } });
    fetch('/api/study/flashcards/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ courseId: courseId, subtopicId: subtopicId, topicTitle: subtopicName })
    }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.success) { Swal.fire({ icon: 'success', text: d.count + ' flashcards created!', timer: 1500, showConfirmButton: false }); loadFlashcards(); }
        else Swal.fire({ icon: 'error', text: d.error });
    });
}

function startQuiz() {
    Swal.fire({
        title: 'Quiz Setup',
        html:
            '<div style="text-align:left;font-size:0.8rem;color:#475569;font-weight:600;margin-bottom:6px">Number of questions</div>' +
            '<select id="qz-count" style="width:100%;padding:10px;border-radius:10px;border:1.5px solid #cbd5e1;font-family:inherit;font-weight:600;margin-bottom:10px">' +
            '<option value="5">5 questions</option><option value="10" selected>10 questions</option>' +
            '<option value="15">15 questions</option><option value="20">20 questions</option></select>' +
            '<div style="text-align:left;font-size:0.8rem;color:#475569;font-weight:600;margin-bottom:6px">Question type</div>' +
            '<select id="qz-type" style="width:100%;padding:10px;border-radius:10px;border:1.5px solid #cbd5e1;font-family:inherit;font-weight:600;margin-bottom:10px">' +
            '<option value="mixed" selected>Mixed (MCQ + Theory)</option>' +
            '<option value="multiple_choice">Multiple Choice only</option>' +
            '<option value="theory">Theory only</option></select>' +
            '<div style="text-align:left;font-size:0.8rem;color:#475569;font-weight:600;margin-bottom:6px">Time limit</div>' +
            '<select id="qz-time" style="width:100%;padding:10px;border-radius:10px;border:1.5px solid #cbd5e1;font-family:inherit;font-weight:600;margin-bottom:10px">' +
            '<option value="0" selected>Untimed</option>' +
            '<option value="5">5 minutes</option>' +
            '<option value="10">10 minutes</option>' +
            '<option value="15">15 minutes</option></select>',
        showCancelButton: true,
        confirmButtonText: 'Generate Quiz',
        showLoaderOnConfirm: true,
        preConfirm: function() {
            var count = parseInt(document.getElementById('qz-count').value) || 5;
            var type = document.getElementById('qz-type').value;
            var time = parseInt(document.getElementById('qz-time').value) || 0;
            Swal.update({ html: '<div style="margin-top:8px"><i class="fas fa-spinner fa-spin" style="font-size:1.6rem;color:#0062ff"></i></div><div style="margin-top:8px;font-weight:600;color:#475569">Generating quiz…</div>' });
            return fetch('/api/study/quiz/generate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ courseId: courseId, subtopicId: subtopicId, topicTitle: subtopicName, questionType: type, questionCount: count, timeLimit: time })
            }).then(function(r){ return r.json(); }).then(function(d) {
                if (d && d.success && d.attempt) return d;
                throw new Error((d && d.error) ? d.error : 'Failed to generate quiz');
            });
        }
    }).then(function(res) {
        if (res && res.isConfirmed && res.value && res.value.attempt) {
            window.location.href = '/study/quiz/' + res.value.attempt.id;
        }
    }).catch(function(err) {
        Swal.fire({ icon: 'error', title: 'Quiz error', text: err.message });
    });
}

function escapeHtml(t) { return (t || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function fmtTime(secs) {
    var m = Math.floor(secs / 60);
    var s = secs % 60;
    return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
}

function toggleSessionTimer() {
    var btn = document.getElementById('stToggle');
    if (stRunning) {
        clearInterval(stInterval);
        stRunning = false;
        btn.innerHTML = '<i class="fas fa-play"></i>';
        btn.className = 'st-btn play';
        return;
    }
    if (!stSessionId) {
        fetch('/api/study/sessions/start', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ courseId: courseId, subtopicId: subtopicId, courseName: subtopicName })
        }).then(function(r){ return r.json(); }).then(function(d) {
            if (d.success && d.session) {
                stSessionId = d.session.id;
                document.getElementById('stStopBtn').style.display = 'block';
                startTimer(btn);
            }
        });
        return;
    }
    startTimer(btn);
}

function startTimer(btn) {
    stRunning = true;
    btn.innerHTML = '<i class="fas fa-pause"></i>';
    btn.className = 'st-btn pause';
    stInterval = setInterval(function() {
        stSeconds++;
        document.getElementById('stDisplay').textContent = fmtTime(stSeconds);
    }, 1000);
}

function endSubtopICSession() {
    if (!stSessionId) return;
    if (stInterval) clearInterval(stInterval);
    stRunning = false;
    fetch('/api/study/sessions/end', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId: stSessionId, elapsedSeconds: stSeconds })
    }).then(function(r){ return r.json(); }).then(function(d) {
        if (d.success) {
            stSessionId = null;
            stSeconds = 0;
            document.getElementById('stDisplay').textContent = '00:00';
            document.getElementById('stToggle').innerHTML = '<i class="fas fa-play"></i>';
            document.getElementById('stToggle').className = 'st-btn play';
            document.getElementById('stStopBtn').style.display = 'none';
        }
    });
}

function chEscape(s) {
    return (s == null ? '' : String(s)).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function chRender(text) {
    var raw = String(text || '');
    var paras = raw.split(/\n\s*\n/);
    return paras.map(function(p) {
        var t = p.replace(/\s*\n\s*/g, ' ').trim();
        if (!t) return '';
        return '<p style="margin:0 0 6px">' + chEscape(t) + '</p>';
    }).join('');
}

function chAppend(role, html) {
    var wrap = document.createElement('div');
    wrap.className = 'chat-msg ' + role;
    var bubble = document.createElement('div');
    bubble.className = 'bubble';
    bubble.innerHTML = html;
    wrap.appendChild(bubble);
    var container = document.getElementById('chatMessages');
    if (container.querySelector('.fa-comments')) container.innerHTML = '';
    container.appendChild(wrap);
    container.scrollTop = container.scrollHeight;
}

function loadChatHistory() {
    fetch('/api/study/chat/history?courseId=' + courseId + '&subtopicId=' + subtopicId)
    .then(function(r){ return r.json(); }).then(function(d) {
        if (d.messages && d.messages.length > 0) {
            var container = document.getElementById('chatMessages');
            container.innerHTML = '';
            d.messages.forEach(function(m) {
                chAppend(m.role === 'user' ? 'user' : 'ai', chRender(m.message));
            });
        }
    }).catch(function(e){ console.warn('chat history', e); });
}

function sendChatMsg() {
    var input = document.getElementById('chatInput');
    var msg = input.value.trim();
    if (!msg) return;
    input.value = '';
    chAppend('user', chEscape(msg));
    var pending = chAppend('ai', '<i class="fas fa-spinner fa-spin"></i> Thinking…');
    fetch('/api/study/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: msg, courseId: courseId, subtopicId: subtopicId, courseName: subtopicName })
    }).then(function(r){ return r.json().catch(function(){ return { success:false, error:'Bad response' }; }); })
    .then(function(d) {
        if (pending && pending.parentNode) pending.remove();
        if (d && d.success && d.reply) chAppend('ai', chRender(d.reply));
        else chAppend('ai', '<p style="color:#dc2626;margin:0">' + chEscape((d && d.error) ? d.error : 'No response') + '</p>');
    }).catch(function(err) {
        if (pending && pending.parentNode) pending.remove();
        chAppend('ai', '<p style="color:#dc2626;margin:0">' + chEscape(err.message || 'network error') + '</p>');
    });
}

if (document.querySelector('#tab-videos.active')) loadVideos();

(function autoInit() {
  var raw = <%- JSON.stringify(typeof subtopic !== "undefined" && subtopic ? (subtopic.content || '') : '') %>;
  if (raw) {
    document.getElementById('contentDisplay').style.display = 'block';
    document.getElementById('explanationText').innerHTML = explainRender(raw);
  }
})();
</script>
