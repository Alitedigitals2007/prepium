<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>Prepium | <%= course ? course.course_name : 'Course' %></title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .status-bar { height: env(safe-area-inset-top, 0px); }
        .page-content { padding: 0 1.5rem 1.5rem; }

        .hero-card { background: var(--brand-gradient); border-radius: var(--radius-lg); padding: 20px; margin: 0 1.5rem 1rem; color: white; position: relative; overflow: hidden; }
        .hero-card::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at top right, rgba(255,255,255,0.15) 0%, transparent 60%); }
        .hero-card h2 { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.5px; position: relative; margin: 0 0 2px; }
        .hero-card .code { font-size: 0.78rem; opacity: 0.85; font-weight: 600; position: relative; margin-bottom: 10px; display: block; }
        .hero-card .meta-row { display: flex; gap: 16px; position: relative; font-size: 0.72rem; font-weight: 600; opacity: 0.9; }
        .hero-card .meta-row i { margin-right: 4px; }

        .quick-actions { display: flex; gap: 8px; padding: 0 1.5rem 1rem; }
        .q-btn { flex: 1; padding: 12px; border-radius: var(--radius-sm); border: none; cursor: pointer; font-family: inherit; font-weight: 700; font-size: 0.72rem; display: flex; flex-direction: column; align-items: center; gap: 4px; transition: var(--transition); background: white; border: 1px solid var(--border); color: var(--text-dark); }
        .q-btn i { font-size: 1rem; color: var(--brand); }
        .q-btn:active { transform: scale(0.95); }
        .q-btn.primary { background: var(--brand-gradient); color: white; border: none; }
        .q-btn.primary i { color: white; }
        .q-btn.primary:hover { box-shadow: 0 6px 20px rgba(0, 98, 255, 0.35); }

        .section-label { font-size: 0.62rem; font-weight: 800; color: var(--text-sub); text-transform: uppercase; letter-spacing: 1px; padding: 0.5rem 1.5rem 0.5rem; display: flex; justify-content: space-between; align-items: center; }
        .section-label .action-link { font-size: 0.68rem; text-transform: none; letter-spacing: 0; color: var(--brand); cursor: pointer; font-weight: 700; background: none; border: none; font-family: inherit; }

        .topic-item { margin: 0 1.5rem 8px; background: white; border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; transition: var(--transition); }
        .topic-header { display: flex; align-items: center; gap: 10px; padding: 14px 14px; cursor: pointer; }
        .topic-header:active { background: #fafbfc; }
        .topic-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brand); flex-shrink: 0; }
        .topic-dot.completed { background: var(--success); }
        .topic-name { flex: 1; font-weight: 700; font-size: 0.82rem; }
        .topic-actions { display: flex; gap: 4px; }
        .topic-actions button { width: 32px; height: 32px; border-radius: 8px; border: none; background: transparent; cursor: pointer; color: var(--text-sub); font-size: 0.75rem; transition: var(--transition); display: flex; align-items: center; justify-content: center; }
        .topic-actions button:hover { background: #f1f5f9; }
        .topic-actions .del-btn:hover { color: var(--danger); background: #fef2f2; }

        .subtopic-list { padding: 0 14px 12px; display: none; }
        .subtopic-list.open { display: block; }
        .subtopic-chip { display: flex; align-items: center; gap: 8px; padding: 10px; margin-bottom: 4px; background: var(--bg); border-radius: 8px; border: 1px solid var(--border); font-size: 0.75rem; font-weight: 600; }
        .subtopic-chip .chip-actions { margin-left: auto; display: flex; gap: 4px; }
        .subtopic-chip .chip-actions button { width: 28px; height: 28px; border-radius: 6px; border: none; background: transparent; cursor: pointer; font-size: 0.7rem; color: var(--text-sub); }
        .subtopic-chip .chip-actions button:hover { background: #f1f5f9; }
        .subtopic-chip .chip-actions .accept-btn:hover { color: var(--success); }
        .subtopic-chip .chip-actions .edit-btn:hover { color: var(--brand); }
        .subtopic-chip .chip-actions .reject-btn:hover { color: var(--danger); }
        .subtopic-chip .status-badge { font-size: 0.6rem; padding: 2px 8px; border-radius: 4px; font-weight: 700; }
        .status-badge.accepted { background: #d1fae5; color: #065f46; }
        .status-badge.pending { background: #fef3c7; color: #92400e; }
        .status-badge.ai-generated { background: #dbeafe; color: #1e40af; }

        .add-topic-row { display: flex; gap: 8px; margin: 0 1.5rem 12px; }
        .add-topic-row input { flex: 1; padding: 12px 14px; border: 1.5px solid var(--border); border-radius: var(--radius-sm); font-family: inherit; font-size: 0.82rem; font-weight: 600; outline: none; transition: var(--transition); }
        .add-topic-row input:focus { border-color: var(--brand); }
        .add-topic-row button { padding: 12px 18px; border-radius: var(--radius-sm); border: none; background: var(--brand-gradient); color: white; font-weight: 700; font-size: 0.75rem; cursor: pointer; white-space: nowrap; }

        .generate-section { margin: 0 1.5rem 12px; }
        .gen-btn { width: 100%; padding: 12px; border-radius: var(--radius-sm); border: 1.5px dashed var(--border); background: transparent; font-family: inherit; font-weight: 700; font-size: 0.78rem; color: var(--text-sub); cursor: pointer; transition: var(--transition); display: flex; align-items: center; justify-content: center; gap: 8px; }
        .gen-btn:hover { border-color: var(--brand); color: var(--brand); }
        .gen-btn i { color: var(--brand); }

        .empty-topics { text-align: center; padding: 2rem 1.5rem; color: var(--text-muted); }
        .empty-topics i { font-size: 2rem; display: block; margin-bottom: 8px; }

        @media (min-width: 431px) { .app-shell { border-left: 1px solid var(--glass-border); border-right: 1px solid var(--glass-border); margin: 0 auto; } }
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="status-bar"></div>
    
    <div class="header-nav">
        <a href="/study" class="back-circle"><i class="fas fa-arrow-left"></i></a>
        <div class="header-title"><%= course ? course.course_name : 'Course Detail' %></div>
        <div style="width:42px"></div>
    </div>

    <div class="hero-card">
        <h2><%= course ? course.course_name : '' %></h2>
        <span class="code"><%= course ? course.course_code : '' %></span>
        <div class="meta-row">
            <span><i class="fas fa-layer-group"></i> <%= course ? course.unit : 0 %> credits</span>
            <span><i class="fas fa-list"></i> <%= topics ? topics.length : 0 %> topics</span>
        </div>
    </div>

    <div class="quick-actions">
        <button class="q-btn" onclick="startSession()"><i class="fas fa-play-circle"></i> Study</button>
        <button class="q-btn" onclick="showQuizSetup()"><i class="fas fa-question-circle"></i> Quiz</button>
        <button class="q-btn" onclick="openAIClass()"><i class="fas fa-robot"></i> AI Class</button>
        <button class="q-btn" onclick="openFlashcards()"><i class="fas fa-layer-group"></i> Cards</button>
    </div>

    <div class="section-label">
        <span>Scheme of Work</span>
        <button class="action-link" onclick="addTopicPrompt()"><i class="fas fa-plus"></i> Add Topic</button>
    </div>

    <div class="add-topic-row" id="addTopicRow" style="display:none;">
        <input type="text" id="topicInput" placeholder="Enter topic name..." maxlength="200">
        <button onclick="addTopic()">Add</button>
    </div>



    <div id="topicsContainer">
        <% if (topics && topics.length > 0) { %>
            <% topics.forEach(function(t) { %>
            <div class="topic-item" data-topic-id="<%= t.id %>">
                <div class="topic-header" onclick="toggleSubtopicList(this)">
                    <div class="topic-dot <%= t.completed ? 'completed' : '' %>"></div>
                    <div class="topic-name"><%= t.topic_name || t.title %></div>
                    <div class="topic-actions">
                        <button onclick="event.stopPropagation(); generateSubtopicAI(<%= t.id %>)" title="AI Generate"><i class="fas fa-magic"></i></button>
                        <button class="del-btn" onclick="event.stopPropagation(); deleteTopic(<%= t.id %>)" title="Delete"><i class="fas fa-trash"></i></button>
                    </div>
                </div>
                <div class="subtopic-list">
                    <% if (t.subtopics && t.subtopics.length > 0) { %>
                        <% t.subtopics.forEach(function(st) { %>
                        <div class="subtopic-chip" data-subtopic-id="<%= st.id %>" onclick="openSubtopic(<%= st.id %>)">
                            <span class="st-name"><%= st.subtopic_name || st.title %></span>
                            <span class="status-badge <%= st.status %>"><%= st.status %></span>
                            <div class="chip-actions" onclick="event.stopPropagation()">
                                <% if (st.status === 'ai-generated') { %>
                                    <button class="accept-btn" onclick="acceptSubtopic(<%= st.id %>)"><i class="fas fa-check"></i></button>
                                    <button class="edit-btn" onclick="editSubtopic(<%= st.id %>)"><i class="fas fa-pen"></i></button>
                                    <button class="reject-btn" onclick="rejectSubtopic(<%= st.id %>)"><i class="fas fa-times"></i></button>
                                <% } else if (st.status === 'pending') { %>
                                    <button class="edit-btn" onclick="editSubtopic(<%= st.id %>)"><i class="fas fa-pen"></i></button>
                                    <button class="reject-btn" onclick="deleteSubtopic(<%= st.id %>)"><i class="fas fa-trash"></i></button>
                                <% } else { %>
                                    <button class="edit-btn" onclick="editSubtopic(<%= st.id %>)"><i class="fas fa-pen"></i></button>
                                <% } %>
                            </div>
                        </div>
                        <% }); %>
                    <% } else { %>
                        <div style="padding:8px;text-align:center;font-size:0.72rem;color:var(--text-muted);font-weight:600;">
                            No subtopics yet. <a href="#" onclick="generateSubtopicAI(<%= t.id %>);return false;" style="color:var(--brand);">Generate with AI</a>
                        </div>
                    <% } %>
                </div>
            </div>
            <% }); %>
        <% } else { %>
            <div class="empty-topics">
                <i class="fas fa-list"></i>
                <p>No topics added yet. Add manually or use AI to generate.</p>
            </div>
        <% } %>
    </div>

    <div style="height: 40px;"></div>

    <%- include('partials/bottom-nav', { activeNav: 'study' }) %>
</div>

<script>
var courseId = <%= course ? course.id : 0 %>;
var courseName = '<%= course ? course.course_name.replace(/'/g, "\\'") : '' %>';

function toggleSubtopicList(header) {
    header.nextElementSibling.classList.toggle('open');
}

function addTopicPrompt() {
    var row = document.getElementById('addTopicRow');
    row.style.display = row.style.display === 'none' ? 'flex' : 'none';
    if (row.style.display === 'flex') document.getElementById('topicInput').focus();
}

function addTopic() {
    var name = document.getElementById('topicInput').value.trim();
    if (!name) return Swal.fire({ icon: 'warning', text: 'Enter a topic name' });
    fetch('/api/study/topics/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ courseId: courseId, title: name })
    }).then(r => r.json()).then(d => {
        if (d.success) { Swal.fire({ icon: 'success', timer: 1000, showConfirmButton: false, title: 'Added!' }); setTimeout(function() { location.reload(); }, 1000); }
        else Swal.fire({ icon: 'error', text: d.error });
    });
}

function deleteTopic(id) {
    Swal.fire({ title: 'Delete topic?', text: 'Subtopics will also be removed', icon: 'warning', showCancelButton: true, confirmButtonText: 'Delete' }).then(function(res) {
        if (res.isConfirmed) {
            fetch('/api/study/topics/delete/' + id, { method: 'POST' }).then(r => r.json()).then(function(d) {
                if (d.success) location.reload();
                else Swal.fire({ icon: 'error', text: d.error });
            });
        }
    });
}

function generateSubtopicAI(topicId) {
    var topicEl = document.querySelector('[data-topic-id="' + topicId + '"]');
    var topicTitle = topicEl ? topicEl.querySelector('.topic-name').textContent.trim() : '';
    Swal.fire({ title: 'Generating...', html: 'AI is creating subtopics', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); } });
    fetch('/api/study/subtopics/ai-generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ topicId: topicId, courseId: courseId, topicTitle: topicTitle, courseName: courseName })
    }).then(r => r.json()).then(function(d) {
        if (d.success) { Swal.fire({ icon: 'success', text: (d.subtopics ? d.subtopics.length : 0) + ' subtopics generated!', timer: 1500, showConfirmButton: false }); setTimeout(function() { location.reload(); }, 1500); }
        else Swal.fire({ icon: 'error', text: d.error });
    });
}

function acceptSubtopic(id) {
    fetch('/api/study/subtopics/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, status: 'accepted' })
    }).then(r => r.json()).then(function(d) { if (d.success) location.reload(); });
}

function rejectSubtopic(id) {
    Swal.fire({ title: 'Remove subtopic?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Remove' }).then(function(res) {
        if (res.isConfirmed) {
            fetch('/api/study/subtopics/delete/' + id, { method: 'POST' }).then(r => r.json()).then(function(d) { if (d.success) location.reload(); });
        }
    });
}

function deleteSubtopic(id) {
    fetch('/api/study/subtopics/delete/' + id, { method: 'POST' }).then(r => r.json()).then(function(d) { if (d.success) location.reload(); });
}

function editSubtopic(id) {
    var nameEl = document.querySelector('[data-subtopic-id="' + id + '"] .st-name');
    var currentName = nameEl ? nameEl.textContent.trim() : '';
    Swal.fire({ title: 'Edit Subtopic', input: 'text', inputValue: currentName, showCancelButton: true, confirmButtonText: 'Save' }).then(function(res) {
        if (res.isConfirmed && res.value.trim()) {
            fetch('/api/study/subtopics/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: id, title: res.value.trim() })
            }).then(r => r.json()).then(function(d) { if (d.success) location.reload(); });
        }
    });
}

function openSubtopic(id) {
    window.location.href = '/study/subtopic/' + id;
}

function startSession() {
    Swal.fire({ title: 'Starting session...', html: 'Setting up your study environment', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); } });
    fetch('/api/study/sessions/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ courseId: courseId, courseName: courseName })
    }).then(r => r.json()).then(function(d) {
        if (d.success && d.redirect) window.location.href = d.redirect;
        else Swal.fire({ icon: 'error', text: d.error || 'Could not start session' });
    });
}

function showQuizSetup() {
    Swal.fire({
        title: 'Quick Quiz',
        html:
            '<select id="swal-subtopic" style="width:100%;padding:10px;border-radius:10px;border:1px solid #e2e8f0;font-family:inherit;font-weight:600;margin-bottom:8px">' +
            '<option value="">All Subtopics</option>' +
            '<% if (topics) { topics.forEach(function(t) { if (t.subtopics) { t.subtopics.forEach(function(st) { %>' +
            '<option value="<%= st.id %>"><%= st.subtopic_name || st.title %></option>' +
            '<% }); } }); } %>' +
            '</select>' +
            '<select id="swal-type" style="width:100%;padding:10px;border-radius:10px;border:1px solid #e2e8f0;font-family:inherit;font-weight:600;margin-bottom:8px">' +
            '<option value="mixed">Mixed Questions</option><option value="multiple_choice">Multiple Choice</option><option value="theory">Theory</option>' +
            '</select>' +
            '<div style="display:flex;gap:8px">' +
            '<input id="swal-count" type="number" value="5" min="1" max="20" style="flex:1;padding:10px;border-radius:10px;border:1px solid #e2e8f0;font-family:inherit;font-weight:600;text-align:center">' +
            '<select id="swal-timed" style="width:auto;padding:10px;border-radius:10px;border:1px solid #e2e8f0;font-family:inherit;font-weight:600">' +
            '<option value="0">Untimed</option><option value="5">5 min</option><option value="10">10 min</option><option value="15">15 min</option>' +
            '</select></div>',
        showCancelButton: true, confirmButtonText: 'Start Quiz', showLoaderOnConfirm: true,
        preConfirm: function() {
            var subtopicId = document.getElementById('swal-subtopic').value;
            var type = document.getElementById('swal-type').value;
            var count = document.getElementById('swal-count').value;
            var timed = document.getElementById('swal-timed').value;
            return fetch('/api/study/quiz/generate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ courseId: courseId, subtopicId: subtopicId || undefined, topicTitle: courseName, questionType: type, questionCount: parseInt(count), timeLimit: parseInt(timed) })
            }).then(function(r) { return r.json(); }).then(function(d) {
                if (d.success && d.attempt) return d;
                throw new Error(d.error || 'Failed to generate quiz');
            });
        }
    }).then(function(res) {
        if (res.isConfirmed) {
            window.location.href = '/study/quiz/' + res.value.attempt.id;
        }
    });
}

function openFlashcards() {
    window.location.href = '/study/flashcards/' + courseId;
}

function openAIClass() {
    startSession();
}
</script>
</body>
</html>
