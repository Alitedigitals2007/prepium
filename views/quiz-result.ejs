<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prepium | Results Review</title>
    <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" async></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { --brand: #0062ff; --bg: #f8fafc; --success: #22c55e; --danger: #ef4444; --text: #1e293b; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); padding: 20px; color: var(--text); }
        .container { max-width: 550px; margin: auto; }
        .card { background: white; padding: 25px; border-radius: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.04); margin-bottom: 20px; position: relative; border: 1px solid #f1f5f9; }
        
        /* Centered Performance Card */
        .header-card { text-align: center; }
        .perc-text { font-size: 3.8rem; font-weight: 800; color: var(--brand); margin: 0; line-height: 1; }
        .stat-box { background: #eff6ff; padding: 15px; border-radius: 20px; margin-top: 15px; border: 1px solid #dbeafe; }
        .stat-label { font-size: 0.7rem; font-weight: 800; color: #64748b; text-transform: uppercase; display: block; letter-spacing: 0.5px; }

        /* Collapsible Subject Report */
        .report-toggle { background: white; border: 1px solid #e2e8f0; border-radius: 20px; margin-bottom: 25px; overflow: hidden; }
        .report-toggle summary { padding: 18px; font-weight: 800; font-size: 0.85rem; color: #1e293b; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
        .report-toggle summary::after { content: '↓'; color: var(--brand); font-size: 1.1rem; }
        .report-content { padding: 0 18px 18px 18px; border-top: 1px solid #f1f5f9; }
        .subj-row { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f8fafc; }
        .subj-name { font-weight: 700; color: #64748b; font-size: 0.85rem; }

        /* Review Card Logic */
        .review-card { border-left: 8px solid #cbd5e1; }
        .review-card.correct-q { border-left-color: var(--success); }
        .review-card.wrong-q { border-left-color: var(--danger); }
        
        .badge { position: absolute; top: 18px; right: 20px; font-size: 0.65rem; font-weight: 800; padding: 5px 12px; border-radius: 8px; text-transform: uppercase; }
        .correct-q .badge { background: #f0fdf4; color: var(--success); }
        .wrong-q .badge { background: #fef2f2; color: var(--danger); }

        .q-text { font-weight: 800; margin-bottom: 22px; font-size: 1.05rem; color: #0f172a; line-height: 1.6; padding-right: 85px; }
        
        /* Options Review Styling */
        .opt-container { display: flex; flex-direction: column; gap: 10px; }
        .opt-row { padding: 14px 18px; border-radius: 16px; border: 2px solid #f1f5f9; font-size: 0.95rem; font-weight: 700; display: flex; align-items: center; justify-content: space-between; }
        .opt-row .lbl { margin-right: 12px; font-weight: 800; color: #94a3b8; }

        /* Visual Feedback */
        .opt-row.is-correct { border-color: var(--success); background: #f0fdf4; color: #166534; }
        .opt-row.is-correct .lbl { color: var(--success); }
        .opt-row.is-wrong-pick { border-color: var(--danger); background: #fef2f2; color: #991b1b; }
        .opt-row.is-wrong-pick .lbl { color: var(--danger); }

        .status-tag { font-size: 0.75rem; font-weight: 800; padding: 4px 10px; border-radius: 6px; }

        /* Solution Expansion */
        .sol-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; margin-top: 20px; }
        .sol-box summary { padding: 15px; font-size: 0.75rem; font-weight: 800; color: var(--brand); list-style: none; cursor: pointer; text-align: center; }
        .sol-body { padding: 0 15px 15px 15px; font-size: 0.85rem; color: #475569; border-top: 1px solid #e2e8f0; padding-top: 15px; line-height: 1.6; }
        .hint-badge { background: #fef9c3; color: #854d0e; padding: 3px 8px; border-radius: 6px; font-weight: 800; font-size: 0.65rem; margin-bottom: 10px; display: inline-block; }

        .btn-home { display: block; text-align: center; padding: 20px; background: var(--brand); color: white; text-decoration: none; border-radius: 20px; font-weight: 800; margin: 40px 0; box-shadow: 0 10px 25px rgba(0,98,255,0.2); }
    </style>
</head>
<body>

    <div class="container">
        <div class="card header-card">
            <span class="stat-label">Exam Performance</span>
            <h1 class="perc-text"><%= percentage %>%</h1>
            <div class="stat-box">
                <span class="stat-label">Final Score</span>
                <span style="font-weight: 800; font-size: 1.2rem;"><%= score %> / <%= total %></span>
            </div>
        </div>

        <details class="report-toggle">
            <summary>VIEW SUBJECT BREAKDOWN</summary>
            <div class="report-content">
                <% Object.keys(subjectStats).forEach(subject => { %>
                    <div class="subj-row">
                        <span class="subj-name"><%= subject %></span>
                        <span style="font-weight: 800; color: var(--text);">
                            <%= subjectStats[subject].correct %> / <%= subjectStats[subject].total %>
                        </span>
                    </div>
                <% }) %>
            </div>
        </details>

        <h3 style="font-weight: 800; margin: 30px 0 15px 5px; color: #64748b; font-size: 0.9rem; letter-spacing: 0.5px;">SCRUTINY & REVIEW</h3>

        <% results.forEach((r, i) => { %>
            <div class="card review-card <%= r.isCorrect ? 'correct-q' : 'wrong-q' %>">
                <div class="badge"><%= r.isCorrect ? 'Passed' : 'Failed' %></div>
                
                <div class="q-text">
                    <span style="color: var(--brand); font-size: 0.75rem; display: block; margin-bottom: 4px;">QUESTION <%= i + 1 %></span>
                    <%= r.question_text %>
                </div>

                <div class="opt-container">
                    <% ['a', 'b', 'c', 'd'].forEach(key => { 
                        let cls = '';
                        let tag = '';

                        // Logic: Always show correct answer green, show user's choice red if wrong.
                        if(key === r.correctAnswer) {
                            cls = 'is-correct';
                            tag = 'Correct Answer ✓';
                        } else if(key === r.userChoice && !r.isCorrect) {
                            cls = 'is-wrong-pick';
                            tag = 'Your Choice ✗';
                        }
                    %>
                        <div class="opt-row <%= cls %>">
                            <span><span class="lbl"><%= key.toUpperCase() %></span> <%= r['option_' + key] %></span>
                            <% if(tag) { %>
                                <span class="status-tag"><%= tag %></span>
                            <% } %>
                        </div>
                    <% }) %>
                </div>

                <% if(r.hint || r.explanation) { %>
                <details class="sol-box">
                    <summary>REASONING & SOLUTION</summary>
                    <div class="sol-body">
                        <% if(r.hint) { %>
                            <div class="hint-badge">EXAM TIP</div>
                            <p style="margin-top:0;"><i><%= r.hint %></i></p>
                        <% } %>
                        <% if(r.explanation) { %>
                            <p style="margin-bottom:0;"><b>Detailed Explanation:</b><br> <%= r.explanation %></p>
                        <% } %>
                    </div>
                </details>
                <% } %>
            </div>
        <% }) %>

        <a href="/dashboard" class="btn-home">Finish & Exit</a>
    </div>

</body>
</html>
