<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prepium | Performance Report</title>
    <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" async></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { --brand: #0062ff; --bg: #f8fafc; --success: #22c55e; --danger: #ef4444; --text: #1e293b; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); padding: 20px; color: var(--text); }
        .container { max-width: 550px; margin: auto; }
        .card { background: white; padding: 25px; border-radius: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.04); margin-bottom: 20px; border: 1px solid #f1f5f9; position: relative; }
        
        /* THE CHART - Visual Score Gauge */
        .chart-container { display: flex; justify-content: center; align-items: center; margin: 20px 0; }
        .circular-chart { width: 140px; height: 140px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            background: radial-gradient(closest-side, white 79%, transparent 80% 100%), 
            conic-gradient(var(--brand) <%= percentage %>%, #e2e8f0 0); }
        .chart-value { font-size: 2rem; font-weight: 800; color: var(--brand); }

        /* Collapsible Subject Report */
        .report-toggle { background: white; border: 2px solid #eff6ff; border-radius: 20px; margin-bottom: 30px; overflow: hidden; }
        .report-toggle summary { padding: 18px; font-weight: 800; font-size: 0.9rem; color: var(--text); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
        .report-toggle summary::after { content: '+'; font-size: 1.4rem; color: var(--brand); transition: 0.3s; }
        .report-toggle[open] summary::after { content: '−'; }
        .report-inner { padding: 0 18px 18px; border-top: 1px solid #f1f5f9; }
        .subj-row { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f8fafc; font-weight: 700; color: #64748b; font-size: 0.85rem; }
        .subj-val { color: var(--brand); font-weight: 800; }

        /* Review Question Card */
        .review-card { border-top: 10px solid #cbd5e1; }
        .review-card.correct-q { border-top-color: var(--success); }
        .review-card.wrong-q { border-top-color: var(--danger); }
        .q-label { font-size: 0.65rem; font-weight: 800; color: var(--brand); text-transform: uppercase; margin-bottom: 8px; display: block; }
        .q-text { font-weight: 800; font-size: 1.05rem; line-height: 1.6; margin-bottom: 20px; color: #0f172a; }

        /* THE OPTION ENGINE - Fixed Logic */
        .option-stack { display: flex; flex-direction: column; gap: 12px; }
        .opt-box { padding: 16px; border-radius: 16px; border: 2.5px solid #f1f5f9; font-weight: 700; display: flex; align-items: center; font-size: 0.95rem; position: relative; }
        .opt-letter { width: 30px; height: 30px; background: #f1f5f9; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 15px; font-weight: 800; color: #94a3b8; flex-shrink: 0; }

        /* CORRECT OPTION (Always Green) */
        .opt-box.truth { border-color: var(--success); background: #f0fdf4; color: #166534; }
        .opt-box.truth .opt-letter { background: var(--success); color: white; }
        .opt-box.truth::after { content: 'Correct Answer ✓'; position: absolute; right: 15px; font-size: 0.65rem; font-weight: 800; text-transform: uppercase; }

        /* WRONG PICK (Always Red) */
        .opt-box.mistake { border-color: var(--danger); background: #fef2f2; color: #991b1b; }
        .opt-box.mistake .opt-letter { background: var(--danger); color: white; }
        .opt-box.mistake::after { content: 'Your Choice ✗'; position: absolute; right: 15px; font-size: 0.65rem; font-weight: 800; text-transform: uppercase; }

        /* Collapsible Explanation */
        .explanation-btn { background: #f8fafc; border-radius: 16px; border: 1px solid #e2e8f0; margin-top: 20px; }
        .explanation-btn summary { padding: 14px; font-size: 0.75rem; font-weight: 800; color: #64748b; list-style: none; text-align: center; cursor: pointer; }
        .explanation-content { padding: 15px; border-top: 1px solid #e2e8f0; font-size: 0.85rem; line-height: 1.6; color: #475569; }

        .btn-finish { display: block; text-align: center; padding: 20px; background: var(--brand); color: white; text-decoration: none; border-radius: 20px; font-weight: 800; margin-top: 40px; box-shadow: 0 10px 20px rgba(0,98,255,0.2); }
    </style>
</head>
<body>

    <div class="container">
        <div class="card" style="text-align: center;">
            <span class="q-label" style="margin-bottom: 10px;">Overall Grade</span>
            <div class="chart-container">
                <div class="circular-chart">
                    <span class="chart-value"><%= percentage %>%</span>
                </div>
            </div>
            <div style="font-weight: 800; font-size: 1.1rem; color: #1e293b;">
                Score: <%= score %> / <%= total %>
            </div>
        </div>

        <details class="report-toggle">
            <summary>SUBJECT PERFORMANCE REPORT</summary>
            <div class="report-inner">
                <% Object.keys(subjectStats).forEach(subject => { %>
                    <div class="subj-row">
                        <span><%= subject %></span>
                        <span class="subj-val"><%= subjectStats[subject].correct %> / <%= subjectStats[subject].total %></span>
                    </div>
                <% }) %>
            </div>
        </details>

        <h3 style="font-weight: 800; color: #94a3b8; font-size: 0.8rem; letter-spacing: 1px; margin-bottom: 15px;">CORRECTION & ANALYSIS</h3>

        <% results.forEach((r, i) => { %>
            <div class="card review-card <%= r.isCorrect ? 'correct-q' : 'wrong-q' %>">
                <span class="q-label">Question <%= i + 1 %></span>
                <div class="q-text"><%= r.question_text %></div>

                <div class="option-stack">
                    <% ['a', 'b', 'c', 'd'].forEach(letter => { 
                        let boxClass = '';
                        // Logic: If this letter matches the correct answer in DB, mark it 'truth'
                        if(letter === r.correctAnswer) {
                            boxClass = 'truth';
                        } 
                        // Else if user picked this letter and it was wrong, mark it 'mistake'
                        else if(letter === r.userChoice && !r.isCorrect) {
                            boxClass = 'mistake';
                        }
                    %>
                        <div class="opt-box <%= boxClass %>">
                            <div class="opt-letter"><%= letter.toUpperCase() %></div>
                            <%= r['option_' + letter] %>
                        </div>
                    <% }) %>
                </div>

                <% if(r.hint || r.explanation) { %>
                    <details class="explanation-btn">
                        <summary>VIEW DETAILED SOLUTION</summary>
                        <div class="explanation-content">
                            <% if(r.hint) { %>
                                <p><b>💡 Hint:</b> <i><%= r.hint %></i></p>
                            <% } %>
                            <% if(r.explanation) { %>
                                <p><b>🔍 Analysis:</b> <%= r.explanation %></p>
                            <% } %>
                        </div>
                    </details>
                <% } %>
            </div>
        <% }) %>

        <a href="/dashboard" class="btn-finish">Finish Review</a>
    </div>

</body>
</html>
