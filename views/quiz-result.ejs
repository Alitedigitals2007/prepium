<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prepium | Results Review</title>
    <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" async></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { --brand: #0062ff; --bg: #f8fafc; --success: #22c55e; --danger: #ef4444; --text: #1e293b; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); padding: 20px; color: var(--text); }
        .container { max-width: 550px; margin: auto; }
        .card { background: white; padding: 25px; border-radius: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.04); margin-bottom: 20px; }
        
        /* Stats */
        .perc-text { font-size: 3.5rem; font-weight: 800; color: var(--brand); margin: 0; text-align: center; }
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 15px; }
        .stat-box { background: #f1f5f9; padding: 15px; border-radius: 20px; text-align: center; }
        .stat-label { font-size: 0.65rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; display: block; }
        .stat-val { font-weight: 800; font-size: 1.1rem; }

        /* Review Card Logic */
        .review-card { border-top: 8px solid #cbd5e1; position: relative; }
        .review-card.correct { border-top-color: var(--success); }
        .review-card.wrong { border-top-color: var(--danger); }
        
        .status-badge { position: absolute; top: -14px; right: 20px; padding: 4px 12px; border-radius: 20px; font-size: 0.7rem; font-weight: 800; color: white; text-transform: uppercase; }
        .correct .status-badge { background: var(--success); }
        .wrong .status-badge { background: var(--danger); }

        .q-text { font-weight: 800; margin-bottom: 20px; font-size: 1.05rem; color: #0f172a; line-height: 1.6; }
        
        /* Options Styling */
        .option-list { display: flex; flex-direction: column; gap: 10px; }
        .opt-item { padding: 14px; border-radius: 14px; border: 2px solid #f1f5f9; font-size: 0.9rem; font-weight: 600; display: flex; align-items: center; transition: 0.2s; }
        .opt-item b { margin-right: 12px; opacity: 0.4; font-weight: 800; }
        
        /* Correct Option State */
        .opt-item.correct-ans { border-color: var(--success); background: #f0fdf4; color: #166534; }
        .opt-item.correct-ans b { opacity: 1; color: var(--success); }
        
        /* User Wrong Selection State */
        .opt-item.user-wrong { border-color: var(--danger); background: #fef2f2; color: #991b1b; }
        .opt-item.user-wrong b { opacity: 1; color: var(--danger); }

        /* Expansion Panels */
        details { background: #f8fafc; border-radius: 16px; border: 1px solid #e2e8f0; margin-top: 20px; cursor: pointer; overflow: hidden; }
        summary { padding: 14px; font-size: 0.8rem; font-weight: 800; color: var(--brand); list-style: none; display: flex; justify-content: space-between; align-items: center; }
        .details-content { padding: 15px; font-size: 0.85rem; color: #475569; border-top: 1px solid #e2e8f0; line-height: 1.5; }
        .hint-pill { background: #fef9c3; color: #854d0e; padding: 4px 10px; border-radius: 8px; font-weight: 800; font-size: 0.65rem; display: inline-block; margin-bottom: 10px; }

        .btn-done { display: block; text-align: center; padding: 20px; background: var(--brand); color: white; text-decoration: none; border-radius: 20px; font-weight: 800; margin: 40px 0; box-shadow: 0 10px 20px rgba(0,98,255,0.2); }
    </style>
</head>
<body>

    <div class="container">
        <div class="card" style="text-align: center;">
            <span class="stat-label">Overall Performance</span>
            <h1 class="perc-text"><%= percentage %>%</h1>
            <div class="stats-grid">
                <div class="stat-box">
                    <span class="stat-label">Score</span>
                    <span class="stat-val"><%= score %> / <%= total %></span>
                </div>
                <div class="stat-box">
                    <span class="stat-label">Duration</span>
                    <span class="stat-val"><%= timeUsed %></span>
                </div>
            </div>
        </div>

        <h3 style="font-weight: 800; margin: 30px 0 15px 5px; color: #64748b; font-size: 0.9rem;">DETAILED REVIEW</h3>

        <% results.forEach((r, i) => { %>
            <div class="card review-card <%= r.isCorrect ? 'correct' : 'wrong' %>">
                <div class="status-badge"><%= r.isCorrect ? 'Correct' : 'Incorrect' %></div>
                
                <div class="q-text">
                    <small style="color: var(--brand); display: block; margin-bottom: 5px;">Question <%= i + 1 %></small>
                    <%= r.question_text %>
                </div>

                <div class="option-list">
                    <% ['a', 'b', 'c', 'd'].forEach(letter => { 
                        let itemClass = '';
                        if(letter === r.correctAnswer) itemClass = 'correct-ans';
                        if(letter === r.userChoice && !r.isCorrect) itemClass = 'user-wrong';
                    %>
                        <div class="opt-item <%= itemClass %>">
                            <b><%= letter.toUpperCase() %></b>
                            <%= r['option_' + letter] %>
                            
                            <% if(letter === r.correctAnswer) { %>
                                <span style="margin-left: auto;">LHS ✓</span>
                            <% } else if(letter === r.userChoice) { %>
                                <span style="margin-left: auto;">Your Choice ✗</span>
                            <% } %>
                        </div>
                    <% }) %>
                </div>

                <% if(r.hint || r.explanation) { %>
                    <details>
                        <summary>
                            <span>SOLUTION & HINT</span>
                            <span style="font-size: 1.2rem;">+</span>
                        </summary>
                        <div class="details-content">
                            <% if(r.hint) { %>
                                <div class="hint-pill">EXAM HINT</div>
                                <p style="margin-top: 0;"><i><%= r.hint %></i></p>
                            <% } %>
                            
                            <% if(r.explanation) { %>
                                <p style="margin-bottom: 0;">
                                    <b style="color: var(--text);">Step-by-Step:</b><br>
                                    <%= r.explanation %>
                                </p>
                            <% } %>
                        </div>
                    </details>
                <% } %>
            </div>
        <% }) %>

        <a href="/dashboard" class="btn-done">Complete Review</a>
    </div>

</body>
</html>
