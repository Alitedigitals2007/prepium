<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Advanced Premium Dashboard</title>
    
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0062ff">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root { 
            --brand: #0062ff; 
            --brand-gradient: linear-gradient(135deg, #0062ff 0%, #0045b5 100%);
            --accent: #4f46e5;
            --bg: #f8fafc; 
            --surface: rgba(255, 255, 255, 0.45);
            --text-dark: #0f172a; 
            --text-sub: #64748b;
            --border: rgba(226, 232, 240, 0.6);
            --glass-border: rgba(255, 255, 255, 0.7);
            --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.02);
            --shadow-md: 0 12px 30px rgba(15, 23, 42, 0.04);
            --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            
            --crazy-bg: radial-gradient(circle at top right, #0f172a 0%, #1e1b4b 50%, #020617 100%);
            --crazy-surface: rgba(15, 23, 42, 0.45);
            --crazy-border: rgba(99, 102, 241, 0.3);
            --crazy-glass-border: rgba(255, 255, 255, 0.15);
            --crazy-text: #f8fafc;
            --crazy-glow: 0 0 20px rgba(99, 102, 241, 0.4);
        }

        * { 
            box-sizing: border-box; 
            -webkit-tap-highlight-color: transparent; 
            margin: 0; padding: 0;
        }
        
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: radial-gradient(circle at top right, #eff6ff 0%, #dbeafe 40%, #e2e8f0 100%);
            background-attachment: fixed;
            color: var(--text-dark); 
            display: flex; 
            justify-content: center; 
            min-height: 100vh;
            transition: background 0.5s ease, color 0.3s ease;
        }

        body.crazy-active {
            background: var(--crazy-bg);
            background-attachment: fixed;
            color: var(--crazy-text);
        }

        .app-shell { 
            width: 100%; 
            max-width: 430px; 
            background: rgba(248, 250, 252, 0.6); 
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            min-height: 100vh; 
            position: relative; 
            padding-bottom: 120px;
            box-shadow: 0 0 40px rgba(0, 98, 255, 0.05);
            border-left: 1px solid var(--glass-border);
            border-right: 1px solid var(--glass-border);
            transition: background 0.5s ease, border 0.5s ease;
        }
        body.crazy-active .app-shell {
            background: rgba(15, 23, 42, 0.6);
            border-left: 1px solid var(--crazy-glass-border);
            border-right: 1px solid var(--crazy-glass-border);
        }

        /* Header UI */
        .header-nav { 
            padding: 1.75rem 1.5rem 0.5rem; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
        }
        .logo { 
            font-weight: 800; 
            font-size: 1.4rem; 
            letter-spacing: -1px; 
            color: var(--text-dark); 
            text-decoration: none; 
        }
        body.crazy-active .logo { color: var(--crazy-text); }
        .logo span { color: var(--brand); }

        .top-action-cluster { display: flex; align-items: center; gap: 10px; }

        .crazy-toggle-btn {
            width: 42px; height: 42px;
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid var(--glass-border);
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; color: #f59e0b; font-size: 1.1rem;
            box-shadow: var(--shadow-sm); transition: var(--transition);
        }
        body.crazy-active .crazy-toggle-btn {
            background: rgba(30, 27, 75, 0.8); border-color: var(--crazy-glass-border); color: #a855f7;
        }

        .profile-trigger {
            width: 42px; height: 42px; 
            background: rgba(255, 255, 255, 0.8); border: 1px solid var(--glass-border);
            border-radius: 14px; display: flex; align-items: center; justify-content: center;
            font-weight: 700; color: var(--brand); text-decoration: none;
            box-shadow: var(--shadow-sm);
        }
        body.crazy-active .profile-trigger {
            background: rgba(30, 27, 75, 0.8); border-color: var(--crazy-glass-border); color: #6366f1;
        }

        /* Status Pills */
        .meta-status-row { padding: 0 1.5rem 1rem; display: flex; gap: 10px; align-items: center; }
        .live-pill {
            background: rgba(0, 98, 255, 0.1); border: 1px solid rgba(0, 98, 255, 0.15);
            padding: 4px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 700;
            color: var(--brand); display: flex; align-items: center; gap: 6px;
        }
        body.crazy-active .live-pill { background: rgba(99, 102, 241, 0.2); border-color: rgba(99, 102, 241, 0.3); color: #818cf8; }

        /* Typography */
        .hero-section { padding: 0.5rem 1.5rem 1rem; }
        .hero-section h1 { font-size: 1.65rem; font-weight: 800; letter-spacing: -0.5px; color: var(--text-dark); }
        body.crazy-active .hero-section h1 { color: var(--crazy-text); }
        
        .quote-box {
            margin: 0 1.5rem 1.5rem; padding: 14px 18px;
            background: rgba(255, 255, 255, 0.5); border: 1px solid var(--glass-border); border-radius: 18px;
            display: flex; gap: 10px;
        }
        body.crazy-active .quote-box { background: rgba(15, 23, 42, 0.4); border-color: var(--crazy-glass-border); }
        .quote-box i { color: var(--brand); font-size: 0.85rem; margin-top: 3px; opacity: 0.7; }
        body.crazy-active .quote-box i { color: #6366f1; }
        .quote-text { font-size: 0.78rem; color: var(--text-sub); font-weight: 600; line-height: 1.4; }
        body.crazy-active .quote-text { color: #94a3b8; }

        /* Premium Gate Banners */
        <% if (!user.has_paid) { %>
        .premium-card {
            margin: 0 1.5rem 1.5rem; padding: 24px; 
            background: var(--brand-gradient); border-radius: 24px; color: white; 
            box-shadow: 0 12px 25px rgba(0, 98, 255, 0.15);
        }
        body.crazy-active .premium-card { background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); }
        .premium-card h3 { font-size: 1.15rem; font-weight: 800; }
        .premium-card p { font-size: 0.85rem; opacity: 0.9; margin: 6px 0 16px; font-weight: 500; }
        .upgrade-btn {
            background: #ffffff; color: var(--brand); border: none; padding: 12px 22px; 
            border-radius: 14px; font-weight: 800; font-size: 0.85rem; cursor: pointer; transition: var(--transition);
        }
        body.crazy-active .upgrade-btn { color: #4f46e5; }
        <% } %>

        .challenge-hub {
            margin: 0 1.5rem 1.75rem; padding: 20px;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); border-radius: 24px; 
            display: flex; align-items: center; justify-content: space-between; color: white; text-decoration: none;
        }
        body.crazy-active .challenge-hub { background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); }
        .challenge-icon-box { width: 44px; height: 44px; background: rgba(255, 255, 255, 0.2); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }

        /* Titles Headers */
        .section-header { padding: 0.5rem 1.5rem 0.75rem; display: flex; justify-content: space-between; align-items: center; }
        .section-header h2 { font-size: 1.05rem; font-weight: 800; color: var(--text-dark); letter-spacing: -0.3px; }
        body.crazy-active .section-header h2 { color: var(--crazy-text); }

        /* SPACIOUS UNIFIED GRID SYSTEM CODES */
        .grid-wrapper { padding: 0 1.5rem 2rem; }
        .clean-dashboard-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        /* Glass Cards Components Layout */
        .glass-card {
            background: var(--surface);
            backdrop-filter: blur(20px) saturate(140%);
            -webkit-backdrop-filter: blur(20px) saturate(140%);
            border: 1px solid var(--glass-border);
            padding: 20px 16px; border-radius: 24px; text-decoration: none;
            display: flex; flex-direction: column; position: relative;
            box-shadow: 0 8px 24px rgba(148, 163, 184, 0.06);
            transition: var(--transition);
        }
        body.crazy-active .glass-card { background: var(--crazy-surface); border-color: var(--crazy-border); }
        .glass-card:not(.locked):active { transform: scale(0.96); background: rgba(255, 255, 255, 0.75); }

        .highlight-border { border-left: 3px solid var(--brand); }
        body.crazy-active .highlight-border { border-left-color: #6366f1; }

        .item-icon {
            width: 42px; height: 42px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem; margin-bottom: 14px;
            background: #ffffff; color: var(--brand);
            border: 1px solid var(--border); flex-shrink: 0;
        }
        body.crazy-active .item-icon { background: #1e1b4b; color: #818cf8; border-color: var(--crazy-border); }

        .glass-card b { font-size: 0.92rem; font-weight: 800; color: var(--text-dark); letter-spacing: -0.1px; line-height: 1.2; }
        body.crazy-active .glass-card b { color: var(--crazy-text); }
        .glass-card span { font-size: 0.72rem; color: var(--text-sub); font-weight: 600; margin-top: 5px; line-height: 1.3; }
        body.crazy-active .glass-card span { color: #94a3b8; }

        /* Global Security Locks Design Overlay */
        .locked::after {
            content: '\f023'; font-family: "Font Awesome 6 Free"; font-weight: 900;
            position: absolute; top: 16px; right: 16px; 
            color: #94a3b8; font-size: 0.68rem;
            background: #ffffff; width: 22px; height: 22px; border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            border: 1px solid var(--border); box-shadow: var(--shadow-sm);
        }
        body.crazy-active .locked::after { background: #0f172a; border-color: var(--crazy-border); color: #64748b; }
        .locked .item-icon { background: rgba(226, 232, 240, 0.7) !important; color: #94a3b8 !important; box-shadow: none !important; }

        /* Navigation Systems Footer */
        .bottom-nav {
            position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
            width: calc(100% - 32px); max-width: 398px;
            background: rgba(255, 255, 255, 0.65); backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px);
            height: 74px; border-radius: 24px; display: flex; align-items: center;
            box-shadow: 0 16px 35px rgba(0, 98, 255, 0.08); border: 1px solid var(--glass-border); z-index: 1000;
            transition: background 0.5s ease, border 0.5s ease;
        }
        body.crazy-active .bottom-nav { background: rgba(15, 23, 42, 0.75); border-color: var(--crazy-border); }
        
        .nav-link { 
            text-decoration: none; 
            color: var(--text-sub); 
            text-align: center; 
            flex: 1; 
            font-weight: 700; 
            cursor: pointer; 
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .nav-link.active { color: var(--brand); }
        body.crazy-active .nav-link.active { color: #818cf8; }
        .nav-link i { font-size: 1.15rem; display: block; margin-bottom: 4px; }
        .nav-link span { font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.5px; }
        
        /* Interactive Notification Badge Dot */
        .nav-link .notification-dot {
            position: absolute;
            top: 4px;
            right: 28px;
            background-color: #ef4444;
            color: #ffffff;
            font-size: 0.55rem;
            font-weight: 800;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: 1.5px solid #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        body.crazy-active .nav-link .notification-dot { border-color: #1e1b4b; }

        .nav-center-btn {
            width: 54px; height: 54px; background: var(--brand); border-radius: 18px;
            display: flex; align-items: center; justify-content: center; color: white; font-size: 1.35rem; 
            transform: translateY(-22px); border: 4px solid #f1f5f9; box-shadow: 0 8px 20px rgba(0, 98, 255, 0.2);
            text-decoration: none;
        }
        body.crazy-active .nav-center-btn { background: #6366f1; border-color: #0f172a; box-shadow: var(--crazy-glow); }

        /* Overlay Layout All Pages Navigator */
        .master-navigator {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.3); backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px);
            z-index: 9999; display: flex; justify-content: center; align-items: center;
            opacity: 0; pointer-events: none; transition: opacity 0.4s ease; padding: 24px;
        }
        .master-navigator.show { opacity: 1; pointer-events: auto; }
        .navigator-content {
            background: rgba(255, 255, 255, 0.88); border: 1px solid rgba(255, 255, 255, 0.6);
            width: 100%; max-width: 380px; border-radius: 32px; padding: 24px;
            max-height: 80vh; overflow-y: auto; scrollbar-width: none;
        }
        .navigator-content::-webkit-scrollbar { display: none; }
        body.crazy-active .navigator-content { background: rgba(15, 23, 42, 0.95); border-color: var(--crazy-border); }
        .navigator-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid rgba(0,0,0,0.06); }
        body.crazy-active .navigator-header { border-bottom-color: rgba(255,255,255,0.1); }
        .navigator-header h3 { font-size: 1.15rem; font-weight: 800; }
        body.crazy-active .navigator-header h3 { color: white; }
        .close-navigator-btn { width: 32px; height: 32px; border-radius: 50%; background: rgba(0,0,0,0.05); display: flex; align-items: center; justify-content: center; cursor: pointer; }
        body.crazy-active .close-navigator-btn { background: rgba(255,255,255,0.1); color: white; }
        .navigator-links-stack { display: flex; flex-direction: column; gap: 8px; }
        .navigator-row-item { display: flex; align-items: center; gap: 14px; padding: 12px 16px; background: rgba(255, 255, 255, 0.6); border: 1px solid rgba(255, 255, 255, 0.5); border-radius: 16px; text-decoration: none; color: var(--text-dark); }
        body.crazy-active .navigator-row-item { background: rgba(30, 27, 75, 0.4); border-color: rgba(255,255,255,0.05); color: white; }
        .navigator-row-item i { font-size: 1.05rem; color: var(--brand); width: 24px; text-align: center; }
        body.crazy-active .navigator-row-item i { color: #818cf8; }
        .navigator-row-item div b { font-size: 0.88rem; font-weight: 700; display: block; }
        .navigator-row-item div span { font-size: 0.72rem; color: var(--text-sub); }
        body.crazy-active .navigator-row-item div span { color: #94a3b8; }
        .navigator-row-item.nav-locked { opacity: 0.55; }

        /* Floating Deadline Tracker Button */
        .deadline-fab {
            position: fixed; bottom: 100px; right: 20px;
            width: 56px; height: 56px; border-radius: 18px;
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white; border: none; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem; z-index: 1001;
            box-shadow: 0 8px 24px rgba(239, 68, 68, 0.35);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .deadline-fab:active { transform: scale(0.92); }
        .deadline-fab .fab-badge {
            position: absolute; top: -4px; right: -4px;
            background: #1e1b4b; color: white;
            font-size: 0.6rem; font-weight: 800;
            width: 20px; height: 20px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            border: 2px solid white;
        }

        /* Deadline Overlay Sheet */
        .deadline-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            z-index: 9998; display: flex; justify-content: center; align-items: flex-end;
            opacity: 0; pointer-events: none; transition: opacity 0.35s ease;
        }
        .deadline-overlay.show { opacity: 1; pointer-events: auto; }

        .deadline-sheet {
            background: white; width: 100%; max-width: 430px;
            border-radius: 28px 28px 0 0; padding: 0;
            max-height: 85vh; overflow: hidden;
            transform: translateY(100%); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex; flex-direction: column;
        }
        .deadline-overlay.show .deadline-sheet { transform: translateY(0); }

        .sheet-handle {
            width: 40px; height: 4px; border-radius: 4px;
            background: #e2e8f0; margin: 12px auto 0;
        }
        .sheet-header {
            display: flex; justify-content: space-between; align-items: center;
            padding: 16px 20px 12px; border-bottom: 1px solid #f1f5f9;
        }
        .sheet-header h3 { font-size: 1.05rem; font-weight: 800; margin: 0; }
        .sheet-close {
            width: 32px; height: 32px; border-radius: 50%;
            background: #f1f5f9; border: none; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            color: #64748b; font-size: 0.85rem;
        }

        .sheet-body {
            overflow-y: auto; padding: 16px 20px 24px;
            flex: 1; scrollbar-width: none;
        }
        .sheet-body::-webkit-scrollbar { display: none; }

        /* Quick Add Form inside overlay */
        .quick-add-form {
            display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
            margin-bottom: 20px; padding: 16px;
            background: #f8fafc; border-radius: 20px; border: 1px solid #eef2f6;
        }
        .quick-add-form .qa-group { margin-bottom: 0; }
        .quick-add-form .qa-group.full { grid-column: span 2; }
        .quick-add-form label {
            display: block; font-size: 0.6rem; font-weight: 800;
            color: #a3aed0; text-transform: uppercase; margin-bottom: 4px;
        }
        .quick-add-form input {
            width: 100%; padding: 10px 12px; border-radius: 12px;
            border: 1px solid #eef2f6; font-family: inherit;
            font-weight: 600; font-size: 0.8rem; background: white;
        }
        .quick-add-form input:focus { border-color: var(--brand); outline: none; }
        .quick-add-form button {
            grid-column: span 2; padding: 12px; border-radius: 14px;
            background: var(--brand); color: white; border: none;
            font-weight: 800; font-size: 0.82rem; cursor: pointer;
            margin-top: 4px;
        }

        /* Mini Deadline Cards in overlay */
        .mini-deadline-card {
            display: flex; align-items: center; gap: 12px;
            padding: 14px; background: white; border: 1px solid #eef2f6;
            border-radius: 18px; margin-bottom: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.01);
        }
        .mini-deadline-card.expired {
            border-color: #fff1f0; background: #fffafb;
        }
        .mini-avatar {
            width: 40px; height: 40px; border-radius: 12px;
            background: #fef2f2; color: #ef4444;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; font-size: 0.95rem; flex-shrink: 0;
        }
        .mini-card-content { flex: 1; min-width: 0; }
        .mini-card-title { font-size: 0.85rem; font-weight: 700; margin: 0 0 3px; }
        .mini-card-meta { font-size: 0.65rem; color: #a3aed0; font-weight: 600; }
        .mini-countdown {
            display: inline-flex; align-items: center; gap: 4px;
            background: #eef2f6; padding: 4px 10px; border-radius: 8px;
            font-size: 0.7rem; font-weight: 800;
        }
        .mini-countdown.urgent { background: #fef2f2; color: #ef4444; }
        .mini-countdown.expired { background: #ef4444; color: white; }
        .mini-delete {
            background: none; border: none; color: #cbd5e1;
            padding: 8px; font-size: 0.85rem; cursor: pointer;
        }
        .mini-delete:hover { color: #ef4444; }
        .mini-empty { text-align: center; padding: 30px 0; color: #a3aed0; }
        .mini-empty i { font-size: 2rem; margin-bottom: 8px; display: block; opacity: 0.3; }
    </style>
</head>
<body>

    <div class="app-shell">
        <header class="header-nav">
            <a href="/dashboard" class="logo">Prepium<span>.</span></a>
            <div class="top-action-cluster">
                <div class="crazy-toggle-btn" id="toggle-crazy-mode">
                    <i class="fas fa-moon"></i>
                </div>
                <a href="/profile" class="profile-trigger">
                    <%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %>
                </a>
            </div>
        </header>

        <div class="meta-status-row">
            <div class="live-pill"><i class="fas fa-clock"></i> <span id="live-time-display">00:00:00</span></div>
            <div class="live-pill" style="background:rgba(79, 70, 229, 0.1); color:var(--accent); border-color:rgba(79, 70, 229, 0.15)">
                <i class="fas fa-calendar"></i> <span id="live-date-display">Date</span>
            </div>
        </div>

        <section class="hero-section">
            <h1 id="greeting-field">Hello, Student 👋</h1>
        </section>

        <div class="quote-box">
            <i class="fas fa-quote-left"></i>
            <div class="quote-text" id="quote-field">"Loading strategic quotes engine..."</div>
        </div>

        <% if (!user.has_paid) { %>
            <div class="premium-card">
                <h3>Upgrade to Premium</h3>
                <p>Unlock Study Library, Audio Podcasts, CGPA Trackers, and AI engines for <b>₦1,000</b>.</p>
                <button onclick="payWithPaystack()" id="pay-btn" class="upgrade-btn">Get Full Access</button>
            </div>
        <% } %>

        <a href="/daily-challenge" class="challenge-hub">
            <div style="display: flex; align-items: center; gap: 14px;">
                <div class="challenge-icon-box"><i class="fas fa-fire-alt"></i></div>
                <div>
                    <h4 style="font-weight:800; font-size: 0.95rem;">Daily Challenge</h4>
                    <p style="font-size:0.75rem; opacity:0.9; margin-top:2px;">Compete live with peers</p>
                </div>
            </div>
            <i class="fas fa-chevron-right" style="opacity: 0.8; font-size: 0.8rem;"></i>
        </a>

        <div class="section-header">
            <h2>Academic Workspace</h2>
        </div>
        
        <div class="grid-wrapper">
            <div class="clean-dashboard-grid">
                
                <a href="/setup-test" class="glass-card highlight-border">
                    <div class="item-icon"><i class="fas fa-bolt"></i></div>
                    <b>Practice Quiz</b>
                    <span><%= user.has_paid ? 'Unlimited Mode' : (2 - user.quiz_attempts) + ' Free Left' %></span>
                </a>

                <a href="<%= user.has_paid ? '/ai-quiz' : '#' %>" class="glass-card <%= !user.has_paid ? 'locked' : '' %>" onclick="<%= !user.has_paid ? 'payWithPaystack()' : '' %>">
                    <div class="item-icon"><i class="fas fa-robot"></i></div>
                    <b>AI Quiz Bot</b>
                    <span>PDF parsing to CBT exam sets</span>
                </a>

                <a href="<%= user.has_paid ? '/cgpa' : '#' %>" class="glass-card <%= !user.has_paid ? 'locked' : '' %>" onclick="<%= !user.has_paid ? 'payWithPaystack()' : '' %>">
                    <div class="item-icon" style="color: #0284c7;"><i class="fas fa-chart-line"></i></div>
                    <b>CGPA Tracker</b>
                    <span>Target calculation and profile analysis</span>
                </a>

                <a href="/deadlines" class="glass-card">
                    <div class="item-icon" style="color: #ef4444;"><i class="fas fa-hourglass-half"></i></div>
                    <b>Deadline Tracker</b>
                    <span>Track execution milestones</span>
                </a>

                <a href="<%= user.has_paid ? '/subjects' : '#' %>" class="glass-card <%= !user.has_paid ? 'locked' : '' %>" onclick="<%= !user.has_paid ? 'payWithPaystack()' : '' %>">
                    <div class="item-icon" style="color: #ea580c;"><i class="fas fa-book-open"></i></div>
                    <b>Study Library</b>
                    <span>Course notebooks and structural references</span>
                </a>

                <a href="<%= user.has_paid ? '/competition' : '#' %>" class="glass-card <%= !user.has_paid ? 'locked' : '' %>" onclick="<%= !user.has_paid ? 'payWithPaystack()' : '' %>">
                    <div class="item-icon" style="color: #e11d48;"><i class="fas fa-trophy"></i></div>
                    <b>Live Arena</b>
                    <span>Realtime scores metrics ranking panels</span>
                </a>

                <a href="<%= user.has_paid ? '/pomodoro' : '#' %>" class="glass-card" onclick="<%= !user.has_paid ? 'payWithPaystack()' : '' %>">
                    <div class="item-icon"><i class="fas fa-stopwatch"></i></div>
                    <b>Pomodoro</b>
                    <span>Structured execution focus timers</span>
                </a>

                <a href="https://alitedigitals.vercel.app/projects" target="_blank" class="glass-card">
                    <div class="item-icon" style="color: #d97706;"><i class="fas fa-shopping-cart"></i></div>
                    <b>Alite Store</b>
                    <span>Utilities marketplace storefront</span>
                </a>

                <a href="/suggestions" class="glass-card">
                    <div class="item-icon"><i class="fas fa-pen-fancy"></i></div>
                    <b>Feedback</b>
                    <span>Submit software enhancement advice</span>
                </a>

            </div>
        </div>

        <!-- Floating Deadline Tracker Button -->
        <% if (user.has_paid) { %>
        <button class="deadline-fab" id="deadline-fab" onclick="openDeadlineOverlay()">
            <i class="fas fa-hourglass-half"></i>
            <% if (typeof upcomingDeadlines !== 'undefined' && upcomingDeadlines > 0) { %>
            <div class="fab-badge"><%= upcomingDeadlines %></div>
            <% } %>
        </button>
        <% } %>

        <!-- Deadline Tracker Overlay -->
        <div class="deadline-overlay" id="deadline-overlay">
            <div class="deadline-sheet">
                <div class="sheet-handle"></div>
                <div class="sheet-header">
                    <h3><i class="fas fa-hourglass-half" style="color:#ef4444;"></i> Arena Tracker</h3>
                    <button class="sheet-close" onclick="closeDeadlineOverlay()"><i class="fas fa-times"></i></button>
                </div>
                <div class="sheet-body">
                    <form class="quick-add-form" id="quick-deadline-form" onsubmit="submitQuickDeadline(event)">
                        <div class="qa-group full">
                            <label>Task Title</label>
                            <input type="text" name="title" required placeholder="e.g. GST 101 Assignment" maxlength="40">
                        </div>
                        <div class="qa-group">
                            <label>Date</label>
                            <input type="date" name="due_date" id="qa-date" required>
                        </div>
                        <div class="qa-group">
                            <label>Time</label>
                            <input type="time" name="due_time" id="qa-time" required>
                        </div>
                        <button type="submit"><i class="fas fa-plus"></i> Add Target</button>
                    </form>

                    <div id="overlay-deadline-list">
                        <div class="mini-empty"><i class="fas fa-hourglass-end"></i><p>Loading...</p></div>
                    </div>
                </div>
            </div>
        </div>

        <nav class="bottom-nav">
            <a href="/dashboard" class="nav-link active">
                <i class="fas fa-home"></i>
                <span>Home</span>
            </a>
            <a href="/history" class="nav-link">
                <i class="fas fa-chart-bar"></i>
                <span>Stats</span>
            </a>
            <a href="/setup-test" class="nav-center-btn"><i class="fas fa-plus"></i></a>
            <a href="/notifications" class="nav-link" id="trigger-notifications">
                <% if (unreadNotifs > 0) { %>
                <div class="notification-dot"><%= unreadNotifs %></div>
                <% } %>
                <i class="fas fa-bell"></i>
                <span>Notification</span>
            </a>
            <a href="/profile" class="nav-link">
                <i class="fas fa-user-circle"></i>
                <span>Profile</span>
            </a>
        </nav>
    </div>

    <div class="master-navigator" id="navigator-overlay">
        <div class="navigator-content">
            <div class="navigator-header">
                <h3>Notifications</h3>
                <div class="close-navigator-btn" id="close-navigator"><i class="fas fa-times"></i></div>
            </div>
            <div class="navigator-links-stack">
                <div class="navigator-row-item">
                    <i class="fas fa-bolt" style="color: #eab308;"></i>
                    <div><b>Quiz Performance</b><span>Your performance profile analytics are updated.</span></div>
                </div>
                <div class="navigator-row-item">
                    <i class="fas fa-gift" style="color: #ec4899;"></i>
                    <div><b>Premium Features</b><span>Access tailored mock templates dynamically instantly.</span></div>
                </div>
                <div class="navigator-row-item">
                    <i class="fas fa-star" style="color: #3b82f6;"></i>
                    <div><b>New Study Assets</b><span>Fresh physics and electronics reference kits dropped.</span></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const userName = "<%= user.fullname ? user.fullname.split(' ')[0] : 'Student' %>";
        
        function updateTimeAndGreeting() {
            const now = new Date();
            let hours = now.getHours();
            let minutes = now.getMinutes();
            let seconds = now.getSeconds();
            minutes = minutes < 10 ? '0' + minutes : minutes;
            seconds = seconds < 10 ? '0' + seconds : seconds;
            document.getElementById('live-time-display').innerText = `${hours}:${minutes}:${seconds}`;
            
            const options = { month: 'short', day: 'numeric' };
            document.getElementById('live-date-display').innerText = now.toLocaleDateString('en-US', options);

            let greeting = "Good day";
            if (hours < 12) greeting = "Good morning";
            else if (hours < 16) greeting = "Good afternoon";
            else greeting = "Good evening";
            
            document.getElementById('greeting-field').innerHTML = `${greeting}, ${userName} 👋`;
        }
        setInterval(updateTimeAndGreeting, 1000);
        updateTimeAndGreeting();

        const academicQuotes = [
            "Your commitment to continuous learning builds structural momentum for future goals.",
            "Consistency scales faster over time than sporadic intensive efforts. Keep showing up.",
            "Excellence is an architectural pattern formed through incremental daily focus loops.",
            "Great developers and exceptional scientists are forged by resolving complex issues.",
            "Do not wish for lighter tasks; engineer a highly streamlined focus strategy instead.",
            "Every practice exam completed scales your absolute error tolerance downwards."
        ];
        function injectRandomQuote() {
            const randomIndex = Math.floor(Math.random() * academicQuotes.length);
            document.getElementById('quote-field').innerText = `"${academicQuotes[randomIndex]}"`;
        }
        injectRandomQuote();

        const toggleCrazyBtn = document.getElementById('toggle-crazy-mode');
        toggleCrazyBtn.addEventListener('click', () => {
            document.body.classList.toggle('crazy-active');
            const icon = toggleCrazyBtn.querySelector('i');
            icon.className = document.body.classList.contains('crazy-active') ? 'fas fa-sun' : 'fas fa-moon';
        });

        const overlay = document.getElementById('navigator-overlay');
       
        notifLink.addEventListener('click', (e) => { 
            e.preventDefault(); 
            overlay.classList.add('show'); 
            const badge = notifLink.querySelector('.notification-dot');
            if (badge) badge.style.display = 'none';
        });
        
        document.getElementById('close-navigator').addEventListener('click', () => { overlay.classList.remove('show'); });
        overlay.addEventListener('click', (e) => { if(e.target === overlay) overlay.classList.remove('show'); });

        function payWithPaystack() {
            const btn = document.getElementById('pay-btn');
            if (btn) { btn.innerHTML = "Opening Gateway..."; btn.disabled = true; }
            let handler = PaystackPop.setup({
                key: '<%= paystack_key %>',
                email: '<%= user.email %>',
                amount: 1000 * 100, 
                currency: 'NGN',
                callback: function(response) { window.location.href = "/verify-payment?reference=" + response.reference; },
                onClose: function() { if (btn) { btn.innerHTML = "Get Full Access"; btn.disabled = false; } }
            });
            handler.openIframe();
        }

        // Deadline Overlay Functions
        function openDeadlineOverlay() {
            const overlay = document.getElementById('deadline-overlay');
            overlay.classList.add('show');
            loadOverlayDeadlines();
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('qa-date').value = today;
            document.getElementById('qa-time').value = '12:00';
        }

        function closeDeadlineOverlay() {
            document.getElementById('deadline-overlay').classList.remove('show');
        }

        document.getElementById('deadline-overlay').addEventListener('click', function(e) {
            if (e.target === this) closeDeadlineOverlay();
        });

        async function loadOverlayDeadlines() {
            try {
                const res = await fetch('/api/deadlines');
                const data = await res.json();
                const list = document.getElementById('overlay-deadline-list');

                if (!data.deadlines || data.deadlines.length === 0) {
                    list.innerHTML = '<div class="mini-empty"><i class="fas fa-hourglass-end"></i><p>No active targets</p></div>';
                    return;
                }

                list.innerHTML = data.deadlines.map(dl => {
                    const target = new Date(dl.date_str + 'T' + dl.time_str).getTime();
                    const now = Date.now();
                    const diff = target - now;
                    const isExpired = diff <= 0;

                    let countdownHtml = '';
                    if (isExpired) {
                        countdownHtml = '<span class="mini-countdown expired"><i class="fas fa-clock"></i> Expired</span>';
                    } else {
                        const d = Math.floor(diff / 86400000);
                        const h = Math.floor((diff % 86400000) / 3600000);
                        const m = Math.floor((diff % 3600000) / 60000);
                        const text = d > 0 ? `${d}d ${h}h ${m}m` : `${h}h ${m}m`;
                        const urgent = diff < 3600000;
                        countdownHtml = `<span class="mini-countdown ${urgent ? 'urgent' : ''}"><i class="fas fa-clock"></i> ${text}</span>`;
                    }

                    return `
                        <div class="mini-deadline-card ${isExpired ? 'expired' : ''}" data-id="${dl.id}">
                            <div class="mini-avatar">${dl.title.charAt(0).toUpperCase()}</div>
                            <div class="mini-card-content">
                                <p class="mini-card-title">${dl.title}</p>
                                <div class="mini-card-meta">${dl.date_str} • ${dl.time_str}</div>
                                ${countdownHtml}
                            </div>
                            <button class="mini-delete" onclick="deleteOverlayDeadline(${dl.id})" title="Delete">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    `;
                }).join('');

                // Start live countdowns in overlay
                startOverlayTimers();
            } catch (err) {
                console.error('Failed to load deadlines:', err);
            }
        }

        function startOverlayTimers() {
            setInterval(() => {
                const cards = document.querySelectorAll('.mini-deadline-card');
                const now = Date.now();
                cards.forEach(card => {
                    const meta = card.querySelector('.mini-card-meta').textContent;
                    const parts = meta.split(' • ');
                    const target = new Date(parts[0] + 'T' + parts[1]).getTime();
                    const diff = target - now;
                    const countdown = card.querySelector('.mini-countdown');
                    if (!countdown) return;

                    if (diff <= 0) {
                        countdown.className = 'mini-countdown expired';
                        countdown.innerHTML = '<i class="fas fa-clock"></i> Expired';
                        card.classList.add('expired');
                        return;
                    }
                    const d = Math.floor(diff / 86400000);
                    const h = Math.floor((diff % 86400000) / 3600000);
                    const m = Math.floor((diff % 3600000) / 60000);
                    const text = d > 0 ? `${d}d ${h}h ${m}m` : `${h}h ${m}m`;
                    const urgent = diff < 3600000;
                    countdown.className = `mini-countdown ${urgent ? 'urgent' : ''}`;
                    countdown.innerHTML = `<i class="fas fa-clock"></i> ${text}`;
                });
            }, 60000);
        }

        async function submitQuickDeadline(e) {
            e.preventDefault();
            const form = e.target;
            const data = Object.fromEntries(new FormData(form));

            try {
                const res = await fetch('/deadlines/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams(data)
                });
                if (res.ok) {
                    form.reset();
                    loadOverlayDeadlines();
                }
            } catch (err) {
                console.error('Failed to add deadline:', err);
            }
        }

        async function deleteOverlayDeadline(id) {
            if (!confirm('Remove this target?')) return;
            try {
                await fetch(`/deadlines/delete/${id}`, { method: 'POST' });
                loadOverlayDeadlines();
            } catch (err) {
                console.error('Failed to delete:', err);
            }
        }
    </script>
    <%- include('partials/pomodoro-overlay') %>
</body>
</html>