<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Student Dashboard</title>
    
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root { 
            --brand: #0062ff; 
            --brand-gradient: linear-gradient(135deg, #0062ff 0%, #0045b5 100%);
            --accent: #7c3aed;
            --bg: #f8fafc; 
            --text-dark: #0b1437; 
            --text-sub: #a3aed0;
            --border: #eef2f6;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; transition: all 0.2s ease; outline: none; }
        
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: var(--bg); margin: 0; color: var(--text-dark); 
            display: flex; justify-content: center; 
        }

        .app-shell { 
            width: 100%; max-width: 430px; 
            background: #ffffff; min-height: 100vh; 
            position: relative; padding-bottom: 110px;
            box-shadow: 0 0 40px rgba(0,0,0,0.02);
        }

        /* Top Navigation Header */
        .header-nav { padding: 2rem 1.5rem 1rem; display: flex; justify-content: space-between; align-items: center; }
        .logo { font-weight: 800; font-size: 1.4rem; letter-spacing: -1px; color: var(--text-dark); text-decoration: none; }
        .logo span { color: var(--brand); }

        .profile-trigger {
            width: 45px; height: 45px; background: #f1f5f9; border: 1.5px solid var(--border);
            border-radius: 14px; display: flex; align-items: center; justify-content: center;
            font-weight: 700; color: var(--brand); text-decoration: none;
        }

        /* Hero Message */
        .hero-section { padding: 0 1.5rem 1.5rem; }
        .hero-section h1 { font-size: 1.7rem; font-weight: 800; margin: 0; letter-spacing: -0.5px; }
        .hero-section p { color: var(--text-sub); font-size: 0.9rem; margin: 5px 0 0; font-weight: 500; }

        /* Premium Upgrade Banner */
        <% if (!user.has_paid) { %>
        .premium-card {
            margin: 0 1.5rem 1.5rem; padding: 24px; background: var(--brand-gradient);
            border-radius: 28px; color: white; position: relative; overflow: hidden;
            box-shadow: 0 12px 25px rgba(0, 98, 255, 0.2);
        }
        .premium-card h3 { font-size: 1.2rem; margin: 0; font-weight: 800; }
        .premium-card p { font-size: 0.85rem; opacity: 0.9; margin: 8px 0 16px; line-height: 1.4; }
        .upgrade-btn {
            background: white; color: var(--brand); border: none; padding: 12px 24px; 
            border-radius: 14px; font-weight: 800; font-size: 0.85rem; cursor: pointer;
        }
        <% } %>

        /* Daily Challenge - ACCESSIBLE TO ALL */
        .challenge-hub {
            margin: 0 1.5rem 1.5rem; padding: 22px;
            background: linear-gradient(135deg, #7c3aed 0%, #4f46e5 100%);
            border-radius: 24px; display: flex; align-items: center;
            justify-content: space-between; color: white; text-decoration: none;
            box-shadow: 0 10px 20px rgba(124, 58, 237, 0.15);
        }
        .icon-box {
            width: 48px; height: 48px; background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px); border-radius: 15px;
            display: flex; align-items: center; justify-content: center; font-size: 1.4rem;
        }

        /* Action Grid */
        .menu-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; padding: 0 1.5rem; }
        .menu-item {
            background: white; padding: 22px 16px; border-radius: 24px;
            border: 1px solid var(--border); text-decoration: none;
            display: flex; flex-direction: column; position: relative;
        }
        .menu-item:active { transform: scale(0.96); }
        .item-icon {
            width: 44px; height: 44px; border-radius: 13px;
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 12px; font-size: 1.15rem;
        }
        .menu-item b { font-size: 0.9rem; font-weight: 800; color: var(--text-dark); display: block; }
        .menu-item span { font-size: 0.7rem; color: var(--text-sub); font-weight: 600; margin-top: 4px; }

        /* Lock Styling for Free Users */
        .locked { opacity: 0.6; filter: grayscale(0.5); }
        .locked::after {
            content: '\f023'; font-family: "Font Awesome 6 Free"; font-weight: 900;
            position: absolute; top: 15px; right: 15px; color: var(--text-sub); font-size: 0.75rem;
        }

        /* Bottom Floating Navbar */
        .bottom-nav {
            position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
            width: calc(100% - 40px); max-width: 390px;
            background: #0b1437; height: 75px; border-radius: 24px;
            display: flex; justify-content: space-around; align-items: center;
            box-shadow: 0 12px 30px rgba(11, 20, 55, 0.3); z-index: 1000;
        }
        .nav-link { text-decoration: none; color: #a3aed0; text-align: center; }
        .nav-link.active { color: white; }
        .nav-link i { font-size: 1.25rem; display: block; margin-bottom: 3px; }
        .nav-link span { font-size: 0.6rem; font-weight: 700; text-transform: uppercase; }
        
        .nav-center-btn {
            width: 60px; height: 60px; background: var(--brand); border-radius: 20px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 1.6rem; transform: translateY(-28px);
            border: 5px solid #ffffff; box-shadow: 0 8px 15px rgba(0, 98, 255, 0.4);
            text-decoration: none;
        }
    </style>
</head>
<body>

    <div class="app-shell">
        <header class="header-nav">
            <a href="/dashboard" class="logo">Prepium<span>.</span></a>
            <a href="/profile" class="profile-trigger">
                <%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %>
            </a>
        </header>

        <section class="hero-section">
            <h1>Hi, <%= user.fullname ? user.fullname.split(' ')[0] : 'Student' %> 👋</h1>
            <p>Ready to crush your goals today?</p>
        </section>

        <% if (!user.has_paid) { %>
            <div class="premium-card">
                <h3>Upgrade to Premium</h3>
                <p>Access the Study Library, Arena, and all Pro tools for just <b>₦1,000</b>.</p>
                <button onclick="payWithPaystack()" id="pay-btn" class="upgrade-btn">Get Full Access</button>
            </div>
        <% } %>

        <a href="/daily-challenge" class="challenge-hub">
            <div style="display: flex; align-items: center; gap: 15px;">
                <div class="icon-box"><i class="fas fa-fire-alt"></i></div>
                <div>
                    <h4 style="margin:0; font-weight:800; font-size: 1rem;">Daily Challenge</h4>
                    <p style="margin:2px 0 0; font-size:0.75rem; opacity:0.9;">Compete with students live</p>
                </div>
            </div>
            <i class="fas fa-arrow-right" style="opacity: 0.8;"></i>
        </a>

        <div class="menu-grid">
            
            <a href="/setup-test" class="menu-item" style="background: #f0f7ff; border-color: #dbeafe;">
                <div class="item-icon" style="background: var(--brand); color: white;"><i class="fas fa-bolt"></i></div>
                <b>Practice Quiz</b>
                <span><%= user.has_paid ? 'Unlimited Access' : (2 - user.quiz_attempts) + ' Free Remaining' %></span>
            </a>

            <a href="<%= user.has_paid ? '/subjects' : '#' %>" class="menu-item <%= !user.has_paid ? 'locked' : '' %>" onclick="<%= !user.has_paid ? 'payWithPaystack()' : '' %>">
                <div class="item-icon" style="background: #eef2ff; color: #4f46e5;"><i class="fas fa-book-open"></i></div>
                <b>Study Library</b>
                <span>Course Manuals</span>
            </a>

            <a href="<%= user.has_paid ? '/pomodoro' : '#' %>" class="menu-item <%= !user.has_paid ? 'locked' : '' %>" onclick="<%= !user.has_paid ? 'payWithPaystack()' : '' %>">
                <div class="item-icon" style="background: #fff1f2; color: #e11d48;"><i class="fas fa-stopwatch"></i></div>
                <b>Pomodoro</b>
                <span>Focus Sessions</span>
            </a>

            <a href="<%= user.has_paid ? '/deadlines' : '#' %>" class="menu-item <%= !user.has_paid ? 'locked' : '' %>" onclick="<%= !user.has_paid ? 'payWithPaystack()' : '' %>">
                <div class="item-icon" style="background: #fdf2f8; color: #db2777;"><i class="fas fa-hourglass-start"></i></div>
                <b>Deadlines</b>
                <span>Exam Tracker</span>
            </a>

            <a href="<%= user.has_paid ? '/timetable' : '#' %>" class="menu-item <%= !user.has_paid ? 'locked' : '' %>" onclick="<%= !user.has_paid ? 'payWithPaystack()' : '' %>">
                <div class="item-icon" style="background: #f0fdf4; color: #16a34a;"><i class="fas fa-calendar-day"></i></div>
                <b>Timetable</b>
                <span>Study Planner</span>
            </a>

            <a href="<%= user.has_paid ? '/competition' : '#' %>" class="menu-item <%= !user.has_paid ? 'locked' : '' %>" onclick="<%= !user.has_paid ? 'payWithPaystack()' : '' %>">
                <div class="item-icon" style="background: #fffbeb; color: #d97706;"><i class="fas fa-trophy"></i></div>
                <b>Live Arena</b>
                <span>Global Rankings</span>
            </a>

            <a href="/suggestions" class="menu-item">
                <div class="item-icon" style="background: #f5f3ff; color: #7c3aed;"><i class="fas fa-pen-fancy"></i></div>
                <b>Feedback</b>
                <span>Tell us more</span>
            </a>

            <a href="https://alitedigitals.vercel.app/projects" target="_blank" class="menu-item">
                <div class="item-icon" style="background: #f8fafc; color: var(--text-dark); border: 1px solid var(--border);"><i class="fas fa-shopping-cart"></i></div>
                <b>Alite Store</b>
                <span>Tech Shop</span>
            </a>
        </div>

        <nav class="bottom-nav">
            <a href="/dashboard" class="nav-link active">
                <i class="fas fa-home"></i>
                <span>Home</span>
            </a>
            <a href="<%= user.has_paid ? '/history' : '#' %>" class="nav-link">
                <i class="fas fa-chart-bar"></i>
                <span>Stats</span>
            </a>
            
            <a href="/setup-test" class="nav-center-btn"><i class="fas fa-plus"></i></a>
            
            <a href="<%= user.has_paid ? '/notifications' : '#' %>" class="nav-link">
                <i class="fas fa-bell"></i>
                <span>Alerts</span>
            </a>
            <a href="/profile" class="nav-link">
                <i class="fas fa-user-circle"></i>
                <span>Profile</span>
            </a>
        </nav>
    </div>

    <script>
        function payWithPaystack() {
            const btn = document.getElementById('pay-btn');
            if (btn) { btn.innerHTML = "Opening Gateway..."; btn.disabled = true; }

            let handler = PaystackPop.setup({
                key: '<%= paystack_key %>',
                email: '<%= user.email %>',
                amount: 1000 * 100, // Fixed 1,000 NGN
                currency: 'NGN',
                callback: function(response) {
                    window.location.href = "/verify-payment?reference=" + response.reference;
                },
                onClose: function() {
                    if (btn) { btn.innerHTML = "Get Full Access"; btn.disabled = false; }
                }
            });
            handler.openIframe();
        }
    </script>
</body>
</html>