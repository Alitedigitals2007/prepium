<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Dashboard</title>
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { --brand: #0062ff; --bg: #f8fafc; --text: #0f172a; --sub: #64748b; }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; outline: none; }
        
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: var(--bg); 
            margin: 0; 
            padding: 0;
            color: var(--text); 
            display: flex; 
            justify-content: center; 
        }

        .app-shell { 
            width: 100%; 
            max-width: 430px; 
            background: white; 
            min-height: 100vh; 
            position: relative; 
            box-shadow: 0 0 60px rgba(0,0,0,0.05);
            padding-bottom: 100px;
        }

        /* Modernized Header */
        .header-main { 
            padding: 2.5rem 1.5rem 1.5rem;
            background: linear-gradient(180deg, #f0f7ff 0%, #ffffff 100%);
        }
        .user-profile { display: flex; align-items: center; gap: 15px; }
        .avatar-circle { 
            width: 52px; 
            height: 52px; 
            background: var(--brand); 
            border-radius: 18px; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            color: white; 
            font-weight: 800; 
            font-size: 1.3rem;
            box-shadow: 0 10px 20px rgba(0, 98, 255, 0.15);
        }
        
        .welcome-msg h1 { margin: 0; font-size: 1.4rem; font-weight: 800; letter-spacing: -0.5px; }
        .tier-pill { 
            font-size: 0.65rem; 
            font-weight: 800; 
            padding: 4px 10px; 
            border-radius: 8px; 
            text-transform: uppercase; 
            margin-top: 4px; 
            display: inline-block;
        }
        .paid { background: #e0f2fe; color: var(--brand); }
        .unpaid { background: #f1f5f9; color: var(--sub); }

        /* Unified Action Grid */
        .menu-grid { 
            display: grid; 
            grid-template-columns: repeat(2, 1fr); 
            gap: 15px; 
            padding: 1.5rem; 
        }
        .menu-card { 
            background: #ffffff; 
            border: 1px solid #f1f5f9; 
            padding: 2rem 1rem; 
            border-radius: 30px; 
            text-align: center; 
            text-decoration: none; 
            transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 6px rgba(0,0,0,0.01);
        }
        .menu-card:active { transform: translateY(2px); background: #f8fafc; }
        .menu-card i { 
            font-size: 2.2rem; 
            display: block; 
            margin-bottom: 12px; 
            font-style: normal;
        }
        .menu-card b { font-size: 0.9rem; font-weight: 800; color: var(--text); }
        .menu-card p { font-size: 0.7rem; color: var(--sub); margin: 5px 0 0; font-weight: 600; }
        
        .locked-card { opacity: 0.5; filter: grayscale(1); pointer-events: none; }

        /* Paywall Styling */
        .paywall-container { 
            margin: 1.5rem;
            background: #1e293b;
            border-radius: 32px;
            padding: 2rem;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .paywall-container::after {
            content: '';
            position: absolute;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background: radial-gradient(circle, rgba(0,98,255,0.2) 0%, transparent 70%);
        }
        .upgrade-btn { 
            background: var(--brand); 
            color: white; 
            padding: 1.1rem; 
            border-radius: 18px; 
            font-weight: 800; 
            display: block; 
            margin-top: 1.5rem; 
            border: none; 
            width: 100%; 
            font-size: 1rem; 
            cursor: pointer;
            position: relative;
            z-index: 1;
        }

        /* Navigation Bar */
        .nav-bar { 
            position: fixed; 
            bottom: 0; 
            width: 100%; 
            max-width: 430px; 
            background: rgba(255, 255, 255, 0.98); 
            height: 85px; 
            display: flex; 
            justify-content: space-around; 
            align-items: center; 
            border-top: 1px solid #f1f5f9; 
            z-index: 1000;
            padding-bottom: 15px;
        }
        .nav-item { text-decoration: none; color: #94a3b8; font-size: 0.65rem; font-weight: 800; text-align: center; }
        .nav-item.active { color: var(--brand); }
        .nav-item i { display: block; font-size: 1.4rem; margin-bottom: 4px; font-style: normal; }

        .center-fab { 
            width: 60px; 
            height: 60px; 
            background: var(--brand); 
            border-radius: 22px; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            color: white; 
            font-size: 2rem; 
            transform: translateY(-25px); 
            border: 5px solid white; 
            box-shadow: 0 10px 20px rgba(0, 98, 255, 0.3);
            text-decoration: none;
        }
        
        .dot { height: 8px; width: 8px; background: #ef4444; border-radius: 50%; position: absolute; top: 0; right: 0; border: 2px solid white; }
    </style>
</head>
<body>

    <div class="app-shell">
        <header class="header-main">
            <div class="user-profile">
                <div class="avatar-circle">
                    <%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %>
                </div>
                <div class="welcome-msg">
                    <h1>Hi, <%= user.fullname ? user.fullname.split(' ')[0] : 'Student' %></h1>
                    <span class="tier-pill <%= user.has_paid ? 'paid' : 'unpaid' %>">
                        <%= user.has_paid ? 'Premium Access' : 'Basic Plan' %>
                    </span>
                </div>
            </div>
        </header>

        <div class="menu-grid">
            <a href="/subjects" class="menu-card">
                <i>📚</i>
                <b>Study Library</b>
                <p>Browse Courses</p>
            </a>
            
            <a href="/history" class="menu-card">
                <i>📜</i>
                <b>Performance</b>
                <p>Past Results</p>
            </a>

            <a href="<%= user.has_paid ? '/competition' : '#' %>" class="menu-card <%= !user.has_paid ? 'locked-card' : '' %>">
                <i>🏆</i>
                <b>Live Arena</b>
                <p>Global Rank</p>
            </a>

            <a href="/profile" class="menu-card">
                <i>⚙️</i>
                <b>Settings</b>
                <p>Account Prefs</p>
            </a>
        </div>

        <% if (!user.has_paid) { %>
        <div class="paywall-container">
            <h2 style="margin: 0; font-size: 1.2rem;">Ready for 2026?</h2>
            <p style="font-size: 0.8rem; opacity: 0.8; margin: 10px 0;">Unlock full analytics, custom mock exams, and premium subjects.</p>
            <button id="pay-btn" onclick="payWithPaystack()" class="upgrade-btn">Get Premium — ₦500</button>
        </div>
        <% } %>

        <nav class="nav-bar">
            <a href="/dashboard" class="nav-item active"><i>🏠</i>Home</a>
            <a href="/history" class="nav-item"><i>📊</i>Stats</a>
            
            <a href="<%= user.has_paid ? '/setup-test' : '#' %>" class="center-fab">+</a>
            
            <a href="/notifications" class="nav-item" style="position: relative;">
                <i>🔔</i>Alerts
                <% if (locals.hasNewNotifs) { %><span class="dot"></span><% } %>
            </a>
            <a href="/profile" class="nav-item"><i>👤</i>Profile</a>
        </nav>
    </div>

    <script>
        function payWithPaystack() {
            const btn = document.getElementById('pay-btn');
            btn.innerHTML = "Opening Secure Pay...";
            btn.disabled = true;

            let handler = PaystackPop.setup({
                key: '<%= paystack_key %>',
                email: '<%= user.email %>',
                amount: 500 * 100, 
                currency: 'NGN',
                callback: function(response) {
                    window.location.href = "/verify-payment?reference=" + response.reference;
                },
                onClose: function() {
                    btn.innerHTML = "Get Premium — ₦500";
                    btn.disabled = false;
                }
            });
            handler.openIframe();
        }
    </script>
</body>
</html>
