    .drawer-tile .at-label { font-size: 0.68rem; font-weight: 700; color: var(--text-secondary); text-align: center; }
    .drawer-tile.locked .at-icon { opacity: 0.5; }
    .drawer-tile.locked .at-label { opacity: 0.5; }
    .drawer-tile .at-lock { position: absolute; top: -4px; right: -4px; background: var(--surface-solid); border: 1px solid var(--border); padding: 2px; border-radius: 50%; font-size: 0.38rem; }
</style>

<script>
function lockedAction(e) {
    if (e) { e.preventDefault(); }
    if (<%= migratedLocked %>) { payWithPaystack(null); return; }
    window.location.href = '/upgrade';
}

function payWithPaystack(e, presets) {
    if (e) { e.preventDefault(); }
    if (typeof PaystackPop === 'undefined') { alert('Payment system loading. Please try again.'); return; }
    var pAmount = (presets && presets.amount) || <%= migratedLocked ? rechargePrice : premiumPrice %>;
    var pCoupon = (presets && presets.coupon) || '';
    Swal.fire({
        title: 'Have a coupon code?',
        input: 'text',
        inputPlaceholder: 'Enter code or leave blank',
        showCancelButton: true,
        confirmButtonText: 'Continue',
        cancelButtonText: 'No coupon',
        preConfirm: function(val) {
            if (!val || !val.trim()) return { code: null, amount: pAmount };
            return fetch('/api/coupon/validate', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: val.trim() })
            }).then(function(r) { return r.json(); }).then(function(d) {
                if (!d.valid) { Swal.showValidationMessage(d.message || 'Invalid code'); return false; }
                return { code: d.code, amount: d.final_amount, discountLabel: d.discountLabel, original: d.original_amount };
            });
        },
        allowOutsideClick: false
    }).then(function(result) {
        if (!result || !result.isConfirmed || !result.value) return;
        var info = result.value;
        if (info.discountLabel) {
            Swal.fire({ icon: 'info', title: info.discountLabel + ' applied!', text: 'You pay \u20A6' + info.amount.toLocaleString(), timer: 2000, showConfirmButton: false });
        }
        var amount = (info.amount || pAmount) * 100;
        var handler = PaystackPop.setup({
            key: '<%= paystack_key %>',
            email: '<%= user.email %>',
            amount: amount,
            currency: 'NGR',
            callback: function(response) {
                var ref = response.reference;
                var dest = '/verify-payment?reference=' + ref;
                if (info.code) dest += '&coupon=' + encodeURIComponent(info.code);
                window.location.href = dest;
            },
            onClose: function() {}
        });
        setTimeout(function() { handler.openIframe(); }, info.discountLabel ? 2200 : 100);
    });
}

function openDrawer() { document.getElementById('appDrawer').classList.add('open'); document.body.style.overflow = 'hidden'; }
function closeDrawer() { document.getElementById('appDrawer').classList.remove('open'); document.body.style.overflow = ''; }
function filterDrawer() {
    var search = document.getElementById('drawerSearch').value.toLowerCase();
    var body = document.getElementById('drawerBody');
    if (body) {
        body.querySelectorAll('.drawer-tile').forEach(function(el) {
            var text = el.textContent.toLowerCase();
            el.style.display = text.includes(search) ? '' : 'none';
        });
        body.querySelectorAll('.drawer-group-label, .drawer-empty').forEach(function(el) {
            el.style.display = Array.from(el.parentElement.children).some(function(sib) { return sib.classList.contains('drawer-tile') && sib.style.display !== 'none'; }) ? '' : 'none';
        });
    }
}

(function() {
    var params = new URLSearchParams(window.location.search);
    var payment = params.get('payment');
    if (payment === 'success') {
        Swal.fire({ icon: 'success', title: 'Payment Successful!', text: 'Premium unlocked!', timer: 3000, timerProgressBar: true, showConfirmButton: true }).then(() => window.history.replaceState({}, document.title, '/dashboard'));
    } else if (payment === 'failed') {
        Swal.fire({ icon: 'error', title: 'Payment Failed', text: 'Please try again', timer: 4000, timerProgressBar: true, showConfirmButton: true }).then(() => window.history.replaceState({}, document.title, '/dashboard'));
    }
    var hour = new Date().getHours();
    var g = 'Good morning';
    if (hour < 12) g = 'Good morning';
    else if (hour < 17) g = 'Good afternoon';
    else if (hour < 21) g = 'Good evening';
    else g = 'Good night';
    var greetEl = document.getElementById('greeting-text');
    if (greetEl) greetEl.textContent = g;
    
    function updateClock() {
        var now = new Date();
        var h = now.getHours();
        var m = now.getMinutes();
        var timeStr = (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
        var clk = document.getElementById('dashClock');
        if (clk) clk.textContent = timeStr;
    }
    updateClock();
    setInterval(updateClock, 10000);
})();
</script>

