<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Dashboard</title>
    <%- include('partials/design-head') %>
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        <% if (!user.has_paid) { %>
        .upgrade-strip { margin: 0 1.25rem 1.25rem; padding: 18px 20px; border-radius: 20px; background: linear-gradient(135deg,#0f172a 0%,#1e1b4b 100%); color: white; display: flex; align-items: center; gap: 14px; position: relative; overflow: hidden; }
        .upgrade-strip::before { content: ''; position: absolute; top: -50%; right: -20%; width: 200px; height: 200px; border-radius: 50%; background: rgba(99,102,241,0.15); }
        .upgrade-strip .us-icon { width: 44px; height: 44px; border-radius: 14px; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0; }
        .upgrade-strip .us-content { flex: 1; }
        .upgrade-strip .us-content h4 { font-size: 0.85rem; font-weight: 800; margin: 0; }
        .upgrade-strip .us-content p { font-size: 0.7rem; opacity: 0.7; font-weight: 500; margin: 2px 0 0; }
        .upgrade-strip .us-btn { padding: 10px 18px; border-radius: 12px; background: white; color: var(--brand); font-weight: 800; font-size: 0.72rem; border: none; cursor: pointer; flex-shrink: 0; }
        <% } %>
        .bottom-spacer { height: 20px; }
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell px-0 pb-24">

    <div class="hero-strip">
        <div class="hero-stat">
            <div class="stat-icon" style="background:#eef4ff;color:var(--brand);"><i class="fas fa-check-circle"></i></div>
            <div class="stat-num"><%= typeof quizCount !== 'undefined' ? quizCount : 0 %></div>
            <div class="stat-label">Quizzes Done</div>
        </div>
        <div class="hero-stat">
            <div class="stat-icon" style="background:#fef3c7;color:#f59e0b;"><i class="fas fa-trophy"></i></div>
            <div class="stat-num"><%= typeof avgScore !== 'undefined' ? avgScore + '%' : '0%' %></div>
            <div class="stat-label">Avg Score</div>
        </div>
        <div class="hero-stat">
            <div class="stat-icon" style="background:#d1fae5;color:#10b981;"><i class="fas fa-book-open"></i></div>
            <div class="stat-num"><%= typeof studySessions !== 'undefined' ? studySessions : 0 %></div>
            <div class="stat-label">Study Sessions</div>
        </div>
        <div class="hero-stat">
            <div class="stat-icon" style="background:#f0fdf4;color:#16a34a;"><i class="fas fa-robot"></i></div>
            <div class="stat-num"><%= typeof aiQuizCount !== 'undefined' ? aiQuizCount : 0 %></div>
            <div class="stat-label">AI Quizzes</div>
        </div>
    </div>

    <div class="quick-mood">
        <div class="mood-chip primary" onclick="location.href='/daily-task'"><i class="fas fa-tasks"></i> Daily Task</div>
        <div class="mood-chip" onclick="location.href='/study'"><i class="fas fa-graduation-cap"></i> Study Hub</div>
        <div class="mood-chip" onclick="location.href='/setup-test'"><i class="fas fa-bolt"></i> Quiz</div>
        <div class="mood-chip" onclick="location.href='/timetable'"><i class="fas fa-table"></i> Timetable</div>
        <div class="mood-chip" onclick="location.href='/cgpa'"><i class="fas fa-chart-line"></i> CGPA</div>
        <div class="mood-chip" onclick="location.href='/refer'"><i class="fas fa-gift"></i> Refer</div>
        <div class="mood-chip" onclick="location.href='/history'"><i class="fas fa-chart-bar"></i> History</div>
        <div class="mood-chip" onclick="location.href='/daily-challenge'"><i class="fas fa-calendar-check"></i> Challenge</div>
    </div>

    <% if (!user.has_paid) { %>
    <div class="upgrade-strip">
        <div class="us-icon"><i class="fas fa-crown"></i></div>
        <div class="us-content">
            <h4>Unlock Premium</h4>
            <p>AI tutors, CGPA tracker & more</p>
        </div>
        <button class="us-btn" onclick="payWithPaystack()">₦2,000</button>
    </div>
    <% } %>

    <div class="section-head">
        <h2>Your Tools</h2>
    </div>

    <div class="feature-grid">
        <a href="/daily-task" class="feature-card featured" style="background:linear-gradient(135deg,#0d9488,#0891b2);margin-bottom:10px;">
            <div class="fc-icon"><i class="fas fa-tasks"></i></div>
            <div class="fc-body">
                <div class="fc-label">Daily Task</div>
                <div class="fc-desc">Timetable, goals, deadlines & weekly report</div>
            </div>
            <div class="fc-arrow"><i class="fas fa-arrow-right"></i></div>
        </a>

        <a href="/study" class="feature-card featured">
            <div class="fc-icon"><i class="fas fa-graduation-cap"></i></div>
            <div class="fc-body">
                <div class="fc-label">Study with AI</div>
                <div class="fc-desc">Courses, flashcards, quizzes & AI tutor</div>
            </div>
            <div class="fc-arrow"><i class="fas fa-arrow-right"></i></div>
        </a>

        <a href="/timetable" class="feature-card <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'payWithPaystack(event)' %>" style="position:relative;">
            <% if (!user.has_paid) { %><div class="lock-overlay"><i class="fas fa-lock"></i> Premium</div><% } %>
            <div class="fc-icon" style="background:#f3e8ff;color:#7c3aed;"><i class="fas fa-table"></i></div>
            <div class="fc-label">Timetable</div>
            <div class="fc-desc">AI-powered schedule</div>
        </a>

        <a href="/reading-timetable" class="feature-card <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'payWithPaystack(event)' %>" style="position:relative;">
            <% if (!user.has_paid) { %><div class="lock-overlay"><i class="fas fa-lock"></i> Premium</div><% } %>
            <div class="fc-icon" style="background:#dbeafe;color:#0284c7;"><i class="fas fa-book-open"></i></div>
            <div class="fc-label">Reading Schedule</div>
            <div class="fc-desc">Smart study plan</div>
        </a>

        <a href="/cgpa" class="feature-card <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'payWithPaystack(event)' %>" style="position:relative;">
            <% if (!user.has_paid) { %><div class="lock-overlay"><i class="fas fa-lock"></i> Premium</div><% } %>
            <div class="fc-icon" style="background:#e0f2fe;color:#0284c7;"><i class="fas fa-graduation-cap"></i></div>
            <div class="fc-label">CGPA Tracker</div>
            <div class="fc-desc">Target calculator</div>
        </a>

        <a href="/history" class="feature-card <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'payWithPaystack(event)' %>" style="position:relative;">
            <% if (!user.has_paid) { %><div class="lock-overlay"><i class="fas fa-lock"></i> Premium</div><% } %>
            <div class="fc-icon" style="background:#fef3c7;color:#f59e0b;"><i class="fas fa-chart-bar"></i></div>
            <div class="fc-label">History</div>
            <div class="fc-desc">Quiz performance</div>
        </a>

        <a href="/refer" class="feature-card">
            <div class="fc-icon" style="background:#d1fae5;color:#10b981;"><i class="fas fa-gift"></i></div>
            <div class="fc-label">Refer & Earn</div>
            <div class="fc-desc">15% commission on referrals</div>
        </a>

        <a href="/deadlines" class="feature-card <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'payWithPaystack(event)' %>" style="position:relative;">
            <% if (!user.has_paid) { %><div class="lock-overlay"><i class="fas fa-lock"></i> Premium</div><% } %>
            <div class="fc-icon" style="background:#fee2e2;color:#ef4444;"><i class="fas fa-hourglass-half"></i></div>
            <div class="fc-label">Deadlines</div>
            <div class="fc-desc">Track milestones</div>
        </a>

        <a href="/daily-challenge" class="feature-card">
            <div class="fc-icon" style="background:#d1fae5;color:#10b981;"><i class="fas fa-calendar-check"></i></div>
            <div class="fc-label">Daily Challenge</div>
            <div class="fc-desc">Free daily competition</div>
        </a>

        <a href="/competition" class="feature-card <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'payWithPaystack(event)' %>" style="position:relative;">
            <% if (!user.has_paid) { %><div class="lock-overlay"><i class="fas fa-lock"></i> Premium</div><% } %>
            <div class="fc-icon" style="background:#fce7f3;color:#ec4899;"><i class="fas fa-trophy"></i></div>
            <div class="fc-label">Live Arena</div>
            <div class="fc-desc">Real-time rankings</div>
        </a>


        <a href="/suggestions" class="feature-card">
            <div class="fc-icon" style="background:#e0f2fe;color:#0284c7;"><i class="fas fa-lightbulb"></i></div>
            <div class="fc-label">Feedback</div>
            <div class="fc-desc">Share your thoughts</div>
        </a>
    </div>

    <% if (typeof recentQuiz !== 'undefined' && recentQuiz) { %>
    <div class="section-head" style="padding-top:0.75rem;">
        <h2>Recent Activity</h2>
    </div>
    <div class="quick-resume">
        <a href="/history" class="resume-card">
            <div class="rc-icon"><i class="fas fa-bolt"></i></div>
            <div class="rc-body">
                <div class="rc-title"><%= recentQuiz.subject || 'Quiz' %></div>
                <div class="rc-meta"><%= new Date(recentQuiz.date_taken).toLocaleDateString('en-GB', { day:'numeric', month:'short' }) %></div>
            </div>
            <div class="rc-progress"><%= recentQuiz.score %>/<%= recentQuiz.total_questions %></div>
        </a>
    </div>
    <% } %>

    <div style="margin-top:1rem;">
        <div class="section-head">
            <h2>Daily Challenge</h2>
            <a href="/daily-challenge" class="see-all">Join <i class="fas fa-arrow-right" style="font-size:0.6rem;"></i></a>
        </div>
        <a href="/daily-challenge" class="daily-banner">
            <div class="db-left">
                <div class="db-icon"><i class="fas fa-fire-alt"></i></div>
                <div class="db-text">
                    <h4>Today's Challenge</h4>
                    <p>Compete live with peers</p>
                </div>
            </div>
            <div class="db-arrow"><i class="fas fa-chevron-right"></i></div>
        </a>
    </div>

    <div class="bottom-spacer"></div>

    <%- include('partials/bottom-nav', { activeNav: 'dashboard' }) %>
</div>

<script>
function payWithPaystack(e, presets) {
    if (e) { e.preventDefault(); }
    if (typeof PaystackPop === 'undefined') { alert('Payment system loading. Please try again.'); return; }
    var pAmount = (presets && presets.amount) || 2000;
    var pCoupon = (presets && presets.coupon) || '';
    Swal.fire({
        title: 'Have a coupon code?',
        input: 'text',
        inputPlaceholder: 'Enter code or leave blank',
        showCancelButton: true,
        confirmButtonText: 'Continue',
        cancelButtonText: 'No coupon',
        preConfirm: function(val) {
            if (!val || !val.trim()) return { code: null, amount: pAmount };
            return fetch('/api/coupon/validate', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: val.trim() })
            }).then(function(r) { return r.json(); }).then(function(d) {
                if (!d.valid) { Swal.showValidationMessage(d.message || 'Invalid code'); return false; }
                return { code: d.code, amount: d.final_amount, discountLabel: d.discountLabel, original: d.original_amount };
            });
        },
        allowOutsideClick: false
    }).then(function(result) {
        if (!result || !result.isConfirmed || !result.value) return;
        var info = result.value;
        var callbackUrl = '/verify-payment?reference=';
        if (info.code) callbackUrl += 'REPLACE_REF&coupon=' + encodeURIComponent(info.code);
        else callbackUrl += 'REPLACE_REF';
        if (info.discountLabel) {
            Swal.fire({ icon: 'info', title: info.discountLabel + ' applied!', text: 'You pay ₦' + info.amount.toLocaleString(), timer: 2000, showConfirmButton: false });
        }
        var amount = (info.amount || pAmount) * 100;
        var handler = PaystackPop.setup({
            key: '<%= paystack_key %>',
            email: '<%= user.email %>',
            amount: amount,
            currency: 'NGN',
            callback: function(response) {
                var ref = response.reference;
                var dest = '/verify-payment?reference=' + ref;
                if (info.code) dest += '&coupon=' + encodeURIComponent(info.code);
                window.location.href = dest;
            },
            onClose: function() {}
        });
        setTimeout(function() { handler.openIframe(); }, info.discountLabel ? 2200 : 100);
    });
}

(function() {
    const params = new URLSearchParams(window.location.search);
    const payment = params.get('payment');
    if (payment === 'success') {
        Swal.fire({ icon: 'success', title: 'Payment Successful!', text: 'Premium unlocked!', timer: 3000, timerProgressBar: true, showConfirmButton: true }).then(() => window.history.replaceState({}, document.title, '/dashboard'));
    } else if (payment === 'failed') {
        Swal.fire({ icon: 'error', title: 'Payment Failed', text: 'Please try again', timer: 4000, showConfirmButton: true }).then(() => window.history.replaceState({}, document.title, '/dashboard'));
    }

    const hour = new Date().getHours();
    let g = 'Good evening';
    if (hour < 12) g = 'Good morning';
    else if (hour < 17) g = 'Good afternoon';
    var gt = document.getElementById('greeting-text');
    if (gt) gt.textContent = g;
})();
</script>
</body>
</html>
