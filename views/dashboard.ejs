<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <style>
        body::before { display: none; }
        .app-shell { background: var(--bg); backdrop-filter: none; border: none; padding-bottom: 112px; }
        .dash-content { position: relative; min-height: 100vh; max-width: 680px; margin: 0 auto; }

        /* ---------- Header ---------- */
        .dash-header { padding: 1.1rem 1.15rem 0.85rem; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
        .dash-header-left { display: flex; align-items: center; gap: 11px; min-width: 0; }
        .menu-btn {
            width: 44px; height: 44px; flex: 0 0 44px; border-radius: 15px;
            background: var(--surface-solid); border: 1px solid var(--border-solid);
            display: grid; place-items: center; color: var(--text-secondary);
            font-size: 1rem; cursor: pointer; box-shadow: var(--shadow-sm);
            transition: transform 0.14s var(--ease-out), border-color 0.14s;
        }
        .menu-btn:hover { border-color: var(--brand); color: var(--brand); }
        .menu-btn:active { transform: scale(0.92); }
        .dash-avatar {
            width: 46px; height: 46px; flex: 0 0 46px; border-radius: 16px;
            background: linear-gradient(135deg, #2563eb, #7c3aed); color: #fff;
            display: grid; place-items: center; font-weight: 800; font-size: 1.1rem;
            box-shadow: 0 8px 18px rgba(37, 99, 235, 0.26);
        }
        .dash-hello { min-width: 0; }
        .dash-greeting { font-size: 0.6rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.09em; }
        .dash-name { font-size: 1.28rem; font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .dash-sub { display: flex; align-items: center; gap: 6px; font-size: 0.62rem; font-weight: 600; color: var(--text-muted); margin-top: 2px; }
        .dash-sub i { font-size: 0.55rem; }
        .dash-header-right { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; }
        .streak-chip {
            display: flex; align-items: center; gap: 5px; padding: 9px 12px; border-radius: 13px;
            background: linear-gradient(135deg, #f97316, #ef4444); color: #fff;
            font-weight: 800; font-size: 0.74rem; box-shadow: 0 5px 14px rgba(239, 68, 68, 0.28);
        }
        .bell {
            width: 44px; height: 44px; border-radius: 15px; position: relative;
            background: var(--surface-solid); border: 1px solid var(--border-solid);
            display: grid; place-items: center; color: var(--text-secondary);
            font-size: 1rem; box-shadow: var(--shadow-sm); text-decoration: none;
            transition: transform 0.14s var(--ease-out);
        }
        .bell:active { transform: scale(0.92); }
        .bell-dot {
            position: absolute; top: 9px; right: 9px; min-width: 17px; height: 17px;
            padding: 0 4px; border-radius: 99px; background: #ef4444; color: #fff;
            border: 2px solid var(--surface-solid); font-size: 0.5rem; font-weight: 800;
            display: grid; place-items: center;
        }

        /* ---------- Hero / next action ---------- */
        .hero-card {
            margin: 0 1.15rem 1.15rem; border-radius: 26px; padding: 20px;
            background: linear-gradient(135deg, #1d4ed8 0%, #4f46e5 55%, #7c3aed 100%);
            color: #fff; position: relative; overflow: hidden;
            box-shadow: 0 18px 40px rgba(37, 99, 235, 0.32);
            text-decoration: none; display: block;
        }
        .hero-card::before, .hero-card::after {
            content: ''; position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.14);
        }
        .hero-card::before { width: 190px; height: 190px; right: -60px; top: -80px; }
        .hero-card::after { width: 120px; height: 120px; right: 40px; bottom: -80px; background: rgba(255, 255, 255, 0.08); }
        .hero-kicker {
            display: inline-flex; align-items: center; gap: 6px;
            font-size: 0.58rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.09em;
            background: rgba(255, 255, 255, 0.18); padding: 4px 9px; border-radius: 99px;
            position: relative; z-index: 1;
        }
        .hero-row { display: flex; align-items: center; gap: 14px; margin-top: 12px; position: relative; z-index: 1; }
        .hero-icon {
            width: 52px; height: 52px; flex: 0 0 52px; border-radius: 16px;
            display: grid; place-items: center; font-size: 1.25rem;
            background: rgba(255, 255, 255, 0.18); border: 1px solid rgba(255, 255, 255, 0.22);
        }
        .hero-body { flex: 1; min-width: 0; }
        .hero-title { font-size: 1.05rem; font-weight: 800; line-height: 1.25; }
        .hero-sub { font-size: 0.7rem; opacity: 0.82; font-weight: 500; margin-top: 2px; }
        .hero-cta {
            flex: 0 0 auto; padding: 10px 15px; border-radius: 13px;
            background: #fff; color: #2563eb; font-size: 0.72rem; font-weight: 800;
            display: inline-flex; align-items: center; gap: 6px;
        }
        .hero-welcome { position: relative; z-index: 1; }
        .hero-welcome h2 { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.02em; }
        .hero-welcome p { font-size: 0.72rem; opacity: 0.85; margin-top: 4px; line-height: 1.5; }
        .hero-steps { display: grid; gap: 7px; margin-top: 14px; }
        .hero-step {
            display: flex; align-items: center; gap: 10px;
            background: rgba(255, 255, 255, 0.13); border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 14px; padding: 10px 12px; color: #fff; text-decoration: none;
        }
        .hero-step .hs-num { width: 24px; height: 24px; flex: 0 0 24px; border-radius: 50%; background: #fff; color: #2563eb; font-size: 0.7rem; font-weight: 800; display: grid; place-items: center; }
        .hero-step .hs-title { font-size: 0.78rem; font-weight: 700; flex: 1; }
        .hero-step .hs-sub { display: none; }
        .hero-step > i { font-size: 0.6rem; opacity: 0.7; }

        /* ---------- Stats ---------- */
        .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; padding: 0 1.15rem 1.15rem; }
        .stat-card {
            background: var(--surface-solid); border: 1px solid var(--border-solid);
            border-radius: 17px; padding: 12px 6px 11px; text-align: center;
            box-shadow: var(--shadow-sm);
        }
        .stat-card i { font-size: 0.9rem; margin-bottom: 5px; display: block; }
        .stat-card b { display: block; font-size: 1.15rem; font-weight: 800; color: var(--text-primary); line-height: 1; }
        .stat-card span { display: block; font-size: 0.52rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 4px; }

        /* ---------- Sections ---------- */
        .section-head { padding: 0.35rem 1.15rem 0.7rem; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
        .section-head h2 { font-size: 0.98rem; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); }
        .section-head .see-all { font-size: 0.66rem; font-weight: 800; color: var(--brand); text-decoration: none; background: none; border: none; font-family: var(--font); cursor: pointer; display: inline-flex; align-items: center; gap: 4px; }

        /* ---------- Quick actions ---------- */
        .quick-scroll { display: flex; gap: 9px; padding: 0 1.15rem 1.15rem; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
        .quick-scroll::-webkit-scrollbar { display: none; }
        .quick-tile {
            flex: 0 0 auto; width: 82px; scroll-snap-align: start;
            display: flex; flex-direction: column; align-items: center; gap: 8px;
            text-decoration: none; color: inherit; position: relative;
        }
        .quick-tile .qt-icon {
            width: 58px; height: 58px; border-radius: 19px; display: grid; place-items: center;
            color: #fff; font-size: 1.25rem;
            box-shadow: inset 0 -5px 0 rgba(0, 0, 0, 0.16), inset 0 2px 0 rgba(255, 255, 255, 0.26), 0 7px 16px rgba(15, 23, 42, 0.16);
            transition: transform 0.15s var(--ease-out);
        }
        .quick-tile:active .qt-icon { transform: scale(0.9); }
        .quick-tile .qt-label { font-size: 0.64rem; font-weight: 700; color: var(--text-secondary); text-align: center; line-height: 1.2; }
        .quick-tile.locked .qt-icon, .quick-tile.locked .qt-label { opacity: 0.5; }
        .quick-tile .qt-lock { position: absolute; top: -3px; right: 10px; width: 18px; height: 18px; border-radius: 50%; background: var(--surface-solid); border: 1px solid var(--border-solid); display: grid; place-items: center; font-size: 0.45rem; color: var(--text-muted); }
        .c-blue { background: linear-gradient(135deg, #2563eb, #3b82f6); }
        .c-grad { background: linear-gradient(135deg, #4f46e5, #7c3aed); }
        .c-teal { background: linear-gradient(135deg, #0d9488, #14b8a6); }
        .c-orange { background: linear-gradient(135deg, #ea580c, #f59e0b); }
        .c-green { background: linear-gradient(135deg, #059669, #10b981); }
        .c-red { background: linear-gradient(135deg, #b91c1c, #ef4444); }
        .c-purple { background: linear-gradient(135deg, #7c3aed, #a855f7); }
        .c-pink { background: linear-gradient(135deg, #db2777, #ec4899); }

        /* ---------- Today list ---------- */
        .today-list { padding: 0 1.15rem; display: grid; gap: 8px; }
        .today-row {
            display: flex; align-items: center; gap: 12px; padding: 12px 13px;
            border-radius: 16px; background: var(--surface-solid);
            border: 1px solid var(--border-solid); box-shadow: var(--shadow-sm);
            text-decoration: none; color: inherit;
            transition: transform 0.14s var(--ease-out);
        }
        .today-row:active { transform: scale(0.985); }
        .today-row .tr-icon { width: 40px; height: 40px; flex: 0 0 40px; border-radius: 13px; display: grid; place-items: center; font-size: 0.88rem; background: var(--brand-soft); color: var(--brand); }
        .today-row .tr-body { flex: 1; min-width: 0; }
        .today-row .tr-title { font-size: 0.8rem; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--text-primary); }
        .today-row .tr-meta { font-size: 0.63rem; color: var(--text-muted); font-weight: 600; margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .today-row .tr-badge { flex: 0 0 auto; }
        .today-row .tr-chevron { font-size: 0.6rem; color: var(--text-muted); flex: 0 0 auto; }

        /* ---------- Challenge banner ---------- */
        .challenge-card {
            margin: 0 1.15rem 1.15rem; padding: 16px 18px; border-radius: 20px;
            background: linear-gradient(135deg, #f97316, #ef4444); color: #fff;
            display: flex; align-items: center; gap: 13px; text-decoration: none;
            box-shadow: 0 12px 28px rgba(239, 68, 68, 0.28); position: relative; overflow: hidden;
        }
        .challenge-card::after { content: ''; position: absolute; width: 140px; height: 140px; border-radius: 50%; right: -40px; top: -70px; background: rgba(255, 255, 255, 0.12); }
        .challenge-icon { width: 44px; height: 44px; flex: 0 0 44px; border-radius: 14px; background: rgba(255, 255, 255, 0.2); display: grid; place-items: center; font-size: 1.1rem; position: relative; z-index: 1; }
        .challenge-body { flex: 1; position: relative; z-index: 1; }
        .challenge-body h3 { font-size: 0.9rem; font-weight: 800; }
        .challenge-body p { font-size: 0.66rem; opacity: 0.86; margin-top: 1px; }
        .challenge-go { position: relative; z-index: 1; font-size: 0.62rem; font-weight: 800; background: #fff; color: #ea580c; padding: 8px 13px; border-radius: 11px; }

        /* ---------- Premium ---------- */
        .premium-card {
            margin: 0 1.15rem 1.15rem; padding: 17px 18px; border-radius: 20px;
            background: linear-gradient(135deg, #fffbeb, #fef3c7); border: 1px solid #fde68a;
            display: flex; align-items: center; gap: 13px;
        }
        .premium-icon { width: 44px; height: 44px; flex: 0 0 44px; border-radius: 14px; background: linear-gradient(135deg, #f59e0b, #f97316); color: #fff; display: grid; place-items: center; font-size: 1.05rem; box-shadow: 0 6px 14px rgba(245, 158, 11, 0.3); }
        .premium-body { flex: 1; min-width: 0; }
        .premium-body h3 { font-size: 0.86rem; font-weight: 800; color: #78350f; }
        .premium-body p { font-size: 0.66rem; color: #92400e; margin-top: 1px; font-weight: 500; }
        .premium-btn { flex: 0 0 auto; border: none; border-radius: 11px; padding: 9px 14px; font-family: var(--font); font-size: 0.68rem; font-weight: 800; cursor: pointer; background: linear-gradient(135deg, #f59e0b, #f97316); color: #fff; }

        /* ---------- Recent / side ---------- */
        .card-list { padding: 0 1.15rem; display: grid; gap: 8px; }
        .mini-card { display: flex; align-items: center; gap: 12px; padding: 11px 13px; border-radius: 15px; background: var(--surface-solid); border: 1px solid var(--border-solid); text-decoration: none; color: inherit; }
        .mini-card .mc-icon { width: 38px; height: 38px; flex: 0 0 38px; border-radius: 12px; display: grid; place-items: center; background: var(--brand-soft); color: var(--brand); font-size: 0.85rem; }
        .mini-card .mc-body { flex: 1; min-width: 0; }
        .mini-card .mc-title { font-size: 0.78rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .mini-card .mc-meta { font-size: 0.62rem; color: var(--text-muted); font-weight: 600; margin-top: 1px; }
        .mini-card .mc-score { font-size: 0.78rem; font-weight: 800; color: var(--brand); }
        .empty-row { padding: 0 1.15rem; }
        .empty-card { padding: 18px; border-radius: 16px; background: var(--surface-solid); border: 1px dashed var(--border-solid); text-align: center; color: var(--text-muted); font-size: 0.74rem; line-height: 1.5; }
        .empty-card i { display: block; font-size: 1.2rem; margin-bottom: 6px; opacity: 0.5; }

        .notice-strip { margin: 0 1.15rem 1.15rem; }

        /* ---------- Desktop ---------- */
        .dash-columns { display: block; }
        @media (min-width: 1024px) {
            .app-shell { padding-bottom: 40px; }
            .dash-content { max-width: 1100px; padding: 0 32px 40px; }
            .dash-header { padding: 2rem 0 1.1rem; }
            .hero-card, .challenge-card, .premium-card { margin-left: 0; margin-right: 0; }
            .stat-grid { padding: 0 0 1.15rem; gap: 12px; }
            .stat-card { padding: 16px 8px; }
            .stat-card b { font-size: 1.4rem; }
            .section-head { padding-left: 0; padding-right: 0; }
            .quick-scroll { padding-left: 0; padding-right: 0; }
            .today-list, .card-list { padding-left: 0; padding-right: 0; }
            .notice-strip { margin-left: 0; margin-right: 0; }
            .dash-columns { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 26px; align-items: start; }
            .dash-col-main { min-width: 0; }
            .dash-col-side { min-width: 0; }
            .dash-side-block { background: var(--surface-solid); border: 1px solid var(--border-solid); border-radius: 18px; padding: 15px 16px; box-shadow: var(--shadow-sm); margin-bottom: 14px; }
            .dash-side-block h3 { font-size: 0.78rem; font-weight: 800; margin: 0 0 9px; display: flex; align-items: center; gap: 7px; color: var(--text-primary); }
            .dash-side-block h3 i { color: var(--brand); font-size: 0.78rem; }
            .side-row { display: flex; align-items: center; gap: 9px; padding: 7px 0; }
            .side-row + .side-row { border-top: 1px dashed var(--border-solid); }
            .side-row .sr-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--brand); flex-shrink: 0; }
            .side-row .sr-body { flex: 1; min-width: 0; }
            .side-row .sr-title { font-size: 0.75rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
            .side-row .sr-meta { font-size: 0.62rem; color: var(--text-muted); font-weight: 600; }
            .side-empty { font-size: 0.7rem; color: var(--text-muted); line-height: 1.5; }
            .dash-mobile-only { display: none !important; }
            .quick-tile { width: 90px; }
        }
        @media (max-width: 1023.98px) { .dash-desktop-only { display: none !important; } }
        @media (max-width: 360px) { .stat-grid { grid-template-columns: repeat(2, 1fr); } }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/app-intro') %>
<%- include('partials/sidebar') %>
<div class="app-shell">
  <div class="dash-content">

    <div class="dash-header">
        <div class="dash-header-left">
            <button class="menu-btn" onclick="openDrawer()" aria-label="Open all apps"><i class="fas fa-bars"></i></button>
            <div class="dash-avatar"><%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %></div>
            <div class="dash-hello">
                <div class="dash-greeting" id="greeting-text">Good morning</div>
                <div class="dash-name"><%= user.fullname ? user.fullname.split(' ')[0] : 'Student' %></div>
                <div class="dash-sub"><i class="fas fa-clock"></i><span id="dashClock">--:--</span><span>&middot;</span><span>Let&rsquo;s get smarter</span></div>
            </div>
        </div>
        <div class="dash-header-right">
            <div class="streak-chip"><i class="fas fa-fire"></i><%= typeof streak !== 'undefined' ? streak : 0 %></div>
            <a href="/notifications" class="bell" aria-label="Notifications">
                <i class="fas fa-bell"></i>
                <% if (typeof unreadNotifs !== 'undefined' && unreadNotifs > 0) { %><span class="bell-dot"><%= unreadNotifs > 9 ? '9+' : unreadNotifs %></span><% } %>
            </a>
        </div>
    </div>

    <% if (typeof notice !== 'undefined' && notice && notice.message) { %>
    <div class="notice-strip">
        <i class="fas fa-bullhorn"></i>
        <span>
            <%= notice.message %>
            <% if (notice.link) { %> <a href="<%= notice.link %>" style="color:var(--brand);font-weight:700;"><%= notice.link_text || 'Learn more' %></a><% } %>
        </span>
    </div>
    <% } %>

    <% if (typeof isNewUser !== 'undefined' && isNewUser) { %>
    <div class="hero-card">
        <div class="hero-welcome">
            <span class="hero-kicker"><i class="fas fa-sparkles"></i> Welcome aboard</span>
            <h2>Hi <%= user.fullname ? user.fullname.split(' ')[0] : 'there' %>, let&rsquo;s set you up</h2>
            <p>Three quick steps and Prepium builds a study plan around your courses.</p>
            <div class="hero-steps">
                <a href="/study" class="hero-step"><span class="hs-num">1</span><span class="hs-title">Add your courses</span><i class="fas fa-chevron-right"></i></a>
                <a href="/timetable" class="hero-step"><span class="hs-num">2</span><span class="hs-title">Add your timetable</span><i class="fas fa-chevron-right"></i></a>
                <a href="/study" class="hero-step"><span class="hs-num">3</span><span class="hs-title">Start studying with AI</span><i class="fas fa-chevron-right"></i></a>
            </div>
        </div>
    </div>
    <% } else if (typeof nextAction !== 'undefined' && nextAction) { %>
    <a href="<%= nextAction.href %>" class="hero-card">
        <span class="hero-kicker"><i class="fas fa-play"></i> Pick up where you left off</span>
        <div class="hero-row">
            <div class="hero-icon"><i class="fas <%= nextAction.icon %>"></i></div>
            <div class="hero-body">
                <div class="hero-title"><%= nextAction.title %></div>
                <div class="hero-sub"><%= nextAction.sub %></div>
            </div>
            <div class="hero-cta"><%= nextAction.cta %> <i class="fas fa-arrow-right" style="font-size:0.6rem"></i></div>
        </div>
    </a>
    <% } else { %>
    <a href="/study" class="hero-card">
        <span class="hero-kicker"><i class="fas fa-graduation-cap"></i> Study Hub</span>
        <div class="hero-row">
            <div class="hero-icon"><i class="fas fa-book-open"></i></div>
            <div class="hero-body">
                <div class="hero-title">Start a study session</div>
                <div class="hero-sub">Courses, flashcards and an AI tutor</div>
            </div>
            <div class="hero-cta">Open <i class="fas fa-arrow-right" style="font-size:0.6rem"></i></div>
        </div>
    </a>
    <% } %>

    <div class="stat-grid">
        <div class="stat-card">
            <i class="fas fa-bolt" style="color:#2563eb"></i>
            <b><%= typeof quizCount !== 'undefined' ? quizCount : 0 %></b>
            <span>Quizzes</span>
        </div>
        <div class="stat-card">
            <i class="fas fa-bullseye" style="color:#f59e0b"></i>
            <b><%= typeof avgScore !== 'undefined' ? avgScore + '%' : '0%' %></b>
            <span>Avg score</span>
        </div>
        <div class="stat-card">
            <i class="fas fa-clock" style="color:#10b981"></i>
            <b><%= typeof studySessions !== 'undefined' ? studySessions : 0 %></b>
            <span>Sessions</span>
        </div>
        <div class="stat-card">
            <i class="fas fa-clone" style="color:#7c3aed"></i>
            <b><%= typeof flashcardCount !== 'undefined' ? flashcardCount : 0 %></b>
            <span>Cards</span>
        </div>
    </div>

    <div class="section-head">
        <h2>Quick actions</h2>
        <button class="see-all" onclick="openDrawer()">All apps <i class="fas fa-chevron-right" style="font-size:0.5rem"></i></button>
    </div>
    <div class="quick-scroll">
        <a href="/study" class="quick-tile">
            <div class="qt-icon c-grad"><i class="fas fa-graduation-cap"></i></div>
            <span class="qt-label">Study Hub</span>
        </a>
        <a href="/chat" class="quick-tile">
            <div class="qt-icon c-green"><i class="fas fa-comments"></i></div>
            <span class="qt-label">Community</span>
        </a>
        <a href="/daily-challenge" class="quick-tile">
            <div class="qt-icon c-orange"><i class="fas fa-fire-alt"></i></div>
            <span class="qt-label">Challenge</span>
        </a>
        <a href="/games" class="quick-tile">
            <div class="qt-icon c-purple"><i class="fas fa-gamepad"></i></div>
            <span class="qt-label">Games</span>
        </a>
        <a href="/daily-task" class="quick-tile <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'lockedAction(event)' %>">
            <% if (!user.has_paid) { %><span class="qt-lock"><i class="fas fa-lock"></i></span><% } %>
            <div class="qt-icon c-teal"><i class="fas fa-tasks"></i></div>
            <span class="qt-label">Tasks</span>
        </a>
        <a href="/cgpa" class="quick-tile <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'lockedAction(event)' %>">
            <% if (!user.has_paid) { %><span class="qt-lock"><i class="fas fa-lock"></i></span><% } %>
            <div class="qt-icon c-blue"><i class="fas fa-chart-line"></i></div>
            <span class="qt-label">CGPA</span>
        </a>
        <a href="/library" class="quick-tile">
            <div class="qt-icon c-teal"><i class="fas fa-building-columns"></i></div>
            <span class="qt-label">Library</span>
        </a>
        <a href="/insights" class="quick-tile">
            <div class="qt-icon c-green"><i class="fas fa-brain"></i></div>
            <span class="qt-label">Insights</span>
        </a>
        <a href="/skills" class="quick-tile">
            <div class="qt-icon c-grad"><i class="fas fa-seedling"></i></div>
            <span class="qt-label">Skills</span>
        </a>
        <a href="/challenges" class="quick-tile">
            <div class="qt-icon c-red"><i class="fas fa-medal"></i></div>
            <span class="qt-label">Challenges</span>
        </a>
        <a href="/opportunities" class="quick-tile">
            <div class="qt-icon c-amber"><i class="fas fa-briefcase"></i></div>
            <span class="qt-label">Opportunities</span>
        </a>
        <a href="/wrapped" class="quick-tile">
            <div class="qt-icon c-purple"><i class="fas fa-gift"></i></div>
            <span class="qt-label">Wrapped</span>
        </a>
        <button class="quick-tile" onclick="openDrawer()" style="background:none;border:none;font-family:var(--font);cursor:pointer">
            <div class="qt-icon" style="background:linear-gradient(135deg,#475569,#64748b)"><i class="fas fa-grip"></i></div>
            <span class="qt-label">All apps</span>
        </button>
    </div>

    <div class="dash-columns">
      <div class="dash-col-main">

        <div class="section-head">
            <h2>Today &amp; upcoming</h2>
            <a href="/deadlines" class="see-all">Deadlines <i class="fas fa-arrow-right" style="font-size:0.5rem"></i></a>
        </div>

        <div class="today-list">
            <% if (typeof todayPlan !== 'undefined' && todayPlan.length) { %>
                <% todayPlan.forEach(function(p) { %>
                <a href="/reading-timetable" class="today-row">
                    <div class="tr-icon"><i class="fas fa-book-open"></i></div>
                    <div class="tr-body">
                        <div class="tr-title"><%= p.course %><%= p.course_code ? ' · ' + p.course_code : '' %></div>
                        <div class="tr-meta">Reading plan · <%= String(p.start_time).slice(0,5) %>–<%= String(p.end_time).slice(0,5) %></div>
                    </div>
                    <span class="badge badge-brand tr-badge">Today</span>
                </a>
                <% }); %>
            <% } %>
            <% if (typeof pendingTasks !== 'undefined' && pendingTasks > 0) { %>
            <a href="/daily-task" class="today-row">
                <div class="tr-icon" style="background:var(--warning-soft);color:var(--warning);"><i class="fas fa-tasks"></i></div>
                <div class="tr-body">
                    <div class="tr-title"><%= pendingTasks %> task<%= pendingTasks === 1 ? '' : 's' %> still open</div>
                    <div class="tr-meta">Daily task planner</div>
                </div>
                <span class="badge badge-warning tr-badge">Open</span>
            </a>
            <% } %>
            <% if (typeof upcomingDeadlinesList !== 'undefined' && upcomingDeadlinesList.length) { %>
                <% upcomingDeadlinesList.forEach(function(d) {
                    var due = new Date(d.due_date);
                    var days = Math.ceil((due - new Date(new Date().toDateString())) / 86400000);
                    var label = days <= 0 ? 'Today' : (days === 1 ? 'Tomorrow' : due.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }));
                    var urgent = days <= 1; %>
                <a href="/deadlines" class="today-row">
                    <div class="tr-icon" style="background:var(--danger-soft);color:var(--danger);"><i class="fas fa-hourglass-half"></i></div>
                    <div class="tr-body">
                        <div class="tr-title"><%= d.title %></div>
                        <div class="tr-meta">Deadline<%= d.due_time ? ' · ' + String(d.due_time).slice(0,5) : '' %></div>
                    </div>
                    <span class="badge <%= urgent ? 'badge-danger' : 'badge-muted' %> tr-badge"><%= label %></span>
                </a>
                <% }); %>
            <% } %>
            <% if ((!todayPlan || !todayPlan.length) && (!pendingTasks) && (!upcomingDeadlinesList || !upcomingDeadlinesList.length)) { %>
                <div class="empty-card" style="margin:0;">
                    <i class="fas fa-mug-hot"></i>
                    Nothing scheduled — add a deadline or reading plan and it will show up here.
                </div>
            <% } %>
        </div>

        <% if (typeof recentQuiz !== 'undefined' && recentQuiz) { %>
        <div class="section-head" style="padding-top:1.15rem;">
            <h2>Recent activity</h2>
            <a href="/history" class="see-all">History <i class="fas fa-arrow-right" style="font-size:0.5rem"></i></a>
        </div>
        <div class="card-list">
            <a href="/history" class="mini-card">
                <div class="mc-icon"><i class="fas fa-bolt"></i></div>
                <div class="mc-body">
                    <div class="mc-title"><%= recentQuiz.subject || 'Quiz' %></div>
                    <div class="mc-meta"><%= new Date(recentQuiz.date_taken).toLocaleDateString('en-GB', { day:'numeric', month:'short' }) %></div>
                </div>
                <div class="mc-score"><%= recentQuiz.score %>/<%= recentQuiz.total_questions %></div>
            </a>
        </div>
        <% } %>

        <div class="dash-mobile-only">
            <% if (typeof weakSubjects !== 'undefined' && weakSubjects.length) { %>
            <div class="section-head" style="padding-top:1.15rem;">
                <h2>Topics to improve</h2>
            </div>
            <div class="card-list">
                <% weakSubjects.forEach(function(w) { %>
                <a href="/study" class="mini-card">
                    <div class="mc-icon" style="background:var(--warning-soft);color:var(--warning);"><i class="fas fa-bullseye"></i></div>
                    <div class="mc-body">
                        <div class="mc-title"><%= w.subject %></div>
                        <div class="mc-meta">Avg <%= w.avg_pct %>% over <%= w.attempts %> attempt<%= w.attempts === 1 ? '' : 's' %></div>
                    </div>
                    <i class="fas fa-chevron-right tr-chevron"></i>
                </a>
                <% }); %>
            </div>
            <% } %>
        </div>

        <div class="section-head" style="padding-top:1.15rem;">
            <h2>Daily challenge</h2>
            <a href="/daily-challenge" class="see-all">Leaderboard <i class="fas fa-arrow-right" style="font-size:0.5rem"></i></a>
        </div>
        <a href="/daily-challenge" class="challenge-card">
            <div class="challenge-icon"><i class="fas fa-fire-alt"></i></div>
            <div class="challenge-body">
                <h3>Today&rsquo;s challenge is live</h3>
                <p>10 questions &middot; compete with your peers</p>
            </div>
            <div class="challenge-go">Play</div>
        </a>

        <% if (!user.has_paid) { %>
        <div class="premium-card">
            <div class="premium-icon"><i class="fas fa-crown"></i></div>
            <div class="premium-body">
                <% if (migratedLocked) { %>
                <h3>Recharge Premium</h3>
                <p>Your free migration period is over &mdash; pay &#8358;<%= rechargePrice.toLocaleString() %> to continue</p>
                <% } else { %>
                <h3>Unlock Prepium Pro</h3>
                <p>AI tutor, CGPA tracker, timetable &amp; more</p>
                <% } %>
            </div>
            <% if (migratedLocked) { %>
            <button class="premium-btn" onclick="payWithPaystack(event)">Recharge</button>
            <% } else { %>
            <button class="premium-btn" onclick="location.href='/upgrade'">Explore</button>
            <% } %>
        </div>
        <% } %>

        <div class="bottom-spacer" style="height:12px"></div>
      </div>

      <div class="dash-col-side dash-desktop-only">
        <div class="dash-side-block">
            <h3><i class="fas fa-bullseye"></i> Topics to improve</h3>
            <% if (typeof weakSubjects !== 'undefined' && weakSubjects.length) { %>
                <% weakSubjects.forEach(function(w) { %>
                <div class="side-row">
                    <div class="sr-dot" style="background:var(--warning);"></div>
                    <div class="sr-body">
                        <div class="sr-title"><%= w.subject %></div>
                        <div class="sr-meta">Avg <%= w.avg_pct %>% over <%= w.attempts %> attempt<%= w.attempts === 1 ? '' : 's' %></div>
                    </div>
                </div>
                <% }); %>
                <a href="/study" style="display:inline-block;margin-top:8px;font-size:0.7rem;font-weight:700;color:var(--brand);text-decoration:none;">Practise these <i class="fas fa-arrow-right" style="font-size:0.6rem;"></i></a>
            <% } else { %>
                <p class="side-empty">Take a couple of quizzes and your weakest subjects will show up here automatically.</p>
            <% } %>
        </div>
        <div class="dash-side-block">
            <h3><i class="fas fa-clock-rotate-left"></i> Recent activity</h3>
            <% if (typeof history !== 'undefined' && history.length) { %>
                <% history.forEach(function(h) { %>
                <div class="side-row">
                    <div class="sr-dot"></div>
                    <div class="sr-body">
                        <div class="sr-title"><%= h.subject || 'Quiz' %></div>
                        <div class="sr-meta"><%= h.score %> correct · <%= h.time %></div>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
                <p class="side-empty">Your quiz history will appear here after your first practice session.</p>
            <% } %>
        </div>
        <div class="dash-side-block">
            <h3><i class="fas fa-graduation-cap"></i> Keep going</h3>
            <p class="side-empty" style="margin-bottom:10px;">You&rsquo;ve completed <b><%= typeof quizCount !== 'undefined' ? quizCount : 0 %></b> quizzes and <b><%= typeof studySessions !== 'undefined' ? studySessions : 0 %></b> study sessions.</p>
            <a href="/study" class="btn btn-primary btn-sm" style="text-decoration:none;"><i class="fas fa-play"></i> Study now</a>
        </div>
      </div>
    </div>

  </div>
</div>

<%- include('partials/bottom-nav', { activeNav: 'dashboard' }) %>

<script>
function lockedAction(e) {
    if (e) { e.preventDefault(); }
    if (<%= migratedLocked %>) { payWithPaystack(null); return; }
    window.location.href = '/upgrade';
}

function payWithPaystack(e, presets) {
    if (e) { e.preventDefault(); }
    if (typeof PaystackPop === 'undefined') { alert('Payment system loading. Please try again.'); return; }
    var pAmount = (presets && presets.amount) || <%= migratedLocked ? rechargePrice : premiumPrice %>;
    Swal.fire({
        title: 'Have a coupon code?',
        input: 'text',
        inputPlaceholder: 'Enter code or leave blank',
        showCancelButton: true,
        confirmButtonText: 'Continue',
        cancelButtonText: 'No coupon',
        preConfirm: function(val) {
            if (!val || !val.trim()) return { code: null, amount: pAmount };
            return fetch('/api/coupon/validate', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: val.trim() })
            }).then(function(r) { return r.json(); }).then(function(d) {
                if (!d.valid) { Swal.showValidationMessage(d.message || 'Invalid code'); return false; }
                return { code: d.code, amount: d.final_amount, discountLabel: d.discountLabel, original: d.original_amount };
            });
        },
        allowOutsideClick: false
    }).then(function(result) {
        if (!result || !result.isConfirmed || !result.value) return;
        var info = result.value;
        if (info.discountLabel) {
            Swal.fire({ icon: 'info', title: info.discountLabel + ' applied!', text: 'You pay \u20A6' + info.amount.toLocaleString(), timer: 2000, showConfirmButton: false });
        }
        var amount = (info.amount || pAmount) * 100;
        var handler = PaystackPop.setup({
            key: '<%= paystack_key %>',
            email: '<%= user.email %>',
            amount: amount,
            currency: 'NGN',
            callback: function(response) {
                var ref = response.reference;
                var dest = '/verify-payment?reference=' + ref;
                if (info.code) dest += '&coupon=' + encodeURIComponent(info.code);
                window.location.href = dest;
            },
            onClose: function() {}
        });
        setTimeout(function() { handler.openIframe(); }, info.discountLabel ? 2200 : 100);
    });
}

(function() {
    var params = new URLSearchParams(window.location.search);
    var payment = params.get('payment');
    if (payment === 'success') {
        Swal.fire({ icon: 'success', title: 'Payment Successful!', text: 'Premium unlocked!', timer: 3000, timerProgressBar: true, showConfirmButton: true }).then(function() { window.history.replaceState({}, document.title, '/dashboard'); });
    } else if (payment === 'failed') {
        Swal.fire({ icon: 'error', title: 'Payment Failed', text: 'Please try again', timer: 4000, timerProgressBar: true, showConfirmButton: true }).then(function() { window.history.replaceState({}, document.title, '/dashboard'); });
    }

    function updateClock() {
        var now = new Date();
        var h = now.getHours();
        var m = now.getMinutes();
        var timeStr = (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
        var clk = document.getElementById('dashClock');
        if (clk) clk.textContent = timeStr;
        var greetEl = document.getElementById('greeting-text');
        if (greetEl) {
            var g = 'Good morning';
            if (h >= 12 && h < 17) g = 'Good afternoon';
            else if (h >= 17 && h < 21) g = 'Good evening';
            else if (h >= 21) g = 'Good night';
            greetEl.textContent = g;
        }
    }
    updateClock();
    setInterval(updateClock, 30000);
})();
</script>

<%- include('partials/install-banner') %>
</body>
</html>
