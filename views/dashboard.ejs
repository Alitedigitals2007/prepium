<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Dashboard</title>
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { --brand: #0062ff; --bg: #f8fafc; --text: #1e293b; --gold: #f59e0b; }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; outline: none; }
        
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: var(--bg); 
            margin: 0; 
            padding-bottom: 100px; 
            color: var(--text); 
            display: flex; 
            justify-content: center; 
        }

        .app-shell { 
            width: 100%; 
            max-width: 430px; 
            background: white; 
            min-height: 100vh; 
            position: relative; 
            box-shadow: 0 0 40px rgba(0,0,0,0.03); 
        }

        /* Header Area */
        .top-bar { padding: 1.5rem 1.2rem; display: flex; justify-content: space-between; align-items: center; }
        .profile-info { display: flex; align-items: center; gap: 12px; }
        .avatar { 
            width: 44px; 
            height: 44px; 
            background: linear-gradient(135deg, var(--brand), #00d2ff); 
            border-radius: 15px; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            color: white; 
            font-weight: 800; 
            font-size: 1.2rem; 
        }
        
        .status-badge { font-size: 0.6rem; font-weight: 800; padding: 4px 10px; border-radius: 8px; text-transform: uppercase; margin-top: 4px; display: inline-block; letter-spacing: 0.5px; }
        .paid { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
        .unpaid { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
        .streak-pill { 
            font-size: 0.75rem; 
            font-weight: 800; 
            color: var(--gold); 
            display: flex; 
            align-items: center; 
            gap: 4px; 
            background: #fffbeb; 
            padding: 6px 12px; 
            border-radius: 12px; 
            border: 1px solid #fef3c7; 
        }

        /* Navigation Grid */
        .section-label { padding: 0 1.2rem; font-size: 0.75rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; margin: 1.5rem 0 0.8rem; letter-spacing: 0.8px; }
        .action-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; padding: 0 1.2rem; }
        .action-card { 
            background: #f8fafc; 
            border: 1px solid #f1f5f9; 
            padding: 1.4rem 5px; 
            border-radius: 24px; 
            text-align: center; 
            text-decoration: none; 
            color: inherit; 
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); 
        }
        .action-card:active { transform: scale(0.94); background: #f1f5f9; }
        .locked { opacity: 0.4; filter: grayscale(1); pointer-events: none; }
        .action-card span:first-child { font-size: 1.8rem; margin-bottom: 8px; display: block; }
        .action-card b { font-size: 0.75rem; font-weight: 800; display: block; }

        /* Recent Activity */
        .activity-card { margin: 1.2rem; background: #ffffff; border: 1px solid #f1f5f9; border-radius: 28px; padding: 0.5rem 1.2rem; }
        .activity-row { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid #f8fafc; }
        .activity-row:last-child { border-bottom: none; }
        .subject-name { font-weight: 700; font-size: 0.9rem; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px; }
        .score-badge { background: #eff6ff; color: var(--brand); padding: 6px 14px; border-radius: 12px; font-weight: 800; font-size: 0.85rem; }

        /* Paywall */
        .paywall-overlay { 
            position: absolute; 
            top: 180px; 
            left: 0; 
            right: 0; 
            bottom: 85px; 
            background: rgba(255, 255, 255, 0.8); 
            backdrop-filter: blur(12px); 
            -webkit-backdrop-filter: blur(12px); 
            z-index: 100; 
            display: flex; 
            justify-content: center; 
            align-items: flex-start; 
            padding-top: 40px; 
        }
        .lock-box { 
            background: white; 
            width: 88%; 
            padding: 2.5rem 2rem; 
            border-radius: 35px; 
            box-shadow: 0 20px 40px rgba(0,0,0,0.08); 
            text-align: center; 
            border: 1px solid #f1f5f9; 
        }
        .upgrade-btn { 
            background: var(--brand); 
            color: white; 
            padding: 1.2rem; 
            border-radius: 20px; 
            text-decoration: none; 
            font-weight: 800; 
            display: block; 
            margin-top: 1.5rem; 
            border: none; 
            width: 100%; 
            font-size: 1.05rem; 
            box-shadow: 0 8px 16px rgba(0, 98, 255, 0.25); 
            cursor: pointer;
        }

        /* Bottom Navbar */
        .bottom-nav { 
            position: fixed; 
            bottom: 0; 
            width: 100%; 
            max-width: 430px; 
            background: rgba(255, 255, 255, 0.95); 
            backdrop-filter: blur(10px); 
            height: 85px; 
            display: flex; 
            justify-content: space-around; 
            align-items: center; 
            border-top: 1px solid #f1f5f9; 
            z-index: 101; 
            padding-bottom: env(safe-area-inset-bottom); 
        }
        .nav-link { text-decoration: none; color: #94a3b8; font-size: 0.65rem; font-weight: 800; text-align: center; transition: 0.2s; position: relative; }
        .nav-link.active { color: var(--brand); }
        .nav-link i { display: block; font-size: 1.4rem; margin-bottom: 4px; font-style: normal; }
        
        /* Notification Dot */
        .notification-dot { 
            position: absolute; 
            top: -2px; 
            right: calc(50% - 18px); 
            width: 10px; 
            height: 10px; 
            background-color: #ff4d4d; 
            border-radius: 50%; 
            border: 2px solid white; 
            animation: pulse 1.5s infinite; 
        }
        @keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.2); } 100% { transform: scale(1); } }

        .fab { 
            width: 62px; 
            height: 62px; 
            background: var(--brand); 
            border-radius: 50%; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            color: white; 
            font-size: 2.2rem; 
            transform: translateY(-30px); 
            border: 6px solid white; 
            box-shadow: 0 12px 24px rgba(0, 98, 255, 0.35); 
            text-decoration: none; 
        }
    </style>
</head>
<body>

    <div class="app-shell">
        <header class="top-bar">
            <div class="profile-info">
                <div class="avatar"><%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %></div>
                <div>
                    <div style="font-weight: 800; font-size: 1.1rem;"><%= user.fullname ? user.fullname.split(' ')[0] : 'Student' %></div>
                    <span class="status-badge <%= user.has_paid ? 'paid' : 'unpaid' %>">
                        <%= user.has_paid ? 'Premium' : 'Basic Member' %>
                    </span>
                </div>
            </div>
            <div class="streak-pill">
                <span>🔥</span> <%= user.current_streak || 0 %>
            </div>
        </header>

        <div class="section-label">Main Menu</div>
        <div class="action-grid">
            <a href="/subjects" class="action-card">
        <span>📚</span><b>Library</b>
    </a>
            <a href="<%= user.has_paid ? '/competition' : '#' %>" class="action-card <%= !user.has_paid ? 'locked' : '' %>">
                <span>🏆</span><b>Compete</b>
            </a>
            <a href="/history" class="action-card">
                <span>📜</span><b>History</b>
            </a>
        </div>

        <div class="section-label">Recent Attempts</div>
        <div class="activity-card">
            <% if (typeof history !== 'undefined' && history.length > 0) { %>
                <% history.forEach(item => { %>
                <div class="activity-row">
                    <div>
                        <div class="subject-name text-capitalize"><%= item.subject || 'General Practice' %></div>
                        <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 600;"><%= item.time %></div>
                    </div>
                    <span class="score-badge"><%= item.score %>%</span>
                </div>
                <% }) %>
            <% } else { %>
                <div style="text-align: center; padding: 2.5rem 0;">
                    <p style="color: #94a3b8; font-size: 0.85rem; font-weight: 600; line-height: 1.4;">No history found.<br>Your scores will appear here.</p>
                </div>
            <% } %>
        </div>

        <% if (!user.has_paid) { %>
        <div class="paywall-overlay">
            <div class="lock-box">
                <div style="font-size: 3.5rem; margin-bottom: 0.5rem;">✨</div>
                <h2 style="margin: 0; font-weight: 800; font-size: 1.4rem;">Get Full Access</h2>
                <p style="font-size: 0.85rem; color: #64748b; margin: 12px 0; line-height: 1.5;">Join the 2026 cohort. Unlock detailed analytics and live competitions.</p>
                <button id="pay-btn" onclick="payWithPaystack()" class="upgrade-btn">Unlock for ₦500</button>
            </div>
        </div>
        <% } %>

        <nav class="bottom-nav">
            <a href="/dashboard" class="nav-link active"><i>🏠</i>Home</a>
            <a href="/history" class="nav-link"><i>📜</i>History</a>
            <a href="<%= user.has_paid ? '/setup-test' : '#' %>" class="fab">+</a>
            <a href="/notifications" class="nav-link">
                <i>🔔</i>
                <% if (locals.hasNewNotifs === true) { %>
                    <span class="notification-dot"></span>
                <% } %>
                Alerts
            </a>
            <a href="/profile" class="nav-link"><i>👤</i>Profile</a>
        </nav>
    </div>

    <script>
        function payWithPaystack() {
            const btn = document.getElementById('pay-btn');
            btn.innerHTML = "Processing...";
            btn.style.opacity = "0.7";

            let handler = PaystackPop.setup({
                key: '<%= paystack_key %>',
                email: '<%= user.email %>',
                amount: 500 * 100, 
                currency: 'NGN',
                callback: function(response) {
                    window.location.href = "/verify-payment?reference=" + response.reference;
                },
                onClose: function() {
                    btn.innerHTML = "Unlock for ₦2,000";
                    btn.style.opacity = "1";
                }
            });
            handler.openIframe();
        }
    </script>
</body>
</html>
