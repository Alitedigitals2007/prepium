<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>Prepium | Dashboard</title>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0062ff">
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --dash-bg: #f0f2f8;
            --card-bg: rgba(255,255,255,0.85);
            --card-shadow: 0 2px 12px rgba(0,0,0,0.04);
            --accent-purple: #7c3aed;
            --accent-rose: #f43f5e;
            --accent-amber: #f59e0b;
            --accent-teal: #0d9488;
            --accent-blue: #0062ff;
        }
        body { background: var(--dash-bg); }
        body::before { display: none; }
        .app-shell { background: transparent; backdrop-filter: none; border: none; padding-bottom: 100px; }

        .dash-header { padding: 1.25rem 1.25rem 0.75rem; display: flex; align-items: center; justify-content: space-between; }
        .dash-header-left { display: flex; align-items: center; gap: 12px; }
        .dash-avatar { width: 46px; height: 46px; border-radius: 16px; background: var(--brand-gradient); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.1rem; box-shadow: 0 4px 14px rgba(0,98,255,0.25); }
        .dash-greeting { font-size: 0.62rem; font-weight: 700; color: var(--text-sub); text-transform: uppercase; letter-spacing: 0.5px; }
        .dash-name { font-size: 1.15rem; font-weight: 800; line-height: 1.2; }
        .dash-header-right { display: flex; align-items: center; gap: 8px; }
        .notif-bell { width: 42px; height: 42px; border-radius: 14px; background: white; border: 1px solid rgba(226,232,240,0.6); display: flex; align-items: center; justify-content: center; color: var(--text-sub); font-size: 1rem; cursor: pointer; position: relative; box-shadow: var(--card-shadow); transition: var(--transition); }
        .notif-bell:active { transform: scale(0.92); }
        .notif-dot { position: absolute; top: 8px; right: 8px; width: 8px; height: 8px; border-radius: 50%; background: var(--danger); border: 2px solid white; }
        .streak-badge { display: flex; align-items: center; gap: 5px; padding: 8px 14px; border-radius: 12px; background: linear-gradient(135deg,#f97316,#ef4444); color: white; font-weight: 800; font-size: 0.75rem; box-shadow: 0 4px 12px rgba(239,68,68,0.25); }
        .streak-badge i { font-size: 0.85rem; }

        .hero-strip { padding: 0 1.25rem 1.25rem; display: flex; flex-wrap: wrap; gap: 8px; }
        .hero-stat { flex: 1 1 calc(50% - 4px); min-width: 0; background: white; border-radius: 18px; padding: 14px 10px; border: 1px solid rgba(226,232,240,0.5); box-shadow: var(--card-shadow); }
        .hero-stat .stat-icon { width: 36px; height: 36px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; margin-bottom: 8px; }
        .hero-stat .stat-num { font-size: 1.3rem; font-weight: 800; line-height: 1; }
        .hero-stat .stat-label { font-size: 0.6rem; font-weight: 700; color: var(--text-sub); text-transform: uppercase; letter-spacing: 0.3px; margin-top: 3px; }

        .quick-mood { padding: 0 1.25rem 1rem; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none; }
        .quick-mood::-webkit-scrollbar { display: none; }
        .mood-chip { flex-shrink: 0; padding: 10px 18px; border-radius: 14px; background: white; border: 1px solid rgba(226,232,240,0.5); font-weight: 700; font-size: 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 6px; color: var(--text-dark); box-shadow: var(--card-shadow); transition: var(--transition); }
        .mood-chip:active { transform: scale(0.95); }
        .mood-chip i { font-size: 0.85rem; }
        .mood-chip.primary { background: var(--brand-gradient); color: white; border: none; box-shadow: 0 4px 14px rgba(0,98,255,0.25); }

        <% if (!user.has_paid) { %>
        .upgrade-strip { margin: 0 1.25rem 1.25rem; padding: 18px 20px; border-radius: 20px; background: linear-gradient(135deg,#0f172a 0%,#1e1b4b 100%); color: white; display: flex; align-items: center; gap: 14px; position: relative; overflow: hidden; }
        .upgrade-strip::before { content: ''; position: absolute; top: -50%; right: -20%; width: 200px; height: 200px; border-radius: 50%; background: rgba(99,102,241,0.15); }
        .upgrade-strip .us-icon { width: 44px; height: 44px; border-radius: 14px; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0; }
        .upgrade-strip .us-content { flex: 1; }
        .upgrade-strip .us-content h4 { font-size: 0.85rem; font-weight: 800; margin: 0; }
        .upgrade-strip .us-content p { font-size: 0.7rem; opacity: 0.7; font-weight: 500; margin: 2px 0 0; }
        .upgrade-strip .us-btn { padding: 10px 18px; border-radius: 12px; background: white; color: var(--brand); font-weight: 800; font-size: 0.72rem; border: none; cursor: pointer; flex-shrink: 0; }
        <% } %>

        .section-head { padding: 0.5rem 1.25rem 0.75rem; display: flex; align-items: center; justify-content: space-between; }
        .section-head h2 { font-size: 1rem; font-weight: 800; letter-spacing: -0.3px; }
        .section-head .see-all { font-size: 0.68rem; font-weight: 700; color: var(--brand); cursor: pointer; text-decoration: none; }

        .feature-grid { padding: 0 1.25rem; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .feature-card { background: white; border-radius: 18px; padding: 18px 14px; border: 1px solid rgba(226,232,240,0.5); box-shadow: var(--card-shadow); text-decoration: none; color: inherit; transition: all 0.3s var(--ease-out); display: flex; flex-direction: column; }
        .feature-card:active { transform: scale(0.96); }
        .feature-card .fc-icon { width: 42px; height: 42px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1rem; margin-bottom: 12px; }
        .feature-card .fc-label { font-size: 0.78rem; font-weight: 800; margin-bottom: 2px; }
        .feature-card .fc-desc { font-size: 0.65rem; color: var(--text-sub); font-weight: 600; line-height: 1.3; }
        .feature-card .fc-badge { display: inline-flex; align-items: center; gap: 3px; margin-top: 8px; padding: 3px 8px; border-radius: 6px; font-size: 0.58rem; font-weight: 700; }
        .feature-card.featured { grid-column: span 2; flex-direction: row; align-items: center; gap: 16px; padding: 16px 18px; background: linear-gradient(135deg,#0062ff,#4f46e5); color: white; border: none; box-shadow: 0 6px 24px rgba(0,98,255,0.25); }
        .feature-card.featured .fc-icon { background: rgba(255,255,255,0.2); color: white; margin-bottom: 0; }
        .feature-card.featured .fc-body { flex: 1; }
        .feature-card.featured .fc-label { font-size: 0.88rem; }
        .feature-card.featured .fc-desc { color: rgba(255,255,255,0.75); }
        .feature-card.featured .fc-arrow { width: 32px; height: 32px; border-radius: 10px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

        .feature-card.locked { opacity: 0.6; }
        .feature-card.locked .fc-icon { background: #f1f5f9; color: var(--text-muted); }
        .feature-card.locked::after { display: none; }
        .feature-card .lock-overlay { display: none; }
        .feature-card.locked .lock-overlay { display: flex; align-items: center; justify-content: center; position: absolute; inset: 0; background: rgba(255,255,255,0.5); backdrop-filter: blur(2px); border-radius: 18px; font-size: 0.75rem; color: var(--text-sub); font-weight: 700; z-index: 2; cursor: pointer; }

        .quick-resume { padding: 0 1.25rem; }
        .resume-card { background: white; border-radius: 18px; padding: 16px; border: 1px solid rgba(226,232,240,0.5); box-shadow: var(--card-shadow); display: flex; align-items: center; gap: 14px; text-decoration: none; color: inherit; margin-bottom: 10px; transition: var(--transition); }
        .resume-card:active { transform: scale(0.98); }
        .resume-card .rc-icon { width: 44px; height: 44px; border-radius: 14px; background: var(--brand-soft); display: flex; align-items: center; justify-content: center; color: var(--brand); font-size: 1rem; flex-shrink: 0; }
        .resume-card .rc-body { flex: 1; min-width: 0; }
        .resume-card .rc-body .rc-title { font-size: 0.82rem; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .resume-card .rc-body .rc-meta { font-size: 0.65rem; color: var(--text-sub); font-weight: 600; margin-top: 1px; }
        .resume-card .rc-progress { width: 40px; text-align: right; font-size: 0.75rem; font-weight: 800; color: var(--brand); }

        .daily-banner { margin: 0 1.25rem 1.25rem; padding: 18px 20px; border-radius: 20px; background: linear-gradient(135deg,#0d9488,#0891b2); color: white; display: flex; align-items: center; justify-content: space-between; text-decoration: none; box-shadow: 0 6px 20px rgba(13,148,136,0.25); position: relative; overflow: hidden; }
        .daily-banner::before { content: ''; position: absolute; top: -40%; right: -20%; width: 160px; height: 160px; border-radius: 50%; background: rgba(255,255,255,0.08); }
        .daily-banner .db-left { display: flex; align-items: center; gap: 12px; position: relative; }
        .daily-banner .db-icon { width: 40px; height: 40px; border-radius: 12px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }
        .daily-banner .db-text h4 { font-size: 0.88rem; font-weight: 800; margin: 0; }
        .daily-banner .db-text p { font-size: 0.68rem; opacity: 0.85; margin: 2px 0 0; font-weight: 500; }
        .daily-banner .db-arrow { font-size: 0.8rem; opacity: 0.7; position: relative; }

        .bottom-spacer { height: 20px; }
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="dash-header">
        <div class="dash-header-left">
            <div class="dash-avatar"><%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %></div>
            <div>
                <div class="dash-greeting" id="greeting-text">Good morning</div>
                <div class="dash-name"><%= user.fullname ? user.fullname.split(' ')[0] : 'Student' %></div>
            </div>
        </div>
        <div class="dash-header-right">
            <div class="streak-badge"><i class="fas fa-fire"></i> <%= typeof streak !== 'undefined' ? streak : 0 %></div>
            <a href="/notifications" class="notif-bell">
                <i class="fas fa-bell"></i>
                <% if (typeof unreadNotifs !== 'undefined' && unreadNotifs > 0) { %><div class="notif-dot"></div><% } %>
            </a>
        </div>
    </div>

    <div class="hero-strip">
        <div class="hero-stat">
            <div class="stat-icon" style="background:#eef4ff;color:var(--brand);"><i class="fas fa-check-circle"></i></div>
            <div class="stat-num"><%= typeof quizCount !== 'undefined' ? quizCount : 0 %></div>
            <div class="stat-label">Quizzes Done</div>
        </div>
        <div class="hero-stat">
            <div class="stat-icon" style="background:#fef3c7;color:#f59e0b;"><i class="fas fa-trophy"></i></div>
            <div class="stat-num"><%= typeof avgScore !== 'undefined' ? avgScore + '%' : '0%' %></div>
            <div class="stat-label">Avg Score</div>
        </div>
        <div class="hero-stat">
            <div class="stat-icon" style="background:#d1fae5;color:#10b981;"><i class="fas fa-book-open"></i></div>
            <div class="stat-num"><%= typeof studySessions !== 'undefined' ? studySessions : 0 %></div>
            <div class="stat-label">Study Sessions</div>
        </div>
        <div class="hero-stat">
            <div class="stat-icon" style="background:#f0fdf4;color:#16a34a;"><i class="fas fa-robot"></i></div>
            <div class="stat-num"><%= typeof aiQuizCount !== 'undefined' ? aiQuizCount : 0 %></div>
            <div class="stat-label">AI Quizzes</div>
        </div>
    </div>

    <div class="quick-mood">
        <div class="mood-chip primary" onclick="location.href='/daily-task'"><i class="fas fa-tasks"></i> Daily Task</div>
        <div class="mood-chip" onclick="location.href='/study'"><i class="fas fa-graduation-cap"></i> Study Hub</div>
        <div class="mood-chip" onclick="location.href='/setup-test'"><i class="fas fa-bolt"></i> Quiz</div>
        <div class="mood-chip" onclick="location.href='/timetable'"><i class="fas fa-table"></i> Timetable</div>
        <div class="mood-chip" onclick="location.href='/cgpa'"><i class="fas fa-chart-line"></i> CGPA</div>
        <div class="mood-chip" onclick="location.href='/refer'"><i class="fas fa-gift"></i> Refer</div>
        <div class="mood-chip" onclick="location.href='/history'"><i class="fas fa-chart-bar"></i> History</div>
        <div class="mood-chip" onclick="location.href='/daily-challenge'"><i class="fas fa-calendar-check"></i> Challenge</div>
    </div>

    <% if (!user.has_paid) { %>
    <div class="upgrade-strip">
        <div class="us-icon"><i class="fas fa-crown"></i></div>
        <div class="us-content">
            <h4>Unlock Premium</h4>
            <p>AI tutors, CGPA tracker & more</p>
        </div>
        <button class="us-btn" onclick="payWithPaystack()">₦2,000</button>
    </div>
    <% } %>

    <div class="section-head">
        <h2>Your Tools</h2>
    </div>

    <div class="feature-grid">

        <!-- ═══ STUDY TOOLS ═══ -->
        <a href="/study" class="feature-card featured">
            <div class="fc-icon"><i class="fas fa-graduation-cap"></i></div>
            <div class="fc-body">
                <div class="fc-label">Study with AI</div>
                <div class="fc-desc">Courses, flashcards, quizzes & AI tutor</div>
            </div>
            <div class="fc-arrow"><i class="fas fa-arrow-right"></i></div>
        </a>

        <a href="/cgpa" class="feature-card <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'payWithPaystack(event)' %>" style="position:relative;">
            <% if (!user.has_paid) { %><div class="lock-overlay"><i class="fas fa-lock"></i> Premium</div><% } %>
            <div class="fc-icon" style="background:#e0f2fe;color:#0284c7;"><i class="fas fa-chart-line"></i></div>
            <div class="fc-label">CGPA Tracker</div>
            <div class="fc-desc">Forecast & AI advisor</div>
        </a>

        <a href="/ai-quiz" class="feature-card <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'payWithPaystack(event)' %>" style="position:relative;">
            <% if (!user.has_paid) { %><div class="lock-overlay"><i class="fas fa-lock"></i> Premium</div><% } %>
            <div class="fc-icon" style="background:#f0fdf4;color:#16a34a;"><i class="fas fa-wand-magic-sparkles"></i></div>
            <div class="fc-label">AI Quiz Generator</div>
            <div class="fc-desc">Generate quizzes from PDF</div>
        </a>

        <!-- ═══ DAILY & TASK TOOLS ═══ -->
        <a href="/daily-task" class="feature-card featured" style="background:linear-gradient(135deg,#0d9488,#0891b2);margin-bottom:10px;">
            <div class="fc-icon"><i class="fas fa-tasks"></i></div>
            <div class="fc-body">
                <div class="fc-label">Daily Task</div>
                <div class="fc-desc">Timetable, goals, deadlines & weekly report</div>
            </div>
            <div class="fc-arrow"><i class="fas fa-arrow-right"></i></div>
        </a>

        <a href="/timetable" class="feature-card <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'payWithPaystack(event)' %>" style="position:relative;">
            <% if (!user.has_paid) { %><div class="lock-overlay"><i class="fas fa-lock"></i> Premium</div><% } %>
            <div class="fc-icon" style="background:#f3e8ff;color:#7c3aed;"><i class="fas fa-table"></i></div>
            <div class="fc-label">Timetable</div>
            <div class="fc-desc">AI-powered schedule</div>
        </a>

        <a href="/reading-timetable" class="feature-card <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'payWithPaystack(event)' %>" style="position:relative;">
            <% if (!user.has_paid) { %><div class="lock-overlay"><i class="fas fa-lock"></i> Premium</div><% } %>
            <div class="fc-icon" style="background:#dbeafe;color:#0284c7;"><i class="fas fa-book-open"></i></div>
            <div class="fc-label">Reading Schedule</div>
            <div class="fc-desc">Smart study plan</div>
        </a>

        <a href="/deadlines" class="feature-card <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'payWithPaystack(event)' %>" style="position:relative;">
            <% if (!user.has_paid) { %><div class="lock-overlay"><i class="fas fa-lock"></i> Premium</div><% } %>
            <div class="fc-icon" style="background:#fee2e2;color:#ef4444;"><i class="fas fa-hourglass-half"></i></div>
            <div class="fc-label">Deadlines</div>
            <div class="fc-desc">Track milestones</div>
        </a>

        <!-- ═══ EXTRAS ═══ -->
        <a href="/history" class="feature-card <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'payWithPaystack(event)' %>" style="position:relative;">
            <% if (!user.has_paid) { %><div class="lock-overlay"><i class="fas fa-lock"></i> Premium</div><% } %>
            <div class="fc-icon" style="background:#fef3c7;color:#f59e0b;"><i class="fas fa-chart-bar"></i></div>
            <div class="fc-label">History</div>
            <div class="fc-desc">Quiz performance</div>
        </a>

        <a href="/daily-challenge" class="feature-card">
            <div class="fc-icon" style="background:#d1fae5;color:#10b981;"><i class="fas fa-calendar-check"></i></div>
            <div class="fc-label">Daily Challenge</div>
            <div class="fc-desc">Free daily competition</div>
        </a>

        <a href="/competition" class="feature-card <%= user.has_paid ? '' : 'locked' %>" onclick="<%= user.has_paid ? '' : 'payWithPaystack(event)' %>" style="position:relative;">
            <% if (!user.has_paid) { %><div class="lock-overlay"><i class="fas fa-lock"></i> Premium</div><% } %>
            <div class="fc-icon" style="background:#fce7f3;color:#ec4899;"><i class="fas fa-trophy"></i></div>
            <div class="fc-label">Live Arena</div>
            <div class="fc-desc">Real-time rankings</div>
        </a>

        <a href="/refer" class="feature-card">
            <div class="fc-icon" style="background:#d1fae5;color:#10b981;"><i class="fas fa-gift"></i></div>
            <div class="fc-label">Refer & Earn</div>
            <div class="fc-desc">15% commission on referrals</div>
        </a>

        <a href="/guide" class="feature-card">
            <div class="fc-icon" style="background:#e0e7ff;color:#3730a3;"><i class="fas fa-book"></i></div>
            <div class="fc-label">User Guide</div>
            <div class="fc-desc">How to use every feature</div>
        </a>

        <a href="/suggestions" class="feature-card">
            <div class="fc-icon" style="background:#e0f2fe;color:#0284c7;"><i class="fas fa-lightbulb"></i></div>
            <div class="fc-label">Feedback</div>
            <div class="fc-desc">Share your thoughts</div>
        </a>
    </div>

    <% if (typeof recentQuiz !== 'undefined' && recentQuiz) { %>
    <div class="section-head" style="padding-top:0.75rem;">
        <h2>Recent Activity</h2>
    </div>
    <div class="quick-resume">
        <a href="/history" class="resume-card">
            <div class="rc-icon"><i class="fas fa-bolt"></i></div>
            <div class="rc-body">
                <div class="rc-title"><%= recentQuiz.subject || 'Quiz' %></div>
                <div class="rc-meta"><%= new Date(recentQuiz.date_taken).toLocaleDateString('en-GB', { day:'numeric', month:'short' }) %></div>
            </div>
            <div class="rc-progress"><%= recentQuiz.score %>/<%= recentQuiz.total_questions %></div>
        </a>
    </div>
    <% } %>

    <div style="margin-top:1rem;">
        <div class="section-head">
            <h2>Daily Challenge</h2>
            <a href="/daily-challenge" class="see-all">Join <i class="fas fa-arrow-right" style="font-size:0.6rem;"></i></a>
        </div>
        <a href="/daily-challenge" class="daily-banner">
            <div class="db-left">
                <div class="db-icon"><i class="fas fa-fire-alt"></i></div>
                <div class="db-text">
                    <h4>Today's Challenge</h4>
                    <p>Compete live with peers</p>
                </div>
            </div>
            <div class="db-arrow"><i class="fas fa-chevron-right"></i></div>
        </a>
    </div>

    <div class="bottom-spacer"></div>

    <nav class="bottom-nav">
        <a href="/dashboard" class="nav-link active"><i class="fas fa-home"></i><span>Home</span></a>
        <a href="/study" class="nav-link"><i class="fas fa-graduation-cap"></i><span>Study</span></a>

        <a href="/history" class="nav-link"><i class="fas fa-chart-bar"></i><span>Stats</span></a>
        <a href="/profile" class="nav-link"><i class="fas fa-user-circle"></i><span>Profile</span></a>
    </nav>
</div>

<script>
function payWithPaystack(e, presets) {
    if (e) { e.preventDefault(); }
    if (typeof PaystackPop === 'undefined') { alert('Payment system loading. Please try again.'); return; }
    var pAmount = (presets && presets.amount) || <%= premiumPrice %>;
    var pCoupon = (presets && presets.coupon) || '';
    Swal.fire({
        title: 'Have a coupon code?',
        input: 'text',
        inputPlaceholder: 'Enter code or leave blank',
        showCancelButton: true,
        confirmButtonText: 'Continue',
        cancelButtonText: 'No coupon',
        preConfirm: function(val) {
            if (!val || !val.trim()) return { code: null, amount: pAmount };
            return fetch('/api/coupon/validate', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: val.trim() })
            }).then(function(r) { return r.json(); }).then(function(d) {
                if (!d.valid) { Swal.showValidationMessage(d.message || 'Invalid code'); return false; }
                return { code: d.code, amount: d.final_amount, discountLabel: d.discountLabel, original: d.original_amount };
            });
        },
        allowOutsideClick: false
    }).then(function(result) {
        if (!result || !result.isConfirmed || !result.value) return;
        var info = result.value;
        var callbackUrl = '/verify-payment?reference=';
        if (info.code) callbackUrl += 'REPLACE_REF&coupon=' + encodeURIComponent(info.code);
        else callbackUrl += 'REPLACE_REF';
        if (info.discountLabel) {
            Swal.fire({ icon: 'info', title: info.discountLabel + ' applied!', text: 'You pay ₦' + info.amount.toLocaleString(), timer: 2000, showConfirmButton: false });
        }
        var amount = (info.amount || pAmount) * 100;
        var handler = PaystackPop.setup({
            key: '<%= paystack_key %>',
            email: '<%= user.email %>',
            amount: amount,
            currency: 'NGN',
            callback: function(response) {
                var ref = response.reference;
                var dest = '/verify-payment?reference=' + ref;
                if (info.code) dest += '&coupon=' + encodeURIComponent(info.code);
                window.location.href = dest;
            },
            onClose: function() {}
        });
        setTimeout(function() { handler.openIframe(); }, info.discountLabel ? 2200 : 100);
    });
}

(function() {
    const params = new URLSearchParams(window.location.search);
    const payment = params.get('payment');
    if (payment === 'success') {
        Swal.fire({ icon: 'success', title: 'Payment Successful!', text: 'Premium unlocked!', timer: 3000, timerProgressBar: true, showConfirmButton: true }).then(() => window.history.replaceState({}, document.title, '/dashboard'));
    } else if (payment === 'failed') {
        Swal.fire({ icon: 'error', title: 'Payment Failed', text: 'Please try again', timer: 4000, showConfirmButton: true }).then(() => window.history.replaceState({}, document.title, '/dashboard'));
    }

    const hour = new Date().getHours();
    let g = 'Good evening';
    if (hour < 12) g = 'Good morning';
    else if (hour < 17) g = 'Good afternoon';
    document.getElementById('greeting-text').textContent = g;
})();
</script>
</body>
</html>
