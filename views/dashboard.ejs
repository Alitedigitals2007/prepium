<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Dashboard</title>
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { 
            --brand: #0062ff; 
            --bg: #f8fafc; 
            --text: #0f172a; 
            --sub: #64748b; 
        }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; outline: none; }
        
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: var(--bg); 
            margin: 0; 
            padding: 0;
            color: var(--text); 
            display: flex; 
            justify-content: center; 
        }

        .app-shell { 
            width: 100%; 
            max-width: 430px; 
            background: white; 
            min-height: 100vh; 
            position: relative; 
            box-shadow: 0 0 60px rgba(0,0,0,0.05);
            padding-bottom: 110px;
        }

        /* Modernized Responsive Header */
        .header-main { 
            padding: 2rem 1.5rem 1.5rem;
            background: linear-gradient(180deg, #f0f7ff 0%, #ffffff 100%);
            border-bottom: 1px solid #f1f5f9;
        }

        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        /* Prepium App Logo */
        .brand-logo {
            font-size: 1.25rem;
            font-weight: 800;
            letter-spacing: -0.8px;
            color: var(--text);
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .brand-logo span {
            color: var(--brand);
        }

        /* Fast Top-Right CTA Button */
        .top-upgrade-btn {
            background: var(--brand);
            color: white;
            border: none;
            padding: 10px 16px;
            border-radius: 14px;
            font-size: 0.78rem;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(0, 62, 255, 0.25);
            animation: pulse-glow 2s infinite;
            text-wrap: nowrap;
        }
        @keyframes pulse-glow {
            0% { transform: scale(1); box-shadow: 0 4px 12px rgba(0, 62, 255, 0.25); }
            50% { transform: scale(1.03); box-shadow: 0 4px 16px rgba(0, 62, 255, 0.45); }
            100% { transform: scale(1); box-shadow: 0 4px 12px rgba(0, 62, 255, 0.25); }
        }

        .user-profile { display: flex; align-items: center; gap: 14px; }
        .avatar-circle { 
            width: 54px; 
            height: 54px; 
            background: #f1f5f9; 
            color: var(--brand);
            border: 2px solid #e2e8f0;
            border-radius: 20px; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            font-weight: 800; 
            font-size: 1.35rem;
        }
        
        .welcome-msg h1 { margin: 0; font-size: 1.35rem; font-weight: 800; letter-spacing: -0.5px; }
        .tier-pill { 
            font-size: 0.65rem; 
            font-weight: 800; 
            padding: 4px 10px; 
            border-radius: 8px; 
            text-transform: uppercase; 
            margin-top: 5px; 
            display: inline-block;
            letter-spacing: 0.3px;
        }
        .paid { background: #e0f2fe; color: var(--brand); }
        .unpaid { background: #f1f5f9; color: var(--sub); }

        /* Mobile Action Grid */
        .menu-grid { 
            display: grid; 
            grid-template-columns: repeat(2, 1fr); 
            gap: 14px; 
            padding: 1.2rem 1.5rem; 
        }
        .menu-card { 
            background: #ffffff; 
            border: 1px solid #f1f5f9; 
            padding: 1.5rem 1rem; 
            border-radius: 24px; 
            text-align: center; 
            text-decoration: none; 
            transition: 0.2s;
            box-shadow: 0 4px 6px rgba(0,0,0,0.01);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .menu-card:active { transform: translateY(2px); background: #f8fafc; }
        .menu-card i { 
            font-size: 1.8rem; 
            display: block; 
            margin-bottom: 8px; 
            font-style: normal;
        }
        .menu-card b { font-size: 0.88rem; font-weight: 800; color: var(--text); display: block; }
        .menu-card p { font-size: 0.68rem; color: var(--sub); margin: 4px 0 0; font-weight: 600; }
        
        /* Premium lock state */
        .locked-card { 
            opacity: 0.55; 
            filter: grayscale(1); 
            cursor: not-allowed;
            background: #fafafa;
        }

        /* App Sticky Bottom Navigation Bar */
        .nav-bar { 
            position: fixed; 
            bottom: 0; 
            width: 100%; 
            max-width: 430px; 
            background: rgba(255, 255, 255, 0.98); 
            backdrop-filter: blur(8px);
            height: 85px; 
            display: flex; 
            justify-content: space-around; 
            align-items: center; 
            border-top: 1px solid #f1f5f9; 
            z-index: 1000;
            padding-bottom: 12px;
        }
        .nav-item { text-decoration: none; color: #94a3b8; font-size: 0.65rem; font-weight: 800; text-align: center; }
        .nav-item.active { color: var(--brand); }
        .nav-item i { display: block; font-size: 1.35rem; margin-bottom: 4px; font-style: normal; }

        .center-fab { 
            width: 58px; 
            height: 58px; 
            background: var(--brand); 
            border-radius: 20px; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            color: white; 
            font-size: 1.8rem; 
            transform: translateY(-22px); 
            border: 5px solid white; 
            box-shadow: 0 10px 20px rgba(0, 98, 255, 0.3);
            text-decoration: none;
        }
        .center-fab.locked-fab {
            background: #94a3b8;
            box-shadow: none;
            opacity: 0.7;
            cursor: not-allowed;
        }
        
        .dot { height: 8px; width: 8px; background: #ef4444; border-radius: 50%; position: absolute; top: 0; right: 0; border: 2px solid white; }
    </style>
</head>
<body>

    <div class="app-shell">
        <header class="header-main">
            <div class="header-top">
                <div class="brand-logo">Prepium<span>.</span></div>
                <% if (!user.has_paid) { %>
                    <button id="pay-btn-top" onclick="payWithPaystack()" class="top-upgrade-btn">Upgrade — ₦500</button>
                <% } %>
            </div>

            <div class="user-profile">
                <div class="avatar-circle">
                    <%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %>
                </div>
                <div class="welcome-msg">
                    <h1>Hi, <%= user.fullname ? user.fullname.split(' ')[0] : 'Student' %></h1>
                    <span class="tier-pill <%= user.has_paid ? 'paid' : 'unpaid' %>">
                        <%= user.has_paid ? 'Premium Access' : 'Basic Plan' %>
                    </span>
                </div>
            </div>
        </header>

        <div class="menu-grid">
            
            <% if (!user.has_paid) { %>
                <% if (user.quiz_attempts < 2) { %>
                    <a href="/setup-test" class="menu-card" style="border: 2px solid var(--brand); background: #f0f7ff;">
                        <i>⚡</i>
                        <b style="color: var(--brand);">Try Free Quiz</b>
                        <p style="color: var(--brand); font-weight: 700;">
                            <%= 2 - user.quiz_attempts %> of 2 attempts left
                        </p>
                    </a>
                <% } else { %>
                    <a href="#" onclick="payWithPaystack()" class="menu-card" style="border: 1px dashed #cbd5e1; background: #f8fafc;">
                        <i>🔒</i>
                        <b style="color: var(--sub);">Free Quizzes Used</b>
                        <p style="color: var(--brand); font-weight: 700;">Tap to Upgrade</p>
                    </a>
                <% } %>
            <% } %>

            <a href="<%= user.has_paid ? '/subjects' : '#' %>" class="menu-card <%= !user.has_paid ? 'locked-card' : '' %>">
                <i>📚</i>
                <b>Study Library</b>
                <p>Course Books</p>
            </a>
            
            <a href="<%= user.has_paid ? '/history' : '#' %>" class="menu-card <%= !user.has_paid ? 'locked-card' : '' %>">
                <i>📜</i>
                <b>Performance</b>
                <p>Past Results</p>
            </a>

            <a href="<%= user.has_paid ? '/competition' : '#' %>" class="menu-card <%= !user.has_paid ? 'locked-card' : '' %>">
                <i>🏆</i>
                <b>Live Arena</b>
                <p>Rank Tracker</p>
            </a>

            <a href="<%= user.has_paid ? '/deadlines' : '#' %>" class="menu-card <%= !user.has_paid ? 'locked-card' : '' %>">
                <i>⏳</i>
                <b>Deadlines</b>
                <p>Countdown</p>
            </a>

            <a href="<%= user.has_paid ? '/pomodoro' : '#' %>" class="menu-card <%= !user.has_paid ? 'locked-card' : '' %>">
                <i>⏱️</i>
                <b>Pomodoro</b>
                <p>Study Timer</p>
            </a>

            <a href="<%= user.has_paid ? '/timetable' : '#' %>" class="menu-card <%= !user.has_paid ? 'locked-card' : '' %>">
                <i>📅</i>
                <b>Timetable</b>
                <p>Day Planner</p>
            </a>

            <a href="https://alitedigitals.vercel.app/projects" target="_blank" class="menu-card">
                <i>🏪</i>
                <b>Alite Store</b>
                <p>Tech Projects</p>
            </a>

            <a href="/suggestions" class="menu-card">
                <i>✍️</i>
                <b>Feedback</b>
                <p>Send Review</p>
            </a>

            <a href="/how-it-works" class="menu-card">
                <i>❓</i>
                <b>How it Works</b>
                <p>User Guide</p>
            </a>

            <a href="/profile" class="menu-card">
                <i>👤</i>
                <b>Profile</b>
                <p>Account Settings</p>
            </a>

        </div>

        <nav class="nav-bar">
            <a href="/dashboard" class="nav-item active"><i>🏠</i>Home</a>
            <a href="<%= user.has_paid ? '/history' : '#' %>" class="nav-item <%= !user.has_paid ? 'locked-card' : '' %>"><i>📊</i>Stats</a>
            
            <% if (user.has_paid || (!user.has_paid && user.quiz_attempts < 2)) { %>
                <a href="/setup-test" class="center-fab">+</a>
            <% } else { %>
                <a href="#" onclick="payWithPaystack()" class="center-fab locked-fab">+</a>
            <% } %>
            
            <a href="<%= user.has_paid ? '/notifications' : '#' %>" class="nav-item <%= !user.has_paid ? 'locked-card' : '' %>" style="position: relative;">
                <i>🔔</i>Alerts
                <% if (locals.hasNewNotifs) { %><span class="dot"></span><% } %>
            </a>
            <a href="/profile" class="nav-item"><i>👤</i>Profile</a>
        </nav>
    </div>

    <script>
        function payWithPaystack() {
            const btn = document.getElementById('pay-btn-top');
            
            // Temporary loader state for UI feedback
            if (btn) {
                btn.innerHTML = "Opening Pay...";
                btn.disabled = true;
            }

            let handler = PaystackPop.setup({
                key: '<%= paystack_key %>',
                email: '<%= user.email %>',
                amount: 500 * 100, 
                currency: 'NGN',
                callback: function(response) {
                    window.location.href = "/verify-payment?reference=" + response.reference;
                },
                onClose: function() {
                    if (btn) {
                        btn.innerHTML = "Upgrade — ₦500";
                        btn.disabled = false;
                    }
                }
            });
            handler.openIframe();
        }
    </script>
</body>
</html>