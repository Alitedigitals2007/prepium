<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <style>
        body::before { display: none; }
        .app-shell { background: transparent; backdrop-filter: none; border: none; padding-bottom: 110px; }

        .dash-header { padding: 1.25rem 1.25rem 0.75rem; display: flex; align-items: center; justify-content: space-between; }
        .dash-header-left { display: flex; align-items: center; gap: 12px; }
        .dash-avatar { width: 46px; height: 46px; border-radius: 16px; background: var(--brand-gradient); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.1rem; box-shadow: 0 4px 14px var(--brand-light); }
        .dash-greeting { font-size: 0.62rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; }
        .dash-name { font-size: 1.15rem; font-weight: 800; line-height: 1.2; }
        .dash-header-right { display: flex; align-items: center; gap: 8px; }
        .hamburger-btn { width: 42px; height: 42px; border-radius: 12px; background: var(--surface-solid); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; color: var(--text-secondary); font-size: 1rem; cursor: pointer; transition: var(--transition); }
        .hamburger-btn:hover { background: var(--bg); border-color: var(--brand); }
        .hamburger-btn:active { transform: scale(0.92); }
        .notif-bell { width: 42px; height: 42px; border-radius: 14px; background: var(--surface-solid); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; color: var(--text-secondary); font-size: 1rem; cursor: pointer; position: relative; box-shadow: var(--shadow-sm); transition: var(--transition); }
        .notif-bell:active { transform: scale(0.92); }
        .notif-dot { position: absolute; top: 8px; right: 8px; width: 8px; height: 8px; border-radius: 50%; background: var(--danger); border: 2px solid var(--surface-solid); }
        .streak-badge { display: flex; align-items: center; gap: 5px; padding: 8px 14px; border-radius: 12px; background: linear-gradient(135deg,#f97316,#ef4444); color: white; font-weight: 800; font-size: 0.75rem; box-shadow: 0 4px 12px rgba(239,68,68,0.25); }
        .streak-badge i { font-size: 0.85rem; }

        /* Next action hero card */
        .next-card { margin: 0 1.25rem 1.25rem; border-radius: 20px; padding: 18px; background: var(--brand-gradient); color: #fff; display: flex; align-items: center; gap: 14px; text-decoration: none; box-shadow: 0 8px 28px var(--brand-light); position: relative; overflow: hidden; }
        .next-card::before { content: ''; position: absolute; top: -45%; right: -15%; width: 170px; height: 170px; border-radius: 50%; background: rgba(255,255,255,0.09); }
        .next-card .nc-icon { width: 46px; height: 46px; flex: 0 0 46px; border-radius: 14px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 1.05rem; position: relative; }
        .next-card .nc-body { flex: 1; min-width: 0; position: relative; }
        .next-card .nc-kicker { font-size: 0.6rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; opacity: 0.8; }
        .next-card .nc-title { font-size: 0.95rem; font-weight: 800; margin: 2px 0 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .next-card .nc-sub { font-size: 0.68rem; opacity: 0.85; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .next-card .nc-cta { flex-shrink: 0; padding: 9px 16px; border-radius: 12px; background: rgba(255,255,255,0.22); color: #fff; font-weight: 800; font-size: 0.72rem; position: relative; }

        /* Onboarding */
        .onboard-card { margin: 0 1.25rem 1.25rem; border-radius: 20px; padding: 20px 18px; background: var(--surface-solid); border: 1px solid var(--border); box-shadow: var(--shadow-sm); }
        .onboard-card h3 { font-size: 1rem; font-weight: 800; margin: 0 0 4px; }
        .onboard-card > p { font-size: 0.75rem; color: var(--text-secondary); margin: 0 0 14px; }
        .onboard-steps { display: grid; gap: 8px; }
        .onboard-step { display: flex; align-items: center; gap: 12px; padding: 11px 12px; border-radius: 14px; background: var(--bg); text-decoration: none; color: inherit; }
        .onboard-step .os-num { width: 26px; height: 26px; flex: 0 0 26px; border-radius: 50%; background: var(--brand-soft); color: var(--brand); font-weight: 800; font-size: 0.75rem; display: flex; align-items: center; justify-content: center; }
        .onboard-step .os-body { flex: 1; min-width: 0; }
        .onboard-step .os-title { font-size: 0.8rem; font-weight: 700; }
        .onboard-step .os-sub { font-size: 0.66rem; color: var(--text-secondary); }
        .onboard-step i.fa-chevron-right { font-size: 0.65rem; color: var(--text-muted); }

        .hero-strip { padding: 0 1.25rem 1.25rem; display: flex; flex-wrap: wrap; gap: 8px; }
        .hero-stat { flex: 1 1 calc(50% - 4px); min-width: 0; background: var(--surface-solid); border-radius: 18px; padding: 14px 10px; border: 1px solid var(--border); box-shadow: var(--shadow-sm); }
        .hero-stat .stat-icon { width: 36px; height: 36px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; margin-bottom: 8px; }
        .hero-stat .stat-num { font-size: 1.3rem; font-weight: 800; line-height: 1; }
        .hero-stat .stat-label { font-size: 0.6rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.3px; margin-top: 3px; }

        .section-head { padding: 0.5rem 1.25rem 0.75rem; display: flex; align-items: center; justify-content: space-between; }
        .section-head h2 { font-size: 1rem; font-weight: 800; letter-spacing: -0.3px; }
        .section-head .see-all { font-size: 0.68rem; font-weight: 700; color: var(--brand); cursor: pointer; text-decoration: none; background: none; border: none; font-family: var(--font); }

        /* ── Phone-style app grid ── */
        .app-grid { padding: 0 1.25rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px 6px; }
        .app-tile { display: flex; flex-direction: column; align-items: center; gap: 7px; text-decoration: none; position: relative; }
        .app-tile:active .at-icon { transform: scale(0.9); }
        .app-tile .at-icon {
            width: 56px; height: 56px; border-radius: 17px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.3rem; position: relative;
            background: var(--surface-solid); border: 1px solid var(--border);
            box-shadow: var(--shadow-sm); transition: transform 0.15s var(--ease-out);
        }
        .app-tile .at-label { font-size: 0.62rem; font-weight: 700; color: var(--text-secondary); text-align: center; line-height: 1.25; max-width: 74px; }
        .app-tile.locked .at-icon { opacity: 0.55; }
        .app-tile.locked .at-label { opacity: 0.55; }
        .app-tile .at-lock {
            position: absolute; top: -3px; right: 6px;
            width: 18px; height: 18px; border-radius: 50%;
            background: var(--surface-solid); border: 1px solid var(--border);
            display: flex; align-items: center; justify-content: center;
            font-size: 0.55rem; color: var(--text-muted); box-shadow: var(--shadow-sm);
        }

        /* Quick dock (phone-style home bar) */
        .quick-dock { padding: 0 1.25rem; display: flex; justify-content: space-around; margin-bottom: 1.5rem; }
        .dock-item { display: flex; flex-direction: column; align-items: center; gap: 4px; text-decoration: none; color: inherit; font-family: var(--font); background: none; border: none; cursor: pointer; flex: 1; max-width: 72px; }
        .dock-item span { font-size: 0.62rem; font-weight: 600; color: var(--text-secondary); margin-top: 2px; }
        .dock-item.locked { opacity: 0.55; }
        .dock-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; box-shadow: var(--shadow-sm); }
        .dock-icon.c-blue { background: var(--brand-soft); color: var(--brand); }
        .dock-icon.c-green { background: var(--success-soft); color: var(--success); }
        .dock-icon.c-amber { background: var(--warning-soft); color: var(--warning); }
        .dock-icon.c-red { background: var(--danger-soft); color: var(--danger); }
        .dock-icon.c-grad { background: var(--brand-gradient); color: #fff; box-shadow: 0 4px 14px var(--brand-light); }
        .dock-icon.c-teal { background: linear-gradient(135deg,#0d9488,#0891b2); color: #fff; }
        .dock-icon.c-orange { background: linear-gradient(135deg,#f59e0b,#ef4444); color: #fff; }
        .dock-lock { position: absolute; top: -4px; right: 4px; width: 16px; height: 16px; border-radius: 50%; background: var(--surface-solid); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 0.4rem; color: var(--text-muted); }

        /* ── App drawer (all apps) ── */
        .app-drawer {
            position: fixed; inset: 0; z-index: 3000;
            background: var(--bg); display: none;
            overflow-y: auto; -webkit-overflow-scrolling: touch;
            padding: 18px 16px 60px;
        }
        .app-drawer.open { display: block; }
        .drawer-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; max-width: 640px; margin-left: auto; margin-right: auto; }
        .drawer-head h2 { font-size: 1.15rem; font-weight: 800; color: var(--text-primary); margin: 0; }
        .drawer-close { width: 40px; height: 40px; border-radius: 13px; border: 1px solid var(--border); background: var(--surface-solid); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; cursor: pointer; }
        .drawer-search {
            width: 100%; max-width: 640px; margin: 0 auto 18px; display: block;
            padding: 12px 16px; border-radius: 14px; border: 1px solid var(--border);
            background: var(--surface-solid); color: var(--text-primary);
            font-family: var(--font); font-size: 0.88rem; box-sizing: border-box;
        }
        .drawer-group-label {
            font-size: 0.66rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.08em; color: var(--text-muted);
            max-width: 640px; margin: 18px auto 10px;
        }
        .drawer-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px 6px; max-width: 640px; margin: 0 auto; }
        .drawer-empty { text-align: center; color: var(--text-muted); font-size: 0.8rem; padding: 20px 0; max-width: 640px; margin: 0 auto; }

        /* Today rows */
        .today-list { padding: 0 1.25rem; display: grid; gap: 8px; }
        .today-row { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 14px; background: var(--surface-solid); border: 1px solid var(--border); box-shadow: var(--shadow-sm); text-decoration: none; color: inherit; }
        .today-row .tr-icon { width: 38px; height: 38px; flex: 0 0 38px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem; background: var(--brand-soft); color: var(--brand); }
        .today-row .tr-body { flex: 1; min-width: 0; }
        .today-row .tr-title { font-size: 0.8rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .today-row .tr-meta { font-size: 0.66rem; color: var(--text-secondary); font-weight: 600; margin-top: 1px; }
        .today-row .tr-badge { flex-shrink: 0; }

        .quick-resume { padding: 0 1.25rem; }
        .resume-card { background: var(--surface-solid); border-radius: 18px; padding: 16px; border: 1px solid var(--border); box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 14px; text-decoration: none; color: inherit; margin-bottom: 10px; transition: var(--transition); }
        .resume-card:active { transform: scale(0.98); }
        .resume-card .rc-icon { width: 44px; height: 44px; border-radius: 14px; background: var(--brand-soft); display: flex; align-items: center; justify-content: center; color: var(--brand); font-size: 1rem; flex-shrink: 0; }
        .resume-card .rc-body { flex: 1; min-width: 0; }
        .resume-card .rc-body .rc-title { font-size: 0.82rem; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .resume-card .rc-body .rc-meta { font-size: 0.65rem; color: var(--text-secondary); font-weight: 600; margin-top: 1px; }
        .resume-card .rc-progress { width: 40px; text-align: right; font-size: 0.75rem; font-weight: 800; color: var(--brand); }

        .daily-banner { margin: 0 1.25rem 1.25rem; padding: 18px 20px; border-radius: 20px; background: linear-gradient(135deg,var(--accent),var(--brand)); color: white; display: flex; align-items: center; justify-content: space-between; text-decoration: none; box-shadow: 0 6px 20px var(--brand-light); position: relative; overflow: hidden; }
        .daily-banner::before { content: ''; position: absolute; top: -40%; right: -20%; width: 160px; height: 160px; border-radius: 50%; background: rgba(255,255,255,0.08); }
        .daily-banner .db-left { display: flex; align-items: center; gap: 12px; position: relative; }
        .daily-banner .db-icon { width: 40px; height: 40px; border-radius: 12px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }
        .daily-banner .db-text h4 { font-size: 0.88rem; font-weight: 800; margin: 0; }
        .daily-banner .db-text p { font-size: 0.68rem; opacity: 0.85; margin: 2px 0 0; font-weight: 500; }
        .daily-banner .db-arrow { font-size: 0.8rem; opacity: 0.7; position: relative; }

        <% if (!user.has_paid) { %>
        .upgrade-strip { margin: 0 1.25rem 1.25rem; padding: 18px 20px; border-radius: 20px; background: linear-gradient(135deg,var(--surface-solid) 0%,var(--surface) 100%); color: var(--text-primary); display: flex; align-items: center; gap: 14px; position: relative; overflow: hidden; border: 1px solid var(--border); }
        .upgrade-strip::before { content: ''; position: absolute; top: -50%; right: -20%; width: 200px; height: 200px; border-radius: 50%; background: var(--brand-light); }
        .upgrade-strip .us-icon { width: 44px; height: 44px; border-radius: 14px; background: var(--brand-light); display: flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0; color: var(--brand); }
        .upgrade-strip .us-content { flex: 1; }
        .upgrade-strip .us-content h4 { font-size: 0.85rem; font-weight: 800; margin: 0; }
        .upgrade-strip .us-content p { font-size: 0.7rem; opacity: 0.7; font-weight: 500; margin: 2px 0 0; color: var(--text-secondary); }
        .upgrade-strip .us-btn { padding: 10px 18px; border-radius: 12px; background: var(--brand); color: white; font-weight: 800; font-size: 0.72rem; border: none; cursor: pointer; flex-shrink: 0; }
        <% } %>

        .bottom-spacer { height: 20px; }

        /* ── Desktop ≥1024px ── */
        @media (min-width: 1024px) {
            .app-shell { padding-bottom: 40px; }
            .dash-content { max-width: 1080px; margin: 0 auto; padding: 0 32px 40px; }
            .dash-columns { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 24px; align-items: start; }
            .dash-col-main { min-width: 0; }
            .dash-col-side { min-width: 0; }
            .dash-header { padding: 2rem 0 1rem; }
            .hero-strip { padding: 0 0 1.25rem; }
            .hero-stat { flex: 1 1 calc(25% - 6px); }
            .next-card { margin: 0 0 1.25rem; }
            .onboard-card { margin: 0 0 1.25rem; }
            .upgrade-strip { margin: 0 0 1.25rem; }
            .section-head { padding: 0.5rem 0 0.75rem; }
            .app-grid { padding: 0; grid-template-columns: repeat(6, 1fr); gap: 20px 8px; }
            .app-tile .at-icon { width: 64px; height: 64px; }
            .today-list { padding: 0; }
            .quick-resume { padding: 0; }
            .daily-banner { margin: 0 0 1.25rem; }
            .dash-side-block { background: var(--surface-solid); border: 1px solid var(--border); border-radius: 18px; padding: 16px; box-shadow: var(--shadow-sm); margin-bottom: 16px; }
            .dash-side-block h3 { font-size: 0.8rem; font-weight: 800; margin: 0 0 10px; display: flex; align-items: center; gap: 8px; color: var(--text-primary); }
            .dash-side-block h3 i { color: var(--brand); font-size: 0.8rem; }
            .side-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; }
            .side-row + .side-row { border-top: 1px dashed var(--border-solid); }
            .side-row .sr-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--brand); flex-shrink: 0; }
            .side-row .sr-body { flex: 1; min-width: 0; }
            .side-row .sr-title { font-size: 0.76rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
            .side-row .sr-meta { font-size: 0.64rem; color: var(--text-secondary); font-weight: 600; }
            .side-empty { font-size: 0.72rem; color: var(--text-muted); line-height: 1.5; }
            .dash-mobile-only { display: none !important; }
        }
        @media (max-width: 1023.98px) {
            .dash-desktop-only { display: none !important; }
        }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/app-intro') %>
<%- include('partials/sidebar') %>
<div class="app-shell">
  <div class="dash-content">
    <div class="dash-header">
        <div class="dash-header-left">
            <button class="hamburger-btn" onclick="openDrawer()" aria-label="All apps">
                <i class="fas fa-bars"></i>
            </button>
             <div class="dash-avatar"><%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %></div>
            <div>
                <div class="dash-greeting" id="greeting-text">Good morning</div>
                <div class="dash-name"><%= user.fullname ? user.fullname.split(' ')[0] : 'Student' %></div>
            </div>
        </div>
        <div class="dash-header_right">
            <div class="dash-clock" id="dashClock" style="font-size:0.75rem;font-weight:600;color:var(--text-secondary);">--:--</div>
            <div class="streak-badge"><i class="fas fa-fire"></i> <%= typeof streak !== 'undefined' ? streak : 0 %></div>
            <a href="/notifications" class="notif-bell" aria-label="Notifications">
                <i class="fas fa-bell"></i>
                <% if (typeof unreadNotifs !== 'undefined' && unreadNotifs > 0) { %><div class="notif-dot"></div><% } %>
            </a>
        </div>
    </div>

    <% if (typeof notice !== 'undefined' && notice && notice.message) { %>
    <div class="notice-strip" style="margin:0 1.25rem 1.25rem;">
        <i class="fas fa-bullhorn"></i>
        <span>
            <%= notice.message %>
            <% if (notice.link) { %> <a href="<%= notice.link %>" style="color:var(--brand);font-weight:700;"><%= notice.link_text || 'Learn more' %></a><% } %>
        </span>
    </div>
    <% } %>

    <% if (typeof isNewUser !== 'undefined' && isNewUser) { %>
    <div class="onboard-card">
        <h3>Welcome to Prepium, <%= user.fullname ? user.fullname.split(' ')[0] : 'Student' %>!</h3>
        <p>Set up your academics in three quick steps and get a study plan built around your courses.</p>
        <div class="onboard-steps">
            <a href="/study" class="onboard-step">
                <div class="os-num">1</div>
                <div class="os-body"><div class="os-title">Add your courses</div><div class="os-sub">Build your Study Hub so the AI tutor knows your syllabus</div></div>
                <i class="fas fa-chevron-right"></i>
            </a>
            <a href="/timetable" class="onboard-step">
                <div class="os-num">2</div>
                <div class="os-body"><div class="os-title">Add your timetable</div><div class="os-sub">Snap a photo — AI fills in your class schedule</div></div>
                <i class="fas fa-chevron-right"></i>
            </a>
            <a href="/setup-test" class="onboard-step">
                <div class="os-num">3</div>
                <div class="os-body"><div class="os-title">Take your first practice quiz</div><div class="os-sub">Pick your courses and start practising for exams</div></div>
                <i class="fas fa-chevron-right"></i>
            </a>
        </div>
    </div>
    <% } else if (typeof nextAction !== 'undefined' && nextAction) { %>
    <a href="<%= nextAction.href %>" class="next-card">
        <div class="nc-icon"><i class="fas <%= nextAction.icon %>"></i></div>
        <div class="nc-body">
            <div class="nc-kicker">Continue studying</div>
            <div class="nc-title"><%= nextAction.title %></div>
            <div class="nc-sub"><%= nextAction.sub %></div>
        </div>
        <div class="nc-cta"><%= nextAction.cta %></div>
    </a>
    <% } else { %>
    <a href="/setup-test" class="next-card">
        <div class="nc-icon"><i class="fas fa-bolt"></i></div>
        <div class="nc-body">
            <div class="nc-kicker">Continue studying</div>
            <div class="nc-title">Start a practice quiz</div>
            <div class="nc-sub">Pick your courses and test yourself</div>
        </div>
        <div class="nc-cta">Start</div>
    </a>
    <% } %>

    <div class="hero-strip">
        <div class="hero-stat">
            <div class="stat-icon" style="background:var(--brand-soft);color:var(--brand);"><i class="fas fa-check-circle"></i></div>
            <div class="stat-num"><%= typeof quizCount !== 'undefined' ? quizCount : 0 %></div>
            <div class="stat-label">Quizzes Done</div>
        </div>
        <div class="hero-stat">
            <div class="stat-icon" style="background:var(--warning-soft);color:var(--warning);"><i class="fas fa-trophy"></i></div>
            <div class="stat-num"><%= typeof avgScore !== 'undefined' ? avgScore + '%' : '0%' %></div>
            <div class="stat-label">Avg Score</div>
        </div>
        <div class="hero-stat">
            <div class="stat-icon" style="background:var(--success-soft);color:var(--success);"><i class="fas fa-book-open"></i></div>
            <div class="stat-num"><%= typeof studySessions !== 'undefined' ? studySessions : 0 %></div>
            <div class="stat-label">Study Sessions</div>
        </div>
        <div class="hero-stat">
            <div class="stat-icon" style="background:var(--success-soft);color:var(--success);"><i class="fas fa-robot"></i></div>
            <div class="stat-num"><%= typeof aiQuizCount !== 'undefined' ? aiQuizCount : 0 %></div>
            <div class="stat-label">AI Quizzes</div>
        </div>
    </div>

    <div class="dash-columns">
      <div class="dash-col-main">
        <% if (!user.has_paid) { %>
        <% if (migratedLocked) { %>
        <div class="upgrade-strip" style="background:linear-gradient(135deg,#fdf3e6 0%,var(--surface) 100%);border-color:var(--accent);">
            <div class="us-icon"><i class="fas fa-rotate-left"></i></div>
            <div class="us-content">
                <h4>Recharge Premium</h4>
                <p>Your free migration period is over — pay &#8358;<%= rechargePrice.toLocaleString() %> to continue</p>
            </div>
            <button class="us-btn" onclick="payWithPaystack(event)">Recharge Now</button>
        </div>
        <% } else { %>
        <div class="upgrade-strip">
