<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | AI CBT Arena</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- MathJax Configuration for LaTeX and Scientific Notations -->
    <script>
        window.MathJax = {
            tex: {
                inlineMath: [['\\(', '\\)'], ['$', '$']],
                displayMath: [['\\[', '\\]'], ['$$', '$$']],
                processEscapes: true
            },
            options: {
                skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre']
            }
        };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

    <style>
        :root { 
            --brand: #2563eb; 
            --brand-light: #eff6ff;
            --brand-gradient: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            --accent: #7c3aed; 
            --glass-surface: rgba(255, 255, 255, 0.75);
            --glass-border: rgba(148, 163, 184, 0.16);
            --glass-input: rgba(248, 250, 252, 0.8);
            --text-dark: #0f172a;
            --text-sub: #64748b;
            --border: #e2e8f0;
            --success: #10b981;
            --danger: #ef4444;
            --shadow-glass: 0 8px 32px 0 rgba(148, 163, 184, 0.06);
        }
        
        * { box-sizing: border-box; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); font-family: 'Plus Jakarta Sans', sans-serif; outline: none; -webkit-tap-highlight-color: transparent; }
        body { 
            background: #f8fafc; 
            background-image: radial-gradient(at 0% 0%, rgba(37, 99, 235, 0.03) 0, transparent 50%), radial-gradient(at 50% 0%, rgba(124, 58, 237, 0.03) 0, transparent 50%);
            margin: 0; 
            color: var(--text-dark); 
            display: flex; 
            justify-content: center; 
            min-height: 100vh;
        }
        
        .app-shell { 
            width: 100%; 
            max-width: 430px; 
            background: rgba(255, 255, 255, 0.85); 
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            min-height: 100vh; 
            position: relative; 
            padding: 0 1.5rem 120px; 
            border-left: 1px solid var(--glass-border);
            border-right: 1px solid var(--glass-border);
            display: flex; 
            flex-direction: column; 
        }
        
        .header { 
            display: flex; 
            align-items: center; 
            justify-content: space-between; 
            padding: 1.5rem 0 1rem; 
            position: sticky; 
            top: 0; 
            background: rgba(248, 250, 252, 0.6); 
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            z-index: 100; 
            border-bottom: 1px solid transparent; 
        }
        .header.scrolled { border-bottom-color: var(--glass-border); }
        .header-left { display: flex; align-items: center; gap: 12px; }
        
        .back-btn { 
            color: var(--text-dark); 
            text-decoration: none; 
            font-size: 0.95rem; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            width: 42px; 
            height: 42px; 
            border-radius: 14px; 
            background: var(--glass-surface); 
            border: 1px solid var(--glass-border);
            box-shadow: var(--shadow-glass);
        }
        .header h1 { font-size: 1.25rem; margin: 0; font-weight: 800; letter-spacing: -0.5px; }
        
        .history-shortcut { 
            color: var(--brand); 
            font-size: 1.1rem; 
            text-decoration: none; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            width: 42px; 
            height: 42px; 
            border-radius: 14px; 
            background: var(--brand-light); 
            border: 1px solid rgba(37, 99, 235, 0.1);
        }

        .card {
            background: var(--glass-surface);
            border: 1px solid var(--glass-border);
            padding: 24px;
            border-radius: 24px;
            box-shadow: var(--shadow-glass);
            margin-bottom: 20px;
        }
        
        .config-group { margin-top: 18px; text-align: left; }
        .config-group label { font-size: 0.8rem; font-weight: 700; color: var(--text-dark); display: block; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
        
        .select-wrapper { position: relative; display: flex; align-items: center; }
        .select-wrapper i { position: absolute; left: 16px; color: var(--brand); font-size: 1rem; pointer-events: none; }
        
        .select-field { 
            width: 100%; 
            padding: 15px 15px 15px 46px; 
            border-radius: 16px; 
            border: 1px solid var(--glass-border); 
            background: var(--glass-input); 
            font-weight: 600; 
            font-size: 0.92rem; 
            color: var(--text-dark); 
            -webkit-appearance: none; 
            appearance: none; 
            cursor: pointer; 
        }
        .select-field:focus { border-color: var(--brand); background: #ffffff; }
        .select-wrapper::after { content: '\f078'; font-family: 'Font Awesome 5 Free'; font-weight: 900; position: absolute; right: 18px; color: var(--text-sub); font-size: 0.75rem; pointer-events: none; }
        
        .upload-box { 
            border: 2px dashed #cbd5e1; 
            border-radius: 24px; 
            padding: 40px 20px; 
            text-align: center; 
            cursor: pointer; 
            background: rgba(248, 250, 252, 0.5); 
            position: relative; 
            overflow: hidden; 
        }
        .upload-box:hover { border-color: var(--brand); background: var(--brand-light); }
        .upload-box i { font-size: 2.5rem; color: var(--brand); margin-bottom: 14px; }
        .upload-box h3 { margin: 0 0 4px; font-weight: 800; font-size: 1.1rem; }
        .file-input { display: none; }
        
        .text-input-field {
            width: 100%;
            padding: 15px 16px;
            border-radius: 16px;
            border: 1px solid var(--border);
            background: #ffffff;
            font-size: 0.92rem;
            font-weight: 600;
            color: var(--text-dark);
            margin-top: 8px;
        }
        .text-input-field:focus { border-color: var(--brand); box-shadow: 0 0 0 4px var(--brand-light); }

        .cta-btn { 
            background: var(--brand-gradient); 
            color: white; 
            border: none; 
            width: 100%; 
            padding: 16px; 
            border-radius: 18px; 
            font-weight: 800; 
            font-size: 0.95rem; 
            margin-top: 24px; 
            cursor: pointer; 
            box-shadow: 0 8px 24px rgba(37, 99, 235, 0.2); 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            gap: 10px; 
        }
        .cta-btn:active { transform: scale(0.98); }
        
        .loading-screen { display: none; text-align: center; padding: 60px 20px; flex: 1; }
        .spinner { width: 48px; height: 48px; border: 4px solid var(--border); border-top-color: var(--brand); border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 24px; }
        @keyframes spin { to { transform: rotate(360deg); } }

        .quiz-arena { display: none; }
        .sticky-timer { 
            position: sticky; 
            top: 70px; 
            background: rgba(255, 255, 255, 0.8); 
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 12px 14px; 
            border: 1px solid var(--glass-border); 
            border-radius: 16px;
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            font-weight: 800; 
            z-index: 90; 
            margin-bottom: 24px; 
            box-shadow: var(--shadow-glass);
        }
        .timer-badge { background: #fee2e2; color: var(--danger); padding: 6px 14px; border-radius: 12px; display: flex; align-items: center; gap: 6px; font-size: 0.9rem; }
        
        .question-card { border: 1px solid var(--glass-border); border-radius: 24px; padding: 24px; margin-bottom: 20px; background: var(--glass-surface); box-shadow: var(--shadow-glass); }
        .option-label { display: flex; align-items: center; padding: 15px; border: 1px solid var(--border); border-radius: 16px; margin-top: 12px; cursor: pointer; font-weight: 600; font-size: 0.9rem; background: #ffffff; }
        .option-label input { margin-right: 12px; transform: scale(1.15); accent-color: var(--brand); }
        .option-label:has(input:checked) { border-color: var(--brand); background: var(--brand-light); color: var(--brand); }
        
        .type-badge { display: inline-block; padding: 4px 10px; border-radius: 8px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; margin-bottom: 10px; letter-spacing: 0.5px; }
        .badge-obj { background: #e0f2fe; color: #0369a1; }
        .badge-gap { background: #fef3c7; color: #b45309; }
        .badge-theory { background: #f3e8ff; color: #6b21a8; }

        .result-view { display: none; text-align: center; padding: 10px 0; }
        .score-radial { width: 140px; height: 140px; border-radius: 50%; background: #f0fdf4; border: 8px solid var(--success); display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 0 auto 24px; box-shadow: 0 10px 25px rgba(16, 185, 129, 0.1); }
        .score-radial.failed { background: #fef2f2; border-color: var(--danger); box-shadow: 0 10px 25px rgba(239, 68, 68, 0.1); }
        
        .explanation-panel { display: none; margin-top: 16px; padding: 16px; background: var(--brand-light); border-left: 4px solid var(--brand); border-radius: 0 16px 16px 0; font-size: 0.85rem; line-height: 1.5; text-align: left; font-weight: 500; }
        .correct-mark { border-color: var(--success) !important; background: #f0fdf4 !important; color: #15803d; font-weight: 700; }
        .wrong-mark { border-color: var(--danger) !important; background: #fef2f2 !important; color: #b91c1c; font-weight: 700; }
        
        .eval-score-sub { font-size: 0.8rem; font-weight: 700; display: inline-block; margin-top: 5px; padding: 2px 8px; border-radius: 6px; }

        .bottom-nav { position: fixed; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 430px; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-top: 1px solid var(--glass-border); display: flex; justify-content: space-around; padding: 14px 0; z-index: 1000; box-shadow: 0 -4px 20px rgba(0,0,0,0.02); }
        .nav-item { display: flex; flex-direction: column; align-items: center; text-decoration: none; color: var(--text-sub); font-size: 0.65rem; font-weight: 700; gap: 5px; width: 60px; text-transform: uppercase; letter-spacing: 0.5px; }
        .nav-item i { font-size: 1.2rem; }
        .nav-item.active { color: var(--brand); }
    </style>
</head>
<body>

    <div class="app-shell">
        <div class="header" id="appHeader">
            <div class="header-left">
                <a href="/dashboard" class="back-btn"><i class="fas fa-chevron-left"></i></a>
                <h1 id="engineHeaderTitle">AI CBT Generator</h1>
            </div>
            <a href="/history" class="history-shortcut" title="View Test History">
                <i class="fas fa-history"></i>
            </a>
        </div>

        <!-- CONFIGURATION SETUP STATE -->
        <div id="uploadState" class="card">
            <form id="pdfUploadForm">
                <div class="upload-box" onclick="document.getElementById('fileField').click()">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <h3>Select Lecture Note PDF</h3>
                    <p style="color: var(--text-sub); font-size: 0.8rem; margin: 4px 0 0;">Max file size limit 10MB</p>
                    <input type="file" id="fileField" name="lecture_note" class="file-input" accept=".pdf" required onchange="updateFileLabel(this)">
                    <b id="fileNameDisplay" style="color: var(--brand); display:block; margin-top:15px; font-size:0.85rem; word-break: break-all;"></b>
                </div>

                <div class="config-group">
                    <label>Question Formats Structure</label>
                    <div class="select-wrapper">
                        <i class="fas fa-sliders-h"></i>
                        <select name="question_type" id="question_type" class="select-field">
                            <option value="obj" selected>Objective (Multiple Choice - MCQs)</option>
                            <option value="german">German (Fill In The Gaps)</option>
                            <option value="theory">Theory (Comprehensive Open-Ended)</option>
                            <option value="mixed">Mixed Assessment (Obj + Gaps + Theory)</option>
                        </select>
                    </div>
                </div>

                <div class="config-group">
                    <label>Target Question Count</label>
                    <div class="select-wrapper">
                        <i class="fas fa-list-ol"></i>
                        <select name="num_questions" id="num_questions" class="select-field">
                            <option value="5" selected>5 High-Yield Questions</option>
                            <option value="10">10 Detailed Questions</option>
                            <option value="15">15 Comprehensive Questions</option>
                            <option value="20">20 Mock Exam Sheet Questions</option>
                        </select>
                    </div>
                </div>

                <div class="config-group">
                    <label>Countdown Session Timer</label>
                    <div class="select-wrapper">
                        <i class="fas fa-stopwatch"></i>
                        <select name="quiz_duration" id="quiz_duration" class="select-field">
                            <option value="3">3 Minutes Sprint</option>
                            <option value="5" selected>5 Minutes Standard Match</option>
                            <option value="10">10 Minutes Relaxed Session</option>
                            <option value="15">15 Minutes Extended Exam</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="cta-btn">
                    <span>Initialize AI Quiz Loop</span>
                    <i class="fas fa-bolt"></i>
                </button>
            </form>
        </div>

        <!-- LOADING FRAMEWORK STATE -->
        <div id="loadingState" class="loading-screen">
            <div class="spinner"></div>
            <h3 style="font-weight:800;">Structuring AI Test Framework...</h3>
            <p style="color: var(--text-sub); font-size: 0.85rem; line-height: 1.5; max-width:300px; margin:0 auto;">Gemini Engine is running deep structural extraction to parse equations and content from your file.</p>
        </div>

        <!-- LIVE QUIZ ARENA STATE -->
        <div id="quizArenaState" class="quiz-arena">
            <div class="sticky-timer">
                <span id="liveCbtLabelTitle" style="font-size:0.85rem; font-weight:800; max-width:200px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">Dynamic CBT Framework</span>
                <span class="timer-badge"><i class="far fa-clock"></i> <span id="clock">05:00</span></span>
            </div>
            
            <div id="questionsContainer"></div>
            <button id="submitQuizBtn" class="cta-btn" style="background: var(--text-dark); box-shadow: none;">Submit Final Answers</button>
        </div>

        <!-- PERFORMANCE RESULTS SHEET STATE -->
        <div id="resultState" class="result-view">
            <div id="radialScoreWrapper" class="score-radial">
                <h2 id="finalScoreRatio" style="margin:0; font-size:2rem; font-weight:800; color:inherit; letter-spacing:-1px;">0/5</h2>
                <span id="scorePercentValue" style="font-size:0.75rem; font-weight:700; opacity:0.8; text-transform:uppercase;">0% Score</span>
            </div>
            <h2 id="feedbackVerdictMsg" style="margin:0 0 5px; font-weight:800; font-size:1.4rem;">Session Completed!</h2>
            <p id="historySyncFeedback" style="color:var(--text-sub); font-size:0.85rem; margin:0 0 25px; font-weight:600;"><i class="fas fa-cloud-upload-alt"></i> Synced to study history...</p>
            
            <hr style="border:none; border-top:1px solid var(--border); margin-bottom:25px;">
            <h3 style="text-align:left; font-weight:800; margin-bottom:15px; font-size:1.1rem;"><i class="fas fa-clipboard-check"></i> Script Evaluation</h3>
            
            <div id="gradedReviewScriptsContainer"></div>
            <button onclick="window.location.reload()" class="cta-btn">Process Another File</button>
        </div>

        <!-- STATIC FOOTER NAV BAR -->
        <nav class="bottom-nav">
            <a href="/dashboard" class="nav-item">
                <i class="fas fa-th-large"></i>
                <span>Home</span>
            </a>
            <a href="/ai-quiz" class="nav-item active">
                <i class="fas fa-robot"></i>
                <span>AI Quiz</span>
            </a>
            <a href="/history" class="nav-item">
                <i class="fas fa-history"></i>
                <span>History</span>
            </a>
            <a href="/profile" class="nav-item">
                <i class="fas fa-user"></i>
                <span>Profile</span>
            </a>
        </nav>
    </div>

    <script>
        let timerCountdown = null;
        let quizQuestionsPayload = [];
        let trackedQuizTitle = "AI-Test";

        window.addEventListener('scroll', () => {
            const header = document.getElementById('appHeader');
            if (window.scrollY > 10) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        });

        function updateFileLabel(input) {
            if(input.files.length > 0) {
                document.getElementById('fileNameDisplay').innerHTML = `<i class="fas fa-check-circle"></i> ${input.files[0].name}`;
            }
        }

        document.getElementById('pdfUploadForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            document.getElementById('uploadState').style.display = 'none';
            document.getElementById('loadingState').style.display = 'block';
            document.getElementById('engineHeaderTitle').innerText = 'Generating Test';

            const formData = new FormData(e.target);

            try {
                const response = await fetch('/generate-ai-quiz', { 
                    method: 'POST', 
                    body: formData 
                });
                const data = await response.json();

                if (data.success) {
                    quizQuestionsPayload = data.questions;
                    trackedQuizTitle = data.quizTitle;
                    startQuizArena(data.questions, data.durationSeconds);
                } else {
                    alert(data.message || "Failed to parse document files accurately.");
                    resetUiToUpload();
                }
            } catch (err) {
                alert("Network communication failure window timeout.");
                resetUiToUpload();
            }
        });

        function resetUiToUpload() {
            document.getElementById('loadingState').style.display = 'none';
            document.getElementById('uploadState').style.display = 'block';
            document.getElementById('engineHeaderTitle').innerText = 'AI CBT Generator';
        }

        function startQuizArena(questions, totalSeconds) {
            document.getElementById('loadingState').style.display = 'none';
            document.getElementById('quizArenaState').style.display = 'block';
            document.getElementById('engineHeaderTitle').innerText = 'Live CBT Session';
            document.getElementById('liveCbtLabelTitle').innerText = trackedQuizTitle;

            const container = document.getElementById('questionsContainer');
            container.innerHTML = '';

            questions.forEach((q, qIndex) => {
                const card = document.createElement('div');
                card.className = 'question-card';
                
                let typeBadge = `<span class="type-badge badge-obj">Objective</span>`;
                if(q.type === 'german') typeBadge = `<span class="type-badge badge-gap">Fill in the Gap</span>`;
                if(q.type === 'theory') typeBadge = `<span class="type-badge badge-theory">Theory</span>`;

                let interactionMarkup = '';
                if(q.type === 'german') {
                    interactionMarkup = `
                        <input type="text" id="answer_${qIndex}" name="answer_${qIndex}" placeholder="Type exact missing words..." class="text-input-field">
                    `;
                } else if(q.type === 'theory') {
                    interactionMarkup = `
                        <textarea id="answer_${qIndex}" name="answer_${qIndex}" rows="4" placeholder="Provide a detailed solution response explanation..." class="text-input-field" style="resize:none; height:100px;"></textarea>
                    `;
                } else {
                    interactionMarkup = `
                        <div id="optionsGroup_${qIndex}">
                            ${q.options.map(opt => `
                                <label class="option-label">
                                    <input type="radio" name="answer_${qIndex}" value="${opt.replace(/"/g, '&quot;')}">
                                    <span>${opt}</span>
                                </label>
                            `).join('')}
                        </div>
                    `;
                }

                card.innerHTML = `
                    ${typeBadge}
                    <p style="font-weight:700; margin:0 0 15px 0; font-size:0.95rem; line-height:1.5;"><b>Q${qIndex + 1}:</b> ${q.question}</p>
                    ${interactionMarkup}
                `;
                container.appendChild(card);
            });

            // Trigger MathJax typesetting for scientific notation rendering
            if (window.MathJax && typeof window.MathJax.typesetPromise === "function") {
                window.MathJax.typesetPromise([container]);
            }

            let duration = totalSeconds;
            let initialM = Math.floor(duration / 60);
            let initialS = duration % 60;
            document.getElementById('clock').innerText = `${initialM}:${initialS < 10 ? '0' : ''}${initialS}`;

            timerCountdown = setInterval(() => {
                duration--;
                let m = Math.floor(duration / 60);
                let s = duration % 60;
                document.getElementById('clock').innerText = `${m}:${s < 10 ? '0' : ''}${s}`;

                if(duration <= 0) {
                    clearInterval(timerCountdown);
                    evaluateAndDisplayQuizResults();
                }
            }, 1000);

            document.getElementById('submitQuizBtn').onclick = () => {
                if(confirm("Submit your answers? Your performance metrics will sync into history records.")) {
                    clearInterval(timerCountdown);
                    evaluateAndDisplayQuizResults();
                }
            };
        }

        function calculateKeywordOverlapMatch(submitted, targetKeywords) {
            if(!submitted || !targetKeywords || targetKeywords.length === 0) return 0;
            const text = submitted.toLowerCase();
            let matches = 0;
            targetKeywords.forEach(kw => {
                if(text.includes(kw.toLowerCase())) matches++;
            });
            return (matches / targetKeywords.length);
        }

        async function evaluateAndDisplayQuizResults() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
            
            document.getElementById('quizArenaState').style.display = 'none';
            document.getElementById('engineHeaderTitle').innerText = 'Performance Sheet';
            document.getElementById('resultState').style.display = 'block';

            let achievedTotalScorePoints = 0;
            const maxCalculatedPointsPossible = quizQuestionsPayload.length;
            const reviewContainer = document.getElementById('gradedReviewScriptsContainer');
            reviewContainer.innerHTML = '';

            quizQuestionsPayload.forEach((q, qIndex) => {
                let userInputValue = '';
                let itemEarnedScore = 0;
                let evaluationFeedbackTemplate = '';

                if (q.type === 'german') {
                    const txtBox = document.getElementById(`answer_${qIndex}`);
                    userInputValue = txtBox ? txtBox.value.trim() : '';
                    
                    const normalizedUser = userInputValue.toLowerCase().replace(/[.,\/#!$%\^&\*;:{}=\-_`~()]/g,"");
                    const normalizedCorrect = q.correct.toLowerCase().replace(/[.,\/#!$%\^&\*;:{}=\-_`~()]/g,"");
                    
                    if(normalizedUser === normalizedCorrect && normalizedUser !== '') {
                        itemEarnedScore = 1;
                        achievedTotalScorePoints += 1;
                    }

                    evaluationFeedbackTemplate = `
                        <div style="margin-top:12px; font-size:0.9rem; font-weight:600;">
                            <div class="option-label ${itemEarnedScore === 1 ? 'correct-mark' : 'wrong-mark'}" style="cursor:default;">
                                <span><b>Your Answer:</b> ${userInputValue || '[Left Blank]'}</span>
                            </div>
                            ${itemEarnedScore === 0 ? `
                            <div class="option-label correct-mark" style="cursor:default; margin-top:8px;">
                                <span><b>Expected Value:</b> ${q.correct}</span>
                            </div>` : ''}
                        </div>
                    `;

                } else if (q.type === 'theory') {
                    const txtArea = document.getElementById(`answer_${qIndex}`);
                    userInputValue = txtArea ? txtArea.value.trim() : '';
                    
                    let matchRatio = calculateKeywordOverlapMatch(userInputValue, q.keywords || []);
                    if(userInputValue.length < 5) matchRatio = 0; 
                    
                    itemEarnedScore = matchRatio; 
                    achievedTotalScorePoints += matchRatio;

                    let ratingLabel = 'Poor matching details';
                    let labelColor = 'background:#fee2e2; color:var(--danger);';
                    if(matchRatio >= 0.75) { ratingLabel = 'Excellent Definition Match'; labelColor = 'background:#dcfce7; color:var(--success);'; }
                    else if(matchRatio >= 0.4) { ratingLabel = 'Partial credit match'; labelColor = 'background:#fef3c7; color:#d97706;'; }

                    evaluationFeedbackTemplate = `
                        <div style="margin-top:12px; font-size:0.9rem;">
                            <div style="padding:15px; border:1px solid var(--border); border-radius:16px; background:#f8fafc; font-weight:500;">
                                <b>Your Submission:</b> <p style="margin:5px 0 0; color:var(--text-dark); font-style:italic;">"${userInputValue || '[No contents entered]'}"</p>
                            </div>
                            <span class="eval-score-sub" style="${labelColor}">${ratingLabel} (${Math.round(matchRatio * 100)}%)</span>
                            
                            <div class="option-label correct-mark" style="cursor:default; margin-top:12px;">
                                <span><b>Core Benchmark Solution Guidelines:</b> ${q.correct}</span>
                            </div>
                        </div>
                    `;

                } else {
                    const checkedRadio = document.querySelector(`input[name="answer_${qIndex}"]:checked`);
                    userInputValue = checkedRadio ? checkedRadio.value : null;
                    
                    if (userInputValue === q.correct) {
                        itemEarnedScore = 1;
                        achievedTotalScorePoints += 1;
                    }

                    evaluationFeedbackTemplate = `
                        <div style="margin-top:12px;">
                            ${q.options.map(opt => {
                                let labelClass = 'option-label';
                                if (opt === q.correct) labelClass = 'option-label correct-mark';
                                else if (userInputValue === opt && userInputValue !== q.correct) labelClass = 'option-label wrong-mark';
                                
                                return `
                                    <div class="${labelClass}" style="cursor:default; margin-top:8px;">
                                        <input type="radio" disabled ${userInputValue === opt ? 'checked' : ''}>
                                        <span>${opt}</span>
                                    </div>
                                `;
                            }).join('')}
                        </div>
                    `;
                }

                const reviewCard = document.createElement('div');
                reviewCard.className = 'question-card';
                reviewCard.style.textAlign = 'left';
                
                let cardTypeBadge = `<span class="type-badge badge-obj">Objective</span>`;
                if(q.type === 'german') cardTypeBadge = `<span class="type-badge badge-gap">Fill in the Gap</span>`;
                if(q.type === 'theory') cardTypeBadge = `<span class="type-badge badge-theory">Theory</span>`;

                reviewCard.innerHTML = `
                    ${cardTypeBadge}
                    <p style="font-weight:700; margin:0 0 15px 0; font-size:0.95rem; line-height:1.5;"><b>Q${qIndex + 1}:</b> ${q.question}</p>
                    ${evaluationFeedbackTemplate}
                    <div class="explanation-panel" style="display:block;">
                        <b style="color:var(--brand); display:block; margin-bottom:4px;"><i class="fas fa-info-circle"></i> Rationale:</b>
                        <span>${q.explanation}</span>
                    </div>
                `;
                reviewContainer.appendChild(reviewCard);
            });

            const computedFinalDisplayScore = parseFloat(achievedTotalScorePoints.toFixed(1));
            const scorePercentage = Math.round((achievedTotalScorePoints / maxCalculatedPointsPossible) * 100);
            
            document.getElementById('finalScoreRatio').innerText = `${computedFinalDisplayScore}/${maxCalculatedPointsPossible}`;
            document.getElementById('scorePercentValue').innerText = `${scorePercentage}% Score`;

            const radial = document.getElementById('radialScoreWrapper');
            if(scorePercentage < 45) {
                radial.className = 'score-radial failed';
                radial.style.color = 'var(--danger)';
                document.getElementById('feedbackVerdictMsg').innerText = "Keep Practicing! 📚";
            } else {
                radial.className = 'score-radial';
                radial.style.color = 'var(--success)';
                document.getElementById('feedbackVerdictMsg').innerText = "Excellent Work! 🎉";
            }

            // Cleanly render new LaTeX strings generated within results explanations or answers
            if (window.MathJax && typeof window.MathJax.typesetPromise === "function") {
                window.MathJax.typesetPromise([reviewContainer]);
            }

            try {
                const response = await fetch('/save-ai-quiz-results', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        quizTitle: trackedQuizTitle,
                        totalQuestions: maxCalculatedPointsPossible,
                        correctAnswers: computedFinalDisplayScore,
                        scorePercentage: scorePercentage
                    })
                });
                const syncData = await response.json();
                if(syncData.success) {
                    document.getElementById('historySyncFeedback').innerHTML = `<span style="color:var(--success)"><i class="fas fa-check-circle"></i> Performance history updated successfully!</span>`;
                } else {
                    throw new Error();
                }
            } catch (err) {
                document.getElementById('historySyncFeedback').innerHTML = `<span style="color:var(--danger)"><i class="fas fa-exclamation-triangle"></i> Local-only session. Profile sync offline.</span>`;
            }
        }
    </script>
</body>
</html>