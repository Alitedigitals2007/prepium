<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif; background: #0b1437; color: #e2e8f0; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px 16px 60px; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
        .orb1, .orb2 { position: fixed; border-radius: 50%; filter: blur(80px); z-index: 0; }
        .orb1 { width: 420px; height: 420px; background: #6366f1; top: -140px; left: -120px; opacity: 0.35; }
        .orb2 { width: 380px; height: 380px; background: #22d3ee; bottom: -160px; right: -120px; opacity: 0.25; }

        #confetti { position: fixed; inset: 0; pointer-events: none; z-index: 5; }

        .thanks { position: relative; z-index: 2; width: 100%; max-width: 480px; text-align: center; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); backdrop-filter: blur(16px); border-radius: 26px; padding: 40px 26px; box-shadow: 0 24px 70px rgba(0,0,0,0.4); animation: popIn 0.6s cubic-bezier(0.2,1.4,0.4,1) both; }
        @keyframes popIn { 0% { opacity: 0; transform: scale(0.7); } 100% { opacity: 1; transform: scale(1); } }

        .check-ring { width: 84px; height: 84px; margin: 0 auto 18px; border-radius: 50%; background: linear-gradient(135deg,#22c55e,#10b981); display: flex; align-items: center; justify-content: center; font-size: 2rem; color: #fff; box-shadow: 0 0 0 10px rgba(34,197,94,0.15), 0 14px 40px rgba(34,197,94,0.4); animation: ringPulse 1.6s ease infinite; }
        @keyframes ringPulse { 0%,100% { box-shadow: 0 0 0 10px rgba(34,197,94,0.12), 0 14px 40px rgba(34,197,94,0.4); } 50% { box-shadow: 0 0 0 20px rgba(34,197,94,0.05), 0 14px 40px rgba(34,197,94,0.4); } }

        .thanks h1 { font-size: 1.5rem; font-weight: 800; color: #fff; }
        .thanks .sub { margin-top: 6px; font-size: 0.86rem; color: rgba(226,232,240,0.7); line-height: 1.5; }

        .promo { margin-top: 26px; padding: 20px 18px; border-radius: 18px; background: linear-gradient(135deg,#6366f1,#8b5cf6); position: relative; overflow: hidden; text-align: left; box-shadow: 0 12px 34px rgba(99,102,241,0.35); }
        .promo::after { content: ''; position: absolute; top: -40%; right: -20%; width: 200px; height: 200px; border-radius: 50%; background: rgba(255,255,255,0.12); }
        .promo .p-brand { display: flex; align-items: center; gap: 8px; font-size: 0.75rem; font-weight: 800; letter-spacing: 3px; color: rgba(255,255,255,0.9); }
        .promo .p-brand .p-logo { width: 26px; height: 26px; border-radius: 8px; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 0.9rem; }
        .promo .p-title { margin-top: 10px; font-size: 1.05rem; font-weight: 800; color: #fff; line-height: 1.3; }
        .promo .p-text { margin-top: 4px; font-size: 0.78rem; color: rgba(255,255,255,0.85); line-height: 1.5; }
        .btn-register { display: block; width: 100%; margin-top: 14px; padding: 13px; border: none; border-radius: 12px; background: #fff; color: #4338ca; font-family: inherit; font-size: 0.88rem; font-weight: 800; cursor: pointer; text-decoration: none; text-align: center; box-shadow: 0 6px 18px rgba(0,0,0,0.15); }

        .foot { margin-top: 20px; font-size: 0.66rem; color: rgba(226,232,240,0.4); font-weight: 600; }
    </style>
</head>
<body>
    <div class="orb1"></div><div class="orb2"></div>
    <canvas id="confetti"></canvas>

    <div class="thanks">
        <div class="check-ring"><i class="fas fa-check"></i></div>
        <h1>Thank you!</h1>
        <div class="sub">Your score for <strong><%= form.title %></strong> has been recorded successfully.</div>

        <div class="promo">
            <div class="p-brand"><div class="p-logo">P</div> PREPIUM</div>
            <div class="p-title">Level up your studies with Prepium</div>
            <div class="p-text">AI tutors, timed mock exams, CGPA tracker, squad streaks and more — built for students who want better results.</div>
            <a class="btn-register" href="/signup">Register for Prepium now</a>
        </div>
    </div>

    <div class="foot">Powered by Prepium</div>

    <script>
        (function () {
            if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            var c = document.getElementById('confetti');
            var ctx = c.getContext('2d');
            var W, H;
            function resize() { W = c.width = window.innerWidth; H = c.height = window.innerHeight; }
            resize(); window.addEventListener('resize', resize);
            var colors = ['#6366f1', '#22d3ee', '#f59e0b', '#f43f5e', '#22c55e', '#a855f7'];
            var bits = [];
            for (var i = 0; i < 130; i++) {
                bits.push({
                    x: Math.random() * W, y: -20 - Math.random() * H * 0.5,
                    w: 6 + Math.random() * 6, h: 8 + Math.random() * 8,
                    vx: (Math.random() - 0.5) * 1.6, vy: 1.5 + Math.random() * 3,
                    rot: Math.random() * Math.PI, vr: (Math.random() - 0.5) * 0.2,
                    color: colors[Math.floor(Math.random() * colors.length)]
                });
            }
            var t = 0;
            function loop() {
                t++;
                ctx.clearRect(0, 0, W, H);
                bits.forEach(function (b) {
                    b.x += b.vx + Math.sin((t + b.rot * 50) * 0.02) * 0.6;
                    b.y += b.vy;
                    b.rot += b.vr;
                    if (b.y > H + 30) { b.y = -20; b.x = Math.random() * W; }
                    ctx.save();
                    ctx.translate(b.x, b.y);
                    ctx.rotate(b.rot);
                    ctx.fillStyle = b.color;
                    ctx.fillRect(-b.w / 2, -b.h / 2, b.w, b.h);
                    ctx.restore();
                });
                if (t < 240) requestAnimationFrame(loop);
                else { ctx.clearRect(0, 0, W, H); }
            }
            loop();
        })();
    </script>
</body>
</html>