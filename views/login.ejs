<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Login | Prepium</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root { 
            --brand: #0062ff; 
            --bg: #f8fafc; 
            --text: #0f172a; 
            --sub: #64748b;
        }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: var(--bg); 
            margin: 0; 
            display: flex; 
            justify-content: center; 
            color: var(--text);
            min-height: 100vh;
            overflow: hidden; 
        }

        .intro-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: white; display: flex; justify-content: center;
            align-items: center; z-index: 2000;
            animation: fadeOutScreen 0.6s ease-in-out 1.6s forwards;
        }

        .intro-text {
            font-size: 1.65rem; font-weight: 800; color: var(--text);
            text-align: center; opacity: 0; transform: translateY(20px);
            animation: fadeInUpText 0.6s ease-out 0.2s forwards;
        }
        .intro-text span { color: var(--brand); }

        .auth-shell {
            width: 100%; max-width: 430px; background: white; 
            min-height: 100vh; display: flex; flex-direction: column; 
            padding: 2.5rem 2rem; box-shadow: 0 0 60px rgba(0,0,0,0.03);
            position: relative; opacity: 0; transform: translateY(25px);
            animation: displayForm 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1.8s forwards;
        }

        .logo-small { color: var(--brand); font-weight: 800; font-size: 1.35rem; margin-bottom: 2.5rem; display: inline-block; text-decoration: none; }
        .logo-small span { color: var(--text); }
        .header { margin-bottom: 2rem; }
        h1 { font-size: 1.65rem; font-weight: 800; margin: 0; color: var(--text); }
        p { color: var(--sub); font-size: 0.88rem; margin-top: 6px; font-weight: 600; }

        .form-group { margin-bottom: 1.25rem; }
        label { display: block; font-size: 0.72rem; font-weight: 800; margin-bottom: 8px; color: var(--text); text-transform: uppercase; }
        
        .input-wrapper { position: relative; display: flex; align-items: center; }
        input {
            width: 100%; padding: 1.1rem 1.2rem; border-radius: 16px; 
            border: 1px solid #e2e8f0; background: #f8fafc; 
            font-size: 0.92rem; font-weight: 600; color: var(--text); outline: none; 
            transition: all 0.3s ease;
        }
        input:focus { border-color: var(--brand); background: white; box-shadow: 0 0 0 4px rgba(0, 98, 255, 0.08); }

        /* Password Toggle Button Styling */
        .toggle-btn {
            position: absolute; right: 12px; background: #eff6ff; 
            border: none; color: var(--brand); font-size: 0.65rem; 
            font-weight: 800; padding: 6px 10px; border-radius: 8px; 
            cursor: pointer; transition: 0.2s;
        }
        .toggle-btn:hover { background: #dbeafe; }

        .btn-primary {
            background: var(--brand); color: white; border: none; width: 100%;
            padding: 1.15rem; border-radius: 18px; font-size: 0.95rem; font-weight: 800;
            cursor: pointer; margin-top: 1rem; box-shadow: 0 8px 24px rgba(0, 98, 255, 0.18);
            display: flex; justify-content: center; align-items: center; gap: 10px;
        }
        .btn-primary:disabled { background: #94a3b8; cursor: not-allowed; transform: none; }

        .spinner { display: none; width: 18px; height: 18px; border: 3px solid rgba(255, 255, 255, 0.3); border-radius: 50%; border-top-color: white; animation: spin 0.8s linear infinite; }

        @keyframes fadeInUpText { to { opacity: 1; transform: translateY(0); } }
        @keyframes fadeOutScreen { to { opacity: 0; visibility: hidden; } }
        @keyframes displayForm { to { opacity: 1; transform: translateY(0); } }
        @keyframes spin { to { transform: rotate(360deg); } }

        .footer { text-align: center; margin-top: auto; padding-top: 2.5rem; font-size: 0.88rem; color: var(--sub); font-weight: 600; }
        .footer a { color: var(--brand); text-decoration: none; font-weight: 800; }
    </style>
</head>
<body>

    <div class="intro-overlay" id="introOverlay">
        <h2 class="intro-text">Welcome back, <span>Scholar.</span></h2>
    </div>

    <div class="auth-shell">
        <a href="/" class="logo-small">PREPIUM<span>.</span></a>
        
        <div class="header">
            <h1>Welcome back!</h1>
            <p>Sign in to continue practicing and learning.</p>
        </div>

        <form id="loginForm">
            <div class="form-group">
                <label>Email Address</label>
                <div class="input-wrapper">
                    <input type="email" id="email" name="email" placeholder="e.g., scholar@prepium.com" required autocomplete="email">
                </div>
            </div>
            <div class="form-group">
                <label>Password</label>
                <div class="input-wrapper">
                    <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
                    <button type="button" class="toggle-btn" id="togglePassword">SHOW</button>
                </div>
            </div>
            <button type="submit" class="btn-primary" id="submitBtn">
                <span id="btnText">Sign In ➔</span>
                <span class="spinner" id="btnSpinner"></span>
            </button>
        </form>

        <div class="footer">
            Don't have an account? <a href="/signup">Sign up</a>
        </div>
    </div>

    <script>
        const loginForm = document.getElementById('loginForm');
        const submitBtn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const btnSpinner = document.getElementById('btnSpinner');
        const passwordInput = document.getElementById('password');
        const toggleBtn = document.getElementById('togglePassword');

        // 1. Password Toggle Logic
        toggleBtn.addEventListener('click', () => {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            toggleBtn.textContent = type === 'password' ? 'SHOW' : 'HIDE';
        });

        // 2. Intro cleanup
        setTimeout(() => {
            const overlay = document.getElementById('introOverlay');
            if (overlay) overlay.remove();
            document.body.style.overflow = "auto";
        }, 2400);

        // 3. Initialize Toast
        const Toast = Swal.mixin({
            toast: true, position: 'top-end', showConfirmButton: false, timer: 3000, timerProgressBar: true
        });

        // 4. AJAX Login Flow
        loginForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            // UI State: Loading
            submitBtn.disabled = true;
            btnText.textContent = "Verifying...";
            btnSpinner.style.display = "inline-block";

            const formData = {
                email: document.getElementById('email').value,
                password: passwordInput.value
            };

            try {
                const response = await fetch('/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    window.location.href = result.redirect;
                } else {
                    throw new Error(result.message || 'Invalid Login Details');
                }
            } catch (err) {
                // Show Error Toast without refresh
                Toast.fire({ icon: 'error', title: err.message });
                
                // Reset UI
                submitBtn.disabled = false;
                btnText.textContent = "Sign In ➔";
                btnSpinner.style.display = "none";
            }
        });

        // Initial URL Checks (for signup success etc)
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('success')) {
            Toast.fire({ icon: 'success', title: 'Account created! Please login.' });
        }
    </script>
</body>
</html>