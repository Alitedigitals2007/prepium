<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>Prepium | Study</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .status-bar { height: env(safe-area-inset-top, 0px); }
        .page-header { padding: 1.5rem 1.5rem 0.75rem; display: flex; align-items: center; justify-content: space-between; }
        .page-header h1 { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.5px; }
        .page-header p { font-size: 0.72rem; color: var(--text-sub); font-weight: 600; margin-top: 2px; }
        .import-btn { padding: 8px 14px; border-radius: var(--radius-sm); border: 1.5px solid var(--border); background: white; font-weight: 700; font-size: 0.7rem; cursor: pointer; display: flex; align-items: center; gap: 6px; color: var(--text-dark); transition: var(--transition); }
        .import-btn:hover { border-color: var(--brand); color: var(--brand); }

        .stats-row { display: flex; gap: 10px; padding: 0.5rem 1.5rem 1rem; }
        .stat-chip { flex: 1; background: white; border: 1px solid var(--border); border-radius: var(--radius); padding: 16px 12px; text-align: center; box-shadow: var(--shadow-sm); }
        .stat-chip i { font-size: 1.15rem; color: var(--brand); margin-bottom: 6px; display: block; }
        .stat-chip .num { font-size: 1.3rem; font-weight: 800; line-height: 1.2; }
        .stat-chip .lbl { font-size: 0.6rem; color: var(--text-sub); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }
        .stat-chip.streak-chip i { color: #f97316; }
        .stat-chip.streak-chip .num { color: #f97316; }

        .active-session-card { margin: 0 1.5rem 1rem; background: linear-gradient(135deg,#1e293b,#0f172a); border-radius: var(--radius-lg); padding: 18px 20px; color: white; display: flex; align-items: center; gap: 14px; cursor: pointer; box-shadow: 0 8px 24px rgba(15,23,42,0.3); }
        .active-session-card:active { transform: scale(0.98); }
        .active-session-card .as-icon { width: 46px; height: 46px; border-radius: var(--radius-sm); background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
        .active-session-card .as-info { flex: 1; }
        .active-session-card .as-info h4 { margin: 0 0 2px; font-size: 0.85rem; font-weight: 800; }
        .active-session-card .as-info p { margin: 0; font-size: 0.7rem; opacity: 0.7; font-weight: 600; }
        .active-session-card .as-resume { padding: 8px 16px; border-radius: 20px; border: none; background: #22c55e; color: white; font-weight: 800; font-size: 0.7rem; cursor: pointer; }

        .quick-start { margin: 0 1.5rem 1rem; background: var(--brand-gradient); border-radius: var(--radius-lg); padding: 20px; color: white; position: relative; overflow: hidden; cursor: pointer; }
        .quick-start:active { transform: scale(0.98); }
        .quick-start::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at top right, rgba(255,255,255,0.15) 0%, transparent 60%); }
        .quick-start h3 { margin: 0 0 4px; font-size: 1rem; font-weight: 800; position: relative; }
        .quick-start p { margin: 0 0 12px; font-size: 0.72rem; opacity: 0.85; font-weight: 600; position: relative; }
        .quick-start .qs-btn { padding: 10px 24px; border-radius: 20px; border: none; background: white; color: var(--brand); font-weight: 800; font-size: 0.78rem; cursor: pointer; position: relative; display: inline-flex; align-items: center; gap: 8px; }

        .tab-bar { display: flex; gap: 6px; padding: 0.5rem 1.5rem; }
        .tab-pill { flex: 1; padding: 12px; border-radius: var(--radius-sm); background: #f1f5f9; border: none; cursor: pointer; font-family: inherit; font-weight: 700; font-size: 0.78rem; color: var(--text-sub); transition: var(--transition); display: flex; align-items: center; justify-content: center; gap: 6px; }
        .tab-pill.active { background: var(--text-dark); color: white; }
        .tab-pill i { font-size: 0.85rem; }

        .section-label { padding: 1rem 1.5rem 0.6rem; font-size: 0.62rem; font-weight: 800; color: var(--text-sub); text-transform: uppercase; letter-spacing: 1px; display: flex; justify-content: space-between; align-items: center; }
        .section-label .count { color: var(--text-muted); font-weight: 600; }

        .course-grid { padding: 0 1.5rem; }
        .glass-card { margin-bottom: 12px; cursor: pointer; text-decoration: none; display: block; }
        .glass-card:active { transform: scale(0.98); }
        .card-top { display: flex; align-items: center; gap: 14px; margin-bottom: 10px; }
        .card-icon { width: 46px; height: 46px; background: var(--brand-soft); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; color: var(--brand); font-size: 1.1rem; flex-shrink: 0; }
        .card-info { flex: 1; min-width: 0; }
        .card-info h3 { margin: 0; font-size: 0.92rem; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .card-info .code { font-size: 0.68rem; color: var(--text-sub); font-weight: 600; margin: 2px 0 0; }
        .card-meta { display: flex; gap: 12px; font-size: 0.7rem; color: var(--text-sub); font-weight: 600; }
        .card-meta i { margin-right: 4px; }
        .progress-mini { height: 5px; background: #f1f5f9; border-radius: 3px; overflow: hidden; margin-top: 8px; }
        .progress-fill { height: 100%; border-radius: 3px; transition: width 0.5s var(--ease-out); }

        .empty-state { text-align: center; padding: 3rem 1.5rem; }
        .empty-state i { font-size: 2.5rem; color: #e2e8f0; margin-bottom: 0.8rem; display: block; }
        .empty-state h3 { font-size: 0.9rem; font-weight: 700; color: var(--text-sub); margin: 0 0 4px; }
        .empty-state p { font-size: 0.75rem; color: var(--text-muted); margin: 0; }
        .empty-state .cta { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; padding: 11px 22px; border-radius: var(--radius-sm); background: var(--brand-gradient); color: white; text-decoration: none; font-weight: 700; font-size: 0.82rem; }

        .recent-section { padding: 0 1.5rem 1.5rem; }
        .session-chip { display: flex; align-items: center; gap: 12px; padding: 12px 14px; background: white; border: 1px solid var(--border); border-radius: var(--radius-sm); margin-bottom: 8px; cursor: pointer; text-decoration: none; color: inherit; transition: var(--transition); }
        .session-chip:active { transform: scale(0.98); }
        .session-chip .s-icon { width: 36px; height: 36px; border-radius: 10px; background: var(--brand-soft); display: flex; align-items: center; justify-content: center; color: var(--brand); flex-shrink: 0; }
        .session-chip .s-info { flex: 1; }
        .session-chip .s-info .s-name { font-weight: 700; font-size: 0.8rem; }
        .session-chip .s-info .s-date { font-size: 0.65rem; color: var(--text-sub); font-weight: 500; }
        .session-chip .s-dur { font-size: 0.8rem; font-weight: 800; color: var(--brand); }

        @media (min-width: 431px) { .app-shell { border-left: 1px solid var(--glass-border); border-right: 1px solid var(--glass-border); margin: 0 auto; } }
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="status-bar"></div>
    
    <div class="page-header">
        <div>
            <h1>Study</h1>
            <p>Track your learning progress</p>
        </div>
        <button class="import-btn" onclick="importTimetable()" title="Import from timetable"><i class="fas fa-download"></i> Import</button>
    </div>

    <% 
    let totalSessions = 0, totalMins = 0, totalCourses = 0;
    if (typeof courses !== 'undefined' && courses) { totalCourses = courses.length; }
    if (typeof progress !== 'undefined' && progress) {
        progress.forEach(function(p) { totalSessions += p.total_sessions || 0; totalMins += p.total_minutes || 0; });
    }
    var streak = typeof streak !== 'undefined' ? streak : 0;
    var todaySecs = typeof todayStats !== 'undefined' && todayStats ? todayStats.seconds : 0;
    var todaySessions = typeof todayStats !== 'undefined' && todayStats ? todayStats.sessions : 0;
    %>

    <div class="stats-row">
        <div class="stat-chip">
            <i class="fas fa-book-open"></i>
            <div class="num"><%= totalCourses %></div>
            <div class="lbl">Courses</div>
        </div>
        <div class="stat-chip">
            <i class="fas fa-clock"></i>
            <div class="num"><%= Math.floor(totalMins / 60) %>h <%= totalMins % 60 %>m</div>
            <div class="lbl">Total</div>
        </div>
        <div class="stat-chip streak-chip">
            <i class="fas fa-fire"></i>
            <div class="num"><%= streak %></div>
            <div class="lbl">Day Streak</div>
        </div>
    </div>

    <% if (typeof activeSession !== 'undefined' && activeSession) { %>
    <div class="active-session-card" onclick="resumeSession(<%= activeSession.id %>)">
        <div class="as-icon"><i class="fas fa-play-circle"></i></div>
        <div class="as-info">
            <h4><%= activeSession.course_name %></h4>
            <p>Started <%= new Date(activeSession.created_at).toLocaleString('en-GB', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' }) %></p>
        </div>
        <button class="as-resume"><i class="fas fa-play"></i> Resume</button>
    </div>
    <% } %>

    <div class="quick-start" onclick="quickStart()">
        <h3><i class="fas fa-bolt"></i> Quick Start</h3>
        <p>Pick a course and start studying right away</p>
        <button class="qs-btn"><i class="fas fa-play"></i> Go</button>
    </div>

    <div class="tab-bar">
        <button class="tab-pill active" onclick="switchTab('courses', this)"><i class="fas fa-book"></i> My Courses</button>
        <button class="tab-pill" onclick="switchTab('recent', this)"><i class="fas fa-history"></i> Recent</button>
    </div>

    <div id="tab-courses">
        <div class="section-label">
            <span>Study Courses</span>
            <span class="count"><%= totalCourses %></span>
        </div>
        <div class="course-grid">
            <% if (courses && courses.length > 0) { %>
                <% courses.forEach(function(c) { 
                    var p = null;
                    if (typeof progress !== 'undefined' && progress) {
                        progress.forEach(function(pr) { if (pr.course_name === c.course_name) p = pr; });
                    }
                    var mins = p ? p.total_minutes : 0;
                %>
                    <a href="/study/course/<%= c.id %>" class="glass-card">
                        <div class="card-top">
                            <div class="card-icon"><i class="fas fa-book"></i></div>
                            <div class="card-info">
                                <h3><%= c.course_name %></h3>
                                <div class="code"><%= c.course_code ? c.course_code + ' - ' : '' %><%= c.unit %> credits</div>
                            </div>
                        </div>
                        <div class="card-meta">
                            <span><i class="fas fa-clock"></i> <%= Math.floor(mins / 60) %>h <%= mins % 60 %>m</span>
                            <span><i class="fas fa-check-circle"></i> <%= p ? p.total_sessions : 0 %> sessions</span>
                        </div>
                        <div class="progress-mini">
                            <div class="progress-fill" style="width:<%= Math.min(100, mins / 2) %>%"></div>
                        </div>
                    </a>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-book-open"></i>
                    <h3>No courses yet</h3>
                    <p>Import from your timetable or add courses manually</p>
                    <button class="cta" onclick="importTimetable()"><i class="fas fa-download"></i> Import from Timetable</button>
                </div>
            <% } %>
        </div>
    </div>

    <div id="tab-recent" style="display:none;">
        <div class="section-label">Recent Sessions</div>
        <div class="recent-section">
            <% if (typeof recentSessions !== 'undefined' && recentSessions && recentSessions.length > 0) { %>
                <% recentSessions.forEach(function(s) { %>
                    <a href="/study/session/<%= s.id %>" class="session-chip">
                        <div class="s-icon"><i class="fas fa-clock"></i></div>
                        <div class="s-info">
                            <div class="s-name"><%= s.course_name %></div>
                            <div class="s-date"><%= new Date(s.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %> • <%= s.status %></div>
                        </div>
                        <div class="s-dur"><%= Math.floor((s.elapsed_seconds || 0) / 60) %>m</div>
                    </a>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-history"></i>
                    <h3>No sessions yet</h3>
                    <p>Start a study session to see it here</p>
                </div>
            <% } %>
        </div>
    </div>

    <%- include('partials/bottom-nav', { activeNav: 'study' }) %>
</div>

<script>
function switchTab(tab, btn) {
    document.querySelectorAll('.tab-pill').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-courses').style.display = tab === 'courses' ? 'block' : 'none';
    document.getElementById('tab-recent').style.display = tab === 'recent' ? 'block' : 'none';
}

function importTimetable() {
    Swal.fire({
        title: 'Import Courses',
        text: 'Import courses from your timetable?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Import',
        cancelButtonText: 'Cancel'
    }).then(res => {
        if (res.isConfirmed) {
            Swal.fire({ title: 'Importing...', html: 'Syncing courses from timetable', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
            fetch('/api/study/import-timetable', { method: 'POST' })
            .then(r => r.json()).then(d => {
                if (d.success) {
                    Swal.fire({ icon: 'success', title: d.imported + ' courses imported!', timer: 1500, showConfirmButton: false });
                    setTimeout(() => location.reload(), 1500);
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: d.error });
                }
            });
        }
    });
}

function resumeSession(id) {
    window.location.href = '/study/session/' + id;
}

function quickStart() {
    Swal.fire({
        title: 'Quick Start',
        html:
            '<div style="text-align:left;font-size:0.78rem;color:#475569;font-weight:600;margin-bottom:4px">Pick a course</div>' +
            '<select id="qs-course" style="width:100%;padding:10px;border-radius:10px;border:1.5px solid #cbd5e1;font-family:inherit;font-weight:600;margin-bottom:10px">' +
            '<option value="">Select...</option>' +
            '<% if (courses && courses.length > 0) { courses.forEach(function(c) { %>' +
            '<option value="<%= c.id %>" data-name="<%- c.course_name.replace(/'/g, '&#39;') %>"><%= c.course_name %></option>' +
            '<% }); } %>' +
            '</select>' +
            '<div style="text-align:left;font-size:0.78rem;color:#475569;font-weight:600;margin-bottom:4px">Mode</div>' +
            '<select id="qs-mode" style="width:100%;padding:10px;border-radius:10px;border:1.5px solid #cbd5e1;font-family:inherit;font-weight:600">' +
            '<option value="study" selected>Study Session</option>' +
            '<option value="quiz">Quiz</option>' +
            '<option value="flashcard">Flashcards</option></select>',
        showCancelButton: true,
        confirmButtonText: 'Start',
        preConfirm: function() {
            var sel = document.getElementById('qs-course');
            var cid = sel.value;
            var name = sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex].getAttribute('data-name') || '' : '';
            var mode = document.getElementById('qs-mode').value;
            if (!cid) { Swal.showValidationMessage('Select a course'); return; }
            return { courseId: cid, courseName: name, mode: mode };
        }
    }).then(function(res) {
        if (!res || !res.isConfirmed || !res.value) return;
        var v = res.value;
        if (v.mode === 'quiz') window.location.href = '/study/course/' + v.courseId;
        else if (v.mode === 'flashcard') window.location.href = '/study/flashcards/' + v.courseId;
        else {
            Swal.fire({ title: 'Starting...', html: 'Setting up', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); } });
            fetch('/api/study/sessions/start', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ courseId: parseInt(v.courseId), courseName: v.courseName })
            }).then(function(r){ return r.json(); }).then(function(d) {
                if (d.success && d.redirect) window.location.href = d.redirect;
                else Swal.fire({ icon: 'error', text: d.error || 'Failed to start' });
            });
        }
    });
}
</script>
</body>
</html>
