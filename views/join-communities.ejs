<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Entry Verified | Join Prepium Community</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand: #0062ff;
            --brand-dark: #004ecc;
            --brand-soft: #eef4ff;
            --festive-green: #047857;
            --whatsapp-green: #25d366;
            --whatsapp-dark: #1ebd58;
            --share-orange: #ea580c;
            --share-dark: #c2410c;
            --text-dark: #0a0c10;
            --text-muted: #5f6672;
            --surface: #ffffff;
            --bg-gradient: linear-gradient(135deg, #f4f7fa 0%, #eef4ff 100%);
            --border: #edf2f7;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; outline: none; }

        body {
            background: var(--bg-gradient);
            color: var(--text-dark);
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            display: flex;
            justify-content: center;
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        /* Ambient Background Accents */
        .ambient-particle {
            position: absolute;
            font-size: 1.5rem;
            opacity: 0.12;
            user-select: none;
            pointer-events: none;
            animation: floatAround 12s ease-in-out infinite alternate;
        }
        @keyframes floatAround {
            0% { transform: translateY(0px) rotate(0deg); }
            100% { transform: translateY(-30px) rotate(15deg); }
        }

        .app-container {
            width: 100%;
            max-width: 430px;
            background: var(--surface);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            box-shadow: 0 0 40px rgba(0,0,0,0.03);
            overflow: hidden;
            padding: 1.8rem 1.5rem;
        }

        /* Canvas Overlay for Confetti Burst */
        #successCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 99;
        }

        /* Nav Header Component */
        .nav-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--border);
            margin-bottom: 1.8rem;
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--text-dark);
            font-weight: 800;
            font-size: 1.15rem;
        }

        .nav-logo-box {
            background: var(--brand);
            color: white;
            width: 34px;
            height: 34px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }

        /* Content Headings */
        h1 { font-size: 1.8rem; font-weight: 800; margin: 0 0 0.5rem 0; letter-spacing: -0.5px; line-height: 1.25; }
        p { color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin-top: 0; margin-bottom: 1.5rem; }

        /* Custom Alert Notification Block */
        .alert-info {
            background: #fff7ed;
            border-left: 4px solid var(--share-orange);
            color: var(--share-dark);
            padding: 1.1rem;
            border-radius: 18px;
            font-size: 0.88rem;
            line-height: 1.5;
            text-align: left;
            margin-bottom: 1.25rem;
        }

        /* Visual Flyer Component Container */
        .flyer-display-frame {
            width: 100%;
            border-radius: 22px;
            overflow: hidden;
            border: 1px solid var(--border);
            box-shadow: 0 8px 20px rgba(0,0,0,0.04);
            margin-bottom: 1.5rem;
            background: var(--bg-light);
            position: relative;
        }

        .flyer-image {
            width: 100%;
            height: auto;
            display: block;
        }

        /* Action Pill Buttons UI */
        .action-btn {
            display: block;
            width: 100%;
            padding: 1.1rem;
            margin-bottom: 12px;
            border-radius: 20px;
            font-size: 0.95rem;
            font-weight: 800;
            text-decoration: none;
            text-align: center;
            border: none;
            cursor: pointer;
            transition: transform 0.1s ease, background 0.2s ease;
        }

        .action-btn:active { transform: scale(0.97); }
        
        .btn-whatsapp { background: var(--whatsapp-green); color: white; box-shadow: 0 6px 20px rgba(37, 211, 102, 0.15); }
        .btn-whatsapp:hover { background: var(--whatsapp-dark); }
        
        .btn-community { background: var(--brand); color: white; box-shadow: 0 6px 20px rgba(0, 98, 255, 0.15); }
        .btn-community:hover { background: var(--brand-dark); }
        
        .btn-share { background: var(--share-orange); color: white; box-shadow: 0 6px 20px rgba(234, 88, 12, 0.15); }
        .btn-share:hover { background: var(--share-dark); }

        .divider {
            border: 0;
            border-top: 1px solid var(--border);
            margin: 1.8rem 0;
        }

        /* Styled Action Notification Toast Box */
        .toast-notification {
            position: fixed;
            bottom: -80px;
            left: 50%;
            transform: translateX(-50%);
            background: #0a0c10;
            color: #ffffff;
            padding: 1rem 1.5rem;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 700;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            transition: bottom 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 2000;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .toast-notification.show { bottom: 24px; }
    </style>
</head>
<body>

    <!-- Ambient Playful Background Embellishments -->
    <div class="ambient-particle" style="top: 12%; left: 6%;">🎈</div>
    <div class="ambient-particle" style="top: 30%; right: 8%;">✨</div>
    <div class="ambient-particle" style="bottom: 20%; left: 5%;">🎉</div>

    <!-- Confirmation Toast Indicator -->
    <div class="toast-notification" id="statusToast">
        <span>✅</span> Caption Copied & Flyer Downloaded!
    </div>

    <div class="app-container">
        <!-- Interactive Canvas for Victory Confetti -->
        <canvas id="successCanvas"></canvas>

        <!-- Top Header Component -->
        <nav class="nav-bar">
            <a href="#" class="nav-logo">
                <div class="nav-logo-box">P</div>
                <span>Prepium</span>
            </a>
        </nav>

        <h1>Done, <%= studentName %>! 🎉</h1>
        <p>Your entry is verified. Official winners will be drawn and announced directly inside our secure community groups below.</p>
        
        <div class="divider"></div>

        <!-- Dynamic Contextual Campus Logic Layer -->
        <% if (schoolLink) { %>
            <p>Connect with fellow scholars from your active local hub:</p>
            <a href="<%= schoolLink %>" target="_blank" class="action-btn btn-whatsapp">Join <%= studentSchool %> Group</a>
        <% } else { %>
            <div class="alert-info">
                <strong>Notice:</strong> The dedicated campus group for <strong><%= studentSchool %></strong> is filling up behind the scenes. Please hop directly into our main central network hub below!
            </div>
        <% } %>

        <!-- Universal Primary Community Target Network -->
        <a href="<%= mainLink %>" target="_blank" class="action-btn btn-community">Join Main Network Hub</a>

        <div class="divider"></div>
        
        <p style="text-align: center; font-weight: 700; margin-bottom: 0.8rem;">🚀 Multiply Your Winning Chances!</p>
        
        <!-- Embedded Visual Asset Frame Showcase -->
        <div class="flyer-display-frame">
            <!-- Ensure /images/giveaway-flyer.jpg exists inside your public directory assets folder -->
            <img src="/images/giveaway-flyer.png" alt="Prepium Mega Giveaway Flyer" class="flyer-image" id="flyerAsset">
        </div>
        
        <button onclick="executeShareAction()" class="action-btn btn-share">Copy Caption & Download Flyer</button>
    </div>

    <script>
        // Smooth Canvas Confetti Framework Integration
        const canvas = document.getElementById("successCanvas");
        const ctx = canvas.getContext("2d");
        let particles = [];

        function resizeCanvas() {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function createConfetti() {
            const hexColors = ["#0062ff", "#047857", "#fbbf24", "#ec4899", "#a855f7"];
            for (let i = 0; i < 75; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height - canvas.height,
                    r: Math.random() * 6 + 4,
                    d: Math.random() * canvas.height,
                    color: hexColors[Math.floor(Math.random() * hexColors.length)],
                    tilt: Math.random() * 10 - 5,
                    tiltAngleIncremental: Math.random() * 0.06 + 0.02,
                    tiltAngle: 0
                });
            }
        }

        function renderConfetti() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach((p, idx) => {
                p.tiltAngle += p.tiltAngleIncremental;
                p.y += (Math.cos(p.d) + 3 + p.r / 2) / 2;
                p.x += Math.sin(p.tiltAngle);
                p.tilt = Math.sin(p.tiltAngle - idx / 3) * 15;

                ctx.beginPath();
                ctx.lineWidth = p.r;
                ctx.strokeStyle = p.color;
                ctx.moveTo(p.x + p.tilt + p.r / 2, p.y);
                ctx.lineTo(p.x + p.tilt, p.y + p.tilt + p.r / 2);
                ctx.stroke();
            });

            particles = particles.filter(p => p.y <= canvas.height);
            if (particles.length > 0) {
                requestAnimationFrame(renderConfetti);
            }
        }

        // Run verification celebratory burst automatically on document mount
        createConfetti();
        renderConfetti();

        // Execution logic handler for clipboard management and file downloading
        function executeShareAction() {
            const captionText = "🎉 Eid & Children's Day Mega Giveaway! 🎁\n\nI just signed up to win cool prizes like cash, airtime, data, free access to Prepium test platforms, and academic scholarships!\n\n👇 Fill out the short form, join your school group, and secure your spot now:\n" + window.location.origin + '/giveaway';
            
            // 1. Copy text payload content to target device clipboard space
            navigator.clipboard.writeText(captionText).then(() => {
                // 2. Programmatically fetch and force download workflow for image flyer
                const flyerImgSrc = document.getElementById('flyerAsset').src;
                const downloadAnchor = document.createElement('a');
                downloadAnchor.href = flyerImgSrc;
                downloadAnchor.download = 'Prepium-Giveaway-Flyer.jpg';
                document.body.appendChild(downloadAnchor);
                downloadAnchor.click();
                document.body.removeChild(downloadAnchor);

                // 3. Trigger UI feedback notification banner animation frame
                const toast = document.getElementById('statusToast');
                toast.classList.add('show');
                setTimeout(() => {
                    toast.classList.remove('show');
                }, 3500);
            }).catch(err => {
                console.error('Could not copy text/trigger download: ', err);
            });
        }
    </script>
</body>
</html>