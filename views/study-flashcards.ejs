<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        .status-bar { height: env(safe-area-inset-top, 0px); }
        .page-content { padding: 0 1.5rem 1.5rem; }

        .fc-stats { display: flex; gap: 8px; padding: 1rem 0; }
        .fc-stats .stat { flex: 1; background: var(--surface-solid); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; text-align: center; }
        .fc-stats .stat .num { font-size: 1.15rem; font-weight: 800; }
        .fc-stats .stat .lbl { font-size: 0.58rem; color: var(--text-secondary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; }

        .fc-card { background: var(--surface-solid); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 3rem 1.5rem; text-align: center; min-height: 260px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; transition: all 0.4s var(--ease-out); margin-bottom: 12px; box-shadow: var(--shadow-sm); position: relative; }
        .fc-card:active { transform: scale(0.98); }
        .fc-card .fc-side { width: 100%; }
        .fc-card .fc-front { font-size: 1.05rem; font-weight: 700; line-height: 1.5; }
        .fc-card .fc-back { font-size: 0.95rem; font-weight: 600; color: var(--text-secondary); line-height: 1.5; }
        .fc-card .tap-hint { position: absolute; bottom: 16px; font-size: 0.6rem; color: var(--text-muted); font-weight: 600; }
        .fc-card .fc-actions { position: absolute; top: 12px; right: 12px; display: flex; gap: 4px; }
        .fc-card .fc-actions button { width: 30px; height: 30px; border-radius: 8px; border: none; background: var(--bg); cursor: pointer; color: var(--text-secondary); font-size: 0.7rem; display: flex; align-items: center; justify-content: center; }
        .fc-card .fc-actions button:hover { background: var(--bg); color: var(--danger); }

        .fc-nav { display: flex; gap: 8px; justify-content: center; }
        .fc-nav button { padding: 12px 20px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--surface-solid); font-family: inherit; font-weight: 700; font-size: 0.78rem; cursor: pointer; color: var(--text-primary); transition: var(--transition); display: flex; align-items: center; gap: 6px; }
        .fc-nav button:active { transform: scale(0.95); }
        .fc-nav button.primary { background: var(--brand-gradient); color: white; border: none; }

        .empty-state { text-align: center; padding: 3rem 1.5rem; }
        .empty-state i { font-size: 2.5rem; color: var(--border-solid); display: block; margin-bottom: 0.8rem; }
        .empty-state h3 { font-size: 0.9rem; font-weight: 700; color: var(--text-secondary); margin: 0 0 4px; }
        .empty-state p { font-size: 0.75rem; color: var(--text-muted); margin: 0; }

        @media (min-width: 431px) { .app-shell { border-left: 1px solid var(--glass-border); border-right: 1px solid var(--glass-border); margin: 0 auto; } }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="status-bar"></div>
    
    <div class="header-nav">
        <a href="/study/course/<%= courseId %>" class="back-circle"><i class="fas fa-arrow-left"></i></a>
        <div class="header-title">Flashcards</div>
        <div style="width:42px"></div>
    </div>

    <div class="page-content">
        <div class="fc-stats">
            <div class="stat"><div class="num" id="totalCards">0</div><div class="lbl">Cards</div></div>
            <div class="stat"><div class="num" id="currentCardNum">0</div><div class="lbl">Viewing</div></div>
        </div>

        <div id="fcContainer">
            <div class="empty-state">
                <i class="fas fa-layer-group"></i>
                <h3>No flashcards yet</h3>
                <p>Generate flashcards from your course material</p>
            </div>
        </div>

        <div class="count-picker" id="countPicker">
            <button class="count-pill" onclick="setCardCount(5)">5</button>
            <button class="count-pill active" onclick="setCardCount(10)">10</button>
            <button class="count-pill" onclick="setCardCount(15)">15</button>
            <button class="count-pill" onclick="setCardCount(20)">20</button>
        </div>

        <div id="inlineError" class="inline-error" style="display:none">
            <i class="fas fa-exclamation-circle"></i>
            <span id="errorText" style="flex:1"></span>
            <button onclick="generateFlashcards()"><i class="fas fa-redo"></i> Retry</button>
        </div>

        <div class="fc-nav">
            <button class="primary" onclick="generateFlashcards()"><i class="fas fa-magic"></i> Generate</button>
            <button onclick="prevCard()"><i class="fas fa-chevron-left"></i></button>
            <button onclick="nextCard()"><i class="fas fa-chevron-right"></i></button>
        </div>
        <div class="fc-nav" style="margin-top:6px">
            <button onclick="deleteAllFlashcards()" style="color:var(--danger);border-color:#fecaca;background:var(--danger-soft)"><i class="fas fa-trash"></i> Delete all</button>
        </div>
    </div>

    <div style="height:40px"></div>

    <%- include('partials/bottom-nav', { activeNav: 'study' }) %>
</div>

<script>
var courseId = <%= courseId %>;
var courseName = '<%= typeof courseName !== 'undefined' ? courseName.replace(/'/g, "\\'") : '' %>';
var flashcards = [];
var currentIndex = 0;
var cardCount = 10;

function setCardCount(n) {
    cardCount = n;
    document.querySelectorAll('.count-pill').forEach(function(p) {
        p.classList.toggle('active', parseInt(p.textContent) === n);
    });
}

function loadFlashcards() {
    hideInlineError();
    fetch('/api/study/flashcards?courseId=' + courseId)
    .then(function(r){ return r.json().catch(function(){ return { flashcards: [] }; }); })
    .then(function(d) {
        if (d.flashcards && d.flashcards.length > 0) {
            flashcards = d.flashcards;
            currentIndex = 0;
            renderCurrentCard();
        } else {
            document.getElementById('totalCards').textContent = (d.flashcards ? d.flashcards.length : 0);
        }
    }).catch(function(e){ console.warn('flashcards load failed', e); });
}

var gradients = [
    ['#667eea', '#764ba2'], ['#f093fb', '#f5576c'], ['#4facfe', '#00f2fe'],
    ['#43e97b', '#38f9d7'], ['#fa709a', '#fee140'], ['#a18cd1', '#fbc2eb'],
    ['#fccb90', '#d57eeb'], ['#e0c3fc', '#8ec5fc'], ['#f5576c', '#ff6f91'],
    ['#30cfd0', '#330867'], ['#ffecd2', '#fcb69f'], ['#89f7fe', '#66a6ff']
];

function getCardColors(text) {
    var h = 0;
    for (var i = 0; i < (text || '').length; i++) { h = ((h << 5) - h) + text.charCodeAt(i); h |= 0; }
    var idx = Math.abs(h) % gradients.length;
    return gradients[idx];
}

function cardSvg(c, fg) {
    var letter = (c.front || '?').charAt(0).toUpperCase();
    return '<svg width="100%" height="120" viewBox="0 0 300 120" style="border-radius:16px 16px 0 0;display:block">' +
        '<defs><linearGradient id="g' + c.id + '" x1="0%" y1="0%" x2="100%" y2="100%">' +
        '<stop offset="0%" style="stop-color:' + fg[0] + '"/>' +
        '<stop offset="100%" style="stop-color:' + fg[1] + '"/></linearGradient></defs>' +
        '<rect width="300" height="120" rx="16" fill="url(#g' + c.id + ')" opacity="0.15"/>' +
        '<circle cx="240" cy="30" r="40" fill="' + fg[0] + '" opacity="0.08"/>' +
        '<circle cx="60" cy="90" r="30" fill="' + fg[1] + '" opacity="0.08"/>' +
        '<text x="24" y="80" font-family="Plus Jakarta Sans,sans-serif" font-size="64" font-weight="800" fill="' + fg[0] + '" opacity="0.2">' + letter + '</text>' +
        '</svg>';
}

function showSkeleton() {
    document.getElementById('fcContainer').innerHTML =
        '<div class="skeleton skeleton-card"></div>' +
        '<div class="skeleton skeleton-text" style="margin:0 auto 6px;width:40%"></div>' +
        '<div class="skeleton skeleton-text short" style="margin:0 auto"></div>';
}

function hideInlineError() {
    document.getElementById('inlineError').style.display = 'none';
}

function showInlineError(msg) {
    document.getElementById('errorText').textContent = msg;
    document.getElementById('inlineError').style.display = 'flex';
}

function renderCurrentCard() {
    var container = document.getElementById('fcContainer');
    document.getElementById('totalCards').textContent = flashcards.length;
    if (flashcards.length === 0) {
        container.innerHTML = '<div class="empty-state reveal"><i class="fas fa-layer-group"></i><h3>No flashcards yet</h3><p>Generate flashcards from your course material</p></div>';
        document.getElementById('currentCardNum').textContent = '0';
        return;
    }
    document.getElementById('currentCardNum').textContent = currentIndex + 1;
    var fc = flashcards[currentIndex];
    var colors = getCardColors(fc.front);
    container.innerHTML = '<div class="fc-card reveal" style="padding:0;overflow:hidden">' +
        cardSvg(fc, colors) +
        '<div class="fc-actions" style="position:absolute;top:12px;right:12px;z-index:2"><button onclick="event.stopPropagation();deleteCard(' + fc.id + ')" title="Delete" style="width:30px;height:30px;border-radius:8px;border:none;background:var(--surface);cursor:pointer;color:var(--danger);font-size:0.7rem;display:flex;align-items:center;justify-content:center"><i class="fas fa-trash"></i></button></div>' +
        '<div style="padding:24px 24px 16px;cursor:pointer;min-height:120px" onclick="flipCard(this)">' +
        '<div class="fc-side fc-front" style="font-size:1.05rem;font-weight:700;line-height:1.5;color:var(--text-primary)">' + escapeHtml(fc.front || '(empty)') + '</div>' +
        '<div class="fc-side fc-back" style="font-size:0.95rem;font-weight:600;color:var(--text-secondary);line-height:1.55;display:none">' + escapeHtml(fc.back || '(empty)') + '</div>' +
        '</div>' +
        '<div style="padding:0 24px 18px;display:flex;justify-content:space-between;align-items:center">' +
        '<div style="font-size:0.6rem;color:var(--text-muted);font-weight:700;text-transform:uppercase;letter-spacing:0.5px">Tap card to flip</div>' +
        '<div id="flipStateBadge" style="font-size:0.6rem;color:var(--brand);font-weight:800;text-transform:uppercase;letter-spacing:0.5px">Front</div>' +
        '</div></div>';
}

function nextCard() {
    if (flashcards.length === 0) return;
    currentIndex = (currentIndex + 1) % flashcards.length;
    renderCurrentCard();
}

function prevCard() {
    if (flashcards.length === 0) return;
    currentIndex = (currentIndex - 1 + flashcards.length) % flashcards.length;
    renderCurrentCard();
}

function generateFlashcards() {
    hideInlineError();
    showSkeleton();
    fetch('/api/study/flashcards/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ courseId: courseId, topicTitle: courseName, count: cardCount })
    }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.success && d.count > 0) {
            Swal.fire({ icon: 'success', text: d.count + ' flashcards created!', timer: 1200, showConfirmButton: false });
            loadFlashcards();
        } else {
            showSkeleton();
            document.getElementById('fcContainer').innerHTML = '<div class="empty-state"><i class="fas fa-layer-group"></i><h3>No flashcards yet</h3><p>Generate flashcards from your course material</p></div>';
            showInlineError(d.error || 'Could not generate flashcards');
        }
    }).catch(function(e) {
        document.getElementById('fcContainer').innerHTML = '<div class="empty-state"><i class="fas fa-layer-group"></i><h3>No flashcards yet</h3><p>Generate flashcards from your course material</p></div>';
        showInlineError(e.message || 'Network error');
    });
}

function deleteCard(id) {
    Swal.fire({ title: 'Delete card?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Delete' }).then(res => {
        if (res.isConfirmed) {
            fetch('/api/study/flashcards/delete/' + id, { method: 'POST' })
            .then(r => r.json()).then(d => {
                if (d.success) loadFlashcards();
            });
        }
    });
}

function flipCard(el) {
    var front = el.querySelector('.fc-front');
    var back = el.querySelector('.fc-back');
    if (!front || !back) return;
    if (front.style.display === 'none') {
        front.style.display = 'block';
        back.style.display = 'none';
        var b = document.getElementById('flipStateBadge'); if (b) b.textContent = 'Front';
    } else {
        front.style.display = 'none';
        back.style.display = 'block';
        var b2 = document.getElementById('flipStateBadge'); if (b2) b2.textContent = 'Back';
    }
}

function escapeHtml(text) {
    return (text || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function deleteAllFlashcards() {
    Swal.fire({ title: 'Delete all flashcards?', text: 'This cannot be undone for this course.', icon: 'warning', showCancelButton: true, confirmButtonText: 'Delete all', confirmButtonColor: '#dc2626' }).then(function(res) {
        if (res.isConfirmed) {
            fetch('/api/study/flashcards/delete-all', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ courseId: courseId }) })
            .then(function(r){ return r.json(); })
            .then(function(d) {
                if (d.success) { Swal.fire({ icon: 'success', text: d.deleted + ' flashcards deleted', timer: 1500, showConfirmButton: false }); loadFlashcards(); }
                else Swal.fire({ icon: 'error', text: d.error });
            });
        }
    });
}

loadFlashcards();
</script>
</body>
</html>
