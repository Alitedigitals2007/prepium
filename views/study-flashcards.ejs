<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>Prepium | Flashcards</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .status-bar { height: env(safe-area-inset-top, 0px); }
        .page-content { padding: 0 1.5rem 1.5rem; }

        .fc-stats { display: flex; gap: 8px; padding: 1rem 0; }
        .fc-stats .stat { flex: 1; background: white; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; text-align: center; }
        .fc-stats .stat .num { font-size: 1.15rem; font-weight: 800; }
        .fc-stats .stat .lbl { font-size: 0.58rem; color: var(--text-sub); font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; }

        .fc-card { background: white; border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 3rem 1.5rem; text-align: center; min-height: 260px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; transition: all 0.4s var(--ease-out); margin-bottom: 12px; box-shadow: var(--shadow-sm); position: relative; }
        .fc-card:active { transform: scale(0.98); }
        .fc-card .fc-side { width: 100%; }
        .fc-card .fc-front { font-size: 1.05rem; font-weight: 700; line-height: 1.5; }
        .fc-card .fc-back { font-size: 0.95rem; font-weight: 600; color: var(--text-sub); line-height: 1.5; display: none; }
        .fc-card.flipped .fc-front { display: none; }
        .fc-card.flipped .fc-back { display: block; }
        .fc-card .tap-hint { position: absolute; bottom: 16px; font-size: 0.6rem; color: var(--text-muted); font-weight: 600; }
        .fc-card .fc-actions { position: absolute; top: 12px; right: 12px; display: flex; gap: 4px; }
        .fc-card .fc-actions button { width: 30px; height: 30px; border-radius: 8px; border: none; background: #f1f5f9; cursor: pointer; color: var(--text-sub); font-size: 0.7rem; display: flex; align-items: center; justify-content: center; }
        .fc-card .fc-actions button:hover { background: #fee2e2; color: var(--danger); }

        .fc-nav { display: flex; gap: 8px; justify-content: center; }
        .fc-nav button { padding: 12px 20px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: white; font-family: inherit; font-weight: 700; font-size: 0.78rem; cursor: pointer; color: var(--text-dark); transition: var(--transition); display: flex; align-items: center; gap: 6px; }
        .fc-nav button:active { transform: scale(0.95); }
        .fc-nav button.primary { background: var(--brand-gradient); color: white; border: none; }

        .empty-state { text-align: center; padding: 3rem 1.5rem; }
        .empty-state i { font-size: 2.5rem; color: #e2e8f0; display: block; margin-bottom: 0.8rem; }
        .empty-state h3 { font-size: 0.9rem; font-weight: 700; color: var(--text-sub); margin: 0 0 4px; }
        .empty-state p { font-size: 0.75rem; color: var(--text-muted); margin: 0; }

        @media (min-width: 431px) { .app-shell { border-left: 1px solid var(--glass-border); border-right: 1px solid var(--glass-border); margin: 0 auto; } }
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="status-bar"></div>
    
    <div class="header-nav">
        <a href="/study/course/<%= courseId %>" class="back-circle"><i class="fas fa-arrow-left"></i></a>
        <div class="header-title">Flashcards</div>
        <div style="width:42px"></div>
    </div>

    <div class="page-content">
        <div class="fc-stats">
            <div class="stat"><div class="num" id="totalCards">0</div><div class="lbl">Cards</div></div>
            <div class="stat"><div class="num" id="currentCardNum">0</div><div class="lbl">Viewing</div></div>
        </div>

        <div id="fcContainer">
            <div class="empty-state">
                <i class="fas fa-layer-group"></i>
                <h3>No flashcards yet</h3>
                <p>Generate flashcards from your course material</p>
            </div>
        </div>

        <div class="fc-nav">
            <button class="primary" onclick="generateFlashcards()"><i class="fas fa-magic"></i> Generate</button>
            <button onclick="prevCard()"><i class="fas fa-chevron-left"></i></button>
            <button onclick="nextCard()"><i class="fas fa-chevron-right"></i></button>
        </div>
    </div>

    <div style="height:40px"></div>

    <%- include('partials/bottom-nav', { activeNav: 'study' }) %>
</div>

<script>
var courseId = <%= courseId %>;
var flashcards = [];
var currentIndex = 0;

function loadFlashcards() {
    fetch('/api/study/flashcards?courseId=' + courseId)
    .then(r => r.json()).then(d => {
        if (d.flashcards && d.flashcards.length > 0) {
            flashcards = d.flashcards;
            currentIndex = 0;
            renderCurrentCard();
        }
    });
}

function renderCurrentCard() {
    var container = document.getElementById('fcContainer');
    document.getElementById('totalCards').textContent = flashcards.length;
    if (flashcards.length === 0) {
        container.innerHTML = '<div class="empty-state"><i class="fas fa-layer-group"></i><h3>No flashcards yet</h3><p>Generate flashcards from your course material</p></div>';
        document.getElementById('currentCardNum').textContent = '0';
        return;
    }
    document.getElementById('currentCardNum').textContent = currentIndex + 1;
    var fc = flashcards[currentIndex];
    container.innerHTML = '<div class="fc-card" onclick="this.classList.toggle(\'flipped\')">' +
        '<div class="fc-actions"><button onclick="event.stopPropagation();deleteCard(' + fc.id + ')" title="Delete"><i class="fas fa-trash"></i></button></div>' +
        '<div class="fc-side fc-front">' + escapeHtml(fc.front) + '</div>' +
        '<div class="fc-side fc-back">' + escapeHtml(fc.back) + '</div>' +
        '<div class="tap-hint">Tap to flip</div></div>';
}

function nextCard() {
    if (flashcards.length === 0) return;
    currentIndex = (currentIndex + 1) % flashcards.length;
    renderCurrentCard();
}

function prevCard() {
    if (flashcards.length === 0) return;
    currentIndex = (currentIndex - 1 + flashcards.length) % flashcards.length;
    renderCurrentCard();
}

function generateFlashcards() {
    Swal.fire({ title: 'Generating...', html: 'AI creating flashcards for this course', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
    fetch('/api/study/flashcards/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ courseId: courseId })
    }).then(r => r.json()).then(d => {
        if (d.success && d.count > 0) {
            Swal.fire({ icon: 'success', text: d.count + ' flashcards created!', timer: 1500, showConfirmButton: false });
            loadFlashcards();
        } else {
            Swal.fire({ icon: 'error', text: d.error || 'Could not generate flashcards' });
        }
    });
}

function deleteCard(id) {
    Swal.fire({ title: 'Delete card?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Delete' }).then(res => {
        if (res.isConfirmed) {
            fetch('/api/study/flashcards/delete/' + id, { method: 'POST' })
            .then(r => r.json()).then(d => {
                if (d.success) loadFlashcards();
            });
        }
    });
}

function escapeHtml(text) {
    return (text || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

loadFlashcards();
</script>
</body>
</html>
