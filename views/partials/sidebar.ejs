<%- include('glass-kit') %>
<header class="w-full top-0 sticky z-40 bg-surface shadow-sm">
<div class="flex justify-between items-center px-gutter py-3 w-full max-w-container-max mx-auto">
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded-full overflow-hidden border-2 border-primary-fixed shadow-sm bg-primary-container flex items-center justify-center text-white font-bold text-sm">
<%= typeof user !== 'undefined' && user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %>
</div>
<div class="flex flex-col">
<span class="font-label-md text-label-md text-on-surface-variant">Welcome back,</span>
<span class="font-title-lg text-title-lg text-academic-navy"><%= typeof user !== 'undefined' && user.fullname ? user.fullname.split(' ')[0] : 'Student' %></span>
</div>
</div>
<div class="flex items-center gap-4">
<div class="bg-surface-container-high rounded-full px-3 py-1 flex items-center gap-1.5 active:scale-95 transition-transform cursor-pointer">
<span class="text-title-lg"><%= typeof streak !== 'undefined' ? streak : 0 %> 🔥</span>
</div>
<a href="/notifications" class="material-symbols-outlined text-academic-navy text-2xl hover:bg-surface-container-high p-2 rounded-full transition-colors">notifications</a>
</div>
</div>
</header>