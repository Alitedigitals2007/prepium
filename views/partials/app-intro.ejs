<style>
        /* ── Motion-design intro (shared) ── */
        #app-intro {
            position: fixed;
            inset: 0;
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0b1437 0%, #162050 50%, #1a2a6c 100%);
            color: white;
            overflow: hidden;
            cursor: pointer;
        }
        #app-intro.exiting { animation: introExit 0.7s cubic-bezier(0.5, 0, 0.8, 0.4) forwards; pointer-events: none; }
        @keyframes introExit { to { opacity: 0; transform: scale(1.18); filter: blur(12px); } }

        .intro-orb { position: absolute; border-radius: 50%; filter: blur(64px); opacity: 0.55; }
        .orb1 { width: 440px; height: 440px; background: #6366f1; top: -130px; left: -130px; animation: float1 9s ease-in-out infinite; }
        .orb2 { width: 380px; height: 380px; background: #2563eb; bottom: -150px; right: -110px; animation: float2 11s ease-in-out infinite; }
        .orb3 { width: 260px; height: 260px; background: #8b5cf6; top: 42%; left: 72%; animation: float3 13s ease-in-out infinite; }
        @keyframes float1 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(60px,40px) scale(1.15); } }
        @keyframes float2 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-50px,-50px) scale(1.1); } }
        @keyframes float3 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(40px,-60px) scale(1.2); } }

        .intro-grid {
            position: absolute; inset: -50%;
            background-image: linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
            background-size: 60px 60px;
            transform: perspective(600px) rotateX(55deg);
            animation: gridMove 14s linear infinite;
        }
        @keyframes gridMove { from { transform: perspective(600px) rotateX(55deg) translateY(0); } to { transform: perspective(600px) rotateX(55deg) translateY(60px); } }

        .intro-center { text-align: center; position: relative; z-index: 2; }
        .intro-logo-wrap { position: relative; width: 96px; height: 96px; margin: 0 auto 24px; animation: popIn 0.75s cubic-bezier(0.2, 1.4, 0.4, 1) 0.1s both; }
        @keyframes popIn { 0% { opacity: 0; transform: scale(0.2) rotate(-24deg); } 60% { transform: scale(1.12) rotate(3deg); } 100% { opacity: 1; transform: scale(1) rotate(0); } }

        .intro-logo {
            width: 96px; height: 96px; border-radius: 26px;
            background: linear-gradient(135deg, #6366f1, #2563eb);
            display: flex; align-items: center; justify-content: center;
            font-size: 2.6rem; font-weight: 800;
            box-shadow: 0 20px 60px rgba(37, 99, 235, 0.55);
            position: relative; z-index: 2; overflow: hidden;
        }
        .intro-logo::before {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(115deg, transparent 30%, rgba(255,255,255,0.4) 50%, transparent 70%);
            background-size: 250% 100%; animation: shimmer 1.8s linear infinite;
        }
        @keyframes shimmer { from { background-position: 250% 0; } to { background-position: -50% 0; } }

        .intro-ring {
            position: absolute; inset: -10px; border-radius: 34px;
            border: 2px solid rgba(255,255,255,0.22); border-top-color: #22d3ee;
            animation: spinRing 1.3s linear infinite; z-index: 1;
        }
        .intro-ring::after {
            content: ''; position: absolute; inset: -16px; border-radius: 46px;
            border: 1px dashed rgba(255,255,255,0.2);
            animation: spinRing 9s linear infinite reverse;
        }
        @keyframes spinRing { to { transform: rotate(360deg); } }

        .intro-word { font-size: 1.9rem; font-weight: 800; letter-spacing: 0.55em; margin-right: -0.55em; padding-left: 0.3em; }
        .intro-word span { display: inline-block; opacity: 0; animation: letterUp 0.55s cubic-bezier(0.2, 1, 0.4, 1) forwards; }
        .intro-word span:nth-child(1) { animation-delay: 0.55s; }
        .intro-word span:nth-child(2) { animation-delay: 0.62s; }
        .intro-word span:nth-child(3) { animation-delay: 0.69s; }
        .intro-word span:nth-child(4) { animation-delay: 0.76s; }
        .intro-word span:nth-child(5) { animation-delay: 0.83s; }
        .intro-word span:nth-child(6) { animation-delay: 0.90s; }
        .intro-word span:nth-child(7) { animation-delay: 0.97s; }
        @keyframes letterUp { from { opacity: 0; transform: translateY(34px); filter: blur(6px); } to { opacity: 1; transform: translateY(0); filter: blur(0); } }

        .intro-tag {
            margin-top: 16px; font-size: 0.72rem; font-weight: 700;
            color: rgba(255,255,255,0.55); letter-spacing: 0.4em; text-transform: uppercase;
            opacity: 0; animation: tagIn 0.6s ease 1.05s forwards;
        }
        @keyframes tagIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .intro-bar { position: absolute; left: 0; bottom: 0; width: 100%; height: 4px; background: rgba(255,255,255,0.08); z-index: 2; }
        .intro-bar-fill { height: 100%; width: 0; background: linear-gradient(90deg, #6366f1, #22d3ee); box-shadow: 0 0 18px #22d3ee; animation: barFill 2.6s linear forwards; }
        @keyframes barFill { from { width: 0; } to { width: 100%; } }

        @media (prefers-reduced-motion: reduce) {
            #app-intro { display: none; }
        }
    </style>
    <div id="app-intro" aria-hidden="true">
        <div class="intro-orb orb1"></div>
        <div class="intro-orb orb2"></div>
        <div class="intro-orb orb3"></div>
        <div class="intro-grid"></div>
        <div class="intro-center">
            <div class="intro-logo-wrap">
                <div class="intro-ring"></div>
                <div class="intro-logo">P</div>
            </div>
            <div class="intro-word"><span>P</span><span>R</span><span>E</span><span>P</span><span>I</span><span>U</span><span>M</span></div>
            <div class="intro-tag"><%= typeof introTag !== 'undefined' && introTag ? introTag : 'Your learning universe' %></div>
        </div>
        <div class="intro-bar"><div class="intro-bar-fill"></div></div>
    </div>
    <script>
    (function() {
        var intro = document.getElementById('app-intro');
        if (!intro) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { intro.remove(); return; }
        var prevOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        var done = false;
        function close() {
            if (done) return;
            done = true;
            document.body.style.overflow = prevOverflow;
            intro.classList.add('exiting');
            setTimeout(function() { intro.remove(); }, 750);
        }
        intro.addEventListener('click', close);
        document.addEventListener('keydown', function(e) { if (e.key === 'Escape' || e.key === 'Enter' || e.key === ' ') close(); });
        setTimeout(close, 3200);
    })();
    </script>