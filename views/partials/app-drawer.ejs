<% if (typeof user !== 'undefined' && user) { %>
<%
    var isPremium = !!user.has_paid;
    var firstName = (user.fullname || 'Student').trim().split(/\s+/)[0];
    var initial = (user.fullname || 'U').trim().charAt(0).toUpperCase();
%>
<style>
    .app-drawer {
        position: fixed; inset: 0; z-index: 10000;
        display: none; overflow-y: auto; -webkit-overflow-scrolling: touch;
        padding: 20px 16px 96px;
        background:
            radial-gradient(900px 420px at 8% -8%, rgba(37, 99, 235, 0.14), transparent 60%),
            radial-gradient(700px 380px at 105% 4%, rgba(124, 58, 237, 0.12), transparent 55%),
            var(--bg);
    }
    .app-drawer.open { display: block; animation: drawerIn 0.3s var(--ease-out); }
    @keyframes drawerIn { from { opacity: 0; transform: translateY(18px); } }

    .drawer-inner { max-width: 680px; margin: 0 auto; }

    .drawer-head {
        display: flex; align-items: center; justify-content: space-between;
        gap: 14px; margin-bottom: 18px;
    }
    .drawer-user { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .drawer-avatar {
        width: 48px; height: 48px; flex: 0 0 48px; border-radius: 16px;
        display: grid; place-items: center; color: #fff; font-weight: 800; font-size: 1.15rem;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.28);
    }
    .drawer-user-text { min-width: 0; }
    .drawer-user-text h2 {
        font-size: 1.15rem; font-weight: 800; letter-spacing: -0.02em;
        color: var(--text-primary); margin: 0; line-height: 1.15;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .drawer-user-text p {
        margin: 3px 0 0; font-size: 0.68rem; font-weight: 600; color: var(--text-muted);
        display: flex; align-items: center; gap: 5px;
    }
    .drawer-pro {
        font-size: 0.55rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em;
        padding: 2px 7px; border-radius: 99px;
        background: linear-gradient(135deg, #f59e0b, #f97316); color: #fff;
    }
    .drawer-close {
        width: 44px; height: 44px; flex: 0 0 44px; border-radius: 15px;
        background: var(--surface-solid); border: 1px solid var(--border-solid);
        color: var(--text-secondary); display: grid; place-items: center;
        cursor: pointer; font-size: 1rem; box-shadow: var(--shadow-sm);
        transition: transform 0.14s var(--ease-out), border-color 0.14s;
    }
    .drawer-close:hover { border-color: var(--brand); color: var(--brand); }
    .drawer-close:active { transform: scale(0.9); }

    .drawer-search-wrap { position: relative; margin-bottom: 20px; }
    .drawer-search-wrap i {
        position: absolute; left: 16px; top: 50%; transform: translateY(-50%);
        color: var(--text-muted); font-size: 0.85rem; pointer-events: none;
    }
    .drawer-search {
        width: 100%; padding: 14px 16px 14px 44px; border-radius: 18px;
        border: 1.5px solid var(--border-solid); background: var(--surface-solid);
        color: var(--text-primary); font-family: var(--font); font-size: 0.92rem;
        box-sizing: border-box; outline: none;
        box-shadow: var(--shadow-sm);
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .drawer-search:focus { border-color: var(--brand); box-shadow: 0 0 0 4px var(--brand-light); }

    /* Featured quick actions */
    .drawer-feature-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 24px; }
    .drawer-feature {
        position: relative; overflow: hidden; text-decoration: none; color: #fff;
        border-radius: 20px; padding: 16px; min-height: 96px;
        display: flex; flex-direction: column; justify-content: space-between;
        box-shadow: 0 12px 26px rgba(15, 23, 42, 0.18);
        transition: transform 0.15s var(--ease-out);
    }
    .drawer-feature:active { transform: scale(0.97); }
    .drawer-feature::after {
        content: ''; position: absolute; width: 120px; height: 120px; border-radius: 50%;
        right: -34px; top: -46px; background: rgba(255, 255, 255, 0.16);
    }
    .drawer-feature.study { background: linear-gradient(135deg, #2563eb, #4f46e5); }
    .drawer-feature.community { background: linear-gradient(135deg, #7c3aed, #db2777); }
    .drawer-feature i { font-size: 1.15rem; position: relative; z-index: 1; }
    .drawer-feature b { font-size: 0.9rem; font-weight: 800; position: relative; z-index: 1; }
    .drawer-feature span { font-size: 0.62rem; opacity: 0.82; font-weight: 600; position: relative; z-index: 1; }

    .drawer-group-label {
        display: flex; align-items: center; gap: 8px;
        font-size: 0.63rem; font-weight: 800; text-transform: uppercase;
        letter-spacing: 0.1em; color: var(--text-muted);
        margin: 22px 0 12px;
    }
    .drawer-group-label::after { content: ''; flex: 1; height: 1px; background: var(--border-solid); border-radius: 2px; }

    .drawer-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px 8px; }
    @media (min-width: 560px) { .drawer-grid { grid-template-columns: repeat(5, 1fr); } }

    .drawer-tile {
        display: flex; flex-direction: column; align-items: center; gap: 8px;
        text-decoration: none; color: inherit; position: relative;
        transition: transform 0.15s var(--ease-out);
        animation: tileIn 0.35s var(--ease-out) both;
    }
    .drawer-tile:nth-child(1) { animation-delay: 0.02s; } .drawer-tile:nth-child(2) { animation-delay: 0.04s; }
    .drawer-tile:nth-child(3) { animation-delay: 0.06s; } .drawer-tile:nth-child(4) { animation-delay: 0.08s; }
    .drawer-tile:nth-child(5) { animation-delay: 0.1s; } .drawer-tile:nth-child(6) { animation-delay: 0.12s; }
    .drawer-tile:nth-child(7) { animation-delay: 0.14s; } .drawer-tile:nth-child(8) { animation-delay: 0.16s; }
    @keyframes tileIn { from { opacity: 0; transform: translateY(10px) scale(0.92); } }
    .drawer-tile:hover { transform: translateY(-3px); }
    .drawer-tile:active { transform: scale(0.9); }
    .drawer-tile .at-icon {
        width: 56px; height: 56px; border-radius: 18px; font-size: 1.25rem;
        display: grid; place-items: center; color: #fff; position: relative;
        box-shadow: inset 0 -5px 0 rgba(0, 0, 0, 0.16), inset 0 2px 0 rgba(255, 255, 255, 0.26), 0 6px 14px rgba(15, 23, 42, 0.16);
        transition: box-shadow 0.16s var(--ease-out);
    }
    .drawer-tile:hover .at-icon {
        box-shadow: inset 0 -5px 0 rgba(0, 0, 0, 0.16), inset 0 2px 0 rgba(255, 255, 255, 0.26), 0 10px 22px rgba(15, 23, 42, 0.24);
    }
    .drawer-tile .at-label {
        font-size: 0.65rem; font-weight: 700; color: var(--text-secondary);
        text-align: center; line-height: 1.28; max-width: 76px;
    }
    .drawer-tile.locked .at-icon, .drawer-tile.locked .at-label { opacity: 0.5; }
    .drawer-tile .at-lock {
        position: absolute; top: -4px; right: calc(50% - 32px);
        width: 19px; height: 19px; border-radius: 50%;
        display: grid; place-items: center; font-size: 0.45rem;
        background: var(--surface-solid); border: 1px solid var(--border-solid);
        color: var(--text-muted); box-shadow: var(--shadow-sm);
    }
    .drawer-tile .at-icon.c-blue   { background: linear-gradient(135deg, #2563eb, #3b82f6); }
    .drawer-tile .at-icon.c-grad   { background: linear-gradient(135deg, #4f46e5, #7c3aed); }
    .drawer-tile .at-icon.c-teal   { background: linear-gradient(135deg, #0d9488, #14b8a6); }
    .drawer-tile .at-icon.c-orange { background: linear-gradient(135deg, #ea580c, #f59e0b); }
    .drawer-tile .at-icon.c-green  { background: linear-gradient(135deg, #059669, #10b981); }
    .drawer-tile .at-icon.c-red    { background: linear-gradient(135deg, #b91c1c, #ef4444); }
    .drawer-tile .at-icon.c-purple { background: linear-gradient(135deg, #7c3aed, #a855f7); }
    .drawer-tile .at-icon.c-amber  { background: linear-gradient(135deg, #b45309, #f59e0b); }
    .drawer-tile .at-icon.c-pink   { background: linear-gradient(135deg, #db2777, #ec4899); }

    .drawer-empty { text-align: center; color: var(--text-muted); font-size: 0.8rem; padding: 28px 0; }
    .drawer-hint {
        margin-top: 26px; text-align: center; font-size: 0.62rem;
        color: var(--text-muted); font-weight: 600;
    }
    .drawer-hint i { color: var(--brand); }

    @media (max-width: 380px) {
        .drawer-grid { grid-template-columns: repeat(3, 1fr); }
        .drawer-feature-row { grid-template-columns: 1fr; }
    }
</style>

<div class="app-drawer" id="appDrawer" role="dialog" aria-modal="true" aria-label="All apps">
    <div class="drawer-inner">
        <div class="drawer-head">
            <div class="drawer-user">
                <div class="drawer-avatar"><%= initial %></div>
                <div class="drawer-user-text">
                    <h2>Hi, <%= firstName %></h2>
                    <p>
                        What do you want to open?
                        <% if (isPremium) { %><span class="drawer-pro">Pro</span><% } %>
                    </p>
                </div>
            </div>
            <button class="drawer-close" onclick="closeDrawer()" aria-label="Close"><i class="fas fa-xmark"></i></button>
        </div>

        <div class="drawer-search-wrap">
            <i class="fas fa-magnifying-glass"></i>
            <input type="search" class="drawer-search" id="drawerSearch" placeholder="Search apps, tools and settings…" oninput="filterDrawer()" autocomplete="off">
        </div>

        <div class="drawer-feature-row" id="drawerFeatured">
            <a href="/study" class="drawer-feature study" data-name="Study Hub">
                <i class="fas fa-graduation-cap"></i>
                <div>
                    <b>Study Hub</b><br>
                    <span>Courses, flashcards &amp; AI tutor</span>
                </div>
            </a>
            <a href="/chat" class="drawer-feature community" data-name="Community">
                <i class="fas fa-comments"></i>
                <div>
                    <b>Community</b><br>
                    <span>Chats, calls, status &amp; feed</span>
                </div>
            </a>
        </div>

        <div id="drawerBody">
            <div class="drawer-group-label">Study</div>
            <div class="drawer-grid">
                <a href="/study" class="drawer-tile" data-name="Study Hub Courses"><div class="at-icon c-grad"><i class="fas fa-book-open"></i></div><span class="at-label">Study Hub</span></a>
                <a href="/games" class="drawer-tile" data-name="Games Hub"><div class="at-icon c-purple"><i class="fas fa-gamepad"></i></div><span class="at-label">Games Hub</span></a>
                <a href="/library" class="drawer-tile" data-name="Course Library"><div class="at-icon c-blue"><i class="fas fa-building-columns"></i></div><span class="at-label">Course Library</span></a>
                <a href="/daily-challenge" class="drawer-tile" data-name="Daily Challenge"><div class="at-icon c-orange"><i class="fas fa-fire-alt"></i></div><span class="at-label">Daily Challenge</span></a>
                <a href="/challenges" class="drawer-tile" data-name="Prepium Challenges"><div class="at-icon c-red"><i class="fas fa-medal"></i></div><span class="at-label">Challenges</span></a>
                <a href="/history" class="drawer-tile" data-name="Quiz History"><div class="at-icon c-green"><i class="fas fa-clock-rotate-left"></i></div><span class="at-label">History</span></a>
            </div>

            <div class="drawer-group-label">Academics</div>
            <div class="drawer-grid">
                <a href="/cgpa" class="drawer-tile <%= isPremium ? '' : 'locked' %>" data-name="CGPA Tracker"><div class="at-icon c-blue"><i class="fas fa-chart-line"></i></div><span class="at-label">CGPA Tracker</span><% if (!isPremium) { %><span class="at-lock"><i class="fas fa-lock"></i></span><% } %></a>
                <a href="/insights" class="drawer-tile" data-name="Academic Insights"><div class="at-icon c-teal"><i class="fas fa-brain"></i></div><span class="at-label">Academic Insights</span></a>
                <a href="/timetable" class="drawer-tile <%= isPremium ? '' : 'locked' %>" data-name="Timetable"><div class="at-icon c-amber"><i class="fas fa-calendar-alt"></i></div><span class="at-label">Timetable</span><% if (!isPremium) { %><span class="at-lock"><i class="fas fa-lock"></i></span><% } %></a>
                <a href="/reading-timetable" class="drawer-tile <%= isPremium ? '' : 'locked' %>" data-name="Reading Plan"><div class="at-icon c-teal"><i class="fas fa-book-dropped"></i></div><span class="at-label">Reading Plan</span><% if (!isPremium) { %><span class="at-lock"><i class="fas fa-lock"></i></span><% } %></a>
                <a href="/deadlines" class="drawer-tile <%= isPremium ? '' : 'locked' %>" data-name="Deadlines"><div class="at-icon c-red"><i class="fas fa-calendar-check"></i></div><span class="at-label">Deadlines</span><% if (!isPremium) { %><span class="at-lock"><i class="fas fa-lock"></i></span><% } %></a>
                <a href="/daily-task" class="drawer-tile <%= isPremium ? '' : 'locked' %>" data-name="Daily Task"><div class="at-icon c-grad"><i class="fas fa-tasks"></i></div><span class="at-label">Daily Task</span><% if (!isPremium) { %><span class="at-lock"><i class="fas fa-lock"></i></span><% } %></a>
            </div>

            <div class="drawer-group-label">Grow</div>
            <div class="drawer-grid">
                <a href="/skills" class="drawer-tile" data-name="Skills Centre"><div class="at-icon c-green"><i class="fas fa-seedling"></i></div><span class="at-label">Skills Centre</span></a>
                <a href="/opportunities" class="drawer-tile" data-name="Opportunities Centre"><div class="at-icon c-amber"><i class="fas fa-briefcase"></i></div><span class="at-label">Opportunities</span></a>
                <a href="/wrapped" class="drawer-tile" data-name="Prepium Wrapped"><div class="at-icon c-pink"><i class="fas fa-gift"></i></div><span class="at-label">Wrapped</span></a>
                <a href="/holiday" class="drawer-tile" data-name="Holiday Mode"><div class="at-icon c-orange"><i class="fas fa-umbrella-beach"></i></div><span class="at-label">Holiday Mode</span></a>
            </div>

            <div class="drawer-group-label">Community</div>
            <div class="drawer-grid">
                <a href="/chat" class="drawer-tile" data-name="Community Chats"><div class="at-icon c-green"><i class="fas fa-comments"></i></div><span class="at-label">Community</span></a>
                <a href="/chat?tab=friends" class="drawer-tile" data-name="Friends Leaderboard"><div class="at-icon c-blue"><i class="fas fa-user-group"></i></div><span class="at-label">Friends</span></a>
                <a href="/competition" class="drawer-tile <%= isPremium ? '' : 'locked' %>" data-name="Live Arena"><div class="at-icon c-red"><i class="fas fa-trophy"></i></div><span class="at-label">Live Arena</span><% if (!isPremium) { %><span class="at-lock"><i class="fas fa-lock"></i></span><% } %></a>
                <a href="/squads" class="drawer-tile" data-name="Squad Streaks"><div class="at-icon c-purple"><i class="fas fa-users"></i></div><span class="at-label">Squad Streaks</span></a>
                <a href="/notifications" class="drawer-tile" data-name="Notifications"><div class="at-icon c-teal"><i class="fas fa-bell"></i></div><span class="at-label">Notifications</span></a>
                <a href="/suggestions" class="drawer-tile" data-name="Feedback"><div class="at-icon c-pink"><i class="fas fa-lightbulb"></i></div><span class="at-label">Feedback</span></a>
            </div>

            <div class="drawer-group-label">Account</div>
            <div class="drawer-grid">
                <a href="/profile" class="drawer-tile" data-name="Profile"><div class="at-icon c-teal"><i class="fas fa-user"></i></div><span class="at-label">Profile</span></a>
                <a href="/upgrade" class="drawer-tile" data-name="Premium"><div class="at-icon c-amber"><i class="fas fa-crown"></i></div><span class="at-label">Premium</span></a>
                <a href="/install" class="drawer-tile" data-name="Install App"><div class="at-icon c-blue"><i class="fas fa-mobile-screen"></i></div><span class="at-label">Install App</span></a>
                <a href="/refer" class="drawer-tile" data-name="Refer and Earn"><div class="at-icon c-orange"><i class="fas fa-hand-holding-heart"></i></div><span class="at-label">Refer &amp; Earn</span></a>
                <a href="/guide" class="drawer-tile" data-name="User Guide"><div class="at-icon c-grad"><i class="fas fa-book"></i></div><span class="at-label">Guide</span></a>
                <a href="/how-it-works" class="drawer-tile" data-name="How It Works"><div class="at-icon c-purple"><i class="fas fa-circle-info"></i></div><span class="at-label">How It Works</span></a>
                <a href="/terms" class="drawer-tile" data-name="Terms"><div class="at-icon c-grad"><i class="fas fa-file-contract"></i></div><span class="at-label">Terms</span></a>
                <a href="/privacy" class="drawer-tile" data-name="Privacy"><div class="at-icon c-grad"><i class="fas fa-lock"></i></div><span class="at-label">Privacy</span></a>
            </div>

            <p class="drawer-empty">No apps found. Try a different search.</p>
        </div>

        <p class="drawer-hint"><i class="fas fa-lightbulb"></i> Tip: tap the search bar to jump to any tool instantly.</p>
    </div>
</div>
<% } %>
