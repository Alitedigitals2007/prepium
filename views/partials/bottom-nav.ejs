<%- include('install-banner') %>
<style>
    /* Re-declare here to guarantee fixed positioning even if style.css wasn't loaded
       or a local <style> in the page overrode .bottom-nav */
    .bottom-nav.fixed-nav {
        position: fixed !important;
        bottom: 16px !important;
        left: 50% !important;
        right: auto !important;
        transform: translateX(-50%) !important;
        width: calc(100% - 32px) !important;
        max-width: 398px !important;
        z-index: 9999 !important;
    }
</style>
<nav class="bottom-nav fixed-nav" id="prepium-bottom-nav">
    <a href="/dashboard" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'dashboard' ? 'active' : '' %>">
        <i class="fas fa-home"></i><span>Home</span>
    </a>
    <a href="/study" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'study' ? 'active' : '' %>">
        <i class="fas fa-graduation-cap"></i><span>Study</span>
    </a>
    <a href="/setup-test" class="nav-center-btn <%= typeof activeNav !== 'undefined' && activeNav === 'quiz' ? 'active' : '' %>">
        <i class="fas fa-plus"></i>
    </a>
    <a href="/history" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'history' ? 'active' : '' %>">
        <i class="fas fa-chart-bar"></i><span>Stats</span>
    </a>
    <a href="/profile" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'profile' ? 'active' : '' %>">
        <i class="fas fa-user-circle"></i><span>Profile</span>
    </a>
    <a href="/guide" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'guide' ? 'active' : '' %>">
        <i class="fas fa-book"></i><span>Guide</span>
    </a>
</nav>
<script>
    // Lift the bottom nav out of any container so `position: fixed` works
    // reliably on every page. Done at parse-end to keep the markup valid.
    (function () {
        var nav = document.getElementById('prepium-bottom-nav');
        if (!nav) return;
        // Move to body root on next tick — restores position:fixed behaviour
        // even if an ancestor has stacking-context quirks
        document.addEventListener('DOMContentLoaded', function () {
            if (nav.parentElement !== document.body) {
                document.body.appendChild(nav);
            }
        });
    })();
</script>
