<%- include('install-banner') %>
<%- include('app-drawer') %>
<style>
    .bottom-nav.fixed-nav {
        position: fixed !important;
        bottom: 16px !important;
        left: 50% !important;
        right: auto !important;
        transform: translateX(-50%) !important;
        width: calc(100% - 32px) !important;
        max-width: 398px !important;
        z-index: 9999 !important;
    }
</style>
<nav class="bottom-nav fixed-nav" id="prepium-bottom-nav">
    <a href="/dashboard" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'dashboard' ? 'active' : '' %>">
        <i class="fas fa-home"></i><span>Home</span>
    </a>
    <a href="/study" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'study' ? 'active' : '' %>">
        <i class="fas fa-graduation-cap"></i><span>Study</span>
    </a>
    <a href="/chat" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'chats' ? 'active' : '' %>">
        <i class="fas fa-comments"></i><span>Chats</span>
    </a>
    <a href="/profile" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'profile' ? 'active' : '' %>">
        <i class="fas fa-user-circle"></i><span>Profile</span>
    </a>
    <a href="/guide" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'guide' ? 'active' : '' %>">
        <i class="fas fa-book"></i><span>Guide</span>
    </a>
</nav>
<script>
    (function () {
        var nav = document.getElementById('prepium-bottom-nav');
        if (!nav) return;
        document.addEventListener('DOMContentLoaded', function () {
            if (nav.parentElement !== document.body) {
                document.body.appendChild(nav);
            }
        });
    })();

    /* Global app-drawer controls (available on all pages) */
    window.openDrawer = function () {
        var d = document.getElementById('appDrawer');
        if (!d) return;
        d.classList.add('open');
        document.body.style.overflow = 'hidden';
        var input = document.getElementById('drawerSearch');
        if (input) { input.value = ''; window.filterDrawer(); setTimeout(function () { input.focus({ preventScroll: true }); }, 120); }
    };
    window.closeDrawer = function () {
        var d = document.getElementById('appDrawer');
        if (!d) return;
        d.classList.remove('open');
        document.body.style.overflow = '';
    };
    window.filterDrawer = function () {
        var input = document.getElementById('drawerSearch');
        if (!input) return;
        var q = input.value.toLowerCase().trim();
        var body = document.getElementById('drawerBody');
        if (!body) return;

        body.querySelectorAll('.drawer-tile').forEach(function (el) {
            var text = (el.getAttribute('data-name') || '') + ' ' + el.textContent;
            el.style.display = (!q || text.toLowerCase().indexOf(q) !== -1) ? '' : 'none';
        });

        /* Hide a section header + grid when it has no matching tiles */
        body.querySelectorAll('.drawer-group-label').forEach(function (label) {
            var grid = label.nextElementSibling;
            var hasVisible = false;
            if (grid) {
                grid.querySelectorAll('.drawer-tile').forEach(function (t) {
                    if (t.style.display !== 'none') hasVisible = true;
                });
                grid.style.display = hasVisible ? '' : 'none';
            }
            label.style.display = hasVisible ? '' : 'none';
        });

        var featured = document.getElementById('drawerFeatured');
        if (featured) featured.style.display = q ? 'none' : '';

        var empty = body.querySelector('.drawer-empty');
        if (empty) {
            var any = false;
            body.querySelectorAll('.drawer-tile').forEach(function (t) { if (t.style.display !== 'none') any = true; });
            empty.style.display = any ? 'none' : '';
        }
    };

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { window.closeDrawer(); }
    });
</script>
