            <section class="prem-section" id="pricing">
                <div class="prem-section-head">
                    <h2>Simple, honest pricing</h2>
                    <p>One payment. Every premium tool. No subscriptions.</p>
                </div>
                <div class="price-card">
                    <div class="price-top">
                        <div class="p-label"><%= isPaidSchool ? 'Your school rate' : 'Full access' %></div>
                        <div class="p-amount">&#8358;<%= (premiumPrice || 2000).toLocaleString() %></div>
                        <div class="p-note">one-time payment — not recurring</div>
                    </div>
                    <div class="price-body">
                        <ul class="price-list">
                            <li><i class="fas fa-circle-check"></i> AI Study Assistant for all your courses</li>
                            <li><i class="fas fa-circle-check"></i> PDF-to-quiz generator with saved history</li>
                            <li><i class="fas fa-circle-check"></i> AI flashcards and revision decks</li>
                            <li><i class="fas fa-circle-check"></i> Timetable, reading schedule & deadline reminders</li>
                            <li><i class="fas fa-circle-check"></i> CGPA tracker, forecasting & transcript export</li>
                            <li><i class="fas fa-circle-check"></i> Performance history and Competition Arena</li>
                        </ul>
                        <% if (!user.has_paid) { %>
                            <button class="btn btn-primary" style="width:100%;justify-content:center;" onclick="payWithPaystack(event)">
                                <i class="fas fa-lock-open"></i> <%= migratedLocked ? 'Recharge Premium' : 'Unlock Premium — ' + '&#8358;' + (premiumPrice || 2000).toLocaleString() %>
                            </button>
                        <% } else { %>
                            <a href="/dashboard" class="btn btn-primary" style="width:100%;justify-content:center;">
                                <i class="fas fa-arrow-right"></i> Go to Dashboard
                            </a>
                        <% } %>
                        <div class="price-meta" style="margin-top:16px;">
                            <div><i class="fas fa-circle-check"></i> <span>Payment is <strong>one-time</strong> — your Premium access does not expire and nothing is charged again.</span></div>
                            <div><i class="fas fa-bolt"></i> <span>Access unlocks immediately after your payment is verified — usually within seconds.</span></div>
                            <div><i class="fas fa-gauge-high"></i> <span>AI tools are rate-limited fairly to keep the service fast for every student.</span></div>
                            <div><i class="fas fa-rotate-right"></i> <span>If a payment fails or is cancelled, you are not upgraded and can safely retry.</span></div>
                            <div><i class="fas fa-shield-halved"></i> <span>Payments are processed securely by Paystack. Prepium never sees your card details.</span></div>
                        </div>
                    </div>
                </div>
            </section>
            <section class="prem-section" id="faq">
                <div class="prem-section-head">
                    <h2>Frequently asked questions</h2>
                </div>
                <div style="max-width:640px;margin:0 auto;">
                    <div class="faq-item">
                        <button class="faq-q" onclick="this.parentElement.classList.toggle('open')">What is included in Premium?<i class="fas fa-chevron-down"></i></button>
                        <div class="faq-a">Everything in the comparison table above: the AI study assistant, PDF-to-quiz generator, AI flashcards, timetable with AI extraction, personalised reading schedule, deadline reminders, full performance history, the Competition Arena, and the complete CGPA toolkit with transcript export.</div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-q" onclick="this.parentElement.classList.toggle('open')">Is payment one-time or recurring?<i class="fas fa-chevron-down"></i></button>
                        <div class="faq-a">One-time. You pay <%= isPaidSchool ? 'your school\'s rate of &#8358;' + (premiumPrice || 2000).toLocaleString() : '&#8358;' + (premiumPrice || 2000).toLocaleString() %> once and Premium stays active on your account. There is no subscription and no automatic renewal.</div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-q" onclick="this.parentElement.classList.toggle('open')">How do AI usage limits work?<i class="fas fa-chevron-down"></i></button>
                        <div class="faq-a">AI features are rate-limited fairly — short pauses between heavy automated bursts — so the service stays fast and available for every student. Normal studying (asking questions, generating quizzes and flashcards) is unaffected.</div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-q" onclick="this.parentElement.classList.toggle('open')">How do I access Premium after payment?<i class="fas fa-chevron-down"></i></button>
                        <div class="faq-a">Instantly. As soon as your payment is verified, every premium feature unlocks on your account automatically. If you switch device or browser, just sign in with the same email — your access follows your account, not your phone.</div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-q" onclick="this.parentElement.classList.toggle('open')">What happens to my saved study materials?<i class="fas fa-chevron-down"></i></button>
                        <div class="faq-a">Nothing changes. Your uploaded materials, quiz history, flashcards and study sessions stay on your account whether you are on the free or premium plan.</div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-q" onclick="this.parentElement.classList.toggle('open')">How can I get help with a payment problem?<i class="fas fa-chevron-down"></i></button>
                        <div class="faq-a">If you were debited but Premium did not unlock, send us a message through the <a href="/suggestions">Feedback</a> page with your transaction reference and we will sort it out quickly.</div>
                    </div>
                </div>
            </section>
            <% if (!user.has_paid) { %>
                <section class="prem-final">
                    <h2>Ready to study smarter?</h2>
                    <p>Join the students preparing with the full Prepium system.</p>
                    <button class="btn btn-primary" onclick="payWithPaystack(event)"><i class="fas fa-bolt"></i> Unlock Premium — &#8358;<%= (premiumPrice || 2000).toLocaleString() %></button>
                </section>
            <% } %>
        <% } %>
    </div>
    <%- include('partials/bottom-nav', { activeNav: 'premium' }) %>
    <script>
        var PREMIUM_PRICE = <%= JSON.stringify(premiumPrice || 2000) %>;
        var RECHARGE_PRICE = <%= JSON.stringify(rechargePrice || premiumPrice || 2000) %>;
        var MIGRATED_LOCKED = <%= JSON.stringify(!!migratedLocked) %>;
        var USER_EMAIL = <%= JSON.stringify(String(user.email || '')) %>;
        var PAYSTACK_KEY = <%= JSON.stringify(String(paystack_key || '')) %>;

        function payWithPaystack(e) {
            if (e) e.preventDefault();
            if (!PAYSTACK_KEY || PAYSTACK_KEY === 'pk_test_your_key') {
                if (typeof Swal !== 'undefined') Swal.fire('Payments unavailable', 'Online payment is not configured right now. Please try again later or send us a message via the Feedback page.', 'warning');
                else alert('Payments are temporarily unavailable. Please try again later.');
                return;
            }
            if (typeof PaystackPop === 'undefined') {
                if (typeof Swal !== 'undefined') Swal.fire('Please wait', 'Payment system is still loading. Try again in a moment.', 'info');
                else alert('Payment system is still loading. Please try again in a moment.');
                return;
            }
            var baseAmount = MIGRATED_LOCKED ? RECHARGE_PRICE : PREMIUM_PRICE;
            var finish = function (info) {
                var amount = Math.round(info.amount * 100);
                var handler;
                try {
                    handler = PaystackPop.setup({
                        key: PAYSTACK_KEY,
                        email: USER_EMAIL,
                        amount: amount,
                        currency: 'NGN',
                        callback: function (response) {
                            window.location.href = '/verify-payment?reference=' + encodeURIComponent(response.reference) + (info.coupon ? '&coupon=' + encodeURIComponent(info.coupon) : '');
                        },
                        onClose: function () { }
                    });
                } catch (err) {
                    if (typeof Swal !== 'undefined') Swal.fire('Payment error', 'We could not start the payment. Please try again or contact support via Feedback.', 'error');
                    return;
                }
                handler.openIframe();
            };
            if (typeof Swal === 'undefined') { finish({ amount: baseAmount, coupon: null }); return; }
            Swal.fire({
                title: 'Have a coupon?',
                input: 'text',
                inputPlaceholder: 'Enter coupon code (optional)',
                showCancelButton: true,
                confirmButtonText: 'Continue',
                cancelButtonText: 'Pay full price',
                preConfirm: function (code) {
                    if (!code || !code.trim()) return null;
                    return fetch('/api/coupon/validate', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ code: code.trim() })
                    }).then(function (r) { return r.json(); }).then(function (data) {
                        if (!data.valid) { Swal.showValidationMessage(data.message || 'Invalid coupon'); return false; }
                        return data;
                    }).catch(function () { Swal.showValidationMessage('Could not validate coupon. Try again.'); return false; });
                }
            }).then(function (result) {
                if (result.isDismissed) { finish({ amount: baseAmount, coupon: null }); return; }
                if (result.isConfirmed) {
                    var info = { amount: baseAmount, coupon: null };
                    if (result.value && result.value.valid) {
                        info.amount = result.value.final_amount;
                        info.coupon = result.value.code;
                        if (typeof Swal !== 'undefined') Swal.fire('Coupon applied', result.value.discountLabel + ' — you will pay \u20A6' + result.value.final_amount.toLocaleString(), 'success');
                    }
                    finish(info);
                }
            });
        }

        document.querySelectorAll('.faq-q').forEach(function (btn) {
            btn.addEventListener('click', function () { /* class toggled inline */ });
        });

        <% if (paymentState === 'success') { %>
        if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'success', title: 'Payment Successful!', text: 'Premium unlocked. Welcome aboard!', timer: 3000, showConfirmButton: false });
        }
        if (window.history.replaceState) {
            var clean = window.location.origin + window.location.pathname;
            window.history.replaceState({}, document.title, clean);
        }
        <% } else if (paymentState === 'failed') { %>
        if (typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'error', title: 'Payment Failed', text: 'Your payment could not be completed. No upgrade was applied.', timer: 4000, showConfirmButton: false });
        }
        if (window.history.replaceState) {
            var clean = window.location.origin + window.location.pathname;
            window.history.replaceState({}, document.title, clean);
        }
        <% } %>
    </script>
</body>
</html>
