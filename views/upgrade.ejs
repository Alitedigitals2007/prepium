<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <style>
        .prem-hero { text-align: center; padding: 28px 4px 10px; position: relative; }
        .prem-hero::before, .prem-hero::after {
            content: ''; position: absolute; border-radius: 50%; pointer-events: none; z-index: 0;
        }
        .prem-hero::before { width: 260px; height: 260px; left: -90px; top: -110px; background: radial-gradient(circle, rgba(124, 58, 237, 0.14), transparent 70%); }
        .prem-hero::after { width: 220px; height: 220px; right: -80px; top: 20px; background: radial-gradient(circle, rgba(37, 99, 235, 0.13), transparent 70%); }
        .prem-badge {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 6px 14px; border-radius: 999px;
            background: var(--brand-soft); color: var(--brand);
            font-size: 0.75rem; font-weight: 800; letter-spacing: 0.04em;
            text-transform: uppercase; margin-bottom: 14px;
            position: relative; z-index: 1;
        }
        .prem-badge i { animation: crownFloat 2.4s ease-in-out infinite; }
        @keyframes crownFloat { 50% { transform: translateY(-3px); } }
        .prem-title {
            font-size: clamp(1.7rem, 6vw, 2.6rem); font-weight: 800;
            line-height: 1.15; color: var(--text-primary);
            margin: 0 0 12px; letter-spacing: -0.02em;
            position: relative; z-index: 1;
        }
        .prem-title .grad {
            background: linear-gradient(90deg, #2563eb, #7c3aed, #2563eb);
            background-size: 200% 100%;
            -webkit-background-clip: text; background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: gradShift 4s linear infinite;
        }
        @keyframes gradShift { to { background-position: -200% 0; } }
        .prem-sub { font-size: 0.95rem; color: var(--text-secondary); max-width: 560px; margin: 0 auto 20px; line-height: 1.6; position: relative; z-index: 1; }
        .prem-cta-row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 14px; position: relative; z-index: 1; }
        .prem-price-chip { display: inline-flex; align-items: baseline; gap: 6px; font-size: 0.85rem; color: var(--text-secondary); }
        .prem-price-chip strong { font-size: 1.15rem; color: var(--text-primary); font-weight: 800; }
        .prem-preview {
            max-width: 460px; margin: 26px auto 0;
            border-radius: var(--radius-xl); background: var(--surface);
            border: 1px solid var(--border); box-shadow: var(--shadow-xl);
            overflow: hidden; text-align: left;
        }
        .prem-preview-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; border-bottom: 1px solid var(--border); background: var(--surface-solid); }
        .prem-preview-bar span { width: 9px; height: 9px; border-radius: 50%; background: var(--border-solid); }
        .prem-preview-bar span:first-child { background: var(--brand); }
        .prem-preview-body { padding: 16px 14px; display: grid; gap: 10px; }
        .pp-row { display: flex; gap: 10px; align-items: center; }
        .pp-bubble { flex: 1; border-radius: 12px; padding: 10px 12px; font-size: 0.78rem; line-height: 1.45; color: var(--text-secondary); background: var(--surface-solid); border: 1px solid var(--border); }
        .pp-bubble.ai { background: var(--brand-soft); border-color: var(--brand-light); color: var(--text-primary); }
        .pp-avatar {
            width: 28px; height: 28px; flex: 0 0 28px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.7rem; background: var(--brand-gradient); color: #fff;
        }
        .pp-avatar.user { background: var(--surface-solid); border: 1px solid var(--border); color: var(--text-muted); }
        .pp-chip-row { display: flex; gap: 6px; flex-wrap: wrap; padding-left: 38px; }
        .pp-chip { font-size: 0.68rem; font-weight: 700; padding: 4px 10px; border-radius: 999px; background: var(--brand-soft); color: var(--brand); }
        .pp-caption { text-align: center; font-size: 0.72rem; color: var(--text-muted); margin-top: 10px; }
        .prem-trust { display: flex; justify-content: center; gap: 18px; flex-wrap: wrap; margin: 22px 0 8px; }
        .prem-trust-item { display: flex; align-items: center; gap: 7px; font-size: 0.78rem; font-weight: 600; color: var(--text-secondary); }
        .prem-trust-item i { color: var(--success); }
        .prem-section { margin-top: 46px; }
        .prem-section-head { text-align: center; max-width: 560px; margin: 0 auto 22px; }
        .prem-section-head h2 { font-size: 1.4rem; font-weight: 800; color: var(--text-primary); margin: 0 0 8px; letter-spacing: -0.01em; }
        .prem-section-head p { font-size: 0.9rem; color: var(--text-secondary); margin: 0; line-height: 1.6; }
        .cmp-card { border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--border); overflow: hidden; }
        .cmp-head, .cmp-row { display: grid; grid-template-columns: 1fr 64px 64px; align-items: center; gap: 8px; padding: 13px 16px; }
        .cmp-head {
            background: var(--surface-solid); border-bottom: 1px solid var(--border);
            font-size: 0.72rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.05em; color: var(--text-muted);
        }
        .cmp-head .cmp-col { text-align: center; }
        .cmp-head .cmp-col.prem { color: var(--brand); }
        .cmp-row { border-bottom: 1px solid var(--border); }
        .cmp-row:last-child { border-bottom: none; }
        .cmp-row:nth-child(even) { background: rgba(148, 163, 184, 0.04); }
        .cmp-name { font-size: 0.85rem; font-weight: 600; color: var(--text-primary); }
        .cmp-name small { display: block; font-size: 0.72rem; color: var(--text-muted); font-weight: 500; }
        .cmp-val { text-align: center; }
        .cmp-val i { width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 0.7rem; }
        .cmp-val i.yes { background: var(--success-soft); color: var(--success); }
        .cmp-val i.no { background: rgba(148, 163, 184, 0.15); color: var(--text-muted); }
        @media (min-width: 640px) { .cmp-head, .cmp-row { grid-template-columns: 1fr 110px 110px; padding: 14px 22px; } }
        .feat-block { display: grid; gap: 16px; align-items: center; margin-bottom: 34px; }
        @media (min-width: 860px) {
            .feat-block { grid-template-columns: 1fr 1fr; gap: 34px; }
            .feat-block.flip .feat-copy { order: 2; }
        }
        .feat-kicker {
            display: inline-flex; align-items: center; gap: 6px;
            font-size: 0.72rem; font-weight: 800; letter-spacing: 0.05em;
            text-transform: uppercase; color: var(--brand); margin-bottom: 8px;
        }
        .feat-copy h3 { font-size: 1.2rem; font-weight: 800; color: var(--text-primary); margin: 0 0 8px; }
        .feat-copy p { font-size: 0.88rem; color: var(--text-secondary); line-height: 1.65; margin: 0 0 12px; }
        .feat-points { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
        .feat-points li { display: flex; gap: 9px; font-size: 0.84rem; color: var(--text-secondary); line-height: 1.5; }
        .feat-points i { color: var(--brand); margin-top: 3px; font-size: 0.8rem; }
        .feat-visual { border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow-md); padding: 18px 16px; }
        .fv-title {
            font-size: 0.72rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.05em; color: var(--text-muted);
            margin-bottom: 12px; display: flex; align-items: center; gap: 7px;
        }
        .fv-row {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 12px; border-radius: 12px;
            background: var(--surface-solid); border: 1px solid var(--border);
            margin-bottom: 8px; font-size: 0.8rem; color: var(--text-secondary);
        }
        .fv-row:last-child { margin-bottom: 0; }
        .fv-ico {
            width: 32px; height: 32px; flex: 0 0 32px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.8rem; background: var(--brand-soft); color: var(--brand);
        }
        .fv-bar { flex: 1; height: 7px; border-radius: 4px; background: rgba(148, 163, 184, 0.18); overflow: hidden; }
        .fv-bar span { display: block; height: 100%; border-radius: 4px; background: var(--brand-gradient); }
        .fv-mini-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
        .fv-mini { border-radius: 12px; background: var(--surface-solid); border: 1px solid var(--border); padding: 10px 8px; text-align: center; }
        .fv-mini b { display: block; font-size: 1rem; color: var(--text-primary); }
        .fv-mini span { font-size: 0.66rem; color: var(--text-muted); font-weight: 600; }
        .fv-chat { display: grid; gap: 8px; }
        .fv-msg { max-width: 88%; padding: 9px 12px; border-radius: 12px; font-size: 0.78rem; line-height: 1.5; background: var(--surface-solid); border: 1px solid var(--border); color: var(--text-secondary); }
        .fv-msg.ai { background: var(--brand-soft); border-color: var(--brand-light); color: var(--text-primary); justify-self: start; }
        .fv-msg.me { justify-self: end; }
        .price-card {
            max-width: 460px; margin: 0 auto; position: relative;
            border-radius: var(--radius-xl); background: var(--surface);
            border: 2px solid transparent;
            background-clip: padding-box;
            box-shadow: var(--shadow-lg); overflow: hidden;
        }
        .price-card::before {
            content: ''; position: absolute; inset: -2px; z-index: -1;
            border-radius: var(--radius-xl);
            background: linear-gradient(135deg, #2563eb, #7c3aed, #2563eb);
            background-size: 200% 200%;
            animation: gradShift 4s linear infinite;
        }
        .price-ribbon {
            position: absolute; top: 14px; right: -34px; z-index: 2;
            transform: rotate(45deg); padding: 5px 40px;
            background: #f59e0b; color: #fff; font-size: 0.6rem; font-weight: 800;
            text-transform: uppercase; letter-spacing: 0.1em;
            box-shadow: 0 3px 10px rgba(245, 158, 11, 0.4);
        }
        .btn-primary { position: relative; overflow: hidden; }
        .btn-primary::after {
            content: ''; position: absolute; top: 0; left: -80%; width: 50%; height: 100%;
            background: linear-gradient(105deg, transparent, rgba(255,255,255,0.35), transparent);
            transform: skewX(-20deg); animation: shine 3.2s ease-in-out infinite;
        }
        @keyframes shine { 0%, 60% { left: -80%; } 100% { left: 130%; } }
        .proof-band {
            max-width: 640px; margin: 26px auto 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;
            background: var(--surface-solid); border: 1px solid var(--border-solid); border-radius: var(--radius-lg); padding: 14px 10px;
        }
        .proof-band div { text-align: center; }
        .proof-band b { display: block; font-size: 1.05rem; font-weight: 800; color: var(--text-primary); }
        .proof-band span { font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-muted); font-weight: 700; }
        .sticky-cta {
            position: fixed; left: 50%; transform: translateX(-50%);
            bottom: 84px; z-index: 500; width: calc(100% - 24px); max-width: 420px;
            display: none; align-items: center; gap: 10px;
            background: var(--surface-solid); border: 1px solid var(--border-solid);
            border-radius: 18px; padding: 10px 12px 10px 16px;
            box-shadow: 0 12px 34px rgba(15, 23, 42, 0.25);
        }
        .sticky-cta.show { display: flex; }
        .sticky-cta .sc-info { flex: 1; min-width: 0; }
        .sticky-cta .sc-info b { display: block; font-size: 0.8rem; font-weight: 800; color: var(--text-primary); }
        .sticky-cta .sc-info span { font-size: 0.62rem; color: var(--text-muted); font-weight: 600; }
        .sticky-cta button { border: none; border-radius: 12px; padding: 0.7rem 1rem; background: var(--brand-gradient); color: #fff; font-family: inherit; font-size: 0.72rem; font-weight: 800; cursor: pointer; white-space: nowrap; }
        .price-top { padding: 26px 22px 18px; text-align: center; background: var(--brand-gradient); color: #fff; }
        .price-top .p-label { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.85; }
        .price-top .p-amount { font-size: 2.4rem; font-weight: 800; letter-spacing: -0.02em; margin: 6px 0 2px; }
        .price-top .p-note { font-size: 0.8rem; opacity: 0.9; }
        .price-body { padding: 20px 22px 24px; }
        .price-list { list-style: none; padding: 0; margin: 0 0 18px; display: grid; gap: 10px; }
        .price-list li { display: flex; gap: 10px; font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; }
        .price-list i { color: var(--success); margin-top: 3px; }
        .price-meta { display: grid; gap: 8px; font-size: 0.78rem; color: var(--text-muted); border-top: 1px dashed var(--border-solid); padding-top: 14px; }
        .price-meta div { display: flex; gap: 8px; align-items: flex-start; line-height: 1.5; }
        .price-meta i { margin-top: 2px; color: var(--text-muted); width: 14px; text-align: center; }
        .active-card {
            display: flex; align-items: center; gap: 14px;
            padding: 18px; border-radius: var(--radius-lg);
            background: var(--success-soft); border: 1px solid rgba(22, 163, 74, 0.25);
        }
        .active-card .ac-ico {
            width: 46px; height: 46px; flex: 0 0 46px; border-radius: 14px;
            background: var(--success); color: #fff;
            display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
        }
        .active-card h3 { margin: 0 0 3px; font-size: 1rem; color: var(--text-primary); }
        .active-card p { margin: 0; font-size: 0.82rem; color: var(--text-secondary); }
        .success-hero { text-align: center; padding: 40px 10px 20px; }
        .success-ring {
            width: 92px; height: 92px; margin: 0 auto 18px; border-radius: 50%;
            background: var(--success-soft);
            display: flex; align-items: center; justify-content: center;
            animation: pop 0.45s var(--ease-spring);
        }
        .success-ring i { font-size: 2.2rem; color: var(--success); }
        .success-hero h1 { font-size: 1.6rem; font-weight: 800; color: var(--text-primary); margin: 0 0 8px; }
        .success-hero p { font-size: 0.92rem; color: var(--text-secondary); max-width: 420px; margin: 0 auto 22px; line-height: 1.6; }
        .faq-item { border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); margin-bottom: 10px; overflow: hidden; }
        .faq-q {
            width: 100%; display: flex; align-items: center; justify-content: space-between;
            gap: 12px; padding: 15px 16px; background: none; border: none;
            font-family: var(--font); font-size: 0.88rem; font-weight: 700;
            color: var(--text-primary); text-align: left; cursor: pointer; min-height: 44px;
        }
        .faq-q i { transition: transform 0.25s var(--ease-out); color: var(--text-muted); font-size: 0.8rem; }
        .faq-item.open .faq-q i { transform: rotate(180deg); }
        .faq-a { display: none; padding: 0 16px 15px; font-size: 0.84rem; color: var(--text-secondary); line-height: 1.65; }
        .faq-item.open .faq-a { display: block; }
        .prem-final { text-align: center; padding: 40px 0 30px; }
        .prem-final h2 { font-size: 1.35rem; font-weight: 800; color: var(--text-primary); margin: 0 0 8px; }
        .prem-final p { font-size: 0.88rem; color: var(--text-secondary); margin: 0 0 18px; }
        @media (min-width: 1024px) { .prem-hero { padding-top: 48px; } }
    </style>
</head>
<body>
    <%- include('partials/theme-toggle') %>
    <%- include('partials/sidebar') %>
    <div class="app-shell">
        <% if (paymentState === 'success') { %>
            <section class="success-hero">
                <div class="success-ring"><i class="fas fa-check"></i></div>
                <h1>Payment Successful</h1>
                <p>Your Premium access is now active on your account. Every premium tool — the AI study assistant, PDF-to-quiz generator, flashcards, planners and CGPA tools — is unlocked.</p>
                <div class="prem-cta-row">
                    <a href="/dashboard" class="btn btn-primary"><i class="fas fa-arrow-right"></i> Start Studying</a>
                    <a href="#features" class="btn btn-outline">See What's Unlocked</a>
                </div>
            </section>
        <% } else { %>
            <% if (paymentState === 'failed') { %>
                <div class="notice-strip warning" style="margin-top:16px;">
                    <i class="fas fa-triangle-exclamation"></i>
                    <span>
                        <strong>Payment not completed.</strong>
                        <% if (paymentReason === 'transaction_not_successful') { %>
                            The transaction was not successful, so no upgrade was applied. You can try again below.
                        <% } else if (paymentReason === 'invalid_amount') { %>
                            The payment amount could not be verified. No upgrade was applied.
                        <% } else { %>
                            The payment could not be verified. If you were debited, contact support with your transaction reference before retrying.
                        <% } %>
                    </span>
                </div>
            <% } %>
            <% if (user.has_paid) { %>
                <div style="margin-top:20px;">
                    <div class="active-card">
                        <div class="ac-ico"><i class="fas fa-crown"></i></div>
                        <div>
                            <h3>Premium is active on your account</h3>
                            <p>You already have full access to every premium tool. Head to your dashboard to keep studying.</p>
                        </div>
                    </div>
                </div>
            <% } %>
            <section class="prem-hero">
                <div class="prem-badge"><i class="fas fa-crown"></i> Prepium Premium</div>
                <h1 class="prem-title">Study smarter.<br><span class="grad">Prepare better.</span></h1>
                <p class="prem-sub">
                    Premium unlocks the complete Prepium study system — an AI study assistant that explains difficult topics,
                    a generator that turns your lecture PDFs into exam-style quizzes, smart flashcards, planners and CGPA tools.
                </p>
                <% if (!user.has_paid) { %>
                    <div class="prem-cta-row">
                        <button class="btn btn-primary" onclick="payWithPaystack(event)">
                            <i class="fas fa-bolt"></i> <%= migratedLocked ? 'Recharge Premium' : 'Unlock Premium' %>
                        </button>
                        <a href="#features" class="btn btn-outline">Explore Features</a>
                    </div>
                    <div class="prem-price-chip">
                        <strong>&#8358;<%= (premiumPrice || 2000).toLocaleString() %></strong>
                        <span>one-time payment</span>
                    </div>
                <% } %>
                <div class="prem-preview" aria-hidden="true">
                    <div class="prem-preview-bar"><span></span><span></span><span></span></div>
                    <div class="prem-preview-body">
                        <div class="pp-row">
                            <div class="pp-avatar user"><i class="fas fa-user" style="font-size:0.65rem;"></i></div>
                            <div class="pp-bubble">Explain glycolysis like I'm pre-exam — steps only.</div>
                        </div>
                        <div class="pp-row">
                            <div class="pp-avatar"><i class="fas fa-robot" style="font-size:0.65rem;"></i></div>
                            <div class="pp-bubble ai">Glycolysis has 10 steps in 2 phases. Here's the short version, then a 5-question check…</div>
                        </div>
                        <div class="pp-chip-row">
                            <span class="pp-chip">Step-by-step</span>
                            <span class="pp-chip">Practice quiz</span>
                            <span class="pp-chip">Flashcards</span>
                        </div>
                    </div>
                    <div class="pp-caption">Preview of the premium AI study workflow</div>
                </div>
                <div class="prem-trust">
                    <span class="prem-trust-item"><i class="fas fa-circle-check"></i> One-time payment</span>
                    <span class="prem-trust-item"><i class="fas fa-bolt"></i> Instant unlock</span>
                    <span class="prem-trust-item"><i class="fas fa-shield-halved"></i> Secure via Paystack</span>
                </div>
            </section>
            <section class="prem-section" id="compare">
                <div class="prem-section-head">
                    <h2>Free vs Premium</h2>
                    <p>Everything on the free plan stays free. Premium adds the AI-powered study system on top.</p>
                </div>
                <% if (schoolLockedFeatures && schoolLockedFeatures.length) { %>
                    <div class="notice-strip" style="max-width:640px;margin:0 auto 14px;">
                        <i class="fas fa-circle-info"></i>
                        <span>Some premium features may be restricted for your school by your administrator.</span>
                    </div>
                <% } %>
                <div class="cmp-card" style="max-width:640px;margin:0 auto;">
                    <div class="cmp-head">
                        <span>Feature</span>
                        <span class="cmp-col">Free</span>
                        <span class="cmp-col prem">Premium</span>
                    </div>
                    <% const cmpRows = [
                        ['CBT practice quizzes', "Practice with your school's question bank", true, true],
                        ['Daily Challenge', 'Daily 10-question challenge & leaderboard', true, true],
                        ['Daily Task planner', 'Goals and daily study tasks', true, true],
                        ['Squad Streaks', 'Study accountability with friends', true, true],
                        ['AI Study Assistant', 'Ask questions per course & topic, get step-by-step explanations', false, true],
                        ['PDF-to-Quiz Generator', 'Turn your lecture notes into MCQ, theory & fill-in questions', false, true],
                        ['AI Flashcards', 'Auto-generated revision decks per topic', false, true],
                        ['Timetable + AI Extract', 'Import your class timetable from a photo or PDF', false, true],
                        ['AI Reading Schedule', 'A personalised weekly reading plan', false, true],
                        ['Deadline Tracker', 'Deadlines with email reminders', false, true],
                        ['Performance History', 'Full attempt history and score analytics', false, true],
                        ['Competition Arena', 'Live rankings against other students', false, true],
                        ['CGPA Tracker & Forecast', 'Grade logging, what-if builder, AI prediction, transcript export', false, true]
                    ]; %>
                    <% cmpRows.forEach(function(r) { %>
                        <div class="cmp-row">
                            <div class="cmp-name"><%= r[0] %><small><%= r[1] %></small></div>
                            <div class="cmp-val"><% if (r[2]) { %><i class="fas fa-check yes"></i><% } else { %><i class="fas fa-minus no"></i><% } %></div>
                            <div class="cmp-val"><i class="fas fa-check yes"></i></div>
                        </div>
                    <% }); %>
                </div>
            </section>
            <section class="prem-section" id="features">
                <div class="prem-section-head">
                    <h2>What Premium unlocks</h2>
                    <p>Each tool solves a real academic problem — not just another feature list.</p>
                </div>
                <div class="feat-block">
                    <div class="feat-copy">
                        <span class="feat-kicker"><i class="fas fa-robot"></i> AI Study Assistant</span>
                        <h3>Never get stuck on a topic alone</h3>
                        <p>Reading at 1am and nothing makes sense? Ask the AI tutor inside your Study Hub. It explains topics step by step, answers follow-up questions, and works with your actual course — not generic advice.</p>
                        <ul class="feat-points">
                            <li><i class="fas fa-check"></i> Ask questions per course, topic or subtopic</li>
                            <li><i class="fas fa-check"></i> Clear explanations with maths notation support</li>
                            <li><i class="fas fa-check"></i> Chat history saved so you can revisit sessions</li>
                        </ul>
                    </div>
                    <div class="feat-visual">
                        <div class="fv-title"><i class="fas fa-comments"></i> Tutor chat</div>
                        <div class="fv-chat">
                            <div class="fv-msg me">Why does my integration keep giving a negative area?</div>
