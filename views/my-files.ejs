<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | My Files</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mf-container { padding: 1.25rem; padding-bottom: 100px; max-width: 700px; margin: 0 auto; }
        .mf-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
        .mf-header h1 { font-size: 1.4rem; font-weight: 800; margin: 0; }
        .mf-upload-btn { padding: 10px 18px; border-radius: 12px; background: var(--brand); color: white; border: none; font-weight: 700; font-size: 0.78rem; cursor: pointer; display: flex; align-items: center; gap: 6px; }
        .mf-upload-btn:active { transform: scale(0.95); }
        .file-grid { display: flex; flex-direction: column; gap: 8px; }
        .file-card { background: white; border-radius: 16px; padding: 14px 16px; border: 1px solid rgba(226,232,240,0.5); box-shadow: 0 2px 8px rgba(0,0,0,0.04); display: flex; align-items: center; gap: 12px; }
        .file-card .fi-icon { width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }
        .file-card .fi-body { flex: 1; min-width: 0; }
        .file-card .fi-name { font-size: 0.82rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .file-card .fi-meta { font-size: 0.65rem; color: var(--text-sub); font-weight: 600; margin-top: 1px; }
        .file-card .fi-actions { display: flex; gap: 6px; }
        .file-card .fi-actions button { width: 34px; height: 34px; border-radius: 10px; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 0.78rem; }
        .file-card .fi-actions .view-btn { background: #eef4ff; color: var(--brand); }
        .file-card .fi-actions .del-btn { background: #fee2e2; color: #ef4444; }
        .empty-state { text-align: center; padding: 3rem 1rem; }
        .empty-state i { font-size: 2.5rem; color: var(--text-muted); margin-bottom: 1rem; }
        .empty-state h3 { font-size: 1rem; font-weight: 700; }
        .empty-state p { font-size: 0.75rem; color: var(--text-sub); }
        .upload-modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 10000; display: flex; align-items: center; justify-content: center; padding: 1.25rem; }
        .upload-modal { background: white; border-radius: 24px; padding: 24px; width: 100%; max-width: 400px; }
        .upload-modal h2 { font-size: 1.1rem; font-weight: 800; margin: 0 0 4px; }
        .upload-modal p { font-size: 0.72rem; color: var(--text-sub); margin: 0 0 1rem; }
        .upload-modal input, .upload-modal .file-drop { width: 100%; margin-bottom: 12px; }
        .upload-modal .file-drop { border: 2px dashed #e2e8f0; border-radius: 16px; padding: 32px 16px; text-align: center; cursor: pointer; transition: all 0.2s; }
        .upload-modal .file-drop:hover { border-color: var(--brand); background: #f8faff; }
        .upload-modal .file-drop i { font-size: 2rem; color: var(--text-muted); margin-bottom: 8px; }
        .upload-modal .file-drop p { font-size: 0.75rem; font-weight: 600; margin: 0; }
        .upload-modal .file-drop .fd-name { font-size: 0.68rem; color: var(--brand); font-weight: 700; margin-top: 6px; }
        .upload-modal .modal-actions { display: flex; gap: 8px; }
        .upload-modal .modal-actions button { flex: 1; padding: 12px; border-radius: 14px; border: none; font-weight: 700; font-size: 0.78rem; cursor: pointer; }
        .upload-modal .modal-actions .cancel { background: #f1f5f9; color: var(--text-dark); }
        .upload-modal .modal-actions .upload-submit { background: var(--brand); color: white; }
        .upload-modal .modal-actions .upload-submit:disabled { opacity: 0.5; }
        .viewer-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 10001; display: flex; flex-direction: column; }
        .viewer-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; color: white; }
        .viewer-header h3 { font-size: 0.9rem; font-weight: 700; margin: 0; }
        .viewer-header button { background: rgba(255,255,255,0.15); border: none; color: white; width: 36px; height: 36px; border-radius: 10px; cursor: pointer; }
        .viewer-body { flex: 1; display: flex; align-items: center; justify-content: center; padding: 16px; overflow: auto; }
        .viewer-body iframe, .viewer-body embed { width: 100%; height: 100%; min-height: 70vh; border: none; border-radius: 12px; }
        .viewer-body .no-preview { color: rgba(255,255,255,0.6); text-align: center; }
        .viewer-body .no-preview i { font-size: 3rem; margin-bottom: 12px; }
        .viewer-body .no-preview a { color: white; text-decoration: underline; }
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="mf-container" id="app">
        <div class="mf-header">
            <h1>My Files</h1>
            <button class="mf-upload-btn" @click="showUpload = true"><i class="fas fa-cloud-upload-alt"></i> Upload</button>
        </div>

        <div v-if="files.length === 0" class="empty-state">
            <i class="fas fa-folder-open"></i>
            <h3>No files yet</h3>
            <p>Upload PDF, PPTX, or DOCX files to view them here.</p>
        </div>

        <div class="file-grid">
            <div v-for="f in files" :key="f.id" class="file-card">
                <div class="fi-icon" :style="{ background: iconBg(f.mime_type), color: iconColor(f.mime_type) }">
                    <i :class="iconClass(f.mime_type)"></i>
                </div>
                <div class="fi-body">
                    <div class="fi-name">{{ f.display_name }}</div>
                    <div class="fi-meta">{{ fileSize(f.file_size) }} &middot; {{ timeAgo(f.created_at) }}</div>
                </div>
                <div class="fi-actions">
                    <button class="view-btn" @click="viewFile(f)"><i class="fas fa-eye"></i></button>
                    <button class="del-btn" @click="deleteFile(f)"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>

        <div v-if="showUpload" class="upload-modal-overlay" @click.self="showUpload = false">
            <div class="upload-modal">
                <h2>Upload File</h2>
                <p>PDF, PPTX, DOCX up to 50MB</p>
                <input type="text" class="form-input" placeholder="Display name (optional)" v-model="uploadName" style="padding:12px 14px;border-radius:12px;border:1px solid #e2e8f0;width:calc(100% - 28px);font-size:0.82rem;">
                <div class="file-drop" @click="pickFile">
                    <i class="fas fa-file-upload"></i>
                    <p v-if="!selectedFile">Tap to choose a file</p>
                    <p class="fd-name" v-if="selectedFile">{{ selectedFile.name }}</p>
                </div>
                <input type="file" ref="fileInput" accept=".pdf,.pptx,.ppt,.docx,.doc" style="display:none" @change="onFileChange">
                <div class="modal-actions">
                    <button class="cancel" @click="showUpload = false">Cancel</button>
                    <button class="upload-submit" :disabled="uploading || !selectedFile" @click="doUpload">{{ uploading ? 'Uploading...' : 'Upload' }}</button>
                </div>
            </div>
        </div>

        <div v-if="viewerFile" class="viewer-overlay" @click.self="viewerFile = null">
            <div class="viewer-header">
                <h3>{{ viewerFile.display_name }}</h3>
                <button @click="viewerFile = null"><i class="fas fa-times"></i></button>
            </div>
            <div class="viewer-body">
                <embed v-if="viewerFile.mime_type === 'application/pdf'" :src="viewerFile.file_path" type="application/pdf">
                <iframe v-else-if="viewerFile.file_path.match(/\.(pptx?|docx?)$/i)" :src="'https://docs.google.com/gview?url=' + encodeURIComponent(window.location.origin + viewerFile.file_path) + '&embedded=true'" frameborder="0"></iframe>
                <div v-else class="no-preview">
                    <i class="fas fa-file"></i>
                    <p>Preview not available</p>
                    <a :href="viewerFile.file_path" target="_blank" style="display:inline-flex;align-items:center;gap:6px;padding:10px 20px;background:var(--brand);color:white;border-radius:12px;text-decoration:none;font-weight:700;font-size:0.82rem;"><i class="fas fa-download"></i> Download</a>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('partials/bottom-nav') %>
<script src="https://cdn.jsdelivr.net/npm/vue@2.7.14/dist/vue.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
new Vue({
    el: '#app',
    data: {
        files: <%- JSON.stringify(files || []) %>,
        showUpload: false,
        uploadName: '',
        selectedFile: null,
        uploading: false,
        viewerFile: null,
        window: window
    },
    methods: {
        iconBg(mime) {
            if (!mime) return '#f1f5f9';
            if (mime.includes('pdf')) return '#fee2e2';
            if (mime.includes('presentation') || mime.includes('pptx')) return '#fef3c7';
            return '#dbeafe';
        },
        iconColor(mime) {
            if (!mime) return '#64748b';
            if (mime.includes('pdf')) return '#ef4444';
            if (mime.includes('presentation') || mime.includes('pptx')) return '#f59e0b';
            return '#0284c7';
        },
        iconClass(mime) {
            if (!mime) return 'fas fa-file';
            if (mime.includes('pdf')) return 'fas fa-file-pdf';
            if (mime.includes('presentation') || mime.includes('pptx')) return 'fas fa-file-powerpoint';
            return 'fas fa-file-word';
        },
        fileSize(bytes) {
            if (!bytes) return '';
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024*1024) return (bytes/1024).toFixed(1) + ' KB';
            return (bytes/(1024*1024)).toFixed(1) + ' MB';
        },
        timeAgo(d) {
            const sec = (new Date() - new Date(d)) / 1000;
            if (sec < 60) return 'just now';
            if (sec < 3600) return Math.floor(sec/60) + 'm ago';
            if (sec < 86400) return Math.floor(sec/3600) + 'h ago';
            return Math.floor(sec/86400) + 'd ago';
        },
        pickFile() { this.$refs.fileInput.click(); },
        onFileChange(e) { this.selectedFile = e.target.files[0] || null; },
        async doUpload() {
            if (!this.selectedFile) return;
            this.uploading = true;
            const fd = new FormData();
            fd.append('file', this.selectedFile);
            fd.append('name', this.uploadName || this.selectedFile.name);
            const r = await fetch('/api/files/upload', { method: 'POST', body: fd });
            const d = await r.json();
            this.uploading = false;
            if (d.error) { Swal.fire({ icon: 'error', title: 'Error', text: d.error }); return; }
            this.files.unshift({ id: d.id, display_name: this.uploadName || this.selectedFile.name, file_path: d.url, mime_type: this.selectedFile.type, file_size: this.selectedFile.size, created_at: new Date().toISOString() });
            this.showUpload = false;
            this.uploadName = '';
            this.selectedFile = null;
            Swal.fire({ icon: 'success', title: 'Uploaded!', timer: 1500, showConfirmButton: false });
        },
        viewFile(f) { this.viewerFile = f; },
        async deleteFile(f) {
            const c = await Swal.fire({ title: 'Delete?', text: f.display_name, icon: 'warning', showCancelButton: true, confirmButtonText: 'Delete' });
            if (!c.isConfirmed) return;
            const r = await fetch('/api/files/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: f.id }) });
            const d = await r.json();
            if (d.error) { Swal.fire({ icon: 'error', text: d.error }); return; }
            this.files = this.files.filter(x => x.id !== f.id);
            Swal.fire({ icon: 'success', title: 'Deleted', timer: 1000, showConfirmButton: false });
        }
    }
});
</script>
</body>
</html>