<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Recover Account | Prepium</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand: #0062ff;
            --brand-soft: #eef4ff;
            --text-dark: #0a0c10;
            --text-muted: #5f6672;
            --surface: #ffffff;
            --bg-light: #f4f7fa;
            --border: #edf2f7;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

        body {
            background-color: var(--bg-light);
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .auth-container {
            width: 90%;
            max-width: 400px;
            background: var(--surface);
            padding: 2.5rem 2rem;
            border-radius: 32px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.04);
            text-align: center;
        }

        .logo-box {
            background: var(--brand);
            color: white;
            width: 45px;
            height: 45px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1.2rem;
            margin: 0 auto 1.5rem;
        }

        h2 {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text-dark);
            margin: 0 0 10px;
            letter-spacing: -0.5px;
        }

        p {
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.5;
            margin-bottom: 2rem;
        }

        .form-group {
            text-align: left;
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            font-size: 0.8rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text-dark);
            padding-left: 4px;
        }

        input {
            width: 100%;
            padding: 1.1rem;
            border-radius: 16px;
            border: 1px solid var(--border);
            background: #f8fafc;
            font-family: inherit;
            font-size: 0.95rem;
            transition: 0.3s;
        }

        input:focus {
            border-color: var(--brand);
            background: white;
            box-shadow: 0 0 0 4px rgba(0, 98, 255, 0.1);
            outline: none;
        }

        .btn {
            width: 100%;
            padding: 1.1rem;
            background: var(--brand);
            color: white;
            border: none;
            border-radius: 18px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(0, 98, 255, 0.2);
            transition: 0.3s;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(0, 98, 255, 0.3);
        }

        .footer-links {
            margin-top: 1.5rem;
            font-size: 0.85rem;
        }

        .footer-links a {
            color: var(--brand);
            text-decoration: none;
            font-weight: 700;
        }
    </style>
</head>
<body>

    <div class="auth-container">
        <div class="logo-box">P</div>
        <h2>Forgot Password?</h2>
        <p>Enter your email address and we'll send you a link to reset your password.</p>

        <form action="/forgot-password" method="POST">
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" placeholder="e.g. alite@ui.edu.ng" required>
            </div>
            
            <button type="submit" class="btn">Send Reset Link</button>
        </form>

        <div class="footer-links">
            <span style="color: var(--text-muted)">Remembered?</span> 
            <a href="/login">Back to Login</a>
        </div>
    </div>

</body>
</html>