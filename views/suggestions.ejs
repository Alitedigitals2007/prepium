<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Support</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="manifest" href="/manifest.json">

    <style>
        .app-shell { 
            display: flex; flex-direction: column;
        }

        /* Header */
        .chat-header {
            padding: 2.5rem 1.5rem 1.2rem;
            background: white;
            border-bottom: 1px solid var(--border);
        }
        .chat-header h1 { font-size: 1.4rem; font-weight: 800; margin: 0; letter-spacing: -0.5px; }
        .chat-header p { font-size: 0.75rem; font-weight: 700; color: var(--brand); text-transform: uppercase; margin: 4px 0 0; }

        .content-scroll { flex: 1; padding: 1.5rem; overflow-y: auto; }

        /* Thread List Styling */
        .thread-card {
            display: flex; align-items: center; justify-content: space-between;
            padding: 18px; background: var(--surface); border-radius: 22px;
            margin-bottom: 12px; text-decoration: none; border: 1px solid transparent;
        }
        .thread-card:active { transform: scale(0.98); background: var(--bg); }
        
        .thread-info-box { display: flex; align-items: center; gap: 12px; }
        .unread-dot { width: 10px; height: 10px; background: var(--brand); border-radius: 50%; box-shadow: 0 0 10px rgba(37,99,235,0.5); }
        
        .thread-title { font-size: 0.9rem; font-weight: 700; color: var(--text-dark); margin: 0; }
        .thread-date { font-size: 0.7rem; color: var(--text-sub); font-weight: 600; }

        .status-pill { font-size: 0.6rem; font-weight: 800; padding: 5px 10px; border-radius: 8px; text-transform: uppercase; }
        .status-pill.Open { background: var(--success-soft); color: var(--success); }
        .status-pill.Closed { background: #f1f5f9; color: var(--text-sub); }

        /* Active Chat View */
        .chat-container { display: flex; flex-direction: column; height: 100%; }
        .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--brand); text-decoration: none; font-size: 0.85rem; font-weight: 700; margin-bottom: 1.5rem; }

        .messages-window { 
            background: var(--surface); border: 1px solid var(--border); 
            border-radius: 28px; padding: 20px; display: flex; 
            flex-direction: column; gap: 12px; max-height: 400px; overflow-y: auto;
            margin-bottom: 1.5rem;
        }

        .bubble { max-width: 85%; padding: 14px 18px; border-radius: 20px; font-size: 0.88rem; font-weight: 600; line-height: 1.5; }
        .bubble.user { align-self: flex-end; background: var(--brand-gradient); color: white; border-bottom-right-radius: 4px; box-shadow: 0 4px 12px rgba(37,99,235,0.15); }
        .bubble.admin { align-self: flex-start; background: white; border: 1px solid var(--border); color: var(--text-dark); border-bottom-left-radius: 4px; }
        
        .time { font-size: 0.6rem; display: block; margin-top: 6px; opacity: 0.7; }

        /* Input Form */
        .input-bar { display: flex; gap: 10px; background: var(--surface); border: 1px solid var(--border); padding: 8px; border-radius: 20px; align-items: center; }
        .input-bar input { flex: 1; border: none; background: transparent; padding: 10px; font-family: inherit; font-weight: 600; font-size: 0.9rem; }
        .input-bar input:focus { outline: none; }
        .send-pill { background: var(--brand); color: white; border: none; padding: 10px 20px; border-radius: 14px; font-weight: 800; font-size: 0.8rem; cursor: pointer; }

        /* New Thread Form */
        .composer-card { background: var(--surface-solid); border: 1px solid var(--border); border-radius: 28px; padding: 20px; margin-bottom: 2rem; box-shadow: var(--shadow-md); }
        .form-label { display: block; font-size: 0.7rem; font-weight: 800; color: var(--text-sub); text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.5px; }
        .input-field { width: 100%; background: var(--bg); border: 1px solid var(--border); border-radius: 16px; padding: 14px; font-family: inherit; font-weight: 600; margin-bottom: 15px; }
        .input-field:focus { border-color: var(--brand); outline: none; background: var(--surface-solid); }

    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/sidebar') %>

    <div class="app-shell">
        <header class="chat-header">
            <h1><%= currentThread ? 'Discussion' : 'Support Chat' %></h1>
            <p><%= currentThread ? currentThread.title : 'Direct Messaging' %></p>
        </header>

        <div class="content-scroll">
            <% if (currentThread) { %>
                <div class="chat-container">
                    <a href="/suggestions" class="back-link">
                        <i class="fas fa-arrow-left"></i> All Topics
                    </a>
                    
                    <div class="messages-window">
                        <% activeMessages.forEach(msg => { %>
                            <div class="bubble <%= msg.sender_role.toLowerCase() %>">
                                <%= msg.message %>
                                <span class="time"><%= new Date(msg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                            </div>
                        <% }) %>
                    </div>

                    <% if (currentThread.status === 'Open') { %>
                        <form action="/suggestions/reply" method="POST" class="input-bar">
                            <input type="hidden" name="thread_id" value="<%= currentThread.id %>">
                            <input type="text" name="message" placeholder="Type your reply..." autocomplete="off" required>
                            <button type="submit" class="send-pill">Send</button>
                        </form>
                    <% } else { %>
                        <div style="text-align: center; color: var(--text-sub); font-size: 0.8rem; font-weight: 700; padding: 10px;">
                            <i class="fas fa-lock"></i> Topic closed by administrator
                        </div>
                    <% } %>
                </div>

            <% } else { %>
                <div class="composer-card">
                    <form action="/suggestions/new" method="POST">
                        <label class="form-label">Issue Topic</label>
                        <input type="text" name="title" class="input-field" placeholder="E.g. Error in Chemistry Module" required>
                        
                        <label class="form-label">Details</label>
                        <textarea name="message" class="input-field" rows="3" placeholder="Tell us more..." required></textarea>
                        
                        <button type="submit" class="send-pill" style="width:100%; padding: 16px;">Start Conversation</button>
                    </form>
                </div>

                <label class="form-label" style="margin-bottom: 15px; display: block;">Past Discussions</label>
                
                <% if (threads && threads.length > 0) { %>
                    <% threads.forEach(t => { %>
                        <a href="/suggestions?threadId=<%= t.id %>" class="thread-card">
                            <div class="thread-info-box">
                                <% if (t.has_unread) { %> <div class="unread-dot"></div> <% } %>
                                <div>
                                    <h4 class="thread-title"><%= t.title %></h4>
                                    <span class="thread-date"><%= new Date(t.created_at).toLocaleDateString() %></span>
                                </div>
                            </div>
                            <span class="status-pill <%= t.status %>"><%= t.status %></span>
                        </a>
                    <% }) %>
                <% } else { %>
                    <div style="text-align: center; padding: 40px 0; color: var(--text-sub);">
                        <p style="font-weight: 700;">No support threads found.</p>
                    </div>
                <% } %>
            <% } %>
        </div>

        <%- include('partials/bottom-nav', { activeNav: 'profile' }) %>
    </div>

</body>
</html>