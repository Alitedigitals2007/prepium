<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Support Chat</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { --brand: #0062ff; --bg: #f8fafc; --text: #0f172a; --sub: #64748b; }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; outline: none; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); margin: 0; padding: 0; color: var(--text); display: flex; justify-content: center; }
        .app-shell { width: 100%; max-width: 430px; background: white; min-height: 100vh; position: relative; box-shadow: 0 0 60px rgba(0,0,0,0.05); padding-bottom: 95px; display: flex; flex-direction: column; }
        
        .header-main { padding: 1.8rem 1.5rem 1.2rem; background: linear-gradient(180deg, #f0f7ff 0%, #ffffff 100%); border-bottom: 1px solid #f1f5f9; }
        .welcome-msg h1 { margin: 0; font-size: 1.35rem; font-weight: 800; letter-spacing: -0.5px; }
        .brand-subtitle { font-size: 0.72rem; font-weight: 700; color: var(--brand); text-transform: uppercase; margin-top: 3px; display: block; }
        
        .chat-shell { flex: 1; padding: 1.2rem; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; }
        
        /* Thread item styling with notification dot integration */
        .thread-item { 
            background: #fafafa; 
            border: 1px solid #f1f5f9; 
            border-radius: 18px; 
            padding: 1.1rem; 
            margin-bottom: 10px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            text-decoration: none; 
            color: inherit; 
            position: relative;
            transition: all 0.2s ease;
        }
        .thread-item:hover { border-color: #e2e8f0; background: #f8fafc; }
        
        .thread-left { display: flex; align-items: center; gap: 12px; }
        .thread-title { font-size: 0.88rem; font-weight: 800; color: var(--text); margin: 0; }
        .thread-meta { font-size: 0.72rem; color: var(--sub); display: block; margin-top: 2px; }
        
        /* Dot indicating new admin reply */
        .unread-indicator { 
            width: 8px; 
            height: 8px; 
            background-color: var(--brand); 
            border-radius: 50%; 
            display: inline-block; 
            box-shadow: 0 0 8px rgba(0, 98, 255, 0.6);
        }
        
        .badge { font-size: 0.6rem; font-weight: 800; padding: 4px 10px; border-radius: 6px; text-transform: uppercase; letter-spacing: 0.2px; }
        .Open { background: #d1fae5; color: #065f46; }
        .Closed { background: #f1f5f9; color: #64748b; }

        /* Inline Message Bubble Interface */
        .chat-wrapper { flex: 1; display: flex; flex-direction: column; height: 100%; }
        .chat-area { flex: 1; padding: 1.2rem; background: #fcfcfc; border-radius: 20px; border: 1px solid #f1f5f9; display: flex; flex-direction: column; gap: 10px; margin-bottom: 1rem; max-height: 420px; overflow-y: auto; }
        
        .bubble { max-width: 80%; padding: 12px 16px; border-radius: 16px; font-size: 0.85rem; line-height: 1.45; font-weight: 600; }
        .bubble.user { background: var(--brand); color: white; align-self: flex-end; border-bottom-right-radius: 4px; }
        .bubble.admin { background: #f1f5f9; color: var(--text); align-self: flex-start; border-bottom-left-radius: 4px; }
        .timestamp { font-size: 0.6rem; display: block; margin-top: 5px; opacity: 0.75; text-align: right; }
        .bubble.admin .timestamp { color: var(--sub); text-align: left; }

        .chat-input-form { display: flex; gap: 8px; background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 6px; align-items: center; }
        .chat-input { flex: 1; border: none; font-size: 0.85rem; padding: 10px 12px; font-family: inherit; font-weight: 600; color: var(--text); background: transparent; }
        .send-btn { background: var(--brand); border: none; color: white; border-radius: 12px; font-size: 0.8rem; font-weight: 800; padding: 10px 16px; cursor: pointer; }

        /* Compose Thread Form */
        .form-card { background: white; border: 1px solid #e2e8f0; border-radius: 24px; padding: 1.2rem; margin-bottom: 1.5rem; }
        .form-group { margin-bottom: 12px; }
        .form-group label { display: block; font-size: 0.75rem; font-weight: 800; color: var(--text); margin-bottom: 6px; text-transform: uppercase; }
        .form-control { width: 100%; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px; font-family: inherit; font-size: 0.85rem; font-weight: 600; background: #f8fafc; transition: border 0.2s; }
        .form-control:focus { border-color: var(--brand); background: white; }

        .nav-bar { position: fixed; bottom: 0; width: 100%; max-width: 430px; background: rgba(255,255,255,0.98); backdrop-filter: blur(8px); height: 85px; display: flex; justify-content: space-around; align-items: center; border-top: 1px solid #f1f5f9; z-index: 1000; padding-bottom: 12px; }
        .nav-item { text-decoration: none; color: #94a3b8; font-size: 0.65rem; font-weight: 800; text-align: center; }
        .nav-item.active { color: var(--brand); }
        .nav-item i { display: block; font-size: 1.35rem; margin-bottom: 4px; font-style: normal; }
        .center-fab { width: 58px; height: 58px; background: var(--brand); border-radius: 20px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.8rem; transform: translateY(-22px); border: 5px solid white; box-shadow: 0 10px 20px rgba(0,98,255,0.3); text-decoration: none; }
    </style>
</head>
<body>
    <div class="app-shell">
        <header class="header-main">
            <div class="welcome-msg">
                <h1><%= currentThread ? 'Discussion' : 'Support Chat' %></h1>
                <span class="brand-subtitle"><%= currentThread ? currentThread.title : 'Direct Messaging' %></span>
            </div>
        </header>

        <div class="chat-shell">
            <% if (currentThread) { %>
                <div class="chat-wrapper">
                    <a href="/suggestions" style="color: var(--brand); font-size: 0.78rem; text-decoration: none; font-weight: 800; margin-bottom: 10px; display: block;">➔ View All Topics</a>
                    
                    <div class="chat-area">
                        <% activeMessages.forEach(msg => { %>
                            <div class="bubble <%= msg.sender_role.toLowerCase() %>">
                                <%= msg.message %>
                                <span class="timestamp"><%= new Date(msg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                            </div>
                        <% }) %>
                    </div>

                    <% if (currentThread.status === 'Open') { %>
                        <form action="/suggestions/reply" method="POST" class="chat-input-form">
                            <input type="hidden" name="thread_id" value="<%= currentThread.id %>">
                            <input type="text" name="message" class="chat-input" placeholder="Type a message reply text here..." autocomplete="off" required>
                            <button type="submit" class="send-btn">Send</button>
                        </form>
                    <% } else { %>
                        <div style="background: #f1f5f9; padding: 12px; border-radius: 12px; font-size: 0.75rem; text-align: center; color: #64748b; font-weight: 700;">
                            🔒 This discussion topic has been closed by an admin.
                        </div>
                    <% } %>
                </div>

            <% } else { %>
                <div class="form-card">
                    <form action="/suggestions/new" method="POST">
                        <div class="form-group">
                            <label>Topic Title</label>
                            <input type="text" name="title" class="form-control" required placeholder="E.g., Problem loading PHY 302 solutions">
                        </div>
                        <div class="form-group">
                            <label>Describe issue</label>
                            <textarea name="message" class="form-control" rows="3" required placeholder="Explain your feedback or question..."></textarea>
                        </div>
                        <button type="submit" class="send-btn" style="width: 100%; padding: 14px; border-radius: 14px;">Launch Discussion Thread ➔</button>
                    </form>
                </div>

                <h3 style="font-size: 0.95rem; font-weight: 800; margin: 0 0 10px 0;">All Discussion Threads</h3>
                <% if (threads && threads.length > 0) { %>
                    <% threads.forEach(t => { %>
                        <a href="/suggestions?threadId=<%= t.id %>" class="thread-item">
                            <div class="thread-left">
                                <% if (t.has_unread) { %>
                                    <span class="unread-indicator" title="New admin message"></span>
                                <% } %>
                                <div>
                                    <h4 class="thread-title"><%= t.title %></h4>
                                    <span class="thread-meta">Started on <%= new Date(t.created_at).toLocaleDateString() %></span>
                                </div>
                            </div>
                            <span class="badge <%= t.status %>"><%= t.status %></span>
                        </a>
                    <% }) %>
                <% } else { %>
                    <p style="text-align: center; color: var(--sub); font-size: 0.82rem; margin-top: 15px;">No active discussion threads yet.</p>
                <% } %>
            <% } %>
        </div>

        <nav class="nav-bar">
            <a href="/dashboard" class="nav-item"><i>🏠</i>Home</a>
            <a href="/history" class="nav-item"><i>📊</i>Stats</a>
            <a href="/setup-test" class="center-fab">+</a>
            <a href="/notifications" class="nav-item"><i>🔔</i>Alerts</a>
            <a href="/profile" class="nav-item"><i>👤</i>Profile</a>
        </nav>
    </div>
</body>
</html>