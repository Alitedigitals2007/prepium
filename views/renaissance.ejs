<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        .app-shell { padding: 2rem 1.5rem 110px; }
        @media (min-width: 1024px) { .app-shell { padding-left: 1.5rem !important; } }
        .rnz-hero { background: linear-gradient(135deg, #7c3aed, #2563eb); border-radius: 24px; padding: 1.6rem 1.4rem; color: white; margin-bottom: 1.2rem; position: relative; overflow: hidden; }
        .rnz-hero h1 { font-weight: 800; font-size: 1.5rem; margin: 0 0 6px; }
        .rnz-hero p { font-size: 0.85rem; opacity: 0.9; margin: 0; font-weight: 600; }
        .rnz-hero .join-btn { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; background: #22c55e; color: white; padding: 10px 18px; border-radius: 12px; font-weight: 800; font-size: 0.82rem; text-decoration: none; }
        .exam-card { background: var(--card); border: 1px solid var(--border); border-radius: 20px; padding: 1.2rem; margin-bottom: 14px; }
        .exam-card .title { font-weight: 800; font-size: 1.05rem; }
        .exam-card .desc { font-size: 0.78rem; color: var(--text-secondary); font-weight: 600; margin-top: 4px; }
        .meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
        .meta .m { background: var(--surface-solid); border: 1px solid var(--border-solid); border-radius: 10px; padding: 6px 10px; font-size: 0.72rem; font-weight: 700; color: var(--text-secondary); }
        .status-badge { display: inline-block; padding: 4px 12px; border-radius: 10px; font-size: 0.7rem; font-weight: 800; }
        .st-open { background: var(--success-soft); color: var(--success); }
        .st-upcoming { background: var(--warning-soft); color: var(--warning); }
        .st-closed { background: var(--danger-soft); color: var(--danger); }
        .exam-actions { margin-top: 14px; }
        .btn-start { display: block; width: 100%; background: var(--brand); color: white; border: none; padding: 13px; border-radius: 14px; font-weight: 800; font-size: 0.92rem; cursor: pointer; font-family: inherit; text-decoration: none; text-align: center; }
        .btn-locked { display: block; width: 100%; background: var(--surface-solid); color: var(--text-muted); border: 1px solid var(--border-solid); padding: 13px; border-radius: 14px; font-weight: 800; font-size: 0.92rem; cursor: not-allowed; font-family: inherit; text-align: center; }
        .btn-result { display: block; width: 100%; background: var(--success-soft); color: var(--success); border: 1px solid var(--success-soft); padding: 13px; border-radius: 14px; font-weight: 800; font-size: 0.92rem; cursor: pointer; font-family: inherit; text-align: center; text-decoration: none; }
        .empty { text-align: center; color: var(--text-muted); font-weight: 700; padding: 40px 10px; font-size: 0.9rem; }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
    <div class="app-shell">
        <div class="rnz-hero">
            <h1>Renaissance Mock Exams</h1>
            <p>Sharpen your skills with timed mock exams built with full LaTeX questions.</p>
            <% if (groupLink) { %>
                <a class="join-btn" href="<%= groupLink %>" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i> Join Renaissance Group</a>
            <% } else { %>
                <a class="join-btn" href="https://wa.me/" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i> Join Renaissance Group</a>
            <% } %>
        </div>

        <% const now = new Date(); %>
        <% if (exams.length === 0) { %>
            <div class="empty">No exams have been published yet. Check back soon!</div>
        <% } %>

        <% exams.forEach(function(ex) { %>
            <% const opensAt = ex.opens_at ? new Date(ex.opens_at) : null; %>
            <% const closesAt = ex.closes_at ? new Date(ex.closes_at) : null; %>
            <% const isOpen = (!opensAt || opensAt <= now) && (!closesAt || closesAt > now); %>
            <% const isUpcoming = opensAt && opensAt > now; %>
            <div class="exam-card">
                <div>
                    <% if (isOpen) { %><span class="status-badge st-open">● Open</span><% } %>
                    <% if (isUpcoming) { %><span class="status-badge st-upcoming">● Opens <%= opensAt.toLocaleString([], { weekday:'short', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' }) %></span><% } %>
                    <% if (!isOpen && !isUpcoming) { %><span class="status-badge st-closed">● Closed</span><% } %>
                </div>
                <div class="title" style="margin-top:6px;"><%= ex.title %></div>
                <div class="desc"><%= ex.description %></div>
                <div class="meta">
                    <span class="m"><i class="fas fa-clock"></i> <%= ex.duration_minutes %> mins</span>
                    <span class="m"><i class="fas fa-list-ol"></i> <%= ex.question_count %> questions</span>
                    <% if (ex.show_results_immediately) { %>
                        <span class="m"><i class="fas fa-bolt"></i> Immediate results</span>
                    <% } else { %>
                        <span class="m"><i class="fas fa-hourglass-half"></i> Results released later</span>
                    <% } %>
                </div>
                <div class="exam-actions">
                    <% if (ex.max_attempts && ex.max_attempts > 0) { %>
                        <span class="m" style="display:block;margin-bottom:8px;"><i class="fas fa-hourglass-half"></i> <%= ex.my_attempts %>/<%= ex.max_attempts %> attempts used</span>
                    <% } %>
                    <% if (ex.my_attempt_list && ex.my_attempt_list.length) { %>
                        <div style="margin-bottom:10px;">
                            <div style="font-size:0.68rem;font-weight:800;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;"><i class="fas fa-trophy"></i> My Results</div>
                            <% ex.my_attempt_list.forEach(function(att, ai) { %>
                                <a class="btn-result" href="/renaissance/result/<%= att.id %>" style="margin-bottom:6px;">
                                    <i class="fas fa-trophy"></i> Attempt <%= ex.my_attempt_list.length - ai %> &middot; <%= att.score %>/<%= ex.question_count %> &middot; <%= att.percentage %>%
                                </a>
                            <% }); %>
                        </div>
                    <% } %>
                    <% if (isOpen) { %>
                        <% const trialsLeft = (ex.max_attempts && ex.max_attempts > 0) ? (ex.max_attempts - ex.my_attempts) : 9999; %>
                        <% if (trialsLeft <= 0) { %>
                            <div class="btn-locked"><i class="fas fa-lock"></i> Trial limit reached</div>
                        <% } else if (ex.my_attempts > 0) { %>
                            <a class="btn-start" href="/renaissance/exam/<%= ex.id %>"><i class="fas fa-rocket"></i> Retake</a>
                        <% } else { %>
                            <a class="btn-start" href="/renaissance/exam/<%= ex.id %>"><i class="fas fa-rocket"></i> Start Exam</a>
                        <% } %>
                    <% } else { %>
                        <div class="btn-locked"><i class="fas fa-lock"></i> <%= isUpcoming ? 'Not open yet' : 'Exam closed' %></div>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
    <div style="text-align:center;font-size:0.72rem;font-weight:700;color:var(--text-muted);margin:20px 0 8px;">
        <i class="fas fa-atom"></i> Powered by Renaissance &middot; Build #001
    </div>
    <%- include('partials/bottom-nav', { activeNav: 'renaissance' }) %>
    <script src="/js/animations.js"></script>
</body>
</html>