<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        body { 
            padding: 2rem 1rem; 
        }
        
        .container { max-width: 1200px; margin: 0 auto; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; }
        .logout { color: var(--danger); font-weight: 700; text-decoration: none; font-size: 0.9rem; }

        .page-title { font-size: 1.8rem; font-weight: 800; margin: 0 0 5px 0; }
        .page-subtitle { color: #64748b; margin-top: 0; margin-bottom: 2rem; }

        /* ADD AMBASSADOR FORM STYLE */
        .add-box { 
            background: var(--surface-solid); 
            padding: 1.5rem; 
            border-radius: 24px; 
            border: 1px solid var(--border); 
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03);
            margin-bottom: 2.5rem;
        }
        .add-box h2 { font-size: 1.1rem; font-weight: 800; margin: 0 0 1rem 0; }
        .form-row { display: flex; gap: 1rem; flex-wrap: wrap; }
        .form-group { flex: 1; min-width: 200px; }
        .btn-submit { background: var(--brand); color: white; border: none; padding: 0 1.5rem; height: 50px; border-radius: 12px; font-weight: 700; cursor: pointer; transition: 0.2s; align-self: flex-end; }
        .btn-submit:hover { background: var(--brand); transform: translateY(-1px); }

        .table-wrap { background: var(--surface-solid); border-radius: 24px; overflow: hidden; border: 1px solid var(--border); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03); }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th { background: var(--surface); padding: 1.2rem 1.5rem; font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; }
        td { padding: 1.2rem 1.5rem; border-top: 1px solid var(--border); font-size: 0.95rem; vertical-align: middle; }
        
        .amb-name { font-weight: 700; color: var(--text); display: block; }
        .amb-code { font-family: monospace; color: var(--brand); font-weight: 700; font-size: 0.9rem; background: var(--brand-soft); padding: 2px 6px; border-radius: 4px; }
        
        .val-earned { color: var(--text); font-weight: 700; }
        .val-withdrawn { color: #64748b; font-weight: 600; }
        .val-outstanding { color: var(--warning); font-weight: 800; background: var(--warning-soft); padding: 4px 8px; border-radius: 8px; }
        .val-settled { color: var(--success); font-weight: 800; background: var(--success-soft); padding: 4px 8px; border-radius: 8px; }

        .bank-box { font-size: 0.85rem; color: #475569; max-width: 220px; line-height: 1.4; word-wrap: break-word; }

        .btn-payout { background: var(--brand); color: white; border: none; padding: 0.6rem 1.2rem; border-radius: 12px; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: 0.2s; text-decoration: none; display: inline-block; }
        .btn-payout:hover { background: var(--brand); transform: translateY(-1px); }
        .disabled-btn { background: var(--border); color: #94a3b8; cursor: not-allowed; padding: 0.6rem 1.2rem; border-radius: 12px; font-weight: 700; font-size: 0.85rem; display: inline-block; }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>

    <div class="container">
        <header>
            <a href="/admin/dashboard" class="logo">Prepium Admin</a>
            <a href="/admin/logout" class="logout">Sign Out</a>
        </header>

        <h1 class="page-title">Ambassador Financial Console</h1>
        <p class="page-subtitle">Manage ambassador metrics, track outstanding balances, and mark payouts.</p>

        <div class="add-box">
            <h2>Add New Ambassador</h2>
            <form action="/admin/add-ambassador" method="POST" class="form-row">
                <div class="form-group">
                    <label>Ambassador Name</label>
                    <input type="text" name="name" placeholder="e.g. John Doe" required>
                </div>
                <div class="form-group">
                    <label>Unique Referral ID</label>
                    <input type="text" name="unique_code" placeholder="e.g. ALITE20" required>
                </div>
                <button type="submit" class="btn-submit">Add Profile</button>
            </form>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Ambassador</th>
                        <th>Unique Code</th>
                        <th>Total Referrals</th>
                        <th>Total Earned</th>
                        <th>Withdrawn</th>
                        <th>Outstanding</th>
                        <th>Payout Details</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (ambassadors && ambassadors.length > 0) { %>
                        <% ambassadors.forEach(amb => { %>
                            <tr>
                                <td>
                                    <span class="amb-name"><%= amb.name %></span>
                                </td>
                                <td>
                                    <span class="amb-code"><%= amb.unique_code %></span>
                                </td>
                                <td style="font-weight: 700; text-align: center;"><%= amb.total_referrals %></td>
                                <td><span class="val-earned">â‚¦<%= amb.total_earned %></span></td>
                                <td><span class="val-withdrawn">â‚¦<%= amb.total_withdrawn %></span></td>
                                <td>
                                    <% if (amb.outstanding > 0) { %>
                                        <span class="val-outstanding">â‚¦<%= amb.outstanding %></span>
                                    <% } else { %>
                                        <span class="val-settled">â‚¦0 (SETTLED)</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div class="bank-box"><%= amb.bank_details || 'No bank info saved.' %></div>
                                </td>
                                <td>
                                    <% if (amb.outstanding > 0) { %>
                                        <form action="/admin/payout-complete/<%= amb.id %>" method="POST" style="margin:0;">
                                            <button type="submit" class="btn-payout" onclick="return confirm('Mark this â‚¦<%= amb.outstanding %> payout as paid?')">Record Payout</button>
                                        </form>
                                    <% } else { %>
                                        <span class="disabled-btn">Paid Up</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 3rem; color: #94a3b8;">No ambassadors registered yet.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

<script src="/js/animations.js"></script>
</body>
</html>