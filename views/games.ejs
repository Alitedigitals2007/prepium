<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        .status-bar { height: env(safe-area-inset-top, 0px); }
        .page-content { padding: 0 1.5rem 1.5rem; }
        .game-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; padding: 1rem 0; }
        .game-card { background: var(--surface-solid); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; text-align: center; cursor: pointer; transition: all 0.18s ease; }
        .game-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(37,99,235,0.12); }
        .game-card i { font-size: 2rem; color: var(--brand); margin-bottom: 8px; display: block; }
        .game-card h3 { font-size: 0.9rem; font-weight: 800; margin: 0 0 4px; }
        .game-card p { font-size: 0.72rem; color: var(--text-sub); margin: 0; }
        .game-area { background: var(--surface-solid); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem; margin-top: 1rem; }
        .game-area h2 { font-size: 1.1rem; font-weight: 800; margin-bottom: 1rem; }
        .hidden { display: none; }
        @media (min-width: 431px) { .app-shell { border-left: 1px solid var(--glass-border); border-right: 1px solid var(--glass-border); margin: 0 auto; } }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="status-bar"></div>
    <div class="header-nav">
        <a href="/dashboard" class="back-circle"><i class="fas fa-arrow-left"></i></a>
        <div class="header-title">Games Hub</div>
        <%- include('partials/drawer-trigger') %>
    </div>
    <div class="page-content">
        <p style="font-size:0.8rem;color:var(--text-sub);font-weight:600;margin:0.5rem 0 1rem;">Fun, fast, academic mini-games. Pick one to play.</p>
        <div class="game-grid">
            <div class="game-card" onclick="openGame('sudoku')"><i class="fas fa-th"></i><h3>Sudoku</h3><p>Classic number puzzle</p></div>
            <div class="game-card" onclick="openGame('scramble')"><i class="fas fa-shuffle"></i><h3>Word Scramble</h3><p>Unscramble academic terms</p></div>
            <div class="game-card" onclick="openGame('crossword')"><i class="fas fa-border-all"></i><h3>Crossword</h3><p>Fill in the grid</p></div>
            <div class="game-card" onclick="openGame('chess')"><i class="fas fa-chess"></i><h3>Chess</h3><p>Play vs computer</p></div>
        </div>

        <div id="game-sudoku" class="game-area hidden">
            <h2>Sudoku</h2>
            <p style="font-size:0.8rem;color:var(--text-sub);margin-bottom:1rem;">Fill the 9x9 grid. (Simple puzzle)</p>
            <div id="sudokuBoard" style="display:grid;grid-template-columns:repeat(9,36px);gap:2px;justify-content:center;"></div>
            <div style="text-align:center;margin-top:1rem;"><button onclick="checkSudoku()" style="padding:10px 20px;border:none;background:var(--brand-gradient);color:white;border-radius:8px;font-weight:700;cursor:pointer;">Check</button></div>
        </div>

        <div id="game-scramble" class="game-area hidden">
            <h2>Word Scramble</h2>
            <p id="scrambleWord" style="font-size:1.5rem;font-weight:800;text-align:center;margin:1rem 0;letter-spacing:4px;"></p>
            <div style="text-align:center;"><input id="scrambleInput" placeholder="Your answer" style="padding:10px;border-radius:8px;border:1.5px solid var(--border);font-weight:600;"><button onclick="checkScramble()" style="padding:10px 16px;border:none;background:var(--brand-gradient);color:white;border-radius:8px;font-weight:700;cursor:pointer;margin-left:6px;">Check</button></div>
            <p id="scrambleMsg" style="text-align:center;margin-top:8px;font-weight:600;"></p>
        </div>

        <div id="game-crossword" class="game-area hidden">
            <h2>Crossword (Mini)</h2>
            <p style="font-size:0.8rem;color:var(--text-sub);">Clue: Capital of France? (5 letters)</p>
            <div style="text-align:center;margin-top:1rem;"><input id="crossInput" maxlength="5" style="padding:10px;border-radius:8px;border:1.5px solid var(--border);font-weight:600;text-transform:uppercase;letter-spacing:4px;"><button onclick="checkCross()" style="padding:10px 16px;border:none;background:var(--brand-gradient);color:white;border-radius:8px;font-weight:700;cursor:pointer;margin-left:6px;">Check</button></div>
            <p id="crossMsg" style="text-align:center;margin-top:8px;font-weight:600;"></p>
        </div>

        <div id="game-chess" class="game-area hidden">
            <h2>Chess</h2>
            <p style="font-size:0.8rem;color:var(--text-sub);margin-bottom:1rem;">Play against the computer.</p>
            <iframe src="https://www.chess.com/play/computer" style="width:100%;height:500px;border:none;border-radius:12px;" loading="lazy"></iframe>
        </div>
    </div>
    <%- include('partials/bottom-nav', { activeNav: 'study' }) %>
</div>
<script>
function openGame(name) {
    document.querySelectorAll('.game-area').forEach(function(el){ el.classList.add('hidden'); });
    document.getElementById('game-'+name).classList.remove('hidden');
    if (name === 'sudoku') initSudoku();
    if (name === 'scramble') newScramble();
}

// Sudoku
var sudokuSolution = [5,3,4,6,7,8,9,1,2,6,7,2,1,9,5,3,4,8,1,9,8,3,4,2,5,6,7,8,5,9,7,6,1,4,2,3,4,2,6,8,5,3,7,9,1,7,1,3,9,2,4,8,5,6,9,6,1,5,3,7,2,8,4,2,8,7,4,1,9,6,3,5,3,4,5,2,8,6,1,7,9];
function initSudoku() {
    var board = document.getElementById('sudokuBoard');
    board.innerHTML = '';
    for (var i=0;i<81;i++) {
        var inp = document.createElement('input');
        inp.style.cssText = 'width:36px;height:36px;text-align:center;font-weight:700;border:1px solid var(--border-solid);border-radius:4px;';
        inp.dataset.idx = i;
        if (i % 2 === 0) { inp.value = sudokuSolution[i]; inp.disabled = true; inp.style.background = 'var(--brand-soft)'; }
        board.appendChild(inp);
    }
}
function checkSudoku() {
    var inputs = document.querySelectorAll('#sudokuBoard input');
    var ok = true;
    inputs.forEach(function(inp){ if (parseInt(inp.value) !== sudokuSolution[parseInt(inp.dataset.idx)]) ok = false; });
    alert(ok ? 'Correct! 🎉' : 'Some cells are wrong. Try again.');
}

// Word Scramble
var words = ['CALCULUS','PHYSICS','BIOLOGY','CHEMISTRY','HISTORY','ECONOMICS','GEOGRAPHY','LITERATURE'];
var currentWord = '';
function scramble(w){ return w.split('').sort(function(){return 0.5-Math.random();}).join(''); }
function newScramble(){ currentWord = words[Math.floor(Math.random()*words.length)]; document.getElementById('scrambleWord').textContent = scramble(currentWord); document.getElementById('scrambleInput').value=''; document.getElementById('scrambleMsg').textContent=''; }
function checkScramble(){ var v = document.getElementById('scrambleInput').value.trim().toUpperCase(); var msg = document.getElementById('scrambleMsg'); if (v === currentWord){ msg.textContent='Correct! 🎉'; msg.style.color='var(--success)'; setTimeout(newScramble,1200);} else { msg.textContent='Try again.'; msg.style.color='var(--danger)'; } }

// Crossword
function checkCross(){ var v = document.getElementById('crossInput').value.trim().toUpperCase(); var msg = document.getElementById('crossMsg'); if (v === 'PARIS'){ msg.textContent='Correct! 🎉'; msg.style.color='var(--success)'; } else { msg.textContent='Try again.'; msg.style.color='var(--danger)'; } }
</script>
<%- include('partials/bottom-nav', { activeNav: 'study' }) %>
</div>
</body>
</html>
