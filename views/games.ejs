<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/chessboard.js/1.0.0/css/chessboard-1.0.0.min.css">
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="status-bar"></div>
    <div class="header-nav">
        <a href="/dashboard" class="back-circle"><i class="fas fa-arrow-left"></i></a>
        <div class="header-title">Games Hub</div>
    </div>
    <div class="page-content">
        <div class="stats-row" style="margin:0.5rem 0">
            <div class="stat-chip" style="flex:2;"><i class="fas fa-fire"></i><div class="num" id="sudokuWins">0</div><div class="lbl">Sudoku</div></div>
            <div class="stat-chip" style="flex:2;"><i class="fas fa-shuffle"></i><div class="num" id="scrambleWins">0</div><div class="lbl">Scramble</div></div>
            <div class="stat-chip" style="flex:2;"><i class="fas fa-chess"></i><div class="num" id="chessWins">0</div><div class="lbl">Chess</div></div>
        </div>

        <div class="game-grid">
            <a href="/games/sudoku" class="game-card" style="background:linear-gradient(135deg,#2563eb,#1d4ed8);color:white;"><i class="fas fa-th"></i><h3>Sudoku</h3><p>Easier puzzle</p></a>
            <a href="/games/scramble" class="game-card" style="background:linear-gradient(135deg,#059669,#047857);color:white;"><i class="fas fa-shuffle"></i><h3>Word Scramble</h3><p>Academic terms</p></a>
            <a href="/games/crossword" class="game-card" style="background:linear-gradient(135deg,#dc2626,#b91c1c);color:white;"><i class="fas fa-border-all"></i><h3>Crossword</h3><p>Quick quiz</p></a>
            <a href="/games/chess" class="game-card" style="background:linear-gradient(135deg,#7c3aed,#6d28c9);color:white;"><i class="fas fa-chess"></i><h3>Chess</h3><p>Play now</p></a>
        </div>

        <div style="margin:1rem 0;display:flex;gap:8px;align-items:center">
            <span style="font-weight:700">Friends Online:</span>
            <span id="friendsOnline" style="color:var(--success);font-weight:600">0</span>
        </div>
    </div>
    <%- include('partials/bottom-nav', { activeNav: 'study' }) %>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chessboard.js/1.0.0/js/chessboard-1.0.0.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
// Stats loaded from localStorage
document.getElementById('sudokuWins').textContent = localStorage.getItem('sudokuWins')||0;
document.getElementById('scrambleWins').textContent = localStorage.getItem('scrambleWins')||0;
document.getElementById('chessWins').textContent = localStorage.getItem('chessWins')||0;
</script>
</body>
</html>
