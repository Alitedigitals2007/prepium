<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prepium Admin | Edit <%= subject.name %></title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { 
            --brand: #0062ff; 
            --bg: #f4f7fe; 
            --text-main: #1b2559;
            --text-muted: #a3aed0;
            --border: #e0e5f2;
        }

        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: var(--bg); 
            height: 100vh; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            margin: 0; 
            color: var(--text-main);
        }

        .edit-card { 
            background: white; 
            padding: 40px; 
            border-radius: 32px; 
            width: 100%;
            max-width: 450px; 
            box-shadow: 0 20px 50px rgba(0,0,0,0.04); 
            border: 1px solid #fff;
        }

        h2 { 
            font-weight: 800; 
            font-size: 1.5rem; 
            margin-bottom: 8px; 
            letter-spacing: -0.5px;
        }

        p { 
            color: var(--text-muted); 
            font-size: 0.9rem; 
            margin-bottom: 30px; 
            font-weight: 600;
        }

        .form-group { margin-bottom: 20px; }

        label { 
            font-size: 0.75rem; 
            font-weight: 800; 
            color: var(--text-muted); 
            text-transform: uppercase; 
            display: block; 
            margin-bottom: 8px;
            margin-left: 4px;
        }

        input { 
            width: 100%; 
            padding: 16px; 
            background: #f4f7fe;
            border: 1px solid var(--border); 
            border-radius: 16px; 
            box-sizing: border-box; 
            font-family: inherit;
            font-weight: 600;
            color: var(--text-main);
            transition: 0.2s;
        }

        input:focus { 
            outline: none; 
            border-color: var(--brand); 
            background: white; 
            box-shadow: 0 0 0 4px rgba(0, 98, 255, 0.1);
        }

        .btn { 
            width: 100%; 
            background: var(--brand); 
            color: white; 
            border: none; 
            padding: 18px; 
            border-radius: 18px; 
            font-weight: 800; 
            cursor: pointer; 
            font-size: 1rem;
            box-shadow: 0 10px 20px rgba(0, 98, 255, 0.2);
            transition: 0.3s;
            margin-top: 10px;
        }

        .btn:hover { transform: translateY(-2px); box-shadow: 0 12px 25px rgba(0, 98, 255, 0.3); }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 700;
            font-size: 0.85rem;
        }

        .back-link:hover { color: var(--brand); }
    </style>
</head>
<body>
    <div class="edit-card">
        <h2>Edit Subject</h2>
        <p>Update details for <%= subject.name %> at Prepium</p>
        
        <form action="/admin/subjects/update/<%= subject.id %>" method="POST">
            <div class="form-group">
                <label>Course Title</label>
                <input type="text" name="name" value="<%= subject.name %>" placeholder="e.g. PHY 301" required>
            </div>

            <div class="form-group">
                <label>Level / Category</label>
                <input type="text" name="category" value="<%= subject.category %>" placeholder="e.g. 300 Level" required>
            </div>

            <div class="form-group">
                <label>Google Drive Resource Link</label>
                <input type="url" name="drive_link" value="<%= subject.drive_link || '' %>" placeholder="https://drive.google.com/...">
            </div>

            <button type="submit" class="btn">Save Changes</button>
        </form>

        <a href="/admin/subjects" class="back-link">← Back to Subjects</a>
    </div>
<script src="/js/animations.js"></script>
</body>
</html>