<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Subject</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f8fafc; height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; }
        .edit-box { background: white; padding: 40px; border-radius: 30px; width: 400px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
        input { width: 100%; padding: 12px; margin: 10px 0 20px; border: 1px solid #ddd; border-radius: 12px; box-sizing: border-box; }
        .btn { width: 100%; background: #0062ff; color: white; border: none; padding: 15px; border-radius: 12px; font-weight: 800; cursor: pointer; }
    </style>
</head>
<body>
    <div class="edit-box">
        <h2>Edit Subject</h2>
        <form action="/admin/subjects/update/<%= subject.id %>" method="POST">
            <label>Name</label>
            <input type="text" name="name" value="<%= subject.name %>" required>
            <label>Category</label>
            <input type="text" name="category" value="<%= subject.category %>" required>
            <button type="submit" class="btn">Update Subject</button>
        </form>
    </div>
</body>
</html>