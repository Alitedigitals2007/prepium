<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --sidebar-bg: #0b1437;
            --sidebar-width: 260px;
            --card-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            color: var(--text);
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ===================== SIDEBAR ===================== */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--sidebar-bg);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 200;
            display: flex;
            flex-direction: column;
            padding: 32px 20px;
            transition: transform 0.3s ease;
        }

        .logo {
            font-size: 1.4rem;
            font-weight: 800;
            color: #fff;
            text-decoration: none;
            letter-spacing: 1px;
            margin-bottom: 44px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            width: 34px;
            height: 34px;
            background: var(--brand);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            color: #fff;
        }

        .nav-section {
            margin-bottom: 8px;
        }

        .nav-label {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255, 255, 255, 0.3);
            padding: 0 14px;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .nav-link {
            text-decoration: none;
            color: rgba(255, 255, 255, 0.45);
            font-weight: 600;
            font-size: 0.88rem;
            padding: 12px 14px;
            border-radius: 12px;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.2s ease;
        }

        .nav-link i {
            width: 20px;
            text-align: center;
            font-size: 0.95rem;
        }

        .nav-link:hover {
            background: rgba(255, 255, 255, 0.07);
            color: rgba(255, 255, 255, 0.9);
        }

        .nav-link.active {
            background: var(--brand);
            color: #fff;
            box-shadow: 0 4px 16px rgba(0, 98, 255, 0.4);
        }

        .sidebar-footer {
            margin-top: auto;
        }

        .nav-link.logout {
            color: #ff6b6b;
        }

        .nav-link.logout:hover {
            background: rgba(255, 107, 107, 0.1);
            color: #ff6b6b;
        }

        .hamburger {
            display: none;
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 300;
            background: var(--sidebar-bg);
            color: #fff;
            border: none;
            width: 44px;
            height: 44px;
            border-radius: 12px;
            font-size: 1.2rem;
            cursor: pointer;
            align-items: center;
            justify-content: center;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.4);
            z-index: 150;
        }

        /* ===================== MAIN CONTENT ===================== */
        .main-content {
            margin-left: var(--sidebar-width);
            width: calc(100% - var(--sidebar-width));
            min-height: 100vh;
        }

        /* ===================== HEADER ===================== */
        .header {
            background: var(--surface);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            padding: 18px 40px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-left .breadcrumb {
            font-size: 0.75rem;
            color: var(--text-muted);
            font-weight: 600;
            margin-bottom: 4px;
        }

        .header-left h2 {
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--text);
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .admin-badge {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--brand-light);
            padding: 8px 16px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 0.85rem;
            color: var(--brand);
        }

        .admin-badge i {
            font-size: 1rem;
        }

        /* ===================== CONTAINER ===================== */
        .container {
            padding: 36px 40px;
            max-width: 1100px;
            margin: 0 auto;
        }

        /* ===================== GLASSMORPHISM CARD ===================== */
        .card {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: var(--card-shadow);
            margin-bottom: 28px;
            overflow: hidden;
        }

        .card-header {
            padding: 24px 28px 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .card-header-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .card-header-icon.blue {
            background: var(--brand-light);
            color: var(--brand);
        }

        .card-header-icon.orange {
            background: rgba(255, 159, 67, 0.1);
            color: #ff9f43;
        }

        .card-header h3 {
            font-size: 1.05rem;
            font-weight: 800;
        }

        .card-body {
            padding: 24px 28px 28px;
        }

        /* ===================== BROADCAST FORM ===================== */
        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-muted);
            margin-bottom: 8px;
        }

        .form-input {
            width: 100%;
            padding: 14px 18px;
            border: 1.5px solid var(--border);
            border-radius: 14px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 600;
            font-size: 0.92rem;
            background: var(--surface);
            color: var(--text);
            transition: border-color 0.2s, box-shadow 0.2s;
            outline: none;
        }

        .form-input:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 3px var(--brand-glow);
        }

        .form-input::placeholder {
            color: #b0b9d1;
            font-weight: 500;
        }

        textarea.form-input {
            resize: vertical;
            min-height: 110px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 32px;
            border: none;
            border-radius: 14px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-weight: 800;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-primary {
            background: var(--brand);
            color: #fff;
            box-shadow: 0 4px 16px rgba(0, 98, 255, 0.3);
        }

        .btn-primary:hover {
            background: #0052cc;
            box-shadow: 0 6px 24px rgba(0, 98, 255, 0.4);
            transform: translateY(-1px);
        }

        /* ===================== NOTIFICATION HISTORY ===================== */
        .notif-list {
            list-style: none;
        }

        .notif-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 22px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            margin-bottom: 12px;
            transition: transform 0.15s, box-shadow 0.15s;
        }

        .notif-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
        }

        .notif-left {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            flex: 1;
            min-width: 0;
        }

        .notif-dot {
            width: 10px;
            height: 10px;
            min-width: 10px;
            border-radius: 50%;
            background: var(--brand);
            margin-top: 6px;
            box-shadow: 0 0 0 3px var(--brand-light);
        }

        .notif-content {
            min-width: 0;
        }

        .notif-title {
            font-weight: 800;
            font-size: 0.95rem;
            margin-bottom: 3px;
            color: var(--text);
        }

        .notif-message {
            font-size: 0.85rem;
            color: var(--text-muted);
            font-weight: 500;
            line-height: 1.5;
        }

        .notif-date {
            font-size: 0.78rem;
            color: var(--text-muted);
            font-weight: 700;
            white-space: nowrap;
            margin-left: 16px;
            margin-top: 4px;
        }

        .notif-empty {
            text-align: center;
            padding: 48px 20px;
            color: var(--text-muted);
        }

        .notif-empty i {
            font-size: 2.4rem;
            margin-bottom: 14px;
            display: block;
            color: #c5ceed;
        }

        .notif-empty p {
            font-weight: 600;
            font-size: 0.95rem;
        }

        /* ===================== RESPONSIVE ===================== */
        @media (max-width: 900px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .sidebar-overlay.open {
                display: block;
            }

            .hamburger {
                display: flex;
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }

            .header {
                padding: 18px 20px 18px 72px;
            }

            .container {
                padding: 24px 18px;
            }

            .card-body {
                padding: 20px;
            }

            .notif-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }

            .notif-date {
                margin-left: 0;
                margin-top: 0;
            }
        }

        @media (max-width: 480px) {
            .header-left h2 {
                font-size: 1.1rem;
            }

            .admin-badge span {
                display: none;
            }
        }
    </style>
<meta name="theme-color" content="#2563eb">
<%- include('../partials/theme-toggle') %>
</head>
<body>

    <!-- Hamburger for mobile -->
    <button class="hamburger" id="hamburger" aria-label="Open menu">
        <i class="fas fa-bars"></i>
    </button>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <a href="/admin/dashboard" class="logo">
            <div class="logo-icon"><i class="fas fa-graduation-cap"></i></div>
            PREPIUM
        </a>

        <div class="nav-section">
            <div class="nav-label">Main</div>
            <a href="/admin/dashboard" class="nav-link">
                <i class="fas fa-th-large"></i> Dashboard
            </a>
            <a href="/admin/analytics" class="nav-link">
                <i class="fas fa-chart-line"></i> Analytics
            </a>
        </div>

        <div class="nav-section">
            <div class="nav-label">Management</div>
            <a href="/admin/universities" class="nav-link">
                <i class="fas fa-university"></i> Universities
            </a>
            <a href="/admin/users" class="nav-link">
                <i class="fas fa-users"></i> Students
            </a>
        </div>

        <div class="nav-section">
            <div class="nav-label">Developer</div>
            <a href="/admin/db-manager" class="nav-link">
                <i class="fas fa-database"></i> DB Manager
            </a>
        </div>

        <div class="nav-section">
            <div class="nav-label">Communication</div>
            <a href="/admin/notifications" class="nav-link active">
                <i class="fas fa-bell"></i> Notifications
            </a>
        </div>

        <div class="sidebar-footer">
            <a href="/logout" class="nav-link logout">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </aside>

    <!-- Main -->
    <main class="main-content">

        <!-- Header -->
        <header class="header">
            <div class="header-left">
                <div class="breadcrumb">Admin / Communication</div>
                <h2>Notifications</h2>
            </div>
            <div class="header-right">
                <div class="admin-badge">
                    <i class="fas fa-user-shield"></i>
                    <span>Atilola Israel (Alite)</span>
                </div>
            </div>
        </header>

        <!-- Content -->
        <div class="container">

            <!-- Broadcast Form -->
            <div class="card">
                <div class="card-header">
                    <div class="card-header-icon blue">
                        <i class="fas fa-paper-plane"></i>
                    </div>
                    <h3>Broadcast Announcement</h3>
                </div>
                <div class="card-body">
                    <form action="/admin/notifications/send" method="POST">
                        <div class="form-group">
                            <label for="title">Notification Title</label>
                            <input
                                type="text"
                                id="title"
                                name="title"
                                class="form-input"
                                placeholder="e.g. New Mock Exam Available"
                                required
                            >
                        </div>
                        <div class="form-group">
                            <label for="message">Message</label>
                            <textarea
                                id="message"
                                name="message"
                                class="form-input"
                                rows="4"
                                placeholder="Type your message to students..."
                                required
                            ></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-paper-plane"></i>
                            Send to All Students
                        </button>
                    </form>
                </div>
            </div>

            <!-- Broadcast History -->
            <div class="card">
                <div class="card-header">
                    <div class="card-header-icon orange">
                        <i class="fas fa-history"></i>
                    </div>
                    <h3>Broadcast History</h3>
                </div>
                <div class="card-body">
                    <% if (notifications && notifications.length > 0) { %>
                        <div class="notif-list">
                            <% notifications.forEach(function(n) { %>
                                <div class="notif-item">
                                    <div class="notif-left">
                                        <div class="notif-dot"></div>
                                        <div class="notif-content">
                                            <div class="notif-title"><%= n.title %></div>
                                            <div class="notif-message"><%= n.message %></div>
                                        </div>
                                    </div>
                                    <div class="notif-date">
                                        <i class="far fa-clock" style="margin-right: 4px;"></i>
                                        <%= new Date(n.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="notif-empty">
                            <i class="far fa-bell-slash"></i>
                            <p>No broadcasts sent yet</p>
                        </div>
                    <% } %>
                </div>
            </div>

        </div>
    </main>

    <script>
        const hamburger = document.getElementById('hamburger');
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');

        hamburger.addEventListener('click', () => {
            sidebar.classList.toggle('open');
            overlay.classList.toggle('open');
        });

        overlay.addEventListener('click', () => {
            sidebar.classList.remove('open');
            overlay.classList.remove('open');
        });
    </script>

<script src="/js/animations.js"></script>
</body>
</html>