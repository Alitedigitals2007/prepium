<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prepium | AI Quiz Manager</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Plus Jakarta Sans',sans-serif; display:flex; background:#f0f4f8; color:#0f172a; min-height:100vh; }
        .sidebar { width:260px; background:#0b1437; height:100vh; color:white; position:fixed; display:flex; flex-direction:column; z-index:100; overflow-y:auto; }
        .sidebar-inner { padding:2rem 1.25rem; flex:1; }
        .logo { font-size:1.5rem; font-weight:800; color:white; text-decoration:none; margin-bottom:2.5rem; display:block; padding-left:6px; letter-spacing:-0.5px; }
        .logo span { color:#0062ff; }
        .nav-label { font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:1.2px; color:rgba(255,255,255,0.3); padding:0 12px; margin-bottom:10px; margin-top:8px; }
        .nav-item { display:flex; align-items:center; gap:12px; color:rgba(255,255,255,0.5); text-decoration:none; padding:11px 14px; border-radius:12px; font-size:0.85rem; font-weight:600; margin-bottom:3px; transition:all 0.2s; }
        .nav-item:hover { background:rgba(255,255,255,0.06); color:rgba(255,255,255,0.9); }
        .nav-item.active { background:rgba(0,98,255,0.18); color:white; }
        .main { margin-left:260px; padding:2.5rem; width:calc(100% - 260px); }
        h1 { font-size:1.6rem; font-weight:800; margin-bottom:0.3rem; }
        .subtitle { color:#64748b; font-size:0.88rem; font-weight:500; margin-bottom:1.5rem; }
        .card { background:rgba(255,255,255,0.72); backdrop-filter:blur(20px); border-radius:20px; padding:1.5rem; box-shadow:0 8px 32px rgba(15,23,42,0.07); margin-bottom:1.5rem; }
        .card h3 { font-size:0.95rem; font-weight:700; margin-bottom:1rem; }
        .grid-2 { display:grid; grid-template-columns:1fr 2fr; gap:1.5rem; }
        select, input { padding:10px 14px; border:1.5px solid #e2e8f0; border-radius:14px; font-family:inherit; font-weight:600; font-size:0.85rem; outline:none; background:white; width:100%; }
        select:focus, input:focus { border-color:#0062ff; }
        .form-row { display:flex; gap:10px; align-items:end; flex-wrap:wrap; }
        .form-row .field { flex:1; min-width:120px; }
        .form-row label { font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:#64748b; display:block; margin-bottom:4px; }
        .btn { padding:10px 20px; border:none; border-radius:14px; font-family:inherit; font-weight:700; font-size:0.82rem; cursor:pointer; display:inline-flex; align-items:center; gap:6px; transition:all 0.2s; }
        .btn-primary { background:#0062ff; color:white; }
        .btn-primary:hover { opacity:0.85; }
        .btn-success { background:#10b981; color:white; }
        .btn-danger { background:#f43f5e; color:white; }
        .btn-amber { background:#f59e0b; color:white; }
        .btn-sm { padding:6px 14px; font-size:0.72rem; border-radius:8px; }
        .btn-outline { background:transparent; border:1.5px solid #e2e8f0; color:#64748b; }
        .msg { padding:12px 16px; border-radius:14px; font-weight:600; font-size:0.82rem; margin-bottom:1rem; }
        .msg.good { background:#d1fae5; color:#065f46; }
        .msg.bad { background:#fee2e2; color:#991b1b; }
        table { width:100%; border-collapse:collapse; font-size:0.82rem; }
        th { text-align:left; padding:10px 8px; font-weight:700; color:#64748b; font-size:0.65rem; text-transform:uppercase; border-bottom:1px solid #e2e8f0; }
        td { padding:10px 8px; border-bottom:1px solid #e2e8f0; font-weight:600; }
        .badge { display:inline-block; padding:3px 8px; border-radius:6px; font-size:0.62rem; font-weight:700; }
        .badge.ges { background:#dbeafe; color:#1e40af; }
        .badge.gst { background:#fef3c7; color:#92400e; }
        .question-item { padding:12px; border:1px solid #e2e8f0; border-radius:12px; margin-bottom:8px; }
        .question-item .q-text { font-weight:600; font-size:0.85rem; margin-bottom:6px; }
        .question-item .q-opt { font-size:0.78rem; color:#64748b; }
        .question-item .q-ans { font-size:0.78rem; color:#10b981; font-weight:700; }
        .empty { text-align:center; padding:3rem; color:#94a3b8; font-size:0.85rem; }
        .empty i { font-size:2rem; display:block; margin-bottom:10px; opacity:0.3; }
        @media (max-width:900px) { .grid-2 { grid-template-columns:1fr; } .sidebar { transform:translateX(-100%); } .main { margin-left:0; width:100%; padding:1.5rem; } }
    </style>
</head>
<body>
<nav class="sidebar">
    <div class="sidebar-inner">
        <a href="/admin/dashboard" class="logo">PREPIUM<span>.</span></a>
        <div class="nav-label">Main</div>
        <a href="/admin/dashboard" class="nav-item"><i class="fas fa-th-large"></i> Dashboard</a>
        <a href="/admin/analytics" class="nav-item"><i class="fas fa-chart-line"></i> Analytics</a>
        <div class="nav-label">Quiz System</div>
        <a href="/admin/ai-quiz" class="nav-item active"><i class="fas fa-robot"></i> AI Quiz (GES/GST)</a>
        <a href="/admin/subjects" class="nav-item"><i class="fas fa-book-open"></i> Subjects</a>
        <a href="/admin/questions/manage/0" class="nav-item"><i class="fas fa-question-circle"></i> Questions</a>
        <div class="nav-label">Management</div>
        <a href="/admin/universities" class="nav-item"><i class="fas fa-landmark"></i> Universities</a>
        <a href="/admin/students" class="nav-item"><i class="fas fa-user-graduate"></i> Students</a>
        <a href="/admin/coupons" class="nav-item"><i class="fas fa-ticket"></i> Coupons</a>
        <div class="nav-divider" style="height:1px;background:rgba(255,255,255,0.06);margin:12px 14px;"></div>
        <a href="/logout" class="nav-item" style="color:rgba(244,63,94,0.7)"><i class="fas fa-right-from-bracket"></i> Logout</a>
    </div>
</nav>

<main class="main">
    <h1>AI Quiz Manager</h1>
    <p class="subtitle">Generate and manage GES/GST courses and questions for each university.</p>

    <% if (msg) { %><div class="msg good"><%= msg %></div><% } %>

    <div class="grid-2">
        <div class="card">
            <h3>1. Select University</h3>
            <form method="POST" action="/admin/ai-quiz/generate-courses">
                <div style="margin-bottom:10px;">
                    <select name="university_id" required>
                        <option value="">Choose a university…</option>
                        <% universities.forEach(function(u) { %>
                        <option value="<%= u.id %>"><%= u.name %></option>
                        <% }); %>
                    </select>
                </div>
                <button class="btn btn-primary" style="width:100%"><i class="fas fa-magic"></i> AI-Generate GES/GST Courses</button>
            </form>
            <hr style="margin:1rem 0;border-color:#e2e8f0;">
            <h3>2. Add Course Manually</h3>
            <form method="POST" action="/admin/ai-quiz/course/add">
                <div style="margin-bottom:8px;">
                    <select name="university_id" required>
                        <option value="">Choose university…</option>
                        <% universities.forEach(function(u) { %>
                        <option value="<%= u.id %>"><%= u.name %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-row">
                    <div class="field"><label>Code</label><input name="course_code" placeholder="GES 101" required></div>
                    <div class="field"><label>Title</label><input name="course_title" placeholder="Communication in English" required></div>
                    <div class="field" style="min-width:80px;"><label>Q/Count</label><input name="question_count" type="number" value="10"></div>
                    <button class="btn btn-success">Add</button>
                </div>
            </form>
        </div>

        <div class="card">
            <h3>Courses (<%= courses.length %>)</h3>
            <% if (courses.length > 0) { %>
            <div style="max-height:500px;overflow-y:auto;">
                <table>
                    <thead><tr>
                        <th>University</th>
                        <th>Code</th>
                        <th>Title</th>
                        <th>Q Count</th>
                        <th>Actions</th>
                    </tr></thead>
                    <tbody>
                        <% var currentUni = ''; %>
                        <% courses.forEach(function(c) { %>
                        <tr>
                            <td><%= c.university_name !== currentUni ? (currentUni = c.university_name, c.university_name) : '—' %></td>
                            <td><span class="badge <%= c.course_code.startsWith('GES') ? 'ges' : 'gst' %>"><%= c.course_code %></span></td>
                            <td><%= c.course_title %></td>
                            <td><%= c.question_count %></td>
                            <td style="display:flex;gap:4px;flex-wrap:wrap;">
                                <button class="btn btn-sm btn-primary" onclick="viewQuestions(<%= c.id %>, '<%= c.course_code %>')"><i class="fas fa-eye"></i></button>
                                <form method="POST" action="/admin/ai-quiz/generate-questions/<%= c.id %>" style="display:inline;">
                                    <button class="btn btn-sm btn-success" title="Generate AI Questions"><i class="fas fa-wand-magic-sparkles"></i></button>
                                </form>
                                <button class="btn btn-sm btn-outline" onclick="editCourse(<%= c.id %>, '<%= c.course_title.replace(/'/g, "\\'") %>', <%= c.question_count %>)"><i class="fas fa-edit"></i></button>
                                <form method="POST" action="/admin/ai-quiz/course/delete/<%= c.id %>" style="display:inline;" onsubmit="return confirm('Delete this course and all its questions?')">
                                    <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
            <div class="empty"><i class="fas fa-book"></i> No courses yet. Select a university and generate.</div>
            <% } %>
        </div>
    </div>

    <div class="card" id="questionsPanel" style="display:none;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;">
            <h3 id="qPanelTitle">Questions</h3>
            <button class="btn btn-sm btn-outline" onclick="document.getElementById('questionsPanel').style.display='none'"><i class="fas fa-times"></i> Close</button>
        </div>
        <div id="questionsList"><div class="empty"><i class="fas fa-spinner fa-pulse"></i> Loading…</div></div>
    </div>

    <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;flex-wrap:wrap;gap:8px;">
            <h3>Pre-set Questions (<%= presetQuestions.length %>)</h3>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <select id="filterUni" onchange="filterPreset()" style="width:auto;padding:6px 12px;font-size:0.78rem;">
                    <option value="">All Universities</option>
                    <% universities.forEach(function(u) { %>
                    <option value="<%= u.name %>"><%= u.name %></option>
                    <% }); %>
                </select>
                <select id="filterSubj" onchange="filterPreset()" style="width:auto;padding:6px 12px;font-size:0.78rem;">
                    <option value="">All Subjects</option>
                    <% subjects.forEach(function(s) { %>
                    <option value="<%= s.name %>"><%= s.name %></option>
                    <% }); %>
                </select>
            </div>
        </div>
        <div style="max-height:500px;overflow-y:auto;" id="presetList">
            <% if (presetQuestions.length > 0) { %>
            <% presetQuestions.forEach(function(q) { %>
            <div class="preset-item" data-uni="<%= q.university_name || '' %>" data-subj="<%= q.subject_name || '' %>">
                <div style="display:flex;justify-content:space-between;align-items:start;gap:8px;padding:10px;border:1px solid #e2e8f0;border-radius:12px;margin-bottom:6px;">
                    <div style="flex:1;font-size:0.82rem;">
                        <div style="font-weight:700;margin-bottom:4px;"><%= q.question_text %></div>
                        <div style="font-size:0.72rem;color:#64748b;">
                            <% 
                            var opts = [];
                            ['option_a','option_b','option_c','option_d'].forEach(function(k,i){ if(q[k]) opts.push({letter:String.fromCharCode(65+i), text:q[k]}); });
                            %>
                            <% opts.forEach(function(o) { %>
                            <span style="display:inline-block;margin-right:10px;"><%= o.letter %>) <%= o.text %></span>
                            <% }); %>
                        </div>
                        <div style="font-size:0.72rem;margin-top:4px;">
                            <span style="font-weight:700;color:#10b981;">Answer: <%= q.correct_option %></span>
                            <% if (q.subject_name) { %><span style="margin-left:10px;color:#6366f1;">Subject: <%= q.subject_name %></span><% } %>
                            <% if (q.university_name) { %><span style="margin-left:10px;color:#f59e0b;">Uni: <%= q.university_name %></span><% } %>
                        </div>
                    </div>
                    <form method="POST" action="/admin/questions/delete/<%= q.id %>/0" style="display:inline;" onsubmit="return confirm('Delete this question?')">
                        <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
            <% }); %>
            <% } else { %>
            <div class="empty"><i class="fas fa-database"></i> No pre-set questions. Add via <strong>Subjects</strong> page.</div>
            <% } %>
        </div>
    </div>

    <div style="height:2rem;"></div>
</main>

<script>
function viewQuestions(courseId, code) {
    var panel = document.getElementById('questionsPanel');
    var title = document.getElementById('qPanelTitle');
    var list = document.getElementById('questionsList');
    panel.style.display = 'block';
    title.textContent = 'Questions for ' + code;
    list.innerHTML = '<div class="empty"><i class="fas fa-spinner fa-pulse"></i> Loading…</div>';
    fetch('/admin/ai-quiz/course/' + courseId + '/questions')
    .then(function(r){ return r.json(); })
    .then(function(qs) {
        if (!qs || qs.length === 0) {
            list.innerHTML = '<div class="empty"><i class="fas fa-question"></i> No questions yet. Click the magic wand to generate.</div>';
            return;
        }
        list.innerHTML = qs.map(function(q, i) {
            var opts = [];
            try { opts = typeof q.options === 'string' ? JSON.parse(q.options) : (q.options || []); } catch(e) {}
            var optHtml = opts.length ? opts.map(function(o){ return '<span style="display:block;font-size:0.78rem;color:#475569">' + o + '</span>'; }).join('') : '<span style="color:#94a3b8;">(theory)</span>';
            return '<div class="question-item" id="qitem-' + q.id + '">' +
                '<div style="display:flex;justify-content:space-between;align-items:start;">' +
                '<div style="flex:1">' +
                '<div class="q-text">' + (i+1) + '. ' + q.question_text + '</div>' +
                '<div class="q-opt">' + optHtml + '</div>' +
                (q.correct_answer ? '<div class="q-ans">Answer: ' + q.correct_answer + '</div>' : '') +
                (q.explanation ? '<div style="font-size:0.75rem;color:#64748b;margin-top:4px;padding:8px;background:#f8fafc;border-radius:8px;"><strong>Explanation:</strong> ' + q.explanation + '</div>' : '') +
                '</div>' +
                '<div style="display:flex;gap:4px;flex-shrink:0;">' +
                '<form method="POST" action="/admin/ai-quiz/question/regenerate/' + q.id + '" style="display:inline;"><button class="btn btn-sm btn-amber" title="Regenerate"><i class="fas fa-sync"></i></button></form>' +
                '<form method="POST" action="/admin/ai-quiz/question/delete/' + q.id + '" style="display:inline;" onsubmit="return confirm(\'Delete this question?\')"><button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button></form>' +
                '</div></div></div>';
        }).join('');
        panel.scrollIntoView({ behavior: 'smooth' });
    })
    .catch(function() {
        list.innerHTML = '<div class="empty" style="color:#dc2626;"><i class="fas fa-exclamation-triangle"></i> Failed to load questions.</div>';
    });
}

function filterPreset() {
    var uni = document.getElementById('filterUni').value.toLowerCase();
    var subj = document.getElementById('filterSubj').value.toLowerCase();
    document.querySelectorAll('.preset-item').forEach(function(el) {
        var eu = (el.dataset.uni || '').toLowerCase();
        var es = (el.dataset.subj || '').toLowerCase();
        el.style.display = (uni === '' || eu === uni) && (subj === '' || es === subj) ? '' : 'none';
    });
}

function editCourse(id, title, count) {
    Swal.fire({
        title: 'Edit Course',
        html:
            '<div style="text-align:left;font-size:0.8rem;font-weight:600;color:#475569;margin-bottom:4px">Title</div>' +
            '<input id="swal-title" class="swal2-input" value="' + title.replace(/"/g, '&quot;') + '">' +
            '<div style="text-align:left;font-size:0.8rem;font-weight:600;color:#475569;margin-bottom:4px;margin-top:8px">Questions per course</div>' +
            '<input id="swal-count" class="swal2-input" type="number" value="' + count + '">',
        showCancelButton: true,
        confirmButtonText: 'Save',
        preConfirm: function() {
            return fetch('/admin/ai-quiz/course/update/' + id, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'course_title=' + encodeURIComponent(document.getElementById('swal-title').value) + '&question_count=' + encodeURIComponent(document.getElementById('swal-count').value)
            }).then(function(r) {
                if (r.redirected) window.location.href = r.url;
                else location.reload();
            });
        }
    });
}
</script>
</body>
</html>