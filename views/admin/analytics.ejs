<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        :root {
            --brand: #2563eb;
            --brand-light: rgba(37, 99, 235, 0.1);
            --brand-glow: rgba(37, 99, 235, 0.25);
            --bg: #f0f4f8;
            --sidebar: #0b1437;
            --sidebar-hover: rgba(255, 255, 255, 0.06);
            --sidebar-active: rgba(0, 98, 255, 0.18);
            --border: rgba(226, 232, 240, 0.6);
            --card-bg: rgba(255, 255, 255, 0.72);
            --card-border: rgba(255, 255, 255, 0.5);
            --text-primary: #0f172a;
            --text-secondary: #64748b;
            --text-muted: #94a3b8;
            --green: #10b981;
            --red: #f43f5e;
            --amber: #f59e0b;
            --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.04);
            --shadow-md: 0 4px 16px rgba(15, 23, 42, 0.06);
            --shadow-lg: 0 8px 32px rgba(15, 23, 42, 0.08);
            --shadow-glass: 0 8px 32px rgba(15, 23, 42, 0.07), inset 0 1px 0 rgba(255,255,255,0.6);
            --radius: 20px;
            --radius-sm: 14px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            display: flex;
            background: var(--bg);
            color: var(--text-primary);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Sidebar ── */
        .sidebar {
            width: 260px;
            background: var(--sidebar);
            height: 100vh;
            color: white;
            position: fixed;
            display: flex;
            flex-direction: column;
            z-index: 100;
            overflow-y: auto;
        }

        .sidebar-inner {
            padding: 2rem 1.25rem 1.5rem;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 2px;
            font-size: 1.5rem;
            font-weight: 800;
            color: white;
            text-decoration: none;
            margin-bottom: 2.5rem;
            padding-left: 6px;
            letter-spacing: -0.5px;
        }

        .logo span {
            color: var(--brand);
        }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: rgba(255, 255, 255, 0.3);
            padding: 0 12px;
            margin-bottom: 10px;
            margin-top: 8px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(255, 255, 255, 0.5);
            text-decoration: none;
            padding: 11px 14px;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 3px;
            transition: all 0.2s ease;
            position: relative;
        }

        .nav-item i {
            width: 20px;
            text-align: center;
            font-size: 0.95rem;
        }

        .nav-item:hover {
            background: var(--sidebar-hover);
            color: rgba(255, 255, 255, 0.9);
        }

        .nav-item.active {
            background: var(--sidebar-active);
            color: white;
        }

        .nav-item.active::before {
            content: '';
            position: absolute;
            left: -12px;
            top: 50%;
            transform: translateY(-50%);
            width: 3px;
            height: 20px;
            background: var(--brand);
            border-radius: 0 4px 4px 0;
        }

        .nav-divider {
            height: 1px;
            background: rgba(255, 255, 255, 0.06);
            margin: 12px 14px;
        }

        .nav-item.logout {
            color: rgba(244, 63, 94, 0.7);
        }

        .nav-item.logout:hover {
            background: rgba(244, 63, 94, 0.1);
            color: var(--red);
        }

        /* ── Main Content ── */
        .main {
            margin-left: 260px;
            padding: 2.5rem 2.75rem;
            width: calc(100% - 260px);
            min-height: 100vh;
        }

        .header {
            margin-bottom: 2rem;
        }

        .header h1 {
            font-size: 1.6rem;
            font-weight: 800;
            margin: 0 0 6px 0;
            letter-spacing: -0.5px;
        }

        .header p {
            color: var(--text-secondary);
            font-size: 0.88rem;
            font-weight: 500;
        }

        /* ── Glass Card ── */
        .glass {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--card-border);
            border-radius: var(--radius);
            box-shadow: var(--shadow-glass);
        }

        /* ── Metrics Grid ── */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin-bottom: 22px;
        }

        .metric-card {
            padding: 1.35rem 1.4rem;
            position: relative;
            overflow: hidden;
        }

        .metric-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 20px 20px 0 0;
        }

        .metric-card.accent-blue::before { background: var(--brand); }
        .metric-card.accent-green::before { background: var(--green); }
        .metric-card.accent-red::before { background: var(--red); }
        .metric-card.accent-amber::before { background: var(--amber); }

        .metric-card .icon-wrap {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            margin-bottom: 14px;
        }

        .metric-card.accent-blue .icon-wrap { background: var(--brand-light); color: var(--brand); }
        .metric-card.accent-green .icon-wrap { background: rgba(16, 185, 129, 0.12); color: var(--green); }
        .metric-card.accent-red .icon-wrap { background: rgba(244, 63, 94, 0.12); color: var(--red); }
        .metric-card.accent-amber .icon-wrap { background: rgba(245, 158, 11, 0.12); color: var(--amber); }

        .metric-card small {
            font-size: 0.68rem;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

        .metric-card .value {
            font-size: 1.75rem;
            font-weight: 800;
            display: block;
            margin-top: 6px;
            letter-spacing: -0.5px;
        }

        .metric-card .value.blue { color: var(--brand); }
        .metric-card .value.green { color: var(--green); }
        .metric-card .value.red { color: var(--red); }
        .metric-card .value.amber { color: var(--amber); }

        /* ── Charts Row ── */
        .charts-row {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 18px;
        }

        .card {
            padding: 1.5rem 1.6rem;
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.25rem;
        }

        .card-header h3 {
            margin: 0;
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .card-header .badge {
            font-size: 0.68rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 20px;
            background: var(--brand-light);
            color: var(--brand);
        }

        .chart-container {
            height: 300px;
            position: relative;
        }

        /* ── Traffic List ── */
        .traffic-list { list-style: none; padding: 0; margin: 0; }

        .traffic-item {
            display: flex;
            justify-content: space-between;
            padding: 13px 0;
            border-bottom: 1px solid rgba(241, 245, 249, 0.8);
            align-items: center;
            transition: background 0.15s;
        }

        .traffic-item:last-child { border-bottom: none; }

        .traffic-item .path {
            font-family: 'SF Mono', 'Fira Code', monospace;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--brand);
            background: var(--brand-light);
            padding: 5px 10px;
            border-radius: 8px;
            max-width: 180px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .traffic-item .hits {
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-primary);
        }

        .traffic-item .hits small {
            color: var(--text-muted);
            font-weight: 500;
            font-size: 0.75rem;
        }

        .empty-state {
            text-align: center;
            color: var(--text-muted);
            padding: 3rem 1rem;
            font-size: 0.85rem;
        }

        .empty-state i {
            font-size: 2rem;
            display: block;
            margin-bottom: 10px;
            opacity: 0.3;
        }

        /* ── Responsive ── */
        @media (max-width: 1200px) {
            .metrics-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 900px) {
            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.3s ease;
            }

            .sidebar.open { transform: translateX(0); }

            .main {
                margin-left: 0;
                width: 100%;
                padding: 1.5rem;
            }

            .charts-row { grid-template-columns: 1fr; }

            .mobile-toggle {
                display: flex !important;
            }

            .overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(11, 20, 55, 0.5);
                z-index: 90;
            }

            .overlay.show { display: block; }
        }

        @media (max-width: 600px) {
            .metrics-grid { grid-template-columns: 1fr; }
            .main { padding: 1.25rem; }
        }

        .mobile-toggle {
            display: none;
            position: fixed;
            top: 1rem;
            left: 1rem;
            z-index: 110;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: white;
            border: 1px solid var(--border);
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: var(--shadow-md);
            font-size: 1rem;
            color: var(--text-primary);
        }
    </style>
<meta name="theme-color" content="#2563eb">
<%- include('../partials/theme-toggle') %>
</head>
<body>

    <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>
    <button class="mobile-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>

    <nav class="sidebar" id="sidebar">
        <div class="sidebar-inner">
            <a href="/admin/dashboard" class="logo">PREPIUM<span>.</span></a>

            <div class="nav-label">Main</div>
            <a href="/admin/dashboard" class="nav-item"><i class="fas fa-th-large"></i> Dashboard</a>
            <a href="/admin/analytics" class="nav-item active"><i class="fas fa-chart-line"></i> Analytics</a>

            <div class="nav-label">Management</div>
            <a href="/admin/universities" class="nav-item"><i class="fas fa-landmark"></i> Universities</a>
            <a href="/admin/students" class="nav-item"><i class="fas fa-user-graduate"></i> Students</a>

            <div class="nav-label">Commerce</div>
            <a href="/admin/coupons" class="nav-item"><i class="fas fa-ticket"></i> Coupons</a>

            <div class="nav-label">System</div>
            <a href="/admin/notifications" class="nav-item"><i class="fas fa-bell"></i> Notifications</a>
            <a href="/admin/db-manager" class="nav-item"><i class="fas fa-database"></i> DB Manager</a>

            <div class="nav-divider"></div>
            <a href="/logout" class="nav-item logout"><i class="fas fa-right-from-bracket"></i> Logout</a>
        </div>
    </nav>

    <main class="main">
        <div class="header">
            <h1>Platform Intelligence</h1>
            <p>Real-time performance and user acquisition data.</p>
        </div>

        <div class="metrics-grid">
            <div class="metric-card glass accent-blue">
                <div class="icon-wrap"><i class="fas fa-users"></i></div>
                <small>Total Users</small>
                <span class="value blue"><%= stats.total_users %></span>
            </div>
            <div class="metric-card glass accent-green">
                <div class="icon-wrap"><i class="fas fa-user-plus"></i></div>
                <small>Signups Today / Week</small>
                <span class="value green"><%= signups.daily %> / <%= signups.weekly %></span>
            </div>
            <div class="metric-card glass accent-amber">
                <div class="icon-wrap"><i class="fas fa-crown"></i></div>
                <small>Premium (Total / 7d)</small>
                <span class="value amber"><%= stats.premium_users %> / <%= stats.weekly_premium %></span>
            </div>
            <div class="metric-card glass accent-red">
                <div class="icon-wrap"><i class="fas fa-question-circle"></i></div>
                <small>Total Quizzes Taken</small>
                <span class="value red"><%= stats.total_quizzes %></span>
            </div>
        </div>

        <div class="charts-row" style="margin-bottom:22px;">
            <div class="card glass">
                <div class="card-header">
                    <h3>Estimated Revenue</h3>
                    <span class="badge">₦<%= (revenue.estimated || 0).toLocaleString() %></span>
                </div>
                <div style="padding:0.5rem 0;font-size:0.85rem;color:var(--text-secondary);">
                    Coupon redemptions: <strong><%= revenue.coupon_redemptions || 0 %></strong>
                </div>
            </div>
            <div class="card glass">
                <div class="card-header">
                    <h3>Top Coupons</h3>
                </div>
                <% if (coupons && coupons.length > 0) { %>
                    <div class="traffic-list">
                        <% coupons.forEach(function(c) { %>
                            <div class="traffic-item">
                                <span class="path"><%= c.code %></span>
                                <span class="hits"><%= c.times_used %> <small>/ <%= c.max_uses || '∞' %></small></span>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-state"><i class="fas fa-ticket"></i> No coupons created yet.</div>
                <% } %>
            </div>
        </div>

        <div class="charts-row">
            <div class="card glass">
                <div class="card-header">
                    <h3>Acquisition Trend</h3>
                    <span class="badge">14 Days</span>
                </div>
                <div class="chart-container">
                    <canvas id="growthChart"></canvas>
                </div>
            </div>

            <div class="card glass">
                <div class="card-header">
                    <h3>Page Traffic</h3>
                </div>
                <div class="traffic-list">
                    <% if (pages && pages.length > 0) { %>
                        <% pages.forEach(p => { %>
                            <div class="traffic-item">
                                <span class="path"><%= p.page_path %></span>
                                <span class="hits"><%= p.views %> <small>hits</small></span>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="empty-state">
                            <i class="fas fa-chart-bar"></i>
                            No traffic data available.
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('overlay').classList.toggle('show');
        }

        const ctx = document.getElementById('growthChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: <%- JSON.stringify(chartData.labels) %>,
                datasets: [{
                    label: 'New Users',
                    data: <%- JSON.stringify(chartData.values) %>,
                    borderColor: '#2563eb',
                    backgroundColor: (context) => {
                        const chart = context.chart;
                        const {ctx: c, chartArea} = chart;
                        if (!chartArea) return 'rgba(37,99,235,0.06)';
                        const gradient = c.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
                        gradient.addColorStop(0, 'rgba(37, 99, 235, 0.15)');
                        gradient.addColorStop(1, 'rgba(37, 99, 235, 0.01)');
                        return gradient;
                    },
                    borderWidth: 2.5,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 0,
                    pointHoverRadius: 6,
                    pointHoverBackgroundColor: '#fff',
                    pointHoverBorderColor: '#2563eb',
                    pointHoverBorderWidth: 2.5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { intersect: false, mode: 'index' },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleFont: { family: 'Plus Jakarta Sans', weight: '600', size: 12 },
                        bodyFont: { family: 'Plus Jakarta Sans', weight: '700', size: 13 },
                        padding: 12,
                        cornerRadius: 10,
                        displayColors: false,
                        callbacks: {
                            label: (ctx) => ctx.parsed.y + ' new users'
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(241,245,249,0.6)', drawBorder: false },
                        border: { display: false },
                        ticks: { stepSize: 1, font: { family: 'Plus Jakarta Sans', size: 11, weight: '600' }, color: '#94a3b8', padding: 8 }
                    },
                    x: {
                        grid: { display: false },
                        border: { display: false },
                        ticks: { font: { family: 'Plus Jakarta Sans', size: 11, weight: '600' }, color: '#94a3b8', padding: 8 }
                    }
                }
            }
        });
    </script>
<script src="/js/animations.js"></script>
</body>
</html>
