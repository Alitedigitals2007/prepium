<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <style>
        :root {
            --brand-glow: rgba(37, 99, 235, 0.25);
            --sidebar: #0b1437;
            --sidebar-hover: rgba(255, 255, 255, 0.06);
            --sidebar-active: rgba(0, 98, 255, 0.18);
            --green: #10b981;
            --red: #f43f5e;
            --amber: #f59e0b;
            --shadow-glass: 0 8px 32px rgba(15, 23, 42, 0.07), inset 0 1px 0 rgba(255,255,255,0.6);
        }

        [data-theme="dark"] {
            --shadow-glass: 0 8px 32px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255,255,255,0.05);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            display: flex;
            background: var(--bg);
            color: var(--text-primary);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        .sidebar {
            width: 260px;
            background: var(--sidebar);
            height: 100vh;
            color: white;
            position: fixed;
            display: flex;
            flex-direction: column;
            z-index: 100;
            overflow-y: auto;
        }

        .sidebar-inner { padding: 2rem 1.25rem 1.5rem; display: flex; flex-direction: column; flex: 1; }

        .logo { display: flex; align-items: center; gap: 2px; font-size: 1.5rem; font-weight: 800; color: white; text-decoration: none; margin-bottom: 2.5rem; padding-left: 6px; letter-spacing: -0.5px; }
        .logo span { color: var(--brand); }

        .nav-label { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: rgba(255, 255, 255, 0.3); padding: 0 12px; margin-bottom: 10px; margin-top: 8px; }

        .nav-item { display: flex; align-items: center; gap: 12px; color: rgba(255, 255, 255, 0.5); text-decoration: none; padding: 11px 14px; border-radius: 12px; font-size: 0.85rem; font-weight: 600; margin-bottom: 3px; transition: all 0.2s ease; position: relative; }
        .nav-item i { width: 20px; text-align: center; font-size: 0.95rem; }
        .nav-item:hover { background: var(--sidebar-hover); color: rgba(255, 255, 255, 0.9); }
        .nav-item.active { background: var(--sidebar-active); color: white; }
        .nav-item.active::before { content: ''; position: absolute; left: -12px; top: 50%; transform: translateY(-50%); width: 3px; height: 20px; background: var(--brand); border-radius: 0 4px 4px 0; }
        .nav-divider { height: 1px; background: rgba(255, 255, 255, 0.06); margin: 12px 14px; }
        .nav-item.logout { color: rgba(244, 63, 94, 0.7); }
        .nav-item.logout:hover { background: rgba(244, 63, 94, 0.1); color: var(--red); }

        .main { margin-left: 260px; padding: 2.5rem 2.75rem; width: calc(100% - 260px); min-height: 100vh; }

        .header { margin-bottom: 1.6rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 14px; }
        .header h1 { font-size: 1.6rem; font-weight: 800; margin: 0 0 6px 0; letter-spacing: -0.5px; }
        .header p { color: var(--text-secondary); font-size: 0.88rem; font-weight: 500; }

        .range-selector { display: inline-flex; background: var(--surface-solid); border: 1px solid var(--border-solid); border-radius: 12px; padding: 4px; }
        .range-btn { padding: 7px 16px; border-radius: 9px; font-size: 0.8rem; font-weight: 800; color: var(--text-secondary); text-decoration: none; }
        .range-btn.active { background: var(--brand); color: white; }

        .glass { background: var(--card-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--card-border); border-radius: var(--radius); box-shadow: var(--shadow-glass); }

        .metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 22px; }

        .metric-card { padding: 1.35rem 1.4rem; position: relative; overflow: hidden; }
        .metric-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; border-radius: 20px 20px 0 0; }
        .metric-card.accent-blue::before { background: var(--brand); }
        .metric-card.accent-green::before { background: var(--green); }
        .metric-card.accent-red::before { background: var(--red); }
        .metric-card.accent-amber::before { background: var(--amber); }

        .metric-card .icon-wrap { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; margin-bottom: 14px; }
        .metric-card.accent-blue .icon-wrap { background: var(--brand-light); color: var(--brand); }
        .metric-card.accent-green .icon-wrap { background: rgba(16, 185, 129, 0.12); color: var(--green); }
        .metric-card.accent-red .icon-wrap { background: rgba(244, 63, 94, 0.12); color: var(--red); }
        .metric-card.accent-amber .icon-wrap { background: rgba(245, 158, 11, 0.12); color: var(--amber); }

        .metric-card small { font-size: 0.68rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.8px; }
        .metric-card .value { font-size: 1.75rem; font-weight: 800; display: block; margin-top: 6px; letter-spacing: -0.5px; }
        .metric-card .value.blue { color: var(--brand); }
        .metric-card .value.green { color: var(--green); }
        .metric-card .value.red { color: var(--red); }
        .metric-card .value.amber { color: var(--amber); }
        .metric-card .sub { font-size: 0.72rem; font-weight: 600; color: var(--text-muted); margin-top: 4px; }

        .charts-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 22px; }
        .card { padding: 1.5rem 1.6rem; }
        .card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.1rem; }
        .card-header h3 { margin: 0; font-size: 0.95rem; font-weight: 700; color: var(--text-primary); }
        .card-header .badge { font-size: 0.68rem; font-weight: 700; padding: 4px 10px; border-radius: 20px; background: var(--brand-light); color: var(--brand); }
        .card-header .badge.green { background: rgba(16,185,129,0.12); color: var(--green); }
        .card-header .badge.red { background: rgba(244,63,94,0.12); color: var(--red); }
        .card-header .badge.amber { background: rgba(245,158,11,0.12); color: var(--amber); }

        .chart-container { height: 260px; position: relative; }

        .kpi-mini { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 6px; }
        .kpi-mini .mk { background: var(--surface-solid); border: 1px solid var(--border-solid); border-radius: 14px; padding: 14px 16px; }
        .kpi-mini .mk .l { font-size: 0.66rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; }
        .kpi-mini .mk .v { font-size: 1.4rem; font-weight: 800; margin-top: 4px; }
        .kpi-mini .mk .v.green { color: var(--green); }
        .kpi-mini .mk .v.red { color: var(--red); }
        .kpi-mini .mk .v.amber { color: var(--amber); }
        .kpi-mini .mk .v.blue { color: var(--brand); }

        .split { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }

        .list { list-style: none; }
        .list li { display: flex; justify-content: space-between; align-items: center; padding: 11px 0; border-bottom: 1px solid rgba(241,245,249,0.8); gap: 10px; }
        .list li:last-child { border-bottom: none; }
        .list .lname { font-weight: 700; font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .list .lsub { font-size: 0.72rem; color: var(--text-muted); font-weight: 600; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .list .lval { font-weight: 800; font-size: 0.9rem; flex-shrink: 0; }
        .list .lval.green { color: var(--green); }
        .list .lval.red { color: var(--red); }
        .list .lval.amber { color: var(--amber); }
        .list .lval.blue { color: var(--brand); }
        .pill { font-size: 0.66rem; font-weight: 800; padding: 3px 9px; border-radius: 20px; background: var(--surface-solid); color: var(--text-secondary); border: 1px solid var(--border-solid); }
        .pill.green { background: rgba(16,185,129,0.12); color: var(--green); border-color: transparent; }
        .pill.red { background: rgba(244,63,94,0.12); color: var(--red); border-color: transparent; }
        .pill.amber { background: rgba(245,158,11,0.12); color: var(--amber); border-color: transparent; }
        .pill.blue { background: var(--brand-light); color: var(--brand); border-color: transparent; }

        .empty-state { text-align: center; color: var(--text-muted); padding: 2.4rem 1rem; font-size: 0.85rem; }
        .empty-state i { font-size: 1.8rem; display: block; margin-bottom: 8px; opacity: 0.3; }

        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th { padding: 10px 12px; font-size: 0.66rem; color: var(--text-muted); border-bottom: 2px solid var(--border-solid); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; }
        td { padding: 12px; border-bottom: 1px solid var(--border); font-size: 0.84rem; }
        tr:last-child td { border-bottom: none; }
        .rank { width: 26px; height: 26px; border-radius: 8px; background: var(--brand-light); color: var(--brand); display: inline-flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.75rem; }
        .u-name { font-weight: 700; }
        .u-mail { font-size: 0.74rem; color: var(--text-muted); font-weight: 500; }
        .q-text { font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

        .section-title { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--text-secondary); margin: 4px 0 14px; display: flex; align-items: center; gap: 8px; }
        .section-title i { color: var(--brand); }

        .mobile-toggle { display: none; position: fixed; top: 1rem; left: 1rem; z-index: 110; width: 40px; height: 40px; border-radius: 10px; background: var(--surface-solid); border: 1px solid var(--border); align-items: center; justify-content: center; cursor: pointer; box-shadow: var(--shadow-md); font-size: 1rem; color: var(--text-primary); }

        @media (max-width: 1200px) {
            .metrics-grid { grid-template-columns: repeat(2, 1fr); }
            .charts-row, .split { grid-template-columns: 1fr; }
            .kpi-mini { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 900px) {
            .sidebar { transform: translateX(-100%); transition: transform 0.3s ease; }
            .sidebar.open { transform: translateX(0); }
            .main { margin-left: 0; width: 100%; padding: 1.5rem; }
            .mobile-toggle { display: flex !important; }
            .overlay { display: none; position: fixed; inset: 0; background: rgba(11, 20, 55, 0.5); z-index: 90; }
            .overlay.show { display: block; }
        }
        @media (max-width: 600px) {
            .metrics-grid, .kpi-mini { grid-template-columns: 1fr; }
            .main { padding: 1.25rem; }
        }
    </style>
<meta name="theme-color" content="#2563eb">
<%- include('../partials/theme-toggle') %>
</head>
<body>

    <div class="overlay" id="overlay" onclick="toggleSidebar()"></div>
    <button class="mobile-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>

    <nav class="sidebar" id="sidebar">
        <div class="sidebar-inner">
            <a href="/admin/dashboard" class="logo">PREPIUM<span>.</span></a>

            <div class="nav-label">Main</div>
            <a href="/admin/dashboard" class="nav-item"><i class="fas fa-th-large"></i> Dashboard</a>
            <a href="/admin/analytics" class="nav-item active"><i class="fas fa-chart-line"></i> Analytics</a>

            <div class="nav-label">Management</div>
            <a href="/admin/universities" class="nav-item"><i class="fas fa-landmark"></i> Universities</a>
            <a href="/admin/students" class="nav-item"><i class="fas fa-user-graduate"></i> Students</a>

            <div class="nav-label">Commerce</div>
            <a href="/admin/coupons" class="nav-item"><i class="fas fa-ticket"></i> Coupons</a>

            <div class="nav-label">System</div>
            <a href="/admin/notifications" class="nav-item"><i class="fas fa-bell"></i> Notifications</a>
            <a href="/admin/db-manager" class="nav-item"><i class="fas fa-database"></i> DB Manager</a>

            <div class="nav-divider"></div>
            <a href="/logout" class="nav-item logout"><i class="fas fa-right-from-bracket"></i> Logout</a>
        </div>
    </nav>

    <main class="main">
        <div class="header">
            <div>
                <h1>Platform Intelligence</h1>
                <p>Real-time performance and user acquisition data.</p>
            </div>
            <div class="range-selector">
                <a class="range-btn <%= rangeDays === 7 ? 'active' : '' %>" href="/admin/analytics?range=7">7D</a>
                <a class="range-btn <%= rangeDays === 30 ? 'active' : '' %>" href="/admin/analytics?range=30">30D</a>
                <a class="range-btn <%= rangeDays === 90 ? 'active' : '' %>" href="/admin/analytics?range=90">90D</a>
            </div>
        </div>

        <div class="metrics-grid">
            <div class="metric-card glass accent-blue">
                <div class="icon-wrap"><i class="fas fa-users"></i></div>
                <small>Total Users</small>
                <span class="value blue"><%= stats.total_users %></span>
                <div class="sub">+<%= stats.new_users %> in last <%= rangeDays %> days</div>
            </div>
            <div class="metric-card glass accent-amber">
                <div class="icon-wrap"><i class="fas fa-crown"></i></div>
                <small>Premium Users</small>
                <span class="value amber"><%= stats.premium_users %></span>
                <div class="sub">+<%= stats.new_premium %> new in <%= rangeDays %>d</div>
            </div>
            <div class="metric-card glass accent-red">
                <div class="icon-wrap"><i class="fas fa-file-circle-check"></i></div>
                <small>Assessments (<%= rangeDays %>d)</small>
                <span class="value red"><%= stats.assessments %></span>
                <div class="sub">Exams + quizzes + daily arena</div>
            </div>
            <div class="metric-card glass accent-green">
                <div class="icon-wrap"><i class="fas fa-gauge-high"></i></div>
                <small>Avg Score (<%= rangeDays %>d)</small>
                <span class="value green"><%= stats.avg_score %>%</span>
                <div class="sub">Pass rate <%= stats.pass_rate %>% · <%= stats.passed %>/<%= stats.assessments %></div>
            </div>
        </div>

        <div class="card glass" style="margin-bottom:22px;">
            <div class="card-header">
                <h3>Today at a Glance</h3>
                <span class="badge">24h</span>
            </div>
            <div class="kpi-mini">
                <div class="mk">
                    <div class="l">Active Students</div>
                    <div class="v blue"><%= today.active_today || 0 %></div>
                </div>
                <div class="mk">
                    <div class="l">Logins (24h)</div>
                    <div class="v green"><%= today.logins_today || 0 %></div>
                </div>
                <div class="mk">
                    <div class="l">Tasks Done Today</div>
                    <div class="v amber"><%= today.tasks_done || 0 %>/<%= today.tasks_total || 0 %></div>
                </div>
                <div class="mk">
                    <div class="l">Study Hours (<%= rangeDays %>d)</div>
                    <div class="v red"><%= stats.study_minutes %>m</div>
                </div>
            </div>
            <div class="split" style="margin-top:16px;">
                <div>
                    <div class="section-title"><i class="fas fa-fire"></i> Streak of the Day</div>
                    <% if (streakLeaders.length) { %>
                        <ul class="list">
                            <% streakLeaders.forEach(function(u, i) { %>
                                <li>
                                    <div>
                                        <div class="lname"><%= u.fullname %></div>
                                        <div class="lsub">Longest: <%= u.longest_streak %> days</div>
                                    </div>
                                    <span class="lval amber"><%= u.current_streak %>🔥</span>
                                </li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <div class="empty-state"><i class="fas fa-fire"></i>No streaks yet.</div>
                    <% } %>
                </div>
                <div>
                    <div class="section-title"><i class="fas fa-trophy"></i> Daily Arena Leaders</div>
                    <% if (arenaToday.length) { %>
                        <ul class="list">
                            <% arenaToday.forEach(function(u, i) { %>
                                <li>
                                    <div>
                                        <div class="lname"><%= u.username %></div>
                                        <div class="lsub">Monthly: <%= u.monthly_score %> · Streak <%= u.streak %></div>
                                    </div>
                                    <span class="lval green"><%= u.current_daily_score %></span>
                                </li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <div class="empty-state"><i class="fas fa-trophy"></i>No arena activity yet.</div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="card glass" style="margin-bottom:22px;">
            <div class="card-header">
                <h3>Most Active Users (<%= rangeDays %>d)</h3>
                <span class="badge">By activity score</span>
            </div>
            <% if (activeUsers.length) { %>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr><th></th><th>User</th><th>University</th><th>Quizzes</th><th>Exams</th><th>Study</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            <% activeUsers.forEach(function(u, i) { %>
                                <tr>
                                    <td><span class="rank"><%= i + 1 %></span></td>
                                    <td>
                                        <div class="u-name"><%= u.fullname %></div>
                                        <div class="u-mail"><%= u.email %></div>
                                    </td>
                                    <td><span class="pill"><%= u.university || '—' %></span></td>
                                    <td><span class="pill blue"><%= u.quizzes %></span></td>
                                    <td><span class="pill green"><%= u.exams %></span></td>
                                    <td><span class="pill amber"><%= u.study_sessions %></span></td>
                                    <td style="font-weight:800;font-size:1rem;"><%= u.actions %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state"><i class="fas fa-user-clock"></i>No student activity in this period.</div>
            <% } %>
        </div>

        <div class="charts-row">
            <div class="card glass">
                <div class="card-header">
                    <h3>Acquisition Trend</h3>
                    <span class="badge"><%= rangeDays %> Days</span>
                </div>
                <div class="chart-container"><canvas id="growthChart"></canvas></div>
            </div>
            <div class="card glass">
                <div class="card-header">
                    <h3>Renaissance Exams — Attempts</h3>
                    <span class="badge"><%= rangeDays %>d</span>
                </div>
                <div class="chart-container"><canvas id="examChart"></canvas></div>
            </div>
        </div>

        <div class="split" style="margin-bottom:22px;">
            <div class="card glass">
                <div class="card-header">
                    <h3>Hardest Questions (Renaissance)</h3>
                    <span class="badge red">lowest % correct</span>
                </div>
                <% if (hardest.length) { %>
                    <ul class="list">
                        <% hardest.forEach(function(q) { %>
                            <% var pct = q.answered ? Math.round((q.correct / q.answered) * 100) : 0; %>
                            <li>
                                <div>
                                    <div class="lname"><%= q.exam_title %></div>
                                    <div class="lsub"><%= q.question_text.replace(/\\n/g, ' ') %></div>
                                </div>
                                <span class="pill <%= pct <= 30 ? 'red' : 'amber' %>"><%= q.correct %>/<%= q.answered %> correct</span>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <div class="empty-state"><i class="fas fa-circle-question"></i>Not enough attempts yet.</div>
                <% } %>
            </div>
            <div class="card glass">
                <div class="card-header">
                    <h3>Weakest Subjects</h3>
                    <span class="badge red">by avg score</span>
                </div>
                <% if (subjectWeak.length) { %>
                    <ul class="list">
                        <% subjectWeak.forEach(function(s) { %>
                            <li>
                                <div>
                                    <div class="lname"><%= s.subject %></div>
                                    <div class="lsub"><%= s.attempts %> attempts</div>
                                </div>
                                <span class="lval <%= s.avg_pct < 50 ? 'red' : 'amber' %>"><%= s.avg_pct %>%</span>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <div class="empty-state"><i class="fas fa-book-open"></i>No quiz results yet.</div>
                <% } %>
            </div>
        </div>

        <div class="split" style="margin-bottom:22px;">
            <div class="card glass">
                <div class="card-header">
                    <h3>Renaissance Per-Exam</h3>
                    <span class="badge"><%= rangeDays %>d</span>
                </div>
                <% if (examStats.length) { %>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Exam</th><th>Attempts</th><th>Avg</th><th>Best</th></tr></thead>
                            <tbody>
                                <% examStats.forEach(function(e) { %>
                                    <tr>
                                        <td class="q-text"><%= e.title %></td>
                                        <td><b><%= e.attempts %></b></td>
                                        <td><span class="pill <%= e.avg_pct < 50 ? 'red' : 'green' %>"><%= e.avg_pct %>%</span></td>
                                        <td><%= e.best %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="empty-state"><i class="fas fa-landmark"></i>No submissions in this period.</div>
                <% } %>
            </div>
            <div class="card glass">
                <div class="card-header">
                    <h3>Signups by University (<%= rangeDays %>d)</h3>
                    <span class="badge green"><%= rangeDays %>d</span>
                </div>
                <% if (uniSignups.length) { %>
                    <ul class="list">
                        <% uniSignups.forEach(function(u) { %>
                            <li>
                                <div class="lname"><%= u.university || 'Not specified' %></div>
                                <span class="lval blue"><%= u.signups %></span>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <div class="empty-state"><i class="fas fa-building-columns"></i>No signups yet.</div>
                <% } %>
            </div>
        </div>

        <div class="charts-row">
            <div class="card glass">
                <div class="card-header">
                    <h3>Revenue (Real Payments)</h3>
                    <span class="badge green">₦<%= (revenue.real.revenue || 0).toLocaleString() %></span>
                </div>
                <div class="kpi-mini">
                    <div class="mk">
                        <div class="l">Verified Payments</div>
                        <div class="v green"><%= revenue.real.payments || 0 %></div>
                    </div>
                    <div class="mk">
                        <div class="l">Paid via Coupon</div>
                        <div class="v amber"><%= revenue.real.coupon_paid || 0 %></div>
                    </div>
                    <div class="mk" style="grid-column:span 2;">
                        <div class="l">Note</div>
                        <div style="font-size:0.78rem;color:var(--text-muted);font-weight:600;margin-top:4px;">Sums verified payments only — no more premium×2000 guesses.</div>
                    </div>
                </div>
            </div>
            <div class="card glass">
                <div class="card-header">
                    <h3>Top Coupons</h3>
                </div>
                <% if (coupons && coupons.length > 0) { %>
                    <ul class="list">
                        <% coupons.forEach(function(c) { %>
                            <li>
                                <div>
                                    <div class="lname"><%= c.code %></div>
                                    <div class="lsub"><%= c.discount_type %> <%= c.discount_value %> · <%= c.is_active ? 'Active' : 'Inactive' %></div>
                                </div>
                                <span class="lval blue"><%= c.times_used %> <span style="font-size:0.7rem;color:var(--text-muted);">/<%= c.max_uses || '∞' %></span></span>
                            </li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <div class="empty-state"><i class="fas fa-ticket"></i> No coupons created yet.</div>
                <% } %>
            </div>
        </div>

        <div class="card glass">
            <div class="card-header">
                <h3>Page Traffic (<%= rangeDays %>d)</h3>
                <span class="badge">most active pages</span>
            </div>
            <% if (pages && pages.length > 0) { %>
                <ul class="list">
                    <% pages.forEach(function(p) { %>
                        <li>
                            <span class="lname" style="font-family:monospace;font-size:0.8rem;color:var(--brand);"><%= p.page_path %></span>
                            <span class="lval"><%= p.views %> <span style="font-size:0.7rem;color:var(--text-muted);">views</span></span>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-chart-bar"></i>
                    Page tracking just enabled — views will appear here as students browse.
                </div>
            <% } %>
        </div>
    </main>

    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('overlay').classList.toggle('show');
        }

        var growthChartDone = false;
        function initGrowthChart() {
            var el = document.getElementById('growthChart');
            if (!el || growthChartDone) return;
            if (typeof Chart === 'undefined') { setTimeout(initGrowthChart, 300); return; }
            growthChartDone = true;
            new Chart(el.getContext('2d'), {
                type: 'line',
                data: {
                    labels: <%- JSON.stringify(chartData.labels) %>,
                    datasets: [{
                        label: 'New Users',
                        data: <%- JSON.stringify(chartData.values) %>,
                        borderColor: '#2563eb',
                        backgroundColor: (context) => {
                            const chart = context.chart;
                            const {ctx: c, chartArea} = chart;
                            if (!chartArea) return 'rgba(37,99,235,0.06)';
                            const gradient = c.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
                            gradient.addColorStop(0, 'rgba(37, 99, 235, 0.15)');
                            gradient.addColorStop(1, 'rgba(37, 99, 235, 0.01)');
                            return gradient;
                        },
                        borderWidth: 2.5, fill: true, tension: 0.4,
                        pointRadius: 0, pointHoverRadius: 6, pointHoverBackgroundColor: '#fff',
                        pointHoverBorderColor: '#2563eb', pointHoverBorderWidth: 2.5
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    interaction: { intersect: false, mode: 'index' },
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: 'rgba(241,245,249,0.6)', drawBorder: false }, border: { display: false }, ticks: { stepSize: 1, font: { size: 11, weight: '600' }, color: '#94a3b8', padding: 8 } },
                        x: { grid: { display: false }, border: { display: false }, ticks: { font: { size: 11, weight: '600' }, color: '#94a3b8', padding: 8 } }
                    }
                }
            });
        }

        var examChartDone = false;
        function initExamChart() {
            var el = document.getElementById('examChart');
            if (!el || examChartDone) return;
            if (typeof Chart === 'undefined') { setTimeout(initExamChart, 300); return; }
            examChartDone = true;
            new Chart(el.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: <%- JSON.stringify(chartData.examLabels) %>,
                    datasets: [{
                        label: 'Attempts',
                        data: <%- JSON.stringify(chartData.examValues) %>,
                        backgroundColor: 'rgba(37,99,235,0.7)',
                        hoverBackgroundColor: '#2563eb',
                        borderRadius: 8,
                        maxBarThickness: 44
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: 'rgba(241,245,249,0.6)', drawBorder: false }, border: { display: false }, ticks: { stepSize: 1, font: { size: 11, weight: '600' }, color: '#94a3b8' } },
                        x: { grid: { display: false }, border: { display: false }, ticks: { font: { size: 10, weight: '600' }, color: '#94a3b8', maxRotation: 30 } }
                    }
                }
            });
        }

        initGrowthChart();
        initExamChart();
    </script>
<script src="/js/animations.js"></script>
</body>
</html>