<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prepium | Strategic Intel</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root { --brand: #0062ff; --bg: #f8fafc; --sidebar: #1e293b; --border: #e2e8f0; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; margin: 0; display: flex; background: var(--bg); color: #0f172a; min-height: 100vh; }

        /* Sidebar */
        .sidebar { width: 260px; background: var(--sidebar); height: 100vh; color: white; padding: 2rem 1.5rem; position: fixed; display: flex; flex-direction: column; }
        .logo { font-size: 1.5rem; font-weight: 800; color: var(--brand); text-decoration: none; margin-bottom: 2.5rem; }
        .logo span { color: white; }
        .nav-item { display: flex; align-items: center; gap: 12px; color: #94a3b8; text-decoration: none; padding: 12px 16px; border-radius: 12px; font-size: 0.88rem; font-weight: 600; margin-bottom: 5px; }
        .nav-item:hover, .nav-item.active { background: rgba(255, 255, 255, 0.08); color: white; }

        /* Content */
        .main { margin-left: 260px; padding: 3rem; width: calc(100% - 260px); }
        .header { margin-bottom: 2rem; }
        .header h1 { font-size: 1.75rem; font-weight: 800; margin: 0; }
        
        /* Grid Layout */
        .metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 2rem; }
        .metric-card { background: white; padding: 1.5rem; border-radius: 20px; border: 1px solid var(--border); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02); }
        .metric-card small { font-size: 0.7rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.8px; }
        .metric-card .value { font-size: 1.8rem; font-weight: 800; display: block; margin-top: 8px; }

        .charts-row { display: grid; grid-template-columns: 2fr 1fr; gap: 25px; }
        .card { background: white; padding: 1.5rem; border-radius: 24px; border: 1px solid var(--border); }
        .card h3 { margin-top: 0; font-size: 1rem; font-weight: 800; margin-bottom: 1.5rem; color: #1e293b; }

        .traffic-list { list-style: none; padding: 0; margin: 0; }
        .traffic-item { display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #f1f5f9; align-items: center; }
        .traffic-item:last-child { border: none; }
        .path { font-family: monospace; font-size: 0.8rem; font-weight: 700; color: var(--brand); background: #eff6ff; padding: 4px 8px; border-radius: 6px; }
    </style>
</head>
<body>

    <nav class="sidebar">
        <a href="/admin/dashboard" class="logo">PREPIUM<span>.</span></a>
        <div class="nav-group">
            <a href="/admin/dashboard" class="nav-item">🏠 Dashboard</a>
            <a href="/admin/analytics" class="nav-item active">📈 Analytics</a> 
            <a href="/admin/universities" class="nav-item">🏛️ Universities</a>
            <a href="/admin/subjects" class="nav-item">📚 Subjects</a>
            <a href="/admin/students" class="nav-item">👥 Students</a>
        </div>
    </nav>

    <main class="main">
        <div class="header">
            <h1>Platform Intelligence</h1>
            <p>Real-time performance and user acquisition data.</p>
        </div>

        <div class="metrics-grid">
            <div class="metric-card">
                <small>Daily Signups</small>
                <span class="value" style="color: var(--brand);"><%= signups.daily %></span>
            </div>
            <div class="metric-card">
                <small>Premium Conversion</small>
                <span class="value" style="color: #10b981;"><%= stats.premium_users %></span>
            </div>
            <div class="metric-card">
                <small>Arena Activity</small>
                <span class="value" style="color: #f43f5e;"><%= stats.active_battlers %></span>
            </div>
            <div class="metric-card">
                <small>Total Quizzes</small>
                <span class="value"><%= stats.total_quizzes %></span>
            </div>
        </div>

        <div class="charts-row">
            <div class="card">
                <h3>Acquisition Trend (14 Days)</h3>
                <div style="height: 300px;">
                    <canvas id="growthChart"></canvas>
                </div>
            </div>

            <div class="card">
                <h3>Page Traffic</h3>
                <div class="traffic-list">
                    <% if (pages && pages.length > 0) { %>
                        <% pages.forEach(p => { %>
                            <div class="traffic-item">
                                <span class="path"><%= p.page_path %></span>
                                <span style="font-weight: 800;"><%= p.views %> <small style="color:#64748b">hits</small></span>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="text-align:center; color:#94a3b8; margin-top:2rem;">No traffic data available.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <script>
        const ctx = document.getElementById('growthChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: <%- JSON.stringify(chartData.labels) %>,
                datasets: [{
                    label: 'New Users',
                    data: <%- JSON.stringify(chartData.values) %>,
                    borderColor: '#0062ff',
                    backgroundColor: 'rgba(0, 98, 255, 0.08)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4,
                    pointBackgroundColor: '#fff',
                    pointBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { stepSize: 1 } },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
</body>
</html>