<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prepium Admin | Suggestions</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --brand: #0062ff;
            --brand-light: #3d8bff;
            --brand-dark: #004ecc;
            --bg: #f0f4f8;
            --sidebar: #0b1437;
            --sidebar-hover: rgba(255,255,255,0.08);
            --text: #0f172a;
            --sub: #64748b;
            --border: #e2e8f0;
            --white: #ffffff;
            --glass-bg: rgba(255,255,255,0.75);
            --glass-border: rgba(255,255,255,0.5);
            --shadow-sm: 0 1px 3px rgba(0,0,0,0.04), 0 1px 2px rgba(0,0,0,0.06);
            --shadow-md: 0 4px 14px rgba(0,0,0,0.06), 0 2px 6px rgba(0,0,0,0.04);
            --shadow-lg: 0 10px 30px rgba(0,0,0,0.08), 0 4px 12px rgba(0,0,0,0.05);
            --radius: 18px;
            --radius-sm: 12px;
            --radius-xs: 8px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            display: flex;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            overflow: hidden;
        }

        /* ── Sidebar ── */
        .sidebar {
            width: 260px;
            background: var(--sidebar);
            height: 100vh;
            color: white;
            padding: 2rem 1.25rem;
            position: fixed;
            left: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            z-index: 100;
            overflow-y: auto;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--white);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0;
            margin-bottom: 2.5rem;
            padding: 0 12px;
            letter-spacing: -0.5px;
        }

        .logo .dot { color: var(--brand); }

        .nav-label {
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: rgba(255,255,255,0.3);
            padding: 0 12px;
            margin-bottom: 8px;
            margin-top: 8px;
        }

        .nav-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex: 1;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(255,255,255,0.5);
            text-decoration: none;
            padding: 11px 14px;
            border-radius: var(--radius-sm);
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .nav-item i {
            width: 20px;
            text-align: center;
            font-size: 0.9rem;
        }

        .nav-item:hover {
            background: var(--sidebar-hover);
            color: rgba(255,255,255,0.9);
        }

        .nav-item.active {
            background: var(--brand);
            color: white;
            box-shadow: 0 4px 15px rgba(0,98,255,0.35);
        }

        .nav-item.logout {
            color: rgba(248,113,113,0.7);
            margin-top: auto;
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        .nav-item.logout:hover {
            color: #f87171;
            background: rgba(248,113,113,0.1);
        }

        /* ── Main Content ── */
        .main {
            margin-left: 260px;
            padding: 2rem 2.5rem;
            width: calc(100% - 260px);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .page-header {
            margin-bottom: 1.5rem;
            flex-shrink: 0;
        }

        .page-header h1 {
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: var(--text);
            margin: 0;
        }

        .page-header p {
            margin: 4px 0 0;
            color: var(--sub);
            font-size: 0.88rem;
            font-weight: 500;
        }

        .panel-grid {
            display: grid;
            grid-template-columns: 380px 1fr;
            gap: 24px;
            flex: 1;
            min-height: 0;
        }

        /* ── Glass Card ── */
        .panel-card {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius);
            box-shadow: var(--shadow-md);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .panel-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .panel-header h3 {
            margin: 0;
            font-size: 1rem;
            font-weight: 700;
            color: var(--text);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .panel-header h3 i {
            color: var(--brand);
            font-size: 0.95rem;
        }

        .panel-header .count-badge {
            background: var(--brand);
            color: white;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 20px;
            margin-left: auto;
        }

        .scrollable-area {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .scrollable-area::-webkit-scrollbar { width: 5px; }
        .scrollable-area::-webkit-scrollbar-track { background: transparent; }
        .scrollable-area::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 10px; }
        .scrollable-area::-webkit-scrollbar-thumb:hover { background: #9ca3af; }

        /* ── Thread List ── */
        .thread-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px 16px;
            border: 1px solid transparent;
            border-radius: var(--radius-sm);
            text-decoration: none;
            color: inherit;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .thread-item:hover {
            background: rgba(0,98,255,0.04);
            border-color: rgba(0,98,255,0.15);
        }

        .thread-item.active {
            background: rgba(0,98,255,0.07);
            border-color: var(--brand);
            box-shadow: 0 0 0 3px rgba(0,98,255,0.08);
        }

        .thread-avatar {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--brand), var(--brand-light));
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        .thread-content { flex: 1; min-width: 0; }

        .thread-title {
            margin: 0;
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .thread-meta {
            margin: 3px 0 0;
            font-size: 0.75rem;
            color: var(--sub);
            font-weight: 500;
        }

        .thread-right {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 6px;
            flex-shrink: 0;
        }

        .badge {
            font-size: 0.65rem;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .badge.open {
            background: #dcfce7;
            color: #15803d;
        }

        .badge.closed {
            background: #f1f5f9;
            color: #64748b;
        }

        /* ── Chat Panel ── */
        .chat-header {
            padding: 16px 24px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
            background: rgba(255,255,255,0.5);
        }

        .chat-header-info h4 {
            margin: 0;
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text);
        }

        .chat-header-info span {
            font-size: 0.75rem;
            color: var(--sub);
            font-weight: 500;
        }

        .status-toggle {
            border: none;
            border-radius: var(--radius-sm);
            font-size: 0.78rem;
            font-weight: 700;
            padding: 9px 18px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
            font-family: inherit;
        }

        .status-toggle.close {
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #fecaca;
        }

        .status-toggle.close:hover {
            background: #fee2e2;
        }

        .status-toggle.reopen {
            background: #f0fdf4;
            color: #16a34a;
            border: 1px solid #bbf7d0;
        }

        .status-toggle.reopen:hover {
            background: #dcfce7;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px 24px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        }

        .chat-messages::-webkit-scrollbar { width: 5px; }
        .chat-messages::-webkit-scrollbar-track { background: transparent; }
        .chat-messages::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 10px; }

        .chat-bubble {
            max-width: 70%;
            padding: 12px 16px;
            border-radius: 18px;
            font-size: 0.85rem;
            line-height: 1.5;
            font-weight: 500;
            word-wrap: break-word;
        }

        .chat-bubble.admin {
            background: var(--brand);
            color: white;
            align-self: flex-end;
            border-bottom-right-radius: 6px;
            box-shadow: 0 2px 8px rgba(0,98,255,0.2);
        }

        .chat-bubble.user {
            background: var(--white);
            color: var(--text);
            align-self: flex-start;
            border-bottom-left-radius: 6px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
        }

        .bubble-sender {
            font-size: 0.7rem;
            font-weight: 700;
            margin-bottom: 4px;
            opacity: 0.7;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .chat-bubble.user .bubble-sender { color: var(--brand); }

        .bubble-time {
            font-size: 0.65rem;
            display: block;
            margin-top: 6px;
            opacity: 0.6;
            text-align: right;
        }

        .chat-bubble.user .bubble-time {
            color: var(--sub);
            text-align: left;
        }

        .empty-chat {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            color: var(--sub);
            gap: 12px;
        }

        .empty-chat .empty-icon {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(0,98,255,0.08), rgba(0,98,255,0.02));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: var(--brand);
        }

        .empty-chat p {
            margin: 0;
            font-size: 0.88rem;
            font-weight: 600;
        }

        .empty-chat span {
            font-size: 0.78rem;
            color: #94a3b8;
            font-weight: 500;
        }

        /* ── Reply Form ── */
        .chat-form {
            padding: 16px 24px;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 10px;
            align-items: center;
            background: rgba(255,255,255,0.6);
            flex-shrink: 0;
        }

        .reply-input {
            flex: 1;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 0.88rem;
            padding: 12px 16px;
            font-family: inherit;
            font-weight: 500;
            background: var(--white);
            color: var(--text);
            transition: all 0.2s ease;
            outline: none;
        }

        .reply-input:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 3px rgba(0,98,255,0.1);
        }

        .reply-input::placeholder { color: #94a3b8; }

        .btn-send {
            background: var(--brand);
            border: none;
            color: white;
            border-radius: var(--radius-sm);
            font-size: 0.85rem;
            font-weight: 700;
            padding: 12px 22px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: inherit;
            white-space: nowrap;
        }

        .btn-send:hover {
            background: var(--brand-dark);
            box-shadow: 0 4px 12px rgba(0,98,255,0.3);
            transform: translateY(-1px);
        }

        /* ── Responsive ── */
        @media (max-width: 1100px) {
            .panel-grid { grid-template-columns: 1fr; }
            .panel-card { height: calc(100vh - 180px); }
        }

        @media (max-width: 768px) {
            .sidebar {
                width: 70px;
                padding: 1.5rem 0.75rem;
                align-items: center;
            }
            .logo { justify-content: center; padding: 0; font-size: 1.1rem; margin-bottom: 1.5rem; }
            .nav-label { display: none; }
            .nav-item { justify-content: center; padding: 12px; gap: 0; font-size: 0; }
            .nav-item i { font-size: 1.1rem; width: auto; }
            .nav-item.logout { padding-top: 16px; margin-top: auto; }
            .main { margin-left: 70px; width: calc(100% - 70px); padding: 1.5rem; }
            .chat-bubble { max-width: 90%; }
        }

        @media (max-width: 480px) {
            .sidebar { display: none; }
            .main { margin-left: 0; width: 100%; padding: 1rem; }
            .panel-grid { gap: 16px; }
        }

        /* ── Animations ── */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .panel-card { animation: fadeIn 0.3s ease; }
    </style>
</head>
<body>

    <nav class="sidebar">
        <div>
            <a href="/admin/dashboard" class="logo">PREPIUM<span class="dot">.</span></a>

            <div class="nav-group">
                <div class="nav-label">Main</div>
                <a href="/admin/dashboard" class="nav-item">
                    <i class="fas fa-th-large"></i> Dashboard
                </a>
                <a href="/admin/analytics" class="nav-item">
                    <i class="fas fa-chart-line"></i> Analytics
                </a>
                <a href="/admin/universities" class="nav-item">
                    <i class="fas fa-university"></i> Universities
                </a>

                <div class="nav-label" style="margin-top: 16px;">Management</div>
                <a href="/admin/users" class="nav-item">
                    <i class="fas fa-user-graduate"></i> Students
                </a>
                <a href="/admin/suggestions" class="nav-item active">
                    <i class="fas fa-lightbulb"></i> Suggestions
                </a>
                <a href="/admin/notifications" class="nav-item">
                    <i class="fas fa-bell"></i> Notifications
                </a>
                <a href="/admin/db-manager" class="nav-item">
                    <i class="fas fa-database"></i> DB Manager
                </a>
            </div>
        </div>
        <a href="/logout" class="nav-item logout">
            <i class="fas fa-sign-out-alt"></i> Logout
        </a>
    </nav>

    <main class="main">
        <div class="page-header">
            <h1>Suggestions & Support</h1>
            <p>Manage incoming feature suggestions and student support conversations.</p>
        </div>

        <div class="panel-grid">
            <!-- Thread List Panel -->
            <div class="panel-card">
                <div class="panel-header">
                    <h3>
                        <i class="fas fa-comments"></i>
                        Chat Threads
                        <% if (threads && threads.length > 0) { %>
                            <span class="count-badge"><%= threads.length %></span>
                        <% } %>
                    </h3>
                </div>
                <div class="scrollable-area">
                    <% if (threads && threads.length > 0) { %>
                        <% threads.forEach(t => { %>
                            <a href="/admin/suggestions?threadId=<%= t.id %>" class="thread-item <%= currentThread && currentThread.id === t.id ? 'active' : '' %>">
                                <div class="thread-avatar">
                                    <%= t.fullname ? t.fullname.charAt(0).toUpperCase() : 'U' %>
                                </div>
                                <div class="thread-content">
                                    <h4 class="thread-title"><%= t.title %></h4>
                                    <p class="thread-meta"><%= t.fullname %> &bull; <%= new Date(t.created_at).toLocaleDateString() %></p>
                                </div>
                                <div class="thread-right">
                                    <span class="badge <%= t.status === 'Open' ? 'open' : 'closed' %>"><%= t.status %></span>
                                </div>
                            </a>
                        <% }) %>
                    <% } else { %>
                        <div class="empty-chat">
                            <div class="empty-icon"><i class="fas fa-inbox"></i></div>
                            <p>No active threads yet.</p>
                            <span>Student conversations will appear here.</span>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Chat Panel -->
            <div class="panel-card">
                <% if (currentThread) { %>
                    <div class="chat-header">
                        <div class="chat-header-info">
                            <h4><%= currentThread.title %></h4>
                            <span>Started by <%= currentThread.fullname %> &bull; <%= new Date(currentThread.created_at).toLocaleDateString() %></span>
                        </div>
                        <form action="/admin/suggestions/status" method="POST">
                            <input type="hidden" name="thread_id" value="<%= currentThread.id %>">
                            <% if (currentThread.status === 'Open') { %>
                                <input type="hidden" name="status" value="Closed">
                                <button type="submit" class="status-toggle close">
                                    <i class="fas fa-times-circle"></i> Close Thread
                                </button>
                            <% } else { %>
                                <input type="hidden" name="status" value="Open">
                                <button type="submit" class="status-toggle reopen">
                                    <i class="fas fa-redo-alt"></i> Reopen Thread
                                </button>
                            <% } %>
                        </form>
                    </div>

                    <div class="chat-messages">
                        <% activeMessages.forEach(msg => { %>
                            <div class="chat-bubble <%= msg.sender_role.toLowerCase() %>">
                                <div class="bubble-sender"><%= msg.sender_role %></div>
                                <%= msg.message %>
                                <span class="bubble-time"><%= new Date(msg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                            </div>
                        <% }) %>
                    </div>

                    <form action="/admin/suggestions/reply" method="POST" class="chat-form">
                        <input type="hidden" name="thread_id" value="<%= currentThread.id %>">
                        <input type="text" name="message" class="reply-input" placeholder="Type your reply..." autocomplete="off" required>
                        <button type="submit" class="btn-send">
                            <i class="fas fa-paper-plane"></i> Reply
                        </button>
                    </form>
                <% } else { %>
                    <div class="empty-chat">
                        <div class="empty-icon"><i class="fas fa-headset"></i></div>
                        <p>Select a thread to get started</p>
                        <span>Pick a conversation from the list on the left.</span>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

<script src="/js/animations.js"></script>
</body>
</html>