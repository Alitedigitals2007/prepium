<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        :root {
            --danger: #ef4444;
            --success: #22c55e;
        }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--surface); color: var(--text-dark); margin: 0; padding: 20px; }
        .admin-wrapper { max-width: 900px; margin: 0 auto; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .status-pill { padding: 8px 16px; border-radius: 99px; font-size: 0.8rem; font-weight: 800; }
        .status-pill.success { background: var(--success-soft); color: var(--success); }
        .status-pill.danger { background: var(--danger-soft); color: var(--danger); }
        .glass-card { background: var(--surface-solid); padding: 30px; border-radius: 24px; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); border: 1px solid var(--border); margin-bottom: 30px; }
        .q-card { background: var(--surface); border: 1.5px solid var(--border); border-radius: 16px; padding: 20px; margin-bottom: 15px; }
        .q-card h4 { margin: 0 0 5px; color: var(--brand); font-size: 0.85rem; }
        .q-card .correct { color: var(--success); font-weight: 800; }
        .q-card .opt { color: var(--text-sub); }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th { text-align: left; font-size: 0.75rem; color: var(--text-sub); text-transform: uppercase; padding: 12px; border-bottom: 2px solid var(--border); }
        td { padding: 15px 12px; font-weight: 700; border-bottom: 1px solid var(--border); }
        .rank-num { color: var(--brand); font-weight: 800; }
        .badge { display: inline-block; padding: 4px 12px; border-radius: 99px; font-size: 0.7rem; font-weight: 800; }
        .badge-auto { background: var(--brand-soft); color: var(--brand); }
    </style>
<meta name="theme-color" content="#2563eb">
<%- include('../partials/theme-toggle') %>
</head>
<body>
    <div class="admin-wrapper">
        <header>
            <div>
                <h1 style="margin:0; font-weight:800;">Daily Arena</h1>
                <p style="color: var(--text-sub); margin: 5px 0 0;">AI-generated daily challenges — no manual entry needed</p>
            </div>
            <div class="status-pill success">
                Per-User Mode
            </div>
        </header>

        <section class="glass-card">
            <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 20px;">
                <div style="width: 50px; height: 50px; background: var(--brand-soft); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                    <i class="fas fa-user" style="color: var(--brand);"></i>
                </div>
                <div>
                    <h2 style="margin: 0; font-size: 1.2rem;">Personalised Daily Challenge</h2>
                    <p style="color: var(--text-sub); font-size: 0.85rem; margin: 5px 0 0;">
                        Questions are now personalised per user. Students pick a subject and get 20 AI-generated questions.
                        <br><strong>Today:</strong> <%= typeof todayChallenges !== 'undefined' ? todayChallenges : 0 %> challenges completed.
                    </p>
                </div>
            </div>
        </section>

        <section class="glass-card">
            <h2 style="margin-top:0; font-size: 1.2rem;">Weekly Leaderboard (Top 30)</h2>
            <table>
                <thead>
                    <tr><th>Rank</th><th>Student Name</th><th>Monthly Score</th></tr>
                </thead>
                <tbody>
                    <% if (leaderboard.length > 0) { %>
                        <% leaderboard.forEach((user, i) => { %>
                            <tr>
                                <td class="rank-num">#<%= i + 1 %></td>
                                <td><%= user.username %></td>
                                <td><%= user.monthly_score.toLocaleString() %> pts</td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="3" style="text-align:center; color:var(--text-sub);">No records yet.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </section>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <script src="/js/animations.js"></script>
</body>
</html>