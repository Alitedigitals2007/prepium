<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Arena | Prepium</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand: #0062ff;
            --brand-soft: #eef4ff;
            --text-dark: #0f172a;
            --text-sub: #64748b;
            --border: #e2e8f0;
            --danger: #ef4444;
            --success: #22c55e;
        }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f8fafc; color: var(--text-dark); margin: 0; padding: 20px; }
        .admin-wrapper { max-width: 900px; margin: 0 auto; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .status-pill { padding: 8px 16px; border-radius: 99px; font-size: 0.8rem; font-weight: 800; }
        .status-pill.success { background: #dcfce7; color: #166534; }
        .status-pill.danger { background: #fee2e2; color: #991b1b; }
        .glass-card { background: white; padding: 30px; border-radius: 24px; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); border: 1px solid var(--border); margin-bottom: 30px; }
        .q-card { background: #fdfdff; border: 1.5px solid var(--border); border-radius: 16px; padding: 20px; margin-bottom: 15px; }
        .q-card h4 { margin: 0 0 5px; color: var(--brand); font-size: 0.85rem; }
        .q-card .correct { color: var(--success); font-weight: 800; }
        .q-card .opt { color: var(--text-sub); }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th { text-align: left; font-size: 0.75rem; color: var(--text-sub); text-transform: uppercase; padding: 12px; border-bottom: 2px solid #f1f5f9; }
        td { padding: 15px 12px; font-weight: 700; border-bottom: 1px solid #f1f5f9; }
        .rank-num { color: var(--brand); font-weight: 800; }
        .badge { display: inline-block; padding: 4px 12px; border-radius: 99px; font-size: 0.7rem; font-weight: 800; }
        .badge-auto { background: #eef4ff; color: var(--brand); }
    </style>
</head>
<body>
    <div class="admin-wrapper">
        <header>
            <div>
                <h1 style="margin:0; font-weight:800;">Daily Arena</h1>
                <p style="color: var(--text-sub); margin: 5px 0 0;">AI-generated daily challenges — no manual entry needed</p>
            </div>
            <div class="status-pill <%= daysLeft < 2 ? 'danger' : 'success' %>">
                <%= daysLeft %> Days of Content Ready
            </div>
        </header>

        <section class="glass-card">
            <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 20px;">
                <div style="width: 50px; height: 50px; background: var(--brand-soft); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                    <i class="fas fa-robot" style="color: var(--brand);"></i>
                </div>
                <div>
                    <h2 style="margin: 0; font-size: 1.2rem;">Auto-Generation Active</h2>
                    <p style="color: var(--text-sub); font-size: 0.85rem; margin: 5px 0 0;">
                        Questions are automatically generated by AI each day when the first student visits.
                        Admin manual entry is no longer required.
                    </p>
                </div>
            </div>
        </section>

        <section class="glass-card">
            <h2 style="margin-top:0; font-size: 1.1rem;">
                <i class="fas fa-star" style="color: var(--brand);"></i> Today's Questions
            </h2>
            <% if (todayQuestions.length > 0) { %>
                <% todayQuestions.forEach((q, i) => { %>
                    <div class="q-card">
                        <div style="display: flex; justify-content: space-between; align-items: start;">
                            <h4>Q<%= i + 1 %> <span class="badge badge-auto">Auto</span></h4>
                        </div>
                        <p style="font-weight: 700; margin: 8px 0;"><%= q.question_text %></p>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 0.85rem;">
                            <div class="<%= q.correct_option === 'A' ? 'correct' : 'opt' %>">A. <%= q.option_a %></div>
                            <div class="<%= q.correct_option === 'B' ? 'correct' : 'opt' %>">B. <%= q.option_b %></div>
                            <div class="<%= q.correct_option === 'C' ? 'correct' : 'opt' %>">C. <%= q.option_c %></div>
                            <div class="<%= q.correct_option === 'D' ? 'correct' : 'opt' %>">D. <%= q.option_d %></div>
                        </div>
                        <% if (q.explanation) { %>
                            <p style="font-size: 0.8rem; color: var(--text-sub); margin: 8px 0 0;"><b>Explanation:</b> <%= q.explanation %></p>
                        <% } %>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="color: var(--text-sub); text-align: center; padding: 30px 0;">
                    <i class="fas fa-hourglass-half" style="font-size: 2rem; display: block; margin-bottom: 10px;"></i>
                    No questions generated yet today. They'll appear automatically when the first student visits the daily challenge page.
                </p>
            <% } %>
        </section>

        <section class="glass-card">
            <h2 style="margin-top:0; font-size: 1.2rem;">Monthly Leaderboard (Top 30)</h2>
            <table>
                <thead>
                    <tr><th>Rank</th><th>Student Name</th><th>Monthly Score</th></tr>
                </thead>
                <tbody>
                    <% if (leaderboard.length > 0) { %>
                        <% leaderboard.forEach((user, i) => { %>
                            <tr>
                                <td class="rank-num">#<%= i + 1 %></td>
                                <td><%= user.username %></td>
                                <td><%= user.monthly_score.toLocaleString() %> pts</td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="3" style="text-align:center; color:var(--text-sub);">No records yet.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </section>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <script src="/js/animations.js"></script>
</body>
</html>