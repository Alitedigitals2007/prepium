<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prepium Admin | Student Directory</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { 
            --brand: #0062ff; 
            --brand-light: #eef4ff;
            --bg: #f4f7fe; 
            --sidebar: #0b1437; 
            --text-main: #1b2559; 
            --text-muted: #a3aed0;
            --border: #e0e5f2; 
            --success: #05cd99;
            --danger: #ee5d50;
        }

        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); margin: 0; display: flex; color: var(--text-main); }
        
        /* Sidebar */
        .sidebar { width: 260px; background: var(--sidebar); height: 100vh; padding: 2.5rem 1.5rem; position: fixed; color: white; box-sizing: border-box; z-index: 100; }
        .logo { font-size: 1.5rem; font-weight: 800; margin-bottom: 3rem; display: block; text-decoration: none; color: white; letter-spacing: -1px; }
        .nav-item { display: flex; align-items: center; color: #a3aed0; text-decoration: none; padding: 16px; border-radius: 12px; margin-bottom: 5px; font-weight: 700; transition: 0.3s; }
        .nav-item:hover, .nav-item.active { background: rgba(255, 255, 255, 0.1); color: white; }

        /* Main Content */
        .main { margin-left: 260px; padding: 2.5rem 3rem; width: calc(100% - 260px); box-sizing: border-box; }
        .header { margin-bottom: 1.5rem; }
        .header h1 { font-size: 1.8rem; font-weight: 800; margin: 0; }

        /* Stats Grid */
        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 2rem; }
        .stat-card { background: white; padding: 20px; border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.02); display: flex; flex-direction: column; }
        .stat-label { font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; }
        .stat-value { font-size: 1.5rem; font-weight: 800; color: var(--text-main); }
        .stat-card.premium-card { border-bottom: 4px solid var(--success); }
        
        /* Search & Filter Card */
        .filter-card { background: white; padding: 20px; border-radius: 24px; margin-bottom: 2rem; display: flex; gap: 15px; align-items: center; box-shadow: 0 10px 40px rgba(0,0,0,0.02); }
        .search-group { flex: 2; position: relative; }
        .search-input { width: 100%; padding: 14px 20px; border-radius: 14px; border: 1px solid var(--border); background: #f4f7fe; font-family: inherit; font-weight: 600; box-sizing: border-box; }
        .filter-select { flex: 1; padding: 14px; border-radius: 14px; border: 1px solid var(--border); background: #f4f7fe; font-weight: 600; cursor: pointer; }
        .btn-filter { background: var(--brand); color: white; border: none; padding: 14px 28px; border-radius: 14px; font-weight: 800; cursor: pointer; transition: 0.2s; }
        .btn-filter:hover { background: #0052d4; transform: translateY(-1px); }

        /* Table Design */
        .table-container { background: white; border-radius: 24px; padding: 10px; box-shadow: 0 10px 40px rgba(0,0,0,0.02); overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; min-width: 800px; }
        th { padding: 20px 15px; color: var(--text-muted); font-size: 0.7rem; text-transform: uppercase; font-weight: 800; letter-spacing: 1px; border-bottom: 1px solid var(--border); text-align: left; }
        td { padding: 20px 15px; border-bottom: 1px solid #f4f7fe; font-size: 0.9rem; font-weight: 600; }

        /* Status Badges */
        .badge { padding: 6px 12px; border-radius: 10px; font-size: 0.7rem; font-weight: 800; display: inline-block; }
        .status-premium { background: #e6fffb; color: var(--success); }
        .status-basic { background: #fff1f0; color: var(--danger); }

        .action-select { padding: 10px; border-radius: 10px; border: 1px solid var(--border); font-size: 0.8rem; font-weight: 700; background: white; cursor: pointer; outline: none; }
        .student-info .name { display: block; font-weight: 800; color: var(--text-main); font-size: 0.95rem; }
        .student-info .email { display: block; font-size: 0.75rem; color: var(--text-muted); font-weight: 600; }
    </style>
</head>
<body>

    <div class="sidebar">
        <a href="/admin/dashboard" class="logo">PREPIUM</a>
        <a href="/admin/dashboard" class="nav-item">🏠 Dashboard</a>
        <a href="/admin/universities" class="nav-item">🏛️ Universities</a>
        <a href="/admin/subjects" class="nav-item">📚 Subjects</a>
        <a href="/admin/students" class="nav-item active">👥 Students</a>
        <a href="/admin/notifications" class="nav-item">🔔 Notifications</a>
    </div>

    <main class="main">
        <div class="header">
            <h1>Student Management</h1>
            <p style="color: var(--text-muted); margin-top: 5px;">View analytics and manage student access levels.</p>
        </div>

        <!-- STATISTICS OVERVIEW -->
        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-label">Total Registered</span>
                <span class="stat-value"><%= stats.total %></span>
            </div>
            <div class="stat-card premium-card">
                <span class="stat-label" style="color: var(--success);">Premium Users</span>
                <span class="stat-value"><%= stats.premium %></span>
            </div>
            <div class="stat-card">
                <span class="stat-label" style="color: var(--danger);">Basic Users</span>
                <span class="stat-value"><%= stats.basic %></span>
            </div>
        </div>
        
        <!-- Search & School Filter -->
        <form action="/admin/students" method="GET" class="filter-card">
            <div class="search-group">
                <input type="text" name="search" class="search-input" placeholder="Search name or email..." value="<%= filters.search || '' %>">
            </div>
            <select name="school" class="filter-select">
                <option value="">All Universities</option>
                <% universities.forEach(uni => { %>
                    <option value="<%= uni.id %>" <%= filters.school == uni.id ? 'selected' : '' %>><%= uni.name %></option>
                <% }) %>
            </select>
            <button type="submit" class="btn-filter">Update View</button>
        </form>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Student Name & Email</th>
                        <th>University</th>
                        <th>Current Plan</th>
                        <th>Registration Date</th>
                        <th>Manage Plan</th>
                    </tr>
                </thead>
                <tbody>
                    <% students.forEach(user => { %>
                    <tr>
                        <td>
                            <div class="student-info">
                                <!-- Using fullname as per database schema -->
                                <span class="name"><%= user.fullname %></span>
                                <span class="email"><%= user.email %></span>
                            </div>
                        </td>
                        <td><%= user.school_name || 'Not Specified' %></td>
                        <td>
                            <% if (user.has_paid) { %>
                                <span class="badge status-premium">PREMIUM</span>
                            <% } else { %>
                                <span class="badge status-basic">BASIC</span>
                            <% } %>
                        </td>
                        <td style="color: var(--text-muted); font-size: 0.8rem;">
                            <%= new Date(user.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </td>
                        <td>
                            <form action="/admin/students/toggle-status/<%= user.id %>" method="POST">
                                <select name="has_paid" class="action-select" onchange="this.form.submit()">
                                    <option value="false" <%= !user.has_paid ? 'selected' : '' %>>Basic</option>
                                    <option value="true" <%= user.has_paid ? 'selected' : '' %>>Premium</option>
                                </select>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                    
                    <% if (students.length === 0) { %>
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 60px; color: var(--text-muted);">
                                No student records match your current filters.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>
</body>
</html>