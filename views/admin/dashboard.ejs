<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        :root {
            --brand: #2563eb;
            --brand-light: rgba(37, 99, 235, 0.08);
            --brand-glow: rgba(37, 99, 235, 0.25);
            --sidebar: #0b1437;
            --sidebar-hover: rgba(255, 255, 255, 0.06);
            --sidebar-active: rgba(0, 98, 255, 0.18);
            --bg: #f0f4f8;
            --card: rgba(255, 255, 255, 0.72);
            --card-solid: #ffffff;
            --text-primary: #0f172a;
            --text-secondary: #64748b;
            --text-muted: #94a3b8;
            --border: rgba(226, 232, 240, 0.6);
            --border-solid: #e2e8f0;
            --indigo: #2563eb;
            --green: #16a34a;
            --green-bg: #dcfce7;
            --amber: #f59e0b;
            --amber-bg: #fef3c7;
            --rose: #f43f5e;
            --rose-bg: #ffe4e6;
            --blue: #3b82f6;
            --blue-bg: #dbeafe;
            --radius: 16px;
            --radius-sm: 10px;
            --shadow-sm: 0 1px 3px rgba(0,0,0,0.04), 0 1px 2px rgba(0,0,0,0.02);
            --shadow: 0 4px 24px rgba(0,0,0,0.06), 0 1px 4px rgba(0,0,0,0.03);
            --shadow-lg: 0 12px 40px rgba(0,0,0,0.08);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            display: flex;
            background: var(--bg);
            color: var(--text-primary);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Sidebar ── */
        .sidebar {
            width: 264px;
            background: var(--sidebar);
            height: 100vh;
            color: white;
            padding: 28px 16px;
            position: fixed;
            left: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            z-index: 200;
            overflow-y: auto;
            scrollbar-width: none;
        }
        .sidebar::-webkit-scrollbar { display: none; }

        .logo {
            font-size: 1.4rem;
            font-weight: 800;
            color: white;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 2px;
            letter-spacing: -0.5px;
            padding: 0 12px;
            margin-bottom: 8px;
        }
        .logo .dot { color: var(--brand); }

        .sidebar-section {
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: rgba(255,255,255,0.3);
            padding: 0 12px;
            margin-top: 28px;
            margin-bottom: 10px;
        }

        .nav-group {
            display: flex;
            flex-direction: column;
            gap: 3px;
            flex: 1;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(255,255,255,0.5);
            text-decoration: none;
            padding: 11px 14px;
            border-radius: var(--radius-sm);
            font-size: 0.84rem;
            font-weight: 600;
            transition: all 0.2s ease;
            position: relative;
        }
        .nav-item i {
            width: 20px;
            text-align: center;
            font-size: 0.92rem;
        }
        .nav-item:hover {
            background: var(--sidebar-hover);
            color: rgba(255,255,255,0.9);
        }
        .nav-item.active {
            background: var(--sidebar-active);
            color: white;
        }
        .nav-item.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 3px;
            height: 20px;
            background: var(--brand);
            border-radius: 0 3px 3px 0;
        }
        .nav-item.logout {
            color: rgba(244, 63, 94, 0.7);
            margin-top: 6px;
        }
        .nav-item.logout:hover {
            background: rgba(244, 63, 94, 0.1);
            color: #f43f5e;
        }

        /* ── Main Content ── */
        .main {
            margin-left: 264px;
            padding: 32px;
            width: calc(100% - 264px);
            min-height: 100vh;
        }

        /* ── Welcome Banner ── */
        .welcome-banner {
            background: linear-gradient(135deg, var(--sidebar) 0%, #162050 50%, #1a2a6c 100%);
            border-radius: var(--radius);
            padding: 32px 36px;
            color: white;
            margin-bottom: 28px;
            position: relative;
            overflow: hidden;
        }
        .welcome-banner::before {
            content: '';
            position: absolute;
            top: -40%;
            right: -10%;
            width: 320px;
            height: 320px;
            background: radial-gradient(circle, rgba(37,99,235,0.2) 0%, transparent 70%);
            border-radius: 50%;
        }
        .welcome-banner::after {
            content: '';
            position: absolute;
            bottom: -50%;
            right: 10%;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(99,102,241,0.15) 0%, transparent 70%);
            border-radius: 50%;
        }
        .welcome-banner h1 {
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 6px;
            position: relative;
            z-index: 1;
        }
        .welcome-banner p {
            color: rgba(255,255,255,0.6);
            font-weight: 500;
            font-size: 0.9rem;
            position: relative;
            z-index: 1;
        }

        /* ── Stats Grid ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 28px;
        }
        .stat-card {
            background: var(--card);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 22px 24px;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            position: relative;
            overflow: hidden;
            transition: all 0.25s ease;
        }
        .stat-card:hover {
            box-shadow: var(--shadow);
            transform: translateY(-2px);
        }
        .stat-card::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            border-radius: 4px 0 0 4px;
        }
        .stat-card.indigo::before { background: var(--indigo); }
        .stat-card.green::before { background: var(--green); }
        .stat-card.amber::before { background: var(--amber); }
        .stat-card.blue::before { background: var(--blue); }
        .stat-card.rose::before { background: var(--rose); }

        .stat-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }
        .stat-label {
            font-size: 0.72rem;
            color: var(--text-secondary);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .stat-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.88rem;
        }
        .stat-icon.indigo { background: rgba(99,102,241,0.1); color: var(--indigo); }
        .stat-icon.green { background: rgba(22,163,74,0.1); color: var(--green); }
        .stat-icon.amber { background: rgba(245,158,11,0.1); color: var(--amber); }
        .stat-icon.blue { background: rgba(59,130,246,0.1); color: var(--blue); }
        .stat-icon.rose { background: rgba(244,63,94,0.1); color: var(--rose); }

        .stat-value {
            font-size: 1.9rem;
            font-weight: 800;
            color: var(--text-primary);
            letter-spacing: -1px;
            line-height: 1;
        }

        /* ── Table Card ── */
        .table-card {
            background: var(--card);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 26px;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
        }
        .table-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }
        .table-header h3 {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--text-primary);
        }
        .table-header .badge {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--brand);
            background: var(--brand-light);
            padding: 5px 12px;
            border-radius: 20px;
        }

        .table-responsive { width: 100%; overflow-x: auto; }

        table { width: 100%; border-collapse: collapse; text-align: left; }

        th {
            padding: 12px 16px;
            font-size: 0.7rem;
            color: var(--text-muted);
            border-bottom: 2px solid var(--border-solid);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 700;
        }
        td {
            padding: 14px 16px;
            border-bottom: 1px solid #f1f5f9;
            font-size: 0.86rem;
        }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: rgba(37,99,235,0.02); }

        .user-info { display: flex; flex-direction: column; gap: 2px; }
        .user-name { font-weight: 700; color: var(--text-primary); }
        .user-email { font-size: 0.78rem; color: var(--text-muted); font-weight: 500; }

        .university-tag {
            font-weight: 600;
            color: var(--text-secondary);
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }
        .status-paid { background: var(--green-bg); color: var(--green); }
        .status-free { background: #f1f5f9; color: var(--text-muted); }
        .status i { font-size: 0.55rem; }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
            font-weight: 600;
        }
        .empty-state i {
            font-size: 2rem;
            margin-bottom: 12px;
            display: block;
            color: var(--border-solid);
        }

        /* ── Responsive ── */
        @media (max-width: 1200px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 768px) {
            .sidebar {
                width: 72px;
                padding: 20px 8px;
            }
            .logo { justify-content: center; padding: 0; }
            .sidebar-section { display: none; }
            .nav-item span { display: none; }
            .nav-item { justify-content: center; padding: 12px; }
            .nav-item i { margin: 0; }
            .main { margin-left: 72px; width: calc(100% - 72px); padding: 20px; }
            .stats-grid { grid-template-columns: 1fr; }
            .welcome-banner { padding: 24px; }
            .welcome-banner h1 { font-size: 1.3rem; }
        }
        @media (max-width: 480px) {
            .sidebar { width: 56px; padding: 16px 4px; }
            .main { margin-left: 56px; width: calc(100% - 56px); padding: 12px; }
            .stat-card { padding: 16px; }
            .stat-value { font-size: 1.4rem; }
            .table-card { padding: 16px; }
            th, td { padding: 10px 8px; font-size: 0.75rem; }
        }
    </style>
<meta name="theme-color" content="#2563eb">
<%- include('../partials/theme-toggle') %>
</head>
<body>

    <nav class="sidebar">
        <a href="/admin/dashboard" class="logo">PREPIUM<span class="dot">.</span></a>

        <div class="nav-group">
            <span class="sidebar-section">Main</span>
            <a href="/admin/dashboard" class="nav-item active">
                <i class="fas fa-th-large"></i>
                <span>Dashboard</span>
            </a>
            <a href="/admin/analytics" class="nav-item">
                <i class="fas fa-chart-line"></i>
                <span>Analytics</span>
            </a>

            <span class="sidebar-section">Dev</span>
            <a href="/admin/db-manager" class="nav-item">
                <i class="fas fa-database"></i>
                <span>DB Manager</span>
            </a>

            <span class="sidebar-section">Manage</span>
            <a href="/admin/universities" class="nav-item">
                <i class="fas fa-building-columns"></i>
                <span>Universities</span>
            </a>
            <a href="/admin/coupons" class="nav-item">
                <i class="fas fa-ticket"></i>
                <span>Coupons</span>
            </a>
            <a href="/admin/daily" class="nav-item">
                <i class="fas fa-fire-flame-curved"></i>
                <span>Daily Arena</span>
            </a>
            <a href="/admin/quiz-generator" class="nav-item">
                <i class="fas fa-bolt"></i>
                <span>Quiz Generator</span>
            </a>

            <span class="sidebar-section">People</span>
            <a href="/admin/students" class="nav-item">
                <i class="fas fa-user-graduate"></i>
                <span>Students</span>
            </a>
            <a href="/admin/ambassadors" class="nav-item">
                <i class="fas fa-gift"></i>
                <span>Referrals</span>
            </a>

            <span class="sidebar-section">Finance</span>
            <a href="/admin/withdrawals" class="nav-item">
                <i class="fas fa-credit-card"></i>
                <span>Withdrawals</span>
            </a>

            <span class="sidebar-section">System</span>
            <a href="/admin/suggestions" class="nav-item">
                <i class="fas fa-lightbulb"></i>
                <span>Suggestions</span>
            </a>
            <a href="/admin/notifications" class="nav-item">
                <i class="fas fa-bell"></i>
                <span>Notifications</span>
            </a>
            <a href="/admin/email" class="nav-item">
                <i class="fas fa-envelope"></i>
                <span>Send Email</span>
            </a>
            <a href="/admin/groups" class="nav-item">
                <i class="fas fa-layer-group"></i>
                <span>Groups</span>
            </a>
        </div>

        <a href="/logout" class="nav-item logout">
            <i class="fas fa-right-from-bracket"></i>
            <span>Logout</span>
        </a>
    </nav>

    <main class="main">
        <div class="welcome-banner">
            <h1>Welcome back, Admin</h1>
            <p>Here's what's happening with Prepium today.</p>
        </div>

        <div class="stats-grid">
            <div class="stat-card indigo">
                <div class="stat-header">
                    <span class="stat-label">Institutions</span>
                    <div class="stat-icon indigo"><i class="fas fa-building-columns"></i></div>
                </div>
                <span class="stat-value"><%= stats.universities || 0 %></span>
            </div>
            <div class="stat-card green">
                <div class="stat-header">
                    <span class="stat-label">Total Students</span>
                    <div class="stat-icon green"><i class="fas fa-user-graduate"></i></div>
                </div>
                <span class="stat-value"><%= stats.students %></span>
            </div>
            <div class="stat-card amber">
                <div class="stat-header">
                    <span class="stat-label">Premium Users</span>
                    <div class="stat-icon amber"><i class="fas fa-crown"></i></div>
                </div>
                <span class="stat-value"><%= stats.premium %></span>
            </div>
            <div class="stat-card blue">
                <div class="stat-header">
                    <span class="stat-label">Subjects</span>
                    <div class="stat-icon blue"><i class="fas fa-book-open"></i></div>
                </div>
                <span class="stat-value"><%= stats.subjects %></span>
            </div>
        </div>

        <div class="table-card">
            <div class="table-header">
                <h3>Recent Signups</h3>
                <span class="badge"><%= (locals.recentUsers && recentUsers.length) ? recentUsers.length + ' users' : '0 users' %></span>
            </div>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>University</th>
                            <th>Plan</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (locals.recentUsers && recentUsers.length > 0) { %>
                            <% recentUsers.forEach(function(user) { %>
                            <tr>
                                <td>
                                    <div class="user-info">
                                        <span class="user-name"><%= user.fullname %></span>
                                        <span class="user-email"><%= user.email %></span>
                                    </div>
                                </td>
                                <td><span class="university-tag"><%= user.university_name || 'Not Specified' %></span></td>
                                <td>
                                    <span class="status <%= user.has_paid ? 'status-paid' : 'status-free' %>">
                                        <i class="fas <%= user.has_paid ? 'fa-circle-check' : 'fa-circle' %>"></i>
                                        <%= user.has_paid ? 'Premium' : 'Basic' %>
                                    </span>
                                </td>
                            </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="3">
                                    <div class="empty-state">
                                        <i class="fas fa-users"></i>
                                        No new signups recorded yet.
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

<script src="/js/animations.js"></script>
</body>
</html>
