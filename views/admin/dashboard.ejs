<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prepium Admin | Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { 
            --brand: #0062ff; 
            --bg: #f8fafc; 
            --sidebar: #1e293b; 
        }
        * { box-sizing: border-box; }
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            margin: 0; 
            display: flex; 
            background: var(--bg); 
            color: #1e293b; 
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar { 
            width: 260px; 
            background: var(--sidebar); 
            height: 100vh; 
            color: white; 
            padding: 2rem 1.5rem; 
            position: fixed; 
            left: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            z-index: 100;
        }
        .logo { 
            font-size: 1.5rem; 
            font-weight: 800; 
            color: var(--brand); 
            text-decoration: none; 
            display: block; 
            letter-spacing: -0.5px;
            margin-bottom: 2.5rem;
        }
        .logo span { color: white; }
        
        .nav-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex: 1;
        }
        .nav-item { 
            display: flex;
            align-items: center;
            gap: 12px;
            color: #94a3b8; 
            text-decoration: none; 
            padding: 12px 16px; 
            border-radius: 12px; 
            font-size: 0.88rem;
            font-weight: 600; 
            transition: all 0.3s ease; 
        }
        .nav-item:hover, .nav-item.active { 
            background: rgba(255, 255, 255, 0.08); 
            color: white; 
        }
        .nav-item.logout {
            color: #f87171;
            margin-top: auto;
        }

        /* Main Viewport */
        .main { 
            margin-left: 260px; 
            padding: 3rem; 
            width: calc(100% - 260px); 
            min-height: 100vh;
        }
        .welcome { margin-bottom: 2.5rem; }
        .welcome h1 { 
            margin: 0; 
            font-size: 1.75rem; 
            font-weight: 800; 
            letter-spacing: -0.5px;
        }
        .welcome p { 
            margin: 5px 0 0; 
            color: #64748b; 
            font-weight: 600;
            font-size: 0.9rem;
        }
        
        /* Stats Grid */
        .stats-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); 
            gap: 20px; 
            margin-bottom: 2.5rem; 
        }
        .stat-card { 
            background: white; 
            padding: 1.6rem; 
            border-radius: 20px; 
            border: 1px solid #e2e8f0; 
        }
        .stat-label { 
            font-size: 0.72rem; 
            color: #64748b; 
            font-weight: 800; 
            text-transform: uppercase; 
            letter-spacing: 0.5px; 
        }
        .stat-value { 
            font-size: 2rem; 
            font-weight: 800; 
            margin-top: 6px; 
            display: block; 
            color: #0f172a;
        }

        /* Table Card */
        .table-card { 
            background: white; 
            padding: 2rem; 
            border-radius: 24px; 
            border: 1px solid #e2e8f0; 
        }
        .table-card h3 { margin: 0 0 1.2rem 0; font-size: 1.15rem; font-weight: 800; }
        
        .table-responsive { width: 100%; overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th { padding: 14px 16px; font-size: 0.75rem; color: #64748b; border-bottom: 2px solid #f1f5f9; text-transform: uppercase; }
        td { padding: 14px 16px; border-bottom: 1px solid #f1f5f9; font-size: 0.88rem; }
        
        .status { padding: 4px 10px; border-radius: 8px; font-size: 0.68rem; font-weight: 800; }
        .status-paid { background: #dcfce7; color: #15803d; }
        .status-free { background: #f1f5f9; color: #64748b; }
    </style>
</head>
<body>

    <nav class="sidebar">
        <div style="width: 100%;">
            <a href="/admin/dashboard" class="logo">PREPIUM<span>.</span></a>
            
            <div class="nav-group">
                <a href="/admin/dashboard" class="nav-item active">🏠 Dashboard</a>
                <!-- New University Management Link -->
                <a href="/admin/universities" class="nav-item">🏛️ Universities</a>
                <a href="/admin/subjects" class="nav-item">📚 Manage Subjects</a>
                <a href="/admin/notifications" class="nav-item">🔔 Notifications</a>
                <a href="/admin/students" class="nav-item">👥 Students</a>
                <a href="/admin/suggestions" class="nav-item">💡 Suggestions</a>
            </div>
        </div>

        <a href="/logout" class="nav-item logout">🚪 Logout</a>
    </nav>

    <main class="main">
        <div class="welcome">
            <!-- Dynamic Personalization -->
            <h1>Alite's Command Center</h1>
            <p>Overview of Prepium performance and growth.</p>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-label">Institutions</span>
                <span class="stat-value" style="color: #6366f1;"><%= stats.universities || 0 %></span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Total Students</span>
                <span class="stat-value"><%= stats.students %></span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Premium Users</span>
                <span class="stat-value" style="color: #16a34a;"><%= stats.premium %></span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Subjects</span>
                <span class="stat-value" style="color: var(--brand);"><%= stats.subjects %></span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Questions</span>
                <span class="stat-value" style="color: #f59e0b;"><%= stats.questions %></span>
            </div>
        </div>

        <div class="table-card">
            <h3>Recent Signups</h3>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>University</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (locals.recentUsers && recentUsers.length > 0) { %>
                            <% recentUsers.forEach(user => { %>
                            <tr>
                                <td><b><%= user.fullname %></b><br><small style="color: #94a3b8;"><%= user.email %></small></td>
                                <!-- Shows which school they attend -->
                                <td><span style="font-weight: 600;"><%= user.university_name || 'Not Specified' %></span></td>
                                <td>
                                    <span class="status <%= user.has_paid ? 'status-paid' : 'status-free' %>">
                                        <%= user.has_paid ? 'PREMIUM' : 'BASIC' %>
                                    </span>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" style="text-align: center; color: #94a3b8; font-weight: 600; padding: 25px 0;">No new signups recorded yet.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

</body>
</html>