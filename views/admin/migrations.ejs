<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Free Migrations · Prepium</title>
    <%- include('../partials/head') %>
    <%- include('../partials/theme-toggle') %>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            display: flex;
            background: var(--bg);
            color: var(--text-primary);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Sidebar ── */
        .sidebar {
            width: 264px; background: var(--sidebar,#0b1437); height: 100vh; color: white;
            padding: 28px 16px; position: fixed; left: 0; top: 0; display: flex;
            flex-direction: column; z-index: 200; overflow-y: auto; scrollbar-width: none;
        }
        .sidebar::-webkit-scrollbar { display: none; }
        .logo { font-size: 1.4rem; font-weight: 800; color: white; text-decoration: none; display: flex; align-items: center; gap: 2px; letter-spacing: -0.5px; padding: 0 12px; margin-bottom: 8px; }
        .logo .dot { color: var(--brand); }
        .sidebar-section { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: rgba(255,255,255,0.3); padding: 0 12px; margin-top: 28px; margin-bottom: 10px; }
        .nav-group { display: flex; flex-direction: column; gap: 3px; flex: 1; }
        .nav-item { display: flex; align-items: center; gap: 12px; color: rgba(255,255,255,0.5); text-decoration: none; padding: 11px 14px; border-radius: var(--radius-sm); font-size: 0.84rem; font-weight: 600; transition: all 0.2s ease; position: relative; }
        .nav-item i { width: 20px; text-align: center; font-size: 0.92rem; }
        .nav-item:hover { background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.9); }
        .nav-item.active { background: rgba(0,98,255,0.18); color: white; }
        .nav-item.active::before { content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 3px; height: 20px; background: var(--brand); border-radius: 0 3px 3px 0; }
        .nav-item.logout { color: rgba(244, 63, 94, 0.7); margin-top: 6px; }
        .nav-item.logout:hover { background: rgba(244, 63, 94, 0.1); color: #f43f5e; }

        /* ── Main ── */
        .main { margin-left: 264px; padding: 32px; width: calc(100% - 264px); min-height: 100vh; }
        .page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 26px; }
        .page-head h1 { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.5px; }
        .page-head p { color: var(--text-secondary); font-weight: 500; font-size: 0.85rem; margin-top: 3px; }

        .flash { padding: 12px 16px; border-radius: var(--radius-sm); margin-bottom: 20px; font-size: 0.85rem; font-weight: 700; }
        .flash.msg { background: var(--success-soft); color: var(--success); }
        .flash.error { background: var(--danger-soft); color: var(--danger); }

        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 28px; }
        .stat-card { background: var(--card); padding: 22px 24px; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-sm); position: relative; overflow: hidden; }
        .stat-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; }
        .stat-card.blue::before { background: var(--brand); }
        .stat-card.green::before { background: #16a34a; }
        .stat-card.rose::before { background: #f43f5e; }
        .stat-label { font-size: 0.72rem; color: var(--text-secondary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; }
        .stat-value { font-size: 1.9rem; font-weight: 800; letter-spacing: -1px; line-height: 1; }

        .card { background: var(--card); padding: 26px; border-radius: var(--radius); border: 1px solid var(--border); box-shadow: var(--shadow-sm); margin-bottom: 24px; }
        .card h3 { font-size: 1.05rem; font-weight: 800; margin-bottom: 4px; }
        .card .sub { color: var(--text-secondary); font-size: 0.8rem; font-weight: 500; margin-bottom: 20px; }

        .form-row { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
        .form-row label { font-size: 0.85rem; font-weight: 700; min-width: 180px; }
        .form-row input[type="number"] { flex: 1; max-width: 200px; padding: 11px 14px; border-radius: var(--radius-sm); border: 1px solid var(--border-solid); background: var(--bg); color: var(--text-primary); font-weight: 700; font-size: 0.9rem; }
        .form-row input[type="number"]:focus { outline: none; border-color: var(--brand); }

        .feature-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px; margin-bottom: 22px; }
        .feature-chip { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--radius-sm); cursor: pointer; transition: all 0.2s ease; background: var(--bg); }
        .feature-chip:hover { border-color: var(--brand); }
        .feature-chip.checked { border-color: var(--brand); background: var(--brand-soft); }
        .feature-chip input { display: none; }
        .feature-chip .fc-icon { width: 30px; height: 30px; border-radius: 9px; background: var(--brand-light); color: var(--brand); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; flex-shrink: 0; }
        .feature-chip .fc-label { font-size: 0.8rem; font-weight: 700; }

        .btn { padding: 12px 22px; border-radius: var(--radius-sm); font-weight: 800; font-size: 0.82rem; border: none; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s ease; }
        .btn-primary { background: var(--brand); color: white; }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: var(--shadow); }
        .btn-danger { background: var(--danger); color: white; }
        .btn-ghost { background: var(--surface); color: var(--text-primary); border: 1px solid var(--border-solid); }
        .btn-sm { padding: 8px 14px; font-size: 0.74rem; }

        .danger-zone { border: 1px solid var(--danger-soft); background: var(--danger-soft, #fef2f2); }
        .danger-zone h3 { color: var(--danger); }
        .danger-actions { display: flex; gap: 12px; flex-wrap: wrap; }

        .table-responsive { width: 100%; overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; text-align: left; }
        th { padding: 12px 16px; font-size: 0.7rem; color: var(--text-muted); border-bottom: 2px solid var(--border-solid); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; }
        td { padding: 14px 16px; border-bottom: 1px solid var(--border); font-size: 0.86rem; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: rgba(37,99,235,0.02); }
        .user-info { display: flex; flex-direction: column; gap: 2px; }
        .user-name { font-weight: 700; }
        .user-email { font-size: 0.78rem; color: var(--text-muted); font-weight: 500; }
        .status { display: inline-flex; align-items: center; gap: 5px; padding: 5px 12px; border-radius: 20px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; }
        .status-paid { background: var(--green-bg, #dcfce7); color: #16a34a; }
        .status-locked { background: var(--danger-soft, #fee2e2); color: #dc2626; }
        .empty-state { text-align: center; padding: 40px 20px; color: var(--text-muted); font-weight: 600; }
        .empty-state i { font-size: 2rem; margin-bottom: 12px; display: block; color: var(--border-solid); }

        @media (max-width: 1000px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 768px) {
            .sidebar { width: 72px; padding: 20px 8px; }
            .logo { justify-content: center; padding: 0; }
            .sidebar-section { display: none; }
            .nav-item span { display: none; }
            .nav-item { justify-content: center; padding: 12px; }
            .main { margin-left: 72px; width: calc(100% - 72px); padding: 20px; }
            .stats-grid { grid-template-columns: 1fr; }
        }
        @media (max-width: 480px) { .sidebar { width: 56px; padding: 16px 4px; } .main { margin-left: 56px; padding: 12px; } }
    </style>
</head>
<body>

    <nav class="sidebar">
        <a href="/admin/dashboard" class="logo">PREPIUM<span class="dot">.</span></a>
        <div class="nav-group">
            <span class="sidebar-section">Main</span>
            <a href="/admin/dashboard" class="nav-item"><i class="fas fa-th-large"></i><span>Dashboard</span></a>
            <a href="/admin/analytics" class="nav-item"><i class="fas fa-chart-line"></i><span>Analytics</span></a>

            <span class="sidebar-section">Dev</span>
            <a href="/admin/db-manager" class="nav-item"><i class="fas fa-database"></i><span>DB Manager</span></a>

            <span class="sidebar-section">Manage</span>
            <a href="/admin/universities" class="nav-item"><i class="fas fa-building-columns"></i><span>Universities</span></a>
            <a href="/admin/coupons" class="nav-item"><i class="fas fa-ticket"></i><span>Coupons</span></a>
            <a href="/admin/migrations" class="nav-item active"><i class="fas fa-rotate-left"></i><span>Free Migrations</span></a>
            <a href="/admin/daily" class="nav-item"><i class="fas fa-fire-flame-curved"></i><span>Daily Arena</span></a>
            <a href="/admin/quiz-generator" class="nav-item"><i class="fas fa-bolt"></i><span>Quiz Generator</span></a>

            <span class="sidebar-section">People</span>
            <a href="/admin/students" class="nav-item"><i class="fas fa-user-graduate"></i><span>Students</span></a>
            <a href="/admin/ambassadors" class="nav-item"><i class="fas fa-gift"></i><span>Referrals</span></a>

            <span class="sidebar-section">Finance</span>
            <a href="/admin/withdrawals" class="nav-item"><i class="fas fa-credit-card"></i><span>Withdrawals</span></a>

            <span class="sidebar-section">System</span>
            <a href="/admin/suggestions" class="nav-item"><i class="fas fa-lightbulb"></i><span>Suggestions</span></a>
            <a href="/admin/notifications" class="nav-item"><i class="fas fa-bell"></i><span>Notifications</span></a>
            <a href="/admin/email" class="nav-item"><i class="fas fa-envelope"></i><span>Send Email</span></a>
            <a href="/admin/groups" class="nav-item"><i class="fas fa-layer-group"></i><span>Groups</span></a>
        </div>
        <a href="/logout" class="nav-item logout"><i class="fas fa-right-from-bracket"></i><span>Logout</span></a>
    </nav>

    <main class="main">
        <div class="page-head">
            <div>
                <h1>Free Migrations</h1>
                <p>Manage users who moved to Premium for free and control the recharge.</p>
            </div>
        </div>

        <% if (locals.msg) { %><div class="flash msg"><i class="fas fa-circle-check"></i> <%= msg %></div><% } %>
        <% if (locals.error) { %><div class="flash error"><i class="fas fa-circle-exclamation"></i> <%= error %></div><% } %>

        <div class="stats-grid">
            <div class="stat-card blue">
                <div class="stat-label">Migrated Users</div>
                <div class="stat-value"><%= users.length %></div>
            </div>
            <div class="stat-card green">
                <div class="stat-label">Currently Premium</div>
                <div class="stat-value"><%= users.filter(function(u){ return u.has_paid; }).length %></div>
            </div>
            <div class="stat-card rose">
                <div class="stat-label">Locked Out</div>
                <div class="stat-value"><%= lockedCount %></div>
            </div>
        </div>

        <form method="POST" action="/admin/migrations/settings" class="card">
            <h3>Recharge Settings</h3>
            <p class="sub">Price locked-out migrated users must pay to keep Premium, and which Premium features to lock.</p>

            <div class="form-row">
                <label>Recharge Price (₦)</label>
                <input type="number" name="recharge_price" min="0" value="<%= settings.recharge_price %>" required>
            </div>

            <label style="font-size:0.85rem;font-weight:700;display:block;margin-bottom:12px;">Locked Features</label>
            <div class="feature-grid">
                <% var locked = settings.locked_features; %>
                <% if (settings.migrated_locked) { %><div style="font-size:0.78rem;color:var(--danger);font-weight:700;margin-bottom:4px;"><i class="fas fa-lock"></i> Users are currently locked out — features below show what they're missing.</div><% } %>
                <% features.forEach(function(f) { %>
                <% var checked = locked.indexOf(f.key) !== -1; %>
                <label class="feature-chip <%= checked ? 'checked' : '' %>">
                    <input type="checkbox" name="locked_features" value="<%= f.key %>" <%= checked ? 'checked' : '' %>>
                    <span class="fc-icon"><i class="fas <%= f.icon %>"></i></span>
                    <span class="fc-label"><%= f.label %></span>
                </label>
                <% }); %>
            </div>

            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Settings</button>
        </form>

        <div class="card danger-zone">
            <h3>Lock / Restore Access</h3>
            <p class="sub">Locking signs every migrated (free) user out of Premium until they recharge. Restoring gives it back instantly.</p>
            <div class="danger-actions">
                <form method="POST" action="/admin/migrations/lock" onsubmit="return confirm('<%= users.length %> migrated users will lose Premium. Lock them all out?');">
                    <button type="submit" class="btn btn-danger"><i class="fas fa-lock"></i> Lock All Migrated Users</button>
                </form>
                <form method="POST" action="/admin/migrations/unlock" onsubmit="return confirm('<%= lockedCount %> users will be restored to Premium. Continue?');">
                    <button type="submit" class="btn btn-ghost"><i class="fas fa-unlock"></i> Restore All</button>
                </form>
            </div>
        </div>

        <div class="card">
            <h3>Migrated Users</h3>
            <p class="sub">Everyone who already used the free migration.</p>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>School</th>
                            <th>Migrated On</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (users.length > 0) { %>
                            <% users.forEach(function(u) { %>
                            <tr>
                                <td>
                                    <div class="user-info">
                                        <span class="user-name"><%= u.fullname %></span>
                                        <span class="user-email"><%= u.email %></span>
                                    </div>
                                </td>
                                <td><%= u.school || 'Not set' %></td>
                                <td><%= u.migrated_at ? new Date(u.migrated_at).toLocaleString() : '—' %></td>
                                <td>
                                    <% if (u.has_paid) { %>
                                    <span class="status status-paid"><i class="fas fa-circle-check"></i> Premium</span>
                                    <% } else { %>
                                    <span class="status status-locked"><i class="fas fa-lock"></i> Locked</span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="4">
                                    <div class="empty-state">
                                        <i class="fas fa-rotate-left"></i>
                                        No users have used the free migration yet.
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

<script>
    document.querySelectorAll('.feature-chip').forEach(function(chip) {
        chip.addEventListener('click', function() {
            var input = chip.querySelector('input');
            input.checked = !input.checked;
            chip.classList.toggle('checked', input.checked);
        });
    });
</script>
<script src="/js/animations.js"></script>
</body>
</html>