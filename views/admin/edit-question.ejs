<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Question | Prepium</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <style>
        :root { --brand: #0062ff; --bg: #f4f7fe; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); padding: 40px; }
        .card { background: white; padding: 30px; border-radius: 24px; max-width: 700px; margin: auto; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
        input, textarea, select { width: 100%; padding: 14px; border: 1px solid #e0e5f2; border-radius: 14px; margin-bottom: 15px; font-family: inherit; box-sizing: border-box;}
        .btn { background: var(--brand); color: white; border: none; padding: 16px; border-radius: 14px; width: 100%; font-weight: 800; cursor: pointer; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Edit Question</h2>
        <form action="/admin/questions/update" method="POST">
            <input type="hidden" name="id" value="<%= q.id %>">
            <input type="hidden" name="subject_id" value="<%= q.subject_id %>">
            
            <label>Question</label>
            <textarea name="question_text" rows="3" required><%= q.question_text %></textarea>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <input type="text" name="option_a" value="<%= q.option_a %>" required>
                <input type="text" name="option_b" value="<%= q.option_b %>" required>
                <input type="text" name="option_c" value="<%= q.option_c %>" required>
                <input type="text" name="option_d" value="<%= q.option_d %>" required>
            </div>

            <label>Correct Answer</label>
            <select name="correct_option">
                <option value="A" <%= q.correct_option == 'A' ? 'selected' : '' %>>A</option>
                <option value="B" <%= q.correct_option == 'B' ? 'selected' : '' %>>B</option>
                <option value="C" <%= q.correct_option == 'C' ? 'selected' : '' %>>C</option>
                <option value="D" <%= q.correct_option == 'D' ? 'selected' : '' %>>D</option>
            </select>

            <label>Hint</label>
            <input type="text" name="hint" value="<%= q.hint %>">
            
            <button type="submit" class="btn">Update Question</button>
            <a href="/admin/questions/manage/<%= q.subject_id %>" style="display:block; text-align:center; margin-top:15px; color:#64748b; text-decoration:none;">Cancel</a>
        </form>
    </div>
</body>
</html>