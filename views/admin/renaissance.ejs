<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <%- include('../partials/tikzjax') %>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
        .admin-shell { display: flex; min-height: 100vh; }
        .admin-sidebar { width: 240px; background: #0b1437; color: white; padding: 1.25rem; display: flex; flex-direction: column; gap: 4px; flex-shrink: 0; }
        .admin-sidebar a { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 12px; color: rgba(255,255,255,0.7); text-decoration: none; font-weight: 600; font-size: 0.82rem; }
        .admin-sidebar a:hover, .admin-sidebar a.active { background: rgba(255,255,255,0.08); color: white; }
        .admin-main { flex: 1; padding: 1.5rem; overflow-y: auto; }
        .page-head { margin-bottom: 1.5rem; }
        .page-head h1 { font-size: 1.4rem; font-weight: 800; }
        .page-head p { font-size: 0.75rem; color: var(--sub); font-weight: 600; margin-top: 2px; }
        .tabs { display: flex; gap: 8px; margin-bottom: 1.25rem; flex-wrap: wrap; }
        .tab { padding: 10px 18px; border-radius: 12px; background: var(--surface-solid); border: 1px solid var(--border); font-family: inherit; font-weight: 700; font-size: 0.8rem; cursor: pointer; color: var(--text); }
        .tab.active { background: var(--brand-gradient); color: white; border-color: transparent; }
        .card { background: var(--card); border-radius: 20px; padding: 20px; box-shadow: 0 2px 12px rgba(0,0,0,0.04); margin-bottom: 1rem; }
        .card h2 { font-size: 0.95rem; font-weight: 800; margin-bottom: 12px; }
        .row { display: flex; gap: 12px; flex-wrap: wrap; }
        .form-group { flex: 1; min-width: 180px; }
        .form-group label { display: block; font-size: 0.7rem; font-weight: 700; color: var(--sub); margin-bottom: 4px; text-transform: uppercase; }
        .form-group select, .form-group input, .form-group textarea { width: 100%; padding: 10px 14px; border-radius: 12px; border: 1px solid var(--border); font-family: inherit; font-size: 0.82rem; font-weight: 600; background: var(--surface-solid); color: var(--text); }
        .form-group textarea { min-height: 100px; resize: vertical; }
        .btn { padding: 10px 20px; border-radius: 12px; border: none; font-family: inherit; font-weight: 700; font-size: 0.8rem; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s; }
        .btn:active { transform: scale(0.96); }
        .btn-primary { background: var(--brand-gradient); color: white; }
        .btn-green { background: #10b981; color: white; }
        .btn-amber { background: #f59e0b; color: white; }
        .btn-outline { background: var(--surface-solid); border: 1px solid var(--border); color: var(--text); }
        .btn-danger { background: var(--danger-soft); color: var(--danger); }
        .btn-purple { background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: white; }
        .btn:disabled { opacity: 0.5; pointer-events: none; }
        .badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 6px; font-size: 0.65rem; font-weight: 700; }
        .badge-draft { background: var(--surface); color: #64748b; }
        .badge-published { background: var(--success-soft); color: var(--success); }
        .badge-closed { background: var(--danger-soft); color: var(--danger); }
        .badge-live { background: var(--success-soft); color: var(--success); }
        .badge-hidden { background: var(--warning-soft); color: var(--warning); }
        .table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        .table th { text-align: left; padding: 8px 12px; font-size: 0.65rem; font-weight: 700; color: var(--sub); text-transform: uppercase; border-bottom: 1px solid var(--border); }
        .table td { padding: 10px 12px; font-size: 0.78rem; font-weight: 600; border-bottom: 1px solid var(--border); vertical-align: top; }
        .table .actions { display: flex; gap: 6px; flex-wrap: wrap; }
        .mini-btn { padding: 6px 10px; border-radius: 8px; border: none; cursor: pointer; font-size: 0.7rem; font-weight: 700; font-family: inherit; }
        .option-input { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
        .option-input .letter { font-weight: 800; color: var(--brand); min-width: 18px; font-size: 0.8rem; }
        .editor-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        @media (max-width: 900px) { .editor-grid { grid-template-columns: 1fr; } .admin-sidebar { width: 200px; } }
        .preview-box { background: var(--surface-solid); border: 1px dashed var(--border); border-radius: 16px; padding: 16px; min-height: 200px; font-size: 0.85rem; line-height: 1.7; overflow-x: auto; }
        .preview-box .label { font-size: 0.65rem; font-weight: 700; color: var(--sub); text-transform: uppercase; margin-bottom: 8px; display: block; }
        .question-row { border: 1px solid var(--border); border-radius: 14px; padding: 12px 14px; margin-bottom: 10px; background: var(--surface-solid); }
        .question-row .q-top { display: flex; justify-content: space-between; gap: 8px; align-items: flex-start; }
        .question-row .q-text { font-size: 0.82rem; font-weight: 600; line-height: 1.6; flex: 1; }
        .checkbox-row { display: flex; align-items: center; gap: 10px; margin-top: 6px; }
        .checkbox-row input[type=checkbox] { width: 18px; height: 18px; }
        .code-hint { font-size: 0.7rem; color: var(--sub); margin-top: 4px; }
        .mt-1 { margin-top: 1rem; }
        .mt-2 { margin-top: 2rem; }
        .empty { text-align: center; padding: 30px; color: var(--sub); font-weight: 600; font-size: 0.8rem; }
        .chip { background: var(--surface); border-radius: 8px; padding: 2px 8px; font-size: 0.65rem; font-weight: 700; color: var(--sub); }
    </style>
<%- include('../partials/theme-toggle') %>
</head>
<body>
<div class="admin-shell">
    <aside class="admin-sidebar">
        <div style="font-weight:800;font-size:1rem;margin-bottom:1rem;color:white;">PREPIUM<span style="color:var(--brand)">.</span></div>
        <a href="/admin/dashboard"><i class="fas fa-home"></i> Dashboard</a>
        <a href="/admin/students"><i class="fas fa-users"></i> Students</a>
        <a href="/admin/universities"><i class="fas fa-university"></i> Universities</a>
        <a href="/admin/daily-manage"><i class="fas fa-tasks"></i> Daily Task</a>
        <a href="/admin/quiz-generator"><i class="fas fa-bolt"></i> Quiz Generator</a>
        <a href="/admin/renaissance" class="active"><i class="fas fa-landmark"></i> Renaissance Mocks</a>
        <a href="/admin/coupons"><i class="fas fa-tags"></i> Coupons</a>
        <a href="/admin/analytics"><i class="fas fa-chart-bar"></i> Analytics</a>
        <a href="/admin/notifications"><i class="fas fa-bell"></i> Notifications</a>
        <a href="/admin/db-manager"><i class="fas fa-database"></i> DB Manager</a>
        <a href="/admin/suggestions"><i class="fas fa-lightbulb"></i> Feedback</a>
        <a href="/logout" style="margin-top:auto;"><i class="fas fa-sign-out"></i> Logout</a>
    </aside>
    <main class="admin-main" id="app">
        <div class="page-head">
            <h1>Renaissance Mock Exams</h1>
            <p>Build mock exams with LaTeX + TikZ questions, AI-checked answers, timers and scheduled openings.</p>
        </div>

        <div class="tabs">
            <button class="tab" :class="{active: tab==='exams'}" @click="tab='exams'"><i class="fas fa-file-signature"></i> Exams</button>
            <button class="tab" :class="{active: tab==='builder'}" @click="openBuilder"><i class="fas fa-tasks"></i> Builder</button>
            <button class="tab" :class="{active: tab==='attempts'}" @click="openAttempts"><i class="fas fa-chart-line"></i> Attempts <span class="badge badge-live" v-if="liveInProgress">LIVE</span></button>
            <button class="tab" :class="{active: tab==='settings'}" @click="tab='settings'"><i class="fas fa-cog"></i> Settings</button>
        </div>

        <!-- ════════════════ EXAMS ════════════════ -->
        <div v-show="tab==='exams'">
            <div class="card">
                <h2><i class="fas fa-plus-circle"></i> Create / Edit Exam</h2>
                <div class="row">
                    <div class="form-group" style="flex:2;min-width:220px;">
                        <label>Exam Title</label>
                        <input v-model="examForm.title" placeholder="e.g. Renaissance Mock Exam 1">
                    </div>
                    <div class="form-group">
                        <label>Duration (minutes)</label>
                        <input type="number" v-model.number="examForm.duration_minutes" min="1">
                    </div>
                    <div class="form-group">
                        <label>Max Attempts per Student</label>
                        <input type="number" v-model.number="examForm.max_attempts" min="0" placeholder="0 = unlimited">
                        <div class="code-hint">0 means students can take it unlimited times.</div>
                    </div>
                    <div class="form-group">
                        <label>Opens At</label>
                        <input type="datetime-local" v-model="examForm.opens_at">
                    </div>
                    <div class="form-group">
                        <label>Closes At</label>
                        <input type="datetime-local" v-model="examForm.closes_at">
                    </div>
                </div>
                <div class="row">
                    <div class="form-group">
                        <label>Description</label>
                        <textarea v-model="examForm.description" style="min-height:60px;"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Results</label>
                        <div class="checkbox-row" style="margin-top:14px;">
                            <input type="checkbox" id="showRes" v-model="examForm.show_results_immediately">
                            <label for="showRes" style="margin:0;text-transform:none;font-size:0.8rem;">Show results immediately after submission</label>
                        </div>
                    </div>
                    <div style="display:flex;align-items:flex-end;gap:8px;">
                        <button class="btn btn-primary" @click="saveExam"><i class="fas fa-save"></i> {{ examForm.id ? 'Update Exam' : 'Create Exam' }}</button>
                        <button v-if="examForm.id" class="btn btn-outline" @click="resetExamForm"><i class="fas fa-times"></i> Cancel</button>
                    </div>
                </div>
            </div>

            <div class="card">
                <h2><i class="fas fa-list"></i> Exams</h2>
                <div v-if="exams.length === 0" class="empty">No exams yet. Create your first Renaissance mock exam above.</div>
                <table class="table" v-else>
                    <thead>
                        <tr><th>Title</th><th>Status</th><th>Duration</th><th>Opens</th><th>Results</th><th>Questions</th><th>Attempts</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        <tr v-for="e in exams" :key="e.id">
                            <td>
                                <div style="font-weight:800;">{{ e.title }}</div>
                                <div style="font-size:0.7rem;color:var(--sub);">{{ e.description }}</div>
                            </td>
                            <td><span class="badge" :class="'badge-' + (e.status === 'published' ? 'published' : (e.status === 'closed' ? 'closed' : 'draft'))">{{ e.status }}</span></td>
                            <td>{{ e.duration_minutes }} min</td>
                            <td>{{ fmtDT(e.opens_at) || 'Anytime' }}</td>
                            <td><span class="badge" :class="e.show_results_immediately ? 'badge-live' : 'badge-hidden'">{{ e.show_results_immediately ? 'Immediate' : 'Delayed' }}</span></td>
                            <td>{{ e.question_count }}</td>
                            <td>{{ e.attempt_count }}</td>
                            <td>
                                <div class="actions">
                                    <button class="mini-btn btn-purple" @click="openExam(e)"><i class="fas fa-pen"></i> Edit</button>
                                    <button class="mini-btn btn-green" @click="buildExam(e)"><i class="fas fa-tasks"></i> Build</button>
                                    <button class="mini-btn btn-amber" @click="togglePublish(e)"><i class="fas fa-rocket"></i> {{ e.status === 'published' ? 'Close' : 'Publish' }}</button>
                                    <button v-if="!e.show_results_immediately" class="mini-btn btn-green" @click="toggleRelease(e)"><i class="fas fa-eye"></i> {{ e.results_released ? 'Hide Results' : 'Release Results' }}</button>
                                    <button class="mini-btn btn-danger" @click="deleteExam(e)"><i class="fas fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ════════════════ BUILDER ════════════════ -->
        <div v-show="tab==='builder'">
            <div class="card" v-if="exams.length">
                <h2><i class="fas fa-folder-open"></i> Select Exam</h2>
                <div class="row">
                    <div class="form-group" style="flex:2;">
                        <select v-model="selectedExamId" @change="loadExam(selectedExamId)">
                            <option v-for="e in exams" :value="e.id" :key="e.id">{{ e.title }}</option>
                        </select>
                    </div>
                    <div v-if="exam" style="display:flex;align-items:center;gap:8px;">
                        <span class="badge" :class="'badge-' + (exam.status === 'published' ? 'published' : (exam.status === 'closed' ? 'closed' : 'draft'))">{{ exam.status }}</span>
                        <a :href="'/renaissance/exam/' + exam.id" target="_blank" class="btn btn-outline" style="text-decoration:none;"><i class="fas fa-external-link-alt"></i> View as student</a>
                    </div>
                </div>
            </div>
            <div v-if="!exam" class="card">
                <div class="empty">Create an exam first, then build its courses and questions here.</div>
            </div>

            <template v-if="exam">
                <!-- Bulk import: paste full paper -->
                <div class="card" v-if="exam">
                    <h2><i class="fas fa-file-import"></i> Bulk Import — {{ exam.title }}</h2>
                    <div class="code-hint" style="margin-bottom:12px;">Questions are added straight into this exam.</div>
                    <div class="form-group" style="margin-top:12px;">
                        <label>Full LaTeX (all questions in one code)</label>
                        <textarea v-model="importLatex" style="min-height:200px;font-family:monospace;font-size:0.78rem;" placeholder="Paste the whole paper here. Questions separated with \item, numbered lines like '1.', or \section headings. Options like 'A.', '(B)' or \item C. are auto-detected."></textarea>
                        <div class="code-hint">Splits automatically on \item, numbered questions, or \section headings. Lines like A. / (B) become MCQ choices; no options detected = theory question.</div>
                    </div>
                    <div class="form-group" style="margin-top:12px;">
                        <label>... or upload a PDF / photo of a paper</label>
                        <div class="row" style="gap:8px;">
                            <input type="file" ref="importFile" accept=".pdf,.png,.jpg,.jpeg,.webp" class="file-input" style="flex:1;">
                            <button class="btn btn-blue" @click="uploadImportFile" :disabled="uploading"><i class="fas fa-upload"></i> {{ uploading ? 'Reading...' : 'Upload & Read' }}</button>
                        </div>
                        <div class="code-hint">PDFs: text is read automatically. Scanned pages / photos: AI vision reads them (math and circuit diagrams are approximated).</div>
                    </div>
                    <div class="checkbox-row" style="margin-top:12px;">
                        <input type="checkbox" id="aiFill" v-model="importAI">
                        <label for="aiFill" style="margin:0;text-transform:none;font-size:0.8rem;">AI-fill correct answer + explanation for every question after import</label>
                    </div>
                    <div class="row" style="margin-top:12px;">
                        <button class="btn btn-primary" @click="previewImport" :disabled="!importLatex.trim()"><i class="fas fa-search"></i> Preview Split</button>
                        <button class="btn btn-green" @click="doImport" :disabled="!importPreview.length"><i class="fas fa-file-import"></i> Import {{ importPreview.length }} Question{{ importPreview.length === 1 ? '' : 's' }}</button>
                    </div>
                    <div v-if="importError" class="code-hint" style="color:var(--danger);margin-top:8px;">{{ importError }}</div>
                    <div v-if="importPreview.length" class="mt-1">
                        <div style="font-size:0.72rem;font-weight:800;color:var(--sub);text-transform:uppercase;margin-bottom:8px;">Detected Questions</div>
                        <div v-for="(q, i) in importPreview" :key="i" class="question-row">
                            <div style="display:flex;gap:8px;align-items:flex-start;">
                                <span class="chip">{{ i + 1 }}</span>
                                <span class="chip">{{ q.question_type }}</span>
                                <span class="chip" v-if="q.options.length">{{ q.options.length }} options</span>
                                <div style="font-size:0.78rem;font-weight:600;line-height:1.5;flex:1;word-break:break-word;">{{ q.question_text }}</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Question editor -->
                <div class="card" v-if="exam">
                    <h2><i class="fas fa-pen-square"></i> {{ editing ? 'Edit Question' : 'Add Question' }}</h2>
                    <div class="row" style="margin-bottom:12px;">
                        <div class="form-group" style="max-width:180px;">
                            <label>Type</label>
                            <select v-model="qForm.question_type">
                                <option value="mcq">Multiple Choice</option>
                                <option value="theory">Theory / Open</option>
                            </select>
                        </div>
                    </div>
                    <div class="editor-grid">
                        <div>
                            <div class="form-group">
                                <label>Question (LaTeX + TikZ)</label>
                                <textarea v-model="qForm.question_text" style="min-height:180px;font-family:monospace;font-size:0.78rem;" @input="schedulePreview"></textarea>
                                <div class="code-hint">Use $...$ for inline math, $$...$$ for display math, and \begin{tikzpicture}...\end{tikzpicture} for circuits/vector diagrams. E.g. \begin{tikzpicture}\draw (0,0) circle (1);\end{tikzpicture}</div>
                            </div>
                            <div class="row" v-if="qForm.question_type === 'mcq'" style="margin-top:12px;">
                                <div class="form-group">
                                    <label>Options</label>
                                    <div v-for="(opt, i) in qForm.options" :key="i" class="option-input">
                                        <span class="letter">{{ String.fromCharCode(65 + i) }}</span>
                                        <input v-model="qForm.options[i]" :placeholder="'Option ' + String.fromCharCode(65 + i)">
                                        <button type="button" class="mini-btn btn-danger" @click="removeOption(i)" style="padding:4px 8px;">&times;</button>
                                    </div>
                                    <button class="mini-btn btn-outline" @click="addOption" v-if="qForm.options.length < 6">+ Add option</button>
                                </div>
                            </div>
                            <div class="row" style="margin-top:12px;">
                                <div class="form-group">
                                    <label>Correct Answer</label>
                                    <input v-model="qForm.correct_answer" :placeholder="qForm.question_type === 'mcq' ? 'e.g. B' : 'Expected answer'">
                                </div>
                            </div>
                            <div class="form-group" style="margin-top:12px;">
                                <label>Explanation</label>
                                <textarea v-model="qForm.explanation" style="min-height:90px;"></textarea>
                            </div>
                            <div class="row" style="margin-top:12px;">
                                <button class="btn btn-green" @click="saveQuestion"><i class="fas fa-save"></i> Save Question</button>
                                <button class="btn btn-purple" @click="aiGenerate"><i class="fas fa-magic"></i> AI Generate Answer + Explanation</button>
                                <button class="btn btn-outline" @click="cancelEdit" v-if="editing"><i class="fas fa-times"></i> Cancel</button>
                            </div>
                            <div class="code-hint" v-if="aiStatus" style="margin-top:8px;color:var(--brand);">AI ({{ aiStatus }})</div>
                        </div>
                        <div>
                            <div class="preview-box">
                                <span class="label"><i class="fas fa-eye"></i> Live Preview</span>
                                <div ref="preview" class="rnz-render" data-tex="" style="min-height:150px;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Questions list -->
                <div class="card" v-if="exam">
                    <h2><i class="fas fa-list-ul"></i> Questions ({{ questions.length }})</h2>
                    <div v-if="questions.length === 0" class="empty">No questions yet. Use the editor above to add one.</div>
                    <div v-for="q in questions" :key="q.id" class="question-row">
                        <div class="q-top">
                            <div class="q-text">
                                <div class="rnz-render" :data-tex="q.question_text"></div>
                            </div>
                            <div class="actions" style="flex-shrink:0;">
                                <button class="mini-btn btn-green" @click="editQuestion(q)"><i class="fas fa-pen"></i></button>
                                <button class="mini-btn btn-danger" @click="deleteQuestion(q)"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                        <div style="margin-top:8px;font-size:0.72rem;color:var(--sub);font-weight:600;">
                            <span class="chip">{{ q.question_type }}</span>
                            <span v-if="q.correct_answer" class="chip">Answer: {{ q.correct_answer }}</span>
                            <span v-if="q.ai_generated" class="chip"><i class="fas fa-robot"></i> AI</span>
                        </div>
                        <div v-if="q.explanation" style="margin-top:6px;font-size:0.75rem;color:var(--sub);line-height:1.5;"><b>Why:</b> {{ q.explanation }}</div>
                    </div>
                </div>
            </template>
        </div>

        <!-- ════════════════ ATTEMPTS ════════════════ -->
        <div v-show="tab==='attempts'">
            <div class="card" v-if="exams.length">
                <h2><i class="fas fa-chart-line"></i> Attempts / Results — Live</h2>
                <div class="row">
                    <div class="form-group" style="flex:2;">
                        <label>Select Exam</label>
                        <select v-model="attemptExamId" @change="loadAttempts">
                            <option value="" disabled>-- Select exam --</option>
                            <option v-for="e in exams" :value="e.id" :key="e.id">{{ e.title }} · {{ e.attempt_count }} submitted</option>
                        </select>
                    </div>
                    <div style="display:flex;align-items:flex-end;gap:8px;">
                        <span class="chip" v-if="liveInProgress">{{ liveInProgress }} in progress</span>
                        <span class="chip" v-if="liveTimer">{{ liveTimer }}</span>
                    </div>
                </div>
            </div>
            <div v-if="attemptExamId && !attempts.length" class="card">
                <div class="empty">No attempts yet. They appear here live as students start and submit.</div>
            </div>
            <div class="card" v-if="attempts.length">
                <table class="table">
                    <thead><tr><th>Student</th><th>Status</th><th>Score</th><th>Time Used</th><th>Started</th><th>Submitted</th><th>Actions</th></tr></thead>
                    <tbody>
                        <tr v-for="a in attempts" :key="a.id">
                            <td>
                                <div style="font-weight:800;">{{ a.fullname }}</div>
                                <div style="font-size:0.7rem;color:var(--sub);">{{ a.email }}</div>
                            </td>
                            <td><span class="badge" :class="a.status === 'submitted' ? 'badge-published' : 'badge-live'">{{ a.status }}</span></td>
                            <td>
                                <template v-if="a.status === 'submitted'"><b>{{ a.percentage }}%</b> ({{ a.score }}/{{ a.total }})</template>
                                <template v-else>—</template>
                            </td>
                            <td>{{ fmtDur(a.time_taken) }}</td>
                            <td>{{ fmtDT(a.started_at) }}</td>
                            <td>{{ a.submitted_at ? fmtDT(a.submitted_at) : '—' }}</td>
                            <td>
                                <div class="actions">
                                    <a :href="'/admin/renaissance/exams/' + attemptExamId + '/attempts/' + a.id + '/print'" target="_blank" class="mini-btn btn-purple"><i class="fas fa-print"></i> Print</a>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="code-hint" style="margin-top:8px;"><i class="fas fa-sync"></i> Refreshes automatically every 5 seconds while this tab is open.</div>
            </div>
        </div>

        <!-- ════════════════ SETTINGS ════════════════ -->
        <div v-show="tab==='settings'">
            <div class="card">
                <h2><i class="fas fa-users"></i> Renaissance Group</h2>
                <div class="row">
                    <div class="form-group">
                        <label>WhatsApp / Telegram Group Link</label>
                        <input v-model="groupLink" placeholder="https://chat.whatsapp.com/... or https://t.me/...">
                        <div class="code-hint">Shown as the "Join Renaissance Group" button on the student dashboard.</div>
                    </div>
                    <div style="display:flex;align-items:flex-end;">
                        <button class="btn btn-primary" @click="saveSettings"><i class="fas fa-save"></i> Save</button>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/vue@2.7.14/dist/vue.min.js"></script>
<script>window.RNZ_GROUP_LINK = <%- groupLinkJSON %>;</script>
<script>
function rnzDTLocal(dt) {
    if (!dt) return '';
    var d = new Date(dt);
    if (isNaN(d.getTime())) return dt;
    function p(n) { return (n < 10 ? '0' : '') + n; }
    return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + 'T' + p(d.getHours()) + ':' + p(d.getMinutes());
}
function rnzFmtDT(dt) {
    if (!dt) return null;
    var d = new Date(dt);
    if (isNaN(d.getTime())) return dt;
    return d.toLocaleString([], { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
}
var app = new Vue({
    el: '#app',
    data: {
        tab: 'exams',
        exams: [],
        examForm: { id: null, title: '', description: '', duration_minutes: 30, max_attempts: 0, opens_at: '', closes_at: '', show_results_immediately: true },
        selectedExamId: null,
        exam: null,
        allQuestions: [],
        qForm: { id: null, exam_id: null, question_type: 'mcq', question_text: '', options: ['', '', '', ''], correct_answer: '', explanation: '', ai_generated: false },
        editing: false,
        groupLink: '',
        aiStatus: '',
        previewTimer: null,
        importLatex: '',
        importPreview: [],
        importError: '',
        importAI: true,
        uploading: false,
        attempts: [],
        attemptExamId: '',
        liveInProgress: 0,
        liveTimer: '',
        attemptsPoll: null
    },
    computed: {
        questions: function () {
            return this.allQuestions;
        }
    },
    methods: {
        fmtDT: rnzFmtDT,
        async loadExams() {
            const r = await fetch('/api/admin/renaissance/exams');
            const d = await r.json();
            this.exams = d.exams || [];
        },
        openBuilder() {
            this.tab = 'builder';
            if (this.exams.length && !this.selectedExamId) {
                this.selectedExamId = this.exams[0].id;
                this.loadExam(this.selectedExamId);
            }
        },
        openExam(e) {
            this.tab = 'exams';
            this.examForm = {
                id: e.id,
                title: e.title,
                description: e.description || '',
                duration_minutes: e.duration_minutes,
                max_attempts: e.max_attempts || 0,
                opens_at: rnzDTLocal(e.opens_at),
                closes_at: rnzDTLocal(e.closes_at),
                show_results_immediately: !!e.show_results_immediately
            };
            window.scrollTo({ top: 0, behavior: 'smooth' });
        },
        resetExamForm() {
            this.examForm = { id: null, title: '', description: '', duration_minutes: 30, max_attempts: 0, opens_at: '', closes_at: '', show_results_immediately: true };
        },
        async saveExam() {
            if (!this.examForm.title || !this.examForm.title.trim()) return Swal.fire({ icon: 'warning', text: 'Enter an exam title' });
            const body = { ...this.examForm, opens_at: this.examForm.opens_at || null, closes_at: this.examForm.closes_at || null };
            const url = this.examForm.id ? '/api/admin/renaissance/exams/' + this.examForm.id : '/api/admin/renaissance/exams';
            const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
            const d = await r.json();
            if (d.error) return Swal.fire({ icon: 'error', text: d.error });
            this.resetExamForm();
            await this.loadExams();
            Swal.fire({ icon: 'success', title: 'Saved', timer: 900, showConfirmButton: false });
        },
        async togglePublish(e) {
            const toStatus = e.status === 'published' ? 'closed' : 'published';
            const r = await fetch('/api/admin/renaissance/exams/' + e.id + '/publish', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: toStatus }) });
            await r.json();
            await this.loadExams();
            if (this.exam && this.exam.id === e.id) this.exam.status = toStatus;
        },
        async toggleRelease(e) {
            const released = !e.results_released;
            const r = await fetch('/api/admin/renaissance/exams/' + e.id + '/release-results', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ released }) });
            await r.json();
            e.results_released = released;
            Swal.fire({ icon: 'success', title: released ? 'Results released' : 'Results hidden', timer: 1000, showConfirmButton: false });
        },
        async deleteExam(e) {
            const c = await Swal.fire({ title: 'Delete "' + e.title + '"?', text: 'This removes its questions and attempts too.', icon: 'warning', showCancelButton: true, confirmButtonText: 'Delete', confirmButtonColor: '#ef4444' });
            if (!c.isConfirmed) return;
            await fetch('/api/admin/renaissance/exams/' + e.id, { method: 'DELETE' });
            if (this.exam && this.exam.id === e.id) { this.exam = null; this.allQuestions = []; this.selectedExamId = null; }
            await this.loadExams();
        },
        buildExam(e) {
            this.selectedExamId = e.id;
            this.tab = 'builder';
            this.loadExam(e.id);
        },
        async loadExam(id) {
            const r = await fetch('/api/admin/renaissance/exams/' + id);
            const d = await r.json();
            if (d.error) return Swal.fire({ icon: 'error', text: d.error });
            this.exam = d.exam;
            this.allQuestions = d.questions || [];
            this.cancelEdit();
            this.$nextTick(function () { rnzRender(document.getElementById('app')); });
        },
        addOption() {
            if (this.qForm.options.length < 6) this.qForm.options.push('');
        },
        removeOption(i) { this.qForm.options.splice(i, 1); },
        schedulePreview() {
            var self = this;
            clearTimeout(this.previewTimer);
            this.previewTimer = setTimeout(function () { self.refreshPreview(); }, 400);
        },
        refreshPreview() {
            this.$nextTick(function () {
                var el = app.$refs.preview;
                if (el) {
                    el.setAttribute('data-tex', app.qForm.question_text || '');
                    rnzRender(el);
                }
            });
        },
        editQuestion(q) {
            var opts = [];
            try { opts = JSON.parse(q.options || '[]'); } catch (e) {}
            this.qForm = {
                id: q.id,
                exam_id: q.exam_id || this.exam.id,
                question_type: q.question_type,
                question_text: q.question_text,
                options: opts.length ? opts : ['', '', '', ''],
                correct_answer: q.correct_answer || '',
                explanation: q.explanation || '',
                ai_generated: !!q.ai_generated
            };
            this.editing = true;
            this.refreshPreview();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        },
        cancelEdit() {
            this.editing = false;
            this.qForm = { id: null, exam_id: this.exam ? this.exam.id : null, question_type: 'mcq', question_text: '', options: ['', '', '', ''], correct_answer: '', explanation: '', ai_generated: false };
        },
        async saveQuestion() {
            if (!this.exam) return;
            if (!this.qForm.question_text || !this.qForm.question_text.trim()) return Swal.fire({ icon: 'warning', text: 'Question text is required' });
            const payload = { exam_id: this.exam.id, question_type: this.qForm.question_type, question_text: this.qForm.question_text, options: this.qForm.question_type === 'mcq' ? this.qForm.options.filter(o => o.trim() !== '') : [], correct_answer: this.qForm.correct_answer, explanation: this.qForm.explanation, ai_generated: this.qForm.ai_generated };
            const url = this.qForm.id ? '/api/admin/renaissance/questions/' + this.qForm.id : '/api/admin/renaissance/questions';
            const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            const d = await r.json();
            if (d.error) return Swal.fire({ icon: 'error', text: d.error });
            if (!this.qForm.id) this.qForm.id = d.id;
            await this.loadExam(this.exam.id);
            Swal.fire({ icon: 'success', title: 'Question saved', timer: 800, showConfirmButton: false });
        },
        async deleteQuestion(q) {
            const cf = await Swal.fire({ title: 'Delete question?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Delete', confirmButtonColor: '#ef4444' });
            if (!cf.isConfirmed) return;
            await fetch('/api/admin/renaissance/questions/' + q.id, { method: 'DELETE' });
            if (this.qForm.id === q.id) this.cancelEdit();
            await this.loadExam(this.exam.id);
        },
        async aiGenerate() {
            if (!this.exam) return;
            if (!this.qForm.question_text || !this.qForm.question_text.trim()) return Swal.fire({ icon: 'warning', text: 'Write the question first' });
            if (!this.qForm.id) {
                const p = { exam_id: this.exam.id, question_type: this.qForm.question_type, question_text: this.qForm.question_text, options: this.qForm.question_type === 'mcq' ? this.qForm.options.filter(o => o.trim() !== '') : [], correct_answer: '', explanation: '' };
                const r = await fetch('/api/admin/renaissance/questions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(p) });
                const d = await r.json();
                if (d.error) return Swal.fire({ icon: 'error', text: d.error });
                this.qForm.id = d.id;
            }
            this.aiStatus = 'Generating answer with AI...';
            const r = await fetch('/api/admin/renaissance/questions/' + this.qForm.id + '/ai', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
            const d = await r.json();
            if (d.error) { this.aiStatus = ''; return Swal.fire({ icon: 'error', text: d.error }); }
            this.qForm.correct_answer = d.answer || '';
            this.qForm.explanation = d.explanation || '';
            this.qForm.ai_generated = true;
            this.aiStatus = 'Answer generated by ' + (d.provider || 'AI') + ' — review and correct if needed.';
            this.refreshPreview();
            await this.loadExam(this.exam.id);
        },
        async saveSettings() {
            const r = await fetch('/api/admin/renaissance/settings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ group_link: this.groupLink }) });
            await r.json();
            Swal.fire({ icon: 'success', title: 'Saved', timer: 900, showConfirmButton: false });
        },
        async previewImport() {
            this.importError = '';
            if (!this.exam) return;
            if (!this.importLatex.trim()) return Swal.fire({ icon: 'warning', text: 'Paste the LaTeX code first' });
            const r = await fetch('/api/admin/renaissance/import/parse', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ latex: this.importLatex }) });
            const d = await r.json();
            if (d.error) { this.importError = d.error; this.importPreview = []; return; }
            this.importPreview = d.questions;
        },
        async doImport() {
            if (!this.exam || !this.importPreview.length) return;
            const cf = await Swal.fire({ title: 'Import ' + this.importPreview.length + ' question' + (this.importPreview.length === 1 ? '' : 's') + '?', icon: 'question', showCancelButton: true, confirmButtonText: 'Import' });
            if (!cf.isConfirmed) return;
            Swal.fire({ title: 'Importing...', html: this.importAI ? 'AI-filling answers (this can take a minute)...' : 'Please wait...', allowOutsideClick: false, didOpen: function () { Swal.showLoading(); } });
            const r = await fetch('/api/admin/renaissance/import/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ exam_id: this.exam.id, questions: this.importPreview, ai_fill: this.importAI }) });
            const d = await r.json();
            Swal.close();
            if (d.error) return Swal.fire({ icon: 'error', text: d.error });
            this.importLatex = '';
            this.importPreview = [];
            await this.loadExam(this.exam.id);
            Swal.fire({ icon: 'success', title: d.count + ' questions imported' + (d.aiFilled ? ' · ' + d.aiFilled + ' AI-filled' : ''), timer: 1600, showConfirmButton: false });
        },
        async uploadImportFile() {
            const input = this.$refs.importFile;
            if (!input || !input.files || !input.files.length) return Swal.fire({ icon: 'warning', text: 'Choose a PDF or image first' });
            this.importError = '';
            this.uploading = true;
            const fd = new FormData();
            fd.append('file', input.files[0]);
            try {
                const r = await fetch('/api/admin/renaissance/import/file', { method: 'POST', body: fd });
                const d = await r.json();
                if (d.error) { this.importError = d.error; return; }
                if (!d.questions || !d.questions.length) { this.importError = 'No questions could be read from that file.'; return; }
                this.importLatex = d.raw || '';
                this.importPreview = d.questions;
                Swal.fire({ icon: 'success', title: d.questions.length + ' questions read from ' + (d.source === 'vision' ? 'AI vision' : 'PDF text'), text: 'Review below, then click Import.', timer: 1800, showConfirmButton: false });
            } catch (e) {
                this.importError = e.message;
            } finally {
                this.uploading = false;
            }
        },
        fmtDur(sec) {
            sec = parseInt(sec) || 0;
            var m = Math.floor(sec / 60), s = sec % 60;
            return (m ? m + 'm ' : '') + s + 's';
        },
        openAttempts() {
            this.tab = 'attempts';
            if (!this.attemptExamId && this.exams.length) {
                this.attemptExamId = this.exams[0].id;
            }
            this.loadAttempts();
            this.startAttemptsPoll();
        },
        startAttemptsPoll() {
            this.stopAttemptsPoll();
            var self = this;
            this.attemptsPoll = setInterval(function () { self.loadAttempts(); }, 5000);
        },
        stopAttemptsPoll() {
            if (this.attemptsPoll) { clearInterval(this.attemptsPoll); this.attemptsPoll = null; }
        },
        async loadAttempts() {
            if (!this.attemptExamId) { this.attempts = []; return; }
            try {
                const r = await fetch('/api/admin/renaissance/exams/' + this.attemptExamId + '/attempts');
                const d = await r.json();
                this.attempts = d.attempts || [];
                this.liveInProgress = this.attempts.filter(function (a) { return a.status === 'in_progress'; }).length;
                this.liveTimer = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            } catch (e) {}
        }
    },
    watch: {
        tab: function (val) {
            if (val !== 'attempts') this.stopAttemptsPoll();
        }
    },
    mounted: function () {
        this.groupLink = window.RNZ_GROUP_LINK || '';
        this.loadExams();
    }
});
</script>
</body>
</html>