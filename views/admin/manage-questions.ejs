<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Prepium | Manage <%= subject.name %></title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        window.MathJax = {
            tex: { inlineMath: [['$', '$'], ['\\(', '\\)']] },
            svg: { fontCache: 'global' }
        };
    </script>
    <script src="https://polyfill.io/v3/polyfill.min.js?features=es6"></script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

    <style>
        :root { 
            --brand: #0062ff; 
            --brand-light: #e6f0ff;
            --bg: #f4f7fe; 
            --text: #1b2559; 
            --sidebar-width: 260px;
        }

        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: var(--bg); 
            color: var(--text); 
            margin: 0; 
            display: flex;
        }

        /* SIDEBAR NAVIGATION */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: white;
            border-right: 1px solid #e0e5f2;
            position: fixed;
            padding: 40px 20px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--brand);
            text-decoration: none;
            margin-bottom: 50px;
            display: block;
        }

        .nav-link {
            text-decoration: none;
            color: #a3aed0;
            font-weight: 700;
            padding: 15px 20px;
            border-radius: 12px;
            margin-bottom: 10px;
            transition: 0.3s;
            display: flex;
            align-items: center;
        }

        .nav-link:hover, .nav-link.active {
            background: var(--brand-light);
            color: var(--brand);
        }

        /* MAIN CONTENT AREA */
        .main-content {
            margin-left: var(--sidebar-width);
            width: calc(100% - var(--sidebar-width));
            min-height: 100vh;
        }

        /* TOP HEADER */
        .header {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            padding: 20px 40px;
            border-bottom: 1px solid #e0e5f2;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .breadcrumb { font-size: 0.85rem; color: #a3aed0; font-weight: 600; }
        .user-pill {
            background: white;
            padding: 8px 16px;
            border-radius: 50px;
            border: 1px solid #e0e5f2;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .container { padding: 40px; max-width: 1200px; margin: auto; }
        
        .card { background: white; padding: 25px; border-radius: 24px; border: 1px solid #e0e5f2; box-shadow: 0 4px 20px rgba(0,0,0,0.02); margin-bottom: 30px; }
        .bulk-card { border: 2px dashed var(--brand); background: #f0f7ff; }
        
        input, textarea, select { 
            width: 100%; padding: 14px; border: 1px solid #e0e5f2; border-radius: 14px; 
            font-family: inherit; font-weight: 600; box-sizing: border-box; background: #fcfdfe; margin-bottom: 10px;
        }

        .btn { padding: 16px; border: none; border-radius: 16px; font-weight: 800; cursor: pointer; transition: 0.3s; width: 100%; }
        .btn-primary { background: var(--brand); color: white; }
        .btn-bulk { background: #1b2559; color: white; }

        .options-display { 
            display: grid; grid-template-columns: 1fr 1fr; gap: 15px; 
            background: #f8fafc; padding: 15px; border-radius: 12px; margin: 10px 0;
        }
        .opt-item { font-size: 0.9rem; color: #475569; }

        .preview-box { background: #fff; border-left: 5px solid var(--brand); padding: 20px; border-radius: 16px; margin-top: 10px; min-height: 100px; }
        .question-item { padding: 25px; border-bottom: 1px solid #f1f5f9; }
        .badge { padding: 5px 12px; border-radius: 8px; font-size: 0.75rem; font-weight: 800; margin-right: 8px; }
        .badge-ans { background: #dcfce7; color: #15803d; }
        .badge-hint { background: #fff7ed; color: #c2410c; }
    </style>
</head>
<body>

    <div class="sidebar">
        <a href="/admin/dashboard" class="logo">PREPIUM</a>
        <nav>
            <a href="/admin/dashboard" class="nav-link">📊 Dashboard</a>
            <a href="/admin/subjects" class="nav-link active">📚 Subjects</a>
            <a href="/admin/users" class="nav-link">👥 Students</a>
            <a href="/admin/settings" class="nav-link">⚙️ Settings</a>
        </nav>
        <div style="margin-top: auto;">
            <a href="/logout" class="nav-link" style="color: #ee5d50;" onclick="return confirm('Logout of session?')">🚪 Logout</a>
        </div>
    </div>

    <div class="main-content">
        <header class="header">
            <div>
                <div class="breadcrumb">Pages / Subjects / Question Manager</div>
                <h2 style="margin:0;"><%= subject.name %></h2>
            </div>
            <div class="user-pill">
                Admin: Atilola Israel
            </div>
        </header>

        <div class="container">
            <div style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 30px;">
                
                <div>
                    <div class="card">
                        <h3>Single Question Entry</h3>
                        <form action="/admin/questions/add" method="POST">
                            <input type="hidden" name="subject_id" value="<%= subject.id %>">
                            <textarea id="singleQ" name="question_text" rows="2" placeholder="Question Text (e.g. Find $H_2SO_4$ mass)" required></textarea>
                            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
                                <input type="text" name="option_a" placeholder="Option A" required>
                                <input type="text" name="option_b" placeholder="Option B" required>
                                <input type="text" name="option_c" placeholder="Option C" required>
                                <input type="text" name="option_d" placeholder="Option D" required>
                            </div>
                            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
                                <select name="correct_option"><option value="A">Answer: A</option><option value="B">Answer: B</option><option value="C">Answer: C</option><option value="D">Answer: D</option></select>
                                <input type="text" name="hint" placeholder="Explanation/Hint">
                            </div>
                            <button type="submit" class="btn btn-primary">Save to Database</button>
                        </form>
                    </div>

                    <div class="card bulk-card">
                        <h3>Bulk JSON Import</h3>
                        <form action="/admin/questions/bulk-import" method="POST">
                            <input type="hidden" name="subject_id" value="<%= subject.id %>">
                            <textarea id="bulkJSON" name="json_data" rows="8" placeholder='Paste JSON array here...' required></textarea>
                            <button type="submit" class="btn btn-bulk">Import All Questions</button>
                        </form>
                    </div>
                </div>

                <div style="position: sticky; top: 100px; height: fit-content;">
                    <div class="card" style="border-top: 8px solid var(--brand);">
                        <h3 style="margin:0 0 10px;">Scientific Preview</h3>
                        <div id="previewArea" class="preview-box">
                            Start typing to see formula rendering...
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                    <h3 style="margin:0;">Stored Questions (<%= questions.length %>)</h3>
                </div>
                <% questions.forEach(q => { %>
                    <div class="question-item">
                        <div style="font-weight:700; font-size:1.1rem; margin-bottom:15px;"><%= q.question_text %></div>
                        
                        <div class="options-display">
                            <div class="opt-item"><strong>A:</strong> <%= q.option_a %></div>
                            <div class="opt-item"><strong>B:</strong> <%= q.option_b %></div>
                            <div class="opt-item"><strong>C:</strong> <%= q.option_c %></div>
                            <div class="opt-item"><strong>D:</strong> <%= q.option_d %></div>
                        </div>

                        <span class="badge badge-ans">CORRECT: <%= q.correct_option %></span>
                        <% if(q.hint) { %><span class="badge badge-hint">HINT: <%= q.hint %></span><% } %>
                        
                        <div style="float:right;">
                            <a href="/admin/questions/edit/<%= q.id %>" style="color:var(--brand); font-weight:800; text-decoration:none; margin-right: 20px; font-size:0.85rem;">EDIT</a>
                            <a href="/admin/questions/delete/<%= q.id %>/<%= subject.id %>" style="color:#ef4444; font-weight:800; text-decoration:none; font-size:0.85rem;">DELETE</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <script>
        const singleInput = document.getElementById('singleQ');
        const bulkInput = document.getElementById('bulkJSON');
        const previewArea = document.getElementById('previewArea');

        function updatePreview() {
            if (singleInput.value) {
                previewArea.innerHTML = `<div style="font-weight:700">${singleInput.value}</div>`;
            } else if (bulkInput.value) {
                try {
                    const data = JSON.parse(bulkInput.value);
                    const q = data[0]; 
                    previewArea.innerHTML = `
                        <div style="font-weight:800; margin-bottom:10px;">1. ${q.question}</div>
                        <div style="font-size:0.9rem;">
                            A: ${q.a} <br> B: ${q.b} <br> C: ${q.c} <br> D: ${q.d}
                        </div>
                    `;
                } catch (e) {
                    previewArea.innerHTML = `<span style="color:red">JSON Error.</span>`;
                }
            }
            if (window.MathJax && window.MathJax.typeset) {
                MathJax.typeset();
            }
        }

        singleInput.addEventListener('input', updatePreview);
        bulkInput.addEventListener('input', updatePreview);
    </script>
</body>
</html>