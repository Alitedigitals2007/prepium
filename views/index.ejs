<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Smart Exam Mastery</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand: #0062ff;
            --brand-soft: #eef4ff;
            --success: #00c853;
            --text-dark: #0a0c10;
            --text-muted: #5f6672;
            --surface: #ffffff;
            --bg-light: #f4f7fa;
            --border: #edf2f7;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; outline: none; }

        body {
            background-color: var(--bg-light);
            color: var(--text-dark);
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            display: flex;
            justify-content: center;
        }

        .app-container {
            width: 100%;
            max-width: 430px;
            background: var(--surface);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            box-shadow: 0 0 40px rgba(0,0,0,0.03);
            overflow-x: hidden;
            padding-bottom: 140px; 
        }

        /* Nav Bar */
        .nav-bar {
            position: sticky;
            top: 0;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            z-index: 1000;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--text-dark);
            font-weight: 800;
            font-size: 1.15rem;
        }

        .nav-logo-box {
            background: var(--brand);
            color: white;
            width: 34px;
            height: 34px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }

        .nav-menu-btn {
            background: var(--bg-light);
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 12px;
            font-size: 1.15rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Floating Menu */
        .mobile-menu {
            display: none;
            flex-direction: column;
            background: white;
            border-bottom: 1px solid var(--border);
            padding: 0.8rem 1.5rem;
            gap: 6px;
        }
        .mobile-menu.open { display: flex; animation: fadeInTop 0.3s ease forwards; }

        .menu-link {
            text-decoration: none;
            color: var(--text-muted);
            font-weight: 700;
            font-size: 0.9rem;
            padding: 12px 14px;
            border-radius: 14px;
        }

        /* Hero */
        .hero {
            padding: 3rem 1.5rem 2.2rem;
            background: linear-gradient(180deg, var(--brand-soft) 0%, #ffffff 100%);
            text-align: center;
            border-bottom-left-radius: 40px;
            border-bottom-right-radius: 40px;
        }

        .hero-badge {
            display: inline-flex;
            background: white;
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.72rem;
            font-weight: 800;
            color: var(--brand);
            box-shadow: 0 4px 14px rgba(0,0,0,0.03);
            margin-bottom: 1.2rem;
            text-transform: uppercase;
            border: 1px solid rgba(0, 98, 255, 0.1);
        }

        h1 { font-size: 2.5rem; font-weight: 800; margin: 0; letter-spacing: -1.2px; color: var(--brand); }
        .tagline { color: var(--text-muted); font-size: 0.98rem; margin-top: 12px; font-weight: 600; }

        .section-title {
            padding: 2.2rem 1.5rem 0.6rem;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-muted);
            font-weight: 800;
        }

        .features-grid { padding: 0.4rem 1.5rem; display: grid; gap: 0.85rem; }
        .card {
            background: var(--surface);
            padding: 1.15rem;
            border-radius: 22px;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 16px;
        }

        /* Testimonials */
        .testimonials-container { padding: 0.5rem 0 1rem; overflow: hidden; }
        .testimonial-track {
            display: flex;
            gap: 16px;
            padding: 0 1.5rem;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scrollbar-width: none;
        }
        .testimonial-track::-webkit-scrollbar { display: none; }
        .t-card {
            min-width: 280px;
            background: white;
            padding: 1.5rem;
            border-radius: 24px;
            border: 1px solid var(--border);
            scroll-snap-align: center;
        }
        .t-user { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
        .t-avatar { width: 36px; height: 36px; background: var(--brand-soft); color: var(--brand); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.8rem; }
        .t-name { font-size: 0.85rem; font-weight: 800; }
        .t-text { font-size: 0.85rem; color: var(--text-dark); line-height: 1.5; font-style: italic; }

        /* FAQ */
        .faq-list { padding: 0.4rem 1.5rem; display: flex; flex-direction: column; gap: 10px; }
        .faq-item { border: 1px solid var(--border); border-radius: 18px; background: var(--surface); }
        .faq-question { padding: 1.2rem; display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-weight: 700; font-size: 0.88rem; }
        .faq-answer { max-height: 0; overflow: hidden; padding: 0 1.2rem; color: var(--text-muted); font-size: 0.82rem; transition: 0.3s ease; }
        .faq-item.active .faq-answer { padding-bottom: 1.2rem; max-height: 150px; }

        .actions {
            padding: 1.25rem 1.5rem;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            position: fixed;
            bottom: 0;
            width: 100%;
            max-width: 430px;
            border-top: 1px solid var(--border);
            z-index: 1000;
        }
        .btn {
            display: block; width: 100%; padding: 1.15rem; border-radius: 20px;
            text-decoration: none; font-weight: 800; text-align: center; font-size: 0.95rem;
        }
        .btn-primary { background: var(--brand); color: white; margin-bottom: 10px; box-shadow: 0 8px 24px rgba(0, 98, 255, 0.2); }
        .btn-outline { color: var(--brand); background: var(--brand-soft); }

        .reveal { opacity: 0; transform: translateY(20px); transition: 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
        .reveal.visible { opacity: 1; transform: translateY(0); }
        @keyframes fadeInTop { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>

    <div class="app-container">
        <nav class="nav-bar">
            <a href="/" class="nav-logo">
                <div class="nav-logo-box">P</div>
                <span>Prepium</span>
            </a>
            <button class="nav-menu-btn" onclick="toggleMenu()">☰</button>
        </nav>

        <div class="mobile-menu" id="mobileMenu">
            <a href="#features" class="menu-link" onclick="toggleMenu()">🛡️ Core Features</a>
            <a href="#testimonials" class="menu-link" onclick="toggleMenu()">💬 Testimonials</a>
            
            <% if (locals.user && user.role === 'admin') { %>
                <a href="/admin/analytics" class="menu-link" style="color: var(--brand)">📊 Strategic Intel</a>
            <% } %>

            <a href="/login" class="menu-link">🔐 Sign In</a>
        </div>

        <header class="hero">
            <span class="hero-badge">🚀 Continuous Assessment Portal</span>
            <h1>Prepium</h1>
            <p class="tagline">The ultimate CBT practice engine for ambitious students.</p>
        </header>

        <div class="section-title reveal" id="features">Why Prepium?</div>
        <section class="features-grid">
            <div class="card reveal">
                <div style="font-size: 1.5rem;">⚡</div>
                <div>
                    <h3 style="margin:0; font-size:0.95rem;">Fast-Track Mastery</h3>
                    <p style="margin:3px 0 0; font-size:0.8rem; color:var(--text-muted);">Clean, distraction-free test environments.</p>
                </div>
            </div>
            <div class="card reveal">
                <div style="font-size: 1.5rem;">🎯</div>
                <div>
                    <h3 style="margin:0; font-size:0.95rem;">Mixed Topics</h3>
                    <p style="margin:3px 0 0; font-size:0.8rem; color:var(--text-muted);">Combine subjects into one custom attempt.</p>
                </div>
            </div>
        </section>

        <div class="section-title reveal" id="testimonials">Success Stories</div>
        <section class="testimonials-container reveal">
            <div class="testimonial-track">
                <div class="t-card">
                    <div class="t-user">
                        <div class="t-avatar">AA</div>
                        <div><div class="t-name">Stephanie A.</div><div style="font-size:0.7rem; color:var(--text-muted)">Physics Dept.</div></div>
                    </div>
                    <p class="t-text">"The LaTeX support for physics formulas is perfect. Finally, a platform that understands my curriculum!"</p>
                </div>
                <div class="t-card">
                    <div class="t-user">
                        <div class="t-avatar">DO</div>
                        <div><div class="t-name">Daniel O.</div><div style="font-size:0.7rem; color:var(--text-muted)">Pharmacy</div></div>
                    </div>
                    <p class="t-text">"Strategic analytics helped me see exactly where I was failing. My scores jumped by 30%."</p>
                </div>
            </div>
        </section>

        <div class="section-title reveal">Common Questions</div>
        <section class="faq-list reveal">
            <div class="faq-item">
                <div class="faq-question" onclick="toggleFaq(this)">Is my payment renewable? <span>+</span></div>
                <div class="faq-answer">No, its a one-time payment.</div>
            </div>
            <div class="faq-item">
                <div class="faq-question" onclick="toggleFaq(this)">Can I use it on mobile? <span>+</span></div>
                <div class="faq-answer">Prepium is fully optimized for mobile browsers with an app-like experience.</div>
            </div>
        </section>

        <div class="actions">
            <a href="/signup" class="btn btn-primary">Create Account</a>
            <a href="/login" class="btn btn-outline">Sign In</a>
        </div>
    </div>

    <script>
        function toggleMenu() { document.getElementById('mobileMenu').classList.toggle('open'); }
        function toggleFaq(el) {
            const item = el.parentElement;
            item.classList.toggle('active');
            el.querySelector('span').innerText = item.classList.contains('active') ? '−' : '+';
        }
        const reveals = document.querySelectorAll('.reveal');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); });
        }, { threshold: 0.1 });
        reveals.forEach(el => observer.observe(el));
    </script>
</body>
</html>