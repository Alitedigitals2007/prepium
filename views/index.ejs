<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        .app-container {
            width: 100%;
            max-width: 430px;
            background: var(--surface);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            box-shadow: var(--shadow-sm);
            overflow-x: hidden;
            padding-bottom: 140px;
            padding-top: 60px;
        }

        .nav-bar {
            position: fixed;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            max-width: 430px;
            background: var(--surface);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            z-index: 1000;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--text-primary);
            font-weight: 800;
            font-size: 1.15rem;
        }

        .nav-logo-box {
            background: var(--brand);
            color: white;
            width: 34px;
            height: 34px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }

        .nav-menu-btn {
            background: var(--surface-solid);
            border: 1px solid var(--border);
            width: 40px;
            height: 40px;
            border-radius: 12px;
            font-size: 1.15rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
        }

        .nav-links { display: none; }
        .nav-links a { text-decoration: none; }

        .mobile-menu {
            display: none;
            flex-direction: column;
            background: var(--surface-solid);
            border-bottom: 1px solid var(--border);
            padding: 0.8rem 1.5rem;
            gap: 6px;
        }
        .mobile-menu.open { display: flex; animation: fadeInTop 0.3s ease forwards; }

        .menu-link {
            text-decoration: none;
            color: var(--text-muted);
            font-weight: 700;
            font-size: 0.9rem;
            padding: 12px 14px;
            border-radius: 14px;
        }

        .hero {
            padding: 3rem 1.5rem 2.2rem;
            background: linear-gradient(180deg, var(--brand-soft) 0%, var(--surface-solid) 100%);
            text-align: center;
            border-bottom-left-radius: 40px;
            border-bottom-right-radius: 40px;
        }

        .hero-badge {
            display: inline-flex;
            background: var(--surface-solid);
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.72rem;
            font-weight: 800;
            color: var(--brand);
            box-shadow: var(--shadow-sm);
            margin-bottom: 1.2rem;
            text-transform: uppercase;
            border: 1px solid var(--brand-light);
        }

        h1 { font-size: 2.5rem; font-weight: 800; margin: 0; letter-spacing: -1.2px; color: var(--brand); }
        .tagline { color: var(--text-secondary); font-size: 0.98rem; margin-top: 12px; font-weight: 600; }

        .carousel-wrapper {
            position: relative;
            width: 100%;
            overflow: hidden;
            padding: 10px 0;
            background: linear-gradient(90deg, transparent 0%, var(--brand-light) 50%, transparent 100%);
        }
        
        .carousel-wrapper::before, .carousel-wrapper::after {
            content: "";
            position: absolute;
            top: 0;
            width: 40px;
            height: 100%;
            z-index: 2;
            pointer-events: none;
        }
        .carousel-wrapper::before { left: 0; background: linear-gradient(90deg, var(--surface), transparent); }
        .carousel-wrapper::after { right: 0; background: linear-gradient(-90deg, var(--surface), transparent); }

        .partner-track { 
            display: flex;
            width: max-content;
            gap: 16px;
            animation: scrollMarquee 15s linear infinite;
        }

        .partner-card { 
            background: var(--surface); 
            padding: 10px 20px; 
            border-radius: 20px; 
            border: 1px solid var(--border);
            display: flex; 
            align-items: center; 
            gap: 10px;
            box-shadow: var(--shadow-sm);
        }
        .partner-card img { 
            width: 32px; 
            height: 32px; 
            object-fit: contain; 
        }
        .partner-name { 
            font-size: 0.72rem; 
            font-weight: 800; 
            color: var(--text-primary); 
            letter-spacing: 0.3px;
        }

        .features-grid { padding: 0.4rem 1.5rem; display: grid; gap: 0.85rem; }
        .card {
            background: var(--surface);
            padding: 1.15rem;
            border-radius: 22px;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .testimonials-container { padding: 0.5rem 0 1rem; overflow: hidden; }
        .testimonial-track {
            display: flex;
            gap: 16px;
            padding: 0 1.5rem;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scrollbar-width: none;
        }
        .testimonial-track::-webkit-scrollbar { display: none; }
        .t-card {
            min-width: 280px;
            background: var(--surface-solid);
            padding: 1.5rem;
            border-radius: 24px;
            border: 1px solid var(--border);
            scroll-snap-align: center;
        }
        .t-user { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
        .t-avatar { width: 36px; height: 36px; background: var(--brand-soft); color: var(--brand); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.8rem; }
        .t-name { font-size: 0.85rem; font-weight: 800; color: var(--text-primary); }
        .t-text { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; font-style: italic; }

        .faq-list { padding: 0.4rem 1.5rem; display: flex; flex-direction: column; gap: 10px; }
        .faq-item { border: 1px solid var(--border); border-radius: 18px; background: var(--surface); }
        .faq-question { padding: 1.2rem; display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-weight: 700; font-size: 0.88rem; color: var(--text-primary); }
        .faq-answer { max-height: 0; overflow: hidden; padding: 0 1.2rem; color: var(--text-muted); font-size: 0.82rem; transition: 0.3s ease; }
        .faq-item.active .faq-answer { padding-bottom: 1.2rem; max-height: 150px; }

        .actions {
            padding: 1.25rem 1.5rem;
            background: var(--surface);
            backdrop-filter: blur(20px);
            position: fixed;
            bottom: 0;
            width: 100%;
            max-width: 430px;
            border-top: 1px solid var(--border);
            z-index: 1000;
        }
        
        /* ── Desktop ── */
        @media (min-width: 992px) {
            body { display: flex; justify-content: center; }

            .app-container {
                max-width: none;
                width: 100%;
                box-shadow: none;
                border: none;
                padding-bottom: 3rem;
                padding-top: 0;
            }

            .nav-bar {
                position: sticky;
                top: 0;
                left: 0;
                transform: none;
                width: 100%;
                max-width: none;
                padding: 0.85rem 3rem;
            }

            .nav-menu-btn { display: none; }
            .mobile-menu { display: none !important; }

            .nav-links { display: flex; align-items: center; gap: 4px; }
            .nav-links a { font-weight: 700; font-size: 0.88rem; color: var(--text-secondary); padding: 9px 14px; border-radius: 10px; transition: 0.2s; }
            .nav-links a:hover { color: var(--brand); background: var(--brand-soft); }
            .nav-links .nav-cta-outline { border: 1px solid var(--border-solid); color: var(--text-primary); }
            .nav-links .nav-cta { background: var(--brand-gradient); color: white; padding: 10px 22px; border-radius: 12px; box-shadow: 0 6px 18px rgba(99, 102, 241, 0.25); }
            .nav-links .nav-cta:hover { color: white; transform: translateY(-1px); }

            .hero { padding: 5rem 2rem 4.2rem; border-bottom-left-radius: 60px; border-bottom-right-radius: 60px; }
            .hero-badge { font-size: 0.8rem; padding: 8px 18px; }
            .hero h1 { font-size: 4rem; letter-spacing: -2px; }
            .hero .tagline { font-size: 1.2rem; max-width: 640px; margin-left: auto; margin-right: auto; }

            .section-title { text-align: center; padding: 2.8rem 1rem 0.9rem; font-size: 0.9rem; }
            .section-title + div { max-width: 1200px; margin: 0 auto; }
            .section-title + div[style*="padding"] { text-align: center; }
            .partner-card img { width: 40px; height: 40px; }

            .features-grid {
                max-width: 1200px;
                margin: 0 auto;
                grid-template-columns: repeat(3, 1fr);
                gap: 1.2rem;
                padding: 0.8rem 2rem;
            }
            .card { padding: 1.6rem; border-radius: 24px; flex-direction: column; align-items: flex-start; gap: 14px; }
            .card i { font-size: 2rem !important; }
            .card h3 { font-size: 1.05rem !important; }
            .card p { font-size: 0.88rem !important; }

            .testimonials-container { max-width: 1200px; margin: 0 auto; padding: 0.5rem 2rem 1rem; overflow: visible; }
            .testimonial-track { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 18px; padding: 0; overflow: visible; scroll-snap-type: none; }
            .t-card { min-width: 0; }

            .faq-list { max-width: 820px; margin: 0 auto; padding: 0.6rem 1rem; }

            .actions {
                position: static;
                max-width: none;
                width: auto;
                background: transparent;
                border: none;
                backdrop-filter: none;
                padding: 2.5rem 1rem 1rem;
                display: flex;
                justify-content: center;
                gap: 16px;
            }
            .actions .btn { width: 240px; }
        }

        @keyframes scrollMarquee {
            0% { transform: translateX(0); }
            100% { transform: translateX(calc(-50% - 8px)); }
        }
        @keyframes fadeInTop { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
