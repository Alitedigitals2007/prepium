<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Smart Exam Mastery</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand: #0062ff;
            --brand-soft: #eef4ff;
            --success: #00c853;
            --text-dark: #0a0c10;
            --text-muted: #5f6672;
            --surface: #ffffff;
            --bg-light: #f4f7fa;
            --border: #edf2f7;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

        body {
            background-color: var(--bg-light);
            color: var(--text-dark);
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            display: flex;
            justify-content: center;
        }

        /* Fixed Mobile-App Shell Frame */
        .app-container {
            width: 100%;
            max-width: 430px;
            background: var(--surface);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            box-shadow: 0 0 40px rgba(0,0,0,0.03);
            overflow-y: auto;
            padding-bottom: 135px; /* Spacing for the fixed action tray */
        }

        /* Nav Bar */
        .nav-bar {
            position: sticky;
            top: 0;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            z-index: 1000;
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
            animation: slideDown 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--text-dark);
            font-weight: 800;
            font-size: 1.15rem;
            letter-spacing: -0.5px;
        }

        .nav-logo-box {
            background: var(--brand);
            color: white;
            width: 34px;
            height: 34px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            font-weight: 800;
            transition: transform 0.3s ease;
        }

        .nav-logo:hover .nav-logo-box {
            transform: scale(1.06) rotate(-5deg);
        }

        .nav-menu-btn {
            background: var(--bg-light);
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 12px;
            font-size: 1.15rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s, transform 0.2s;
        }
        
        .nav-menu-btn:active {
            transform: scale(0.92);
        }

        /* Floating Slide Overlay Menu */
        .mobile-menu {
            display: none;
            flex-direction: column;
            background: white;
            border-bottom: 1px solid var(--border);
            padding: 0.8rem 1.5rem;
            gap: 6px;
            animation: fadeInTop 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .mobile-menu.open { display: flex; }

        .menu-link {
            text-decoration: none;
            color: var(--text-muted);
            font-weight: 700;
            font-size: 0.9rem;
            padding: 12px 14px;
            border-radius: 14px;
            transition: 0.2s;
        }

        .menu-link:active {
            background: var(--brand-soft);
            color: var(--brand);
        }

        /* Hero Layout with Visual Entrance */
        .hero {
            padding: 3rem 1.5rem 2.2rem;
            background: linear-gradient(180deg, var(--brand-soft) 0%, #ffffff 100%);
            text-align: center;
            border-bottom-left-radius: 40px;
            border-bottom-right-radius: 40px;
            animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            background: white;
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.72rem;
            font-weight: 800;
            color: var(--brand);
            box-shadow: 0 4px 14px rgba(0,0,0,0.03);
            margin-bottom: 1.2rem;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            border: 1px solid rgba(0, 98, 255, 0.1);
            animation: pulseIn 2s infinite alternate;
        }

        h1 {
            font-size: 2.3rem;
            font-weight: 800;
            margin: 0;
            letter-spacing: -1.2px;
            color: var(--brand);
            line-height: 1.1;
            animation: scaleEntrance 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
        }

        .tagline {
            color: var(--text-muted);
            font-size: 0.98rem;
            margin-top: 12px;
            line-height: 1.5;
            font-weight: 600;
            animation: fadeIn 0.8s ease 0.3s both;
        }

        .stats-bar {
            display: flex;
            justify-content: center;
            gap: 16px;
            padding: 0.6rem 1rem;
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--success);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            animation: fadeIn 1s ease 0.4s both;
        }

        /* Section Reveal Titles */
        .section-title {
            padding: 2.2rem 1.5rem 0.6rem;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-muted);
            font-weight: 800;
        }

        /* Features List & Interactivity */
        .features-grid {
            padding: 0.4rem 1.5rem 1rem;
            display: grid;
            gap: 0.85rem;
        }

        .card {
            background: var(--surface);
            padding: 1.15rem;
            border-radius: 22px;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 16px;
            transition: 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer;
        }

        .card:active {
            transform: scale(0.96);
            border-color: var(--brand);
            background: #fafcff;
        }

        .card-icon {
            font-size: 1.4rem;
            height: 48px;
            width: 48px;
            background: var(--bg-light);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.3s ease;
        }

        .card:hover .card-icon {
            background: var(--brand-soft);
            transform: rotate(-3deg);
        }

        .card-info h3 {
            margin: 0;
            font-size: 0.95rem;
            font-weight: 800;
            color: var(--text-dark);
        }

        .card-info p {
            margin: 3px 0 0;
            font-size: 0.82rem;
            color: var(--text-muted);
            font-weight: 600;
        }

        /* Integrated Animated Step Mechanism */
        .steps-list {
            padding: 0.4rem 1.5rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .step-item {
            display: flex;
            gap: 16px;
            align-items: flex-start;
        }

        .step-number {
            background: var(--brand-soft);
            color: var(--brand);
            width: 34px;
            height: 34px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.9rem;
            flex-shrink: 0;
            transition: 0.3s ease;
        }

        .step-item:hover .step-number {
            background: var(--brand);
            color: white;
            transform: scale(1.08);
        }

        .step-body h4 {
            margin: 0 0 4px;
            font-size: 0.95rem;
            font-weight: 800;
            color: var(--text-dark);
        }

        .step-body p {
            margin: 0;
            font-size: 0.85rem;
            color: var(--text-muted);
            line-height: 1.48;
            font-weight: 600;
        }

        /* Bottom Fixed Dynamic Panel */
        .actions {
            padding: 1.25rem 1.5rem;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            position: fixed;
            bottom: 0;
            width: 100%;
            max-width: 430px;
            border-top: 1px solid var(--border);
            z-index: 1000;
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .btn {
            display: block;
            width: 100%;
            padding: 1.15rem;
            border-radius: 20px;
            text-decoration: none;
            font-weight: 800;
            text-align: center;
            font-size: 0.95rem;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .btn-primary {
            background: var(--brand);
            color: white;
            margin-bottom: 10px;
            box-shadow: 0 8px 24px rgba(0, 98, 255, 0.25);
        }

        .btn-primary:active { transform: scale(0.965); }

        .btn-outline {
            color: var(--brand);
            background: var(--brand-soft);
            font-weight: 700;
        }
        .btn-outline:active { background: #e2edff; }

        /* Animation System Classes */
        .reveal {
            opacity: 0;
            transform: translateY(24px);
            transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes fadeInTop {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes slideDown {
            from { transform: translateY(-100%); }
            to { transform: translateY(0); }
        }

        @keyframes slideUp {
            from { transform: translateY(100%); }
            to { transform: translateY(0); }
        }

        @keyframes scaleEntrance {
            from { opacity: 0; transform: scale(0.93); }
            to { opacity: 1; transform: scale(1); }
        }

        @keyframes pulseIn {
            0% { transform: scale(1); border-color: rgba(0, 98, 255, 0.1); }
            100% { transform: scale(1.03); border-color: rgba(0, 98, 255, 0.25); }
        }
    </style>
</head>
<body>

    <div class="app-container">
        <nav class="nav-bar">
            <a href="/" class="nav-logo">
                <div class="nav-logo-box">P</div>
                <span>Prepium</span>
            </a>
            <button type="button" class="nav-menu-btn" onclick="toggleMenu()">☰</button>
        </nav>

        <div class="mobile-menu" id="mobileMenu">
            <a href="#features" class="menu-link" onclick="toggleMenu()">🛡️ Core Features</a>
            <a href="#how-it-works" class="menu-link" onclick="toggleMenu()">ℹ️ How It Works</a>
            <a href="/login" class="menu-link">🔐 Sign In</a>
        </div>

        <header class="hero">
            <span class="hero-badge">🚀 Continuous Assessment Portal</span>
            <h1>Prepium</h1>
            <p class="tagline">The ultimate CBT practice engine for ambitious students.</p>
        </header>

        <div class="stats-bar">
            <span>● Live Questions</span>
            <span>● Instant Feedback</span>
        </div>

        <div class="section-title reveal" id="features">Key Features</div>
        <section class="features-grid">
            <div class="card reveal">
                <div class="card-icon">⚡</div>
                <div class="card-info">
                    <h3>Fast-Track Mastery</h3>
                    <p>Experience clean, distraction-free test environments.</p>
                </div>
            </div>

            <div class="card reveal">
                <div class="card-icon">🎯</div>
                <div class="card-info">
                    <h3>Mixed Topics</h3>
                    <p>Combine multiple topics into a single exam attempt.</p>
                </div>
            </div>

            <div class="card reveal">
                <div class="card-icon">⏱️</div>
                <div class="card-info">
                    <h3>Real Conditions</h3>
                    <p>Simulate exam parameters with customizable timers.</p>
                </div>
            </div>
        </section>

        <div class="section-title reveal" id="how-it-works">How It Works</div>
        <section class="steps-list">
            <div class="step-item reveal">
                <div class="step-number">1</div>
                <div class="step-body">
                    <h4>Create an Account</h4>
                    <p>Sign up in seconds to start building custom test sessions matching your curriculum.</p>
                </div>
            </div>

            <div class="step-item reveal">
                <div class="step-number">2</div>
                <div class="step-body">
                    <h4>Customize Practice</h4>
                    <p>Choose your subjects, set the number of questions, and select a timing format.</p>
                </div>
            </div>

            <div class="step-item reveal">
                <div class="step-number">3</div>
                <div class="step-body">
                    <h4>Review Analytics</h4>
                    <p>Analyze in-depth performance stats and breakdown highlights immediately after testing.</p>
                </div>
            </div>
        </section>

        <div class="actions">
            <a href="/signup" class="btn btn-primary">Create Account</a>
            <a href="/login" class="btn btn-outline">Sign In</a>
        </div>
    </div>

    <script>
        function toggleMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('open');
        }

        // Apply progressive, scroll-driven staggered reveal
        const reveals = document.querySelectorAll('.reveal');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.1 });

        reveals.forEach(el => observer.observe(el));
    </script>
</body>
</html>