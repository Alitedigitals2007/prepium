<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium Mega Giveaway | Celebrate Eid & Children's Day</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand: #0062ff;
            --brand-dark: #004ecc;
            --brand-soft: #eef4ff;
            --festive-green: #047857;
            --text-dark: #0a0c10;
            --text-muted: #5f6672;
            --surface: #ffffff;
            --bg-gradient: linear-gradient(135deg, #f4f7fa 0%, #eef4ff 100%);
            --border: #edf2f7;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; outline: none; }

        body {
            background: var(--bg-gradient);
            color: var(--text-dark);
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            display: flex;
            justify-content: center;
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        /* Ambient Floating Festive Particles (Playful Eids & Kids Vibe) */
        .ambient-particle {
            position: absolute;
            font-size: 1.5rem;
            opacity: 0.15;
            user-select: none;
            pointer-events: none;
            animation: floatAround 12s ease-in-out infinite alternate;
        }
        @keyframes floatAround {
            0% { transform: translateY(0px) rotate(0deg); }
            100% { transform: translateY(-40px) rotate(20deg); }
        }

        .app-container {
            width: 100%;
            max-width: 430px;
            background: var(--surface);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            box-shadow: 0 0 40px rgba(0,0,0,0.03);
            overflow: hidden;
            padding-bottom: 140px; /* Space for the dock */
        }

        /* Nav Header Component */
        .nav-bar {
            background: var(--surface);
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--text-dark);
            font-weight: 800;
            font-size: 1.15rem;
        }

        .nav-logo-box {
            background: var(--brand);
            color: white;
            width: 34px;
            height: 34px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }

        /* Canvas Overlay for Confetti Burst */
        #confettiCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 99;
        }

        /* Multi-Stage Layer Panes */
        .stage-pane {
            display: none;
            flex-direction: column;
            padding: 1.8rem 1.5rem;
            flex-grow: 1;
        }

        .stage-pane.active {
            display: flex;
        }

        /* Slide Transitions Triggered via JavaScript */
        .slide-next { animation: slideNext 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .slide-back { animation: slideBack 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

        @keyframes slideNext {
            from { opacity: 0; transform: translateX(40px); }
            to { opacity: 1; transform: translateX(0); }
        }
        @keyframes slideBack {
            from { opacity: 0; transform: translateX(-40px); }
            to { opacity: 1; transform: translateX(0); }
        }

        /* Decorative Components */
        .festive-hero {
            background: linear-gradient(135deg, var(--brand-dark) 0%, var(--festive-green) 100%);
            padding: 2.2rem 1.5rem;
            border-radius: 24px;
            color: white;
            text-align: center;
            margin-bottom: 1.5rem;
            box-shadow: 0 10px 25px rgba(0, 98, 255, 0.12);
            position: relative;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.2);
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.8rem;
        }

        h1 { font-size: 1.85rem; font-weight: 800; margin: 0; letter-spacing: -1px; line-height: 1.25; }
        h2 { font-size: 1.35rem; font-weight: 800; margin: 0 0 0.5rem 0; color: var(--text-dark); letter-spacing: -0.5px; }
        
        .description-text {
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.6;
            margin-top: 0;
            margin-bottom: 1.25rem;
        }

        /* Feature Blocks for Explanation Stage */
        .feature-item {
            background: var(--bg-light);
            border: 1px solid var(--border);
            padding: 1.1rem;
            border-radius: 20px;
            display: flex;
            gap: 14px;
            margin-bottom: 10px;
            align-items: flex-start;
        }

        .feature-icon {
            font-size: 1.4rem;
            line-height: 1;
        }

        .feature-title { font-weight: 700; font-size: 0.95rem; margin: 0 0 4px 0; }
        .feature-desc { font-size: 0.82rem; color: var(--text-muted); margin: 0; line-height: 1.4; }

        /* Form Styling Elements */
        .input-wrapper { margin-bottom: 1.15rem; }
        .input-wrapper label {
            display: block;
            font-size: 0.8rem;
            font-weight: 800;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
        }

        input, select {
            width: 100%;
            padding: 0.95rem;
            border: 1.5px solid var(--border);
            background: var(--bg-light);
            border-radius: 16px;
            font-family: inherit;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-dark);
            transition: all 0.2s ease;
        }

        input:focus, select:focus {
            border-color: var(--brand);
            background: var(--surface);
            box-shadow: 0 0 0 4px rgba(0, 98, 255, 0.1);
        }

        /* Fixed Footer Dynamic Nav Action Dock */
        .action-dock {
            padding: 1.25rem 1.5rem;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            position: absolute;
            bottom: 0;
            width: 100%;
            border-top: 1px solid var(--border);
            z-index: 1000;
        }

        .dock-buttons {
            display: flex;
            gap: 10px;
            width: 100%;
        }

        .btn {
            padding: 1.1rem;
            border-radius: 20px;
            font-weight: 800;
            text-align: center;
            font-size: 0.95rem;
            border: none;
            cursor: pointer;
            transition: transform 0.1s ease, background 0.2s ease;
        }

        .btn:active { transform: scale(0.97); }
        .btn-primary { background: var(--brand); color: white; flex-grow: 2; box-shadow: 0 8px 24px rgba(0, 98, 255, 0.15); }
        .btn-primary:hover { background: var(--brand-dark); }
        
        /* Glassmorphic Back Button Setup */
        .btn-back { 
            background: var(--brand-soft); 
            color: var(--brand); 
            flex-grow: 1; 
            display: none; /* Injected via stage checking script */
        }
        .btn-back:hover { background: #e2ecff; }

        /* Progress Bar/Dots Layer */
        .indicator-wrap {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-bottom: 1rem;
        }
        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--border);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .dot.active {
            background: var(--brand);
            width: 24px;
            border-radius: 4px;
        }
    </style>
</head>
<body>

    <!-- Ambient Playful Background Embellishments -->
    <div class="ambient-particle" style="top: 10%; left: 5%; animation-delay: 0s;">🎈</div>
    <div class="ambient-particle" style="top: 25%; right: 6%; animation-delay: 2s;">✨</div>
    <div class="ambient-particle" style="bottom: 15%; left: 4%; animation-delay: 4s;">🍼</div>
    <div class="ambient-particle" style="bottom: 30%; right: 8%; animation-delay: 1s;">🎉</div>

    <div class="app-container">
        <!-- Interactive Canvas for programmatic particle celebration triggers -->
        <canvas id="confettiCanvas"></canvas>

        <nav class="nav-bar">
            <a href="#" class="nav-logo">
                <div class="nav-logo-box">P</div>
                <span>Prepium</span>
            </a>
        </nav>

        <!-- STAGE 1: Celebrate & Welcome Deck -->
        <div class="stage-pane active" id="stage1">
            <div class="festive-hero">
                <span class="hero-badge">Double Celebration 🌟</span>
                <h1>Eid & Children's Day Mega Giveaway!</h1>
            </div>
            <h2>Win Premium Rewards!</h2>
            <p class="description-text">We are rewarding ambitious students across Nigeria with fantastic educational prize packages, live scholarship funds, straight cash transfers, free high-speed airtime, and curated premium study tools!</p>
        </div>

        <!-- STAGE 2: Platform Motivation Explainer -->
        <div class="stage-pane" id="stage2">
            <h2>Supercharge Your Grades</h2>
            <p class="description-text">Before locking in your giveaway entries, here is a quick look at how Prepium helps you master your exams:</p>
            
            <div class="feature-item">
                <div class="feature-icon">⚡</div>
                <div>
                    <h3 class="feature-title">High-Speed CBT Engines</h3>
                    <p class="feature-desc">Simulate realistic, strict, distraction-free test conditions matched perfectly to your university curriculum.</p>
                </div>
            </div>

            <div class="feature-item">
                <div class="feature-icon">📊</div>
                <div>
                    <h3 class="feature-title">Strategic Analytics</h3>
                    <p class="feature-desc">Identify your core topic weaknesses instantly so you don't waste time studying the wrong things.</p>
                </div>
            </div>

            <div class="feature-item">
                <div class="feature-icon">🔬</div>
                <div>
                    <h3 class="feature-title">LaTeX Math & Science Formulas</h3>
                    <p class="feature-desc">Flawless complex mathematical equations and structural formatting designed for premium technical clarity.</p>
                </div>
            </div>
        </div>

        <!-- STAGE 3: Secure Verified Registration Form -->
        <div class="stage-pane" id="stage3">
            <h2>Complete Registration</h2>
            <p class="description-text">Provide your accurate academic details below to claim your rewards and verify your entry.</p>

            <form action="/submit-giveaway" method="POST" id="giveawayForm">
                <div class="input-wrapper">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" placeholder="e.g., Alite Israel" required>
                </div>

                <div class="input-wrapper">
                    <label for="department">Department / Course</label>
                    <input type="text" id="department" name="department" placeholder="e.g., Physics" required>
                </div>

                <div class="input-wrapper">
                    <label for="phone">WhatsApp Number</label>
                    <input type="tel" id="phone" name="phone" placeholder="e.g., 08123456789" required>
                </div>

                <div class="input-wrapper">
                    <label for="uniSelector">Your University</label>
                    <select name="university" id="uniSelector" onchange="toggleCustomInput(this)" required>
                        <option value="" disabled selected>-- Choose Institution --</option>
                        <% universities.forEach(function(uni) { %>
                            <option value="<%= uni %>"><%= uni %></option>
                        <% }) %>
                        <option value="Other">Other (Type your school name)</option>
                    </select>
                </div>

                <div class="input-wrapper" id="customBlock" style="display: none;">
                    <label for="customUniField">Type School Name</label>
                    <input type="text" name="customUniversity" id="customUniField" placeholder="Enter full university name">
                </div>
            </form>
        </div>

        <!-- Control Action Dock Setup -->
        <div class="action-dock">
            <div class="indicator-wrap">
                <div class="dot active" id="dot1"></div>
                <div class="dot" id="dot2"></div>
                <div class="dot" id="dot3"></div>
            </div>
            <div class="dock-buttons">
                <button type="button" class="btn btn-back" id="backBtn" onclick="regressStage()">Back</button>
                <button type="button" class="btn btn-primary" id="footerBtn" onclick="advanceStage()">Next Channel</button>
            </div>
        </div>
    </div>

    <script>
        let currentStage = 1;

        // Interactive Canvas Confetti System Configurations
        const canvas = document.getElementById("confettiCanvas");
        const ctx = canvas.getContext("2d");
        let confettiParticles = [];

        function resizeCanvas() {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function spawnConfetti() {
            const colors = ["#0062ff", "#047857", "#fbbf24", "#ec4899", "#a855f7"];
            for (let i = 0; i < 60; i++) {
                confettiParticles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height - canvas.height,
                    r: Math.random() * 6 + 4,
                    d: Math.random() * canvas.height,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    tilt: Math.random() * 10 - 5,
                    tiltAngleIncremental: Math.random() * 0.07 + 0.02,
                    tiltAngle: 0
                });
            }
        }

        function drawConfetti() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            confettiParticles.forEach((p, idx) => {
                p.tiltAngle += p.tiltAngleIncremental;
                p.y += (Math.cos(p.d) + 3 + p.r / 2) / 2;
                p.x += Math.sin(p.tiltAngle);
                p.tilt = Math.sin(p.tiltAngle - idx / 3) * 15;

                ctx.beginPath();
                ctx.lineWidth = p.r;
                ctx.strokeStyle = p.color;
                ctx.moveTo(p.x + p.tilt + p.r / 2, p.y);
                ctx.lineTo(p.x + p.tilt, p.y + p.tilt + p.r / 2);
                ctx.stroke();
            });

            confettiParticles = confettiParticles.filter(p => p.y <= canvas.height);
            if (confettiParticles.length > 0) {
                requestAnimationFrame(drawConfetti);
            }
        }

        // Trigger Confetti Drop instantly on mount to establish high-converting excitement
        spawnConfetti();
        drawConfetti();

        function updateUIState(directionAnimation) {
            // Cycle through all panels to assign visibility configurations
            for (let i = 1; i <= 3; i++) {
                const pane = document.getElementById(`stage${i}`);
                const dot = document.getElementById(`dot${i}`);
                
                if (i === currentStage) {
                    pane.className = `stage-pane active ${directionAnimation}`;
                    dot.classList.add('active');
                } else {
                    pane.className = 'stage-pane';
                    dot.classList.remove('active');
                }
            }

            // Sync Back Button display properties based on stage positional indices
            const backBtn = document.getElementById('backBtn');
            backBtn.style.display = currentStage > 1 ? 'block' : 'none';

            // Update Primary CTA text string variables
            const footerBtn = document.getElementById('footerBtn');
            if (currentStage === 3) {
                footerBtn.innerText = "Claim Entry Rewards";
            } else {
                footerBtn.innerText = "Next Channel";
            }
        }

        function advanceStage() {
            if (currentStage < 3) {
                currentStage++;
                updateUIState('slide-next');
                // Drop context-sensitive subtle micro-confetti when shifting segments
                if(currentStage === 2) { spawnConfetti(); drawConfetti(); }
            } else if (currentStage === 3) {
                const form = document.getElementById('giveawayForm');
                if (form.checkValidity()) {
                    form.submit();
                } else {
                    form.reportValidity();
                }
            }
        }

        function regressStage() {
            if (currentStage > 1) {
                currentStage--;
                updateUIState('slide-back');
            }
        }

        function toggleCustomInput(selectElement) {
            const block = document.getElementById('customBlock');
            const field = document.getElementById('customUniField');
            if (selectElement.value === 'Other') {
                block.style.display = 'block';
                field.setAttribute('required', 'true');
                field.focus();
            } else {
                block.style.display = 'none';
                field.removeAttribute('required');
                field.value = '';
            }
        }
    </script>
</body>
</html>