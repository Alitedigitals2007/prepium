<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        :root { --brand: #2563eb; --bg: #f8fafc; --text: #1e293b; }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); margin: 0; display: flex; justify-content: center; }
        
        .auth-shell { 
            width: 100%; 
            max-width: 430px; 
            background: var(--surface-solid); 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            padding: 2.5rem 2rem; 
        }
        
        .logo-small { color: var(--brand); font-weight: 800; font-size: 1.2rem; margin-bottom: 2rem; display: block; text-decoration: none; }
        h1 { font-size: 1.8rem; font-weight: 800; margin: 0; }
        p { color: var(--text-secondary); font-size: 0.95rem; margin-top: 8px; }
        
        .header { margin-bottom: 2rem; }
        .form-group { margin-bottom: 1.2rem; }
        
        label { display: block; font-size: 0.75rem; font-weight: 800; margin-bottom: 8px; color: var(--text-muted); text-transform: uppercase; padding-left: 4px; }
        input { 
            width: 100%; 
            padding: 1.1rem; 
            border-radius: 20px; 
            border: 2px solid var(--bg); 
            background: var(--bg); 
            font-size: 1.1rem; 
            font-weight: 700;
            outline: none; 
            transition: 0.3s; 
            font-family: monospace;
            letter-spacing: 1px;
        }
        input:focus { border-color: var(--brand); background: var(--surface-solid); box-shadow: 0 0 0 4px rgba(37,99,235,0.08); }
        
        .btn-primary { 
            background: var(--brand); 
            color: var(--surface-solid); 
            border: none; 
            width: 100%; 
            padding: 1.2rem; 
            border-radius: 22px; 
            font-size: 1rem; 
            font-weight: 700; 
            cursor: pointer; 
            margin-top: 1.5rem; 
            box-shadow: 0 10px 20px rgba(37,99,235,0.15); 
        }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>

    <div class="auth-shell">
        <a href="/" class="logo-small">Prepium.</a>
        
        <div class="header">
            <h1>Ambassador Login</h1>
            <p>Sign in to track earnings and referrals.</p>
        </div>

        <form action="/ambassador/login" method="POST">
            <div class="form-group">
                <label>Unique Ambassador ID</label>
                <input type="text" name="unique_code" placeholder="E.g. PREP-1234" required autofocus>
            </div>
            <button type="submit" class="btn-primary">Sign In</button>
        </form>
    </div>

<script src="/js/animations.js"></script>
</body>
</html>