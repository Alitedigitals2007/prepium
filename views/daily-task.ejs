<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Daily Task</title>
    <%- include('partials/design-head') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .page-header { padding: 1.5rem 1.5rem 0.5rem; display: flex; align-items: center; justify-content: space-between; }
        .page-header h1 { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.5px; }
        .page-header .date-badge { font-size: 0.68rem; font-weight: 700; color: var(--text-sub); background: #f1f5f9; padding: 6px 14px; border-radius: 20px; }

        .summary-strip { display: flex; gap: 8px; padding: 0.5rem 1.5rem 1rem; }
        .sum-card { flex: 1; background: white; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px 10px; text-align: center; }
        .sum-card .num { font-size: 1.2rem; font-weight: 800; }
        .sum-card .lbl { font-size: 0.55rem; color: var(--text-sub); font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; margin-top: 2px; }
        .sum-card.green .num { color: var(--success); }
        .sum-card.orange .num { color: var(--warning); }
        .sum-card.blue .num { color: var(--brand); }
        .sum-card.purple .num { color: #7c3aed; }

        .section-head { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.5rem 0.4rem; }
        .section-head h3 { font-size: 0.82rem; font-weight: 800; letter-spacing: -0.2px; display: flex; align-items: center; gap: 6px; }
        .section-head .add-btn { font-size: 0.65rem; font-weight: 700; color: var(--brand); background: none; border: none; cursor: pointer; font-family: inherit; padding: 4px 8px; border-radius: 6px; }
        .section-head .add-btn:hover { background: var(--brand-soft); }

        .content-pad { padding: 0 1.5rem; }
        .list-card { background: white; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px 14px; margin-bottom: 8px; display: flex; align-items: center; gap: 12px; }
        .list-card .lc-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; flex-shrink: 0; }
        .list-card .lc-body { flex: 1; min-width: 0; }
        .list-card .lc-title { font-weight: 700; font-size: 0.78rem; }
        .list-card .lc-meta { font-size: 0.63rem; color: var(--text-sub); font-weight: 600; }
        .list-card .lc-action { font-size: 0.7rem; color: var(--text-muted); cursor: pointer; }
        .list-card .lc-action:hover { color: var(--danger); }

        .task-check { width: 22px; height: 22px; border-radius: 6px; border: 2px solid var(--border); display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; transition: var(--transition); font-size: 0.65rem; color: white; }
        .task-check.done { background: var(--success); border-color: var(--success); }

        .deadline-urgent { border-left: 3px solid var(--danger); }
        .deadline-soon { border-left: 3px solid var(--warning); }
        .deadline-later { border-left: 3px solid var(--success); }

        .goal-check { width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--border); display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; font-size: 0.6rem; color: white; transition: var(--transition); }
        .goal-check.done { background: #7c3aed; border-color: #7c3aed; }

        .add-row { display: flex; gap: 8px; padding: 0 1.5rem 8px; }
        .add-row input { flex: 1; padding: 10px 12px; border: 1.5px solid var(--border); border-radius: var(--radius-sm); font-family: inherit; font-size: 0.78rem; font-weight: 600; outline: none; }
        .add-row input:focus { border-color: var(--brand); }
        .add-row button { padding: 10px 16px; border-radius: var(--radius-sm); border: none; background: var(--brand-gradient); color: white; font-weight: 700; font-size: 0.72rem; cursor: pointer; }

        .empty-state { text-align: center; padding: 1.5rem; color: var(--text-muted); }
        .empty-state i { font-size: 1.5rem; display: block; margin-bottom: 6px; }

        .week-report { background: white; border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; margin: 0 1.5rem 1rem; }
        .week-report .wr-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .week-report .wr-header h4 { font-size: 0.78rem; font-weight: 800; }
        .week-report .wr-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
        .week-report .wr-bar-bg { flex: 1; height: 8px; background: #f1f5f9; border-radius: 4px; overflow: hidden; }
        .week-report .wr-bar { height: 100%; border-radius: 4px; transition: width 0.5s var(--ease-out); }
        .week-report .wr-label { font-size: 0.68rem; font-weight: 700; width: 70px; flex-shrink: 0; }
        .week-report .wr-val { font-size: 0.68rem; font-weight: 700; width: 40px; text-align: right; flex-shrink: 0; }
        .week-report .wr-percent { font-size: 1.1rem; font-weight: 800; text-align: center; padding: 8px; border-radius: 10px; background: var(--brand-soft); color: var(--brand); margin-bottom: 10px; }

        .reading-badge { font-size: 0.6rem; padding: 2px 8px; border-radius: 4px; font-weight: 700; background: #dbeafe; color: #1e40af; margin-left: 6px; }

        @media (min-width: 431px) { .app-shell { border-left: 1px solid var(--glass-border); border-right: 1px solid var(--glass-border); margin: 0 auto; } }
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="page-header">
        <div>
            <h1>Daily Task</h1>
        </div>
        <div class="date-badge"><i class="fas fa-calendar-alt"></i> <%= new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }) %></div>
    </div>

    <div class="summary-strip">
        <div class="sum-card green">
            <div class="num"><%= weekStats.done %></div>
            <div class="lbl">Done Today</div>
        </div>
        <div class="sum-card orange">
            <div class="num"><%= weekStats.total %></div>
            <div class="lbl">Total Tasks</div>
        </div>
        <div class="sum-card blue">
            <div class="num"><%= Math.floor(weekStats.studyMins / 60) %>h</div>
            <div class="lbl">Studied</div>
        </div>
        <div class="sum-card purple">
            <div class="num"><%= weekStats.avgScore %>%</div>
            <div class="lbl">Avg Quiz</div>
        </div>
    </div>

    <div class="section-head">
        <h3><i class="fas fa-flag-checkered" style="color:#7c3aed"></i> Personal Goals</h3>
        <button class="add-btn" onclick="addGoal()"><i class="fas fa-plus"></i> Add</button>
    </div>
    <div id="goalsList" class="content-pad">
        <% if (goals && goals.length > 0) { %>
            <% goals.forEach(function(g) { %>
            <div class="list-card" data-goal-id="<%= g.id %>">
                <div class="goal-check <%= g.is_completed ? 'done' : '' %>" onclick="toggleGoal(<%= g.id %>)">
                    <% if (g.is_completed) { %><i class="fas fa-check"></i><% } %>
                </div>
                <div class="lc-body">
                    <div class="lc-title" style="<%= g.is_completed ? 'text-decoration:line-through;color:var(--text-muted)' : '' %>"><%= g.goal %></div>
                    <% if (g.target_date) { %><div class="lc-meta">Due: <%= g.target_date %></div><% } %>
                </div>
                <div class="lc-action" onclick="deleteGoal(<%= g.id %>)"><i class="fas fa-times"></i></div>
            </div>
            <% }); %>
        <% } else { %>
            <div class="empty-state"><i class="fas fa-bullseye"></i>No goals yet. Add one!</div>
        <% } %>
    </div>

    <div class="section-head">
        <h3><i class="fas fa-chalkboard-teacher" style="color:var(--brand)"></i> Today's Classes</h3>
    </div>
    <div class="content-pad">
        <% if (slots && slots.length > 0) { %>
            <% slots.forEach(function(s) { %>
            <div class="list-card">
                <div class="lc-icon" style="background:var(--brand-soft);color:var(--brand)"><i class="fas fa-book"></i></div>
                <div class="lc-body">
                    <div class="lc-title"><%= s.course %></div>
                    <div class="lc-meta"><%= s.course_code ? s.course_code + ' &middot; ' : '' %><%= s.start_time?.substring(0,5) %> - <%= s.end_time?.substring(0,5) %><%= s.venue ? ' &middot; ' + s.venue : '' %></div>
                </div>
            </div>
            <% }); %>
        <% } else { %>
            <div class="empty-state"><i class="fas fa-calendar-day"></i>No classes scheduled today</div>
        <% } %>
    </div>

    <div class="section-head">
        <h3><i class="fas fa-clock" style="color:#0891b2"></i> Study Schedule</h3>
    </div>
    <div class="content-pad">
        <% if (readingSlots && readingSlots.length > 0) { %>
            <% readingSlots.forEach(function(r) { %>
            <div class="list-card">
                <div class="lc-icon" style="background:#dbeafe;color:#0284c7"><i class="fas fa-book-open"></i></div>
                <div class="lc-body">
                    <div class="lc-title"><%= r.course %></div>
                    <div class="lc-meta"><%= r.start_time?.substring(0,5) %> - <%= r.end_time?.substring(0,5) %></div>
                </div>
                <span class="reading-badge"><%= r.course_code || '' %></span>
            </div>
            <% }); %>
        <% } else { %>
            <div class="empty-state"><i class="fas fa-clock"></i>No study sessions scheduled</div>
        <% } %>
    </div>

    <div class="section-head">
        <h3><i class="fas fa-hourglass-half" style="color:var(--danger)"></i> Deadlines</h3>
    </div>
    <div class="content-pad">
        <% if (deadlines && deadlines.length > 0) { %>
            <% deadlines.forEach(function(d) { %>
            <div class="list-card">
                <div class="lc-body">
                    <div class="lc-title"><%= d.title %></div>
                    <div class="lc-meta"><%= d.date_str %> at <%= d.time_str %></div>
                </div>
            </div>
            <% }); %>
        <% } else { %>
            <div class="empty-state"><i class="fas fa-hourglass-half"></i>No upcoming deadlines</div>
        <% } %>
    </div>

    <div class="section-head">
        <h3><i class="fas fa-check-circle" style="color:var(--success)"></i> Today's Tasks</h3>
        <button class="add-btn" onclick="generateTasks()"><i class="fas fa-magic"></i> Auto</button>
    </div>
    <div id="tasksList" class="content-pad">
        <% if (tasks && tasks.length > 0) { %>
            <% tasks.forEach(function(t) { %>
            <div class="list-card" data-task-id="<%= t.id %>">
                <div class="task-check <%= t.is_done ? 'done' : '' %>" onclick="toggleTask(<%= t.id %>)">
                    <% if (t.is_done) { %><i class="fas fa-check"></i><% } %>
                </div>
                <div class="lc-body">
                    <div class="lc-title" style="<%= t.is_done ? 'text-decoration:line-through;color:var(--text-muted)' : '' %>"><%= t.task_label %></div>
                    <div class="lc-meta"><%= t.task_type %></div>
                </div>
            </div>
            <% }); %>
        <% } else { %>
            <div class="empty-state"><i class="fas fa-tasks"></i>No tasks for today. Tap "Auto" to generate.</div>
        <% } %>
    </div>

    <div class="section-head">
        <h3><i class="fas fa-chart-line" style="color:var(--warning)"></i> Weekly Report</h3>
    </div>
    <div class="week-report" id="weekReport">
        <% var weekPct = weekStats.total > 0 ? Math.round((weekStats.done / weekStats.total) * 100) : 0; %>
        <div class="wr-percent"><%= weekPct %>%</div>
        <div class="wr-header"><h4>This Week's Progress</h4></div>
        <div class="wr-row">
            <span class="wr-label">Tasks</span>
            <div class="wr-bar-bg"><div class="wr-bar" style="width:<%= weekPct %>%"></div></div>
            <span class="wr-val"><%= weekStats.done %>/<%= weekStats.total %></span>
        </div>
        <div class="wr-row">
            <span class="wr-label">Study</span>
            <div class="wr-bar-bg"><div class="wr-bar" style="width:<%= Math.min(100, (weekStats.studyMins / 420) * 100) %>%;background:var(--brand)"></div></div>
            <span class="wr-val"><%= Math.floor(weekStats.studyMins / 60) %>h</span>
        </div>
        <div class="wr-row">
            <span class="wr-label">Quizzes</span>
            <div class="wr-bar-bg"><div class="wr-bar" style="width:<%= weekStats.avgScore %>%;background:#7c3aed"></div></div>
            <span class="wr-val"><%= weekStats.quizCount %></span>
        </div>
        <div style="display:flex;gap:8px;margin-top:12px">
            <button style="flex:1;padding:10px;border-radius:8px;border:none;background:var(--brand-gradient);color:white;font-weight:700;font-size:0.72rem;cursor:pointer" onclick="viewFullReport()"><i class="fas fa-expand"></i> Full Report</button>
        </div>
    </div>

    <div style="height:40px"></div>
    <%- include('partials/bottom-nav', { activeNav: 'dashboard' }) %>
</div>

<script>
function addGoal() {
    Swal.fire({ title: 'New Goal', html: '<input id="goal-input" class="swal2-input" placeholder="What do you want to achieve?" style="width:100%"><input id="goal-date" class="swal2-input" type="date" style="width:100%;margin-top:8px">', showCancelButton: true, confirmButtonText: 'Add', preConfirm: function() {
        var goal = document.getElementById('goal-input').value.trim();
        if (!goal) { Swal.showValidationMessage('Enter a goal'); return; }
        return fetch('/api/daily-task/goal', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ goal: goal, target_date: document.getElementById('goal-date').value || null }) }).then(r => r.json());
    }}).then(function(r) { if (r.isConfirmed && r.value.success) location.reload(); });
}

function toggleGoal(id) {
    fetch('/api/daily-task/goal/toggle/' + id, { method: 'POST' }).then(r => r.json()).then(function(d) { if (d.success) location.reload(); });
}

function deleteGoal(id) {
    Swal.fire({ title: 'Remove goal?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Remove' }).then(function(res) {
        if (res.isConfirmed) {
            fetch('/api/daily-task/goal/delete/' + id, { method: 'POST' }).then(r => r.json()).then(function(d) { if (d.success) location.reload(); });
        }
    });
}

function toggleTask(taskId) {
    fetch('/api/daily-task/task/toggle', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ taskId: taskId }) }).then(r => r.json()).then(function(d) { if (d.success) location.reload(); });
}

function generateTasks() {
    Swal.fire({ title: 'Generating tasks...', html: 'Creating tasks from your schedule', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); } });
    fetch('/api/daily-task/generate-tasks', { method: 'POST' }).then(r => r.json()).then(function(d) {
        if (d.success) { Swal.fire({ icon: 'success', text: d.count + ' tasks created!', timer: 1500, showConfirmButton: false }); setTimeout(function() { location.reload(); }, 1500); }
        else Swal.fire({ icon: 'error', text: d.error });
    });
}

function viewFullReport() {
    Swal.fire({ title: 'Loading report...', html: 'Compiling weekly stats', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); } });
    fetch('/api/daily-task/weekly-report').then(r => r.json()).then(function(d) {
        Swal.close();
        var html = '<div style="text-align:left;font-size:0.8rem">';
        if (d.days && d.days.length) {
            html += '<h4 style="font-size:0.85rem;font-weight:800;margin-bottom:8px;color:var(--success)">Daily Tasks</h4>';
            d.days.forEach(function(day) {
                var pct = day.total > 0 ? Math.round((day.done / day.total) * 100) : 0;
                html += '<div style="display:flex;justify-content:space-between;padding:4px 0;font-size:0.72rem;font-weight:600"><span>' + day.task_date + '</span><span>' + day.done + '/' + day.total + ' (' + pct + '%)</span></div>';
            });
        }
        if (d.study && d.study.length) {
            html += '<h4 style="font-size:0.85rem;font-weight:800;margin:12px 0 8px;color:var(--brand)">Study Time</h4>';
            d.study.forEach(function(s) {
                var mins = Math.round((s.secs || 0) / 60);
                html += '<div style="display:flex;justify-content:space-between;padding:4px 0;font-size:0.72rem;font-weight:600"><span>' + s.d + '</span><span>' + Math.floor(mins / 60) + 'h ' + (mins % 60) + 'm</span></div>';
            });
        }
        if (d.quizzes && d.quizzes.length) {
            html += '<h4 style="font-size:0.85rem;font-weight:800;margin:12px 0 8px;color:#7c3aed">Quizzes</h4>';
            d.quizzes.forEach(function(q) {
                html += '<div style="display:flex;justify-content:space-between;padding:4px 0;font-size:0.72rem;font-weight:600"><span>' + q.d + '</span><span>' + q.cnt + ' quizzes, ' + q.avg + '% avg</span></div>';
            });
        }
        if (!d.days && !d.study && !d.quizzes) html += '<div style="text-align:center;color:var(--text-muted);padding:1rem">No data this week yet</div>';
        html += '</div>';
        Swal.fire({ title: 'Weekly Analysis', html: html, width: 400, confirmButtonText: 'Close', confirmButtonColor: 'var(--brand)' });
    });
}
</script>
</body>
</html>
