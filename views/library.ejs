<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        .lib-wrap { max-width: 900px; margin: 0 auto; padding: 24px 16px 60px; }
        .lib-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
        .lib-logo { display: flex; align-items: center; gap: 10px; font-weight: 800; color: var(--text-primary); text-decoration: none; font-size: 1.05rem; }
        .lib-logo span { width: 34px; height: 34px; border-radius: 10px; background: var(--brand-gradient); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; }
        .lib-hero { text-align: center; padding: 18px 0 26px; }
        .lib-hero h1 { font-size: clamp(1.5rem, 5vw, 2.1rem); font-weight: 800; color: var(--text-primary); margin: 0 0 8px; letter-spacing: -0.02em; }
        .lib-hero p { font-size: 0.92rem; color: var(--text-secondary); max-width: 520px; margin: 0 auto; line-height: 1.6; }
        .lib-search { display: flex; gap: 8px; max-width: 520px; margin: 22px auto 0; }
        .lib-search input {
            flex: 1; padding: 13px 16px; border-radius: 14px;
            border: 1px solid var(--border); background: var(--surface-solid);
            color: var(--text-primary); font-family: var(--font); font-size: 0.9rem; min-width: 0;
        }
        .lib-search button { padding: 13px 20px; border-radius: 14px; border: none; background: var(--brand-gradient); color: #fff; font-weight: 800; font-size: 0.85rem; cursor: pointer; }
        .lib-section-title { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin: 30px 0 12px; }
        .uni-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
        .uni-card {
            display: flex; align-items: center; gap: 12px; padding: 14px;
            border-radius: 16px; background: var(--surface); border: 1px solid var(--border);
            text-decoration: none; color: inherit; transition: var(--transition);
        }
        .uni-card:hover { border-color: var(--brand); box-shadow: var(--shadow-md); }
        .uni-card .uc-badge { width: 40px; height: 40px; flex: 0 0 40px; border-radius: 12px; background: var(--brand-soft); color: var(--brand); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem; }
        .uni-card .uc-body { min-width: 0; }
        .uni-card .uc-name { font-size: 0.8rem; font-weight: 700; line-height: 1.3; }
        .uni-card .uc-meta { font-size: 0.66rem; color: var(--text-muted); font-weight: 600; margin-top: 2px; }
        .result-row {
            display: flex; align-items: center; gap: 12px; padding: 13px 14px;
            border-radius: 14px; background: var(--surface); border: 1px solid var(--border);
            margin-bottom: 8px; text-decoration: none; color: inherit;
        }
        .result-row .rr-code { font-size: 0.72rem; font-weight: 800; color: var(--brand); background: var(--brand-soft); padding: 4px 9px; border-radius: 8px; flex-shrink: 0; }
        .result-row .rr-body { flex: 1; min-width: 0; }
        .result-row .rr-title { font-size: 0.84rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .result-row .rr-meta { font-size: 0.66rem; color: var(--text-muted); font-weight: 600; }
        .lib-foot { text-align: center; margin-top: 40px; font-size: 0.75rem; color: var(--text-muted); }
        .lib-foot a { color: var(--brand); font-weight: 700; text-decoration: none; }
    </style>
</head>
<body>
    <div class="lib-wrap">
        <div class="lib-top">
            <a href="/" class="lib-logo"><span>P</span> Prepium</a>
            <div style="display:flex;gap:8px;">
                <% if (user) { %><a href="/dashboard" class="btn btn-outline btn-sm" style="text-decoration:none;">Dashboard</a><% } else { %><a href="/login" class="btn btn-outline btn-sm" style="text-decoration:none;">Sign in</a><% } %>
            </div>
        </div>

        <div class="lib-hero">
            <h1>Course Library</h1>
            <p>Browse courses by university, faculty and department — with lecture notes, past questions and solutions shared by students.</p>
            <form class="lib-search" method="get" action="/library" role="search">
                <input type="search" name="q" value="<%= q %>" placeholder="Search course code or title, e.g. CHM 101" aria-label="Search courses">
                <button type="submit"><i class="fas fa-search"></i> Search</button>
            </form>
        </div>

        <% if (q) { %>
            <div class="lib-section-title">Results for "<%= q %>"</div>
            <% if (results.length) { %>
                <% results.forEach(function(c) { %>
                <a href="/library/course/<%= c.id %>" class="result-row">
                    <span class="rr-code"><%= c.code || '—' %></span>
                    <div class="rr-body">
                        <div class="rr-title"><%= c.title %></div>
                        <div class="rr-meta"><%= c.department %> · <%= c.university %> · <%= c.resource_count %> resource<%= c.resource_count == 1 ? '' : 's' %></div>
                    </div>
                </a>
                <% }); %>
            <% } else { %>
                <div class="notice-strip"><i class="fas fa-circle-info"></i><span>No courses matched "<%= q %>". Try a different code or title.</span></div>
            <% } %>
        <% } %>

        <div class="lib-section-title">Browse by university</div>
        <div class="uni-grid">
            <% universities.forEach(function(u) { %>
            <a href="/library/<%= u.slug %>" class="uni-card">
                <div class="uc-badge"><%= u.name.charAt(0) %></div>
                <div class="uc-body">
                    <div class="uc-name"><%= u.name %></div>
                    <div class="uc-meta"><%= u.course_count %> course<%= u.course_count == 1 ? '' : 's' %> listed</div>
                </div>
            </a>
            <% }); %>
        </div>

        <div class="lib-foot">
            Are you a student? <a href="/signup">Create an account</a> to contribute notes and past questions to your school's library.
        </div>
    </div>
</body>
</html>
