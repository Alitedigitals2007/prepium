<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--text-primary); min-height: 100vh; }
        .app-shell { display: flex; min-height: 100vh; }
        .main-area { flex: 1; padding: 1.5rem; overflow-y: auto; max-width: 900px; margin: 0 auto; width: 100%; }
        .header-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.2rem; }
        .header-title { font-weight: 800; font-size: 1rem; }
        .back-circle { width: 38px; height: 38px; border-radius: 50%; background: var(--surface-solid); border: 1px solid var(--border-solid); display: flex; align-items: center; justify-content: center; color: var(--text-primary); }
        .card { background: var(--surface-solid); border-radius: 20px; padding: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.04); margin-bottom: 1rem; }
        .path-head { display: flex; gap: 16px; align-items: center; margin-bottom: 18px; }
        .path-icon { width: 56px; height: 56px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: white; flex-shrink: 0; }
        .ic-blue { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }
        .ic-green { background: linear-gradient(135deg, #10b981, #059669); }
        .ic-purple { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
        .ic-orange { background: linear-gradient(135deg, #f97316, #ea580c); }
        .ic-red { background: linear-gradient(135deg, #ef4444, #dc2626); }
        .ic-amber { background: linear-gradient(135deg, #f59e0b, #d97706); }
        .ic-teal { background: linear-gradient(135deg, #14b8a6, #0d9488); }
        .ic-indigo { background: linear-gradient(135deg, #6366f1, #4f46e5); }
        .ic-rose { background: linear-gradient(135deg, #f43f5e, #e11d48); }
        .lesson { border: 1px solid var(--border-solid); border-radius: 16px; padding: 18px; margin-bottom: 12px; background: var(--surface-solid); }
        .lesson.done { border-color: rgba(16,185,129,0.4); }
        .lesson-top { display: flex; align-items: flex-start; gap: 12px; }
        .lesson-num { width: 30px; height: 30px; border-radius: 10px; background: var(--bg); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.78rem; flex-shrink: 0; }
        .lesson.done .lesson-num { background: rgba(16,185,129,0.15); color: #10b981; }
        .lesson-title { font-weight: 800; font-size: 0.9rem; }
        .lesson-summary { font-size: 0.78rem; color: var(--text-secondary); margin-top: 2px; }
        .lesson-body { font-size: 0.84rem; line-height: 1.65; color: var(--text-secondary); margin-top: 12px; display: none; }
        .lesson.open .lesson-body { display: block; }
        .lesson-res { display: inline-flex; align-items: center; gap: 6px; font-size: 0.76rem; font-weight: 700; color: var(--brand); text-decoration: none; margin-top: 10px; }
        .lesson-actions { display: flex; gap: 8px; margin-top: 14px; }
        .btn { padding: 10px 20px; border-radius: 12px; border: none; font-family: inherit; font-weight: 700; font-size: 0.78rem; cursor: pointer; display: inline-flex; align-items: center; gap: 7px; }
        .btn-primary { background: linear-gradient(135deg, var(--brand), #1d4ed8); color: white; }
        .btn-outline { background: var(--surface-solid); border: 1.5px solid var(--border-solid); color: var(--text-primary); }
        .btn-ghost { background: var(--bg); color: var(--text-secondary); }
        .xp-badge { font-size: 0.68rem; font-weight: 800; color: #10b981; background: rgba(16,185,129,0.12); padding: 4px 10px; border-radius: 20px; }
        .proj { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border-solid); font-size: 0.82rem; }
        .proj:last-child { border-bottom: none; }
        input[type="text"], textarea { width: 100%; padding: 11px 14px; border-radius: 12px; border: 1.5px solid var(--border-solid); background: var(--bg); color: var(--text-primary); font-family: inherit; font-size: 0.84rem; }
        textarea { min-height: 80px; resize: vertical; }
        .xp-toast { position: fixed; top: 18px; left: 50%; transform: translateX(-50%); background: #10b981; color: white; padding: 10px 20px; border-radius: 30px; font-weight: 800; font-size: 0.8rem; z-index: 999; opacity: 0; transition: opacity 0.3s; pointer-events: none; }
        .xp-toast.show { opacity: 1; }
        .note { font-size: 0.72rem; color: var(--text-secondary); background: var(--bg); padding: 10px 14px; border-radius: 12px; line-height: 1.5; margin-top: 12px; }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="xp-toast" id="xpToast"></div>
<div class="app-shell">
    <div class="main-area">
        <div class="header-nav">
            <a href="/skills" class="back-circle"><i class="fas fa-arrow-left"></i></a>
            <div class="header-title"><%= skillPath.title %></div>
            <%- include('partials/drawer-trigger') %>
        </div>

        <div class="card">
            <div class="path-head">
                <div class="path-icon ic-<%= skillPath.tone || 'blue' %>"><i class="fas <%= skillPath.icon || 'fa-star' %>"></i></div>
                <div>
                    <div style="font-weight:800; font-size:1.05rem;"><%= skillPath.title %></div>
                    <div style="font-size:0.78rem; color:var(--text-secondary);"><%= skillPath.description %></div>
                </div>
            </div>
            <div style="height:8px; background:var(--bg); border-radius:8px; overflow:hidden;">
                <div style="height:100%; width:<%= lessons.length ? Math.round((lessons.filter(function(l){return l.done;}).length / lessons.length) * 100) : 0 %>%; background:linear-gradient(90deg, var(--brand), #1d4ed8);"></div>
            </div>
            <p style="font-size:0.7rem; color:var(--text-secondary); margin-top:6px;"><%= lessons.filter(function(l){return l.done;}).length %> of <%= lessons.length %> lessons complete · +15 XP per lesson</p>
        </div>

        <% lessons.forEach(function (l, i) { %>
            <div class="lesson <%= l.done ? 'done' : '' %>" id="lesson-<%= l.id %>">
                <div class="lesson-top" onclick="toggleLesson(<%= l.id %>)" style="cursor:pointer;">
                    <div class="lesson-num"><%= l.done ? '✓' : (i + 1) %></div>
                    <div style="flex:1;">
                        <div class="lesson-title"><%= l.title %></div>
                        <div class="lesson-summary"><%= l.summary %> · <%= l.est_minutes %> min</div>
                    </div>
                    <i class="fas fa-chevron-down" style="color:var(--text-secondary); font-size:0.75rem;"></i>
                </div>
                <div class="lesson-body">
                    <p><%= l.content %></p>
                    <% if (l.resource_url) { %>
                        <a class="lesson-res" href="<%= l.resource_url %>" target="_blank" rel="noopener"><i class="fas fa-arrow-up-right-from-square"></i> <%= l.resource_label || 'External resource' %></a>
                    <% } %>
                    <div class="lesson-actions">
                        <% if (l.done) { %>
                            <span class="xp-badge"><i class="fas fa-check"></i> Completed</span>
                        <% } else { %>
                            <button class="btn btn-primary" onclick="completeLesson(<%= l.id %>)"><i class="fas fa-check"></i> Mark complete (+15 XP)</button>
                        <% } %>
                    </div>
                </div>
            </div>
        <% }); %>

        <div class="card">
            <h3 style="font-weight:800; font-size:0.95rem; margin-bottom:4px;"><i class="fas fa-diagram-project" style="color:var(--brand);"></i> Practical projects</h3>
            <p style="font-size:0.75rem; color:var(--text-secondary); margin-bottom:12px;">Lesson completion alone never equals mastery — a submitted project is the real evidence. +100 XP.</p>
            <% projects.forEach(function (p) { %>
                <div class="proj">
                    <div>
                        <div style="font-weight:700;"><%= p.title %></div>
                        <% if (p.notes) { %><div style="font-size:0.72rem; color:var(--text-secondary);"><%= p.notes.slice(0, 120) %></div><% } %>
                    </div>
                    <span class="xp-badge"><i class="fas fa-paper-plane"></i> Submitted</span>
                </div>
            <% }); %>
            <div style="margin-top:14px;">
                <input type="text" id="projTitle" placeholder="Project title — e.g. My CGPA calculator build" maxlength="200" style="margin-bottom:8px;">
                <textarea id="projNotes" placeholder="What did you build? Link your repo or screenshots..."></textarea>
                <button class="btn btn-primary" style="margin-top:10px;" onclick="submitProject()"><i class="fas fa-paper-plane"></i> Submit project</button>
            </div>
        </div>

        <%- include('partials/bottom-nav', { activeNav: activeNav }) %>
    </div>
</div>
<script>
    function toggleLesson(id) {
        document.getElementById('lesson-' + id).classList.toggle('open');
    }
    function toast(msg) {
        var t = document.getElementById('xpToast');
        t.textContent = msg;
        t.classList.add('show');
        setTimeout(function () { t.classList.remove('show'); }, 2200);
    }
    function completeLesson(id) {
        fetch('/api/skills/<%= skillPath.slug %>/lessons/' + id + '/complete', { method: 'POST' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d.success) {
                    if (d.xp_awarded) toast('+' + d.xp_awarded + ' XP');
                    setTimeout(function () { window.location.reload(); }, 800);
                }
            });
    }
    function submitProject() {
        var title = document.getElementById('projTitle').value.trim();
        if (!title) return;
        fetch('/api/skills/<%= skillPath.slug %>/projects', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ title: title, notes: document.getElementById('projNotes').value })
        }).then(function (r) { return r.json(); }).then(function (d) {
            if (d.success) {
                toast('+' + d.xp_awarded + ' XP — project submitted!');
                setTimeout(function () { window.location.reload(); }, 900);
            }
        });
    }
</script>
</body>
</html>
