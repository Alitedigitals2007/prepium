<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Instructions</title>
    <%- include('partials/design-head') %>
    <style>
        .app-shell { padding: 2rem 1.5rem; }
        @media (min-width: 1024px) { .app-shell { padding-left: 1.5rem !important; } }
        
        .card { background: #f8fafc; border: 1px solid #f1f5f9; border-radius: 24px; padding: 1.5rem; margin-bottom: 20px; }
        .subject-tag { display: inline-block; background: white; padding: 5px 12px; border-radius: 10px; font-weight: 800; font-size: 0.8rem; border: 1px solid #e2e8f0; margin: 5px; }
        
        .instruction-item { display: flex; gap: 15px; margin-bottom: 15px; align-items: flex-start; }
        .icon { width: 40px; height: 40px; background: #eff6ff; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
        
        .go-btn { background: var(--brand); color: white; width: 100%; padding: 1.2rem; border-radius: 20px; border: none; font-weight: 800; font-size: 1.1rem; cursor: pointer; box-shadow: 0 10px 20px rgba(0, 98, 255, 0.2); }
    </style>
</head>
<body>
    <div class="app-shell">
        <h2 style="font-weight: 800; font-size: 1.6rem;">Ready for your Exam?</h2>
        <p style="color: #64748b; font-weight: 600;">Confirm your selection below before we start the timer.</p>

        <div class="card">
            <h4 style="margin: 0 0 10px; font-weight: 800;">Selected Subjects</h4>
            <% setup.summary.forEach(s => { %>
                <span class="subject-tag"><%= s.name %> (<%= s.count %>)</span>
            <% }) %>
            <hr style="border: 0; border-top: 1px solid #e2e8f0; margin: 15px 0;">
            <div style="display: flex; justify-content: space-between; font-weight: 800;">
                <span>Total Questions: <%= setup.totalQs %></span>
                <span>Time: <%= setup.duration %> Mins</span>
            </div>
        </div>

        <h4 style="font-weight: 800;">Important Instructions</h4>
        <div class="instruction-item">
            <div class="icon">⏱️</div>
            <div><b style="display: block;">Timed Session</b> Once you click "Start", the countdown begins and cannot be paused.</div>
        </div>
        <div class="instruction-item">
            <div class="icon">💾</div>
            <div><b style="display: block;">Auto-Save</b> Your progress is saved as you answer. You can jump between questions.</div>
        </div>
        <div class="instruction-item">
            <div class="icon">🚫</div>
            <div><b style="display: block;">Strict Exit</b> Closing the app or refreshing may submit your current progress.</div>
        </div>

        <form action="/live-exam" method="POST">
            <button type="submit" class="go-btn">Confirm & Start Quiz 🚀</button>
        </form>
        <p style="text-align: center; margin-top: 15px;"><a href="/setup-test" style="color: #94a3b8; font-weight: 800; text-decoration: none;">Change Selection</a></p>
    </div>
<script src="/js/animations.js"></script>
</body>
</html>