<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>CGPA Tracker | Prepium</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cabinet+Grotesk:wght@400;500;700;800;900&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<style>
/* ══════════════════════════════════════════════
   TOKENS
══════════════════════════════════════════════ */
:root {
    --ink:     #09090b;
    --ink-2:   #52525b;
    --ink-3:   #a1a1aa;
    --surface: #ffffff;
    --s2:      #fafafa;
    --s3:      #f4f4f5;
    --border:  #e4e4e7;
    --border2: #d4d4d8;

    --blue:    #2563eb;
    --blue-d:  #1d4ed8;
    --blue-lt: rgba(37,99,235,0.07);
    --teal:    #0d9488;
    --teal-lt: rgba(13,148,136,0.07);
    --amber:   #b45309;
    --amber-lt:rgba(180,83,9,0.07);
    --rose:    #e11d48;
    --rose-lt: rgba(225,29,72,0.07);
    --violet:  #7c3aed;
    --violet-lt:rgba(124,58,237,0.07);
    --green:   #16a34a;
    --green-lt:rgba(22,163,74,0.07);

    --r-sm: 10px; --r: 16px; --r-lg: 20px; --r-xl: 28px;
    --sh: 0 1px 2px rgba(0,0,0,0.04), 0 4px 16px rgba(0,0,0,0.04);
    --sh2:0 2px 4px rgba(0,0,0,0.04), 0 8px 24px rgba(0,0,0,0.06);
}

*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; -webkit-tap-highlight-color:transparent; }
html { scroll-behavior:smooth; }

body {
    font-family: 'Instrument Sans', sans-serif;
    background: var(--s2);
    color: var(--ink);
    min-height: 100dvh;
    display: flex;
    justify-content: center;
    overflow-x: hidden;
}

/* centered mobile shell */
.shell {
    width: 100%; max-width: 430px;
    background: var(--surface);
    min-height: 100dvh;
    padding-bottom: 96px;
    box-shadow: 0 0 80px rgba(0,0,0,0.05);
    position: relative;
    animation: appear .3s cubic-bezier(.16,1,.3,1);
}
@keyframes appear { from{opacity:0;transform:translateY(5px)} to{opacity:1;transform:translateY(0)} }

/* ══════════════ TOP BAR ══════════════ */
.topbar {
    position: sticky; top: 0; z-index: 800;
    height: 56px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 16px;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--border);
}
.topbar-brand {
    display: flex; align-items: center; gap: 9px;
    font-family: 'Cabinet Grotesk', sans-serif;
    font-weight: 800; font-size: .95rem; color: var(--ink);
    text-decoration: none;
}
.topbar-logo {
    width: 30px; height: 30px; border-radius: 8px;
    background: var(--ink);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: .7rem;
}
.topbar-right { display: flex; gap: 8px; align-items: center; }
.icon-btn {
    width: 34px; height: 34px; border-radius: var(--r-sm);
    background: var(--s3); border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--ink-2); font-size: .78rem;
    cursor: pointer; transition: .15s; text-decoration: none;
}
.icon-btn:hover { background: var(--border); color: var(--ink); }
.export-btn {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: .72rem; font-weight: 700;
    background: var(--ink); color: #fff; border: none;
    padding: 7px 13px; border-radius: var(--r-sm);
    cursor: pointer; transition: .2s;
}
.export-btn:hover { background: #27272a; }

/* ══════════════ FLASH MESSAGE ══════════════ */
.flash {
    margin: 12px 14px 0;
    padding: 11px 14px;
    background: var(--teal-lt);
    border: 1px solid rgba(13,148,136,.2);
    border-radius: var(--r-sm);
    font-size: .8rem; font-weight: 600; color: var(--teal);
    display: flex; align-items: center; gap: 7px;
    animation: appear .25s ease;
}

/* ══════════════════════════════════════════════
   SETUP WIZARD
══════════════════════════════════════════════ */
.wizard-wrap { padding: 20px 14px 0; }
.wizard-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: 26px 20px;
    box-shadow: var(--sh2);
}

/* step progress */
.prog-bar {
    height: 3px; background: var(--s3); border-radius: 2px;
    margin-bottom: 24px; overflow: hidden;
}
.prog-fill {
    height: 100%; border-radius: 2px;
    background: linear-gradient(90deg, var(--blue), var(--violet));
    transition: width .35s cubic-bezier(.4,0,.2,1);
}

.wiz-step { display: none; }
.wiz-step.on { display: block; animation: appear .22s ease; }

.wiz-eyebrow {
    font-size: .62rem; font-weight: 700; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--blue); margin-bottom: 5px;
}
.wiz-title {
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: 1.45rem; font-weight: 900; margin-bottom: 5px;
}
.wiz-sub { font-size: .8rem; color: var(--ink-2); line-height: 1.55; margin-bottom: 22px; }

/* path cards */
.path-card {
    width: 100%; text-align: left;
    background: var(--s2); border: 1.5px solid var(--border);
    border-radius: var(--r-lg); padding: 16px;
    cursor: pointer; margin-bottom: 10px;
    transition: .18s; display: block;
}
.path-card:hover { border-color: var(--blue); background: var(--blue-lt); }
.path-card-head { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
.path-dot {
    width: 32px; height: 32px; border-radius: 9px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: .8rem;
}
.path-dot.a { background: var(--blue-lt); color: var(--blue); }
.path-dot.b { background: var(--violet-lt); color: var(--violet); }
.path-card strong { font-family: 'Cabinet Grotesk',sans-serif; font-size: .9rem; font-weight: 800; }
.path-card p { font-size: .74rem; color: var(--ink-2); line-height: 1.5; padding-left: 42px; }

.balance-hint {
    background: var(--s3); border-radius: var(--r-sm); padding: 13px;
    margin-bottom: 14px; font-size: .73rem; color: var(--ink-2); line-height: 1.6;
}
.balance-hint strong { color: var(--ink); }

/* ══════════════ FORM ELEMENTS ══════════════ */
.fg { margin-bottom: 13px; }
.fg label {
    display: block; font-size: .62rem; font-weight: 700;
    letter-spacing: .8px; text-transform: uppercase; color: var(--ink-2);
    margin-bottom: 6px;
}
.fg input, .fg select {
    width: 100%; padding: 11px 13px;
    background: var(--s2); border: 1.5px solid var(--border);
    border-radius: var(--r-sm); outline: none;
    font-family: 'Instrument Sans', sans-serif;
    font-size: .9rem; font-weight: 500; color: var(--ink);
    transition: .15s; appearance: none; -webkit-appearance: none;
}
.fg input:focus, .fg select:focus { border-color: var(--blue); background: #fff; }
.fg select option { background: #fff; }
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

.btn {
    width: 100%; padding: 13px; border: none; border-radius: var(--r-lg);
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: .85rem; font-weight: 800; letter-spacing: .3px;
    cursor: pointer; transition: .18s;
    display: flex; align-items: center; justify-content: center; gap: 7px;
}
.btn:active { transform: scale(.98); }
.btn-primary { background: var(--ink); color: #fff; }
.btn-primary:hover { background: #27272a; }
.btn-ghost {
    background: none; color: var(--ink-2);
    border: 1.5px solid var(--border); margin-top: 8px;
}
.btn-ghost:hover { background: var(--s3); color: var(--ink); }
.btn-danger { background: var(--rose-lt); color: var(--rose); border: 1.5px solid rgba(225,29,72,.15); margin-top: 8px; }
.btn-danger:hover { background: rgba(225,29,72,.14); }

/* ══════════════════════════════════════════════
   DASHBOARD
══════════════════════════════════════════════ */

/* ── Hero ── */
.hero {
    margin: 14px 14px 0;
    background: var(--ink);
    border-radius: var(--r-xl);
    padding: 26px 22px 24px;
    color: #fff; position: relative; overflow: hidden;
    box-shadow: 0 8px 32px rgba(9,9,11,.18);
}
.hero::before {
    content: '';
    position: absolute; inset: 0;
    background:
        radial-gradient(ellipse 80% 70% at 110% -10%, rgba(37,99,235,.35) 0%, transparent 60%),
        radial-gradient(ellipse 50% 50% at -10% 110%, rgba(124,58,237,.25) 0%, transparent 60%);
    pointer-events: none;
}
.hero-grid { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; }
.hero-left {}
.hero-eyebrow {
    font-size: .58rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
    color: rgba(255,255,255,.45); margin-bottom: 6px;
}
.hero-cgpa {
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: 5.5rem; font-weight: 900; line-height: .9;
    letter-spacing: -4px; color: #fff;
    animation: pop .5s cubic-bezier(.34,1.56,.64,1);
}
@keyframes pop { from{transform:scale(.85);opacity:0} to{transform:scale(1);opacity:1} }
.hero-scale {
    font-size: .7rem; font-weight: 600; color: rgba(255,255,255,.4);
    letter-spacing: .5px; margin-top: 5px;
}

/* ring */
.ring-wrap { position: relative; width: 88px; height: 88px; flex-shrink: 0; }
.ring-wrap svg { display: block; transform: rotate(-90deg); }
.ring-bg   { fill: none; stroke: rgba(255,255,255,.1); stroke-width: 8; }
.ring-fill {
    fill: none; stroke: url(#rg); stroke-width: 8; stroke-linecap: round;
    stroke-dasharray: 251.2; stroke-dashoffset: 251.2;
    transition: stroke-dashoffset 1.2s cubic-bezier(.4,0,.2,1);
}
.ring-pct {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: .78rem; font-weight: 700; color: rgba(255,255,255,.6);
}

.hero-bottom { position: relative; z-index: 1; margin-top: 16px; display: flex; align-items: center; justify-content: space-between; }
.div-badge {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: .68rem; font-weight: 700; padding: 4px 12px;
    border-radius: 50px;
}
.div-badge.first  { background:rgba(251,191,36,.15); color:#fbbf24; border:1px solid rgba(251,191,36,.2); }
.div-badge.upper  { background:rgba(96,165,250,.12); color:#60a5fa; border:1px solid rgba(96,165,250,.2); }
.div-badge.lower  { background:rgba(52,211,153,.12); color:#34d399; border:1px solid rgba(52,211,153,.2); }
.div-badge.third  { background:rgba(167,139,250,.12);color:#a78bfa; border:1px solid rgba(167,139,250,.2); }
.div-badge.fail   { background:rgba(251,113,133,.12);color:#fb7185; border:1px solid rgba(251,113,133,.2); }
.div-badge.none   { background:rgba(255,255,255,.07);color:rgba(255,255,255,.5); border:1px solid rgba(255,255,255,.1); }
.hero-meta { font-size: .68rem; color: rgba(255,255,255,.4); }

/* ── Stat tiles ── */
.tiles { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; margin: 10px 14px 0; }
.tile {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-lg); padding: 14px 10px 12px; text-align: center;
    box-shadow: var(--sh); position: relative; overflow: hidden;
}
.tile::after { content:''; position:absolute; top:0; left:0; right:0; height:2.5px; border-radius:2px 2px 0 0; }
.tile.t-blue::after  { background: linear-gradient(90deg,var(--blue),#60a5fa); }
.tile.t-teal::after  { background: linear-gradient(90deg,var(--teal),#2dd4bf); }
.tile.t-amber::after { background: linear-gradient(90deg,var(--amber),#fbbf24); }
.tile-icon { font-size: .65rem; margin-bottom: 6px; }
.tile.t-blue .tile-icon  { color: var(--blue); }
.tile.t-teal .tile-icon  { color: var(--teal); }
.tile.t-amber .tile-icon { color: var(--amber); }
.tile-num {
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: 1.55rem; font-weight: 900; line-height: 1; margin-bottom: 3px;
}
.tile.t-blue .tile-num  { color: var(--blue); }
.tile.t-teal .tile-num  { color: var(--teal); }
.tile.t-amber .tile-num { color: var(--amber); }
.tile-label { font-size: .57rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--ink-2); }

/* ── Analytics card ── */
.analytics {
    margin: 12px 14px 0;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-xl); padding: 18px; box-shadow: var(--sh);
}
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.section-label {
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: .82rem; font-weight: 800; display: flex; align-items: center; gap: 6px;
}
.section-label i { color: var(--blue); }
.chart-box { height: 150px; position: relative; margin-bottom: 14px; }
.grade-chips { display: grid; grid-template-columns: repeat(6,1fr); gap: 5px; }
.gchip {
    background: var(--s3); border: 1px solid var(--border);
    border-radius: var(--r-sm); padding: 7px 3px; text-align: center;
}
.gchip-letter {
    font-family: 'Cabinet Grotesk', sans-serif; font-size: 1rem; font-weight: 900; line-height: 1;
}
.gchip-letter.A { color: var(--amber); }
.gchip-letter.B { color: var(--blue); }
.gchip-letter.C { color: var(--teal); }
.gchip-letter.D { color: var(--violet); }
.gchip-letter.E { color: var(--ink-2); }
.gchip-letter.F { color: var(--rose); }
.gchip-count { font-size: .58rem; font-weight: 700; color: var(--ink-2); margin-top: 2px; text-transform: uppercase; }

/* ── Filter pills ── */
.filters { padding: 14px 14px 0; }
.pill-row { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
.pill-row::-webkit-scrollbar { display: none; }
.pill {
    white-space: nowrap;
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: .74rem; font-weight: 700;
    padding: 7px 14px; border-radius: 50px;
    background: var(--s3); border: 1px solid var(--border);
    color: var(--ink-2); cursor: pointer; transition: .15s;
    flex-shrink: 0;
}
.pill:hover { border-color: var(--border2); }
.pill.on { background: var(--ink); border-color: var(--ink); color: #fff; }

.filter-row2 {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 14px 0;
}
.gpa-live {
    font-family: 'Cabinet Grotesk', sans-serif; font-size: .8rem; font-weight: 800;
    color: var(--blue); background: var(--blue-lt);
    border: 1px solid rgba(37,99,235,.12);
    padding: 6px 13px; border-radius: 50px;
}

/* ── Course list ── */
.course-card {
    margin: 10px 14px 0;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r-xl); padding: 18px;
    box-shadow: var(--sh);
}
.course-card-head {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 14px;
}
.course-card-title { font-family:'Cabinet Grotesk',sans-serif; font-size:.88rem; font-weight:800; }
.course-card-meta  { font-size:.7rem; color:var(--ink-2); }

.crow {
    display: flex; align-items: center; justify-content: space-between;
    padding: 11px 0; border-bottom: 1px solid var(--border);
    animation: rowIn .22s ease both;
}
.crow:last-child { border-bottom: none; padding-bottom: 0; }
.crow:first-child { padding-top: 0; }
@keyframes rowIn { from{opacity:0;transform:translateX(-4px)} to{opacity:1;transform:translateX(0)} }
.crow.hidden-row { opacity: .35; }
.crow.hidden-row .ccode { text-decoration: line-through; }

.crow-left { flex: 1; min-width: 0; }
.ccode {
    font-family: 'Cabinet Grotesk', sans-serif; font-size: .92rem; font-weight: 800;
    display: flex; align-items: center; gap: 6px; margin-bottom: 3px;
}
.excl-tag {
    font-size: .52rem; font-weight: 700; text-transform: uppercase; letter-spacing: .3px;
    background: var(--s3); color: var(--ink-3); padding: 2px 6px; border-radius: 4px;
}
.cmeta { font-size: .68rem; color: var(--ink-2); display: flex; gap: 8px; }

.crow-right { display: flex; align-items: center; gap: 7px; flex-shrink: 0; }
.grade-chip {
    width: 36px; height: 36px; border-radius: var(--r-sm);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Cabinet Grotesk', sans-serif; font-weight: 900; font-size: .88rem;
    border: 1px solid var(--border);
}
.grade-chip.A { background:var(--amber-lt); color:var(--amber); border-color:rgba(180,83,9,.15); }
.grade-chip.B { background:var(--blue-lt);  color:var(--blue);  border-color:rgba(37,99,235,.15); }
.grade-chip.C { background:var(--teal-lt);  color:var(--teal);  border-color:rgba(13,148,136,.15); }
.grade-chip.D { background:var(--violet-lt);color:var(--violet);border-color:rgba(124,58,237,.15); }
.grade-chip.E { background:var(--s3);       color:var(--ink-2); }
.grade-chip.F { background:var(--rose-lt);  color:var(--rose);  border-color:rgba(225,29,72,.15); }

.act-row { display: flex; gap: 5px; }
.act {
    width: 30px; height: 30px; border-radius: var(--r-sm);
    background: var(--s3); border: 1px solid var(--border);
    color: var(--ink-2); font-size: .7rem;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: .15s;
}
.act:hover { background: var(--border); color: var(--ink); }
.act.danger:hover { background: var(--rose-lt); color: var(--rose); border-color:rgba(225,29,72,.2); }
.act.eye-on { background:rgba(180,83,9,.07); color:var(--amber); border-color:rgba(180,83,9,.15); }

.empty-state { text-align: center; padding: 32px 0 16px; }
.empty-state i { font-size: 2rem; color: var(--border2); display: block; margin-bottom: 10px; }
.empty-state p { font-size: .8rem; color: var(--ink-2); }

/* ── Reset section ── */
.reset-section {
    margin: 16px 14px 0;
    background: var(--s2); border: 1.5px dashed var(--border);
    border-radius: var(--r-lg); padding: 16px;
}
.reset-section h4 {
    font-family:'Cabinet Grotesk',sans-serif; font-size:.8rem; font-weight:800;
    color:var(--ink); margin-bottom:5px; display:flex;align-items:center;gap:6px;
}
.reset-section h4 i { color: var(--rose); }
.reset-section p { font-size:.73rem; color:var(--ink-2); line-height:1.5; }

/* ══════════════════════════════════════════════
   OVERLAYS
══════════════════════════════════════════════ */
.overlay {
    display: none; position: fixed; inset: 0; z-index: 2000;
    background: #fff; overflow-y: auto; padding-bottom: 48px;
}
.overlay.show { display: block; animation: appear .2s ease; }
.ov-inner { max-width: 430px; margin: 0 auto; padding: 14px; }
.ov-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 8px 0 16px; border-bottom: 1px solid var(--border); margin-bottom: 18px;
}
.ov-title { font-family:'Cabinet Grotesk',sans-serif; font-size:1rem; font-weight:900; }
.ov-close {
    width: 32px; height: 32px; border-radius: 50%;
    background: var(--s3); border: none;
    display: flex; align-items: center; justify-content: center;
    color: var(--ink-2); cursor: pointer; font-size: .85rem;
}

/* ══════════════════════════════════════════════
   BOTTOM NAV
══════════════════════════════════════════════ */
.bnav {
    position: fixed; bottom: 14px; left: 50%; transform: translateX(-50%);
    width: calc(100% - 28px); max-width: 402px; height: 62px;
    background: rgba(255,255,255,.92);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--border); border-radius: 20px;
    display: flex; justify-content: space-around; align-items: center;
    box-shadow: 0 8px 24px rgba(0,0,0,.07); z-index: 700;
}
.bnav-item {
    flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px;
    color: var(--ink-3); text-decoration: none; cursor: pointer; transition: .15s;
}
.bnav-item i { font-size: 1.1rem; }
.bnav-item span { font-size: .56rem; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; }
.bnav-item.on { color: var(--blue); }
.bnav-fab {
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--ink); border: none;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 1rem; cursor: pointer;
    box-shadow: 0 4px 14px rgba(9,9,11,.2);
    transition: .2s;
}
.bnav-fab:hover { transform: scale(1.06) rotate(90deg); }
</style>
</head>
<body>
<div class="shell" id="pdf-root">

<!-- ══ TOPBAR ══ -->
<div class="topbar">
    <a href="/dashboard" class="topbar-brand">
        <div class="topbar-logo"><i class="fas fa-graduation-cap"></i></div>
        Prepium
    </a>
    <div class="topbar-right">
        <% if (hasProfile) { %>
        <button class="export-btn" id="pdfBtn"><i class="fas fa-file-pdf"></i> Export</button>
        <% } %>
        <a href="/dashboard" class="icon-btn" title="Dashboard"><i class="fas fa-house"></i></a>
    </div>
</div>

<!-- ══ FLASH ══ -->
<% if (flash) { %>
<div class="flash"><i class="fas fa-circle-check"></i><%= flash %></div>
<% } %>

<!-- ════════════════════════════════════════════
     SETUP WIZARD  (no profile yet)
════════════════════════════════════════════ -->
<% if (!hasProfile) { %>
<div class="wizard-wrap">
<div class="wizard-card">
<form action="/cgpa/setup" method="POST" id="wiz-form">
    <input type="hidden" name="start_type" id="stype" value="fresh">

    <div class="prog-bar"><div class="prog-fill" id="prog" style="width:33%"></div></div>

    <!-- STEP 1: Academic Profile -->
    <div class="wiz-step on" id="s1">
        <div class="wiz-eyebrow">Step 1 of 3</div>
        <div class="wiz-title">Your Academic Profile</div>
        <div class="wiz-sub">Enter your department and grading preferences to get started.</div>

        <div class="fg">
            <label>Department / Faculty</label>
            <input type="text" name="department" placeholder="e.g. Computer Science" required>
        </div>
        <div class="grid2">
            <div class="fg">
                <label>Current Level</label>
                <select name="current_level">
                    <option value="100">100 Level</option>
                    <option value="200">200 Level</option>
                    <option value="300" selected>300 Level</option>
                    <option value="400">400 Level</option>
                    <option value="500">500 Level</option>
                </select>
            </div>
            <div class="fg">
                <label>Grading Scale</label>
                <select name="grading_scale" id="scale-sel">
                    <option value="5" selected>5-Point</option>
                    <option value="4">4-Point</option>
                </select>
            </div>
        </div>
        <button type="button" class="btn btn-primary" onclick="goStep(2)">
            Continue <i class="fas fa-arrow-right"></i>
        </button>
    </div>

    <!-- STEP 2: Track type -->
    <div class="wiz-step" id="s2">
        <div class="wiz-eyebrow">Step 2 of 3</div>
        <div class="wiz-title">How do you want to track?</div>
        <div class="wiz-sub">Choose whether you're starting fresh or importing existing grades.</div>

        <button type="button" class="path-card" onclick="pickPath('fresh')">
            <div class="path-card-head">
                <div class="path-dot a"><i class="fas fa-star-of-life"></i></div>
                <strong>Start Fresh</strong>
            </div>
            <p>Log everything from scratch — semester by semester, clean slate.</p>
        </button>

        <button type="button" class="path-card" onclick="pickPath('balance')">
            <div class="path-card-head">
                <div class="path-dot b"><i class="fas fa-clock-rotate-left"></i></div>
                <strong>Import Previous CGPA</strong>
            </div>
            <p>Carry forward your existing CGPA and total unit load as a balance.</p>
        </button>

        <button type="button" class="btn btn-ghost" onclick="goStep(1)">
            <i class="fas fa-arrow-left"></i> Back
        </button>
    </div>

    <!-- STEP 3: Balance -->
    <div class="wiz-step" id="s3">
        <div class="wiz-eyebrow">Step 3 of 3</div>
        <div class="wiz-title">Import Your Balance</div>
        <div class="wiz-sub">We'll use these as a base. New courses build on top.</div>

        <div class="grid2">
            <div class="fg">
                <label>Previous CGPA</label>
                <input type="number" name="prev_cgpa" id="prev_cgpa" step="0.01" min="0" max="5" value="0.00" placeholder="e.g. 3.75">
            </div>
            <div class="fg">
                <label>Total Units Done</label>
                <input type="number" name="prev_units" min="0" value="0" placeholder="e.g. 60">
            </div>
        </div>

        <div class="balance-hint">
            <strong>How it works:</strong> Your CGPA × units = quality points. These are added to your running total each time we recalculate.<br><br>
            <strong>5-point scale:</strong> max CGPA 5.00 &nbsp;·&nbsp; <strong>4-point scale:</strong> max CGPA 4.00
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="fas fa-chart-line"></i> Build My Tracker
        </button>
        <button type="button" class="btn btn-ghost" onclick="goStep(2)">
            <i class="fas fa-arrow-left"></i> Back
        </button>
    </div>
</form>
</div>
</div>

<!-- ════════════════════════════════════════════
     DASHBOARD  (profile exists)
════════════════════════════════════════════ -->
<% } else { %>

<%
    const scale  = parseInt(profile.grading_scale) || 5;
    const gpMap5 = { A:5, B:4, C:3, D:2, E:1, F:0 };
    const gpMap4 = { A:4, B:3, C:2, D:1, E:0, F:0 };
    const gp     = scale === 5 ? gpMap5 : gpMap4;

    let totalUnits  = parseInt(profile.prev_units) || 0;
    let totalPoints = parseFloat(profile.prev_gp)  || 0;
    const gradeCounts = { A:0, B:0, C:0, D:0, E:0, F:0 };

    courses.forEach(c => {
        const g = (c.grade||'F').toUpperCase();
        if (gradeCounts.hasOwnProperty(g)) gradeCounts[g]++;
        if (!c.is_hidden) {
            const u = parseInt(c.credit_units)||0;
            totalUnits  += u;
            totalPoints += (gp[g]!==undefined?gp[g]:0)*u;
        }
    });

    const cgpa      = totalUnits > 0 ? (totalPoints/totalUnits).toFixed(2) : '0.00';
    const cgpaF     = parseFloat(cgpa);
    const arcPct    = Math.min(cgpaF/scale, 1);
    const arcOffset = (251.2*(1-arcPct)).toFixed(1);

    let cls='Fail', badge='fail';
    if (scale===5){
        if      (cgpaF>=4.50){cls='First Class Honours';   badge='first';}
        else if (cgpaF>=3.50){cls='Second Class (Upper)';  badge='upper';}
        else if (cgpaF>=2.40){cls='Second Class (Lower)';  badge='lower';}
        else if (cgpaF>=1.50){cls='Third Class';           badge='third';}
        else if (cgpaF>=1.00){cls='Pass';                  badge='none'; }
    } else {
        if      (cgpaF>=3.50){cls='First Class Honours';   badge='first';}
        else if (cgpaF>=3.00){cls='Second Class (Upper)';  badge='upper';}
        else if (cgpaF>=2.00){cls='Second Class (Lower)';  badge='lower';}
        else if (cgpaF>=1.50){cls='Third Class';           badge='third';}
        else if (cgpaF>=1.00){cls='Pass';                  badge='none'; }
    }
%>

<!-- Hero -->
<div class="hero">
    <svg width="0" height="0"><defs>
        <linearGradient id="rg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#60a5fa"/>
            <stop offset="100%" stop-color="#a78bfa"/>
        </linearGradient>
    </defs></svg>

    <div class="hero-grid">
        <div class="hero-left">
            <div class="hero-eyebrow">Cumulative GPA</div>
            <div class="hero-cgpa"><%= cgpa %></div>
            <div class="hero-scale">out of <%= scale %>.00</div>
        </div>
        <div class="ring-wrap">
            <svg width="88" height="88" viewBox="0 0 100 100">
                <circle class="ring-bg"   cx="50" cy="50" r="40"/>
                <circle class="ring-fill" cx="50" cy="50" r="40"
                    style="stroke-dashoffset:<%= arcOffset %>"/>
            </svg>
            <div class="ring-pct"><%= Math.round(arcPct*100) %>%</div>
        </div>
    </div>

    <div class="hero-bottom">
        <span class="div-badge <%= badge %>">
            <i class="fas fa-medal"></i> <%= cls %>
        </span>
        <div class="hero-meta"><%= profile.department %> · L<%= profile.current_level %></div>
    </div>
</div>

<!-- Tiles -->
<div class="tiles">
    <div class="tile t-blue">
        <div class="tile-icon"><i class="fas fa-layer-group"></i></div>
        <div class="tile-num"><%= totalUnits %></div>
        <div class="tile-label">Units</div>
    </div>
    <div class="tile t-teal">
        <div class="tile-icon"><i class="fas fa-star"></i></div>
        <div class="tile-num"><%= totalPoints.toFixed(1) %></div>
        <div class="tile-label">Quality Pts</div>
    </div>
    <div class="tile t-amber">
        <div class="tile-icon"><i class="fas fa-book-open"></i></div>
        <div class="tile-num"><%= courses.length %></div>
        <div class="tile-label">Courses</div>
    </div>
</div>

<!-- Analytics -->
<div class="analytics">
    <div class="section-head">
        <div class="section-label"><i class="fas fa-chart-bar"></i> Grade Breakdown</div>
    </div>
    <div class="chart-box">
        <canvas id="gChart"></canvas>
    </div>
    <div class="grade-chips">
        <% ['A','B','C','D','E','F'].forEach(l => { %>
        <div class="gchip">
            <div class="gchip-letter <%= l %>"><%= l %></div>
            <div class="gchip-count"><%= gradeCounts[l] %>×</div>
        </div>
        <% }) %>
    </div>
</div>

<!-- Filters -->
<div class="filters">
    <div class="pill-row" id="lvl-pills">
        <button class="pill on" onclick="fLvl('all',this)">All</button>
        <button class="pill"    onclick="fLvl('100',this)">100L</button>
        <button class="pill"    onclick="fLvl('200',this)">200L</button>
        <button class="pill"    onclick="fLvl('300',this)">300L</button>
        <button class="pill"    onclick="fLvl('400',this)">400L</button>
        <button class="pill"    onclick="fLvl('500',this)">500L</button>
    </div>
</div>
<div class="filter-row2">
    <div class="pill-row" id="sem-pills" style="padding:0;">
        <button class="pill on" onclick="fSem('all',this)">Both Sems</button>
        <button class="pill"    onclick="fSem('1',this)">1st Sem</button>
        <button class="pill"    onclick="fSem('2',this)">2nd Sem</button>
    </div>
    <div class="gpa-live" id="termGPA">GPA: <%= cgpa %></div>
</div>

<!-- Course list -->
<div class="course-card">
    <div class="course-card-head">
        <div class="course-card-title" id="matLabel">All Courses</div>
        <div class="course-card-meta"  id="matCount"><%= courses.length %> total</div>
    </div>

    <div id="matrix">
    <% if (!courses.length) { %>
        <div class="empty-state">
            <i class="fas fa-folder-open"></i>
            <p>No courses yet. Tap <strong>+</strong> to log your first course.</p>
        </div>
    <% } else { %>
        <% courses.forEach(c => { %>
        <div class="crow <%= c.is_hidden ? 'hidden-row' : '' %> data-row"
             data-id="<%= c.id %>"
             data-code="<%= c.code %>"
             data-title="<%= c.title || '' %>"
             data-units="<%= c.credit_units %>"
             data-grade="<%= c.grade %>"
             data-level="<%= c.level_scope %>"
             data-semester="<%= c.semester %>">
            <div class="crow-left">
                <div class="ccode">
                    <%= c.code %>
                    <% if (c.is_hidden) { %><span class="excl-tag">excluded</span><% } %>
                </div>
                <div class="cmeta">
                    <span><%= c.credit_units %> units</span>
                    <% if (c.title) { %><span>· <%= c.title %></span><% } %>
                    <span>· L<%= c.level_scope %> S<%= c.semester %></span>
                </div>
            </div>
            <div class="crow-right">
                <div class="grade-chip <%= c.grade %>"><%= c.grade %></div>
                <div class="act-row">
                    <button class="act" title="Edit" onclick="openEdit('<%= c.id %>')">
                        <i class="fas fa-pen"></i>
                    </button>
                    <form action="/cgpa/course/toggle-visible/<%= c.id %>" method="POST" style="display:contents">
                        <button type="submit" class="act <%= c.is_hidden ? 'eye-on' : '' %>" title="Toggle">
                            <i class="fas <%= c.is_hidden ? 'fa-eye-slash' : 'fa-eye' %>"></i>
                        </button>
                    </form>
                    <form action="/cgpa/course/delete/<%= c.id %>" method="POST" style="display:contents"
                          onsubmit="return confirm('Delete <%= c.code %>?')">
                        <button type="submit" class="act danger" title="Delete">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <% }) %>
    <% } %>
    </div>
</div>

<!-- Reset section -->
<div class="reset-section">
    <h4><i class="fas fa-triangle-exclamation"></i> Danger Zone</h4>
    <p>Reset your profile and all courses. This cannot be undone.</p>
    <form action="/cgpa/reset" method="POST" onsubmit="return confirm('Delete everything and start over?')">
        <button type="submit" class="btn btn-danger">
            <i class="fas fa-rotate-left"></i> Reset Tracker
        </button>
    </form>
</div>

<% } %> <!-- end hasProfile -->
</div><!-- /shell -->


