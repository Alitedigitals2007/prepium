        <button class="pill on btn-enhanced hover-lift" onclick="fLvl('all',this)">All</button>
<button class="pill" onclick="fLvl('100',this)" class="btn-enhanced hover-lift">100L</button>
<button class="pill" onclick="fLvl('200',this)" class="btn-enhanced hover-lift">200L</button>
<button class="pill" onclick="fLvl('300',this)" class="btn-enhanced hover-lift">300L</button>
<button class="pill" onclick="fLvl('400',this)" class="btn-enhanced hover-lift">400L</button>
<button class="pill" onclick="fLvl('500',this)" class="btn-enhanced hover-lift">500L</button>
    </div>
</div>
<div class="filter-row2">
    <div class="pill-row" id="sem-pills" style="padding:0;">
        <button class="pill on" onclick="fSem('all',this)" class="btn-enhanced hover-lift">Both Sems</button>
<button class="pill" onclick="fSem('1',this)" class="btn-enhanced hover-lift">1st Sem</button>
<button class="pill" onclick="fSem('2',this)" class="btn-enhanced hover-lift">2nd Sem</button>
    </div>
