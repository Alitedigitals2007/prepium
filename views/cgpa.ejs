        sem.courses.forEach(function(c) {
            var gp = gpMap[c.grade] || 0;
            var excl = c.excluded ? ' style="opacity:0.35;text-decoration:line-through"' : '';
            var status = c.excluded ? 'Excluded' : (c.grade === 'F' ? 'Fail' : 'Pass');
            html += '<tr' + excl + '><td style="font-weight:700">' + (c.code || '') + '</td>' +
                '<td>' + (c.title || '') + '</td>' +
                '<td style="text-align:center">' + c.units + '</td>' +
                '<td style="text-align:center;font-weight:700">' + c.grade + '</td>' +
                '<td style="text-align:center">' + gp.toFixed(1) + '</td>' +
                '<td style="text-align:center;font-size:6.5pt;font-weight:600;color:' + (status === 'Pass' ? '#16a34a' : (status === 'Fail' ? '#dc2626' : '#94a3b8')) + '">' + status + '</td></tr>';
