<% include('partials/head') %>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell" id="pdf-root">

<!-- Hero -->
<section class="hero hero-new reveal-scale hover-lift" role="region" aria-label="Cumulative GPA Summary">
  <div class="hero-grid hero-grid-new">
    <div class="hero-left-new">
      <h1 class="hero__title">Cumulative GPA</h1>
      <div class="hero-cgpa-new"><%= cgpa %></div>
      <div class="hero-scale-new">out of <%= scale %>.00</div>
    </div>
    <div class="ring-wrap-new">
      <svg width="88" height="88" viewBox="0 0 100 100">
        <circle class="ring-bg-new" cx="50" cy="50" r="40"/>
        <circle class="ring-fill-new" cx="50" cy="50" r="40"
            style="stroke-dashoffset:<%= arcOffset %>"/>
      </svg>
      <div class="ring-pct-new"><%= Math.round(arcPct*100) %>%</div>
    </div>
  </div>
  <div class="hero-bottom-new">
    <span class="div-badge-new <%= badge %>"><i class="fas fa-medal"></i> <%= cls %></span>
    <div class="hero-meta-new"><%= profile.department %> · L<%= profile.current_level %></div>
  </div>
</section>

<!-- Tiles -->
<div class="tiles reveal">
  <div class="tile t-blue hover-lift">
    <div class="tile-icon"><i class="fas fa-layer-group"></i></div>
    <div class="tile-num"><%= totalUnits %></div>
    <div class="tile-label">Units</div>
  </div>
  <div class="tile t-teal hover-lift">
    <div class="tile-icon"><i class="fas fa-star"></i></div>
    <div class="tile-num"><%= totalPoints.toFixed(1) %></div>
    <div class="tile-label">Quality Pts</div>
  </div>
  <div class="tile t-amber hover-lift">
    <div class="tile-icon"><i class="fas fa-book-open"></i></div>
    <div class="tile-num"><%= courses.length %></div>
    <div class="tile-label">Courses</div>
  </div>
</div>

<!-- Analytics -->
<div class="analytics reveal hover-lift">
  <div class="section-head">
    <div class="section-label"><i class="fas fa-chart-bar"></i> Grade Breakdown</div>
  </div>
  <div class="chart-box">
    <canvas id="gChart"></canvas>
  </div>
  <div class="grade-chips">
    <% ['A','B','C','D','E','F'].forEach(l => { %>
    <div class="gchip">
      <div class="gchip-letter <%= l %>"><%= l %></div>
      <div class="gchip-count"><%= gradeCounts[l] %>×</div>
    </div>
    <% }) %>
  </div>
</div>

<!-- Import from Study -->
<div class="analytics reveal" style="margin-top:10px;">
  <div class="section-head" style="cursor:pointer;" onclick="importFromStudy()" class="btn-enhanced hover-lift">
    <div class="section-label"><i class="fas fa-graduation-cap"></i> Import from Study Hub</div>
    <span style="font-size:0.7rem;color:var(--brand);font-weight:700;">Sync <i class="fas fa-arrow-right" style="font-size:0.6rem;"></i></span>
  </div>
  <p style="font-size:0.72rem;color:var(--text-sub);font-weight:500;line-height:1.5;">Auto-import courses from your Study Hub into CGPA tracker. Existing courses are skipped.</p>
</div>

<!-- AI Course Advisor -->
<div class="analytics reveal" style="margin-top:10px;">
  <div class="section-head" onclick="toggleAdvisor()" style="cursor:pointer;" class="btn-enhanced hover-lift">
    <div class="section-label"><i class="fas fa-robot"></i> AI Course Advisor</div>
    <span style="font-size:0.7rem;color:var(--brand);font-weight:700;" id="advisorToggle"><i class="fas fa-chevron-down"></i></span>
  </div>
  <div id="advisorBody" style="display:none;">
    <div style="display:flex;gap:6px;margin-bottom:12px;">
      <button type="button" onclick="aiPredictGpa()" style="flex:1;padding:11px;border:none;background:linear-gradient(135deg,#2563eb,#1d4ed8);color:white;border-radius:10px;font-weight:700;font-size:0.78rem;cursor:pointer" class="btn-enhanced btn-shine hover-lift"><i class="fas fa-magic"></i> Predict next semester</button>
      <button type="button" onclick="advisorWhatif()" style="flex:1;padding:11px;border:none;background:#0f172a;color:white;border-radius:10px;font-weight:700;font-size:0.78rem;cursor:pointer" class="btn-enhanced hover-lift"><i class="fas fa-calculator"></i> What-If Builder</button>
    </div>

    <div id="aiPredictResult" style="display:none;background:var(--surface);border-radius:10px;padding:12px;font-size:0.85rem;color:var(--text-primary);line-height:1.55;white-space:pre-wrap;margin-bottom:10px;"></div>

    <div id="whatifBuilder" style="display:none;">
      <div class="section-label" style="font-size:0.75rem;margin-bottom:8px;"><i class="fas fa-plus-circle"></i> Add courses to see CGPA impact</div>
      <div id="whatifCourseList" style="margin-bottom:8px;"></div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;">
        <input type="text" id="wiCourseName" placeholder="Course name" style="flex:2;min-width:100px;padding:9px 10px;border:1.5px solid var(--border);border-radius:8px;font-family:inherit;font-weight:600;font-size:0.75rem;">
        <select id="wiCourseUnits" style="flex:1;min-width:60px;padding:9px;border:1.5px solid var(--border);border-radius:8px;font-family:inherit;font-weight:600;font-size:0.75rem;background:var(--surface-solid);">
          <% for(var uu=1;uu<=8;uu++){ %><option value="<%= uu %>" <%= uu===3?'selected':'' %>><%= uu %>u</option><% } %>
        </select>
        <select id="wiCourseGrade" style="flex:1;min-width:50px;padding:9px;border:1.5px solid var(--border);border-radius:8px;font-family:inherit;font-weight:600;font-size:0.75rem;background:var(--surface-solid);">
          <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option><option value="E">E</option><option value="F">F</option>
        </select>
        <button onclick="addAdvisorCourse()" style="padding:9px 14px;border:none;background:var(--bg);border:1.5px solid var(--border);border-radius:8px;font-weight:700;font-size:0.7rem;cursor:pointer;color:var(--text-dark);" class="btn-enhanced hover-lift"><i class="fas fa-plus"></i> Add</button>
      </div>
      <div id="whatifImpact" style="margin-top:8px;"></div>
      <button id="calcImpactBtn" onclick="calcAdvisorImpact()" style="display:none;width:100%;margin-top:8px;padding:12px;border:none;background:var(--brand-gradient);color:white;border-radius:10px;font-weight:700;font-size:0.82rem;cursor:pointer;"><i class="fas fa-calculator"></i> Calculate Impact</button>
    </div>

    <div id="aiWhatifResult" style="display:none;background:var(--surface);border-radius:10px;padding:12px;font-size:0.85rem;color:var(--text-primary);line-height:1.55;margin-top:8px"></div>
  </div>
</div>

<!-- CGPA Trend Chart -->
<div class="analytics reveal hover-lift">
  <div class="section-head">
    <div class="section-label"><i class="fas fa-chart-line"></i> CGPA Trend</div>
  </div>
  <div class="chart-box" style="height:200px;">
    <canvas id="trendChart"></canvas>
  </div>
</div>

<!-- Transcript -->
<div class="analytics reveal hover-lift">
  <button onclick="downloadTranscript()" style="width:100%;background:none;border:none;cursor:pointer;padding:0;text-align:left;font-family:inherit;" class="btn-enhanced btn-shine hover-lift">
    <div class="section-head">
      <div class="section-label"><i class="fas fa-file-alt"></i> Transcript</div>
      <span style="font-size:0.7rem;color:var(--brand);font-weight:700;">View <i class="fas fa-arrow-right" style="font-size:0.6rem;"></i></span>
    </div>
    <p style="font-size:0.72rem;color:var(--text-sub);font-weight:500;line-height:1.5;padding:0 4px;">View your complete academic transcript organized by semester.</p>
  </button>
</div>

<!-- Filters -->
<div class="filters">
  <div class="pill-row" id="lvl-pills">
    <button class="pill on btn-enhanced hover-lift" onclick="fLvl('all',this)">All</button>
    <button class="pill" onclick="fLvl('100',this)" class="btn-enhanced hover-lift">100L</button>
    <button class="pill" onclick="fLvl('200',this)" class="btn-enhanced hover-lift">200L</button>
    <button class="pill" onclick="fLvl('300',this)" class="btn-enhanced hover-lift">300L</button>
    <button class="pill" onclick="fLvl('400',this)" class="btn-enhanced hover-lift">400L</button>
    <button class="pill" onclick="fLvl('500',this)" class="btn-enhanced hover-lift">500L</button>
  </div>
</div>
<div class="filter-row2">
  <div class="pill-row" id="sem-pills" style="padding:0;">
    <button class="pill on" onclick="fSem('all',this)" class="btn-enhanced hover-lift">Both Sems</button>
    <button class="pill" onclick="fSem('1',this)" class="btn-enhanced hover-lift">1st Sem</button>
    <button class="pill" onclick="fSem('2',this)" class="btn-enhanced hover-lift">2nd Sem</button>
  </div>
  <div class="gpa-live btn-enhanced hover-lift" id="termGPA">GPA: <%= cgpa %></div>
</div>

<!-- Course list -->
<div class="course-card reveal glass hover-lift">
  <div class="course-card-head">
    <div class="course-card-title" id="matLabel">All Courses</div>
    <div class="course-card-meta"  id="matCount"><%= courses.length %> total</div>
    <button class="act btn-enhanced btn-shine hover-lift" style="background:var(--brand-gradient);color:white;padding:6px 12px;border-radius:10px;width:auto;font-weight:700;font-size:0.74rem;display:inline-flex;align-items:center;gap:6px" onclick="openOv('ov-add')" title="Add a course"><i class="fas fa-plus"></i> Add Course</button>
  </div>

  <div id="matrix">
    <% if (!courses.length) { %>
      <div class="empty-state">
        <i class="fas fa-folder-open"></i>
        <p>No courses yet. Tap <strong>+</strong> to log your first course.</p>
      </div>
    <% } else { %>
      <div class="bulk-bar" id="bulkBar" style="display:none;">
        <span id="bulkCount">0 selected</span>
        <div class="bulk-actions">
          <button type="button" class="btn-bulk-act" onclick="bulkAction('hide')" title="Hide selected"><i class="fas fa-eye-slash"></i> Hide</button>
          <button type="button" class="btn-bulk-act danger" onclick="bulkAction('delete')" title="Delete selected"><i class="fas fa-trash"></i> Delete</button>
          <button type="button" class="btn-bulk-act" onclick="clearSelection()">Cancel</button>
        </div>
      </div>
      <% courses.forEach(c => { %>
        <div class="crow <%= c.is_hidden ? 'hidden-row' : '' %> data-row"
             data-id="<%= c.id %>"
             data-code="<%= c.code %>"
             data-title="<%= c.title || '' %>"
             data-units="<%= c.credit_units %>"
             data-grade="<%= c.grade %>"
             data-level="<%= c.level_scope %>"
             data-semester="<%= c.semester %>">
          <div class="crow-check">
            <input type="checkbox" class="row-check" value="<%= c.id %>" onchange="updateBulkBar()">
          </div>