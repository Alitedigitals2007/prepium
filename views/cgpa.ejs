<script>
var addCourseCodes = [];
<% if (typeof courses !== 'undefined' && courses && courses.length > 0) { %>
<% courses.forEach(function(c) { %>
addCourseCodes.push('<%= c.code ? c.code.toUpperCase().replace(/'/g, "\\'") : "" %>');
<% }); } %>

document.addEventListener('DOMContentLoaded', function() {
    var codeInput = document.getElementById('add-code');
    if (codeInput) {
        codeInput.addEventListener('input', function() {
            var val = this.value.trim().toUpperCase();
            var warn = document.getElementById('add-code-warn');
            if (addCourseCodes.indexOf(val) >= 0) {
                warn.style.display = 'block';
                warn.style.color = '#d97706';
                warn.innerHTML = '<i class="fas fa-exclamation-triangle"></i> This course already exists. It will be skipped.';
            } else {
                warn.style.display = 'none';
            }
        });
    }
});

function addCourseAjax(keepOpen) {
    var code = document.getElementById('add-code').value.trim().toUpperCase();
    var title = document.getElementById('add-title').value.trim() || code;
    var level = document.getElementById('add-level').value;
    var sem = document.getElementById('add-sem').value;
    var units = parseInt(document.getElementById('add-units').value) || 3;
    var grade = document.getElementById('add-grade').value;
    if (!code) { return showAddError('Enter a course code.'); }
    if (units < 1 || units > 8) { return showAddError('Units must be 1-8.'); }
    document.getElementById('add-loading').style.display = 'block';
    document.getElementById('add-error').style.display = 'none';
    document.getElementById('add-save-btn').disabled = true;
    document.getElementById('add-save-another').disabled = true;
    document.getElementById('add-code-warn').style.display = 'none';
    fetch('/api/cgpa/course/add-ajax', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: code, title: title, level_scope: level, semester: sem, credit_units: units, grade: grade })
    }).then(function(r){ return r.json(); }).then(function(d) {
        document.getElementById('add-loading').style.display = 'none';
        document.getElementById('add-save-btn').disabled = false;
        document.getElementById('add-save-another').disabled = false;
        if (d && d.success) {
            if (d.duplicate) {
                showAddError('Course already exists (skipped).');
            } else {
                if (keepOpen) {
                    document.getElementById('add-code').value = '';
                    document.getElementById('add-title').value = '';
                    document.getElementById('add-grade').selectedIndex = 0;
                    document.getElementById('add-code').focus();
                    showAddError('');
                    document.getElementById('add-error').style.display = 'none';
                    showAddSuccess('Course added! Add another.');
                } else {
                    closeOv('ov-add');
                    Swal.fire({ icon: 'success', title: 'Course Added', text: code + ' was added successfully.', timer: 1500, showConfirmButton: false });
                    setTimeout(function(){ location.reload(); }, 1500);
                }
            }
        } else {
            showAddError((d && d.error) ? d.error : 'Could not add course.');
        }
    }).catch(function(err) {
        document.getElementById('add-loading').style.display = 'none';
        document.getElementById('add-save-btn').disabled = false;
        document.getElementById('add-save-another').disabled = false;
        showAddError('Network error: ' + (err.message || ''));
    });
}

function showAddError(msg) {
    var box = document.getElementById('add-error');
    if (msg) { box.style.display = 'block'; box.innerHTML = '<i class="fas fa-times-circle"></i> ' + msg; }
    else box.style.display = 'none';
}

function showAddSuccess(msg) {
    var box = document.getElementById('add-error');
    box.style.display = 'block';
    box.style.color = '#16a34a';
    box.style.background = '#f0fdf4';
    box.innerHTML = '<i class="fas fa-check-circle"></i> ' + msg;
}
</script>

