            '<td style="text-align:center">' + sem.points.toFixed(1) + '</td>' +
            '<td style="text-align:center;font-size:6.5pt;color:#475569">' + sem.courses.filter(function(c){ return c.grade !== 'F' && !c.excluded; }).length + '/' + sem.courses.filter(function(c){ return !c.excluded; }).length + ' passed</td></tr>';
        html += '</tbody></table></div>';
    });

    html += '<div class="summary-box"><div class="row">' +
        '<div class="item"><div class="lbl">Cumulative GPA (CGPA)</div><div class="num">' + d.cgpa + '</div></div>' +
