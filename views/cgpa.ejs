        '<div class="item"><div class="lbl">Courses Passed</div><div class="num">' + totalPassed + '</div></div>' +
        '<div class="item"><div class="lbl">Degree Classification</div><div class="cls">' + (d.degreeClass || 'N/A') + '</div></div></div></div>' +

        '<div class="footer-note">' +
        '<strong>NOTICE:</strong> This transcript is generated from student-provided academic records. ' +
        'It serves as a personal academic summary and is not an official university-issued document. ' +
        '<br>Reference: ' + (d.refNumber || 'N/A') + ' &nbsp;|&nbsp; Generated: ' + dateStr + ' &nbsp;|&nbsp; Prepium CGPA Tracker' +
        '</div>' +
        '<script>window.addEventListener("load",function(){setTimeout(function(){window.print()},300)})<' + '/script>' +
        '</body></html>';

    return html;
}

