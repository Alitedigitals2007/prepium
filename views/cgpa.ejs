                <input type="text" id="wiCourseName" placeholder="Course name" style="flex:2;min-width:100px;padding:9px 10px;border:1.5px solid var(--border);border-radius:8px;font-family:inherit;font-weight:600;font-size:0.75rem;">
                <select id="wiCourseUnits" style="flex:1;min-width:60px;padding:9px;border:1.5px solid var(--border);border-radius:8px;font-family:inherit;font-weight:600;font-size:0.75rem;background:var(--surface-solid);">
