/* â”€â”€ AI Course Advisor Toggle â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
var advisorOpen = false;
function toggleAdvisor() {
    var body = document.getElementById('advisorBody');
    var tog = document.getElementById('advisorToggle');
    advisorOpen = !advisorOpen;
    body.style.display = advisorOpen ? 'block' : 'none';
    tog.innerHTML = advisorOpen ? '<i class="fas fa-chevron-up"></i>' : '<i class="fas fa-chevron-down"></i>';
