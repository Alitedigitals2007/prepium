<script>
/* ── Wizard ─────────────────────────────── */
const PROGS = { 1:'33%', 2:'66%', 3:'100%' };
function goStep(n) {
    document.querySelectorAll('.wiz-step').forEach(s => s.classList.remove('on'));
    document.getElementById('s'+n).classList.add('on');
    document.getElementById('prog').style.width = PROGS[n];
}
function pickPath(val) {
    document.getElementById('stype').value = val;
    if (val === 'balance') goStep(3);
    else document.getElementById('wiz-form').submit();
}
// sync max attr for CGPA input when scale changes
const scaleSel = document.getElementById('scale-sel');
const prevCGPA = document.getElementById('prev_cgpa');
if (scaleSel && prevCGPA) {
    scaleSel.addEventListener('change', () => {
        prevCGPA.max         = scaleSel.value;
        prevCGPA.placeholder = `e.g. ${scaleSel.value==='5'?'3.75':'3.00'}`;
    });
}

/* ── Overlays ────────────────────────────── */
function openOv(id)  { document.getElementById(id).classList.add('show'); document.body.style.overflow='hidden'; }
function closeOv(id) { document.getElementById(id).classList.remove('show'); document.body.style.overflow=''; }
document.querySelectorAll('.overlay').forEach(ov => {
    ov.addEventListener('click', e => { if (e.target===ov) closeOv(ov.id); });
});

/* ── Edit pre-fill ───────────────────────── */
function openEdit(id) {
    const r = document.querySelector(`.data-row[data-id="${id}"]`);
    if (!r) return;
    document.getElementById('e-id').value    = id;
    document.getElementById('e-code').value  = r.dataset.code;
    document.getElementById('e-title').value = r.dataset.title;
    document.getElementById('e-units').value = r.dataset.units;
    const sel = document.getElementById('e-grade');
    if (sel) sel.value = r.dataset.grade;
    openOv('ov-edit');
}

/* ── AI Advisor fallback (overridden by real fn if hasProfile) ── */
function openCGPAChat() {
    Swal.fire({
        icon: 'info',
        title: 'Setup Required',
        text: 'Set up your CGPA profile first to use the AI Advisor.',
        confirmButtonText: 'OK'
    });
}

<% if (hasProfile) { %>
/* ── Filter state ────────────────────────── */
const SCALE  = <%= parseInt(profile.grading_scale)||5 %>;
const GP_MAP = SCALE === 5
    ? { A:5, B:4, C:3, D:2, E:1, F:0 }
    : { A:4, B:3, C:2, D:1, E:0, F:0 };
const PREV_UNITS = <%= parseInt(profile.prev_units)||0 %>;
const PREV_GP    = <%= parseFloat(profile.prev_gp)||0 %>;
const GRADE_COUNTS = <%- JSON.stringify(gradeCounts) %>;

let curLvl = 'all', curSem = 'all';

function fLvl(v, btn) {
    curLvl = v;
    document.querySelectorAll('#lvl-pills .pill').forEach(p => p.classList.remove('on'));
    btn.classList.add('on');
    render();
}
function fSem(v, btn) {
    curSem = v;
    document.querySelectorAll('#sem-pills .pill').forEach(p => p.classList.remove('on'));
    btn.classList.add('on');
    render();
}

function render() {
    const rows = document.querySelectorAll('.data-row');
    let shown=0, u=0, pts=0;
    rows.forEach(r => {
        const lvl = r.dataset.level, sem = r.dataset.semester;
        const ok  = (curLvl==='all'||curLvl===lvl) && (curSem==='all'||curSem===sem);
        r.style.display = ok ? 'flex' : 'none';
        if (ok) {
            shown++;
            if (!r.classList.contains('hidden-row')) {
                const cu = parseInt(r.dataset.units)||0;
                const g  = (r.dataset.grade||'F').toUpperCase();
                u   += cu;
                pts += (GP_MAP[g]!==undefined?GP_MAP[g]:0)*cu;
            }
        }
    });
    // include prev balance in GPA only when showing all
    const tu = (curLvl==='all'&&curSem==='all') ? u+PREV_UNITS : u;
    const tp = (curLvl==='all'&&curSem==='all') ? pts+PREV_GP  : pts;
    const gpa = tu>0 ? (tp/tu).toFixed(2) : '—';
    document.getElementById('termGPA').textContent = `GPA: ${gpa}`;
    document.getElementById('matCount').textContent = `${shown} shown`;

    const ll = curLvl==='all'?'All Levels':`${curLvl}L`;
    const sl = curSem==='all'?'Both Sems':`Sem ${curSem}`;
    document.getElementById('matLabel').textContent = `${ll} · ${sl}`;
}

/* ── Chart.js ────────────────────────────── */
document.addEventListener('DOMContentLoaded', () => {
    render();
    const ctx = document.getElementById('gChart');
    if (!ctx) return;
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['A','B','C','D','E','F'],
            datasets: [{
                data: [GRADE_COUNTS.A, GRADE_COUNTS.B, GRADE_COUNTS.C, GRADE_COUNTS.D, GRADE_COUNTS.E, GRADE_COUNTS.F],
                backgroundColor: ['rgba(180,83,9,.1)','rgba(37,99,235,.1)','rgba(13,148,136,.1)','rgba(124,58,237,.1)','rgba(82,82,91,.1)','rgba(225,29,72,.1)'],
                borderColor:     ['#b45309','#2563eb','#0d9488','#7c3aed','#52525b','#e11d48'],
                borderWidth: 1.5, borderRadius: 7, borderSkipped: false
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend:{ display:false } },
            scales: {
                x: { grid:{ display:false }, ticks:{ font:{ family:'Plus Jakarta Sans',weight:'700' } } },
                y: { grid:{ color:'rgba(0,0,0,.04)' }, ticks:{ precision:0 } }
            }
        }
    });
});

/* ── Import from Study ───────────────────── */
function importFromStudy() {
    Swal.fire({ title: 'Importing from Study Hub...', html: 'Syncing courses', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
    fetch('/api/study/cgpa-sync', { method: 'POST' })
    .then(r => r.json()).then(d => {
        if (d.success) {
            Swal.fire({ icon: 'success', text: d.synced + ' courses imported!', timer: 1500, showConfirmButton: false });
            setTimeout(() => location.reload(), 1500);
        } else {
            Swal.fire({ icon: 'error', text: d.error || 'Sync failed' });
        }
    });
}

/* ── What-If Forecast ────────────────────── */
function toggleForecast() {
    const body = document.getElementById('forecastBody');
    const tog = document.getElementById('forecastToggle');
    if (body.style.display === 'none') {
        body.style.display = 'block';
        tog.innerHTML = '<i class="fas fa-chevron-up"></i>';
        loadForecast();
    } else {
        body.style.display = 'none';
        tog.innerHTML = '<i class="fas fa-chevron-down"></i>';
    }
}

function loadForecast() {
    document.getElementById('forecastLoading').style.display = 'block';
    document.getElementById('forecastContent').style.display = 'none';
    fetch('/api/cgpa/forecast', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) })
    .then(r => r.json()).then(d => {
        document.getElementById('forecastLoading').style.display = 'none';
        if (!d.success) { document.getElementById('forecastContent').innerHTML = '<p style="color:var(--text-muted);font-size:0.75rem;">' + (d.error || 'Could not load forecast') + '</p>'; document.getElementById('forecastContent').style.display = 'block'; return; }
        var html = '';
        html += '<div style="margin-bottom:12px;padding:12px;background:var(--bg);border-radius:var(--radius-sm);">';
        html += '<div style="font-size:0.65rem;font-weight:700;color:var(--text-sub);text-transform:uppercase;margin-bottom:4px;">Current CGPA</div>';
        html += '<div style="font-size:1.4rem;font-weight:800;color:var(--text-dark);">' + d.currentCGPA + '</div></div>';

        if (d.scenarios && d.scenarios.length > 0) {
            html += '<div style="font-size:0.7rem;font-weight:700;color:var(--text-sub);margin-bottom:6px;">Improve Weak Grades</div>';
            d.scenarios.forEach(function(s) {
                var change = parseFloat(s.change);
                var color = change >= 0 ? 'var(--success)' : 'var(--danger)';
                html += '<div style="display:flex;justify-content:space-between;padding:8px 10px;background:white;border:1px solid var(--border);border-radius:8px;margin-bottom:4px;font-size:0.78rem;font-weight:600;">';
                html += '<span>' + s.label + '</span>';
                html += '<span><strong>' + s.cgpa + '</strong> <span style="color:' + color + ';font-size:0.7rem;">(' + (change >= 0 ? '+' : '') + s.change + ')</span></span>';
                html += '</div>';
            });
        }

        if (d.addScenarios && d.addScenarios.length > 0) {
            html += '<div style="font-size:0.7rem;font-weight:700;color:var(--text-sub);margin:10px 0 6px;">Add New Courses (All A)</div>';
            d.addScenarios.forEach(function(s) {
                html += '<div style="display:flex;justify-content:space-between;padding:8px 10px;background:white;border:1px solid var(--border);border-radius:8px;margin-bottom:4px;font-size:0.78rem;font-weight:600;">';
                html += '<span>' + s.courses + ' courses (' + s.units + ' units)</span>';
                html += '<span><strong>' + s.cgpa + '</strong></span>';
                html += '</div>';
            });
        }

        html += '<div style="margin-top:12px;">';
        html += '<div style="font-size:0.7rem;font-weight:700;color:var(--text-sub);margin-bottom:6px;">Target CGPA Calculator</div>';
        html += '<div style="display:flex;gap:6px;">';
        html += '<input type="number" id="targetInput" step="0.01" min="0" max="5" placeholder="Target CGPA" style="flex:1;padding:10px;border:1.5px solid var(--border);border-radius:8px;font-family:inherit;font-weight:600;font-size:0.8rem;">';
        html += '<button onclick="calcTarget()" style="padding:10px 16px;border-radius:8px;border:none;background:var(--brand-gradient);color:white;font-weight:700;cursor:pointer;font-size:0.75rem;">Calculate</button>';
        html += '</div>';
        html += '<div id="targetResult" style="margin-top:6px;"></div>';
        html += '</div>';

        document.getElementById('forecastContent').innerHTML = html;
        document.getElementById('forecastContent').style.display = 'block';
    });
}

function calcTarget() {
    var val = document.getElementById('targetInput').value;
    if (!val) return;
    fetch('/api/cgpa/forecast', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ targetCGPA: val }) })
    .then(r => r.json()).then(d => {
        var el = document.getElementById('targetResult');
        if (d.targetData) {
            el.innerHTML = '<div style="padding:10px;background:#d1fae5;border-radius:8px;font-size:0.78rem;font-weight:600;color:#065f46;">To achieve <strong>' + d.targetData.target + '</strong>, you need ' + d.targetData.unitsNeededA + ' more units of A\'s (~' + d.targetData.coursesNeededA + ' courses).</div>';
        } else {
            el.innerHTML = '<div style="padding:10px;background:#fef3c7;border-radius:8px;font-size:0.78rem;font-weight:600;color:#92400e;">' + (d.error || 'Target must be higher than current CGPA (' + d.currentCGPA + ')') + '</div>';
        }
    });
}

/* ── Transcript Print/View ───────────────── */
function openTranscript() {
    Swal.fire({ title: 'Generating Transcript...', html: 'Preparing your document', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); } });
    fetch('/api/cgpa/transcript')
    .then(function(r) { return r.json(); })
    .then(function(d) {
        Swal.close();
        if (d.error) { Swal.fire({ icon: 'error', text: d.error }); return; }
        if (!d.semesters || d.semesters.length === 0) { Swal.fire({ icon: 'info', text: 'No courses logged yet.' }); return; }
        var html = buildTranscriptHtml(d);
        var w = window.open('about:blank', '_blank', 'width=794,height=600,scrollbars=yes');
        if (!w) { Swal.fire({ icon: 'error', text: 'Pop-up blocked. Allow pop-ups and try again.' }); return; }
        w.document.write(html);
        w.document.close();
        w.focus();
    })
    .catch(function(err) { Swal.close(); Swal.fire({ icon: 'error', text: 'Failed: ' + (err.message || 'network error') }); });
}

function buildTranscriptHtml(d) {
    var today = new Date();
    var dateStr = today.toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' });
    var timeStr = today.toLocaleTimeString('en-GB', { hour:'2-digit', minute:'2-digit' });
    var gpMap = (d.gradingScale === '5') ? {A:5,B:4,C:3,D:2,E:1,F:0} : {A:4,B:3,C:2,D:1,F:0};
    var totalPassed = 0;
    d.semesters.forEach(function(s) { s.courses.forEach(function(c) { if (c.grade !== 'F' && !c.excluded) totalPassed++; }); });

    var html = '<!DOCTYPE html><html><head><meta charset="utf-8"><title>Official Transcript - ' + (d.student.name || 'Student') + '</title>' +
        '<style>' +
        '@page { margin: 20mm 16mm 16mm; }' +
        'body { font-family: "Segoe UI", Arial, sans-serif; color: #0f172a; font-size: 9.5pt; line-height: 1.45; margin: 0; padding: 0; }' +
        '.header { text-align: center; padding-bottom: 16px; border-bottom: 3px double #0f172a; margin-bottom: 20px; }' +
        '.header .inst { font-size: 18pt; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; margin: 0; }' +
        '.header .title { font-size: 11pt; font-weight: 700; margin: 4px 0 6px; letter-spacing: 2px; text-transform: uppercase; color: #1e293b; }' +
        '.header .divider { width: 80px; height: 1.5px; background: #0f172a; margin: 6px auto; }' +
        '.header .sub { font-size: 7.5pt; color: #475569; font-weight: 600; }' +
        '.header .ref { font-size: 7pt; color: #94a3b8; font-weight: 600; margin-top: 4px; }' +
        '.info-table { width: 100%; border-collapse: collapse; margin-bottom: 18px; font-size: 9pt; }' +
        '.info-table td { padding: 3px 6px; vertical-align: top; }' +
        '.info-table .lbl { font-weight: 700; color: #475569; width: 130px; font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.3px; }' +
        '.info-table .sep { width: 12px; text-align: center; color: #cbd5e1; font-weight: 600; }' +
        '.info-table .val { font-weight: 700; color: #0f172a; }' +
        '.sem-block { margin-bottom: 16px; }' +
        '.sem-header { font-size: 8.5pt; font-weight: 800; color: #1e293b; text-transform: uppercase; letter-spacing: 0.8px; padding: 6px 8px; background: #f1f5f9; border-bottom: 1.5px solid #cbd5e1; margin-bottom: 4px; }' +
        'table.grades { width: 100%; border-collapse: collapse; font-size: 8pt; }' +
        'table.grades th { background: #f8fafc; padding: 5px 6px; text-align: left; font-weight: 700; font-size: 6.5pt; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #e2e8f0; }' +
        'table.grades td { padding: 4px 6px; border-bottom: 1px solid #f1f5f9; }' +
        'table.grades tr:last-child td { border-bottom: none; }' +
        '.sem-gpa td { background: #f8fafc; font-weight: 700; border-top: 1.5px solid #cbd5e1; border-bottom: none !important; font-size: 7.5pt; }' +
        '.summary-box { margin-top: 18px; padding: 14px 16px; background: #0f172a; color: white; border-radius: 4px; }' +
        '.summary-box .row { display: flex; justify-content: space-between; align-items: center; }' +
        '.summary-box .item { text-align: center; flex: 1; }' +
        '.summary-box .item .lbl { font-size: 6pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; opacity: 0.5; }' +
        '.summary-box .item .num { font-size: 14pt; font-weight: 800; margin-top: 2px; }' +
        '.summary-box .item .cls { font-size: 8pt; font-weight: 700; margin-top: 2px; }' +
        '.footer-note { text-align: center; font-size: 6.5pt; color: #94a3b8; margin-top: 16px; padding-top: 10px; border-top: 1px solid #e2e8f0; line-height: 1.6; }' +
        '.footer-note strong { color: #64748b; }' +
        '.watermark { position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%) rotate(-30deg); font-size: 72pt; font-weight: 800; color: rgba(0,0,0,0.025); pointer-events: none; z-index: -1; letter-spacing: 8px; white-space: nowrap; }' +
        '@media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }' +
        '</style></head><body>' +
        '<div class="watermark">PREPIUM</div>' +
        '<div class="header">' +
        '<div class="inst">Prepium</div>' +
        '<div class="divider"></div>' +
        '<div class="title">Official Transcript of Academic Record</div>' +
        '<div class="sub">Student-Owned Academic Record &mdash; For Verification Purposes</div>' +
        '<div class="ref">Reference: ' + (d.refNumber || 'N/A') + ' &nbsp;|&nbsp; Issued: ' + dateStr + ' at ' + timeStr + '</div></div>' +
        '<table class="info-table"><tr>' +
        '<td class="lbl">Student Name</td><td class="sep">:</td><td class="val">' + (d.student.name || 'N/A') + '</td>' +
        '<td class="lbl" style="width:100px">Department</td><td class="sep">:</td><td class="val">' + (d.department || 'N/A') + '</td></tr>' +
        '<tr><td class="lbl">Current Level</td><td class="sep">:</td><td class="val">' + (d.currentLevel || 'N/A') + ' Level</td>' +
