<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Prepium | CGPA Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<style>

/* ══════════════════════════════════════════════════
   DESIGN TOKENS
══════════════════════════════════════════════════ */
:root {
  --bg:        #f8fafc;
  --bg-2:      #ffffff;
  --bg-3:      #f1f5f9;
  --surface:   #ffffff;
  --surface-2: #f8fafc;
  --border:    rgba(15,23,42,0.08);
  --border-2:  rgba(15,23,42,0.15);
  --ink:       #0f172a;
  --ink-2:     #475569;
  --ink-3:     #94a3b8;
  --blue:      #2563eb;
  --blue-dk:   #1d4ed8;
  --blue-lt:   rgba(37,99,235,0.08);
  --violet:    #7c3aed;
  --violet-lt: rgba(124,58,237,0.08);
  --green:     #16a34a;
  --green-lt:  rgba(22,163,74,0.08);
  --red:       #dc2626;
  --red-lt:    rgba(220,38,38,0.08);
  --amber:     #d97706;
  --amber-lt:  rgba(217,119,6,0.08);
  --r-xs: 8px; --r-sm: 12px; --r: 16px; --r-lg: 22px; --r-xl: 28px;
  --sh:   0 1px 3px rgba(15,23,42,0.06), 0 4px 12px rgba(15,23,42,0.04);
  --sh-2: 0 4px 16px rgba(15,23,42,0.08), 0 1px 4px rgba(15,23,42,0.06);
}

*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; -webkit-tap-highlight-color:transparent; }
html { scroll-behavior:smooth; }

body {
  font-family:'Plus Jakarta Sans',sans-serif;
  background:var(--bg);
  color:var(--ink);
  min-height:100dvh;
  display:flex;
  justify-content:center;
  overflow-x:hidden;
  background-image:
    radial-gradient(ellipse 70% 40% at 15% 0%, rgba(37,99,235,0.03) 0%, transparent 55%),
    radial-gradient(ellipse 50% 30% at 85% 100%, rgba(124,58,237,0.03) 0%, transparent 55%);
}

.shell {
  width:100%; max-width:430px; min-height:100dvh;
  background:#ffffff; position:relative; padding-bottom:100px;
  box-shadow:0 0 60px rgba(0,0,0,0.04);
  animation:shellIn 0.35s cubic-bezier(0.16,1,0.3,1);
}
@keyframes shellIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }

/* ══════════════ TOP BAR ══════════════ */
.top-bar {
  position:sticky; top:0; z-index:900;
  padding:12px 16px;
  display:flex; justify-content:space-between; align-items:center;
  background:rgba(255,255,255,0.9);
  backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border);
}
.brand { display:flex; align-items:center; gap:10px; }
.brand-logo {
  width:32px; height:32px;
  background:linear-gradient(135deg,var(--blue),var(--violet));
  border-radius:var(--r-sm);
  display:flex; align-items:center; justify-content:center;
  font-size:0.75rem; color:#fff;
  box-shadow:0 4px 12px rgba(37,99,235,0.2);
}
.brand-name {
  font-family:'Clash Display',sans-serif; font-size:1.05rem; font-weight:700;
  background:linear-gradient(135deg,var(--ink),var(--ink-2));
  -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
}
.top-actions { display:flex; gap:8px; align-items:center; }
.pdf-btn {
  display:inline-flex; align-items:center; gap:6px;
  font-family:'Clash Display',sans-serif; font-size:0.72rem; font-weight:600;
  color:#fff; background:var(--blue); border:none;
  padding:8px 13px; border-radius:var(--r-sm); cursor:pointer;
  transition:all 0.2s;
}
.pdf-btn:hover { background:var(--blue-dk); transform:translateY(-1px); }

/* ══════════════ SETUP WIZARD ══════════════ */
.setup-wrap { padding:20px 14px 0; }
.wizard-card {
  background:var(--surface); border:1px solid var(--border);
  border-radius:var(--r-xl); padding:24px 20px;
  box-shadow:var(--sh-2);
  animation:shellIn 0.3s ease;
}
.step-dots { display:flex; gap:6px; margin-bottom:18px; }
.step-dot { width:8px; height:8px; border-radius:50%; background:var(--bg-3); transition:all 0.25s; }
.step-dot.active { background:var(--blue); width:22px; border-radius:4px; }
.step-dot.done   { background:var(--green); }
.wizard-title { font-family:'Clash Display',sans-serif; font-size:1.4rem; font-weight:700; margin-bottom:4px; }
.wizard-sub   { font-size:0.78rem; color:var(--ink-2); line-height:1.5; margin-bottom:20px; }
.setup-step { display:none; }
.setup-step.active { display:block; animation:fadeUp 0.22s ease; }
@keyframes fadeUp { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }

.path-card {
  display:block; width:100%; text-align:left;
  background:var(--bg-3); border:1px solid var(--border);
  border-radius:var(--r-lg); padding:16px; cursor:pointer; margin-bottom:10px;
  transition:all 0.18s;
}
.path-card:hover { border-color:var(--blue); background:rgba(37,99,235,0.03); }
.path-card-top { display:flex; align-items:center; gap:10px; margin-bottom:5px; }
.path-icon { width:30px; height:30px; border-radius:var(--r-xs); display:flex; align-items:center; justify-content:center; font-size:0.8rem; }
.path-icon.blue   { background:var(--blue-lt); color:var(--blue); }
.path-icon.violet { background:var(--violet-lt); color:var(--violet); }
.path-card b { font-family:'Clash Display',sans-serif; font-size:0.88rem; font-weight:700; }
.path-card small { font-size:0.72rem; color:var(--ink-2); padding-left:40px; display:block; line-height:1.4; }

.balance-box {
  background:var(--violet-lt); border:1px dashed rgba(124,58,237,0.2);
  border-radius:var(--r-lg); padding:14px; margin-bottom:12px;
}
.balance-box-label {
  font-size:0.62rem; font-weight:700; text-transform:uppercase; letter-spacing:0.5px;
  color:var(--violet); margin-bottom:10px; display:flex; align-items:center; gap:5px;
}
.balance-box small { font-size:0.68rem; color:rgba(124,58,237,0.6); display:block; margin-top:5px; }

/* ══════════════ HERO ══════════════ */
.hero {
  margin:14px 14px 0; border-radius:var(--r-xl); overflow:hidden;
  position:relative; padding:28px 22px 24px;
  background:linear-gradient(140deg,#f1f5f9 0%,#e8edf5 100%);
  border:1px solid var(--border); box-shadow:var(--sh);
}
.hero::before {
  content:''; position:absolute; inset:0;
  background:
    radial-gradient(ellipse 80% 60% at 100% 0%, rgba(37,99,235,0.06) 0%, transparent 55%),
    radial-gradient(ellipse 40% 40% at 0% 100%, rgba(124,58,237,0.04) 0%, transparent 55%);
  pointer-events:none;
}
.hero-content { position:relative; z-index:1; }
.hero-eyebrow {
  font-family:'Clash Display',sans-serif; font-size:0.6rem; font-weight:600;
  letter-spacing:2px; text-transform:uppercase; color:var(--blue); margin-bottom:8px;
}
.hero-main { display:flex; align-items:flex-end; justify-content:space-between; }
.hero-cgpa {
  font-family:'Clash Display',sans-serif; font-size:4.8rem; font-weight:700;
  color:var(--ink); line-height:1; letter-spacing:-3px;
  animation:counterIn 0.45s cubic-bezier(0.34,1.56,0.64,1);
}
@keyframes counterIn { from{transform:scale(0.85);opacity:0} to{transform:scale(1);opacity:1} }

/* Radial arc */
.arc-wrap { position:relative; width:90px; height:90px; flex-shrink:0; }
.arc-wrap svg { display:block; transform:rotate(-90deg); }
.arc-bg   { fill:none; stroke:rgba(15,23,42,0.07); stroke-width:8; }
.arc-fill {
  fill:none; stroke:url(#heroGrad); stroke-width:8;
  stroke-linecap:round; stroke-dasharray:251.2; stroke-dashoffset:251.2;
  transition:stroke-dashoffset 1s cubic-bezier(0.4,0,0.2,1);
}
.arc-pct {
  position:absolute; inset:0;
  display:flex; align-items:center; justify-content:center;
  font-family:'Clash Display',sans-serif; font-size:0.72rem; font-weight:700;
  color:var(--ink-2);
}

.division-badge {
  display:inline-block; padding:3px 11px; border-radius:50px;
  font-size:0.68rem; font-weight:700; margin-top:10px;
}
.division-badge.first { background:var(--amber-lt); color:var(--amber); border:1px solid rgba(217,119,6,0.2); }
.division-badge.upper { background:var(--blue-lt);  color:var(--blue);  border:1px solid rgba(37,99,235,0.2); }
.division-badge.lower { background:var(--green-lt); color:var(--green); border:1px solid rgba(22,163,74,0.2); }
.division-badge.third { background:var(--violet-lt);color:var(--violet);border:1px solid rgba(124,58,237,0.2); }
.division-badge.fail  { background:var(--red-lt);   color:var(--red);   border:1px solid rgba(220,38,38,0.2); }
.division-badge.none  { background:var(--bg-3); color:var(--ink-3); border:1px solid var(--border); }

.hero-meta {
  margin-top:14px; display:flex; align-items:center; gap:6px;
  font-size:0.72rem; color:var(--ink-2);
}
.hero-meta strong { color:var(--ink); font-weight:600; }
.hero-dot { width:3px; height:3px; border-radius:50%; background:var(--ink-3); }

/* ══════════════ STATS ROW ══════════════ */
.stats-row { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin:10px 14px 0; }
.stat-tile {
  background:var(--surface); border:1px solid var(--border);
  border-radius:var(--r-lg); padding:14px 10px 12px; text-align:center;
  position:relative; overflow:hidden; box-shadow:var(--sh);
}
.stat-tile::before { content:''; position:absolute; top:0; left:0; right:0; height:2px; }
.stat-tile.blue::before  { background:linear-gradient(90deg,var(--blue),#60a5fa); }
.stat-tile.green::before { background:linear-gradient(90deg,var(--green),#4ade80); }
.stat-tile.red::before   { background:linear-gradient(90deg,var(--red),#f87171); }
.stat-icon { font-size:0.7rem; margin-bottom:6px; opacity:0.6; }
.stat-tile.blue .stat-icon  { color:var(--blue); }
.stat-tile.green .stat-icon { color:var(--green); }
.stat-tile.red .stat-icon   { color:var(--red); }
.stat-num { font-family:'Clash Display',sans-serif; font-size:1.5rem; font-weight:700; line-height:1; margin-bottom:4px; }
.stat-tile.blue .stat-num  { color:var(--blue); }
.stat-tile.green .stat-num { color:var(--green); }
.stat-tile.red .stat-num   { color:var(--red); }
.stat-label { font-size:0.58rem; font-weight:700; text-transform:uppercase; letter-spacing:0.6px; color:var(--ink-2); }

/* ══════════════ ANALYTICS CARD ══════════════ */
.analytics-card {
  background:var(--surface); border:1px solid var(--border);
  border-radius:var(--r-xl); padding:18px; margin:12px 14px 0;
  box-shadow:var(--sh);
}
.chart-container { position:relative; width:100%; height:160px; margin:12px 0 14px; }
.grade-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:6px; margin-top:10px; }
.grade-pill {
  background:var(--bg-3); border:1px solid var(--border);
  border-radius:var(--r-sm); padding:8px 4px; text-align:center;
  transition:transform 0.18s;
}
.grade-pill:hover { transform:translateY(-1px); }
.grade-letter { font-family:'Clash Display',sans-serif; font-size:0.95rem; font-weight:700; }
.grade-letter.A { color:var(--amber); }
.grade-letter.B { color:var(--blue); }
.grade-letter.C { color:var(--green); }
.grade-letter.D { color:var(--violet); }
.grade-letter.E { color:var(--ink-2); }
.grade-letter.F { color:var(--red); }
.grade-count { font-size:0.62rem; font-weight:700; color:var(--ink-2); text-transform:uppercase; margin-top:2px; }

/* ══════════════ FILTER PILLS ══════════════ */
.section-header { display:flex; align-items:center; justify-content:space-between; padding:18px 16px 10px; }
.section-label { font-family:'Clash Display',sans-serif; font-size:0.8rem; font-weight:600; letter-spacing:1px; text-transform:uppercase; color:var(--ink-2); }
.scroll-row { display:flex; gap:7px; padding:0 14px; overflow-x:auto; scrollbar-width:none; }
.scroll-row::-webkit-scrollbar { display:none; }
.pill {
  display:inline-flex; align-items:center; gap:5px; white-space:nowrap;
  font-family:'Clash Display',sans-serif; font-size:0.75rem; font-weight:600;
  padding:8px 15px; border-radius:50px; background:var(--surface-2);
  border:1px solid var(--border); color:var(--ink-2); cursor:pointer;
  transition:all 0.18s; box-shadow:var(--sh);
}
.pill:hover { border-color:var(--border-2); }
.pill.active { background:var(--blue); border-color:var(--blue); color:#fff; box-shadow:0 4px 14px rgba(37,99,235,0.25); }

.sem-row { display:flex; align-items:center; justify-content:space-between; padding:10px 14px; }
.sem-pills { display:flex; gap:7px; }
.gpa-badge {
  font-family:'Clash Display',sans-serif; font-size:0.8rem; font-weight:700;
  color:var(--blue); background:var(--blue-lt);
  border:1px solid rgba(37,99,235,0.12); padding:6px 13px; border-radius:50px;
}

/* ══════════════ COURSE MATRIX ══════════════ */
.card { background:var(--surface); border:1px solid var(--border); border-radius:var(--r-xl); padding:18px; margin:0 14px 10px; box-shadow:var(--sh); }
.card-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
.card-title { font-family:'Clash Display',sans-serif; font-size:0.9rem; font-weight:700; }
.card-meta  { font-size:0.7rem; color:var(--ink-2); font-weight:500; }

.course-row {
  display:flex; align-items:center; justify-content:space-between;
  padding:12px 0; border-bottom:1px solid var(--border);
  animation:rowIn 0.25s ease both;
}
.course-row:last-child { border-bottom:none; padding-bottom:0; }
.course-row:first-child { padding-top:0; }
@keyframes rowIn { from{opacity:0;transform:translateX(-4px)} to{opacity:1;transform:translateX(0)} }
.course-row.is-hidden { opacity:0.35; }
.course-row.is-hidden .cname { text-decoration:line-through; }

.course-left { flex:1; min-width:0; }
.cname { font-family:'Clash Display',sans-serif; font-size:0.9rem; font-weight:700; display:flex; align-items:center; gap:6px; margin-bottom:3px; }
.tag-hidden { font-size:0.55rem; font-weight:700; text-transform:uppercase; letter-spacing:0.3px; background:var(--bg-3); color:var(--ink-3); padding:2px 6px; border-radius:4px; }
.cmeta { font-size:0.68rem; color:var(--ink-2); display:flex; gap:8px; }
.cmeta span { display:inline-flex; align-items:center; gap:3px; }

.course-right { display:flex; align-items:center; gap:8px; flex-shrink:0; }
.grade-chip { width:36px; height:36px; border-radius:var(--r-sm); display:flex; align-items:center; justify-content:center; font-family:'Clash Display',sans-serif; font-weight:700; font-size:0.88rem; border:1px solid var(--border); }
.grade-chip.A { background:var(--amber-lt); color:var(--amber); border-color:rgba(217,119,6,0.15); }
.grade-chip.B { background:var(--blue-lt);  color:var(--blue);  border-color:rgba(37,99,235,0.15); }
.grade-chip.C { background:var(--green-lt); color:var(--green); border-color:rgba(22,163,74,0.15); }
.grade-chip.D { background:var(--violet-lt);color:var(--violet);border-color:rgba(124,58,237,0.15); }
.grade-chip.E { background:var(--bg-3); color:var(--ink-2); }
.grade-chip.F { background:var(--red-lt); color:var(--red); border-color:rgba(220,38,38,0.15); }

.action-btns { display:flex; gap:4px; }
.act-btn { width:30px; height:30px; background:var(--surface-2); border:1px solid var(--border); border-radius:var(--r-xs); color:var(--ink-2); font-size:0.7rem; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.15s; }
.act-btn:hover { border-color:var(--border-2); color:var(--ink); background:var(--bg-3); }
.act-btn.danger:hover { color:var(--red); border-color:rgba(220,38,38,0.2); background:var(--red-lt); }
.act-btn.eye-active { color:var(--amber); border-color:rgba(217,119,6,0.2); background:var(--amber-lt); }

.empty-state { text-align:center; padding:32px 0 16px; color:var(--ink-2); }
.empty-state i { font-size:2.2rem; opacity:0.35; display:block; margin-bottom:10px; }
.empty-state p { font-size:0.8rem; }

/* ══════════════ FORM ELEMENTS ══════════════ */
.form-title { font-family:'Clash Display',sans-serif; font-size:0.9rem; font-weight:700; margin-bottom:15px; display:flex; align-items:center; gap:8px; }
.form-title i { color:var(--blue); }
.form-group { margin-bottom:12px; }
.form-group label { display:block; font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:var(--ink-2); margin-bottom:6px; }
.form-group input,
.form-group select { width:100%; padding:12px 14px; background:var(--surface-2); border:1px solid var(--border); border-radius:var(--r-sm); font-family:'Plus Jakarta Sans',sans-serif; font-size:0.88rem; font-weight:500; color:var(--ink); outline:none; transition:all 0.15s; appearance:none; -webkit-appearance:none; }
.form-group input:focus,
.form-group select:focus { border-color:var(--blue); background:#fff; }
.form-group select option { background:#fff; }
.form-grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }

.btn { width:100%; padding:14px; border:none; border-radius:var(--r-lg); font-family:'Clash Display',sans-serif; font-size:0.85rem; font-weight:700; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:7px; transition:all 0.2s; }
.btn:active { transform:scale(0.98); }
.btn-primary { background:var(--blue); color:#fff; box-shadow:0 4px 14px rgba(37,99,235,0.2); }
.btn-primary:hover { background:var(--blue-dk); }
.btn-outline  { background:#fff; color:var(--ink-2); border:1px solid var(--border); margin-top:8px; }
.btn-outline:hover { background:var(--bg-3); }

/* ══════════════ OVERLAYS ══════════════ */
.overlay { display:none; position:fixed; inset:0; z-index:2000; background:#ffffff; overflow-y:auto; padding-bottom:48px; }
.overlay.show { display:block; animation:fadeUp 0.2s ease; }
@keyframes fadeUp { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }
.overlay-inner { max-width:430px; margin:0 auto; padding:14px; }
.overlay-header { display:flex; align-items:center; justify-content:space-between; padding:8px 0 16px; border-bottom:1px solid var(--border); margin-bottom:16px; }
.overlay-title  { font-family:'Clash Display',sans-serif; font-size:1rem; font-weight:700; }
.overlay-close  { background:var(--bg-3); border:none; width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:var(--ink-2); cursor:pointer; font-size:0.85rem; }

/* ══════════════ BOTTOM NAV ══════════════ */
.bottom-nav {
  position:fixed; bottom:14px; left:50%; transform:translateX(-50%);
  width:calc(100% - 28px); max-width:402px; height:64px;
  background:rgba(255,255,255,0.92); backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px);
  border:1px solid var(--border); border-radius:20px;
  display:flex; justify-content:space-around; align-items:center;
  box-shadow:0 8px 24px rgba(0,0,0,0.06); z-index:1000;
}
.nav-item { flex:1; text-decoration:none; display:flex; flex-direction:column; align-items:center; gap:4px; color:var(--ink-3); cursor:pointer; transition:color 0.2s; }
.nav-item.active { color:var(--blue); }
.nav-item i { font-size:1.1rem; }
.nav-item span { font-size:0.58rem; font-weight:700; text-transform:uppercase; letter-spacing:0.4px; }
.fab { width:44px; height:44px; background:var(--blue); border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:1rem; box-shadow:0 4px 12px rgba(37,99,235,0.3); border:none; cursor:pointer; transition:transform 0.2s; }
.fab:hover { transform:scale(1.08) rotate(90deg); }

@media print {
  body { background:#fff; }
  .shell { max-width:100% !important; box-shadow:none !important; }
  .bottom-nav, .top-actions { display:none !important; }
}
</style>
</head>
<body>

<div class="shell" id="pdf-target">

  <!-- TOP BAR -->
  <div class="top-bar">
    <div class="brand">
      <div class="brand-logo"><i class="fas fa-graduation-cap"></i></div>
      <div class="brand-name">Prepium</div>
    </div>
    <div class="top-actions">
      <% if (hasProfile) { %>
        <button class="pdf-btn" id="pdf-btn">
          <i class="fas fa-file-pdf"></i> Export PDF
        </button>
      <% } %>
    </div>
  </div>


  <!-- ════════════ SETUP WIZARD (no profile) ════════════ -->
  <% if (!hasProfile) { %>
  <div class="setup-wrap">
    <div class="wizard-card">
      <form action="/cgpa/setup" method="POST" id="wizardForm">
        <input type="hidden" name="start_type" id="start_type_val" value="fresh">

        <div class="step-dots">
          <div class="step-dot active" id="dot-1"></div>
          <div class="step-dot" id="dot-2"></div>
          <div class="step-dot" id="dot-3"></div>
        </div>

        <!-- Step 1: Academic Profile -->
        <div class="setup-step active" id="step-1">
          <div class="wizard-title">Setup Profile</div>
          <div class="wizard-sub">Enter your academic details to begin tracking your CGPA.</div>

          <div class="form-group">
            <label>Department</label>
            <input type="text" name="department" placeholder="e.g. Computer Science" required>
          </div>
          <div class="form-grid-2">
            <div class="form-group">
              <label>Current Level</label>
              <select name="current_level">
                <option value="100">100 Level</option>
                <option value="200">200 Level</option>
                <option value="300" selected>300 Level</option>
                <option value="400">400 Level</option>
                <option value="500">500 Level</option>
              </select>
            </div>
            <div class="form-group">
              <label>Grading Scale</label>
              <select name="grading_scale">
                <option value="5" selected>5-Point</option>
                <option value="4">4-Point</option>
              </select>
            </div>
          </div>
          <button type="button" class="btn btn-primary" onclick="wizNext(2)">
            Continue <i class="fas fa-arrow-right"></i>
          </button>
        </div>

        <!-- Step 2: Track Type -->
        <div class="setup-step" id="step-2">
          <div class="wizard-title">Track Type</div>
          <div class="wizard-sub">Choose how you want to start logging grades.</div>

          <button type="button" class="path-card" onclick="selectPath('fresh')">
            <div class="path-card-top">
              <div class="path-icon blue"><i class="fas fa-star"></i></div>
              <b>Fresh Start</b>
            </div>
            <small>Log everything from scratch, semester by semester.</small>
          </button>

          <button type="button" class="path-card" onclick="selectPath('balance')">
            <div class="path-card-top">
              <div class="path-icon violet"><i class="fas fa-history"></i></div>
              <b>Import Balance</b>
            </div>
            <small>Carry forward your existing CGPA and unit totals.</small>
          </button>

          <button type="button" class="btn btn-outline" onclick="wizNext(1)">
            <i class="fas fa-arrow-left"></i> Back
          </button>
        </div>

        <!-- Step 3: Balance Import -->
        <div class="setup-step" id="step-3">
          <div class="wizard-title">Balance Import</div>
          <div class="wizard-sub">Enter your current academic standing to carry it forward.</div>

          <div class="form-grid-2">
            <div class="form-group">
              <label>Current CGPA</label>
              <input type="number" name="prev_cgpa" id="prev_cgpa_input" step="0.01" min="0" max="5" value="0.00" placeholder="e.g. 3.75 (5-pt) or 3.0 (4-pt)">
            </div>
            <div class="form-group">
              <label>Total Units Registered</label>
              <input type="number" name="prev_units" min="0" value="0">
            </div>
          </div>

          <div class="balance-box">
            <div class="balance-box-label"><i class="fas fa-info-circle"></i> How it works</div>
            <small>
              <strong>5-point scale:</strong> max CGPA is 5.00 &nbsp;|&nbsp; <strong>4-point scale:</strong> max CGPA is 4.00<br><br>
              Your existing CGPA × units will be stored as a quality-point base. New courses build on top of it.
            </small>
          </div>

          <button type="submit" class="btn btn-primary">
            <i class="fas fa-chart-line"></i> Build My Dashboard
          </button>
          <button type="button" class="btn btn-outline" onclick="wizNext(2)">
            <i class="fas fa-arrow-left"></i> Back
          </button>
        </div>

      </form>
    </div>
  </div>


  <!-- ════════════ DASHBOARD (has profile) ════════════ -->
  <% } else { %>

  <%
    // ── Server-side CGPA computation ─────────────────────────
    const scale = parseInt(profile.grading_scale) || 5;

    // Base from balance import
    let totalUnits  = parseInt(profile.prev_units) || 0;
    let totalPoints = parseFloat(profile.prev_gp)  || 0;

    // Grade-point map
    const gpMap5 = { A:5, B:4, C:3, D:2, E:1, F:0 };
    const gpMap4 = { A:4, B:3, C:2, D:1, F:0 };
    const gpMap  = scale === 5 ? gpMap5 : gpMap4;

    const gradeCounts = { A:0, B:0, C:0, D:0, E:0, F:0 };

    courses.forEach(c => {
      const g = (c.grade || 'F').toUpperCase();
      if (gradeCounts.hasOwnProperty(g)) gradeCounts[g]++;
      if (!c.is_hidden) {
        const u  = parseInt(c.credit_units) || 0;
        const pt = (gpMap[g] !== undefined ? gpMap[g] : 0);
        totalUnits  += u;
        totalPoints += pt * u;
      }
    });

    const calculatedCGPA = totalUnits > 0
      ? (totalPoints / totalUnits).toFixed(2)
      : '0.00';

    const cgpaFloat = parseFloat(calculatedCGPA);

    let degreeClass = 'Pass';
    let divBadge    = 'none';

    if (scale === 5) {
      if      (cgpaFloat >= 4.50) { degreeClass = 'First Class Honours';   divBadge = 'first'; }
      else if (cgpaFloat >= 3.50) { degreeClass = 'Second Class (Upper)';  divBadge = 'upper'; }
      else if (cgpaFloat >= 2.40) { degreeClass = 'Second Class (Lower)';  divBadge = 'lower'; }
      else if (cgpaFloat >= 1.50) { degreeClass = 'Third Class';           divBadge = 'third'; }
      else if (cgpaFloat >= 1.00) { degreeClass = 'Pass';                  divBadge = 'none';  }
      else                        { degreeClass = 'Fail';                  divBadge = 'fail';  }
    } else {
      if      (cgpaFloat >= 3.50) { degreeClass = 'First Class Honours';   divBadge = 'first'; }
      else if (cgpaFloat >= 3.00) { degreeClass = 'Second Class (Upper)';  divBadge = 'upper'; }
      else if (cgpaFloat >= 2.00) { degreeClass = 'Second Class (Lower)';  divBadge = 'lower'; }
      else if (cgpaFloat >= 1.50) { degreeClass = 'Third Class';           divBadge = 'third'; }
      else if (cgpaFloat >= 1.00) { degreeClass = 'Pass';                  divBadge = 'none';  }
      else                        { degreeClass = 'Fail';                  divBadge = 'fail';  }
    }

    const arcPct = Math.min(cgpaFloat / scale, 1);
    const arcOffset = (251.2 * (1 - arcPct)).toFixed(1);
  %>

  <!-- Hero Banner -->
  <div class="hero">
    <div class="hero-content">
      <p class="hero-eyebrow">Cumulative Grade Point Average</p>

      <div class="hero-main">
        <h1 class="hero-cgpa"><%= calculatedCGPA %></h1>

        <div class="arc-wrap">
          <svg width="90" height="90" viewBox="0 0 100 100">
            <defs>
              <linearGradient id="heroGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#2563eb"/>
                <stop offset="100%" stop-color="#7c3aed"/>
              </linearGradient>
            </defs>
            <circle class="arc-bg"   cx="50" cy="50" r="40"/>
            <circle class="arc-fill" cx="50" cy="50" r="40"
              style="stroke-dashoffset:<%= arcOffset %>"/>
          </svg>
          <div class="arc-pct"><%= Math.round(arcPct * 100) %>%</div>
        </div>
      </div>

      <div>
        <span class="division-badge <%= divBadge %>"><%= degreeClass %></span>
      </div>

      <div class="hero-meta">
        <span><%= profile.department %></span>
        <div class="hero-dot"></div>
        <span><strong><%= scale %>.0 Scale</strong></span>
        <div class="hero-dot"></div>
        <span><%= courses.length %> courses logged</span>
      </div>
    </div>
  </div>

  <!-- Stats Row -->
  <div class="stats-row">
    <div class="stat-tile blue">
      <div class="stat-icon"><i class="fas fa-layer-group"></i></div>
      <div class="stat-num"><%= totalUnits %></div>
      <div class="stat-label">Total Units</div>
    </div>
    <div class="stat-tile green">
      <div class="stat-icon"><i class="fas fa-star"></i></div>
      <div class="stat-num"><%= totalPoints.toFixed(1) %></div>
      <div class="stat-label">Quality Points</div>
    </div>
    <div class="stat-tile red">
      <div class="stat-icon"><i class="fas fa-book"></i></div>
      <div class="stat-num"><%= courses.length %></div>
      <div class="stat-label">Logged Courses</div>
    </div>
  </div>

  <!-- Analytics Card -->
  <div class="analytics-card">
    <div class="card-title" style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
      <i class="fas fa-chart-bar" style="color:var(--blue);"></i>
      Grade Distribution
    </div>
    <div class="chart-container">
      <canvas id="gradeChart"></canvas>
    </div>
    <div class="grade-grid">
      <% ['A','B','C','D','E','F'].forEach(letter => { %>
        <div class="grade-pill">
          <div class="grade-letter <%= letter %>"><%= letter %></div>
          <div class="grade-count"><%= gradeCounts[letter] %>×</div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Level Filter -->
  <div class="section-header">
    <div class="section-label">Academic Portfolio</div>
  </div>

  <div class="scroll-row">
    <button class="pill active" id="level-pill-all"  onclick="filterLevel('all',this)">All Levels</button>
    <button class="pill"        id="level-pill-100"  onclick="filterLevel('100',this)">100L</button>
    <button class="pill"        id="level-pill-200"  onclick="filterLevel('200',this)">200L</button>
    <button class="pill"        id="level-pill-300"  onclick="filterLevel('300',this)">300L</button>
    <button class="pill"        id="level-pill-400"  onclick="filterLevel('400',this)">400L</button>
    <button class="pill"        id="level-pill-500"  onclick="filterLevel('500',this)">500L</button>
  </div>

  <div class="sem-row">
    <div class="sem-pills">
      <button class="pill active" id="sem-pill-all" onclick="filterSem('all',this)">Both</button>
      <button class="pill"        id="sem-pill-1"   onclick="filterSem('1',this)">1st Sem</button>
      <button class="pill"        id="sem-pill-2"   onclick="filterSem('2',this)">2nd Sem</button>
    </div>
    <div class="gpa-badge" id="term-gpa-badge">GPA: <%= calculatedCGPA %></div>
  </div>

  <!-- Course Matrix -->
  <div class="card">
    <div class="card-header">
      <div class="card-title" id="matrix-label">All Courses</div>
      <div class="card-meta"  id="matrix-count"><%= courses.length %> total</div>
    </div>

    <div id="course-matrix">
      <% if (courses.length === 0) { %>
        <div class="empty-state">
          <i class="fas fa-folder-open"></i>
          <p>No courses logged yet. Tap <strong>+</strong> to add your first course.</p>
        </div>
      <% } else { %>
        <% courses.forEach(c => { %>
          <div class="course-row data-row <%= c.is_hidden ? 'is-hidden' : '' %>"
               data-id="<%= c.id %>"
               data-code="<%= c.code %>"
               data-title="<%= c.title || 'Course Module' %>"
               data-units="<%= c.credit_units %>"
               data-grade="<%= c.grade %>"
               data-level="<%= c.level_scope %>"
               data-semester="<%= c.semester %>">
            <div class="course-left">
              <div class="cname">
                <%= c.code %>
                <% if (c.is_hidden) { %><span class="tag-hidden">excluded</span><% } %>
              </div>
              <div class="cmeta">
                <span><i class="fas fa-circle" style="font-size:0.3rem;"></i> <%= c.credit_units %> units</span>
                <span><%= c.title || 'Course Module' %></span>
                <span>L<%= c.level_scope %> · S<%= c.semester %></span>
              </div>
            </div>
            <div class="course-right">
              <div class="grade-chip <%= c.grade %>"><%= c.grade %></div>
              <div class="action-btns">
                <button type="button" class="act-btn" title="Edit" onclick="openEdit('<%= c.id %>')">
                  <i class="fas fa-pen"></i>
                </button>
                <form action="/cgpa/course/toggle-visible/<%= c.id %>" method="POST" style="display:contents;">
                  <button type="submit" class="act-btn <%= c.is_hidden ? 'eye-active' : '' %>" title="Toggle visibility">
                    <i class="fas <%= c.is_hidden ? 'fa-eye-slash' : 'fa-eye' %>"></i>
                  </button>
                </form>
                <form action="/cgpa/course/delete/<%= c.id %>" method="POST" style="display:contents;"
                      onsubmit="return confirm('Delete <%= c.code %>?');">
                  <button type="submit" class="act-btn danger" title="Delete">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <% } %> <!-- end hasProfile -->
</div><!-- end shell -->


<!-- ════════════ ADD COURSE OVERLAY ════════════ -->
<div class="overlay" id="add-overlay">
  <div class="overlay-inner">
    <div class="overlay-header">
      <div class="overlay-title">Log Course Outcome</div>
      <button class="overlay-close" onclick="closeOverlay('add-overlay')"><i class="fas fa-times"></i></button>
    </div>

    <form action="/cgpa/course/add" method="POST">
      <div class="form-grid-2">
        <div class="form-group">
          <label>Course Code</label>
          <input type="text" name="code" placeholder="e.g. PHY301" required style="text-transform:uppercase;">
        </div>
        <div class="form-group">
          <label>Course Title</label>
          <input type="text" name="title" placeholder="e.g. Thermodynamics">
        </div>
      </div>

      <div class="form-grid-2">
        <div class="form-group">
          <label>Level</label>
          <select name="level_scope" required>
            <option value="100">100 Level</option>
            <option value="200">200 Level</option>
            <option value="300" selected>300 Level</option>
            <option value="400">400 Level</option>
            <option value="500">500 Level</option>
          </select>
        </div>
        <div class="form-group">
          <label>Semester</label>
          <select name="semester" required>
            <option value="1" selected>1st Semester</option>
            <option value="2">2nd Semester</option>
          </select>
        </div>
      </div>

      <div class="form-grid-2">
        <div class="form-group">
          <label>Credit Units</label>
          <input type="number" name="credit_units" min="1" max="8" value="3" required>
        </div>
        <div class="form-group">
          <label>Grade <small style="text-transform:none;letter-spacing:0;color:var(--blue);">(<%= hasProfile ? profile.grading_scale : 5 %>-pt scale)</small></label>
          <select name="grade" required>
            <% if (hasProfile && profile.grading_scale == 5) { %>
              <option value="A">A — 5 pts (Excellent)</option>
              <option value="B">B — 4 pts (Good)</option>
              <option value="C">C — 3 pts (Average)</option>
              <option value="D">D — 2 pts (Below Avg)</option>
              <option value="E">E — 1 pt  (Poor)</option>
              <option value="F">F — 0 pts (Fail)</option>
            <% } else { %>
              <option value="A">A — 4 pts (Excellent)</option>
              <option value="B">B — 3 pts (Good)</option>
              <option value="C">C — 2 pts (Average)</option>
              <option value="D">D — 1 pt  (Below Avg)</option>
              <option value="F">F — 0 pts (Fail)</option>
            <% } %>
          </select>
        </div>
      </div>

      <button type="submit" class="btn btn-primary" style="margin-top:10px;">
        <i class="fas fa-plus"></i> Save Course
      </button>
    </form>
  </div>
</div>


<!-- ════════════ EDIT COURSE OVERLAY ════════════ -->
<div class="overlay" id="edit-overlay">
  <div class="overlay-inner">
    <div class="overlay-header">
      <div class="overlay-title">Edit Course</div>
      <button class="overlay-close" onclick="closeOverlay('edit-overlay')"><i class="fas fa-times"></i></button>
    </div>

    <form action="/cgpa/course/edit" method="POST">
      <input type="hidden" name="id" id="edit-id">

      <div class="form-grid-2">
        <div class="form-group">
          <label>Course Code</label>
          <input type="text" name="code" id="edit-code" required style="text-transform:uppercase;">
        </div>
        <div class="form-group">
          <label>Course Title</label>
          <input type="text" name="title" id="edit-title">
        </div>
      </div>

      <div class="form-grid-2">
        <div class="form-group">
          <label>Credit Units</label>
          <input type="number" name="units" id="edit-units" min="1" max="8" required>
        </div>
        <div class="form-group">
          <label>Grade <small style="text-transform:none;letter-spacing:0;color:var(--blue);">(<%= hasProfile ? profile.grading_scale : 5 %>-pt scale)</small></label>
          <select name="grade" id="edit-grade" required>
            <% if (hasProfile && profile.grading_scale == 5) { %>
              <option value="A">A — 5 pts</option>
              <option value="B">B — 4 pts</option>
              <option value="C">C — 3 pts</option>
              <option value="D">D — 2 pts</option>
              <option value="E">E — 1 pt</option>
              <option value="F">F — 0 pts</option>
            <% } else { %>
              <option value="A">A — 4 pts</option>
              <option value="B">B — 3 pts</option>
              <option value="C">C — 2 pts</option>
              <option value="D">D — 1 pt</option>
              <option value="F">F — 0 pts</option>
            <% } %>
          </select>
        </div>
      </div>

      <button type="submit" class="btn btn-primary" style="margin-top:10px;">
        <i class="fas fa-save"></i> Save Changes
      </button>
    </form>
