/* â”€â”€ CGPA AI Functions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
function aiEscape(s) { return (s == null ? '' : String(s)).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

/* â”€â”€ Advisor: Predict next semester â”€â”€â”€â”€â”€â”€â”€â”€ */
function aiPredictGpa() {
    var box = document.getElementById('aiPredictResult');
    box.style.display = 'block';
    box.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Asking AI to analyze your grades...';
    fetch('/api/cgpa/ai-predict', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
    .then(function(r){ return r.json(); })
    .then(function(d) {
        if (d && d.success && d.prediction) {
            var html = d.prediction.split(/\n/).map(function(l) {
                return l.trim() ? '<p style="margin:0 0 6px">' + aiEscape(l) + '</p>' : '';
            }).join('');
            box.innerHTML = '<div style="border-left:3px solid var(--brand);padding-left:12px">' + html + '</div>';
        } else {
            box.innerHTML = '<p style="color:var(--danger);margin:0">' + aiEscape((d && d.error) ? d.error : 'Could not generate prediction.') + '</p>';
        }
    })
    .catch(function(err) {
        box.innerHTML = '<p style="color:var(--danger);margin:0">Network error: ' + aiEscape(err.message) + '</p>';
    });
}

function openCGPAChat() {
    var history = [];
    var containerId = 'cgpa-chat-container-' + Date.now();
    Swal.fire({
        title: '<span style="font-weight:800;font-size:1rem">AI Academic Advisor</span>',
        html:
            '<div id="' + containerId + '" style="text-align:left;max-height:400px;overflow-y:auto;padding:4px;font-size:0.85rem"></div>' +
            '<div id="cgpa-chat-pending" style="display:none;background:var(--surface);border-radius:10px;padding:10px;margin-bottom:8px;font-size:0.85rem"><i class="fas fa-spinner fa-spin"></i> Thinking...</div>' +
            '<div style="display:flex;gap:6px;margin-top:8px">' +
            '<input id="cgpa-chat-inp" type="text" placeholder="Ask about your CGPA..." style="flex:1;padding:11px 13px;border:1.5px solid #cbd5e1;border-radius:10px;font-family:inherit;font-size:0.85rem;font-weight:600;outline:none">' +
            '<button id="cgpa-chat-send" type="button" style="padding:11px 16px;border:none;background:linear-gradient(135deg,#2563eb,#1d4ed8);color:white;font-weight:700;border-radius:10px;cursor:pointer"><i class="fas fa-paper-plane"></i></button></div>' +
            '<div style="font-size:0.68rem;color:#94a3b8;margin-top:6px;font-weight:600">AI can misread data. Verify important decisions.</div>',
        showConfirmButton: false,
        showCloseButton: true,
        width: 500,
        didOpen: function() {
            var box = document.getElementById(containerId);
            var pending = document.getElementById('cgpa-chat-pending');
            box.innerHTML = '<div style="display:flex;gap:10px;margin-bottom:8px"><div style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#1d4ed8);display:flex;align-items:center;justify-content:center;color:white;font-size:0.7rem"><i class="fas fa-robot"></i></div><div style="flex:1;background:var(--surface);border-radius:10px;padding:10px;line-height:1.5">Hi! I\'m your CGPA advisor. Ask me anything — what-if a grade, how to raise your GPA, which semesters to focus on, etc.</div></div>';

            function appnd(role, text, color) {
                var div = document.createElement('div');
                div.style.cssText = 'display:flex;gap:10px;margin-bottom:8px';
                if (role === 'user') div.style.flexDirection = 'row-reverse';
                div.innerHTML = role === 'user'
                    ? '<div style="flex:1;background:#2563eb;color:white;border-radius:10px;padding:10px;line-height:1.5">' + aiEscape(text) + '</div>'
                    : '<div style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#1d4ed8);display:flex;align-items:center;justify-content:center;color:white;font-size:0.7rem;flex-shrink:0"><i class="fas fa-robot"></i></div><div style="flex:1;background:var(--surface);border-radius:10px;padding:10px;line-height:1.5;white-space:pre-wrap">' + aiEscape(text) + '</div>';
                box.appendChild(div);
                box.parentElement.scrollTop = box.parentElement.scrollHeight;
            }

            var inp = document.getElementById('cgpa-chat-inp');
            var send = document.getElementById('cgpa-chat-send');

            function ask(q) {
                q = (q || '').trim();
                if (!q) return;
                appnd('user', q);
                pending.style.display = 'block';
                inp.value = '';
                history.push({ role: 'user', text: q });
                fetch('/api/cgpa/ai-chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: q, history: history })
                })
                .then(function(r){ return r.json().catch(function(){ return { success:false, error:'Bad response' }; }); })
                .then(function(d) {
                    pending.style.display = 'none';
                    if (d && d.success && d.reply) {
                        history.push({ role: 'assistant', text: d.reply });
                        appnd('ai', d.reply);
                    } else {
                        appnd('ai', (d && d.error) ? 'Error: ' + d.error : 'Sorry, I could not process that.');
                    }
                })
                .catch(function(err) {
                    pending.style.display = 'none';
                    appnd('ai', 'Network error: ' + (err.message || 'request failed'));
                });
            }
            send.onclick = function(){ ask(inp.value); };
            inp.onkeydown = function(e){ if (e.key === 'Enter') ask(inp.value); };
            setTimeout(function(){ try { inp.focus(); } catch(e){} }, 100);
        }
    });
}
<% } %>
</script>
</body>
</html>

