</div>

<!-- Course list -->
<div class="course-card reveal glass hover-lift">
    <div class="course-card-head">
        <div class="course-card-title" id="matLabel">All Courses</div>
        <div class="course-card-meta"  id="matCount"><%= courses.length %> total</div>
        <button class="act btn-enhanced btn-shine hover-lift" style="background:var(--brand-gradient);color:white;padding:6px 12px;border-radius:10px;width:auto;font-weight:700;font-size:0.74rem;display:inline-flex;align-items:center;gap:6px" onclick="openOv('ov-add')" title="Add a course"><i class="fas fa-plus"></i> Add Course</button>
    </div>

    <div id="matrix">
    <% if (!courses.length) { %>
        <div class="empty-state">
            <i class="fas fa-folder-open"></i>
            <p>No courses yet. Tap <strong>+</strong> to log your first course.</p>
        </div>
    <% } else { %>
        <div class="bulk-bar" id="bulkBar" style="display:none;">
            <span id="bulkCount">0 selected</span>
            <div class="bulk-actions">
                <button type="button" class="btn-bulk-act" onclick="bulkAction('hide')" title="Hide selected"><i class="fas fa-eye-slash"></i> Hide</button>
                <button type="button" class="btn-bulk-act danger" onclick="bulkAction('delete')" title="Delete selected"><i class="fas fa-trash"></i> Delete</button>
                <button type="button" class="btn-bulk-act" onclick="clearSelection()">Cancel</button>
            </div>
        </div>
        <% courses.forEach(c => { %>
        <div class="crow <%= c.is_hidden ? 'hidden-row' : '' %> data-row"
             data-id="<%= c.id %>"
             data-code="<%= c.code %>"
             data-title="<%= c.title || '' %>"
             data-units="<%= c.credit_units %>"
             data-grade="<%= c.grade %>"
             data-level="<%= c.level_scope %>"
             data-semester="<%= c.semester %>">
            <div class="crow-check">
                <input type="checkbox" class="row-check" value="<%= c.id %>" onchange="updateBulkBar()">
            </div>
