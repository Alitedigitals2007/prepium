/* â”€â”€ Advisor: Multi-Course What-If â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
var advisorCourses = [];

function addAdvisorCourse() {
    var name = document.getElementById('wiCourseName').value.trim() || ('Course ' + (advisorCourses.length + 1));
    var units = parseInt(document.getElementById('wiCourseUnits').value) || 3;
    var grade = document.getElementById('wiCourseGrade').value;
    advisorCourses.push({ name: name, units: units, grade: grade });
    renderAdvisorCourses();
    document.getElementById('wiCourseName').value = '';
}

function removeAdvisorCourse(idx) {
    advisorCourses.splice(idx, 1);
    renderAdvisorCourses();
}

function renderAdvisorCourses() {
    var container = document.getElementById('whatifCourseList');
    var btn = document.getElementById('calcImpactBtn');
    if (advisorCourses.length === 0) {
        container.innerHTML = '<div style="font-size:0.7rem;color:var(--text-muted);font-weight:600;padding:6px 0;">No courses added. Add courses above to see their impact.</div>';
        if (btn) btn.style.display = 'none';
        return;
    }
    var html = '';
    for (var i = 0; i < advisorCourses.length; i++) {
        var c = advisorCourses[i];
        var gc = c.grade === 'A' ? 'var(--success)' : c.grade === 'F' ? 'var(--danger)' : c.grade === 'B' ? 'var(--brand)' : 'var(--text-dark)';
        html += '<div style="display:flex;align-items:center;justify-content:space-between;padding:7px 10px;background:var(--surface-solid);border:1px solid var(--border);border-radius:8px;margin-bottom:4px;font-size:0.75rem;font-weight:600;animation:rowIn .22s ease;">';
        html += '<span>' + aiEscape(c.name) + ' <span style="color:var(--text-muted);font-weight:600;">' + c.units + ' units</span> <span style="color:' + gc + ';">(' + c.grade + ')</span></span>';
        html += '<button onclick="removeAdvisorCourse(' + i + ')" style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:0.75rem;padding:4px;transition:.15s;" onmouseover="this.style.color=\'var(--danger)\'" onmouseout="this.style.color=\'\'"><i class="fas fa-times-circle"></i></button>';
        html += '</div>';
    }
    container.innerHTML = html;
    if (btn) btn.style.display = 'block';
}

function calcAdvisorImpact() {
    if (advisorCourses.length === 0) return;
    var btn = document.getElementById('calcImpactBtn');
    var result = document.getElementById('whatifImpact');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Calculating...';
    result.innerHTML = '';
    fetch('/api/cgpa/bulk-whatif', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ courses: advisorCourses })
    })
    .then(function(r){ return r.json(); })
    .then(function(d) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-calculator"></i> Calculate Impact';
        if (d.success) {
            var color = parseFloat(d.change) >= 0 ? '#16a34a' : '#dc2626';
            var sign = parseFloat(d.change) >= 0 ? '+' : '';
            var bg = parseFloat(d.change) >= 0 ? 'var(--success-soft)' : 'var(--danger-soft)';
            var bd = parseFloat(d.change) >= 0 ? 'rgba(16,185,129,.15)' : 'rgba(239,68,68,.15)';
            result.innerHTML =
                '<div style="background:' + bg + ';border:1px solid ' + bd + ';border-radius:12px;padding:14px;animation:pop .35s cubic-bezier(0.25, 0.8, 0.25, 1);">' +
                '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">' +
                '<span style="font-size:0.65rem;font-weight:700;color:var(--text-sub);text-transform:uppercase;">Current CGPA</span>' +
                '<span style="font-size:0.65rem;font-weight:700;color:var(--text-sub);text-transform:uppercase;">With Additions</span></div>' +
                '<div style="display:flex;justify-content:space-between;align-items:center;">' +
                '<span style="font-size:1.6rem;font-weight:900;color:var(--text-primary);">' + d.currentCGPA + '</span>' +
                '<span style="font-size:0.7rem;color:var(--text-muted);font-weight:600;"><i class="fas fa-arrow-right"></i></span>' +
                '<span style="font-size:1.6rem;font-weight:900;color:' + color + ';">' + d.newCGPA + '</span></div>' +
                '<div style="margin-top:8px;padding-top:8px;border-top:1px solid ' + (parseFloat(d.change) >= 0 ? 'rgba(16,185,129,.2)' : 'rgba(239,68,68,.2)') + ';display:flex;justify-content:space-between;align-items:center;">' +
                '<span style="font-size:0.75rem;font-weight:600;color:var(--text-sub);">' + d.totalUnits + ' units â†’ ' + d.newTotalUnits + ' units</span>' +
                '<span style="font-size:0.85rem;font-weight:800;color:' + color + ';">' + sign + d.change + '</span></div></div>';
        } else {
            result.innerHTML = '<div style="padding:10px;font-size:0.75rem;color:var(--danger);font-weight:600;background:var(--danger-soft);border-radius:8px;">' + aiEscape(d.error || 'Could not calculate.') + '</div>';
        }
    })
    .catch(function(err) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-calculator"></i> Calculate Impact';
        result.innerHTML = '<div style="padding:10px;font-size:0.75rem;color:var(--danger);font-weight:600;background:var(--danger-soft);border-radius:8px;">Network error: ' + aiEscape(err.message) + '</div>';
    });
}

