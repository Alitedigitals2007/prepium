            <strong>5-point scale:</strong> max CGPA 5.00 &nbsp;·&nbsp; <strong>4-point scale:</strong> max CGPA 4.00
        </div>

<button type="submit" class="btn btn-primary btn-enhanced hover-lift">
    <i class="fas fa-chart-line"></i> Build My Tracker
</button>
<button type="button" class="btn btn-ghost btn-enhanced hover-lift" onclick="goStep(2)">
