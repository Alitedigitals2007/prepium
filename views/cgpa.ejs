<!-- â•â•â•â• SCRIPTS â•â•â•â• -->
<script>
/* â”€â”€ Wizard â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
const PROGS = { 1:'33%', 2:'66%', 3:'100%' };
function goStep(n) {
    document.querySelectorAll('.wiz-step').forEach(s => s.classList.remove('on'));
    document.getElementById('s'+n).classList.add('on');
    document.getElementById('prog').style.width = PROGS[n];
}
function pickPath(val) {
    document.getElementById('stype').value = val;
    if (val === 'balance') goStep(3);
    else document.getElementById('wiz-form').submit();
}
// sync max attr for CGPA input when scale changes
const scaleSel = document.getElementById('scale-sel');
const prevCGPA = document.getElementById('prev_cgpa');
if (scaleSel && prevCGPA) {
    scaleSel.addEventListener('change', () => {
        prevCGPA.max         = scaleSel.value;
        prevCGPA.placeholder = `e.g. ${scaleSel.value==='5'?'3.75':'3.00'}`;
    });
}

/* â”€â”€ Overlays â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
function openOv(id)  { document.getElementById(id).classList.add('show'); document.body.style.overflow='hidden'; }
function closeOv(id) { document.getElementById(id).classList.remove('show'); document.body.style.overflow=''; }
document.querySelectorAll('.overlay').forEach(ov => {
    ov.addEventListener('click', e => { if (e.target===ov) closeOv(ov.id); });
});

/* â”€â”€ Edit pre-fill â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
function openEdit(id) {
    const r = document.querySelector(`.data-row[data-id="${id}"]`);
    if (!r) return;
    document.getElementById('e-id').value    = id;
    document.getElementById('e-code').value  = r.dataset.code;
    document.getElementById('e-title').value = r.dataset.title;
    document.getElementById('e-units').value = r.dataset.units;
    const sel = document.getElementById('e-grade');
    if (sel) sel.value = r.dataset.grade;
    openOv('ov-edit');
}

/* â”€â”€ AI Advisor fallback (overridden by real fn if hasProfile) â”€â”€ */
function openCGPAChat() {
    Swal.fire({
        icon: 'info',
        title: 'Setup Required',
        text: 'Set up your CGPA profile first to use the AI Advisor.',
        confirmButtonText: 'OK'
    });
}

<% if (hasProfile) { %>
/* â”€â”€ Filter state â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
const SCALE  = <%= parseInt(profile.grading_scale)||5 %>;
const GP_MAP = SCALE === 5
    ? { A:5, B:4, C:3, D:2, E:1, F:0 }
    : { A:4, B:3, C:2, D:1, E:0, F:0 };
const PREV_UNITS = <%= parseInt(profile.prev_units)||0 %>;
const PREV_GP    = <%= parseFloat(profile.prev_gp)||0 %>;
const GRADE_COUNTS = <%- JSON.stringify(gradeCounts) %>;

let curLvl = 'all', curSem = 'all';

function fLvl(v, btn) {
    curLvl = v;
    document.querySelectorAll('#lvl-pills .pill').forEach(p => p.classList.remove('on'));
    btn.classList.add('on');
    render();
}
function fSem(v, btn) {
    curSem = v;
    document.querySelectorAll('#sem-pills .pill').forEach(p => p.classList.remove('on'));
    btn.classList.add('on');
    render();
}

function render() {
    const rows = document.querySelectorAll('.data-row');
    let shown=0, u=0, pts=0;
    rows.forEach(r => {
        const lvl = r.dataset.level, sem = r.dataset.semester;
        const ok  = (curLvl==='all'||curLvl===lvl) && (curSem==='all'||curSem===sem);
        r.style.display = ok ? 'flex' : 'none';
        if (ok) {
            shown++;
            if (!r.classList.contains('hidden-row')) {
                const cu = parseInt(r.dataset.units)||0;
                const g  = (r.dataset.grade||'F').toUpperCase();
                u   += cu;
                pts += (GP_MAP[g]!==undefined?GP_MAP[g]:0)*cu;
            }
        }
    });
    // include prev balance in GPA only when showing all
    const tu = (curLvl==='all'&&curSem==='all') ? u+PREV_UNITS : u;
    const tp = (curLvl==='all'&&curSem==='all') ? pts+PREV_GP  : pts;
    const gpa = tu>0 ? (tp/tu).toFixed(2) : '—';
    document.getElementById('termGPA').textContent = `GPA: ${gpa}`;
    document.getElementById('matCount').textContent = `${shown} shown`;

    const ll = curLvl==='all'?'All Levels':`${curLvl}L`;
    const sl = curSem==='all'?'Both Sems':`Sem ${curSem}`;
    document.getElementById('matLabel').textContent = `${ll} · ${sl}`;
}

/* â”€â”€ Chart.js â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
document.addEventListener('DOMContentLoaded', () => {
    render();
    var gradeChartDone = false;
    function initGradeChart() {
        var ctx = document.getElementById('gChart');
        if (!ctx || gradeChartDone) return;
        if (typeof Chart === 'undefined') { setTimeout(initGradeChart, 300); return; }
        gradeChartDone = true;
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['A','B','C','D','E','F'],
                datasets: [{
                    data: [GRADE_COUNTS.A, GRADE_COUNTS.B, GRADE_COUNTS.C, GRADE_COUNTS.D, GRADE_COUNTS.E, GRADE_COUNTS.F],
                    backgroundColor: ['rgba(180,83,9,.1)','rgba(37,99,235,.1)','rgba(13,148,136,.1)','rgba(124,58,237,.1)','rgba(82,82,91,.1)','rgba(225,29,72,.1)'],
                    borderColor:     ['#b45309','#2563eb','#0d9488','#7c3aed','#52525b','#e11d48'],
                    borderWidth: 1.5, borderRadius: 7, borderSkipped: false
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend:{ display:false } },
                scales: {
                    x: { grid:{ display:false }, ticks:{ autoSkip:false, font:{ family:'Plus Jakarta Sans',weight:'700' } } },
                    y: { suggestedMax: 10, grid:{ color:'rgba(0,0,0,.04)' }, ticks:{ precision:0 } }
                }
            }
        });
    }
    initGradeChart();
    initTrendChart();
});

/* â”€â”€ Trend Chart â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
function initTrendChart() {
    var ctx = document.getElementById('trendChart');
    if (!ctx) return;
    
    // Check if we're in the profile state (has data to show)
    if (<%= !hasProfile ? 'true' : 'false' %> ) {
        ctx.parentNode.innerHTML = '<div style="padding:20px;text-align:center;color:var(--text-sub);">Set up your profile to see CGPA trends</div>';
        return;
    }
    
    // Extract semester data from existing course elements
    var semesterData = {};
    
    // Process all course rows to calculate GPA per semester
    var rows = document.querySelectorAll('.data-row');
    rows.forEach(function(row) {
        // Skip hidden rows
        if (row.classList.contains('hidden-row')) return;
        
        var level = row.dataset.level;
        var semester = row.dataset.semester;
        var units = parseInt(row.dataset.units) || 0;
        var grade = row.dataset.grade || 'F';
        
        // Create semester key
        var semKey = 'L' + level + 'S' + semester;
        
        // Initialize semester data if not exists
        if (!semesterData[semKey]) {
            semesterData[semKey] = {
                level: parseInt(level),
                semester: parseInt(semester),
                totalUnits: 0,
                totalPoints: 0,
                gpa: 0.0
            };
        }
        
        // Add course data to semester
        if (units > 0) {
            var scale = parseInt(<%= hasProfile ? profile.grading_scale : '5' %>) || 5;
            var gpMap = scale === 5 ? {A:5, B:4, C:3, D:2, E:1, F:0} : {A:4, B:3, C:2, D:1, E:0, F:0};
            var gradePoints = gpMap[grade] || 0;
            
            semesterData[semKey].totalUnits += units;
            semesterData[semKey].totalPoints += (gradePoints * units);
        }
    });
    
    // Calculate GPA for each semester and sort by level/semester
    var semesters = Object.keys(semesterData).map(function(key) {
        var sem = semesterData[key];
        if (sem.totalUnits > 0) {
            sem.gpa = (sem.totalPoints / sem.totalUnits).toFixed(2);
        } else {
            sem.gpa = 0.00;
        }
        return sem;
    }).filter(function(sem) {
        return sem.totalUnits > 0; // Only include semesters with courses
    }).sort(function(a, b) {
        if (a.level !== b.level) return a.level - b.level;
        return a.semester - b.semester;
    });
    
    // If no semester data available, show message
    if (semesters.length === 0) {
        ctx.parentNode.innerHTML = '<div style="padding:20px;text-align:center;color:var(--text-sub);">No semester data available yet</div>';
        return;
    }
    
    // Prepare data for the chart
    var labels = semesters.map(function(sem) {
        return 'L' + sem.level + ' S' + sem.semester;
    });
    var gpaValues = semesters.map(function(sem) {
        return parseFloat(sem.gpa);
    });
    
    // Determine scale for Y-axis
    var scale = parseInt(<%= hasProfile ? profile.grading_scale : '5' %>) || 5;
    
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'CGPA Trend',
                data: gpaValues,
                fill: false,
                borderColor: 'var(--brand)',
                backgroundColor: 'var(--brand-soft)',
                tension: 0.3,
                pointBackgroundColor: 'var(--brand)',
                pointBorderColor: '#fff',
                pointHoverBackgroundColor: '#fff',
                pointHoverBorderColor: 'var(--brand)'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    mode: 'index',
                    intersect: false,
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    max: scale,
                    ticks: {
                        stepSize: 0.5,
                        callback: function(value) {
                            return value.toFixed(2);
                        }
                    },
                    grid: {
                        color: 'rgba(0,0,0,.04)'
                    }
                },
                x: {
                    grid: {
                        display: false
                    },
                    ticks: {
                        font: {
                            family: 'Plus Jakarta Sans',
                            weight: '600'
                        }
                    }
                }
            }
        }
    });
}

