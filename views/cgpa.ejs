<button class="pill" onclick="fLvl('100',this)" class="btn-enhanced hover-lift">100L</button>
<button class="pill" onclick="fLvl('200',this)" class="btn-enhanced hover-lift">200L</button>
<button class="pill" onclick="fLvl('300',this)" class="btn-enhanced hover-lift">300L</button>
