    </div>
    <p style="font-size:0.72rem;color:var(--text-sub);font-weight:500;line-height:1.5;">Auto-import courses from your Study Hub into CGPA tracker. Existing courses are skipped.</p>
</div>

<!-- AI Course Advisor with multi-course What-If -->
<div class="analytics reveal" style="margin-top:10px;">
    <div class="section-head" onclick="toggleAdvisor()" style="cursor:pointer;" class="btn-enhanced hover-lift">
        <div class="section-label"><i class="fas fa-robot"></i> AI Course Advisor</div>
        <span style="font-size:0.7rem;color:var(--brand);font-weight:700;" id="advisorToggle"><i class="fas fa-chevron-down"></i></span>
    </div>
    <div id="advisorBody" style="display:none;">
        <div style="display:flex;gap:6px;margin-bottom:12px;">
            <button type="button" onclick="aiPredictGpa()" style="flex:1;padding:11px;border:none;background:linear-gradient(135deg,#2563eb,#1d4ed8);color:white;border-radius:10px;font-weight:700;font-size:0.78rem;cursor:pointer" class="btn-enhanced btn-shine hover-lift"><i class="fas fa-magic"></i> Predict next semester</button>
            <button type="button" onclick="advisorWhatif()" style="flex:1;padding:11px;border:none;background:#0f172a;color:white;border-radius:10px;font-weight:700;font-size:0.78rem;cursor:pointer" class="btn-enhanced hover-lift"><i class="fas fa-calculator"></i> What-If Builder</button>
        </div>

        <div id="aiPredictResult" style="display:none;background:var(--surface);border-radius:10px;padding:12px;font-size:0.85rem;color:var(--text-primary);line-height:1.55;white-space:pre-wrap;margin-bottom:10px;"></div>

        <div id="whatifBuilder" style="display:none;">
            <div class="section-label" style="font-size:0.75rem;margin-bottom:8px;"><i class="fas fa-plus-circle"></i> Add courses to see CGPA impact</div>
            <div id="whatifCourseList" style="margin-bottom:8px;"></div>
            <div style="display:flex;gap:6px;flex-wrap:wrap;">
                <input type="text" id="wiCourseName" placeholder="Course name" style="flex:2;min-width:100px;padding:9px 10px;border:1.5px solid var(--border);border-radius:8px;font-family:inherit;font-weight:600;font-size:0.75rem;">
                <select id="wiCourseUnits" style="flex:1;min-width:60px;padding:9px;border:1.5px solid var(--border);border-radius:8px;font-family:inherit;font-weight:600;font-size:0.75rem;background:var(--surface-solid);">
                    <% for(var uu=1;uu<=8;uu++){ %><option value="<%= uu %>" <%= uu===3?'selected':'' %>><%= uu %>u</option><% } %>
                </select>
                <select id="wiCourseGrade" style="flex:1;min-width:50px;padding:9px;border:1.5px solid var(--border);border-radius:8px;font-family:inherit;font-weight:600;font-size:0.75rem;background:var(--surface-solid);">
                    <option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option><option value="E">E</option><option value="F">F</option>
                </select>
                <button onclick="addAdvisorCourse()" style="padding:9px 14px;border:none;background:var(--bg);border:1.5px solid var(--border);border-radius:8px;font-weight:700;font-size:0.7rem;cursor:pointer;color:var(--text-dark);" class="btn-enhanced hover-lift"><i class="fas fa-plus"></i> Add</button>
            </div>
            <div id="whatifImpact" style="margin-top:8px;"></div>
            <button id="calcImpactBtn" onclick="calcAdvisorImpact()" style="display:none;width:100%;margin-top:8px;padding:12px;border:none;background:var(--brand-gradient);color:white;border-radius:10px;font-weight:700;font-size:0.82rem;cursor:pointer;"><i class="fas fa-calculator"></i> Calculate Impact</button>
        </div>

        <div id="aiWhatifResult" style="display:none;background:var(--surface);border-radius:10px;padding:12px;font-size:0.85rem;color:var(--text-primary);line-height:1.55;margin-top:8px"></div>
    </div>
</div>

<!-- CGPA Trend Chart -->
<div class="analytics reveal hover-lift">
