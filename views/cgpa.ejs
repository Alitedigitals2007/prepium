    <i class="fas fa-bolt"></i><span>Quiz</span>
  </a>
  <a href="/profile" class="nav-item">
    <i class="fas fa-user-circle"></i><span>Profile</span>
  </a>
</div>


<!-- ════════════ SCRIPTS ════════════ -->
<script>

/* ── Setup wizard ─────────────────────────────── */
// Dynamically update CGPA max when scale is changed in step 1
document.addEventListener('DOMContentLoaded', () => {
  const scaleSelect = document.querySelector('select[name="grading_scale"]');
  const cgpaInput   = document.getElementById('prev_cgpa_input');
  if (scaleSelect && cgpaInput) {
    scaleSelect.addEventListener('change', () => {
      cgpaInput.max         = scaleSelect.value;
      cgpaInput.placeholder = scaleSelect.value === '5'
        ? 'e.g. 3.75 (max 5.00)' : 'e.g. 3.00 (max 4.00)';
    });
  }
});
function wizNext(step) {
  document.querySelectorAll('.setup-step').forEach(el => el.classList.remove('active'));
  document.getElementById('step-' + step).classList.add('active');
  document.querySelectorAll('.step-dot').forEach((d, i) => {
    d.classList.remove('active','done');
    if (i + 1 < step)  d.classList.add('done');
    if (i + 1 === step) d.classList.add('active');
  });
}
function selectPath(val) {
  document.getElementById('start_type_val').value = val;
  if (val === 'balance') wizNext(3);
  else document.getElementById('wizardForm').submit();
}

/* ── Overlays ─────────────────────────────────── */
function openOverlay(id) {
  document.getElementById(id).classList.add('show');
  document.body.style.overflow = 'hidden';
}
function closeOverlay(id) {
  document.getElementById(id).classList.remove('show');
  document.body.style.overflow = '';
}

/* ── Edit modal pre-fill ──────────────────────── */
function openEdit(id) {
  const row = document.querySelector(`.data-row[data-id="${id}"]`);
  if (!row) return;
  document.getElementById('edit-id').value    = id;
  document.getElementById('edit-code').value  = row.dataset.code;
  document.getElementById('edit-title').value = row.dataset.title;
  document.getElementById('edit-units').value = row.dataset.units;
  const sel = document.getElementById('edit-grade');
  if (sel) sel.value = row.dataset.grade;
  openOverlay('edit-overlay');
}

/* ── Close overlay on backdrop click ─────────── */
document.querySelectorAll('.overlay').forEach(ov => {
  ov.addEventListener('click', e => {
    if (e.target === ov) closeOverlay(ov.id);
  });
});

<% if (hasProfile) { %>
/* ── Grade counts (safe JS variable) ─────────── */
const GRADE_COUNTS = <%- JSON.stringify(typeof gradeCounts !== 'undefined' ? gradeCounts : {A:0,B:0,C:0,D:0,E:0,F:0}) %>;

/* ── Filter state ─────────────────────────────── */
let lvlFilter = 'all', semFilter = 'all';
const scale = <%= parseInt(profile.grading_scale) || 5 %>;

// Grade-to-point maps — E only exists on 5-point scale
const gpMap = scale === 5
  ? { A:5, B:4, C:3, D:2, E:1, F:0 }
  : { A:4, B:3, C:2, D:1, E:0, F:0 }; // E treated as F on 4-pt

function filterLevel(val, btn) {
  lvlFilter = val;
  document.querySelectorAll('[id^="level-pill-"]').forEach(p => p.classList.remove('active'));
  if (btn) btn.classList.add('active');
  renderMatrix();
}
function filterSem(val, btn) {
  semFilter = val;
  document.querySelectorAll('[id^="sem-pill-"]').forEach(p => p.classList.remove('active'));
  if (btn) btn.classList.add('active');
  renderMatrix();
}

function renderMatrix() {
  const rows = document.querySelectorAll('.data-row');
  let shown = 0, units = 0, pts = 0;

  rows.forEach(r => {
    const lvl = r.dataset.level;
    const sem = r.dataset.semester;
    const ok  = (lvlFilter === 'all' || lvlFilter === lvl) &&
                (semFilter === 'all' || semFilter === sem);

    r.style.display = ok ? 'flex' : 'none';
    if (ok) {
      shown++;
      if (!r.classList.contains('is-hidden')) {
        const u = parseInt(r.dataset.units) || 0;
        const g = (r.dataset.grade || 'F').toUpperCase();
        const p = gpMap[g] !== undefined ? gpMap[g] : 0;
        units += u;
        pts   += p * u;
      }
    }
  });

  const termGPA = units > 0 ? (pts / units).toFixed(2) : '—';
  document.getElementById('term-gpa-badge').textContent = `GPA: ${termGPA}`;
  document.getElementById('matrix-count').textContent   = `${shown} shown`;

  const lvlLabel = lvlFilter === 'all' ? 'All Levels'  : `${lvlFilter}L`;
  const semLabel = semFilter === 'all' ? 'All Semesters': `Semester ${semFilter}`;
  document.getElementById('matrix-label').textContent = `${lvlLabel} · ${semLabel}`;
}

/* ── Chart.js grade distribution ─────────────── */
document.addEventListener('DOMContentLoaded', () => {
  renderMatrix();

  const ctx = document.getElementById('gradeChart');
  if (ctx) {
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: ['A','B','C','D','E','F'],
        datasets: [{
          data: [
            GRADE_COUNTS.A, GRADE_COUNTS.B, GRADE_COUNTS.C,
            GRADE_COUNTS.D, GRADE_COUNTS.E, GRADE_COUNTS.F
          ],
          backgroundColor: [
            'rgba(217,119,6,0.12)','rgba(37,99,235,0.12)','rgba(22,163,74,0.12)',
            'rgba(124,58,237,0.12)','rgba(71,85,105,0.12)','rgba(220,38,38,0.12)'
          ],
          borderColor: ['#d97706','#2563eb','#16a34a','#7c3aed','#475569','#dc2626'],
          borderWidth: 1.5, borderRadius: 6, borderSkipped: false
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false }, ticks: { font: { family: 'Clash Display', weight: '600' } } },
          y: { grid: { color: 'rgba(15,23,42,0.05)' }, ticks: { precision: 0 } }
        }
      }
    });
  }
});

/* ── PDF export ───────────────────────────────── */
document.getElementById('pdf-btn') && document.getElementById('pdf-btn').addEventListener('click', () => {
  html2pdf().set({
    margin: [12,10,12,10],
    filename: 'prepium_transcript.pdf',
    image: { type: 'jpeg', quality: 0.98 },
    html2canvas: { scale: 2, useCORS: true, scrollX: 0, scrollY: 0 },
    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
  }).from(document.getElementById('pdf-target')).save();
});
<% } %>
</script>
</body>
</html>
