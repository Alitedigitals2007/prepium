        <div style="display:flex;gap:8px;margin-top:10px">
            <button id="add-save-btn" onclick="addCourseAjax()" style="flex:1;padding:12px;border:none;background:linear-gradient(135deg,#0062ff,#003fcc);color:white;border-radius:10px;font-weight:700;font-size:0.82rem;cursor:pointer"><i class="fas fa-plus"></i> Save Course</button>
            <button id="add-save-another" onclick="addCourseAjax(true)" style="padding:12px 16px;border:1.5px solid var(--border);background:white;border-radius:10px;font-weight:700;font-size:0.78rem;cursor:pointer;color:var(--text-dark)"><i class="fas fa-plus-circle"></i> Add Another</button>
