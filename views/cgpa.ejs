<!-- â•â•â•â• ADD COURSE OVERLAY â•â•â•â• -->
<div class="overlay" id="ov-add">
<div class="ov-inner">
    <div class="ov-head">
        <div class="ov-title">Log a Course</div>
        <button class="ov-close btn-enhanced hover-lift" onclick="closeOv('ov-add')"><i class="fas fa-times"></i></button>
    </div>
    <div style="padding:20px">
        <div class="grid2">
            <div class="fg">
                <label>Course Code</label>
                <input type="text" id="add-code" placeholder="e.g. PHY301" required style="text-transform:uppercase;width:100%;padding:10px;border:1.5px solid #cbd5e1;border-radius:10px;font-family:inherit;font-weight:600;outline:none;box-sizing:border-box">
                <div id="add-code-warn" style="font-size:0.68rem;font-weight:600;margin-top:4px;display:none"></div>
            </div>
            <div class="fg">
                <label>Course Title</label>
                <input type="text" id="add-title" placeholder="e.g. Thermodynamics" style="width:100%;padding:10px;border:1.5px solid #cbd5e1;border-radius:10px;font-family:inherit;font-weight:600;outline:none;box-sizing:border-box">
            </div>
        </div>
        <div class="grid2">
            <div class="fg">
                <label>Level</label>
                <select id="add-level" style="width:100%;padding:10px;border:1.5px solid #cbd5e1;border-radius:10px;font-family:inherit;font-weight:600;outline:none;box-sizing:border-box">
                    <option value="100">100 Level</option>
                    <option value="200">200 Level</option>
                    <option value="300" selected>300 Level</option>
                    <option value="400">400 Level</option>
                    <option value="500">500 Level</option>
                </select>
            </div>
            <div class="fg">
                <label>Semester</label>
                <select id="add-sem" style="width:100%;padding:10px;border:1.5px solid #cbd5e1;border-radius:10px;font-family:inherit;font-weight:600;outline:none;box-sizing:border-box">
                    <option value="1" selected>1st Semester</option>
                    <option value="2">2nd Semester</option>
                </select>
            </div>
        </div>
        <div class="grid2">
            <div class="fg">
                <label>Credit Units</label>
                <input type="number" id="add-units" min="1" max="8" value="3" required style="width:100%;padding:10px;border:1.5px solid #cbd5e1;border-radius:10px;font-family:inherit;font-weight:600;outline:none;box-sizing:border-box">
            </div>
            <div class="fg">
                <label>Grade
                    <% if (hasProfile) { %>
                    <small style="text-transform:none;letter-spacing:0;color:var(--blue);">(<%= profile.grading_scale %>-pt)</small>
                    <% } %>
                </label>
                <select id="add-grade" required style="width:100%;padding:10px;border:1.5px solid #cbd5e1;border-radius:10px;font-family:inherit;font-weight:600;outline:none;box-sizing:border-box">
                    <% if (hasProfile && profile.grading_scale == 5) { %>
                        <option value="A">A — 5 pts</option>
                        <option value="B">B — 4 pts</option>
                        <option value="C">C — 3 pts</option>
                        <option value="D">D — 2 pts</option>
                        <option value="E">E — 1 pt</option>
                        <option value="F">F — 0 pts</option>
                    <% } else { %>
                        <option value="A">A — 4 pts</option>
                        <option value="B">B — 3 pts</option>
                        <option value="C">C — 2 pts</option>
                        <option value="D">D — 1 pt</option>
                        <option value="F">F — 0 pts</option>
                    <% } %>
                </select>
            </div>
        </div>
        
        <!-- CSV Import Section -->
        <div style="margin: 20px 0; padding: 15px; border: 1px dashed var(--border); border-radius: var(--radius); background: var(--bg);">
            <div class="fg">
                <label>Add Multiple Courses (CSV)</label>
                <small style="color: var(--text-sub); display: block; margin-bottom: 8px;">
                    Format: Course Code,Course Title,Units,Grade,Level,Semester (one per line)<br/>
                    Example: CSC101,Intro to CS,3,A,300,1
                </small>
                <textarea id="csv-import-data" rows="4" style="width:100%;padding:10px;border:1.5px solid var(--border-solid);border-radius:var(--radius);font-family:monospace;font-size:0.75rem;resize:vertical;" placeholder="CSC101,Intro to CS,3,A,300,1&#10;MTH101,Calculus,4,B,300,2"></textarea>
            </div>
            <div style="margin-top: 12px;">
                <button id="csv-import-btn" onclick="importCoursesCSV()" style="width:100%;padding:12px;border:none;background:linear-gradient(135deg,#10b981,#059669);color:white;border-radius:10px;font-weight:700;font-size:0.82rem;cursor:pointer" class="btn-enhanced btn-shine hover-lift">
                    <i class="fas fa-file-csv"></i> Import Courses from CSV
                </button>
            </div>
        </div>
        
        <div id="add-loading" style="display:none;text-align:center;padding:8px;color:#475569;font-weight:600"><i class="fas fa-spinner fa-spin"></i> Saving...</div>
        <div id="add-error" style="display:none;font-size:0.75rem;color:var(--danger);font-weight:600;margin:4px 0 8px;padding:8px 10px;background:var(--danger-soft);border-radius:8px"></div>
        <div id="add-success" style="display:none;font-size:0.75rem;color:var(--success);font-weight:600;margin:4px 0 8px;padding:8px 10px;background:var(--success-soft);border-radius:8px"></div>
        <div style="display:flex;gap:8px;margin-top:10px">
            <button id="add-save-btn" onclick="addCourseAjax()" style="flex:1;padding:12px;border:none;background:linear-gradient(135deg,#2563eb,#1d4ed8);color:white;border-radius:10px;font-weight:700;font-size:0.82rem;cursor:pointer" class="btn-enhanced btn-shine hover-lift"><i class="fas fa-plus"></i> Save Course</button>
            <button id="add-save-another" onclick="addCourseAjax(true)" style="padding:12px 16px;border:1.5px solid var(--border);background:var(--surface-solid);border-radius:10px;font-weight:700;font-size:0.78rem;cursor:pointer;color:var(--text-dark)" class="btn-enhanced hover-lift"><i class="fas fa-plus-circle"></i> Add Another</button>
        </div>
    </div>
</div>
</div>

<script>
var addCourseCodes = [];
<% if (typeof courses !== 'undefined' && courses && courses.length > 0) { %>
<% courses.forEach(function(c) { %>
addCourseCodes.push('<%= c.code ? c.code.toUpperCase().replace(/'/g, "\\'") : "" %>');
<% }); } %>

document.addEventListener('DOMContentLoaded', function() {
    var codeInput = document.getElementById('add-code');
    if (codeInput) {
        codeInput.addEventListener('input', function() {
            var val = this.value.trim().toUpperCase();
            var warn = document.getElementById('add-code-warn');
            if (addCourseCodes.indexOf(val) >= 0) {
                warn.style.display = 'block';
                warn.style.color = '#d97706';
                warn.innerHTML = '<i class="fas fa-exclamation-triangle"></i> This course already exists. It will be skipped.';
            } else {
                warn.style.display = 'none';
            }
        });
    }
});

function addCourseAjax(keepOpen) {
    var code = document.getElementById('add-code').value.trim().toUpperCase();
    var title = document.getElementById('add-title').value.trim() || code;
    var level = document.getElementById('add-level').value;
    var sem = document.getElementById('add-sem').value;
    var units = parseInt(document.getElementById('add-units').value) || 3;
    var grade = document.getElementById('add-grade').value;
    if (!code) { return showAddError('Enter a course code.'); }
    if (units < 1 || units > 8) { return showAddError('Units must be 1-8.'); }
    document.getElementById('add-loading').style.display = 'block';
    document.getElementById('add-error').style.display = 'none';
    document.getElementById('add-save-btn').disabled = true;
    document.getElementById('add-save-another').disabled = true;
    document.getElementById('add-code-warn').style.display = 'none';
    fetch('/api/cgpa/course/add-ajax', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: code, title: title, level_scope: level, semester: sem, credit_units: units, grade: grade })
    }).then(function(r){ return r.json(); }).then(function(d) {
        document.getElementById('add-loading').style.display = 'none';
        document.getElementById('add-save-btn').disabled = false;
        document.getElementById('add-save-another').disabled = false;
        if (d && d.success) {
            if (d.duplicate) {
                showAddError('Course already exists (skipped).');
            } else {
                if (keepOpen) {
                    document.getElementById('add-code').value = '';
                    document.getElementById('add-title').value = '';
                    document.getElementById('add-grade').selectedIndex = 0;
                    document.getElementById('add-code').focus();
                    showAddError('');
                    document.getElementById('add-error').style.display = 'none';
                    showAddSuccess('Course added! Add another.');
                } else {
                    closeOv('ov-add');
                    Swal.fire({ icon: 'success', title: 'Course Added', text: code + ' was added successfully.', timer: 1500, showConfirmButton: false });
                    setTimeout(function(){ location.reload(); }, 1500);
                }
            }
        } else {
            showAddError((d && d.error) ? d.error : 'Could not add course.');
        }
    }).catch(function(err) {
        document.getElementById('add-loading').style.display = 'none';
        document.getElementById('add-save-btn').disabled = false;
        document.getElementById('add-save-another').disabled = false;
        showAddError('Network error: ' + (err.message || ''));
    });
}

function showAddError(msg) {
    var box = document.getElementById('add-error');
    if (msg) { box.style.display = 'block'; box.innerHTML = '<i class="fas fa-times-circle"></i> ' + msg; }
    else box.style.display = 'none';
}

function showAddSuccess(msg) {
    var box = document.getElementById('add-error');
    box.style.display = 'block';
    box.style.color = '#16a34a';
    box.style.background = 'var(--success-soft)';
    box.innerHTML = '<i class="fas fa-check-circle"></i> ' + msg;
}

function importCoursesCSV() {
    var csvData = document.getElementById('csv-import-data').value.trim();
    if (!csvData) {
        showAddError('Please enter CSV data to import.');
        return;
    }
    
    document.getElementById('add-loading').style.display = 'block';
    document.getElementById('add-error').style.display = 'none';
    document.getElementById('csv-import-btn').disabled = true;
    
    fetch('/api/cgpa/course/import-csv', {
        method: 'POST',
        credentials: 'include',
        headers: { 
            'Content-Type': 'application/json',
            'Accept': 'application/json'
        },
        body: JSON.stringify({ csv: csvData })
    }).then(function(r){ 
        if (!r.ok) {
            throw new Error('Server responded with status ' + r.status);
        }
        return r.json(); 
    }).then(function(d) {
        document.getElementById('add-loading').style.display = 'none';
        document.getElementById('csv-import-btn').disabled = false;
        
        if (d && d.success) {
            var imported = d.imported || 0;
            var skipped = d.skipped || 0;
            var message = 'Successfully imported ' + imported + ' course(s)';
            if (skipped > 0) {
                message += ' (' + skipped + ' skipped - may be duplicates or invalid)';
            }
            
            // Clear the textarea
            document.getElementById('csv-import-data').value = '';
            
            showAddSuccess(message);
            
            // Reload the page to show the newly added courses
            setTimeout(function(){ location.reload(); }, 1500);
        } else {
            showAddError((d && d.error) ? d.error : 'Could not import courses.');
        }
    }).catch(function(err) {
        document.getElementById('add-loading').style.display = 'none';
        document.getElementById('csv-import-btn').disabled = false;
        showAddError('Network error: ' + (err.message || ''));
    });
}
</script>

