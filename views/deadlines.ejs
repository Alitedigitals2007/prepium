<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Deadlines</title>
    <%- include('partials/design-head') %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --dash-bg: #f0f2f8;
            --card-bg: rgba(255,255,255,0.85);
        }
        body { background: var(--dash-bg); }
        body::before { display: none; }
        .app-shell { background: transparent; backdrop-filter: none; border: none; padding-bottom: 100px; }

        .page-header { padding: 1.25rem 1.25rem 0.5rem; display: flex; align-items: center; justify-content: space-between; }
        .page-header h1 { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.5px; margin: 0; }
        .page-header p { font-size: 0.7rem; color: var(--text-sub); font-weight: 600; margin: 2px 0 0; }

        .add-card { margin: 1rem 1.25rem; background: white; border-radius: 20px; padding: 18px; border: 1px solid rgba(226,232,240,0.5); box-shadow: var(--shadow-sm, 0 2px 12px rgba(0,0,0,0.04)); }
        .add-card h2 { font-size: 0.95rem; font-weight: 800; margin: 0 0 4px; }
        .add-card .sub { font-size: 0.7rem; color: var(--text-sub); font-weight: 600; margin-bottom: 14px; }

        .form-row { display: flex; gap: 8px; margin-bottom: 10px; }
        .form-input {
            flex: 1; padding: 12px 14px; border-radius: 12px; border: 1.5px solid #e2e8f0;
            font-family: inherit; font-size: 0.85rem; font-weight: 600; background: #f8fafc; outline: none;
        }
        .form-input:focus { border-color: var(--brand); background: white; }

        .btn-primary { width: 100%; padding: 13px; border-radius: 12px; border: none; background: var(--brand-gradient, linear-gradient(135deg,#0062ff,#4f46e5)); color: white; font-weight: 800; font-size: 0.85rem; cursor: pointer; box-shadow: 0 4px 14px rgba(0,98,255,0.25); }

        .deadline-list { padding: 0 1.25rem; display: flex; flex-direction: column; gap: 10px; }
        .deadline-card {
            background: white; border-radius: 18px; padding: 14px; border: 1.5px solid var(--border, #e2e8f0);
            display: flex; align-items: center; gap: 14px; box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,0.04));
        }
        .deadline-card.urgent { border-left: 4px solid #ef4444; }
        .deadline-card.upcoming { border-left: 4px solid #f59e0b; }
        .deadline-card.future { border-left: 4px solid #10b981; }
        .deadline-card.expired { opacity: 0.6; border-left: 4px solid #94a3b8; }

        .date-block {
            width: 60px; flex-shrink: 0; text-align: center; background: #f8fafc;
            border-radius: 14px; padding: 10px 4px;
        }
        .date-block .month { font-size: 0.65rem; font-weight: 800; color: var(--brand); text-transform: uppercase; }
        .date-block .day { font-size: 1.3rem; font-weight: 800; color: var(--text-dark, #0f172a); line-height: 1.1; }
        .date-block .time { font-size: 0.55rem; font-weight: 700; color: var(--text-sub); margin-top: 4px; }

        .deadline-body { flex: 1; min-width: 0; }
        .deadline-title { font-weight: 800; font-size: 0.9rem; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .deadline-meta { display: flex; align-items: center; gap: 8px; margin-top: 3px; }
        .deadline-meta small { font-size: 0.65rem; color: var(--text-sub); font-weight: 600; }
        .status-pill { font-size: 0.58rem; font-weight: 800; padding: 3px 8px; border-radius: 8px; text-transform: uppercase; letter-spacing: 0.3px; }
        .status-pill.urgent { background: #fee2e2; color: #b91c1c; }
        .status-pill.upcoming { background: #fef3c7; color: #b45309; }
        .status-pill.future { background: #dcfce7; color: #15803d; }
        .status-pill.expired { background: #f1f5f9; color: #64748b; }

        .del-btn {
            background: transparent; border: none; color: #ef4444; cursor: pointer; padding: 8px;
            border-radius: 10px; font-size: 0.85rem;
        }
        .del-btn:hover { background: #fee2e2; }

        .countdown { font-size: 0.6rem; font-weight: 800; display: flex; align-items: center; gap: 4px; margin-top: 4px; }
        .countdown .cd-num { background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-variant-numeric: tabular-nums; color: #0f172a; }
        .countdown .cd-lbl { font-size: 0.5rem; color: #94a3b8; text-transform: uppercase; margin-right: 2px; }
        .countdown .cd-sep { color: #cbd5e1; font-weight: 300; }
        .countdown.urgent .cd-num { background: #fee2e2; color: #b91c1c; }
        .countdown.expired { color: #94a3b8; }

        .empty-state {
            text-align: center; padding: 3rem 1.5rem; color: var(--text-sub);
        }
        .empty-state i { font-size: 2.5rem; color: #cbd5e1; display: block; margin-bottom: 1rem; }
        .empty-state h3 { font-size: 1rem; font-weight: 800; margin: 0 0 4px; color: var(--text-dark, #0f172a); }
        .empty-state p { font-size: 0.78rem; margin: 0; }

        .message {
            margin: 0 1.25rem 1rem; padding: 12px 16px; border-radius: 14px;
            font-size: 0.78rem; font-weight: 700; text-align: center;
        }
        .message.error { background: #fee2e2; color: #b91c1c; }
        .msg-success { background: #dcfce7; color: #15803d; }
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="page-header">
        <div>
            <h1>Deadlines</h1>
            <p>Stay on top of every assignment and exam</p>
        </div>
    </div>

    <div class="add-card">
        <h2>Add a Deadline</h2>
        <div class="sub">Set a date and time, we'll remind you ahead of it.</div>
        <form action="/deadlines/add" method="POST" id="deadlineForm">
            <div class="form-row">
                <input type="text" name="title" class="form-input" placeholder="e.g. Physics Assignment" required maxlength="120">
            </div>
            <div class="form-row">
                <input type="date" name="due_date" class="form-input" required>
                <input type="time" name="due_time" class="form-input" required>
            </div>
            <button type="submit" class="btn-primary"><i class="fas fa-plus"></i> &nbsp;Add Deadline</button>
        </form>
    </div>

    <%
        var todayStr = new Date().toISOString().split('T')[0];
        var hasItems = typeof deadlines !== 'undefined' && deadlines && deadlines.length > 0;
        var queryData = typeof query !== 'undefined' && query ? query : {};
        var errorMsg = queryData.error ? queryData.error : null;
    %>

    <% if (errorMsg) { %>
        <div class="message error"><%= errorMsg %></div>
    <% } %>

    <div class="deadline-list" id="deadlineList">
        <% if (!user.has_paid) { %>
            <div class="empty-state">
                <i class="fas fa-crown"></i>
                <h3>Premium feature</h3>
                <p>Upgrade to add and track unlimited deadlines.</p>
                <a href="/dashboard" class="btn-primary" style="display:inline-block;margin-top:14px;text-decoration:none;width:auto;padding:11px 22px;">Upgrade Now</a>
            </div>
        <% } else if (hasItems) { %>
            <% deadlines.forEach(function(d) {
                var dateStr = d.date_str || '';
                var timeStr = d.time_str || '23:59';
                var dueDate = new Date(dateStr + 'T' + timeStr);
                var now = new Date();
                var diffMs = dueDate.getTime() - now.getTime();
                var diffHours = diffMs / (1000 * 60 * 60);
                var status = 'future';
                var label = 'Upcoming';
                if (diffMs < 0) { status = 'expired'; label = 'Expired'; }
                else if (diffHours < 24) { status = 'urgent'; label = 'Due Today'; }
                else if (diffHours < 72) { status = 'upcoming'; label = 'This Week'; }

                var monthNames = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
                var parts = dateStr.split('-');
                var dayNum = parts.length === 3 ? parseInt(parts[2], 10) : '';
                var monthTxt = parts.length === 3 ? monthNames[(parseInt(parts[1], 10) || 1) - 1] : '';
            %>
                <div class="deadline-card <%= status %>" data-id="<%= d.id %>">
                    <div class="date-block">
                        <div class="month"><%= monthTxt %></div>
                        <div class="day"><%= dayNum %></div>
                        <div class="time"><%= timeStr %></div>
                    </div>
                    <div class="deadline-body">
                        <p class="deadline-title"><%= d.title %></p>
                        <div class="deadline-meta">
                            <span class="status-pill <%= status %>"><%= label %></span>
                            <small><%= dateStr %></small>
                        </div>
                        <div class="countdown <%= status %>" data-due="<%= dateStr %>T<%= timeStr %>"></div>
                    </div>
                    <form action="/deadlines/delete/<%= d.id %>" method="POST" style="margin:0;">
                        <button type="submit" class="del-btn" onclick="return confirm('Delete this deadline?');" title="Delete">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </form>
                </div>
            <% }); %>
        <% } else { %>
            <div class="empty-state">
                <i class="fas fa-hourglass-half"></i>
                <h3>No deadlines yet</h3>
                <p>Add your first one above to get started.</p>
            </div>
        <% } %>
    </div>

    <%- include('partials/bottom-nav', { activeNav: 'deadlines' }) %>
</div>

<script>
(function() {
    var params = new URLSearchParams(window.location.search);
    var msg = params.get('msg');
    var err = params.get('error');
    if (err) {
        Swal.fire({ icon: 'error', title: 'Error', text: err, timer: 3000, showConfirmButton: false });
        window.history.replaceState({}, document.title, '/deadlines');
    } else if (msg) {
        Swal.fire({ icon: 'success', title: msg, timer: 2200, showConfirmButton: false });
        window.history.replaceState({}, document.title, '/deadlines');
    }

    var dateInput = document.querySelector('input[name="due_date"]');
    if (dateInput && !dateInput.value) {
        var d = new Date();
        dateInput.value = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }
    var timeInput = document.querySelector('input[name="due_time"]');
    if (timeInput && !timeInput.value) timeInput.value = '09:00';

    /* ── Countdown Timer ── */
    function updateCountdowns() {
        document.querySelectorAll('.countdown').forEach(function(el) {
            var dueStr = el.getAttribute('data-due');
            if (!dueStr) return;
            var due = new Date(dueStr);
            var now = new Date();
            var diff = due.getTime() - now.getTime();

            if (diff <= 0) {
                el.innerHTML = '<span style="color:#94a3b8">Past due</span>';
                el.className = 'countdown expired';
                return;
            }

            var days = Math.floor(diff / 86400000);
            var hours = Math.floor((diff % 86400000) / 3600000);
            var mins = Math.floor((diff % 3600000) / 60000);
            var secs = Math.floor((diff % 60000) / 1000);

            var parts = [];
            if (days > 0) parts.push('<span class="cd-num">' + days + '</span><span class="cd-lbl">d</span>');
            parts.push('<span class="cd-num">' + String(hours).padStart(2,'0') + '</span><span class="cd-lbl">h</span>');
            parts.push('<span class="cd-sep">:</span>');
            parts.push('<span class="cd-num">' + String(mins).padStart(2,'0') + '</span><span class="cd-lbl">m</span>');
            parts.push('<span class="cd-sep">:</span>');
            parts.push('<span class="cd-num">' + String(secs).padStart(2,'0') + '</span><span class="cd-lbl">s</span>');

            el.innerHTML = '<i class="far fa-clock" style="font-size:0.55rem;opacity:0.5"></i> ' + parts.join('');
        });
    }

    updateCountdowns();
    setInterval(updateCountdowns, 1000);
})();
</script>
</body>
</html>
