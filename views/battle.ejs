<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        body::before { display: none; }
        .app-shell { background: transparent; backdrop-filter: none; border: none; padding-bottom: 100px; }

        .bt-header { padding: 1.25rem 1.25rem 0.75rem; display: flex; align-items: center; gap: 12px; }
        .bt-logo { width: 46px; height: 46px; border-radius: 14px; background: linear-gradient(135deg,#8b5cf6,#d946ef); color: white; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; box-shadow: 0 4px 14px rgba(139,92,246,0.3); }
        .bt-title { font-size: 1.15rem; font-weight: 800; }
        .bt-sub { font-size: 0.62rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; }

        .bt-card { margin: 0 1.25rem 1rem; background: var(--surface-solid); border: 1px solid var(--border); border-radius: 18px; padding: 18px; box-shadow: var(--shadow-sm); }
        .bt-label { font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--text-secondary); margin-bottom: 8px; }
        .bt-select, .bt-input { width: 100%; padding: 12px 14px; border: 1.5px solid var(--border-solid); border-radius: 12px; background: var(--bg); font-family: inherit; font-size: 0.85rem; font-weight: 600; color: var(--text-primary); outline: none; margin-bottom: 10px; }
        .bt-select:focus, .bt-input:focus { border-color: #8b5cf6; box-shadow: 0 0 0 3px rgba(139,92,246,0.15); }
        .bt-input { text-transform: uppercase; }

        .btn-battle { width: 100%; padding: 14px; border: none; border-radius: 14px; background: linear-gradient(135deg,#8b5cf6,#d946ef); color: white; font-weight: 800; font-size: 0.9rem; cursor: pointer; font-family: inherit; box-shadow: 0 6px 18px rgba(139,92,246,0.3); }
        .btn-battle:active { transform: scale(0.97); }
        .btn-battle:disabled { opacity: 0.55; cursor: not-allowed; }

        /* Lobby */
        .lobby { text-align: center; padding: 28px 20px; }
        .lobby .pulse-dot { width: 14px; height: 14px; border-radius: 50%; background: #8b5cf6; margin: 0 auto 12px; animation: pulse 1.2s infinite; }
        @keyframes pulse { 0%,100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.6); opacity: 0.4; } }
        .lobby h3 { font-size: 1.05rem; font-weight: 800; margin-bottom: 4px; }
        .lobby p { font-size: 0.75rem; color: var(--text-secondary); font-weight: 500; line-height: 1.5; }
        .lobby .code-big { display: inline-block; margin-top: 12px; padding: 12px 22px; font-size: 1.3rem; font-weight: 800; letter-spacing: 4px; background: var(--brand-soft); color: var(--brand); border-radius: 12px; }
        .lobby .opponent-box { margin-top: 16px; padding: 12px; border: 1px dashed var(--border-solid); border-radius: 12px; font-size: 0.75rem; color: var(--text-secondary); font-weight: 700; }

        /* Battle screen */
        .vs-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
        .vs-player { flex: 1; text-align: center; }
        .vs-player .vp-name { font-size: 0.75rem; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .vs-player .vp-score { font-size: 1.2rem; font-weight: 800; color: var(--brand); }
        .vs-middle { font-size: 0.72rem; font-weight: 800; color: var(--text-secondary); }
        .vs-you { color: var(--warning); font-size: 0.6rem; font-weight: 800; }

        .timer-wrap { height: 8px; background: var(--surface); border-radius: 99px; overflow: hidden; margin-bottom: 16px; }
        .timer-bar { height: 100%; width: 100%; background: linear-gradient(90deg,#8b5cf6,#d946ef); border-radius: 99px; transition: width 1s linear; }

        .bq-count { font-size: 0.66rem; font-weight: 800; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; }
        .bq-text { font-size: 1.05rem; font-weight: 800; line-height: 1.5; margin-bottom: 16px; min-height: 60px; }
        .b-opt { width: 100%; text-align: left; padding: 13px 14px; margin-bottom: 10px; border: 1.5px solid var(--border-solid); border-radius: 14px; background: var(--surface-solid); color: var(--text-primary); font-family: inherit; font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: all 0.15s; }
        .b-opt:hover { border-color: #8b5cf6; }
        .b-opt.sel { border-color: #8b5cf6; background: rgba(139,92,246,0.12); }
        .b-opt.correct { border-color: var(--success); background: var(--success-soft); color: var(--success); }
        .b-opt.wrong { border-color: #ef4444; background: rgba(239,68,68,0.1); color: #ef4444; }
        .b-opt:disabled { cursor: default; }

        /* Result */
        .result { text-align: center; padding: 26px 16px; }
        .result .res-icon { font-size: 2.6rem; margin-bottom: 10px; }
        .result h2 { font-size: 1.3rem; font-weight: 800; margin-bottom: 4px; }
        .result .res-sub { font-size: 0.78rem; color: var(--text-secondary); font-weight: 600; margin-bottom: 18px; }
        .res-scores { display: flex; justify-content: center; gap: 26px; margin-bottom: 18px; }
        .res-score { padding: 14px 22px; border-radius: 14px; background: var(--surface); border: 1px solid var(--border); }
        .res-score .rs-n { font-size: 1.5rem; font-weight: 800; color: var(--brand); }
        .res-score .rs-l { font-size: 0.65rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; }

        .hidden { display: none !important; }
        @media (min-width: 1024px) { .app-shell { max-width: 720px; margin: 0 auto; padding: 24px; } }
        @media (prefers-reduced-motion: reduce) { .pulse-dot { animation: none; } }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">

    <div class="bt-header">
        <div class="bt-logo"><i class="fas fa-bolt"></i></div>
        <div>
            <div class="bt-title">Live Battle Mode</div>
            <div class="bt-sub">Head-to-head quiz duels</div>
        </div>
    </div>

    <!-- Lobby: setup -->
    <div class="bt-card" id="setupCard">
        <div class="bt-label">Subject</div>
        <select class="bt-select" id="subjectSel">
            <% subjects.forEach(function(s) { %>
            <option value="<%= s.id %>"><%= s.name %></option>
            <% }); %>
        </select>
        <div class="bt-label">Questions</div>
        <select class="bt-select" id="qCountSel">
            <option value="3">Quick — 3 questions</option>
            <option value="5" selected>Standard — 5 questions</option>
            <option value="10">Long — 10 questions</option>
        </select>
        <button class="btn-battle" id="startBtn" onclick="startBattle()"><i class="fas fa-swords"></i> Find Opponent</button>

        <div style="display:flex;align-items:center;gap:10px;margin:16px 0 8px;">
            <div style="flex:1;height:1px;background:var(--border-solid);"></div>
            <span style="font-size:0.65rem;font-weight:800;color:var(--text-muted);text-transform:uppercase;">or battle a friend</span>
            <div style="flex:1;height:1px;background:var(--border-solid);"></div>
        </div>

        <input class="bt-input" id="joinCode" placeholder="Invite code (e.g. ABC123)" maxlength="8">
        <button class="btn-battle" style="background:linear-gradient(135deg,#0ea5e9,#06b6d4);" onclick="joinBattle()"><i class="fas fa-sign-in-alt"></i> Join Battle</button>
    </div>

    <!-- Lobby: waiting for opponent -->
    <div class="bt-card hidden" id="waitCard">
        <div class="lobby">
            <div class="pulse-dot"></div>
            <h3>Waiting for an opponent…</h3>
            <p>Share your battle code so a friend can join instantly.</p>
            <div class="code-big" id="waitCode">------</div>
            <div class="opponent-box" id="waitOpp">No opponent yet — keep the tab open</div>
            <button class="btn-battle" style="margin-top:18px;background:var(--surface-solid);color:#ef4444;border:1.5px solid rgba(239,68,68,0.3);box-shadow:none;" onclick="leaveBattle()">Cancel Battle</button>
        </div>
    </div>

    <!-- Playing -->
    <div class="bt-card hidden" id="playCard">
        <div class="vs-row">
            <div class="vs-player">
                <div class="vp-score" id="myScore">0</div>
                <div class="vp-name"><span class="vs-you">YOU</span><br><span id="myName">…</span></div>
            </div>
            <div class="vs-middle">VS</div>
            <div class="vs-player">
                <div class="vp-score" id="oppScore">0</div>
                <div class="vp-name"><span id="oppName">…</span></div>
            </div>
        </div>
        <div class="timer-wrap"><div class="timer-bar" id="timerBar"></div></div>
        <div class="bq-count" id="qCount">Question 1</div>
        <div class="bq-text" id="qText">Loading…</div>
        <div id="optWrap"></div>
    </div>

    <!-- Result -->
    <div class="bt-card hidden" id="resultCard">
        <div class="result">
            <div class="res-icon" id="resIcon">🏆</div>
            <h2 id="resTitle">You Win!</h2>
            <div class="res-sub" id="resSub">Great battle!</div>
            <div class="res-scores">
                <div class="res-score"><div class="rs-n" id="resYou">0</div><div class="rs-l">You</div></div>
                <div class="res-score"><div class="rs-n" id="resOpp">0</div><div class="rs-l">Opponent</div></div>
            </div>
            <button class="btn-battle" onclick="resetBattle()"><i class="fas fa-redo"></i> Battle Again</button>
        </div>
    </div>

</div>

<script src="/js/animations.js"></script>
<script>
    var battleId = null;
    var pollTimer = null;
    var answered = {};
    var lastQuestion = -1;

    function setPhase(phase) {
        document.getElementById('setupCard').classList.toggle('hidden', phase !== 'setup');
        document.getElementById('waitCard').classList.toggle('hidden', phase !== 'wait');
        document.getElementById('playCard').classList.toggle('hidden', phase !== 'play');
        document.getElementById('resultCard').classList.toggle('hidden', phase !== 'result');
    }

    function startBattle() {
        var subjectId = document.getElementById('subjectSel').value;
        var qCount = document.getElementById('qCountSel').value;
        fetch('/api/battle/start', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subject_id: subjectId, q_count: qCount })
        }).then(function(r) { return r.json(); }).then(function(d) {
            if (!d.success) { alert(d.error || 'Failed'); return; }
            battleId = d.battle_id;
            if (d.waiting) {
                document.getElementById('waitCode').textContent = d.invite_code;
                setPhase('wait');
                startPolling();
            } else {
                setPhase('play');
                startPolling();
            }
        });
    }

    function joinBattle() {
        var code = document.getElementById('joinCode').value.trim();
        if (!code) { alert('Enter the invite code'); return; }
        fetch('/api/battle/join', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code: code })
        }).then(function(r) { return r.json(); }).then(function(d) {
            if (!d.success) { alert(d.error || 'No open battle with that code'); return; }
            battleId = d.battle_id;
            setPhase('play');
            startPolling();
        });
    }

    function leaveBattle() {
        if (battleId) fetch('/api/battle/leave/' + battleId, { method: 'POST' });
        stopPolling(); battleId = null; setPhase('setup');
    }

    function startPolling() { stopPolling(); pollTimer = setInterval(poll, 1200); poll(); }
    function stopPolling() { if (pollTimer) { clearInterval(pollTimer); pollTimer = null; } }

    function poll() {
        if (!battleId) return;
        fetch('/api/battle/state/' + battleId).then(function(r) { return r.json(); }).then(function(s) {
            if (!s.success) { alert(s.error); stopPolling(); setPhase('setup'); return; }

            if (s.phase === 'lobby') {
                setPhase('wait');
                document.getElementById('waitCode').textContent = s.invite_code || '------';
                document.getElementById('waitOpp').textContent = s.opponentJoined ? s.opponent + ' joined!' : 'No opponent yet — keep the tab open';
                if (s.opponentJoined) { setPhase('play'); lastQuestion = -1; }
                return;
            }

            if (s.phase === 'result') {
                stopPolling();
                document.getElementById('resYou').textContent = s.myScore;
                document.getElementById('resOpp').textContent = s.oppScore;
                if (s.draw) { document.getElementById('resIcon').textContent = '🤝'; document.getElementById('resTitle').textContent = "It's a Draw!"; document.getElementById('resSub').textContent = 'Equal scores — rematch?'; }
                else if (s.won) { document.getElementById('resIcon').textContent = '🏆'; document.getElementById('resTitle').textContent = 'You Win!'; document.getElementById('resSub').textContent = '+10 coins added to your account'; }
                else { document.getElementById('resIcon').textContent = '💪'; document.getElementById('resTitle').textContent = 'You Lost'; document.getElementById('resSub').textContent = 'Close one — battle again!'; }
                setPhase('result');
                return;
            }

            // playing
            setPhase('play');
            document.getElementById('myScore').textContent = s.myCorrect;
            document.getElementById('oppScore').textContent = s.oppCorrect;
            document.getElementById('myName').textContent = s.me;
            document.getElementById('oppName').textContent = s.opponent;
            document.getElementById('qCount').textContent = 'Question ' + (s.questionIndex + 1) + ' of ' + s.qCount;

            if (s.questionIndex !== lastQuestion) {
                lastQuestion = s.questionIndex;
                answered = {};
                var q = s.question;
                document.getElementById('qText').textContent = q ? q.question : '…';
                var wrap = document.getElementById('optWrap');
                wrap.innerHTML = '';
                if (q) {
                    q.options.forEach(function(opt, i) {
                        if (!opt) return;
                        var b = document.createElement('button');
                        b.className = 'b-opt';
                        b.textContent = String.fromCharCode(65 + i) + '.  ' + opt;
                        b.onclick = function() { submitAnswer(i); };
                        wrap.appendChild(b);
                    });
                }
            }
            // timer
            var t = document.getElementById('timerBar');
            t.style.transition = 'none';
            t.style.width = '100%';
            void t.offsetWidth;
            t.style.transition = 'width 1s linear';
            t.style.width = (s.timeLeft * 5) + '%';
        }).catch(function() {});
    }

    function submitAnswer(i) {
        if (!battleId || answered[i]) return;
        answered[i] = true;
        var opts = document.querySelectorAll('#optWrap .b-opt');
        opts.forEach(function(b, idx) { if (idx === i) b.classList.add('sel'); });
        fetch('/api/battle/answer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ battle_id: battleId, question_index: lastQuestion, answer: String.fromCharCode(65 + i) })
        });
    }

    function resetBattle() { stopPolling(); battleId = null; lastQuestion = -1; answered = {}; setPhase('setup'); }
</script>
</body>
</html>