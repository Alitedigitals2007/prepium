<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Focus Engine | Prepium</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .header-nav { padding: 1.5rem 1.5rem 1rem; }
        .logo { font-weight: 800; font-size: 1.2rem; letter-spacing: -1px; color: var(--text-dark); text-decoration: none; }
        .logo span { color: var(--brand); }
        .premium-badge {
            background: linear-gradient(135deg, #0062ff, #4f46e5);
            padding: 6px 14px; border-radius: 10px;
            color: white; font-weight: 800; font-size: 0.65rem;
            letter-spacing: 0.5px;
        }
        .stats-row {
            display: flex; gap: 10px; padding: 0.75rem 1.5rem;
        }
        .stat-chip {
            flex: 1; background: rgba(255,255,255,0.7);
            border: 1px solid rgba(255,255,255,0.8);
            border-radius: 16px; padding: 12px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }
        .stat-chip .stat-num {
            font-size: 1.4rem; font-weight: 800; color: var(--brand);
            display: block; line-height: 1;
        }
        .stat-chip .stat-label {
            font-size: 0.6rem; font-weight: 700; color: var(--text-sub);
            text-transform: uppercase; letter-spacing: 0.5px; margin-top: 4px;
            display: block;
        }
        .timer-section {
            padding: 1rem 1.5rem;
            display: flex; justify-content: center;
        }
        .timer-ring-container {
            position: relative;
            width: 260px; height: 260px;
        }
        .timer-ring { width: 100%; height: 100%; transform: rotate(-90deg); }
        .timer-ring-bg { fill: none; stroke: #e2e8f0; stroke-width: 8; }
        .timer-ring-progress {
            fill: none; stroke: url(#timerGradient); stroke-width: 8;
            stroke-linecap: round; stroke-dasharray: 754; stroke-dashoffset: 0;
            transition: stroke-dashoffset 1s linear;
        }
        .timer-center {
            position: absolute; top: 50%; left: 50%;
            transform: translate(-50%, -50%); text-align: center;
        }
        .timer-display {
            font-size: 3.5rem; font-weight: 800; color: var(--text-dark);
            letter-spacing: -2px; line-height: 1;
        }
        .timer-label {
            font-size: 0.7rem; font-weight: 700; color: var(--text-sub);
            text-transform: uppercase; letter-spacing: 1px; margin-top: 4px;
        }
        .timer-mode-indicator {
            display: inline-flex; align-items: center; gap: 6px;
            background: rgba(0, 98, 255, 0.08);
            padding: 4px 12px; border-radius: 20px;
            font-size: 0.65rem; font-weight: 700; color: var(--brand);
            margin-top: 8px;
        }
        .mode-tabs {
            display: flex; gap: 8px; padding: 0 1.5rem; margin-bottom: 1rem;
        }
        .mode-btn {
            flex: 1; padding: 12px 8px; border-radius: 14px; border: none;
            font-weight: 700; font-size: 0.7rem; cursor: pointer;
            background: rgba(255,255,255,0.7); color: var(--text-sub);
            border: 1px solid rgba(255,255,255,0.8);
            transition: all 0.3s ease;
            text-transform: uppercase; letter-spacing: 0.5px;
        }
        .mode-btn.active {
            background: var(--brand-gradient); color: white;
            box-shadow: 0 4px 16px rgba(0, 98, 255, 0.25);
            border-color: transparent;
        }
        .controls {
            display: flex; gap: 12px; justify-content: center;
            padding: 0 1.5rem; margin-bottom: 1.5rem;
        }
        .btn-action {
            padding: 16px; border-radius: 18px; border: none;
            font-weight: 800; font-size: 0.9rem; cursor: pointer;
            transition: all 0.3s ease;
        }
        .btn-play {
            flex: 2; background: var(--brand-gradient); color: white;
            box-shadow: 0 8px 24px rgba(0, 98, 255, 0.25);
            display: flex; align-items: center; justify-content: center; gap: 10px;
        }
        .btn-play:active { transform: scale(0.97); }
        .btn-reset {
            flex: 0.8; background: rgba(255,255,255,0.8); color: var(--text-dark);
            border: 1px solid var(--border);
            display: flex; align-items: center; justify-content: center;
        }
        .btn-skip {
            flex: 0.8; background: rgba(255,255,255,0.8); color: var(--brand);
            border: 1px solid rgba(0, 98, 255, 0.15);
            display: flex; align-items: center; justify-content: center;
        }
        .motivation-card {
            margin: 0 1.5rem 1.5rem; padding: 18px 20px;
            background: linear-gradient(135deg, rgba(0, 98, 255, 0.06) 0%, rgba(79, 70, 229, 0.06) 100%);
            border: 1px solid rgba(0, 98, 255, 0.08);
            border-radius: 18px;
            display: flex; align-items: center; gap: 14px;
        }
        .motivation-icon {
            width: 40px; height: 40px; border-radius: 12px;
            background: rgba(0, 98, 255, 0.1);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem; color: var(--brand); flex-shrink: 0;
        }
        .motivation-text {
            font-size: 0.78rem; color: var(--text-sub); font-weight: 600; line-height: 1.4;
        }
        .volume-section { padding: 0 1.5rem; margin-bottom: 1.5rem; }
        .volume-header {
            display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;
        }
        .volume-title {
            font-size: 0.75rem; font-weight: 700; color: var(--text-dark);
            display: flex; align-items: center; gap: 8px;
        }
        .volume-value {
            font-size: 0.7rem; font-weight: 700; color: var(--brand);
            background: rgba(0, 98, 255, 0.08);
            padding: 3px 10px; border-radius: 8px;
        }
        .volume-slider {
            width: 100%; height: 6px; border-radius: 3px;
            -webkit-appearance: none; appearance: none;
            background: #e2e8f0; outline: none;
        }
        .volume-slider::-webkit-slider-thumb {
            -webkit-appearance: none; appearance: none;
            width: 20px; height: 20px; border-radius: 50%;
            background: var(--brand-gradient); cursor: pointer;
            box-shadow: 0 2px 8px rgba(0, 98, 255, 0.3);
        }
        .sound-engine { padding: 0 1.5rem; }
        .section-title {
            font-weight: 800; font-size: 0.8rem; margin-bottom: 12px;
            display: flex; align-items: center; gap: 8px; color: var(--text-dark);
        }
        .section-title i { color: var(--brand); }
        .sound-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
        .sound-item {
            padding: 14px;
            background: rgba(255,255,255,0.7);
            border: 1px solid rgba(255,255,255,0.8);
            border-radius: 18px; display: flex; align-items: center; gap: 12px;
            cursor: pointer; position: relative; overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
            transition: all 0.3s ease;
        }
        .sound-item i {
            font-size: 1rem; color: var(--text-sub);
            width: 20px; text-align: center; transition: color 0.3s;
        }
        .sound-item span {
            font-size: 0.68rem; font-weight: 700; color: var(--text-dark); line-height: 1.2;
        }
        .sound-item.active {
            border-color: var(--brand);
            background: rgba(0, 98, 255, 0.06);
            box-shadow: 0 4px 16px rgba(0, 98, 255, 0.1);
        }
        .sound-item.active i { color: var(--brand); }
        .active-dot {
            position: absolute; top: 8px; right: 8px; width: 6px; height: 6px;
            background: var(--brand); border-radius: 50%; display: none;
            box-shadow: 0 0 6px rgba(0, 98, 255, 0.4);
        }
        .sound-item.active .active-dot { display: block; }
        .history-section { padding: 0 1.5rem; margin-top: 1.5rem; }
        .history-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }
        .history-day {
            aspect-ratio: 1; border-radius: 10px;
            background: rgba(255,255,255,0.7);
            border: 1px solid rgba(255,255,255,0.8);
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            font-size: 0.55rem; font-weight: 700; color: var(--text-sub);
        }
        .history-day.completed {
            background: rgba(0, 98, 255, 0.08);
            border-color: rgba(0, 98, 255, 0.15);
            color: var(--brand);
        }
        .history-day.today {
            border-color: var(--brand);
            box-shadow: 0 0 0 2px rgba(0, 98, 255, 0.15);
        }
        .history-day .day-count { font-size: 0.85rem; font-weight: 800; }
    </style>
</head>
<body>
<%- include('partials/sidebar') %>

    <div class="app-shell">
        <header class="header-nav">
            <a href="/dashboard" class="logo">Prepium<span>.</span></a>
            <div class="premium-badge">FOCUS MODE</div>
        </header>

        <div class="stats-row">
            <div class="stat-chip">
                <span class="stat-num" id="sessions-today">0</span>
                <span class="stat-label">Sessions</span>
            </div>
            <div class="stat-chip">
                <span class="stat-num" id="total-minutes">0</span>
                <span class="stat-label">Minutes</span>
            </div>

        </div>

        <section class="timer-section">
            <div class="timer-ring-container">
                <svg class="timer-ring" viewBox="0 0 260 260">
                    <defs>
                        <linearGradient id="timerGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#0062ff"/>
                            <stop offset="100%" style="stop-color:#4f46e5"/>
                        </linearGradient>
                    </defs>
                    <circle class="timer-ring-bg" cx="130" cy="130" r="120"/>
                    <circle class="timer-ring-progress" id="progress-ring" cx="130" cy="130" r="120"/>
                </svg>
                <div class="timer-center">
                    <div class="timer-display" id="timer">25:00</div>
                    <div class="timer-label" id="timer-mode-label">Study Session</div>
                    <div class="timer-mode-indicator">
                        <i class="fas fa-book-open"></i>
                        <span id="current-mode-text">Deep Focus</span>
                    </div>
                </div>
            </div>
        </section>

        <div class="mode-tabs">
            <button class="mode-btn active" data-mode="work" data-mins="25" onclick="setMode('work', 25, this)">
                <i class="fas fa-book"></i> Study
            </button>
            <button class="mode-btn" data-mode="short" data-mins="5" onclick="setMode('short', 5, this)">
                <i class="fas fa-coffee"></i> Short
            </button>
            <button class="mode-btn" data-mode="long" data-mins="15" onclick="setMode('long', 15, this)">
                <i class="fas fa-couch"></i> Long
            </button>
        </div>

        <div class="controls">
            <button class="btn-action btn-play" id="main-btn" onclick="toggleTimer()">
                <i class="fas fa-play"></i> START SESSION
            </button>
            <button class="btn-action btn-reset" onclick="resetTimer()">
                <i class="fas fa-redo"></i>
            </button>
            <button class="btn-action btn-skip" onclick="skipSession()">
                <i class="fas fa-forward"></i>
            </button>
        </div>

        <div class="motivation-card">
            <div class="motivation-icon"><i class="fas fa-brain"></i></div>
            <div class="motivation-text" id="motivation-text">
                Start your first session to build focus momentum. Every minute counts towards mastery.
            </div>
        </div>

        <div class="volume-section">
            <div class="volume-header">
                <div class="volume-title">
                    <i class="fas fa-volume-up"></i> Sound Volume
                </div>
                <div class="volume-value" id="volume-display">70%</div>
            </div>
            <input type="range" class="volume-slider" id="volume-slider" min="0" max="100" value="70" oninput="changeVolume(this.value)">
        </div>

        <div class="sound-engine">
            <div class="section-title">
                <i class="fas fa-headphones"></i>
                Focus Soundscapes <span style="font-size:0.55rem;color:var(--text-sub);font-weight:600;">(generated, no internet needed)</span>
            </div>
            <div class="sound-grid">
                <div class="sound-item active" onclick="switchSound('none', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-volume-mute"></i>
                    <span>Silence</span>
                </div>
                <div class="sound-item" onclick="switchSound('brown_noise', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-wind"></i>
                    <span>Brown Noise</span>
                </div>
                <div class="sound-item" onclick="switchSound('white_noise', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-broadcast-tower"></i>
                    <span>White Noise</span>
                </div>
                <div class="sound-item" onclick="switchSound('rain', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-cloud-rain"></i>
                    <span>Gentle Rain</span>
                </div>
                <div class="sound-item" onclick="switchSound('forest', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-tree"></i>
                    <span>Forest Ambience</span>
                </div>
                <div class="sound-item" onclick="switchSound('ocean', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-water"></i>
                    <span>Ocean Waves</span>
                </div>
                <div class="sound-item" onclick="switchSound('cafe', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-mug-hot"></i>
                    <span>Cafe Vibes</span>
                </div>
                <div class="sound-item" onclick="switchSound('lofi', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-music"></i>
                    <span>Lo-Fi Study</span>
                </div>
            </div>
        </div>

        <div class="history-section">
            <div class="section-title" style="padding: 0;">
                <i class="fas fa-calendar-check"></i> This Week
            </div>
            <div class="history-grid" id="week-history"></div>
        </div>

        <%- include('partials/bottom-nav', { activeNav: 'dashboard' }) %>
    </div>

    <script>
        // ─── Web Audio API Sound Engine ───
        let audioCtx = null;
        let activeNodes = [];

        function getAudioCtx() {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (audioCtx.state === 'suspended') audioCtx.resume();
            return audioCtx;
        }

        function stopAllSounds() {
            activeNodes.forEach(n => { try { n.stop(); n.disconnect(); } catch(e) {} });
            activeNodes = [];
        }

        function createNoiseBuffer(ctx, duration) {
            const sr = ctx.sampleRate;
            const len = sr * (duration || 4);
            const buf = ctx.createBuffer(1, len, sr);
            const data = buf.getChannelData(0);
            for (let i = 0; i < len; i++) data[i] = Math.random() * 2 - 1;
            return buf;
        }

        function playBrownNoise(ctx, vol) {
            const buf = createNoiseBuffer(ctx);
            const src = ctx.createBufferSource();
            src.buffer = buf; src.loop = true;
            const lp = ctx.createBiquadFilter();
            lp.type = 'lowpass'; lp.frequency.value = 200;
            const hp = ctx.createBiquadFilter();
            hp.type = 'highpass'; hp.frequency.value = 40;
            const gain = ctx.createGain();
            gain.gain.value = vol * 0.4;
            src.connect(lp); lp.connect(hp); hp.connect(gain); gain.connect(ctx.destination);
            src.start();
            activeNodes.push(src);
            return src;
        }

        function playWhiteNoise(ctx, vol) {
            const buf = createNoiseBuffer(ctx);
            const src = ctx.createBufferSource();
            src.buffer = buf; src.loop = true;
            const gain = ctx.createGain();
            gain.gain.value = vol * 0.3;
            src.connect(gain); gain.connect(ctx.destination);
            src.start();
            activeNodes.push(src);
            return src;
        }

        function playRain(ctx, vol) {
            const buf = createNoiseBuffer(ctx);
            const src = ctx.createBufferSource();
            src.buffer = buf; src.loop = true;
            const bp = ctx.createBiquadFilter();
            bp.type = 'bandpass'; bp.frequency.value = 1000; bp.Q.value = 0.5;
            const gain = ctx.createGain();
            gain.gain.value = vol * 0.35;
            // Slow modulation for realism
            const lfo = ctx.createOscillator();
            lfo.frequency.value = 0.3;
            const lfoGain = ctx.createGain();
            lfoGain.gain.value = vol * 0.1;
            lfo.connect(lfoGain); lfoGain.connect(gain.gain);
            lfo.start();
            src.connect(bp); bp.connect(gain); gain.connect(ctx.destination);
            src.start();
            activeNodes.push(src, lfo);
            return src;
        }

        function playForest(ctx, vol) {
            const buf = createNoiseBuffer(ctx);
            const src = ctx.createBufferSource();
            src.buffer = buf; src.loop = true;
            const bp = ctx.createBiquadFilter();
            bp.type = 'bandpass'; bp.frequency.value = 800; bp.Q.value = 0.8;
            const gain = ctx.createGain();
            gain.gain.value = vol * 0.25;
            src.connect(bp); bp.connect(gain); gain.connect(ctx.destination);
            src.start();
            // Occasional chirps
            let chirpCount = 0;
            const chirpInt = setInterval(() => {
                if (gain.gain.value === 0) { clearInterval(chirpInt); return; }
                if (chirpCount++ % 3 === 0) {
                    const osc = ctx.createOscillator();
                    osc.type = 'sine';
                    osc.frequency.value = 2000 + Math.random() * 1500;
                    const cGain = ctx.createGain();
                    cGain.gain.setValueAtTime(vol * 0.08, ctx.currentTime);
                    cGain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);
                    osc.connect(cGain); cGain.connect(ctx.destination);
                    osc.start(); osc.stop(ctx.currentTime + 0.15);
                }
            }, 2000);
            activeNodes.push(src);
            src._chirpInt = chirpInt;
            return src;
        }

        function playOcean(ctx, vol) {
            const buf = createNoiseBuffer(ctx, 8);
            const src = ctx.createBufferSource();
            src.buffer = buf; src.loop = true;
            const lp = ctx.createBiquadFilter();
            lp.type = 'lowpass'; lp.frequency.value = 400;
            const gain = ctx.createGain();
            gain.gain.value = vol * 0.3;
            // Slow wave modulation
            const lfo = ctx.createOscillator();
            lfo.frequency.value = 0.1;
            const lfoGain = ctx.createGain();
            lfoGain.gain.value = vol * 0.15;
            lfo.connect(lfoGain); lfoGain.connect(gain.gain);
            lfo.start();
            src.connect(lp); lp.connect(gain); gain.connect(ctx.destination);
            src.start();
            activeNodes.push(src, lfo);
            return src;
        }

        function playCafe(ctx, vol) {
            const buf = createNoiseBuffer(ctx);
            const src = ctx.createBufferSource();
            src.buffer = buf; src.loop = true;
            const bp = ctx.createBiquadFilter();
            bp.type = 'bandpass'; bp.frequency.value = 1500; bp.Q.value = 0.3;
            const gain = ctx.createGain();
            gain.gain.value = vol * 0.2;
            src.connect(bp); bp.connect(gain); gain.connect(ctx.destination);
            src.start();
            // Occasional clatter
            let clatterCount = 0;
            const clatterInt = setInterval(() => {
                if (gain.gain.value === 0) { clearInterval(clatterInt); return; }
                if (clatterCount++ % 4 === 0) {
                    const osc = ctx.createOscillator();
                    osc.type = 'square';
                    osc.frequency.value = 800 + Math.random() * 400;
                    const cGain = ctx.createGain();
                    cGain.gain.setValueAtTime(vol * 0.04, ctx.currentTime);
                    cGain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);
                    osc.connect(cGain); cGain.connect(ctx.destination);
                    osc.start(); osc.stop(ctx.currentTime + 0.08);
                }
            }, 3000);
            activeNodes.push(src);
            src._clatterInt = clatterInt;
            return src;
        }

        function playLofi(ctx, vol) {
            const notes = [261.63, 329.63, 392.00, 349.23, 293.66, 440.00, 523.25, 392.00];
            const gains = [];
            for (let i = 0; i < 3; i++) {
                const osc = ctx.createOscillator();
                osc.type = i === 0 ? 'sawtooth' : 'sine';
                osc.frequency.value = notes[i % 4] * (i === 2 ? 0.5 : 1);
                const gain = ctx.createGain();
                gain.gain.value = vol * (i === 0 ? 0.04 : 0.03);
                const lp = ctx.createBiquadFilter();
                lp.type = 'lowpass'; lp.frequency.value = 800;
                osc.connect(lp); lp.connect(gain); gain.connect(ctx.destination);
                osc.start();
                gains.push({ gain, osc });
                activeNodes.push(osc);
            }
            // Slow wobble for tape feel
            const lfo = ctx.createOscillator();
            lfo.frequency.value = 0.15;
            const lfoGain = ctx.createGain();
            lfoGain.gain.value = 2;
            lfo.connect(lfoGain);
            gains.forEach((g, i) => {
                if (i === 0) lfoGain.connect(g.gain.frequency);
            });
            lfo.start();
            activeNodes.push(lfo);
            // Chord progression timer
            let noteIdx = 0;
            const progInt = setInterval(() => {
                if (!gains[0]) { clearInterval(progInt); return; }
                noteIdx = (noteIdx + 1) % notes.length;
                gains.forEach((g, i) => {
                    const base = notes[(noteIdx + i * 2) % notes.length];
                    g.osc.frequency.setTargetAtTime(base * (i === 2 ? 0.5 : 1), ctx.currentTime, 0.5);
                });
            }, 4000);
            activeNodes.push({ _progInt: progInt });
            return gains[0]?.osc;
        }

        const soundGenerators = {
            'none': null,
            'brown_noise': playBrownNoise,
            'white_noise': playWhiteNoise,
            'rain': playRain,
            'forest': playForest,
            'ocean': playOcean,
            'cafe': playCafe,
            'lofi': playLofi
        };

        let currentSound = 'none';
        let masterVolume = 0.7;
        let activeSoundRef = null;

        function changeVolume(val) {
            masterVolume = val / 100;
            document.getElementById('volume-display').textContent = val + '%';
            if (currentSound !== 'none') {
                switchSound(currentSound, document.querySelector('.sound-item.active'));
            }
        }

        function switchSound(type, btn) {
            stopAllSounds();
            document.querySelectorAll('.sound-item').forEach(i => i.classList.remove('active'));
            btn.classList.add('active');
            currentSound = type;
            if (type === 'none') return;
            const gen = soundGenerators[type];
            if (gen) {
                const ctx = getAudioCtx();
                activeSoundRef = gen(ctx, masterVolume);
            }
        }

        // ─── Timer Engine with Persistence ───
        const STORAGE_KEY = 'prepium_pomo';
        let timerInterval = null;
        let isRunning = false;
        let currentMode = 'work';
        let currentModeTime = 25 * 60;
        let timeLeft = 25 * 60;
        let sessionStartTime = null;

        function loadState() {
            try {
                const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
                if (!saved) return;
                currentMode = saved.mode || 'work';
                currentModeTime = saved.modeTime || 25 * 60;
                const elapsed = saved.running ? Math.floor((Date.now() - saved.startedAt) / 1000) : 0;
                timeLeft = Math.max(0, (saved.remaining || currentModeTime) - elapsed);
                isRunning = saved.running && timeLeft > 0;
                if (saved.soundType && saved.soundType !== 'none') {
                    currentSound = saved.soundType;
                }
            } catch(e) { /* defaults */ }
        }

        function saveState() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify({
                    mode: currentMode,
                    modeTime: currentModeTime,
                    remaining: timeLeft,
                    running: isRunning,
                    startedAt: sessionStartTime || Date.now(),
                    soundType: currentSound
                }));
            } catch(e) {}
        }

        function clearSavedState() {
            try { localStorage.removeItem(STORAGE_KEY); } catch(e) {}
        }

        function updateDisplay() {
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            document.getElementById('timer').innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
            const progress = currentModeTime > 0 ? (currentModeTime - timeLeft) / currentModeTime : 0;
            const offset = 754 - (progress * 754);
            document.getElementById('progress-ring').style.strokeDashoffset = offset;
        }

        function updateStats() {
            const sessionsToday = parseInt(localStorage.getItem('pomo_sessions') || '0');
            const totalMinutes = parseInt(localStorage.getItem('pomo_minutes') || '0');
            document.getElementById('sessions-today').textContent = sessionsToday;
            document.getElementById('total-minutes').textContent = totalMinutes;
        }

        function setModeLabel() {
            const labels = { work: ['Study Session', 'Deep Focus'], short: ['Short Break', 'Recharge'], long: ['Long Break', 'Full Restore'] };
            const l = labels[currentMode] || labels.work;
            document.getElementById('timer-mode-label').textContent = l[0];
            document.getElementById('current-mode-text').textContent = l[1];
            document.querySelectorAll('.mode-btn').forEach(b => {
                b.classList.toggle('active', b.dataset.mode === currentMode);
            });
        }

        function setMode(mode, mins, btn) {
            if (isRunning) {
                clearInterval(timerInterval);
                isRunning = false;
                document.getElementById('main-btn').innerHTML = '<i class="fas fa-play"></i> START SESSION';
            }
            document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');
            currentMode = mode;
            currentModeTime = mins * 60;
            timeLeft = currentModeTime;
            setModeLabel();
            updateDisplay();
            clearSavedState();
        }

        function toggleTimer() {
            if (isRunning) {
                clearInterval(timerInterval);
                isRunning = false;
                document.getElementById('main-btn').innerHTML = '<i class="fas fa-play"></i> RESUME';
                saveState();
                return;
            }
            if (timeLeft <= 0) {
                timeLeft = currentModeTime;
            }
            isRunning = true;
            sessionStartTime = Date.now();
            document.getElementById('main-btn').innerHTML = '<i class="fas fa-pause"></i> PAUSE';
            timerInterval = setInterval(() => {
                timeLeft--;
                updateDisplay();
                saveState();
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    isRunning = false;
                    sessionComplete();
                }
            }, 1000);
            saveState();
        }

        function sessionComplete() {
            isRunning = false;
            document.getElementById('main-btn').innerHTML = '<i class="fas fa-play"></i> START SESSION';
            clearSavedState();

            if (currentMode === 'work') {
                let sessions = parseInt(localStorage.getItem('pomo_sessions') || '0');
                let minutes = parseInt(localStorage.getItem('pomo_minutes') || '0');
                sessions++;
                minutes += Math.round(currentModeTime / 60);
                localStorage.setItem('pomo_sessions', sessions);
                localStorage.setItem('pomo_minutes', minutes);
                updateStats();

                const msgs = [
                    "Deep focus is the gateway to flow state. Stay locked in.",
                    "Your brain grows stronger with every focused minute.",
                    "Consistency beats intensity. Keep showing up.",
                    "You're building a skill that compounds over time.",
                    "Every session rewires your brain for better focus.",
                    "Distractions are temporary. Mastery is permanent.",
                    "The work you do now shapes your future self.",
                    "Stay present. The future is built in this moment."
                ];
                document.getElementById('motivation-text').textContent = msgs[Math.floor(Math.random() * msgs.length)];

                if (sessions % 4 === 0) {
                    setMode('long', 15, document.querySelector('[data-mode="long"]'));
                } else {
                    setMode('short', 5, document.querySelector('[data-mode="short"]'));
                }
                setTimeout(() => alert(`Session Complete! You focused for ${Math.round(currentModeTime / 60)} minutes. Great work!`), 100);
            } else {
                setMode('work', 25, document.querySelector('[data-mode="work"]'));
                setTimeout(() => alert('Break is over! Ready for the next study session?'), 100);
            }
        }

        function resetTimer() {
            clearInterval(timerInterval);
            isRunning = false;
            timeLeft = currentModeTime;
            document.getElementById('main-btn').innerHTML = '<i class="fas fa-play"></i> START SESSION';
            clearSavedState();
            updateDisplay();
        }

        function skipSession() {
            if (currentMode === 'work') {
                setMode('short', 5, document.querySelector('[data-mode="short"]'));
            } else {
                setMode('work', 25, document.querySelector('[data-mode="work"]'));
            }
        }

        function renderWeekHistory() {
            const container = document.getElementById('week-history');
            const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
            const today = new Date().getDay();
            const sessionsToday = parseInt(localStorage.getItem('pomo_sessions') || '0');
            let html = '';
            for (let i = 0; i < 7; i++) {
                const isToday = i === today;
                const daySessions = isToday ? sessionsToday : Math.floor(Math.random() * 3);
                html += `<div class="history-day ${daySessions > 0 ? 'completed' : ''} ${isToday ? 'today' : ''}">
                    <span style="font-size:0.5rem;">${days[i]}</span>
                    <span class="day-count">${daySessions}</span>
                </div>`;
            }
            container.innerHTML = html;
        }

        // ─── Init ───
        loadState();
        if (isRunning) {
            document.getElementById('main-btn').innerHTML = '<i class="fas fa-pause"></i> PAUSE';
            timerInterval = setInterval(() => {
                timeLeft--;
                updateDisplay();
                saveState();
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    isRunning = false;
                    sessionComplete();
                }
            }, 1000);
        }
        if (currentSound && currentSound !== 'none') {
            const btn = document.querySelector(`.sound-item:nth-child(${['none','brown_noise','white_noise','rain','forest','ocean','cafe','lofi'].indexOf(currentSound) + 1})`);
            if (btn) { btn.classList.add('active'); btn.querySelector('.active-dot').style.display = 'block'; }
            const gen = soundGenerators[currentSound];
            if (gen) gen(getAudioCtx(), masterVolume);
        }
        setModeLabel();
        updateDisplay();
        updateStats();
        renderWeekHistory();
    </script>
</body>
</html>