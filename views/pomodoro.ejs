<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Focus Engine | Prepium</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root { 
            --brand: #0062ff; 
            --brand-gradient: linear-gradient(135deg, #0062ff 0%, #0045b5 100%);
            --bg: #f8fafc; 
            --text-dark: #0b1437; 
            --text-sub: #a3aed0;
            --border: #eef2f6;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; transition: all 0.2s ease; }
        
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: var(--bg); margin: 0; color: var(--text-dark); 
            display: flex; justify-content: center; overflow-x: hidden;
        }

        .app-shell { 
            width: 100%; max-width: 430px; 
            background: #ffffff; min-height: 100vh; 
            position: relative; display: flex; flex-direction: column;
            box-shadow: 0 0 40px rgba(0,0,0,0.02);
            padding-bottom: 110px;
        }

        /* Header matching Arena style */
        .header-nav { padding: 1.5rem; display: flex; justify-content: space-between; align-items: center; background: white; }
        .logo { font-weight: 800; font-size: 1.2rem; letter-spacing: -1px; color: var(--text-dark); text-decoration: none; }
        .logo span { color: var(--brand); }

        /* Timer Card */
        .focus-card {
            margin: 0.5rem 1.5rem 1rem; background: white; border-radius: 28px; padding: 1.8rem;
            border: 1px solid var(--border); text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        }

        .mode-tabs {
            background: #f1f5f9; padding: 5px; border-radius: 14px;
            display: flex; gap: 4px; margin-bottom: 1.5rem;
        }
        .mode-btn {
            flex: 1; padding: 8px; border-radius: 10px; border: none;
            font-weight: 700; font-size: 0.75rem; cursor: pointer;
            background: transparent; color: var(--text-sub);
        }
        .mode-btn.active { background: white; color: var(--brand); box-shadow: 0 4px 10px rgba(0,0,0,0.05); }

        .timer-display {
            font-size: 4.8rem; font-weight: 800; color: var(--text-dark);
            letter-spacing: -3px; margin: 0.5rem 0; line-height: 1;
        }

        .controls { display: flex; gap: 10px; justify-content: center; margin-top: 1.5rem; }
        .btn-action {
            padding: 14px; border-radius: 16px; border: none;
            font-weight: 800; font-size: 0.9rem; cursor: pointer;
        }
        .btn-play { flex: 2; background: var(--brand-gradient); color: white; box-shadow: 0 8px 20px rgba(0, 98, 255, 0.2); }
        .btn-reset { flex: 0.8; background: #f1f5f9; color: var(--text-dark); }

        /* Soundscape Engine */
        .sound-engine { padding: 0 1.5rem; }
        .section-title { font-weight: 800; font-size: 0.85rem; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; color: var(--text-dark); }
        
        .sound-grid {
            display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;
        }
        .sound-item {
            padding: 15px; background: white; border: 1px solid var(--border);
            border-radius: 20px; display: flex; align-items: center; gap: 12px; cursor: pointer;
            position: relative; overflow: hidden;
        }
        .sound-item i { font-size: 1.1rem; color: var(--text-sub); width: 20px; text-align: center; }
        .sound-item span { font-size: 0.72rem; font-weight: 700; color: var(--text-dark); line-height: 1.2; }
        
        .sound-item.active { border-color: var(--brand); background: #eff6ff; }
        .sound-item.active i { color: var(--brand); }
        
        .active-dot {
            position: absolute; top: 8px; right: 8px; width: 5px; height: 5px;
            background: var(--brand); border-radius: 50%; display: none;
        }
        .sound-item.active .active-dot { display: block; }

        /* Navigation */
        .bottom-nav {
            position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
            width: calc(100% - 40px); max-width: 390px; background: #0b1437; height: 70px; 
            border-radius: 24px; display: flex; justify-content: space-around; 
            align-items: center; z-index: 1000;
        }
        .nav-link { text-decoration: none; color: #a3aed0; text-align: center; font-size: 0.6rem; font-weight: 700; text-transform: uppercase; }
        .nav-link i { font-size: 1.2rem; display: block; margin-bottom: 4px; }
        .nav-link.active { color: white; }
    </style>
</head>
<body>

    <div class="app-shell">
        <header class="header-nav">
            <a href="/dashboard" class="logo">Focus<span>Engine</span></a>
            <div style="background: #eff6ff; padding: 6px 12px; border-radius: 10px; color: var(--brand); font-weight: 800; font-size: 0.7rem;">
                PREMIUM
            </div>
        </header>

        <section class="focus-card">
            <div class="mode-tabs">
                <button class="mode-btn active" onclick="setMode('work', 25, this)">STUDY</button>
                <button class="mode-btn" onclick="setMode('short', 5, this)">SHORT BREAK</button>
                <button class="mode-btn" onclick="setMode('long', 15, this)">LONG BREAK</button>
            </div>

            <div class="timer-display" id="timer">25:00</div>
            
            <div class="controls">
                <button class="btn-action btn-play" id="main-btn" onclick="toggleTimer()">
                    <i class="fas fa-play" style="margin-right: 8px;"></i> START SESSION
                </button>
                <button class="btn-action btn-reset" onclick="resetTimer()">
                    <i class="fas fa-redo"></i>
                </button>
            </div>
        </section>

        <div class="sound-engine">
            <div class="section-title">
                <i class="fas fa-brain" style="color: var(--brand);"></i> 
                COGNITIVE SOUNDSCAPES
            </div>
            
            <div class="sound-grid">
                <div class="sound-item active" onclick="switchSound('none', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-ban"></i>
                    <span>Silence</span>
                </div>
                <div class="sound-item" onclick="switchSound('bilateral_music', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-sync"></i>
                    <span>Bilateral Music (EMDR)</span>
                </div>
                <div class="sound-item" onclick="switchSound('soft_panned', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-cloud-sun-rain"></i>
                    <span>Soft Panned Rainfall</span>
                </div>
                <div class="sound-item" onclick="switchSound('ambient_textures', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-atom"></i>
                    <span>Ambient Textures</span>
                </div>
                <div class="sound-item" onclick="switchSound('rain_window', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-tint"></i>
                    <span>Rain on a Window</span>
                </div>
                <div class="sound-item" onclick="switchSound('nature_tones', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-leaf"></i>
                    <span>Bilateral Nature</span>
                </div>
                <div class="sound-item" onclick="switchSound('storm_brown', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-bolt"></i>
                    <span>Storm & Brown Noise</span>
                </div>
                <div class="sound-item" onclick="switchSound('piano_rain', this)">
                    <div class="active-dot"></div>
                    <i class="fas fa-keyboard"></i>
                    <span>Piano & Rain</span>
                </div>
            </div>
        </div>

        <audio id="audio-player" loop></audio>

        <nav class="bottom-nav">
            <a href="/dashboard" class="nav-link"><i class="fas fa-home"></i><span>Home</span></a>
            <a href="/daily-challenge" class="nav-link"><i class="fas fa-fire"></i><span>Arena</span></a>
            <a href="/focus" class="nav-link active"><i class="fas fa-stopwatch"></i><span>Focus</span></a>
            <a href="/profile" class="nav-link"><i class="fas fa-user-circle"></i><span>Profile</span></a>
        </nav>
    </div>

    <script>
        let timerInterval;
        let timeLeft = 25 * 60;
        let isRunning = false;
        let currentModeTime = 25 * 60;

        const timerEl = document.getElementById('timer');
        const mainBtn = document.getElementById('main-btn');
        const audio = document.getElementById('audio-player');

        // Assets Mapping (Replace with your actual URLs)
       const soundLibrary = {
    'none': '',
    // Bilateral Music (EMDR/8D) - Using a rhythmic, balanced track
    'bilateral_music': 'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3',
    
    // Soft Panned Rainfall - Using a lighter, consistent instrumental
    'soft_panned': 'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3',
    
    // Bilateral Ambient Textures - Deep, synth-heavy track
    'ambient_textures': 'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3',
    
    // Rain on a Window - Using a track with shorter, "tapping" notes
    'rain_window': 'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-8.mp3',
    
    // Bilateral Nature Tones - Lighter, airy instrumental
    'nature_tones': 'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-10.mp3',
    
    // Heavy Storm with Brown Noise - Deep, intense bass-driven track
    'storm_brown': 'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-15.mp3',
    
    // Bilateral Piano & Rain - Piano-led melodic track
    'piano_rain': 'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-16.mp3'
};
        function updateDisplay() {
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            timerEl.innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        function setMode(mode, mins, btn) {
            document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentModeTime = mins * 60;
            timeLeft = currentModeTime;
            resetTimer();
        }

        function toggleTimer() {
            if (isRunning) {
                clearInterval(timerInterval);
                mainBtn.innerHTML = '<i class="fas fa-play" style="margin-right: 8px;"></i> START SESSION';
                isRunning = false;
            } else {
                isRunning = true;
                mainBtn.innerHTML = '<i class="fas fa-pause" style="margin-right: 8px;"></i> PAUSE';
                timerInterval = setInterval(() => {
                    timeLeft--;
                    updateDisplay();
                    if (timeLeft <= 0) {
                        clearInterval(timerInterval);
                        alert("Focus Session Complete!");
                        resetTimer();
                    }
                }, 1000);
            }
        }

        function resetTimer() {
            clearInterval(timerInterval);
            isRunning = false;
            timeLeft = currentModeTime;
            mainBtn.innerHTML = '<i class="fas fa-play" style="margin-right: 8px;"></i> START SESSION';
            updateDisplay();
        }

        function switchSound(type, btn) {
            document.querySelectorAll('.sound-item').forEach(i => i.classList.remove('active'));
            btn.classList.add('active');

            if (type === 'none') {
                audio.pause();
                return;
            }

            audio.src = soundLibrary[type];
            audio.play().catch(e => console.warn("Audio needs user interaction first."));
        }
    </script>
</body>
</html>