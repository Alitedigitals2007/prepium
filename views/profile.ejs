<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prepium | Profile</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { --brand: #0062ff; --bg: #f8fafc; --text: #1e293b; }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); margin: 0; padding-bottom: 100px; color: var(--text); display: flex; justify-content: center; }
        .app-shell { width: 100%; max-width: 430px; background: white; min-height: 100vh; position: relative; box-shadow: 0 0 40px rgba(0,0,0,0.03); }

        /* Profile Header */
        .header-bg { background: linear-gradient(to bottom, #eef4ff, white); padding: 4rem 1.2rem 2rem; text-align: center; }
        .avatar-circle { width: 90px; height: 90px; background: var(--brand); color: white; border-radius: 32px; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: 800; margin: 0 auto 1.2rem; box-shadow: 0 12px 24px rgba(0,98,255,0.2); }
        .name { font-size: 1.5rem; font-weight: 800; margin: 0; letter-spacing: -0.5px; }
        .sub-text { font-size: 0.9rem; color: #64748b; margin: 6px 0; }

        /* Focused Stats Grid */
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; padding: 0 1.5rem; margin-top: 10px; }
        .stat-card { background: #ffffff; border: 1.5px solid #f1f5f9; padding: 1.5rem 1rem; border-radius: 28px; text-align: center; transition: 0.3s; }
        .stat-val { display: block; font-size: 1.6rem; font-weight: 800; color: var(--brand); }
        .stat-lab { font-size: 0.65rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; margin-top: 6px; letter-spacing: 0.5px; }

        /* Settings List */
        .menu-list { padding: 1.5rem; margin-top: 10px; }
        .menu-item { display: flex; align-items: center; justify-content: space-between; padding: 1.2rem; background: #f8fafc; border-radius: 22px; margin-bottom: 12px; text-decoration: none; color: inherit; border: 1px solid transparent; transition: 0.2s; }
        .menu-item:active { border-color: var(--brand); background: white; transform: scale(0.98); }
        .menu-info { display: flex; align-items: center; gap: 12px; font-weight: 700; font-size: 0.95rem; }
        .menu-icon { font-size: 1.3rem; }

        .logout { color: #ef4444; background: #fef2f2; }

        /* Navigation */
        .bottom-nav { position: fixed; bottom: 0; width: 100%; max-width: 430px; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); height: 85px; display: flex; justify-content: space-around; align-items: center; border-top: 1px solid #f1f5f9; z-index: 1000; padding-bottom: 10px; }
        .nav-link { text-decoration: none; color: #94a3b8; font-size: 0.65rem; font-weight: 800; text-align: center; }
        .nav-link.active { color: var(--brand); }
        .nav-link i { display: block; font-size: 1.4rem; margin-bottom: 4px; font-style: normal; }
        .fab { width: 62px; height: 62px; background: var(--brand); border-radius: 22px; display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem; transform: translateY(-25px); border: 5px solid white; box-shadow: 0 10px 20px rgba(0,98,255,0.25); text-decoration: none; }
    </style>
</head>
<body>

    <div class="app-shell">
        <div class="header-bg">
            <div class="avatar-circle">
                <%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %>
            </div>
            <h1 class="name"><%= user.fullname %></h1>
            <p class="sub-text"><%= user.email %></p>
            <div style="margin-top: 12px;">
                <span style="background: <%= user.has_paid ? '#eff6ff' : '#f1f5f9' %>; color: <%= user.has_paid ? var('--brand') : '#64748b' %>; padding: 6px 14px; border-radius: 12px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; border: 1px solid <%= user.has_paid ? '#dbeafe' : '#e2e8f0' %>;">
                    <%= user.has_paid ? 'Premium Access' : 'Basic Learner' %>
                </span>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-val"><%= stats.total %></span>
                <span class="stat-lab">Total Tests</span>
            </div>
            <div class="stat-card">
                <span class="stat-val"><%= stats.average %>%</span>
                <span class="stat-lab">Avg. Score</span>
            </div>
        </div>

        <div class="menu-list">
            <a href="/history" class="menu-item">
                <div class="menu-info"><span class="menu-icon">📊</span> View Performance History</div>
                <span style="color: #cbd5e1;">❯</span>
            </a>
            
            <% if (!user.has_paid) { %>
            <a href="/dashboard" class="menu-item" style="background: #fffbeb; border: 1px solid #fef3c7;">
                <div class="menu-info"><span class="menu-icon">✨</span> Upgrade to Premium</div>
                <span style="color: #f59e0b;">❯</span>
            </a>
            <% } %>

            <a href="/logout" class="menu-item logout">
                <div class="menu-info"><span class="menu-icon">🚪</span> Sign Out</div>
                <span>❯</span>
            </a>
        </div>

        <nav class="bottom-nav">
            <a href="/dashboard" class="nav-link"><i>🏠</i>Home</a>
            <a href="/history" class="nav-link"><i>📊</i>Stats</a>
            <a href="/setup-test" class="fab">+</a>
            <a href="/notifications" class="nav-link"><i>🔔</i>Alerts</a>
            <a href="/profile" class="nav-link active"><i>👤</i>Me</a>
        </nav>
    </div>

</body>
</html>
