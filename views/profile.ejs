<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        /* Profile Hero */
        .profile-hero {
            background: linear-gradient(160deg, var(--brand-light) 0%, rgba(99, 102, 241, 0.06) 50%, rgba(255, 255, 255, 0) 100%);
            padding: 3rem 1.5rem 2rem;
            text-align: center;
            border-bottom: 1px solid var(--border);
            position: relative;
            overflow: hidden;
        }
        .profile-hero::before {
            content: '';
            position: absolute;
            top: -60%;
            right: -20%;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: var(--brand-light);
        }
        .profile-hero::after {
            content: '';
            position: absolute;
            bottom: -40%;
            left: -10%;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: rgba(99, 102, 241, 0.03);
        }

        .avatar-wrap {
            position: relative;
            width: 100px; height: 100px;
            margin: 0 auto 1.2rem;
            z-index: 1;
        }
        .avatar-ring {
            width: 100%; height: 100%;
            background: var(--brand-gradient);
            border-radius: 32px;
            display: flex; align-items: center; justify-content: center;
            font-size: 2.2rem; font-weight: 800; color: white;
            box-shadow: 0 15px 35px rgba(0, 98, 255, 0.25);
            border: 4px solid white;
            position: relative;
        }
        .avatar-badge {
            position: absolute;
            bottom: -2px; right: -2px;
            width: 26px; height: 26px;
            background: var(--success);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            border: 3px solid white;
            font-size: 0.65rem;
            color: white;
        }

        .user-name {
            font-size: 1.65rem; font-weight: 800;
            letter-spacing: -0.6px; margin: 0;
            color: var(--text-dark);
        }
        .user-email {
            color: var(--text-sub);
            font-size: 0.85rem; font-weight: 600;
            margin: 4px 0 18px;
        }

        .badges-row {
            display: flex; flex-wrap: wrap;
            justify-content: center; gap: 8px;
            position: relative; z-index: 1;
        }
        .badge-pill {
            display: inline-flex; align-items: center; gap: 7px;
            background: var(--surface);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            padding: 7px 14px; border-radius: 100px;
            font-size: 0.78rem; font-weight: 700;
            color: var(--text-dark);
            box-shadow: var(--shadow-sm);
        }
        .badge-pill i { font-size: 0.85rem; }
        .badge-pill.uni i { color: var(--brand); }
        .badge-pill.dept i { color: var(--success); }

        /* Stats Section */
        .stats-section { padding: 1.5rem 1.5rem 0.75rem; }
        .section-label {
            font-size: 0.65rem; font-weight: 800;
            color: var(--text-sub); text-transform: uppercase;
            letter-spacing: 1px; margin-bottom: 12px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .stat-icon {
            width: 42px; height: 42px;
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.05rem;
            margin: 0 auto 12px;
        }
        .stat-icon.blue { background: var(--brand-light); color: var(--brand); border: 1px solid var(--brand-light); }
        .stat-icon.green { background: var(--success-soft); color: var(--success); border: 1px solid var(--success-soft); }
        .stat-icon.orange { background: var(--warning-soft); color: var(--warning); border: 1px solid var(--warning-soft); }
        .stat-icon.purple { background: var(--brand-light); color: var(--brand); border: 1px solid var(--brand-light); }

        .stat-card.cgpa-card {
            grid-column: span 2;
            background: linear-gradient(135deg, var(--brand-light) 0%, rgba(99, 102, 241, 0.04) 100%);
            border: 1px solid var(--brand-light);
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 16px;
            text-align: left;
            padding: 22px 20px;
        }
        .stat-card.cgpa-card .stat-icon {
            margin: 0;
            width: 50px; height: 50px;
            font-size: 1.2rem;
            background: var(--brand-gradient);
            color: white; border: none;
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.2);
            flex-shrink: 0;
        }
        .cgpa-info { flex: 1; }
        .cgpa-info .stat-val {
            font-size: 1.6rem;
            color: var(--brand);
            line-height: 1;
        }
        .cgpa-info .stat-val .scale {
            font-size: 0.85rem;
            color: var(--text-sub);
            font-weight: 600;
        }
        .cgpa-info .stat-lbl {
            color: var(--brand);
            margin-top: 5px;
            font-size: 0.68rem;
        }

        /* Menu Section */
        .menu-section { padding: 0.75rem 1.5rem 1.5rem; }

        .menu-card {
            background: var(--surface);
            backdrop-filter: blur(20px) saturate(140%);
            -webkit-backdrop-filter: blur(20px) saturate(140%);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: var(--shadow-md);
        }

        .menu-item {
            display: flex; align-items: center; justify-content: space-between;
            padding: 18px 20px;
            text-decoration: none; color: var(--text-dark);
            border-bottom: 1px solid var(--border);
            transition: var(--transition);
        }
        .menu-item:last-child { border-bottom: none; }
        .menu-item:active { background: rgba(0, 0, 0, 0.02); }

        .menu-left {
            display: flex; align-items: center; gap: 14px;
        }
        .menu-icon {
            width: 40px; height: 40px;
            border-radius: 13px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }
        .menu-icon.blue { background: var(--brand-light); color: var(--brand); }
        .menu-icon.red { background: var(--danger-soft); color: var(--danger); }
        .menu-icon.green { background: var(--success-soft); color: var(--success); }
        .menu-icon.orange { background: var(--warning-soft); color: var(--warning); }
        .menu-icon.purple { background: var(--brand-light); color: var(--brand); }
        .menu-text {
            font-weight: 700; font-size: 0.92rem;
        }
        .menu-item.danger .menu-text { color: var(--danger); }
        .menu-chevron { color: var(--text-muted); font-size: 0.75rem; }


    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/sidebar') %>

    <div class="app-shell">

        <!-- Profile Hero Header -->
        <div class="profile-hero reveal-scale">
            <div class="avatar-wrap">
                <div class="avatar-ring">
                    <%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'P' %>
                    <div class="avatar-badge"><i class="fas fa-check"></i></div>
                </div>
            </div>
            <h1 class="user-name"><%= user.fullname %></h1>
            <p class="user-email"><%= user.email %></p>

            <div class="badges-row">
                <div class="badge-pill uni">
                    <i class="fas fa-university"></i>
                    <%= user.university_name || 'Institution' %>
                </div>
                <% if(cgpaProfile && cgpaProfile.department) { %>
                    <div class="badge-pill dept">
                        <i class="fas fa-graduation-cap"></i>
                        <%= cgpaProfile.department %>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="stats-section">
            <div class="section-label">Performance Stats</div>
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon blue"><i class="fas fa-clipboard-list"></i></div>
                    <span class="stat-val"><%= stats.total %></span>
                    <span class="stat-lbl">Total Tests</span>
                </div>
                <div class="stat-card">
                    <div class="stat-icon green"><i class="fas fa-chart-line"></i></div>
                    <span class="stat-val"><%= stats.average %>%</span>
                    <span class="stat-lbl">Avg. Score</span>
                </div>
                <div class="stat-card">
                    <div class="stat-icon orange"><i class="fas fa-fire"></i></div>
                    <span class="stat-val"><%= streak.current_streak || 0 %></span>
                    <span class="stat-lbl">Day Streak</span>
                </div>
                <div class="stat-card">
                    <div class="stat-icon purple"><i class="fas fa-clock"></i></div>
                    <span class="stat-val"><%= Math.floor((studyMinutes || 0) / 60) %>h</span>
                    <span class="stat-lbl">Studied</span>
                </div>
                <div class="stat-card cgpa-card">
                    <div class="stat-icon"><i class="fas fa-award"></i></div>
                    <div class="cgpa-info">
                        <span class="stat-val">
                            <%= calculatedCGPA %>
                            <span class="scale">/ <%= cgpaProfile ? cgpaProfile.grading_scale : '5.0' %></span>
                        </span>
                        <span class="stat-lbl">Current Cumulative GPA</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Account Status -->
        <div class="menu-section">
            <div class="section-label" style="padding: 0 0 12px;">Account</div>
            <div class="menu-card">
                <% if (user.has_paid) { %>
                <div class="menu-item" style="cursor:default;">
                    <div class="menu-left">
                        <div class="menu-icon green"><i class="fas fa-crown"></i></div>
                        <span class="menu-text">Premium is active<span style="display:block;font-size:0.68rem;color:var(--text-muted);font-weight:600;">Lifetime access — no renewals</span></span>
                    </div>
                    <i class="fas fa-circle-check" style="color:var(--success);"></i>
                </div>
                <% } else { %>
                <a href="/upgrade" class="menu-item">
                    <div class="menu-left">
                        <div class="menu-icon orange"><i class="fas fa-crown"></i></div>
                        <span class="menu-text">Upgrade to Premium<span style="display:block;font-size:0.68rem;color:var(--text-muted);font-weight:600;">AI tutor, PDF-to-quiz, CGPA tools & more</span></span>
                    </div>
                    <i class="fas fa-chevron-right menu-chevron"></i>
                </a>
                <% } %>
                <a href="/install" class="menu-item">
                    <div class="menu-left">
                        <div class="menu-icon blue"><i class="fas fa-mobile-screen"></i></div>
                        <span class="menu-text">Install the App<span style="display:block;font-size:0.68rem;color:var(--text-muted);font-weight:600;">Add Prepium to your home screen</span></span>
                    </div>
                    <i class="fas fa-chevron-right menu-chevron"></i>
                </a>
            </div>
        </div>

        <!-- Menu Section -->
        <div class="menu-section">
            <div class="section-label" style="padding: 0 0 12px;">Quick Actions</div>
            <div class="menu-card">
                <a href="/history" class="menu-item">
                    <div class="menu-left">
                        <div class="menu-icon blue"><i class="fas fa-chart-pie"></i></div>
                        <span class="menu-text">View Performance Analytics</span>
                    </div>
                    <i class="fas fa-chevron-right menu-chevron"></i>
                </a>
                <a href="/library" class="menu-item">
                    <div class="menu-left">
                        <div class="menu-icon purple"><i class="fas fa-building-columns"></i></div>
                        <span class="menu-text">Course Library</span>
                    </div>
                    <i class="fas fa-chevron-right menu-chevron"></i>
                </a>
                <a href="/suggestions" class="menu-item">
                    <div class="menu-left">
                        <div class="menu-icon green"><i class="fas fa-lightbulb"></i></div>
                        <span class="menu-text">Send Feedback</span>
                    </div>
                    <i class="fas fa-chevron-right menu-chevron"></i>
                </a>
                <a href="/logout" class="menu-item danger">
                    <div class="menu-left">
                        <div class="menu-icon red"><i class="fas fa-power-off"></i></div>
                        <span class="menu-text">Sign Out</span>
                    </div>
                    <i class="fas fa-chevron-right menu-chevron"></i>
                </a>
            </div>
        </div>

        <!-- Bottom Navigation -->
        <%- include('partials/bottom-nav', { activeNav: 'profile' }) %>

    </div>

</body>
</html>
