<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prepium | Profile</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { --brand: #0062ff; --bg: #f8fafc; --text: #1e293b; --gold: #f59e0b; }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); margin: 0; padding-bottom: 100px; color: var(--text); display: flex; justify-content: center; }
        .app-shell { width: 100%; max-width: 430px; background: white; min-height: 100vh; position: relative; }

        /* Profile Header */
        .header-bg { background: linear-gradient(to bottom, #eef4ff, white); padding: 3rem 1.2rem 1.5rem; text-align: center; }
        .avatar-circle { width: 85px; height: 85px; background: var(--brand); color: white; border-radius: 30px; display: flex; align-items: center; justify-content: center; font-size: 2.2rem; font-weight: 800; margin: 0 auto 1rem; box-shadow: 0 10px 20px rgba(0,98,255,0.2); }
        .name { font-size: 1.4rem; font-weight: 800; margin: 0; }
        .sub-text { font-size: 0.85rem; color: #64748b; margin: 4px 0; }

        /* Stats Grid */
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 0 1.2rem; margin-top: -10px; }
        .stat-card { background: white; border: 1px solid #f1f5f9; padding: 1.2rem; border-radius: 24px; text-align: center; }
        .stat-val { display: block; font-size: 1.3rem; font-weight: 800; color: var(--brand); }
        .stat-lab { font-size: 0.65rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; margin-top: 4px; }

        /* Settings List */
        .menu-list { padding: 1.2rem; }
        .menu-item { display: flex; align-items: center; justify-content: space-between; padding: 1.2rem; background: #f8fafc; border-radius: 20px; margin-bottom: 10px; text-decoration: none; color: inherit; border: 1px solid transparent; transition: 0.2s; }
        .menu-item:active { border-color: var(--brand); background: white; }
        .menu-info { display: flex; align-items: center; gap: 12px; font-weight: 700; font-size: 0.9rem; }
        .menu-icon { font-size: 1.2rem; }

        .logout { color: #ef4444; background: #fef2f2; }

        /* Nav */
        .bottom-nav { position: fixed; bottom: 0; width: 100%; max-width: 430px; background: white; height: 85px; display: flex; justify-content: space-around; align-items: center; border-top: 1px solid #f1f5f9; z-index: 101; }
        .nav-link { text-decoration: none; color: #94a3b8; font-size: 0.7rem; font-weight: 700; text-align: center; }
        .nav-link.active { color: var(--brand); }
        .fab { width: 60px; height: 60px; background: var(--brand); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem; transform: translateY(-28px); border: 5px solid white; box-shadow: 0 10px 20px rgba(0,98,255,0.3); }
    </style>
</head>
<body>

    <div class="app-shell">
        <div class="header-bg">
            <div class="avatar-circle"><%= user.fullname.charAt(0) %></div>
            <h1 class="name"><%= user.fullname %></h1>
            <p class="sub-text"><%= user.email %></p>
            <div style="margin-top: 10px;">
                <span style="background: <%= user.has_paid ? '#dcfce7' : '#fee2e2' %>; color: <%= user.has_paid ? '#15803d' : '#b91c1c' %>; padding: 5px 12px; border-radius: 10px; font-size: 0.65rem; font-weight: 800; text-transform: uppercase;">
                    <%= user.has_paid ? 'Premium Plan' : 'Free Learner' %>
                </span>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-val">🔥 <%= user.current_streak %></span>
                <span class="stat-lab">Day Streak</span>
            </div>
            <div class="stat-card">
                <span class="stat-val">🎯 <%= stats.average %>%</span>
                <span class="stat-lab">Avg. Score</span>
            </div>
            <div class="stat-card">
                <span class="stat-val">📝 <%= stats.total %></span>
                <span class="stat-lab">Tests Taken</span>
            </div>
            <div class="stat-card">
                <span class="stat-val">🌍 1st</span>
                <span class="stat-lab">Global Rank</span>
            </div>
        </div>

        <div class="menu-list">
            <a href="/history" class="menu-item">
                <div class="menu-info"><span class="menu-icon">📜</span> Detailed History</div>
                <span>❯</span>
            </a>
            <% if (!user.has_paid) { %>
            <a href="/dashboard" class="menu-item" style="background: #fffbeb; border: 1px solid #fef3c7;">
                <div class="menu-info"><span class="menu-icon">✨</span> Upgrade to Premium</div>
                <span>❯</span>
            </a>
            <% } %>
            <a href="/logout" class="menu-item logout">
                <div class="menu-info"><span class="menu-icon">🚪</span> Logout</div>
            </a>
        </div>

        <nav class="bottom-nav">
            <a href="/dashboard" class="nav-link"><i>🏠</i><br>Home</a>
            <a href="/history" class="nav-link"><i>📜</i><br>History</a>
            <a href="/setup-test" class="fab">+</a>
            <a href="/notifications" class="nav-link"><i>🔔</i><br>Alerts</a>
            <a href="/profile" class="nav-link active"><i>👤</i><br>Me</a>
        </nav>
    </div>

</body>
</html>