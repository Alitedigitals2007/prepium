<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Quiz Limit Reached</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <style>
        :root { 
            --brand-light: #e6efff;
            --sub: #64748b;
            --white: #ffffff;
        }
        
        body { 
            align-items: center;
            padding: 1.5rem;
        }

        .app-shell { 
            background: var(--white); 
            border-radius: 32px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 40px rgba(0,0,0,0.02);
            padding: 3rem 1.75rem;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .logo-head {
            font-weight: 800; font-size: 1.35rem; color: var(--brand); text-decoration: none;
            letter-spacing: -0.5px; margin-bottom: 2rem; display: inline-block;
        }
        .logo-head span { color: var(--text); }

        .lock-icon {
            width: 72px; height: 72px; border-radius: 50%; background: var(--brand-light);
            color: var(--brand); display: flex; justify-content: center; align-items: center;
            font-size: 1.75rem; margin-bottom: 1.5rem;
            animation: pulse 2s infinite ease-in-out;
        }

        h1 { font-size: 1.45rem; font-weight: 800; margin-bottom: 10px; letter-spacing: -0.5px; }
        p.desc { color: var(--sub); font-size: 0.9rem; font-weight: 600; line-height: 1.55; margin-bottom: 2.25rem; }

        .btn-action {
            background: var(--brand); color: white; border: none; width: 100%; padding: 1.15rem;
            border-radius: 20px; font-size: 0.95rem; font-weight: 800; cursor: pointer; display: flex;
            justify-content: center; align-items: center; gap: 10px; margin-bottom: 12px;
            box-shadow: 0 8px 24px rgba(0, 98, 255, 0.18); transition: all 0.25s; text-decoration: none;
        }
        .btn-action:hover { background: #0056e0; transform: translateY(-1px); }

        .btn-secondary {
            background: var(--bg); color: var(--text); border: 1px solid var(--border);
            width: 100%; padding: 1.15rem; border-radius: 20px; font-size: 0.95rem; font-weight: 800;
            display: flex; justify-content: center; align-items: center; gap: 10px;
            transition: all 0.25s; text-decoration: none;
        }
        .btn-secondary:hover { background: var(--white); border-color: var(--sub); }

        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(0, 98, 255, 0.25); }
            70% { box-shadow: 0 0 0 15px rgba(0, 98, 255, 0); }
            100% { box-shadow: 0 0 0 0 rgba(0, 98, 255, 0); }
        }
    </style>
</head>
<body>

    <div class="app-shell">
        <a href="/" class="logo-head">PREPIUM<span>.</span></a>

        <div class="lock-icon">
            <i class="fas fa-lock"></i>
        </div>

        <h1>Test Limit Reached</h1>
        <p class="desc"><%= message %></p>

        <a href="/dashboard" id="pay-link" class="btn-action">Unlock Unlimited Access ➔</a>
        <a href="/dashboard" class="btn-secondary">Return to Dashboard</a>
    </div>

    <script>
        document.getElementById('pay-link').addEventListener('click', function(e) {
            e.preventDefault();
            const handler = PaystackPop.setup({
                key: '<%= paystack_key %>',
                email: '<%= userEmail %>',
                amount: 1000 * 100,
                currency: 'NGN',
                callback: function(response) {
                    window.location.href = "/verify-payment?reference=" + response.reference;
                }
            });
            handler.openIframe();
        });
    </script>
</body>
</html>