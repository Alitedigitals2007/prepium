<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#2563eb">
    <title>Prepium | Quiz Limit Reached</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="manifest" href="/manifest.json">
    <script src="https://js.paystack.co/v1/inline.js"></script>
    <style>
        
        body { 
            align-items: center;
            padding: 1.5rem;
        }

        .app-shell { 
            background: var(--surface-solid); 
            border-radius: 32px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 40px rgba(0,0,0,0.02);
            padding: 3rem 1.75rem;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .logo-head {
            font-weight: 800; font-size: 1.35rem; color: var(--brand); text-decoration: none;
            letter-spacing: -0.5px; margin-bottom: 2rem; display: inline-block;
        }
        .logo-head span { color: var(--text); }

        .lock-icon {
            width: 72px; height: 72px; border-radius: 50%; background: var(--brand-light);
            color: var(--brand); display: flex; justify-content: center; align-items: center;
            font-size: 1.75rem; margin-bottom: 1.5rem;
            animation: pulse 2s infinite ease-in-out;
        }

        h1 { font-size: 1.45rem; font-weight: 800; margin-bottom: 10px; letter-spacing: -0.5px; }
        p.desc { color: var(--text-secondary); font-size: 0.9rem; font-weight: 600; line-height: 1.55; margin-bottom: 2.25rem; }

        .btn-action {
            background: var(--brand); color: white; border: none; width: 100%; padding: 1.15rem;
            border-radius: 20px; font-size: 0.95rem; font-weight: 800; cursor: pointer; display: flex;
            justify-content: center; align-items: center; gap: 10px; margin-bottom: 12px;
            box-shadow: var(--shadow-lg); transition: all 0.25s; text-decoration: none;
        }
        .btn-action:hover { filter: brightness(0.9); transform: translateY(-1px); }

        .btn-secondary {
            background: var(--bg); color: var(--text); border: 1px solid var(--border);
            width: 100%; padding: 1.15rem; border-radius: 20px; font-size: 0.95rem; font-weight: 800;
            display: flex; justify-content: center; align-items: center; gap: 10px;
            transition: all 0.25s; text-decoration: none;
        }
        .btn-secondary:hover { background: var(--surface-solid); border-color: var(--text-secondary); }

        @media (min-width: 1024px) { .app-shell { padding-left: 0 !important; } }

        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.25); }
            70% { box-shadow: 0 0 0 15px rgba(99, 102, 241, 0); }
            100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0); }
        }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>

    <div class="app-shell">
        <a href="/" class="logo-head">PREPIUM<span>.</span></a>

        <div class="lock-icon">
            <i class="fas fa-lock"></i>
        </div>

        <h1>Test Limit Reached</h1>
        <p class="desc"><%= message %></p>

        <a href="/dashboard" id="pay-link" class="btn-action">Unlock Unlimited Access âž”</a>
        <a href="/dashboard" class="btn-secondary">Return to Dashboard</a>
    </div>

    <script>
        document.getElementById('pay-link').addEventListener('click', function(e) {
            e.preventDefault();
            if (typeof PaystackPop === 'undefined') { alert('Payment system loading. Please try again.'); return; }
            Swal.fire({
                title: 'Have a coupon code?',
                input: 'text',
                inputPlaceholder: 'Enter code or leave blank',
                showCancelButton: true,
                confirmButtonText: 'Continue',
                cancelButtonText: 'No coupon',
                preConfirm: function(val) {
                    if (!val || !val.trim()) return { code: null, amount: <%= premiumPrice %> };
                    return fetch('/api/coupon/validate', {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ code: val.trim() })
                    }).then(function(r) { return r.json(); }).then(function(d) {
                        if (!d.valid) { Swal.showValidationMessage(d.message || 'Invalid code'); return false; }
                        return { code: d.code, amount: d.final_amount, discountLabel: d.discountLabel };
                    });
                },
                allowOutsideClick: false
            }).then(function(result) {
                if (!result || !result.isConfirmed || !result.value) return;
                var info = result.value;
                if (info.discountLabel) {
                    Swal.fire({ icon: 'info', title: info.discountLabel + ' applied!', text: 'You pay â‚¦' + info.amount.toLocaleString(), timer: 2000, showConfirmButton: false });
                }
                var handler = PaystackPop.setup({
                    key: '<%= paystack_key %>',
                    email: '<%= userEmail %>',
                    amount: (info.amount || <%= premiumPrice %>) * 100,
                    currency: 'NGN',
                    callback: function(response) {
                        var dest = '/verify-payment?reference=' + response.reference;
                        if (info.code) dest += '&coupon=' + encodeURIComponent(info.code);
                        window.location.href = dest;
                    }
                });
                setTimeout(function() { handler.openIframe(); }, info.discountLabel ? 2200 : 100);
            });
        });
    </script>
    <script src="/js/animations.js"></script>
</body>
</html>