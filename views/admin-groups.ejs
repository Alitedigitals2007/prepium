<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | Groups</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root { --brand: #2563eb; --bg: #f0f4f8; --text: #0f172a; --border: #e2e8f0; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; padding: 2rem 1.5rem; }
        .main { max-width: 1000px; margin: 0 auto; }
        h1 { font-size: 1.6rem; font-weight: 800; margin-bottom: 0.25rem; }
        p.desc { color: #64748b; font-weight: 600; margin-bottom: 1.5rem; font-size: 0.85rem; }
        .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 10px; }
        .nav-links { display: flex; gap: 8px; flex-wrap: wrap; }
        .nav-links a { padding: 8px 16px; border-radius: 10px; background: white; color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.78rem; border: 1px solid var(--border); }
        .nav-links a:hover { background: var(--brand); color: white; border-color: var(--brand); }
        .card { background: white; border-radius: 20px; padding: 1.5rem; border: 1px solid var(--border); box-shadow: 0 4px 24px rgba(0,0,0,0.04); margin-bottom: 1.5rem; }
        .card h2 { font-size: 1rem; font-weight: 800; margin-bottom: 1rem; }
        .form-row { display: flex; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
        .form-input { flex: 1; padding: 11px 14px; border-radius: 12px; border: 1.5px solid var(--border); font-family: inherit; font-size: 0.85rem; font-weight: 600; background: #f8fafc; outline: none; min-width: 150px; }
        .form-input:focus { border-color: var(--brand); background: white; }
        .btn { padding: 11px 20px; border-radius: 12px; border: none; background: var(--brand); color: white; font-weight: 700; font-size: 0.82rem; cursor: pointer; }
        .btn:hover { opacity: 0.9; }
        .btn.danger { background: #ef4444; }
        .btn.small { padding: 6px 12px; font-size: 0.72rem; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
        .group-card { background: white; border-radius: 16px; padding: 1.25rem; border: 1px solid var(--border); margin-bottom: 1rem; }
        .group-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
        .group-name { font-weight: 800; font-size: 0.95rem; }
        .group-count { font-size: 0.72rem; color: #64748b; font-weight: 600; }
        .member-list { margin-top: 1rem; }
        .member-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid #f1f5f9; font-size: 0.82rem; }
        .remove-btn { color: #ef4444; cursor: pointer; font-size: 0.78rem; background: none; border: none; }
        .msg { padding: 12px 16px; border-radius: 12px; font-weight: 700; font-size: 0.8rem; margin-bottom: 1rem; }
        .msg.success { background: #dcfce7; color: #15803d; }
        .msg.error { background: #fee2e2; color: #b91c1c; }
        @media (max-width: 768px) { .grid-2 { grid-template-columns: 1fr; } .top-bar { flex-direction: column; align-items: flex-start; } }
    </style>
<meta name="theme-color" content="#2563eb">
<%- include('partials/theme-toggle') %>
</head>
<body>
<div class="main">
    <div class="top-bar">
        <div>
            <h1>User Groups</h1>
            <p class="desc">Create groups and assign users for targeted emails</p>
        </div>
        <div class="nav-links">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/students">Students</a>
            <a href="/admin/email">Send Email</a>
        </div>
    </div>

    <% if (typeof query !== 'undefined' && query && query.msg) { %><div class="msg success"><%= query.msg %></div><% } %>
    <% if (typeof query !== 'undefined' && query && query.error) { %><div class="msg error"><%= query.error %></div><% } %>

    <div class="grid-2">
        <div>
            <div class="card">
                <h2>Create Group</h2>
                <form action="/admin/groups/create" method="POST">
                    <div class="form-row">
                        <input type="text" name="name" class="form-input" placeholder="Group name" required>
                    </div>
                    <div class="form-row">
                        <input type="text" name="description" class="form-input" placeholder="Description (optional)">
                    </div>
                    <button type="submit" class="btn">Create Group</button>
                </form>
            </div>

            <div class="card">
                <h2>Add User to Group</h2>
                <form action="/admin/groups/add-user" method="POST">
                    <div class="form-row">
                        <select name="group_id" class="form-input" required>
                            <option value="">Select group</option>
                            <% groups.forEach(function(g) { %>
                                <option value="<%= g.id %>"><%= g.name %></option>
                            <% }) %>
                        </select>
                        <select name="user_id" class="form-input" required>
                            <option value="">Select user</option>
                            <% students.forEach(function(s) { %>
                                <option value="<%= s.id %>"><%= s.fullname %> (<%= s.email %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <button type="submit" class="btn">Add to Group</button>
                </form>
            </div>
        </div>

        <div>
            <h2 style="font-size:0.95rem;font-weight:800;margin-bottom:1rem;">All Groups</h2>
            <% if (groups && groups.length > 0) { %>
                <% groups.forEach(function(g) { %>
                <div class="group-card">
                    <div class="group-header">
                        <div>
                            <div class="group-name"><%= g.name %></div>
                            <div class="group-count"><%= g.member_count || 0 %> members</div>
                        </div>
                        <form action="/admin/groups/delete/<%= g.id %>" method="POST" onsubmit="return confirm('Delete this group?')">
                            <button type="submit" class="btn danger small">Delete</button>
                        </form>
                    </div>
                    <% if (g.description) { %><p style="font-size:0.78rem;color:#64748b;"><%= g.description %></p><% } %>
                </div>
                <% }) %>
            <% } else { %>
                <div class="card" style="text-align:center;color:#94a3b8;">
                    <i class="fas fa-users" style="font-size:2rem;display:block;margin-bottom:0.8rem;"></i>
                    <p>No groups yet. Create one to get started.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>
</body>
</html>