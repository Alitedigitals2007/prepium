<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        :root { --brand: #2563eb; --sidebar: #0b1437; --bg: #f0f4f8; --text: #0f172a; --border: #e2e8f0; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
        .main { max-width: 1000px; margin: 0 auto; padding: 2rem 1.5rem; }
        h1 { font-size: 1.6rem; font-weight: 800; margin-bottom: 0.25rem; }
        p.desc { color: #64748b; font-weight: 600; margin-bottom: 1.5rem; font-size: 0.85rem; }
        .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 10px; }
        .nav-links { display: flex; gap: 8px; flex-wrap: wrap; }
        .nav-links a { padding: 8px 16px; border-radius: 10px; background: white; color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.78rem; border: 1px solid var(--border); }
        .nav-links a:hover { background: var(--brand); color: white; border-color: var(--brand); }
        .table-wrap { background: white; border-radius: 20px; overflow: hidden; border: 1px solid var(--border); box-shadow: 0 4px 24px rgba(0,0,0,0.04); }
        table { width: 100%; border-collapse: collapse; }
        th { background: #f8fafc; padding: 1rem 1.25rem; font-size: 0.68rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; text-align: left; }
        td { padding: 1rem 1.25rem; border-top: 1px solid #f1f5f9; font-size: 0.85rem; font-weight: 600; }
        .badge { padding: 4px 10px; border-radius: 8px; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; }
        .badge.pending { background: #fef3c7; color: #b45309; }
        .badge.approved { background: #dbeafe; color: #1d4ed8; }
        .badge.completed { background: #dcfce7; color: #15803d; }
        .badge.rejected { background: #fee2e2; color: #b91c1c; }
        .status-select { padding: 6px 10px; border-radius: 8px; border: 1.5px solid var(--border); font-family: inherit; font-weight: 600; font-size: 0.78rem; }
        .btn-update { padding: 6px 14px; border-radius: 8px; border: none; background: var(--brand); color: white; font-weight: 700; font-size: 0.72rem; cursor: pointer; }
        .btn-update:hover { opacity: 0.9; }
        .msg { padding: 12px 16px; border-radius: 12px; font-weight: 700; font-size: 0.8rem; margin-bottom: 1rem; }
        .msg.success { background: #dcfce7; color: #15803d; }
        .msg.error { background: #fee2e2; color: #b91c1c; }
        .empty-state { text-align: center; padding: 3rem; color: #94a3b8; }
        .empty-state i { font-size: 2.5rem; display: block; margin-bottom: 0.8rem; }

        @media (max-width: 768px) {
            .main { padding: 1rem; }
            table { font-size: 0.75rem; }
            th, td { padding: 0.75rem 0.8rem; }
            .top-bar { flex-direction: column; align-items: flex-start; }
            .status-select { width: 100%; margin-bottom: 4px; }
            .btn-update { width: 100%; }
        }
    </style>
<meta name="theme-color" content="#2563eb">
<%- include('partials/theme-toggle') %>
</head>
<body>
<div class="main">
    <div class="top-bar">
        <div>
            <h1>Withdrawal Requests</h1>
            <p class="desc">Manage user withdrawal requests</p>
        </div>
        <div class="nav-links">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/students">Students</a>
            <a href="/admin/ambassadors">Referrals</a>
            <a href="/admin/email">Email</a>
        </div>
    </div>

    <% if (typeof query !== 'undefined' && query && query.msg) { %><div class="msg success"><%= query.msg %></div><% } %>
    <% if (typeof query !== 'undefined' && query && query.error) { %><div class="msg error"><%= query.error %></div><% } %>

    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Ambassador</th><th>Amount</th><th>Fee (10%)</th><th>Net</th><th>Bank Details</th><th>Status</th><th>Date</th><th>Action</th></tr>
            </thead>
            <tbody>
                <% if (withdrawals && withdrawals.length > 0) { %>
                    <% withdrawals.forEach(function(w) { %>
                    <tr>
                        <td><%= w.ambassador_name || 'N/A' %><br><small style="font-weight:400;color:#94a3b8;font-size:0.7rem;"><%= w.unique_code || '' %></small></td>
                        <td>₦<%= Number(w.amount_requested).toLocaleString() %></td>
                        <td>₦<%= Number(w.fee_amount).toLocaleString() %></td>
                        <td>₦<%= Number(w.net_payout).toLocaleString() %></td>
                        <td style="max-width:150px;word-break:break-all;font-size:0.75rem;font-weight:500;"><%= w.bank_details %></td>
                        <td><span class="badge <%= w.status %>"><%= w.status %></span></td>
                        <td style="font-size:0.75rem;font-weight:500;"><%= new Date(w.created_at).toLocaleDateString('en-GB', {day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) %></td>
                        <td>
                            <form action="/admin/withdrawals/update/<%= w.id %>" method="POST" style="display:flex;gap:4px;flex-wrap:wrap;">
                                <select name="status" class="status-select">
                                    <option value="pending" <%= w.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                    <option value="approved" <%= w.status === 'approved' ? 'selected' : '' %>>Approved</option>
                                    <option value="completed" <%= w.status === 'completed' ? 'selected' : '' %>>Completed</option>
                                    <option value="rejected" <%= w.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                                </select>
                                <button type="submit" class="btn-update">Update</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="8" class="empty-state"><i class="fas fa-inbox"></i><p>No withdrawal requests yet</p></td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
</body>
</html>