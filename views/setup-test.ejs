<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Exam Setup</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root { 
            --brand: #0062ff; 
            --brand-gradient: linear-gradient(135deg, #0062ff 0%, #0045b5 100%);
            --bg: #f8fafc; 
            --text-dark: #0b1437; 
            --text-sub: #a3aed0;
            --border: #eef2f6;
            --danger: #ff4d4f;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; transition: all 0.2s ease; }
        
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: var(--bg); margin: 0; color: var(--text-dark); 
            display: flex; justify-content: center; 
        }

        .app-shell { 
            width: 100%; max-width: 430px; 
            background: #ffffff; min-height: 100vh; 
            position: relative; padding-bottom: 240px;
        }

        /* Glass Header */
        .header-glass {
            padding: 1.5rem;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            position: sticky; top: 0; z-index: 100;
            border-bottom: 1px solid var(--border);
        }
        
        .top-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px; }
        .back-circle { 
            width: 40px; height: 40px; background: #f1f5f9; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            text-decoration: none; color: var(--text-dark); font-weight: 800;
        }

        .view-switcher { background: #f1f5f9; padding: 4px; border-radius: 12px; display: flex; }
        .v-btn { border: none; background: transparent; padding: 6px 12px; border-radius: 8px; cursor: pointer; color: var(--text-sub); }
        .v-btn.active { background: white; color: var(--brand); box-shadow: 0 4px 10px rgba(0,0,0,0.05); }

        /* Search & Info */
        .search-row { display: flex; gap: 10px; margin-bottom: 12px; }
        .search-bar { 
            flex: 1; background: #f1f5f9; border-radius: 14px; 
            padding: 10px 15px; display: flex; align-items: center; gap: 10px; 
        }
        .search-bar input { border: none; background: transparent; width: 100%; font-family: inherit; font-weight: 600; font-size: 0.85rem; }

        .guide-box {
            background: #f0f7ff; border-radius: 16px; padding: 12px 15px;
            border: 1px solid #e0ecff; margin-bottom: 15px;
        }
        .guide-box p { margin: 0; font-size: 0.72rem; color: #475569; font-weight: 600; line-height: 1.4; }

        /* Course List */
        .section-title { 
            padding: 1rem 1.5rem 0.5rem; font-size: 0.65rem; font-weight: 800; 
            color: var(--text-sub); text-transform: uppercase; letter-spacing: 1px;
            display: flex; justify-content: space-between;
        }

        .course-grid { padding: 0 1.2rem; display: grid; gap: 12px; }
        .course-grid.grid-layout { grid-template-columns: 1fr 1fr; }
        .course-grid.list-layout { grid-template-columns: 1fr; }

        .course-card {
            background: white; border: 1.5px solid var(--border);
            border-radius: 22px; padding: 16px; position: relative;
        }
        .course-card.selected { border-color: var(--brand); background: #fdfdff; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,98,255,0.06); }

        .card-header { display: flex; align-items: center; gap: 10px; cursor: pointer; }
        .custom-check { 
            width: 20px; height: 20px; accent-color: var(--brand); 
        }
        .course-name { font-weight: 800; font-size: 0.85rem; color: var(--text-dark); flex: 1; }

        .avail-tag { 
            display: inline-block; font-size: 0.6rem; font-weight: 800; 
            background: #f1f5f9; color: var(--text-sub); 
            padding: 4px 8px; border-radius: 6px; margin-top: 8px;
        }

        .qty-box { 
            margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--border);
            display: none; animation: fadeIn 0.3s ease;
        }
        .qty-input {
            width: 100%; background: #f8fafc; border: 2px solid #f1f5f9;
            padding: 8px; border-radius: 12px; text-align: center;
            font-weight: 800; color: var(--brand); font-family: inherit;
        }
        .qty-input:focus { border-color: var(--brand); background: white; outline: none; }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }

        /* Summary Footer */
        .summary-panel {
            position: fixed; bottom: 85px; width: 100%; max-width: 430px;
            background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(20px);
            padding: 1.5rem; border-top: 1px solid var(--border); z-index: 99;
        }

        .stats-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .total-display span:first-child { font-size: 0.6rem; font-weight: 800; color: var(--text-sub); text-transform: uppercase; display: block; }
        .total-display span:last-child { font-size: 1.8rem; font-weight: 800; color: var(--text-dark); }

        .timer-config { 
            background: #f1f5f9; padding: 8px 15px; border-radius: 16px;
            display: flex; align-items: center; gap: 8px; border: 1px solid #eef2f6;
        }
        .timer-input { width: 40px; border: none; background: transparent; font-weight: 800; color: var(--brand); font-size: 1.1rem; text-align: center; }

        .btn-launch {
            width: 100%; background: var(--brand-gradient); color: white;
            padding: 18px; border-radius: 20px; border: none;
            font-weight: 800; font-size: 1rem; cursor: pointer;
            box-shadow: 0 10px 25px rgba(0, 98, 255, 0.2);
        }
        .btn-launch:disabled { background: #cbd5e1; box-shadow: none; opacity: 0.6; cursor: not-allowed; }

        /* Bottom Nav */
        .nav-bar { position: fixed; bottom: 0; width: 100%; max-width: 430px; background: white; height: 85px; display: flex; justify-content: space-around; align-items: center; border-top: 1px solid var(--border); z-index: 101; }
        .nav-item { text-decoration: none; color: #94a3b8; font-size: 0.65rem; font-weight: 800; text-align: center; }
        .nav-item.active { color: var(--brand); }
        .nav-item i { display: block; font-size: 1.2rem; margin-bottom: 4px; }
        .nav-fab { width: 56px; height: 56px; background: var(--brand); border-radius: 20px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.5rem; transform: translateY(-25px); border: 5px solid white; box-shadow: 0 8px 20px rgba(0,98,255,0.2); }
    </style>
</head>
<body>

    <div class="app-shell">
        <div class="header-glass">
            <div class="top-row">
                <a href="/dashboard" class="back-circle"><i class="fas fa-chevron-left"></i></a>
                <h2 style="margin:0; font-size:1.1rem; font-weight:800; letter-spacing:-0.5px;">Setup Exam</h2>
                <div class="view-switcher">
                    <button class="v-btn active" id="gBtn" onclick="toggleLayout('grid')"><i class="fas fa-th-large"></i></button>
                    <button class="v-btn" id="lBtn" onclick="toggleLayout('list')"><i class="fas fa-list"></i></button>
                </div>
            </div>

            <div class="guide-box">
                <p>Pick up to 4 courses, set question counts, and choose your preferred duration.</p>
            </div>

            <div class="search-row">
                <div class="search-bar">
                    <i class="fas fa-search" style="color: var(--text-sub); font-size: 0.8rem;"></i>
                    <input type="text" id="courseSearch" placeholder="Search courses..." onkeyup="doSearch()">
                </div>
            </div>
        </div>

        <form action="/start-quiz" method="POST" id="mainForm">
            <div class="section-title">
                <span>Available Courses</span>
                <span id="selCounter" style="color: var(--brand);">0/4 Selected</span>
            </div>

            <div class="course-grid grid-layout" id="courseContainer">
                <% subjects.sort((a,b) => a.name.localeCompare(b.name)).forEach(sub => { %>
                    <div class="course-card" id="card-<%= sub.id %>">
                        <label class="card-header">
                            <input type="checkbox" name="subject_ids" value="<%= sub.id %>" class="custom-check" onchange="handleSelect(this, '<%= sub.id %>')">
                            <span class="course-name"><%= sub.name %></span>
                        </label>
                        <span class="avail-tag"><%= sub.total_questions %> Qs Avail.</span>
                        
                        <div class="qty-box" id="qty-container-<%= sub.id %>">
                            <input type="number" name="questions_<%= sub.id %>" class="qty-input" placeholder="Qty" max="<%= sub.total_questions %>" oninput="calcTotal()">
                        </div>
                    </div>
                <% }) %>
            </div>

            <div class="summary-panel">
                <div class="stats-row">
                    <div class="total-display">
                        <span>Total Questions</span>
                        <span id="sumTotal">0</span>
                    </div>
                    <div class="timer-config">
                        <input type="number" name="duration" class="timer-input" value="30" required>
                        <span style="font-weight: 800; font-size: 0.7rem; color: var(--text-sub);">MINS</span>
                    </div>
                </div>
                <button type="submit" class="btn-launch" id="launchBtn" disabled>Generate Test 🚀</button>
            </div>
        </form>

        <nav class="nav-bar">
            <a href="/dashboard" class="nav-item"><i>🏠</i>Home</a>
            <a href="/history" class="nav-item"><i>📊</i>Stats</a>
            <a href="/setup-test" class="nav-fab"><i class="fas fa-plus"></i></a>
            <a href="/subjects" class="nav-item"><i>📚</i>Library</a>
            <a href="/profile" class="nav-item"><i>👤</i>Me</a>
        </nav>
    </div>

    <script>
        function toggleLayout(type) {
            const container = document.getElementById('courseContainer');
            document.getElementById('gBtn').classList.toggle('active', type === 'grid');
            document.getElementById('lBtn').classList.toggle('active', type === 'list');
            container.className = `course-grid ${type}-layout`;
        }

        function doSearch() {
            const query = document.getElementById('courseSearch').value.toLowerCase();
            document.querySelectorAll('.course-card').forEach(card => {
                const name = card.querySelector('.course-name').innerText.toLowerCase();
                card.style.display = name.includes(query) ? "" : "none";
            });
        }

        function handleSelect(cb, id) {
            const qtyBox = document.getElementById('qty-container-' + id);
            const card = document.getElementById('card-' + id);
            const selected = document.querySelectorAll('input[name="subject_ids"]:checked');

            if (selected.length > 4) {
                cb.checked = false;
                return;
            }

            document.getElementById('selCounter').innerText = `${selected.length}/4 Selected`;
            qtyBox.style.display = cb.checked ? "block" : "none";
            card.classList.toggle('selected', cb.checked);
            
            if (!cb.checked) qtyBox.querySelector('input').value = ""; 
            calcTotal();
        }

        function calcTotal() {
            let total = 0, hasError = false;
            document.querySelectorAll('input[name="subject_ids"]:checked').forEach(cb => {
                const input = document.querySelector(`input[name="questions_${cb.value}"]`);
                const val = parseInt(input.value) || 0;
                const max = parseInt(input.max);
                
                if (val > max || val <= 0) {
                    input.style.borderColor = "var(--danger)";
                    hasError = true;
                } else {
                    input.style.borderColor = "#eef2f6";
                    total += val;
                }
            });
            document.getElementById('sumTotal').innerText = total;
            document.getElementById('launchBtn').disabled = (total === 0 || hasError);
        }
    </script>
</body>
</html>