<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        .app-shell { padding-bottom: 240px; }

        .top-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
        .back-circle { 
            width: 42px; height: 42px; 
            background: rgba(255,255,255,0.8); border: 1px solid rgba(255,255,255,0.9);
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            text-decoration: none; color: var(--text-primary);
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        }
        .page-title { font-size: 1.15rem; font-weight: 800; letter-spacing: -0.5px; }

        .view-switcher { 
            background: rgba(255,255,255,0.8); padding: 4px; border-radius: 12px; 
            display: flex; border: 1px solid rgba(255,255,255,0.9);
        }
        .v-btn { 
            border: none; background: transparent; padding: 8px 12px; border-radius: 10px; 
            cursor: pointer; color: var(--text-sub); font-size: 0.8rem;
            transition: all 0.3s ease;
        }
        .v-btn.active { 
            background: var(--brand-gradient); color: white; 
            box-shadow: var(--shadow-lg);
        }

        .guide-box {
            background: var(--brand-light);
            border: 1px solid rgba(99, 102, 241, 0.1);
            border-radius: 16px; padding: 16px 18px;
            margin-bottom: 14px;
        }
        .guide-box .guide-steps { margin: 0; padding: 0; list-style: none; }
        .guide-box .guide-steps li {
            font-size: 0.78rem; color: var(--text-secondary);
            font-weight: 600; line-height: 1.5; padding: 4px 0;
            display: flex; align-items: flex-start; gap: 8px;
        }
        .guide-box .guide-steps li .step-num {
            width: 20px; height: 20px; border-radius: 50%;
            background: var(--brand); color: white; font-size: 0.6rem;
            font-weight: 800; display: flex; align-items: center;
            justify-content: center; flex-shrink: 0; margin-top: 2px;
        }
        .guide-box .guide-icon { color: var(--brand); margin-right: 6px; }
        .guide-box .guide-head {
            font-size: 0.85rem; font-weight: 800; color: var(--text-primary);
            margin-bottom: 8px; display: flex; align-items: center; gap: 6px;
        }

        .section-title { padding-left: 14px !important; padding-right: 14px !important; }
        .search-row { display: flex; gap: 10px; margin: 0 14px; }
        .search-bar { 
            flex: 1; 
            background: rgba(255,255,255,0.8); 
            border: 1px solid rgba(255,255,255,0.9);
            border-radius: 14px; 
            padding: 12px 16px; display: flex; align-items: center; gap: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }
        .search-bar input { 
            border: none; background: transparent; width: 100%; 
            font-family: inherit; font-weight: 600; font-size: 0.85rem; 
            color: var(--text-primary); outline: none;
        }
        .search-bar input::placeholder { color: var(--text-sub); }

        .course-grid { padding: 0 14px; display: grid; gap: 12px; }
        .course-grid.grid-layout { grid-template-columns: 1fr 1fr; }
        .course-grid.list-layout { grid-template-columns: 1fr; }

        .course-card {
            background: rgba(255,255,255,0.7);
            border: 1.5px solid rgba(255,255,255,0.8);
            border-radius: 20px; padding: 16px; position: relative;
            box-shadow: 0 2px 12px rgba(0,0,0,0.02);
            transition: all 0.3s ease;
        }
        .course-card.selected { 
            border-color: var(--brand); 
            background: var(--brand-light);
            box-shadow: 0 4px 20px rgba(99, 102, 241, 0.12);
        }

        .card-header { display: flex; align-items: center; gap: 12px; cursor: pointer; }
        .custom-check { 
            width: 22px; height: 22px; accent-color: var(--brand);
            cursor: pointer;
        }
        .course-name { 
            font-weight: 800; font-size: 0.88rem; color: var(--text-dark); 
            flex: 1; line-height: 1.2;
        }

        .avail-tag { 
            display: inline-flex; align-items: center; gap: 4px;
            font-size: 0.62rem; font-weight: 700; 
            background: var(--brand-light); color: var(--brand);
            padding: 4px 10px; border-radius: 8px; margin-top: 10px;
        }

        .qty-box { 
            margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--border);
            display: none; animation: fadeIn 0.3s ease;
        }
        .qty-input {
            width: 100%; 
            background: var(--surface); 
            border: 2px solid var(--border);
            padding: 10px; border-radius: 12px; text-align: center;
            font-weight: 800; color: var(--brand); font-family: inherit;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }
        .qty-input:focus { border-color: var(--brand); background: white; outline: none; }
        .qty-input.error { border-color: var(--danger); }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }

        .summary-panel {
            position: fixed; bottom: 100px;
            left: 50%; transform: translateX(-50%);
            width: calc(100% - 28px); max-width: 430px;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            padding: 1.25rem 1.5rem; 
            border: 1px solid rgba(255,255,255,0.8);
            border-radius: 20px;
            z-index: 99;
            box-shadow: 0 -4px 30px rgba(0,0,0,0.06);
        }

        .stats-row { 
            display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; 
        }
        .total-display span:first-child { 
            font-size: 0.6rem; font-weight: 800; color: var(--text-secondary); 
            text-transform: uppercase; letter-spacing: 0.5px; display: block; 
        }
        .total-display span:last-child { 
            font-size: 1.8rem; font-weight: 800; color: var(--text-primary); 
            letter-spacing: -1px;
        }

        .timer-config { 
            background: var(--surface); 
            border: 1px solid var(--border);
            padding: 10px 16px; border-radius: 16px;
            display: flex; align-items: center; gap: 8px;
        }
        .timer-config i { color: var(--brand); font-size: 0.9rem; }
        .timer-input { 
            width: 45px; border: none; background: transparent; 
            font-weight: 800; color: var(--brand); font-size: 1.1rem; 
            text-align: center; font-family: inherit;
        }
        .timer-label { font-weight: 700; font-size: 0.65rem; color: var(--text-secondary); text-transform: uppercase; }

        .btn-launch {
            width: 100%; background: var(--brand-gradient); color: white;
            padding: 18px; border-radius: 18px; border: none;
            font-weight: 800; font-size: 0.95rem; cursor: pointer;
            box-shadow: var(--shadow-lg);
            display: flex; align-items: center; justify-content: center; gap: 10px;
            transition: all 0.3s ease;
            letter-spacing: -0.2px;
        }
        .btn-launch:active { transform: scale(0.98); }
        .btn-launch:disabled { 
            background: var(--text-muted); 
            box-shadow: none; cursor: not-allowed; 
        }
        .btn-launch:disabled:active { transform: none; }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/sidebar') %>

    <div class="app-shell">
        <div class="header-nav">
            <a href="/dashboard" class="back-circle" title="Back"><i class="fas fa-arrow-left"></i></a>
            <div class="header-title">Setup Test</div>
            <div style="width:42px"></div>
        </div>

        <div style="padding: 0 14px; margin-bottom: 12px;">
            <div class="search-bar" style="background:rgba(255,255,255,0.8);border:1px solid rgba(255,255,255,0.9);border-radius:14px;padding:12px 16px;display:flex;align-items:center;gap:10px;">
                <i class="fas fa-search" style="color: var(--text-sub); font-size: 0.85rem;"></i>
                <input type="text" id="courseSearch" placeholder="Search courses..." onkeyup="doSearch()" style="border:none;background:transparent;width:100%;font-family:inherit;font-weight:600;font-size:0.85rem;color:var(--text-dark);outline:none;">
            </div>
        </div>

        <form action="/start-quiz" method="POST" id="mainForm">
            <div class="section-title">
                <span>Available Courses</span>
                <span id="selCounter" style="color: var(--brand); font-size: 0.7rem;">0/4 Selected</span>
            </div>

            <div class="course-grid grid-layout" id="courseContainer">
                <% subjects.sort((a,b) => a.name.localeCompare(b.name)).forEach(sub => { %>
                    <div class="course-card" id="card-<%= sub.id %>">
                        <label class="card-header">
                            <input type="checkbox" name="subject_ids" value="<%= sub.id %>" class="custom-check" onchange="handleSelect(this, '<%= sub.id %>')">
                            <span class="course-name"><%= sub.name %></span>
                        </label>
                        <span class="avail-tag"><i class="fas fa-database"></i> <%= sub.total_questions %> Questions</span>
                        
                        <div class="qty-box" id="qty-container-<%= sub.id %>">
                            <input type="number" name="questions_<%= sub.id %>" class="qty-input" placeholder="How many?" max="<%= sub.total_questions %>" oninput="calcTotal()">
                        </div>
                    </div>
                <% }) %>
            </div>

            <div class="summary-panel">
                <div class="stats-row">
                    <div class="total-display">
                        <span>Total Questions</span>
                        <span id="sumTotal">0</span>
                    </div>
                    <div class="timer-config">
                        <i class="fas fa-clock"></i>
                        <input type="number" name="duration" class="timer-input" value="30" required>
                        <span class="timer-label">mins</span>
                    </div>
                </div>
                <button type="submit" class="btn-launch" id="launchBtn" disabled>
                    <span>Generate Test</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </form>

        <%- include('partials/bottom-nav', { activeNav: 'quiz' }) %>
    </div>

    <script>
        function toggleLayout(type) {
            const container = document.getElementById('courseContainer');
            document.getElementById('gBtn').classList.toggle('active', type === 'grid');
            document.getElementById('lBtn').classList.toggle('active', type === 'list');
            container.className = `course-grid ${type}-layout`;
        }

        function doSearch() {
            const query = document.getElementById('courseSearch').value.toLowerCase();
            document.querySelectorAll('.course-card').forEach(card => {
                const name = card.querySelector('.course-name').innerText.toLowerCase();
                card.style.display = name.includes(query) ? "" : "none";
            });
        }

        function handleSelect(cb, id) {
            const qtyBox = document.getElementById('qty-container-' + id);
            const card = document.getElementById('card-' + id);
            const selected = document.querySelectorAll('input[name="subject_ids"]:checked');

            if (selected.length > 4) {
                cb.checked = false;
                return;
            }

            document.getElementById('selCounter').innerText = `${selected.length}/4 Selected`;
            qtyBox.style.display = cb.checked ? "block" : "none";
            card.classList.toggle('selected', cb.checked);
            
            if (!cb.checked) qtyBox.querySelector('input').value = ""; 
            calcTotal();
        }

        function calcTotal() {
            let total = 0, hasError = false;
            document.querySelectorAll('input[name="subject_ids"]:checked').forEach(cb => {
                const input = document.querySelector(`input[name="questions_${cb.value}"]`);
                const val = parseInt(input.value) || 0;
                const max = parseInt(input.max);
                
                if (val > max || val <= 0) {
                    input.classList.add('error');
                    hasError = true;
                } else {
                    input.classList.remove('error');
                    total += val;
                }
            });
            document.getElementById('sumTotal').innerText = total;
            document.getElementById('launchBtn').disabled = (total === 0 || hasError);
        }
    </script>
</body>
</html>
