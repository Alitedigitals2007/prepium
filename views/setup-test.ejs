<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Setup Test</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { --brand: #0062ff; --bg: #f8fafc; --text: #1e293b; --danger: #ef4444; }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; outline: none; }
        
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); margin: 0; padding-bottom: 240px; color: var(--text); display: flex; justify-content: center; }
        .app-shell { width: 100%; max-width: 430px; background: white; min-height: 100vh; position: relative; }

        /* Header Area */
        .header-fixed { position: sticky; top: 0; background: white; z-index: 100; border-bottom: 1px solid #f1f5f9; padding-bottom: 10px; }
        .top-bar { padding: 1.2rem 1.2rem 0.5rem; display: flex; align-items: center; justify-content: space-between; }
        .back-btn { text-decoration: none; font-size: 1.4rem; color: var(--text); font-weight: 800; }
        
        .search-container { padding: 0 1.2rem; margin-top: 10px; display: flex; gap: 10px; align-items: center; }
        .search-box { background: #f1f5f9; border-radius: 14px; padding: 10px 14px; display: flex; align-items: center; gap: 10px; flex: 1; border: 1.5px solid transparent; }
        .search-input { border: none; background: transparent; width: 100%; font-family: inherit; font-weight: 600; font-size: 0.9rem; }
        
        /* View Toggle Switch */
        .view-toggle { background: #f1f5f9; border-radius: 12px; display: flex; padding: 4px; border: 1px solid #e2e8f0; }
        .view-btn { border: none; background: transparent; padding: 6px 12px; border-radius: 8px; cursor: pointer; transition: 0.2s; font-size: 1rem; }
        .view-btn.active { background: white; box-shadow: 0 4px 8px rgba(0,0,0,0.06); }

        .section-label { padding: 1.5rem 1.2rem 0.8rem; font-size: 0.7rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; display: flex; justify-content: space-between; }

        /* Subject Layouts */
        .subject-container { padding: 0 1.2rem; display: grid; gap: 12px; transition: 0.3s; }
        
        /* Grid Mode Styles */
        .subject-container.grid-view { grid-template-columns: 1fr 1fr; }
        .subject-container.grid-view .subject-card { text-align: center; }
        .subject-container.grid-view .subject-main { justify-content: center; }
        
        /* List Mode Styles */
        .subject-container.list-view { grid-template-columns: 1fr; }
        .subject-container.list-view .subject-card { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.2rem; }
        .subject-container.list-view .input-area { margin-top: 0; border: none; padding-top: 0; width: 80px; }

        .subject-card {
            background: #ffffff;
            border: 1.5px solid #f1f5f9;
            border-radius: 20px;
            padding: 1.2rem;
            transition: all 0.25s ease;
        }
        .subject-card.active { border-color: var(--brand); background: #f0f7ff; }

        .check-container { display: flex; align-items: center; gap: 10px; cursor: pointer; font-weight: 700; font-size: 0.9rem; }
        .check-container input { width: 20px; height: 20px; accent-color: var(--brand); border-radius: 6px; }
        
        .q-limit-pill { font-size: 0.6rem; font-weight: 800; color: #64748b; background: #f1f5f9; padding: 4px 8px; border-radius: 6px; display: inline-block; margin-top: 5px; }

        .input-area { 
            margin-top: 12px; 
            display: none; 
            border-top: 1px solid rgba(0,0,0,0.05); 
            padding-top: 12px; 
            animation: fadeIn 0.2s ease;
        }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        .qty-input { width: 100%; padding: 8px; border-radius: 10px; border: 1.5px solid #e2e8f0; font-weight: 800; text-align: center; color: var(--brand); }
        .qty-input:focus { border-color: var(--brand); background: white; }

        /* Floating Summary Footer */
        .summary-footer { position: fixed; bottom: 85px; width: 100%; max-width: 430px; background: rgba(255,255,255,0.9); backdrop-filter: blur(15px); padding: 1.2rem; border-top: 1px solid #f1f5f9; z-index: 99; box-shadow: 0 -10px 25px rgba(0,0,0,0.03); }
        .total-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        
        .time-selector { background: white; padding: 10px 14px; border-radius: 16px; border: 1.5px solid #e2e8f0; display: flex; align-items: center; gap: 8px; }
        .time-input { width: 45px; border: none; font-weight: 800; text-align: center; font-size: 1.1rem; color: var(--brand); }

        .start-btn { background: var(--brand); color: white; padding: 1.1rem; border-radius: 18px; border: none; width: 100%; font-weight: 800; font-size: 1rem; box-shadow: 0 10px 20px rgba(0,98,255,0.2); transition: 0.2s; cursor: pointer; }
        .start-btn:disabled { background: #cbd5e1; box-shadow: none; cursor: not-allowed; }

        /* Navigation */
        .bottom-nav { position: fixed; bottom: 0; width: 100%; max-width: 430px; background: white; height: 85px; display: flex; justify-content: space-around; align-items: center; border-top: 1px solid #f1f5f9; z-index: 101; padding-bottom: 10px; }
        .nav-link { text-decoration: none; color: #94a3b8; font-size: 0.65rem; font-weight: 800; text-align: center; }
        .nav-link.active { color: var(--brand); }
        .nav-link i { display: block; font-size: 1.4rem; margin-bottom: 4px; font-style: normal; }
        .fab { width: 62px; height: 62px; background: var(--brand); border-radius: 22px; display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem; transform: translateY(-25px); border: 5px solid white; box-shadow: 0 10px 20px rgba(0,98,255,0.2); text-decoration: none; }
    </style>
</head>
<body>

    <div class="app-shell">
        <div class="header-fixed">
            <header class="top-bar">
                <a href="/dashboard" class="back-btn">←</a>
                <h2 style="margin:0; font-size:1.1rem; font-weight:800;">Exam Setup</h2>
                <div class="view-toggle">
                    <button class="view-btn active" id="gridBtn" onclick="switchView('grid')">▤</button>
                    <button class="view-btn" id="listBtn" onclick="switchView('list')">☰</button>
                </div>
            </header>

            <div class="search-container">
                <div class="search-box">
                    <span>🔍</span>
                    <input type="text" id="subjectSearch" class="search-input" placeholder="Search subjects..." onkeyup="filterSubjects()">
                </div>
            </div>
        </div>

        <form action="/start-quiz" method="POST" id="quizForm">
            <div class="section-label">
                <span>Available Subjects</span>
                <span id="selectionCount" style="color: var(--brand);">0/4 Selected</span>
            </div>
            
            <div class="subject-container grid-view" id="subjectList">
                <% subjects.forEach(sub => { %>
                    <div class="subject-card" id="wrapper-<%= sub.id %>">
                        <div class="subject-main">
                            <label class="check-container">
                                <input type="checkbox" name="subject_ids" value="<%= sub.id %>" onchange="toggleSubject(this, '<%= sub.id %>')">
                                <span class="subject-name text-capitalize"><%= sub.name %></span>
                            </label>
                        </div>
                        <div class="info-row"><span class="q-limit-pill"><%= sub.total_questions %> Qs</span></div>
                        
                        <div class="input-area" id="input-container-<%= sub.id %>">
                            <input type="number" name="questions_<%= sub.id %>" class="qty-input" placeholder="Qty" max="<%= sub.total_questions %>" oninput="validateAndTotal()">
                        </div>
                    </div>
                <% }) %>
            </div>

            <div class="summary-footer">
                <div class="total-row">
                    <div>
                        <span style="font-size: 0.6rem; font-weight: 800; color: #94a3b8; text-transform: uppercase;">Total Questions</span>
                        <span style="font-size: 1.6rem; font-weight: 800; display: block; line-height: 1.2;" id="displayTotal">0</span>
                    </div>
                    <div class="time-selector">
                        <div style="text-align: right;">
                            <span style="font-size: 0.55rem; font-weight: 800; color: #94a3b8; display: block;">TIME</span>
                            <input type="number" name="duration" class="time-input" placeholder="0" required>
                        </div>
                        <span style="font-weight: 800; font-size: 0.8rem; color: #64748b;">min</span>
                    </div>
                </div>
                <button type="submit" class="start-btn" id="submitBtn" disabled>Generate Test 🚀</button>
            </div>
        </form>

        <nav class="bottom-nav">
            <a href="/dashboard" class="nav-link"><i>🏠</i>Home</a>
            <a href="/history" class="nav-link"><i>📊</i>Stats</a>
            <a href="/setup-test" class="fab">+</a>
            <a href="/subjects" class="nav-link"><i>📚</i>Library</a>
            <a href="/profile" class="nav-link"><i>👤</i>Me</a>
        </nav>
    </div>

    <script>
        // Switch between Grid and List view
        function switchView(type) {
            const list = document.getElementById('subjectList');
            const gridBtn = document.getElementById('gridBtn');
            const listBtn = document.getElementById('listBtn');
            
            if (type === 'grid') {
                list.classList.replace('list-view', 'grid-view');
                gridBtn.classList.add('active');
                listBtn.classList.remove('active');
            } else {
                list.classList.replace('grid-view', 'list-view');
                listBtn.classList.add('active');
                gridBtn.classList.remove('active');
            }
        }

        // Search logic
        function filterSubjects() {
            const input = document.getElementById('subjectSearch').value.toLowerCase();
            const cards = document.getElementsByClassName('subject-card');
            for (let card of cards) {
                const name = card.querySelector('.subject-name').innerText.toLowerCase();
                card.style.display = name.includes(input) ? "" : "none";
            }
        }

        // Toggle question inputs when checkbox is clicked
        function toggleSubject(checkbox, id) {
            const container = document.getElementById('input-container-' + id);
            const wrapper = document.getElementById('wrapper-' + id);
            const selected = document.querySelectorAll('input[name="subject_ids"]:checked');

            if (selected.length > 4) {
                checkbox.checked = false;
                alert("You can only choose up to 4 subjects.");
                return;
            }

            document.getElementById('selectionCount').innerText = `${selected.length}/4 Selected`;
            container.style.display = checkbox.checked ? "block" : "none";
            wrapper.classList.toggle('active', checkbox.checked);
            
            if (!checkbox.checked) {
                container.querySelector('input').value = ""; 
            }
            validateAndTotal();
        }

        // Calculate total questions and enable button
        function validateAndTotal() {
            let total = 0;
            let error = false;
            const checked = document.querySelectorAll('input[name="subject_ids"]:checked');
            
            checked.forEach(cb => {
                const input = document.querySelector(`input[name="questions_${cb.value}"]`);
                const val = parseInt(input.value) || 0;
                const max = parseInt(input.max);
                
                if (val > max) {
                    input.style.borderColor = "var(--danger)";
                    error = true;
                } else {
                    input.style.borderColor = "#e2e8f0";
                    total += val;
                }
            });

            document.getElementById('displayTotal').innerText = total;
            document.getElementById('submitBtn').disabled = (total === 0 || error);
        }
    </script>
</body>
</html>
