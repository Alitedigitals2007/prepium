<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Exam Setup</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root { 
            --brand: #0062ff; 
            --brand-gradient: linear-gradient(135deg, #0062ff 0%, #4f46e5 100%);
            --bg: #f8fafc; 
            --text-dark: #0f172a; 
            --text-sub: #64748b;
            --border: #e2e8f0;
            --danger: #ef4444;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: radial-gradient(circle at top right, #eff6ff 0%, #dbeafe 40%, #e2e8f0 100%);
            background-attachment: fixed;
            margin: 0; color: var(--text-dark); 
            display: flex; justify-content: center; 
            min-height: 100vh;
        }

        .app-shell { 
            width: 100%; max-width: 430px; 
            background: rgba(248, 250, 252, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            min-height: 100vh; 
            position: relative; padding-bottom: 140px;
            border-left: 1px solid rgba(255,255,255,0.7);
            border-right: 1px solid rgba(255,255,255,0.7);
        }

        /* Header */
        .header-glass {
            padding: 1.25rem 1.5rem;
            background: rgba(255,255,255,0.5);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            position: sticky; top: 0; z-index: 100;
            border-bottom: 1px solid rgba(255,255,255,0.7);
        }
        
        .top-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
        .back-circle { 
            width: 42px; height: 42px; 
            background: rgba(255,255,255,0.8); border: 1px solid rgba(255,255,255,0.9);
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            text-decoration: none; color: var(--text-dark);
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        }
        .page-title { font-size: 1.15rem; font-weight: 800; letter-spacing: -0.5px; }

        .view-switcher { 
            background: rgba(255,255,255,0.8); padding: 4px; border-radius: 12px; 
            display: flex; border: 1px solid rgba(255,255,255,0.9);
        }
        .v-btn { 
            border: none; background: transparent; padding: 8px 12px; border-radius: 10px; 
            cursor: pointer; color: var(--text-sub); font-size: 0.8rem;
            transition: all 0.3s ease;
        }
        .v-btn.active { 
            background: var(--brand-gradient); color: white; 
            box-shadow: 0 2px 8px rgba(0, 98, 255, 0.2);
        }

        /* Guide Box */
        .guide-box {
            background: linear-gradient(135deg, rgba(0, 98, 255, 0.06) 0%, rgba(79, 70, 229, 0.06) 100%);
            border: 1px solid rgba(0, 98, 255, 0.08);
            border-radius: 16px; padding: 14px 16px;
            margin-bottom: 14px;
        }
        .guide-box p { 
            margin: 0; font-size: 0.78rem; color: var(--text-sub); 
            font-weight: 600; line-height: 1.5; 
        }
        .guide-box i { color: var(--brand); margin-right: 6px; }

        /* Search */
        .search-row { display: flex; gap: 10px; }
        .search-bar { 
            flex: 1; 
            background: rgba(255,255,255,0.8); 
            border: 1px solid rgba(255,255,255,0.9);
            border-radius: 14px; 
            padding: 12px 16px; display: flex; align-items: center; gap: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        }
        .search-bar input { 
            border: none; background: transparent; width: 100%; 
            font-family: inherit; font-weight: 600; font-size: 0.85rem; 
            color: var(--text-dark); outline: none;
        }
        .search-bar input::placeholder { color: var(--text-sub); }

        /* Section Title */
        .section-title { 
            padding: 1.25rem 1.5rem 0.75rem; font-size: 0.65rem; font-weight: 800; 
            color: var(--text-sub); text-transform: uppercase; letter-spacing: 1px;
            display: flex; justify-content: space-between; align-items: center;
        }

        /* Course Grid */
        .course-grid { padding: 0 1.2rem; display: grid; gap: 12px; }
        .course-grid.grid-layout { grid-template-columns: 1fr 1fr; }
        .course-grid.list-layout { grid-template-columns: 1fr; }

        .course-card {
            background: rgba(255,255,255,0.7);
            border: 1.5px solid rgba(255,255,255,0.8);
            border-radius: 20px; padding: 16px; position: relative;
            box-shadow: 0 2px 12px rgba(0,0,0,0.02);
            transition: all 0.3s ease;
        }
        .course-card.selected { 
            border-color: var(--brand); 
            background: rgba(0, 98, 255, 0.04);
            box-shadow: 0 4px 20px rgba(0,98,255,0.1);
        }

        .card-header { display: flex; align-items: center; gap: 12px; cursor: pointer; }
        .custom-check { 
            width: 22px; height: 22px; accent-color: var(--brand);
            cursor: pointer;
        }
        .course-name { 
            font-weight: 800; font-size: 0.88rem; color: var(--text-dark); 
            flex: 1; line-height: 1.2;
        }

        .avail-tag { 
            display: inline-flex; align-items: center; gap: 4px;
            font-size: 0.62rem; font-weight: 700; 
            background: rgba(0, 98, 255, 0.06); color: var(--brand);
            padding: 4px 10px; border-radius: 8px; margin-top: 10px;
        }

        .qty-box { 
            margin-top: 12px; padding-top: 12px; border-top: 1px dashed rgba(226,232,240,0.6);
            display: none; animation: fadeIn 0.3s ease;
        }
        .qty-input {
            width: 100%; 
            background: rgba(255,255,255,0.8); 
            border: 2px solid rgba(226,232,240,0.6);
            padding: 10px; border-radius: 12px; text-align: center;
            font-weight: 800; color: var(--brand); font-family: inherit;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }
        .qty-input:focus { border-color: var(--brand); background: white; outline: none; }
        .qty-input.error { border-color: var(--danger); }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }

        /* Summary Panel */
        .summary-panel {
            position: fixed; bottom: 90px; width: 100%; max-width: 430px;
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            padding: 1.25rem 1.5rem; 
            border-top: 1px solid rgba(255,255,255,0.7);
            z-index: 99;
            box-shadow: 0 -4px 20px rgba(0,0,0,0.03);
        }

        .stats-row { 
            display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; 
        }
        .total-display span:first-child { 
            font-size: 0.6rem; font-weight: 800; color: var(--text-sub); 
            text-transform: uppercase; letter-spacing: 0.5px; display: block; 
        }
        .total-display span:last-child { 
            font-size: 1.8rem; font-weight: 800; color: var(--text-dark); 
            letter-spacing: -1px;
        }

        .timer-config { 
            background: rgba(255,255,255,0.8); 
            border: 1px solid rgba(226,232,240,0.6);
            padding: 10px 16px; border-radius: 16px;
            display: flex; align-items: center; gap: 8px;
        }
        .timer-config i { color: var(--brand); font-size: 0.9rem; }
        .timer-input { 
            width: 45px; border: none; background: transparent; 
            font-weight: 800; color: var(--brand); font-size: 1.1rem; 
            text-align: center; font-family: inherit;
        }
        .timer-label { font-weight: 700; font-size: 0.65rem; color: var(--text-sub); text-transform: uppercase; }

        .btn-launch {
            width: 100%; background: var(--brand-gradient); color: white;
            padding: 18px; border-radius: 18px; border: none;
            font-weight: 800; font-size: 0.95rem; cursor: pointer;
            box-shadow: 0 8px 24px rgba(0, 98, 255, 0.25);
            display: flex; align-items: center; justify-content: center; gap: 10px;
            transition: all 0.3s ease;
            letter-spacing: -0.2px;
        }
        .btn-launch:active { transform: scale(0.98); }
        .btn-launch:disabled { 
            background: linear-gradient(135deg, #cbd5e1, #94a3b8); 
            box-shadow: none; cursor: not-allowed; 
        }
        .btn-launch:disabled:active { transform: none; }

        /* Bottom Nav */
        .bottom-nav {
            position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
            width: calc(100% - 40px); max-width: 390px; 
            background: rgba(255,255,255,0.85); 
            backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px);
            height: 70px; border-radius: 24px; 
            display: flex; justify-content: space-around; 
            align-items: center; z-index: 1000;
            border: 1px solid rgba(255,255,255,0.7);
            box-shadow: 0 8px 32px rgba(0, 98, 255, 0.08);
        }
        .nav-link { 
            text-decoration: none; color: var(--text-sub); text-align: center; 
            font-size: 0.58rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.3px;
            display: flex; flex-direction: column; align-items: center; gap: 4px;
        }
        .nav-link i { font-size: 1.1rem; }
        .nav-link.active { color: var(--brand); }
        .nav-center-btn {
            width: 48px; height: 48px; background: var(--brand-gradient); border-radius: 14px;
            display: flex; align-items: center; justify-content: center; color: white; font-size: 1rem;
            transform: translateY(-10px);
            box-shadow: 0 4px 16px rgba(0, 98, 255, 0.25);
            text-decoration: none;
        }
    </style>
</head>
<body>

    <div class="app-shell">
        <div class="header-glass">
            <div class="top-row">
                <a href="/dashboard" class="back-circle"><i class="fas fa-chevron-left"></i></a>
                <span class="page-title">Setup Exam</span>
                <div class="view-switcher">
                    <button class="v-btn active" id="gBtn" onclick="toggleLayout('grid')"><i class="fas fa-th-large"></i></button>
                    <button class="v-btn" id="lBtn" onclick="toggleLayout('list')"><i class="fas fa-list"></i></button>
                </div>
            </div>

            <div class="guide-box">
                <p><i class="fas fa-info-circle"></i> Pick up to 4 courses, set question counts, and choose your preferred duration.</p>
            </div>

            <div class="search-row">
                <div class="search-bar">
                    <i class="fas fa-search" style="color: var(--text-sub); font-size: 0.85rem;"></i>
                    <input type="text" id="courseSearch" placeholder="Search courses..." onkeyup="doSearch()">
                </div>
            </div>
        </div>

        <form action="/start-quiz" method="POST" id="mainForm">
            <div class="section-title">
                <span>Available Courses</span>
                <span id="selCounter" style="color: var(--brand); font-size: 0.7rem;">0/4 Selected</span>
            </div>

            <div class="course-grid grid-layout" id="courseContainer">
                <% subjects.sort((a,b) => a.name.localeCompare(b.name)).forEach(sub => { %>
                    <div class="course-card" id="card-<%= sub.id %>">
                        <label class="card-header">
                            <input type="checkbox" name="subject_ids" value="<%= sub.id %>" class="custom-check" onchange="handleSelect(this, '<%= sub.id %>')">
                            <span class="course-name"><%= sub.name %></span>
                        </label>
                        <span class="avail-tag"><i class="fas fa-database"></i> <%= sub.total_questions %> Questions</span>
                        
                        <div class="qty-box" id="qty-container-<%= sub.id %>">
                            <input type="number" name="questions_<%= sub.id %>" class="qty-input" placeholder="How many?" max="<%= sub.total_questions %>" oninput="calcTotal()">
                        </div>
                    </div>
                <% }) %>
            </div>

            <div class="summary-panel">
                <div class="stats-row">
                    <div class="total-display">
                        <span>Total Questions</span>
                        <span id="sumTotal">0</span>
                    </div>
                    <div class="timer-config">
                        <i class="fas fa-clock"></i>
                        <input type="number" name="duration" class="timer-input" value="30" required>
                        <span class="timer-label">mins</span>
                    </div>
                </div>
                <button type="submit" class="btn-launch" id="launchBtn" disabled>
                    <span>Generate Test</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </form>

        <nav class="bottom-nav">
            <a href="/dashboard" class="nav-link">
                <i class="fas fa-home"></i><span>Home</span>
            </a>
            <a href="/history" class="nav-link">
                <i class="fas fa-chart-bar"></i><span>Stats</span>
            </a>
            <a href="/setup-test" class="nav-center-btn"><i class="fas fa-plus"></i></a>
            <a href="/notifications" class="nav-link">
                <i class="fas fa-bell"></i><span>Alerts</span>
            </a>
            <a href="/profile" class="nav-link">
                <i class="fas fa-user-circle"></i><span>Profile</span>
            </a>
        </nav>
    </div>

    <script>
        function toggleLayout(type) {
            const container = document.getElementById('courseContainer');
            document.getElementById('gBtn').classList.toggle('active', type === 'grid');
            document.getElementById('lBtn').classList.toggle('active', type === 'list');
            container.className = `course-grid ${type}-layout`;
        }

        function doSearch() {
            const query = document.getElementById('courseSearch').value.toLowerCase();
            document.querySelectorAll('.course-card').forEach(card => {
                const name = card.querySelector('.course-name').innerText.toLowerCase();
                card.style.display = name.includes(query) ? "" : "none";
            });
        }

        function handleSelect(cb, id) {
            const qtyBox = document.getElementById('qty-container-' + id);
            const card = document.getElementById('card-' + id);
            const selected = document.querySelectorAll('input[name="subject_ids"]:checked');

            if (selected.length > 4) {
                cb.checked = false;
                return;
            }

            document.getElementById('selCounter').innerText = `${selected.length}/4 Selected`;
            qtyBox.style.display = cb.checked ? "block" : "none";
            card.classList.toggle('selected', cb.checked);
            
            if (!cb.checked) qtyBox.querySelector('input').value = ""; 
            calcTotal();
        }

        function calcTotal() {
            let total = 0, hasError = false;
            document.querySelectorAll('input[name="subject_ids"]:checked').forEach(cb => {
                const input = document.querySelector(`input[name="questions_${cb.value}"]`);
                const val = parseInt(input.value) || 0;
                const max = parseInt(input.max);
                
                if (val > max || val <= 0) {
                    input.classList.add('error');
                    hasError = true;
                } else {
                    input.classList.remove('error');
                    total += val;
                }
            });
            document.getElementById('sumTotal').innerText = total;
            document.getElementById('launchBtn').disabled = (total === 0 || hasError);
        }
    </script>
</body>
</html>
