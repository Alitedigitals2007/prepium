<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sign Up | Prepium</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root { 
            --brand: #0062ff; 
            --bg: #f8fafc; 
            --text: #0f172a; 
            --sub: #64748b;
        }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background: var(--bg); 
            margin: 0; 
            display: flex; 
            justify-content: center; 
            color: var(--text);
            min-height: 100vh;
            overflow: hidden; /* Prevent scrolls during entrance animation */
        }

        /* Fullscreen Intro Motion Screen */
        .intro-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: white;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 2000;
            animation: fadeOutScreen 0.6s ease-in-out 1.6s forwards;
        }

        .intro-text {
            font-size: 1.65rem;
            font-weight: 800;
            color: var(--text);
            letter-spacing: -0.5px;
            text-align: center;
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUpText 0.6s ease-out 0.2s forwards;
        }
        .intro-text span {
            color: var(--brand);
        }

        /* Main Viewport Container */
        .auth-shell { 
            width: 100%; 
            max-width: 430px; 
            background: white; 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            padding: 2.5rem 2rem;
            box-shadow: 0 0 60px rgba(0,0,0,0.03);
            position: relative;
            
            /* Hidden initially, then fades up beautifully */
            opacity: 0;
            transform: translateY(25px);
            animation: displayForm 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1.8s forwards;
        }
        
        .logo-small { 
            color: var(--brand); 
            font-weight: 800; 
            font-size: 1.35rem; 
            margin-bottom: 2.5rem; 
            display: inline-block; 
            text-decoration: none; 
            letter-spacing: -0.5px;
        }
        .logo-small span { color: var(--text); }

        .header { margin-bottom: 2rem; }
        h1 { 
            font-size: 1.65rem; 
            font-weight: 800; 
            margin: 0; 
            letter-spacing: -0.5px;
            color: var(--text);
        }
        p { 
            color: var(--sub); 
            font-size: 0.88rem; 
            margin-top: 6px; 
            font-weight: 600;
        }
        
        .form-group { margin-bottom: 1.2rem; }
        label { 
            display: block; 
            font-size: 0.72rem; 
            font-weight: 800; 
            margin-bottom: 8px; 
            color: var(--text); 
            letter-spacing: 0.3px;
            text-transform: uppercase;
            padding-left: 2px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }
        input { 
            width: 100%; 
            padding: 1.1rem 1.2rem; 
            border-radius: 18px; 
            border: 1px solid #e2e8f0; 
            background: #f8fafc; 
            font-size: 0.92rem; 
            font-weight: 600;
            color: var(--text);
            outline: none; 
            transition: all 0.3s ease; 
            font-family: inherit;
        }
        input::placeholder { color: #94a3b8; font-weight: 500; }
        input:focus { 
            border-color: var(--brand); 
            background: white; 
            box-shadow: 0 0 0 4px rgba(0, 98, 255, 0.08); 
        }
        
        .btn-primary { 
            background: var(--brand); 
            color: white; 
            border: none; 
            width: 100%; 
            padding: 1.15rem; 
            border-radius: 20px; 
            font-size: 0.95rem; 
            font-weight: 800; 
            cursor: pointer; 
            margin-top: 1.5rem; 
            box-shadow: 0 8px 24px rgba(0, 98, 255, 0.18); 
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            transition: all 0.25s ease;
        }
        .btn-primary:hover {
            background: #0056e0;
            transform: translateY(-1px);
        }
        .btn-primary:disabled {
            background: #94a3b8;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

        /* Dynamic CSS Loading Spinner */
        .spinner {
            display: none;
            width: 18px;
            height: 18px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 0.8s linear infinite;
        }

        /* Motion Keyframes */
        @keyframes fadeInUpText {
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeOutScreen {
            to { opacity: 0; visibility: hidden; }
        }
        @keyframes displayForm {
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        .footer { 
            text-align: center; 
            margin-top: auto; 
            padding-top: 2.5rem; 
            font-size: 0.88rem; 
            color: var(--sub); 
            font-weight: 600;
        }
        .footer a { 
            color: var(--brand); 
            text-decoration: none; 
            font-weight: 800; 
        }
    </style>
</head>
<body>

    <div class="intro-overlay" id="introOverlay">
        <h2 class="intro-text">Hello, Future <span>Scholar.</span></h2>
    </div>

    <div class="auth-shell">
        <a href="/" class="logo-small">PREPIUM<span>.</span></a>
        
        <div class="header">
            <h1>Create Account</h1>
            <p>Join thousands of students acing their exams.</p>
        </div>

        <form action="/auth/signup" method="POST" id="signupForm">
            <div class="form-group">
                <label>Full Name</label>
                <div class="input-wrapper">
                    <input type="text" name="fullname" id="fullname" placeholder="Atilola Israel" required autocomplete="name">
                </div>
            </div>
            <div class="form-group">
                <label>Email Address</label>
                <div class="input-wrapper">
                    <input type="email" name="email" id="email" placeholder="israel@example.com" required autocomplete="email">
                </div>
            </div>
            <div class="form-group">
                <label>Create Password</label>
                <div class="input-wrapper">
                    <input type="password" name="password" id="password" placeholder="••••••••" required autocomplete="new-password">
                </div>
            </div>
            <div class="form-group">
                <label>Referral Code (Optional)</label>
                <div class="input-wrapper">
                    <input type="text" name="referred_by" id="referred_by" placeholder="e.g., ALITE001">
                </div>
            </div>
            <button type="submit" class="btn-primary" id="submitBtn">
                <span id="btnText">Create My Account ➔</span>
                <span class="spinner" id="btnSpinner"></span>
            </button>
        </form>

        <div class="footer">
            Already have an account? <a href="/login">Login</a>
        </div>
    </div>

    <script>
        const signupForm = document.getElementById('signupForm');
        const submitBtn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const btnSpinner = document.getElementById('btnSpinner');
        const introOverlay = document.getElementById('introOverlay');

        // Remove overlay from the DOM once transition ends
        setTimeout(() => {
            if (introOverlay) introOverlay.remove();
            document.body.style.overflow = "auto";
        }, 2400);

        // Capture submit to trigger dynamic signing up loader UI
        signupForm.addEventListener('submit', function() {
            submitBtn.disabled = true;
            btnText.textContent = "Setting up your account...";
            btnSpinner.style.display = "inline-block";
        });

        // Initialize dynamic popups for alerts
        const urlParams = new URLSearchParams(window.location.search);
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
        });

        if (urlParams.has('error')) {
            Toast.fire({ icon: 'error', title: urlParams.get('error') || 'Error creating account.' });
        }
    </script>
</body>
</html>