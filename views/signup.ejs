<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sign Up | Prepium</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="manifest" href="/manifest.json">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .intro-overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: white;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 2000;
            animation: fadeOutScreen 0.6s ease-in-out 1.6s forwards;
        }

        .intro-text {
            font-size: 1.65rem;
            font-weight: 800;
            color: var(--text-dark);
            letter-spacing: -0.5px;
            text-align: center;
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUpText 0.6s ease-out 0.2s forwards;
        }
        .intro-text span { color: var(--brand); }

        .auth-shell {
            opacity: 0;
            transform: translateY(25px);
            animation: displayForm 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1.8s forwards;
        }

        .password-toggle {
            position: absolute;
            right: 1.2rem;
            cursor: pointer;
            color: var(--text-sub);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s ease;
            z-index: 10;
        }
        .password-toggle:hover { color: var(--brand); }
        .password-toggle svg { width: 20px; height: 20px; }

        .btn-primary { display: flex; justify-content: center; align-items: center; gap: 10px; }

        .spinner {
            display: none;
            width: 18px; height: 18px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 0.8s linear infinite;
        }

        @keyframes fadeInUpText { to { opacity: 1; transform: translateY(0); } }
        @keyframes fadeOutScreen { to { opacity: 0; visibility: hidden; } }
        @keyframes displayForm { to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>

    <div class="intro-overlay" id="introOverlay">
        <h2 class="intro-text">Hello, Future <span>Scholar.</span></h2>
    </div>

    <div class="auth-shell">
        <a href="/" class="auth-logo">PREPIUM<span>.</span></a>
        
        <div class="auth-header">
            <h1>Create Account</h1>
            <p>Join thousands of students acing their exams.</p>
        </div>

        <form action="/auth/signup" method="POST" id="signupForm">
            <div class="form-group">
                <label>Full Name</label>
                <div class="input-wrapper">
                    <input type="text" name="fullname" placeholder="John Doe" required autocomplete="name">
                </div>
            </div>

            <div class="form-group">
                <label>University / Institution</label>
                <div class="input-wrapper">
                    <select name="university_id" id="university" required>
                        <option value="" disabled selected>Select your school</option>
                        <% if (locals.universities && universities.length > 0) { %>
                            <% universities.forEach(uni => { %>
                                <option value="<%= uni.id %>"><%= uni.name %></option>
                            <% }) %>
                        <% } else { %>
                            <option value="" disabled>No universities available</option>
                        <% } %>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Email Address</label>
                <div class="input-wrapper">
                    <input type="email" name="email" placeholder="john@example.com" required autocomplete="email">
                </div>
            </div>

            <div class="form-group">
                <label>Create Password</label>
                <div class="input-wrapper">
                    <input type="password" name="password" id="passwordInput" placeholder="........" required autocomplete="new-password">
                    <div class="password-toggle" id="togglePassword">
                        <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Referral Code (Optional)</label>
                <div class="input-wrapper">
                    <input type="text" name="referred_by" placeholder="e.g., 000000">
                </div>
            </div>

            <button type="submit" class="btn btn-primary" id="submitBtn">
                <span id="btnText">Create My Account &rarr;</span>
                <span class="spinner" id="btnSpinner"></span>
            </button>
        </form>

        <div class="auth-footer">
            Already have an account? <a href="/login">Login</a>
        </div>
    </div>

    <script src="/js/animations.js"></script>
    <script>
        const signupForm = document.getElementById('signupForm');
        const submitBtn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const btnSpinner = document.getElementById('btnSpinner');
        const introOverlay = document.getElementById('introOverlay');
        
        const passwordInput = document.getElementById('passwordInput');
        const togglePassword = document.getElementById('togglePassword');
        const eyeIcon = document.getElementById('eyeIcon');

        // 1. Password Visibility Toggle
        togglePassword.addEventListener('click', function () {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            
            if (type === 'text') {
                eyeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />`;
            } else {
                eyeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />`;
            }
        });

        // 2. Intro Removal
        setTimeout(() => {
            if (introOverlay) {
                introOverlay.style.transition = "opacity 0.6s ease";
                introOverlay.style.opacity = "0";
                setTimeout(() => introOverlay.remove(), 600);
            }
            document.body.style.overflow = "auto";
        }, 2400);

        // 3. Loading State
        signupForm.addEventListener('submit', function() {
            submitBtn.disabled = true;
            btnText.textContent = "Setting up your account...";
            btnSpinner.style.display = "inline-block";
        });

        // 4. URL Notifications
        const urlParams = new URLSearchParams(window.location.search);
        const Toast = Swal.mixin({
            toast: true, position: 'top-end', showConfirmButton: false, timer: 4000, timerProgressBar: true
        });

        if (urlParams.has('error')) {
            Toast.fire({ icon: 'error', title: urlParams.get('error') });
        }
        if (urlParams.has('success')) {
            Toast.fire({ icon: 'success', title: urlParams.get('success') });
        }
    </script>
</body>
</html>