<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Practice Quiz</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .pq-container { padding: 1.25rem; padding-bottom: 100px; max-width: 700px; margin: 0 auto; }
        .pq-header { margin-bottom: 1.25rem; }
        .pq-header h1 { font-size: 1.4rem; font-weight: 800; margin: 0; }
        .pq-header p { font-size: 0.75rem; color: var(--text-sub); font-weight: 600; margin: 4px 0 0; }
        .pq-free { display: inline-flex; align-items: center; gap: 5px; padding: 4px 12px; border-radius: 8px; font-size: 0.68rem; font-weight: 700; background: #fef3c7; color: #92400e; }
        .pq-free.used { background: #fee2e2; color: #991b1b; }
        .course-list { display: flex; flex-direction: column; gap: 8px; }
        .course-card { background: white; border-radius: 16px; padding: 14px 16px; border: 1px solid rgba(226,232,240,0.5); box-shadow: 0 2px 8px rgba(0,0,0,0.04); cursor: pointer; transition: all 0.2s; }
        .course-card:active { transform: scale(0.98); }
        .course-card.selected { border-color: var(--brand); box-shadow: 0 0 0 2px rgba(0,98,255,0.15); }
        .course-card .cc-code { font-size: 0.7rem; font-weight: 700; color: var(--brand); text-transform: uppercase; }
        .course-card .cc-title { font-size: 0.82rem; font-weight: 700; margin-top: 2px; }
        .quiz-area { margin-top: 1.25rem; }
        .quiz-area .q-num { font-size: 0.7rem; font-weight: 700; color: var(--text-sub); margin-bottom: 6px; }
        .quiz-area .q-text { font-size: 0.95rem; font-weight: 700; margin-bottom: 1rem; line-height: 1.5; }
        .quiz-area .q-diagram { margin-bottom: 1rem; padding: 12px; background: #f8fafc; border-radius: 12px; font-size: 0.75rem; color: var(--text-sub); font-style: italic; border: 1px dashed #e2e8f0; }
        .quiz-area .option { display: flex; align-items: center; gap: 10px; padding: 12px 14px; margin-bottom: 6px; border-radius: 12px; border: 1px solid #e2e8f0; cursor: pointer; transition: all 0.15s; }
        .quiz-area .option:active { transform: scale(0.98); }
        .quiz-area .option.selected { border-color: var(--brand); background: #eef4ff; }
        .quiz-area .option .opt-letter { width: 28px; height: 28px; border-radius: 8px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.7rem; flex-shrink: 0; }
        .quiz-area .option.selected .opt-letter { background: var(--brand); color: white; }
        .pq-nav { display: flex; gap: 8px; margin-top: 1rem; }
        .pq-nav button { flex: 1; padding: 12px; border-radius: 14px; border: none; font-weight: 700; font-size: 0.78rem; cursor: pointer; transition: all 0.2s; }
        .pq-nav button:active { transform: scale(0.96); }
        .btn-prev { background: #f1f5f9; color: var(--text-dark); }
        .btn-next { background: var(--brand); color: white; }
        .btn-submit { background: #10b981; color: white; }
        .result-summary { background: linear-gradient(135deg, #0b1437, #1a2744); border-radius: 24px; padding: 32px 24px; text-align: center; margin-bottom: 20px; }
        .result-summary .rs-label { font-size: 0.72rem; font-weight: 700; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 1px; }
        .result-summary .rs-score { font-size: 3.2rem; font-weight: 800; color: white; line-height: 1.1; margin: 4px 0; }
        .result-summary .rs-percent { font-size: 1rem; font-weight: 600; display: inline-block; padding: 4px 16px; border-radius: 20px; margin-top: 4px; }
        .result-summary .rs-detail { display: flex; justify-content: center; gap: 32px; margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.1); }
        .result-summary .rs-detail div { text-align: center; }
        .result-summary .rs-detail .rs-num { font-size: 1.1rem; font-weight: 800; color: white; }
        .result-summary .rs-detail .rs-lbl { font-size: 0.6rem; font-weight: 700; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.5px; }
        .rq-card { background: white; border-radius: 18px; padding: 18px; margin-bottom: 12px; border: 1px solid #eef2f6; box-shadow: 0 2px 8px rgba(0,0,0,0.04); text-align: left; }
        .rq-header { display: flex; align-items: flex-start; gap: 12px; }
        .rq-icon { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; flex-shrink: 0; margin-top: 1px; }
        .rq-icon.correct { background: #dcfce7; color: #16a34a; }
        .rq-icon.wrong { background: #fee2e2; color: #dc2626; }
        .rq-body { flex: 1; min-width: 0; }
        .rq-num { font-size: 0.6rem; font-weight: 700; color: var(--text-sub); text-transform: uppercase; letter-spacing: 0.3px; }
        .rq-text { font-size: 0.85rem; font-weight: 600; line-height: 1.5; margin: 4px 0 10px; }
        .rq-answer { font-size: 0.75rem; font-weight: 600; padding: 8px 12px; border-radius: 10px; margin-bottom: 10px; }
        .rq-answer.correct { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
        .rq-answer.wrong { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
        .rq-answer .rq-label { font-weight: 700; }
        .rq-explanation { font-size: 0.76rem; line-height: 1.6; color: #475569; background: #f8fafc; border-radius: 12px; padding: 12px 14px; border: 1px solid #eef2f6; }
        .rq-explanation strong { color: var(--text); }
        .empty-state { text-align: center; padding: 3rem 1rem; }
        .empty-state i { font-size: 2.5rem; color: var(--text-muted); margin-bottom: 1rem; }
        .empty-state h3 { font-size: 1rem; font-weight: 700; }
        .empty-state p { font-size: 0.75rem; color: var(--text-sub); }
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="pq-container" id="app">
        <div v-if="!started && !finished">
            <div class="pq-header">
                <h1>Practice Quiz</h1>
                <p>Select a course to begin</p>
                <div class="pq-free" :class="{ used: freeLeft <= 0 && !isPaid }">
                    <i class="fas" :class="freeLeft > 0 || isPaid ? 'fa-check-circle' : 'fa-times-circle'"></i>
                    {{ freeLeft > 0 ? freeLeft + ' free ' + (freeLeft === 1 ? 'attempt' : 'attempts') + ' remaining' : isPaid ? 'Unlimited attempts' : 'Free limit reached' }}
                </div>
            </div>
            <div v-if="courses.length === 0" class="empty-state">
                <i class="fas fa-book-open"></i>
                <h3>No courses available</h3>
                <p>Courses are published by your admin. Check back later.</p>
            </div>
            <div class="course-list">
                <div v-for="c in courses" :key="c.id" class="course-card" :class="{ selected: selectedCourse === c.id }" @click="selectCourse(c.id)">
                    <div class="cc-code">{{ c.course_code }}</div>
                    <div class="cc-title">{{ c.course_title }}</div>
                </div>
            </div>
            <div style="margin-top:1rem;">
                <button class="btn btn-primary" style="width:100%;padding:14px;border-radius:14px;font-weight:700;" @click="startQuiz" :disabled="!selectedCourse || loading">
                    <i class="fas fa-bolt"></i> Start Quiz
                </button>
            </div>
        </div>

        <div v-if="started && !finished">
            <div class="pq-header">
                <h1>{{ currentCourseTitle }}</h1>
                <p>Question {{ currentIndex + 1 }} of {{ questions.length }}</p>
            </div>
            <div class="quiz-area">
                <div class="q-num">QUESTION {{ currentIndex + 1 }}</div>
                <div class="q-text">{{ currentQ.question }}</div>
                <div v-if="currentQ.diagram_url" class="q-diagram"><i class="fas fa-image"></i> {{ currentQ.diagram_url }}</div>
                <div v-for="(opt, oi) in currentQ.options" :key="oi" class="option" :class="{ selected: answers[currentIndex] === String.fromCharCode(65 + oi) }" @click="setAns(String.fromCharCode(65 + oi))">
                    <div class="opt-letter">{{ String.fromCharCode(65 + oi) }}</div>
                    <div>{{ opt }}</div>
                </div>
            </div>
            <div class="pq-nav">
                <button class="btn-prev" @click="prevQ" :disabled="currentIndex === 0"><i class="fas fa-arrow-left"></i> Previous</button>
                <button v-if="currentIndex < questions.length - 1" class="btn-next" @click="nextQ">Next <i class="fas fa-arrow-right"></i></button>
                <button v-if="currentIndex === questions.length - 1" class="btn-submit" @click="submitQuiz" :disabled="submitting">{{ submitting ? 'Submitting...' : 'Submit' }}</button>
            </div>
        </div>

        <div v-if="finished">
            <div class="result-summary">
                <div class="rs-label">Your Score</div>
                <div class="rs-score">{{ result.score }} / {{ result.total }}</div>
                <div class="rs-percent" :style="{ background: result.percent >= 50 ? '#dcfce7' : '#fee2e2', color: result.percent >= 50 ? '#16a34a' : '#dc2626' }">{{ result.percent }}%</div>
                <div class="rs-detail">
                    <div><div class="rs-num" style="color:#16a34a;">{{ result.results.filter(r => r.isCorrect).length }}</div><div class="rs-lbl">Correct</div></div>
                    <div><div class="rs-num" style="color:#dc2626;">{{ result.results.filter(r => !r.isCorrect).length }}</div><div class="rs-lbl">Wrong</div></div>
                </div>
            </div>
            <div v-for="(r, ri) in result.results" :key="ri" class="rq-card">
                <div class="rq-header">
                    <div class="rq-icon" :class="r.isCorrect ? 'correct' : 'wrong'">
                        <i :class="r.isCorrect ? 'fas fa-check' : 'fas fa-times'"></i>
                    </div>
                    <div class="rq-body">
                        <div class="rq-num">Question {{ ri + 1 }}</div>
                        <div class="rq-text">{{ r.question }}</div>
                        <div class="rq-answer" :class="r.isCorrect ? 'correct' : 'wrong'">
                            <span class="rq-label">{{ r.isCorrect ? 'Your answer' : 'Your answer' }}:</span> {{ r.userAnswer || '(none)' }}
                            <span v-if="!r.isCorrect"><br><span class="rq-label">Correct answer:</span> {{ r.correctAnswer }}</span>
                        </div>
                        <div v-if="r.explanation" class="rq-explanation">
                            <strong>Explanation:</strong> {{ r.explanation }}
                        </div>
                    </div>
                </div>
            </div>
            <button class="btn btn-primary" style="width:100%;margin-top:1rem;padding:14px;border-radius:18px;font-weight:700;font-size:0.9rem;" @click="reset">
                <i class="fas fa-redo"></i> Try Another Quiz
            </button>
        </div>
    </div>
</div>
<%- include('partials/bottom-nav', { activeNav: 'quiz' }) %>
<script src="https://cdn.jsdelivr.net/npm/vue@2.7.14/dist/vue.min.js"></script>
<script>
new Vue({
    el: '#app',
    data: {
        courses: <%- JSON.stringify(courses || []) %>,
        freeLeft: <%- freeLeft %>,
        isPaid: <%= isPaid ? 'true' : 'false' %>,
        selectedCourse: null,
        started: false,
        finished: false,
        loading: false,
        submitting: false,
        questions: [],
        currentIndex: 0,
        answers: {},
        attemptId: null,
        result: { score: 0, total: 0, percent: 0, results: [] }
    },
    computed: {
        currentQ() { return this.questions[this.currentIndex] || { question: '', options: [] }; },
        currentCourseTitle() {
            const c = this.courses.find(x => x.id === this.selectedCourse);
            return c ? c.course_code + ' - ' + c.course_title : '';
        }
    },
    methods: {
        selectCourse(id) { this.selectedCourse = id; },
        async startQuiz() {
            if (!this.selectedCourse) return;
            if (this.freeLeft <= 0 && !this.isPaid) { Swal.fire({ icon: 'warning', title: 'Free limit reached', text: 'Upgrade to premium for unlimited quizzes.' }); return; }
            this.loading = true;
            const r = await fetch('/api/quiz/start', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ courseId: this.selectedCourse }) });
            const d = await r.json();
            this.loading = false;
            if (d.error) { Swal.fire({ icon: 'error', title: 'Error', text: d.error }); return; }
            this.questions = d.questions;
            this.attemptId = d.attemptId;
            this.started = true;
            this.currentIndex = 0;
            this.answers = {};
        },
        setAns(a) { this.$set(this.answers, this.currentIndex, a); },
        nextQ() { if (this.currentIndex < this.questions.length - 1) this.currentIndex++; },
        prevQ() { if (this.currentIndex > 0) this.currentIndex--; },
        async submitQuiz() {
            this.submitting = true;
            const r = await fetch('/api/quiz/submit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ attemptId: this.attemptId, answers: this.answers }) });
            const d = await r.json();
            this.submitting = false;
            if (d.error) { Swal.fire({ icon: 'error', title: 'Error', text: d.error }); return; }
            this.result = { ...d, percent: Math.round((d.score / d.total) * 100) };
            this.finished = true;
        },
        reset() {
            this.started = false;
            this.finished = false;
            this.selectedCourse = null;
            this.questions = [];
            this.answers = {};
            this.attemptId = null;
            this.result = { score: 0, total: 0, percent: 0, results: [] };
        }
    }
});
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>