<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--text-primary); min-height: 100vh; }
        .app-shell { display: flex; min-height: 100vh; }
        .main-area { flex: 1; padding: 1.5rem; overflow-y: auto; max-width: 900px; margin: 0 auto; width: 100%; }
        .header-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.2rem; }
        .header-title { font-weight: 800; font-size: 1rem; }
        .back-circle { width: 38px; height: 38px; border-radius: 50%; background: var(--surface-solid); border: 1px solid var(--border-solid); display: flex; align-items: center; justify-content: center; color: var(--text-primary); }
        .page-subhead p { font-size: 0.8rem; color: var(--text-secondary); font-weight: 600; margin-bottom: 1.2rem; }
        .card { background: var(--surface-solid); border-radius: 20px; padding: 22px; box-shadow: 0 2px 12px rgba(0,0,0,0.04); margin-bottom: 1rem; }

        .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
        .stat-box { background: var(--bg); border-radius: 14px; padding: 12px 8px; text-align: center; }
        .stat-v { font-size: 1.15rem; font-weight: 800; background: linear-gradient(135deg, var(--brand), #1d4ed8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .stat-l { font-size: 0.58rem; color: var(--text-secondary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }

        .paths-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(255px, 1fr)); gap: 14px; }
        .path-card { position: relative; background: var(--surface-solid); border-radius: 20px; padding: 20px; box-shadow: 0 2px 12px rgba(0,0,0,0.04); text-decoration: none; color: inherit; transition: transform 0.2s, box-shadow 0.2s; border: 1px solid var(--border-solid); display: flex; flex-direction: column; overflow: hidden; }
        .path-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(37,99,235,0.14); }
        .path-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--brand), #1d4ed8); opacity: 0; transition: opacity 0.2s; }
        .path-card:hover::before { opacity: 1; }
        .path-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px; }
        .path-icon { width: 46px; height: 46px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.15rem; color: white; box-shadow: 0 4px 10px rgba(0,0,0,0.12); }
        .ic-blue { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }
        .ic-green { background: linear-gradient(135deg, #10b981, #059669); }
        .ic-purple { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
        .ic-orange { background: linear-gradient(135deg, #f97316, #ea580c); }
        .ic-red { background: linear-gradient(135deg, #ef4444, #dc2626); }
        .ic-amber { background: linear-gradient(135deg, #f59e0b, #d97706); }
        .ic-teal { background: linear-gradient(135deg, #14b8a6, #0d9488); }
        .ic-indigo { background: linear-gradient(135deg, #6366f1, #4f46e5); }
        .ic-rose { background: linear-gradient(135deg, #f43f5e, #e11d48); }
        .state-chip { font-size: 0.58rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; padding: 4px 9px; border-radius: 20px; white-space: nowrap; }
        .chip-start { background: var(--bg); color: var(--text-secondary); border: 1px solid var(--border-solid); }
        .chip-progress { background: rgba(37,99,235,0.1); color: var(--brand); }
        .chip-done { background: rgba(16,185,129,0.12); color: #10b981; }
        .path-title { font-weight: 800; font-size: 0.94rem; margin-bottom: 4px; }
        .path-desc { font-size: 0.76rem; color: var(--text-secondary); line-height: 1.45; margin-bottom: 14px; flex: 1; }
        .progress-head { display: flex; justify-content: space-between; font-size: 0.66rem; font-weight: 700; color: var(--text-secondary); margin-bottom: 5px; }
        .progress-track { height: 7px; background: var(--bg); border-radius: 6px; overflow: hidden; margin-bottom: 12px; }
        .progress-fill { height: 100%; background: linear-gradient(90deg, var(--brand), #1d4ed8); border-radius: 6px; transition: width 0.4s; }
        .progress-fill.full { background: linear-gradient(90deg, #10b981, #059669); }
        .path-meta { display: flex; justify-content: space-between; align-items: center; font-size: 0.7rem; color: var(--text-secondary); font-weight: 700; border-top: 1px solid var(--border-solid); padding-top: 11px; }
        .path-meta i { margin-right: 4px; }
        .xp-hint { color: #10b981; }
        .empty-state { text-align: center; padding: 40px 20px; color: var(--text-secondary); }
        .empty-state i { font-size: 2.5rem; margin-bottom: 12px; opacity: 0.4; }
        @media (max-width: 560px) { .stats-row { grid-template-columns: repeat(2, 1fr); } }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="main-area">
        <div class="header-nav">
            <a href="/dashboard" class="back-circle"><i class="fas fa-arrow-left"></i></a>
            <div class="header-title">Skills Centre</div>
            <%- include('partials/drawer-trigger') %>
        </div>

        <div class="page-subhead"><p>Structured learning paths — Prepium lessons, curated external resources, real projects and honest progress tracking</p></div>

        <div class="card">
            <div class="stats-row">
                <div class="stat-box"><div class="stat-v"><%= summary.paths %></div><div class="stat-l">Learning paths</div></div>
                <div class="stat-box"><div class="stat-v"><%= summary.enrolled %></div><div class="stat-l">In progress</div></div>
                <div class="stat-box"><div class="stat-v"><%= summary.lessonsDone %>/<%= summary.lessonsTotal %></div><div class="stat-l">Lessons done</div></div>
                <div class="stat-box"><div class="stat-v"><%= summary.xp %></div><div class="stat-l">Skill XP</div></div>
            </div>
        </div>

        <% if (!paths.length) { %>
            <div class="card">
                <div class="empty-state">
                    <i class="fas fa-seedling"></i>
                    <h3 style="font-weight:800; color:var(--text-primary); margin-bottom:6px;">No paths yet</h3>
                    <p style="font-size:0.82rem;">Learning paths are being prepared — check back soon.</p>
                </div>
            </div>
        <% } %>

        <div class="paths-grid">
            <% paths.forEach(function (p) { %>
                <% var pct = p.lesson_count > 0 ? Math.round((p.done_count / p.lesson_count) * 100) : 0; %>
                <a class="path-card" href="/skills/<%= p.slug %>">
                    <div class="path-top">
                        <div class="path-icon ic-<%= p.tone || 'blue' %>"><i class="fas <%= p.icon || 'fa-star' %>"></i></div>
                        <% if (p.lesson_count > 0 && p.done_count >= p.lesson_count) { %>
                            <span class="state-chip chip-done"><i class="fas fa-circle-check"></i> Completed</span>
                        <% } else if (p.enrolled) { %>
                            <span class="state-chip chip-progress">In progress</span>
                        <% } else { %>
                            <span class="state-chip chip-start">Start</span>
                        <% } %>
                    </div>
                    <div class="path-title"><%= p.title %></div>
                    <div class="path-desc"><%= p.description %></div>
                    <div class="progress-head"><span>Progress</span><span><%= pct %>%</span></div>
                    <div class="progress-track"><div class="progress-fill <%= pct >= 100 ? 'full' : '' %>" style="width:<%= pct %>%"></div></div>
                    <div class="path-meta">
                        <span><i class="fas fa-list-check"></i><%= p.done_count %>/<%= p.lesson_count %> lessons</span>
                        <span class="xp-hint"><i class="fas fa-bolt"></i>+15 XP / lesson</span>
                    </div>
                </a>
            <% }); %>
        </div>

        <%- include('partials/bottom-nav', { activeNav: activeNav }) %>
    </div>
</div>
</body>
</html>
