<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--text-primary); min-height: 100vh; }
        .app-shell { display: flex; min-height: 100vh; }
        .main-area { flex: 1; padding: 1.5rem; overflow-y: auto; max-width: 900px; margin: 0 auto; width: 100%; }
        .header-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.2rem; }
        .header-title { font-weight: 800; font-size: 1rem; }
        .back-circle { width: 38px; height: 38px; border-radius: 50%; background: var(--surface-solid); border: 1px solid var(--border-solid); display: flex; align-items: center; justify-content: center; color: var(--text-primary); }
        .page-subhead p { font-size: 0.8rem; color: var(--text-secondary); font-weight: 600; margin-bottom: 1.2rem; }
        .paths-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 12px; }
        .path-card { background: var(--surface-solid); border-radius: 20px; padding: 22px; box-shadow: 0 2px 12px rgba(0,0,0,0.04); text-decoration: none; color: inherit; transition: all 0.2s; border: 1px solid var(--border-solid); display: block; }
        .path-card:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(37,99,235,0.1); }
        .path-icon { width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; margin-bottom: 12px; color: white; }
        .ic-blue { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }
        .ic-green { background: linear-gradient(135deg, #10b981, #059669); }
        .ic-purple { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
        .ic-orange { background: linear-gradient(135deg, #f97316, #ea580c); }
        .ic-red { background: linear-gradient(135deg, #ef4444, #dc2626); }
        .ic-amber { background: linear-gradient(135deg, #f59e0b, #d97706); }
        .ic-teal { background: linear-gradient(135deg, #14b8a6, #0d9488); }
        .ic-indigo { background: linear-gradient(135deg, #6366f1, #4f46e5); }
        .ic-rose { background: linear-gradient(135deg, #f43f5e, #e11d48); }
        .path-title { font-weight: 800; font-size: 0.92rem; margin-bottom: 4px; }
        .path-desc { font-size: 0.76rem; color: var(--text-secondary); line-height: 1.45; margin-bottom: 12px; }
        .path-meta { display: flex; justify-content: space-between; align-items: center; font-size: 0.7rem; color: var(--text-secondary); font-weight: 700; }
        .progress-track { height: 6px; background: var(--bg); border-radius: 6px; overflow: hidden; margin-bottom: 10px; }
        .progress-fill { height: 100%; background: linear-gradient(90deg, var(--brand), #1d4ed8); border-radius: 6px; }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="main-area">
        <div class="header-nav">
            <a href="/dashboard" class="back-circle"><i class="fas fa-arrow-left"></i></a>
            <div class="header-title">Skills Centre</div>
            <%- include('partials/drawer-trigger') %>
        </div>

        <div class="page-subhead"><p>Structured learning paths — lessons, external resources, projects and honest progress tracking</p></div>

        <div class="paths-grid">
            <% paths.forEach(function (p) { %>
                <a class="path-card" href="/skills/<%= p.slug %>">
                    <div class="path-icon ic-<%= p.tone %>"><i class="fas <%= p.icon %>"></i></div>
                    <div class="path-title"><%= p.title %></div>
                    <div class="path-desc"><%= p.description %></div>
                    <div class="progress-track"><div class="progress-fill" style="width:<%= p.lesson_count > 0 ? Math.round((p.done_count / p.lesson_count) * 100) : 0 %>%"></div></div>
                    <div class="path-meta">
                        <span><%= p.done_count %>/<%= p.lesson_count %> lessons</span>
                        <span><%= p.enrolled ? 'In progress' : 'Start' %> <i class="fas fa-arrow-right"></i></span>
                    </div>
                </a>
            <% }); %>
        </div>

        <%- include('partials/bottom-nav', { activeNav: activeNav }) %>
    </div>
</div>
</body>
</html>
