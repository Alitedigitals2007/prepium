<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        body::before { display: none; }
        .app-shell { background: transparent; backdrop-filter: none; border: none; padding-bottom: 100px; }

        .sq-header { padding: 1.25rem 1.25rem 0.75rem; display: flex; align-items: center; justify-content: space-between; }
        .sq-header-left { display: flex; align-items: center; gap: 12px; }
        .sq-avatar { width: 46px; height: 46px; border-radius: 16px; background: linear-gradient(135deg,#f97316,#ef4444); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.1rem; box-shadow: 0 4px 14px rgba(239,68,68,0.25); }
        .sq-title { font-size: 1.15rem; font-weight: 800; line-height: 1.2; }
        .sq-subtitle { font-size: 0.62rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; }

        .flash-msg { margin: 0 1.25rem 1rem; padding: 12px 16px; background: var(--success-soft); color: var(--success); border: 1px solid rgba(22,163,74,0.25); border-radius: 14px; font-size: 0.8rem; font-weight: 700; }

        .sq-hero { margin: 0 1.25rem 1.25rem; padding: 24px 20px; border-radius: 22px; background: linear-gradient(135deg,#f97316,#ef4444); color: white; position: relative; overflow: hidden; box-shadow: 0 8px 24px rgba(239,68,68,0.25); }
        .sq-hero::before { content: ''; position: absolute; top: -50%; right: -15%; width: 200px; height: 200px; border-radius: 50%; background: rgba(255,255,255,0.1); }
        .sq-hero .sh-eyebrow { font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; opacity: 0.85; }
        .sq-hero .sh-streak { font-size: 2.6rem; font-weight: 800; line-height: 1.1; margin: 4px 0 2px; }
        .sq-hero .sh-streak span { font-size: 1rem; font-weight: 700; opacity: 0.9; }
        .sq-hero .sh-hint { font-size: 0.75rem; font-weight: 600; opacity: 0.9; }

        .sq-card { margin: 0 1.25rem 1rem; background: var(--surface-solid); border: 1px solid var(--border); border-radius: 18px; padding: 18px; box-shadow: var(--shadow-sm); }
        .sq-card .sc-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
        .sq-card .sc-title { font-size: 0.9rem; font-weight: 800; }
        .sq-card .sc-code { font-size: 0.68rem; font-weight: 800; letter-spacing: 1px; background: var(--brand-soft); color: var(--brand); padding: 6px 12px; border-radius: 9px; cursor: pointer; }

        .member-row { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border); }
        .member-row:last-child { border-bottom: none; }
        .member-av { width: 38px; height: 38px; border-radius: 12px; background: var(--brand-soft); color: var(--brand); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.9rem; flex-shrink: 0; }
        .member-info { flex: 1; min-width: 0; }
        .member-name { font-size: 0.82rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .member-status { font-size: 0.66rem; font-weight: 600; color: var(--text-secondary); }
        .checkin-dot { width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; flex-shrink: 0; }
        .checkin-dot.done { background: var(--success-soft); color: var(--success); }
        .checkin-dot.pending { background: var(--surface); color: var(--text-muted); border: 1px dashed var(--border-solid); }

        .btn-checkin { width: 100%; padding: 14px; border: none; border-radius: 14px; background: linear-gradient(135deg,#f97316,#ef4444); color: white; font-weight: 800; font-size: 0.9rem; cursor: pointer; font-family: inherit; box-shadow: 0 6px 18px rgba(239,68,68,0.25); transition: transform 0.1s; }
        .btn-checkin:active { transform: scale(0.97); }
        .btn-checkin.done { background: var(--success); box-shadow: 0 6px 18px rgba(22,163,74,0.25); }

        .btn-ghost { width: 100%; padding: 12px; border: 1.5px solid var(--border-solid); border-radius: 14px; background: transparent; color: var(--text-secondary); font-weight: 700; font-size: 0.82rem; cursor: pointer; font-family: inherit; margin-top: 10px; }

        .empty-squad { text-align: center; padding: 30px 20px; }
        .empty-squad .es-icon { width: 64px; height: 64px; margin: 0 auto 14px; border-radius: 20px; background: var(--brand-soft); color: var(--brand); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
        .empty-squad h3 { font-size: 1rem; font-weight: 800; margin-bottom: 4px; }
        .empty-squad p { font-size: 0.75rem; color: var(--text-secondary); font-weight: 500; line-height: 1.5; }

        .sq-form { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
        .sq-form input { padding: 12px 14px; border: 1.5px solid var(--border-solid); border-radius: 12px; background: var(--bg); font-family: inherit; font-size: 0.85rem; font-weight: 600; color: var(--text-primary); outline: none; }
        .sq-form input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-light); }
        .sq-form .btn-sub { padding: 13px; border: none; border-radius: 12px; background: var(--brand-gradient); color: white; font-weight: 800; font-size: 0.85rem; cursor: pointer; font-family: inherit; }
        .sq-form .btn-sub.outline { background: transparent; border: 1.5px solid var(--brand); color: var(--brand); }

        @media (min-width: 1024px) {
            .app-shell { max-width: 860px; margin: 0 auto; padding: 24px; }
            .sq-hero { max-width: 480px; }
        }
        @media (prefers-reduced-motion: reduce) { .sq-card, .sq-hero { animation: none; } }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/app-intro') %>
<%- include('partials/sidebar') %>
<div class="app-shell">

    <div class="sq-header">
        <div class="sq-header-left">
            <div class="sq-avatar"><i class="fas fa-users"></i></div>
            <div>
                <div class="sq-title">Squad Streaks</div>
                <div class="sq-subtitle">Study together, win together</div>
            </div>
        </div>
    </div>

    <% if (locals.msg && msg) { %>
    <div class="flash-msg"><i class="fas fa-circle-check"></i> <%= msg %></div>
    <% } %>

    <% if (!squad) { %>

    <div class="sq-card">
        <div class="empty-squad">
            <div class="es-icon"><i class="fas fa-fire"></i></div>
            <h3>No squad yet</h3>
            <p>Create a squad or join one with a friend's invite code. If anyone misses a day, the whole squad's streak resets — accountability!</p>
        </div>

        <div class="sq-form">
            <input type="text" id="squadName" placeholder="Squad name (e.g. Physics Crew)">
            <button class="btn-sub" onclick="createSquad()"><i class="fas fa-plus"></i> Create Squad</button>
        </div>
        <div class="sq-form" style="margin-top:14px;border-top:1px dashed var(--border);padding-top:14px;">
            <input type="text" id="squadCode" placeholder="Enter invite code (e.g. AB12CD)" style="text-transform:uppercase;">
            <button class="btn-sub outline" onclick="joinSquad()"><i class="fas fa-sign-in-alt"></i> Join Squad</button>
        </div>
    </div>

    <% } else { %>

    <div class="sq-hero">
        <div class="sh-eyebrow"><%= squad.name %></div>
        <div class="sh-streak"><i class="fas fa-fire"></i> <%= squad.streak %> <span>day<%= squad.streak === 1 ? '' : 's' %> streak</span></div>
        <div class="sh-hint">Keep the whole squad checking in daily. One miss = streak reset.</div>
    </div>

    <div class="sq-card">
        <div class="sc-head">
            <div class="sc-title"><i class="fas fa-users"></i> <%= squad.memberCount %> members</div>
            <div class="sc-code" onclick="copyCode('<%= squad.inviteCode %>')" title="Copy invite code"><i class="fas fa-copy"></i> <%= squad.inviteCode %></div>
        </div>
        <% squad.members.forEach(function(m) { %>
        <div class="member-row">
            <div class="member-av"><%= m.fullname ? m.fullname.charAt(0).toUpperCase() : 'U' %></div>
            <div class="member-info">
                <div class="member-name"><%= m.fullname %><%= m.id === squad.ownerId ? ' <span style="color:var(--warning);font-size:0.62rem;">OWNER</span>' : '' %></div>
                <div class="member-status"><%= m.checked_today ? 'Checked in today' : 'Pending check-in' %></div>
            </div>
            <div class="checkin-dot <%= m.checked_today ? 'done' : 'pending' %>">
                <i class="fas <%= m.checked_today ? 'fa-check' : 'fa-clock' %>"></i>
            </div>
        </div>
        <% }); %>
        <button class="btn-checkin" id="checkinBtn" onclick="checkIn()">
            <i class="fas fa-check-double"></i> <span id="checkinText">I'm in today</span>
        </button>
        <button class="btn-ghost" onclick="leaveSquad()"><i class="fas fa-sign-out-alt"></i> Leave Squad</button>
    </div>

    <% } %>

</div>

<script src="/js/animations.js"></script>
<script>
    function createSquad() {
        var name = document.getElementById('squadName').value.trim();
        if (!name) { alert('Enter a squad name'); return; }
        var f = document.createElement('form');
        f.method = 'POST'; f.action = '/squads/create';
        var i = document.createElement('input');
        i.type = 'hidden'; i.name = 'name'; i.value = name;
        f.appendChild(i); document.body.appendChild(f); f.submit();
    }
    function joinSquad() {
        var code = document.getElementById('squadCode').value.trim();
        if (!code) { alert('Enter the invite code'); return; }
        var f = document.createElement('form');
        f.method = 'POST'; f.action = '/squads/join';
        var i = document.createElement('input');
        i.type = 'hidden'; i.name = 'code'; i.value = code;
        f.appendChild(i); document.body.appendChild(f); f.submit();
    }
    function copyCode(code) {
        if (navigator.clipboard) { navigator.clipboard.writeText(code).then(function(){ alert('Invite code copied: ' + code); }); }
        else alert('Invite code: ' + code);
    }
    function checkIn() {
        fetch('/squads/checkin', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.success) {
                var btn = document.getElementById('checkinBtn');
                btn.classList.add('done');
                document.getElementById('checkinText').textContent = 'Checked in ✓ (' + d.streak + '-day streak)';
                btn.disabled = true;
            } else { alert(d.error || 'Check-in failed'); }
        }).catch(function() { alert('Network error'); });
    }
    function leaveSquad() {
        if (confirm('Leave this squad? Your streak contribution will be removed.')) {
            var f = document.createElement('form');
            f.method = 'POST'; f.action = '/squads/leave';
            document.body.appendChild(f); f.submit();
        }
    }
    (function() {
        var btn = document.getElementById('checkinBtn');
        if (btn && btn.getAttribute('data-done')) {
            btn.classList.add('done');
            document.getElementById('checkinText').textContent = 'Checked in today ✓';
            btn.disabled = true;
        }
    })();
</script>
</body>
</html>