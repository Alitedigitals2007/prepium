<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        body::before { display: none; }
        .app-shell { background: transparent; backdrop-filter: none; border: none; padding-bottom: 110px; }

        .sq-header { padding: 1.25rem 1.25rem 0.75rem; display: flex; align-items: center; justify-content: space-between; }
        .sq-header-left { display: flex; align-items: center; gap: 12px; }
        .sq-avatar { width: 46px; height: 46px; border-radius: 16px; background: linear-gradient(135deg,#f97316,#ef4444); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.1rem; box-shadow: 0 4px 14px rgba(239,68,68,0.25); }
        .sq-title { font-size: 1.15rem; font-weight: 800; line-height: 1.2; }
        .sq-subtitle { font-size: 0.62rem; font-weight: 700; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; }
        .sq-count-badge { min-width: 26px; height: 26px; padding: 0 8px; border-radius: 99px; background: var(--brand-soft); color: var(--brand); font-size: 0.72rem; font-weight: 800; display: flex; align-items: center; justify-content: center; }

        .flash-msg { margin: 0 1.25rem 1rem; padding: 12px 16px; background: var(--success-soft); color: var(--success); border: 1px solid rgba(22,163,74,0.25); border-radius: 14px; font-size: 0.8rem; font-weight: 700; }

        /* Bulk check-in bar */
        .bulk-bar { margin: 0 1.25rem 1rem; padding: 14px 16px; border-radius: 16px; background: var(--surface-solid); border: 1px solid var(--border); box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 12px; }
        .bulk-info { flex: 1; min-width: 0; }
        .bulk-title { font-size: 0.85rem; font-weight: 800; }
        .bulk-sub { font-size: 0.68rem; color: var(--text-secondary); font-weight: 600; }
        .btn-bulk { padding: 10px 14px; border: none; border-radius: 12px; background: linear-gradient(135deg,#f97316,#ef4444); color: white; font-weight: 800; font-size: 0.78rem; cursor: pointer; font-family: inherit; box-shadow: 0 4px 14px rgba(239,68,68,0.25); white-space: nowrap; }
        .btn-bulk.all-done { background: var(--success); box-shadow: 0 4px 14px rgba(22,163,74,0.25); }

        /* Squad card */
        .sq-card { margin: 0 1.25rem 1rem; background: var(--surface-solid); border: 1px solid var(--border); border-radius: 20px; box-shadow: var(--shadow-sm); overflow: hidden; }
        .sq-card-top { padding: 16px 16px 14px; cursor: pointer; user-select: none; }
        .sq-row { display: flex; align-items: center; gap: 12px; }
        .sq-ring { width: 46px; height: 46px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.05rem; flex-shrink: 0; background: var(--brand-soft); color: var(--brand); }
        .sq-ring.on { background: var(--success-soft); color: var(--success); }
        .sq-name { font-size: 0.95rem; font-weight: 800; line-height: 1.2; }
        .sq-meta { font-size: 0.66rem; color: var(--text-secondary); font-weight: 600; margin-top: 2px; }
        .sq-streak { margin-left: auto; text-align: right; }
        .sq-flame { font-size: 1.15rem; font-weight: 800; color: var(--warning); line-height: 1; }
        .sq-flame span { font-size: 0.62rem; color: var(--text-secondary); font-weight: 700; }
        .sq-progress { margin-top: 12px; }
        .sq-progress .sp-head { display: flex; justify-content: space-between; font-size: 0.66rem; font-weight: 700; color: var(--text-secondary); margin-bottom: 6px; }
        .sp-bar { height: 7px; border-radius: 99px; background: var(--surface); overflow: hidden; }
        .sp-fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg,#f97316,#ef4444); transition: width 0.4s ease; }
        .sp-fill.full { background: linear-gradient(90deg,#22c55e,#10b981); }

        .av-stack { display: flex; margin-top: 10px; }
        .av-stack .av { width: 30px; height: 30px; border-radius: 50%; border: 2px solid var(--surface-solid); display: flex; align-items: center; justify-content: center; font-size: 0.66rem; font-weight: 800; margin-left: -8px; background: var(--brand-soft); color: var(--brand); }
        .av-stack .av:first-child { margin-left: 0; }
        .av-stack .av.done { background: var(--success-soft); color: var(--success); }
        .av-stack .av.pending { background: var(--surface); color: var(--text-muted); }

        .sq-actions { display: flex; gap: 10px; padding: 0 16px 14px; }
        .sq-actions .btn-act { flex: 1; padding: 11px; border: none; border-radius: 12px; font-weight: 800; font-size: 0.8rem; cursor: pointer; font-family: inherit; }
        .btn-checkin { background: linear-gradient(135deg,#f97316,#ef4444); color: white; box-shadow: 0 4px 14px rgba(239,68,68,0.2); }
        .btn-checkin.done { background: var(--success); box-shadow: 0 4px 14px rgba(22,163,74,0.2); }
        .btn-expand { background: transparent; border: 1.5px solid var(--border-solid); color: var(--text-secondary); }

        .sq-members { border-top: 1px solid var(--border); padding: 6px 16px 12px; display: none; }
        .sq-card.open .sq-members { display: block; }
        .member-row { display: flex; align-items: center; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--border); }
        .member-row:last-child { border-bottom: none; }
        .member-av { width: 34px; height: 34px; border-radius: 12px; background: var(--brand-soft); color: var(--brand); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.8rem; flex-shrink: 0; }
        .member-info { flex: 1; min-width: 0; }
        .member-name { font-size: 0.8rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .member-status { font-size: 0.64rem; font-weight: 600; color: var(--text-secondary); }
        .checkin-dot { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.66rem; flex-shrink: 0; }
        .checkin-dot.done { background: var(--success-soft); color: var(--success); }
        .checkin-dot.pending { background: var(--surface); color: var(--text-muted); border: 1px dashed var(--border-solid); }
        .sq-footer-row { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; }
        .sq-code { font-size: 0.68rem; font-weight: 800; letter-spacing: 1px; background: var(--brand-soft); color: var(--brand); padding: 6px 12px; border-radius: 9px; cursor: pointer; }
        .sq-leave { font-size: 0.7rem; font-weight: 700; color: #ef4444; background: none; border: none; cursor: pointer; font-family: inherit; }

        /* Create / join */
        .sq-new { margin: 0 1.25rem 1rem; background: var(--surface-solid); border: 1px dashed var(--border-solid); border-radius: 18px; padding: 16px; }
        .sq-new-head { display: flex; align-items: center; justify-content: space-between; cursor: pointer; }
        .sq-new-title { font-size: 0.85rem; font-weight: 800; }
        .sq-new .sq-form { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
        .sq-form input { padding: 12px 14px; border: 1.5px solid var(--border-solid); border-radius: 12px; background: var(--bg); font-family: inherit; font-size: 0.85rem; font-weight: 600; color: var(--text-primary); outline: none; }
        .sq-form input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-light); }
        .sq-form .btn-sub { padding: 13px; border: none; border-radius: 12px; background: var(--brand-gradient); color: white; font-weight: 800; font-size: 0.85rem; cursor: pointer; font-family: inherit; }
        .sq-form .btn-sub.outline { background: transparent; border: 1.5px solid var(--brand); color: var(--brand); }
        .sq-form-divider { display: flex; align-items: center; gap: 10px; margin: 6px 0; }
        .sq-form-divider span { font-size: 0.62rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; }
        .sq-form-divider::before, .sq-form-divider::after { content: ''; flex: 1; height: 1px; background: var(--border-solid); }

        .empty-squad { text-align: center; padding: 30px 20px; }
        .empty-squad .es-icon { width: 64px; height: 64px; margin: 0 auto 14px; border-radius: 20px; background: linear-gradient(135deg,#f97316,#ef4444); color: white; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; box-shadow: 0 8px 20px rgba(239,68,68,0.25); }
        .empty-squad h3 { font-size: 1rem; font-weight: 800; margin-bottom: 4px; }
        .empty-squad p { font-size: 0.75rem; color: var(--text-secondary); font-weight: 500; line-height: 1.5; margin: 0 auto; max-width: 300px; }

        @media (min-width: 1024px) {
            .app-shell { max-width: 680px; margin: 0 auto; padding: 24px; }
        }
        @media (prefers-reduced-motion: reduce) { .sq-card, .sq-new { animation: none; } }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/app-intro') %>
<%- include('partials/sidebar') %>
<div class="app-shell">

    <div class="sq-header">
        <div class="sq-header-left">
            <div class="sq-avatar"><i class="fas fa-users"></i></div>
            <div>
                <div class="sq-title">Squad Streaks</div>
                <div class="sq-subtitle">Study together, win together</div>
            </div>
        </div>
        <% if (squads.length > 0) { %>
        <div class="sq-count-badge"><%= squads.length %> squad<%= squads.length === 1 ? '' : 's' %></div>
        <% } %>
    </div>

    <% if (locals.msg && msg) { %>
    <div class="flash-msg"><i class="fas fa-circle-check"></i> <%= msg %></div>
    <% } %>

    <% if (squads.length === 0) { %>

    <div class="sq-card">
        <div class="empty-squad">
            <div class="es-icon"><i class="fas fa-fire"></i></div>
            <h3>No squads yet</h3>
            <p>Create a squad or join one with a friend's invite code. If anyone misses a day, the whole squad's streak resets — accountability!</p>
        </div>

        <div style="padding:0 16px 16px;">
            <div class="sq-form">
                <input type="text" id="squadName" placeholder="Squad name (e.g. Physics Crew)">
                <button class="btn-sub" onclick="createSquad()"><i class="fas fa-plus"></i> Create Squad</button>
            </div>
            <div class="sq-form-divider"><span>or</span></div>
            <div class="sq-form">
                <input type="text" id="squadCode" placeholder="Enter invite code (e.g. AB12CD)" style="text-transform:uppercase;">
                <button class="btn-sub outline" onclick="joinSquad()"><i class="fas fa-sign-in-alt"></i> Join Squad</button>
            </div>
        </div>
    </div>

    <% } else { %>

    <% var allChecked = squads.every(function(s) { return s.meChecked; }); %>
    <div class="bulk-bar">
        <div class="bulk-info">
            <div class="bulk-title"><%= allChecked ? 'All checked in today ✓' : 'Today’s squad check-in' %></div>
            <div class="bulk-sub"><%= squads.filter(function(s) { return s.meChecked; }).length %>/<%= squads.length %> squads done</div>
        </div>
        <button class="btn-bulk <%= allChecked ? 'all-done' : '' %>" id="bulkBtn" onclick="checkInAll(this)" <%= allChecked ? 'disabled' : '' %>>
            <i class="fas <%= allChecked ? 'fa-check' : 'fa-check-double' %>"></i> Check in all
        </button>
    </div>

    <% squads.forEach(function(s) { %>
    <div class="sq-card <%= s.meChecked ? 'open' : '' %>" id="card-<%= s.id %>" data-id="<%= s.id %>">
        <div class="sq-card-top" onclick="toggleCard(<%= s.id %>)">
            <div class="sq-row">
                <div class="sq-ring <%= s.meChecked ? 'on' : '' %>"><i class="fas <%= s.meChecked ? 'fa-check' : 'fa-users' %>"></i></div>
                <div>
                    <div class="sq-name"><%= s.name %><%= s.isOwner ? ' <span style="color:var(--warning);font-size:0.6rem;">OWNER</span>' : '' %></div>
                    <div class="sq-meta"><%= s.memberCount %> members · <%= s.checkedToday %>/<%= s.memberCount %> checked in</div>
                </div>
                <div class="sq-streak">
                    <div class="sq-flame"><i class="fas fa-fire"></i> <%= s.streak %> <span>day<%= s.streak === 1 ? '' : 's' %></span></div>
                </div>
            </div>
            <div class="sq-progress">
                <div class="sp-head"><span>Today</span><span><%= s.checkedToday %>/<%= s.memberCount %></span></div>
                <div class="sp-bar"><div class="sp-fill <%= s.checkedToday >= s.memberCount ? 'full' : '' %>" style="width:<%= Math.round(s.checkedToday / s.memberCount * 100) %>%"></div></div>
            </div>
            <div class="av-stack">
                <% s.members.forEach(function(m) { %>
                <div class="av <%= m.checked_today ? 'done' : 'pending' %>" title="<%= m.fullname %>"><%= m.fullname ? m.fullname.charAt(0).toUpperCase() : 'U' %></div>
                <% }); %>
            </div>
        </div>
        <div class="sq-actions">
            <button class="btn-act btn-checkin <%= s.meChecked ? 'done' : '' %>" id="checkin-<%= s.id %>" onclick="event.stopPropagation();checkIn(<%= s.id %>, this)" <%= s.meChecked ? 'disabled' : '' %>>
                <i class="fas <%= s.meChecked ? 'fa-check' : 'fa-check-double' %>"></i> <%= s.meChecked ? 'Checked in ✓' : 'I’m in today' %>
            </button>
            <button class="btn-act btn-expand" onclick="event.stopPropagation();toggleCard(<%= s.id %>)">
                <i class="fas fa-chevron-down"></i> Members
            </button>
        </div>
        <div class="sq-members">
            <% s.members.forEach(function(m) { %>
            <div class="member-row">
                <div class="member-av"><%= m.fullname ? m.fullname.charAt(0).toUpperCase() : 'U' %></div>
                <div class="member-info">
                    <div class="member-name"><%= m.fullname %></div>
                    <div class="member-status"><%= m.checked_today ? 'Checked in today' : 'Pending check-in' %></div>
                </div>
                <div class="checkin-dot <%= m.checked_today ? 'done' : 'pending' %>"><i class="fas <%= m.checked_today ? 'fa-check' : 'fa-clock' %>"></i></div>
            </div>
            <% }); %>
            <div class="sq-footer-row">
                <div class="sq-code" onclick="copyCode('<%= s.inviteCode %>')" title="Copy invite code"><i class="fas fa-copy"></i> <%= s.inviteCode %></div>
                <button class="sq-leave" onclick="leaveSquad(<%= s.id %>)"><i class="fas fa-sign-out-alt"></i> <%= s.isOwner ? 'Dissolve' : 'Leave' %></button>
            </div>
        </div>
    </div>
    <% }); %>

    <div class="sq-new">
        <div class="sq-new-head" onclick="toggleNew()">
            <div class="sq-new-title"><i class="fas fa-plus"></i> Create or join another squad</div>
            <i class="fas fa-chevron-down" id="newChev" style="color:var(--text-secondary);"></i>
        </div>
        <div class="sq-form" id="newForm" style="display:none;">
            <input type="text" id="squadName2" placeholder="Squad name (e.g. Physics Crew)">
            <button class="btn-sub" onclick="createSquad()"><i class="fas fa-plus"></i> Create Squad</button>
            <div class="sq-form-divider"><span>or join with a code</span></div>
            <input type="text" id="squadCode2" placeholder="Enter invite code" style="text-transform:uppercase;">
            <button class="btn-sub outline" onclick="joinSquad()"><i class="fas fa-sign-in-alt"></i> Join Squad</button>
        </div>
    </div>

    <% } %>

</div>

<%- include('partials/bottom-nav', { activeNav: 'dashboard' }) %>
<script src="/js/animations.js"></script>
<script>
    function submitForm(action, nameVal, codeVal) {
        var f = document.createElement('form');
        f.method = 'POST'; f.action = action;
        var i = document.createElement('input');
        i.type = 'hidden'; i.name = nameVal ? 'name' : 'code';
        i.value = nameVal || codeVal;
        f.appendChild(i); document.body.appendChild(f); f.submit();
    }
    function createSquad() {
        var name = (document.getElementById('squadName') || document.getElementById('squadName2')).value.trim();
        if (!name) { alert('Enter a squad name'); return; }
        submitForm('/squads/create', name, null);
    }
    function joinSquad() {
        var code = (document.getElementById('squadCode') || document.getElementById('squadCode2')).value.trim();
        if (!code) { alert('Enter the invite code'); return; }
        submitForm('/squads/join', null, code);
    }
    function copyCode(code) {
        if (navigator.clipboard) navigator.clipboard.writeText(code).then(function(){ alert('Invite code copied: ' + code); });
        else alert('Invite code: ' + code);
    }
    function toggleCard(id) {
        var c = document.getElementById('card-' + id);
        c.classList.toggle('open');
    }
    function toggleNew() {
        var f = document.getElementById('newForm');
        f.style.display = f.style.display === 'none' ? 'flex' : 'none';
        var ch = document.getElementById('newChev');
        if (ch) ch.style.transform = f.style.display === 'flex' ? 'rotate(180deg)' : '';
    }
    function checkIn(id, btn) {
        fetch('/squads/checkin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ squad_id: id }) })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.success) {
                btn.classList.add('done');
                btn.innerHTML = '<i class="fas fa-check"></i> Checked in ✓';
                btn.disabled = true;
                location.reload();
            } else { alert(d.error || 'Check-in failed'); }
        }).catch(function() { alert('Network error'); });
    }
    function checkInAll(btn) {
        fetch('/squads/checkin-all', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.success) {
                btn.classList.add('all-done');
                btn.innerHTML = '<i class="fas fa-check"></i> All checked in';
                btn.disabled = true;
                location.reload();
            } else { alert(d.error || 'Bulk check-in failed'); }
        }).catch(function() { alert('Network error'); });
    }
    function leaveSquad(id) {
        if (confirm('Leave this squad? Your streak contribution will be removed.')) {
            var f = document.createElement('form');
            f.method = 'POST'; f.action = '/squads/leave';
            var i = document.createElement('input');
            i.type = 'hidden'; i.name = 'squad_id'; i.value = id;
            f.appendChild(i); document.body.appendChild(f); f.submit();
        }
    }
</script>
</body>
</html>