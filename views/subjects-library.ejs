<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Prepium | Library</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { --brand: #0062ff; --bg: #f8fafc; --text: #1e293b; }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; outline: none; }
        
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); margin: 0; color: var(--text); display: flex; justify-content: center; }
        .app-shell { width: 100%; max-width: 430px; background: white; min-height: 100vh; position: relative; padding-bottom: 100px; }

        /* Header */
        .top-bar { padding: 1.5rem 1.2rem; display: flex; justify-content: space-between; align-items: center; background: white; position: sticky; top: 0; z-index: 100; }
        .profile-info { display: flex; align-items: center; gap: 12px; }
        .avatar { width: 40px; height: 40px; background: linear-gradient(135deg, var(--brand), #00d2ff); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 800; }

        /* Search Bar */
        .search-container { padding: 0 1.2rem 1rem; }
        .search-box { 
            width: 100%; 
            padding: 1rem 1.2rem; 
            border-radius: 20px; 
            border: 1px solid #f1f5f9; 
            background: #f8fafc; 
            font-family: inherit; 
            font-size: 0.9rem; 
            font-weight: 600;
            transition: all 0.3s;
        }
        .search-box:focus { border-color: var(--brand); background: white; box-shadow: 0 10px 20px rgba(0,0,0,0.05); }

        /* Subject List */
        .section-label { padding: 0.5rem 1.2rem 0.8rem; font-size: 0.75rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.8px; }
        .library-container { padding: 0 1.2rem; }
        
        .subject-card { 
            background: #ffffff; 
            border: 1px solid #f1f5f9; 
            border-radius: 24px; 
            padding: 1.2rem; 
            margin-bottom: 12px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center;
            transition: 0.2s;
        }
        
        .subject-info h3 { margin: 0; font-size: 0.95rem; font-weight: 800; text-transform: capitalize; }
        .subject-info p { margin: 2px 0 0; font-size: 0.7rem; color: #94a3b8; font-weight: 600; }

        .count-badge { 
            background: #eff6ff; 
            color: var(--brand); 
            padding: 6px 12px; 
            border-radius: 12px; 
            font-weight: 800; 
            font-size: 0.8rem;
            border: 1px solid #dbeafe;
        }

        /* Bottom Nav (Consistent with Dashboard) */
        .bottom-nav { position: fixed; bottom: 0; width: 100%; max-width: 430px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); height: 85px; display: flex; justify-content: space-around; align-items: center; border-top: 1px solid #f1f5f9; z-index: 101; }
        .nav-link { text-decoration: none; color: #94a3b8; font-size: 0.65rem; font-weight: 800; text-align: center; }
        .nav-link.active { color: var(--brand); }
        .nav-link i { display: block; font-size: 1.4rem; margin-bottom: 4px; font-style: normal; }
        .fab { width: 60px; height: 60px; background: var(--brand); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem; transform: translateY(-25px); border: 6px solid white; text-decoration: none; box-shadow: 0 10px 20px rgba(0,98,255,0.3); }
    </style>
</head>
<body>

    <div class="app-shell">
        <header class="top-bar">
            <div class="profile-info">
                <div class="avatar"><%= user.fullname ? user.fullname[0].toUpperCase() : 'U' %></div>
                <div style="font-weight: 800; font-size: 1rem;">Subject Library</div>
            </div>
            <a href="/dashboard" style="text-decoration: none; font-size: 1.2rem;">🏠</a>
        </header>

        <div class="search-container">
            <input type="text" id="subjectSearch" class="search-box" placeholder="Search for a subject (e.g. Physics)..." onkeyup="filterSubjects()">
        </div>

        <div class="section-label">Available Resources</div>
        
        <div class="library-container" id="libraryGrid">
            <% if (subjects && subjects.length > 0) { %>
                <% subjects.forEach(sub => { %>
                    <div class="subject-card">
                        <div class="subject-info">
                            <h3><%= sub.subject %></h3>
                            <p>Verified Questions</p>
                        </div>
                        <div class="count-badge">
                            <%= sub.question_count %> Qs
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div style="text-align: center; padding: 3rem 1rem;">
                    <p style="color: #94a3b8; font-weight: 600;">No subjects found.</p>
                </div>
            <% } %>
        </div>

        <nav class="bottom-nav">
            <a href="/dashboard" class="nav-link"><i>🏠</i>Home</a>
            <a href="/history" class="nav-link"><i>📜</i>History</a>
            <a href="/setup-test" class="fab">+</a>
            <a href="/subjects" class="nav-link active"><i>📚</i>Library</a>
            <a href="/profile" class="nav-link"><i>👤</i>Profile</a>
        </nav>
    </div>

    <script>
        function filterSubjects() {
            const input = document.getElementById('subjectSearch');
            const filter = input.value.toLowerCase();
            const grid = document.getElementById('libraryGrid');
            const cards = grid.getElementsByClassName('subject-card');

            for (let i = 0; i < cards.length; i++) {
                let title = cards[i].getElementsByTagName('h3')[0];
                if (title) {
                    let textValue = title.textContent || title.innerText;
                    if (textValue.toLowerCase().indexOf(filter) > -1) {
                        cards[i].style.display = "";
                    } else {
                        cards[i].style.display = "none";
                    }
                }
            }
        }
    </script>
</body>
</html>