<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        .status-bar { height: env(safe-area-inset-top, 0px); }
        .app-shell { display: flex; flex-direction: column; height: 100dvh; padding-bottom: 0; }
        .page-content { flex: 1; display: flex; flex-direction: column; padding: 0; max-width: 760px; margin: 0 auto; width: 100%; overflow: hidden; }

        .thread-head {
            display: flex; align-items: center; gap: 0.7rem;
            padding: 0.7rem 1rem; border-bottom: 1px solid var(--border);
            background: var(--surface-solid); position: sticky; top: 0; z-index: 5;
        }
        .thread-avatar { width: 40px; height: 40px; flex: 0 0 40px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-weight: 800; font-size: 0.85rem; }
        .thread-avatar.group { border-radius: 12px; }
        .thread-name { flex: 1; min-width: 0; }
        .thread-name b { display: block; font-size: 0.9rem; font-weight: 800; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .thread-name span { font-size: 0.62rem; color: var(--text-muted); }
        .thread-name span.typing { color: var(--brand); font-weight: 700; }
        .icon-btn { border: none; background: var(--bg); color: var(--text-secondary); width: 36px; height: 36px; border-radius: 50%; cursor: pointer; display: grid; place-items: center; flex: 0 0 36px; }

        .msgs { flex: 1; overflow-y: auto; padding: 0.9rem 0.9rem 0.4rem; display: flex; flex-direction: column; gap: 0.35rem; }
        .msg { max-width: 78%; display: flex; flex-direction: column; }
        .msg.mine { align-self: flex-end; align-items: flex-end; }
        .msg.theirs { align-self: flex-start; align-items: flex-start; }
        .sender-tag { font-size: 0.58rem; font-weight: 800; color: var(--brand); margin: 0.25rem 0 0 0.6rem; }
        .bubble {
            padding: 0.55rem 0.75rem; border-radius: 16px; font-size: 0.82rem; line-height: 1.45;
            word-break: break-word; white-space: pre-wrap; position: relative;
            box-shadow: var(--shadow-sm);
        }
        .msg.mine .bubble { background: var(--brand-gradient); color: #fff; border-bottom-right-radius: 6px; }
        .msg.theirs .bubble { background: var(--surface-solid); border: 1px solid var(--border-solid); color: var(--text-primary); border-bottom-left-radius: 6px; }
        .bubble img { max-width: 260px; max-height: 300px; border-radius: 12px; display: block; cursor: pointer; }
        .msg-meta { display: flex; align-items: center; gap: 4px; font-size: 0.56rem; color: var(--text-muted); padding: 2px 6px 0; }
        .msg.mine .msg-meta { color: rgba(255,255,255,0.75); }
        .msg.mine .msg-meta.outside { color: var(--text-muted); }
        .tick { font-size: 0.66rem; }
        .tick.read { color: #38bdf8; }

        .voice-bubble { display: flex; align-items: center; gap: 0.55rem; min-width: 190px; }
        .voice-play { width: 34px; height: 34px; flex: 0 0 34px; border-radius: 50%; border: none; cursor: pointer; display: grid; place-items: center; background: rgba(255,255,255,0.25); color: #fff; font-size: 0.8rem; }
        .msg.theirs .voice-play { background: var(--brand-soft); color: var(--brand); }
        .voice-bars { flex: 1; display: flex; align-items: center; gap: 2px; height: 22px; }
        .voice-bars i { width: 3px; border-radius: 2px; background: currentColor; opacity: 0.45; }
        .voice-bars i.on { opacity: 1; }
        .voice-dur { font-size: 0.6rem; font-weight: 700; flex: 0 0 auto; }

        .day-sep { align-self: center; font-size: 0.58rem; font-weight: 700; color: var(--text-muted); background: var(--bg); border: 1px solid var(--border-solid); padding: 3px 10px; border-radius: 99px; margin: 0.5rem 0; }

        .typing-row { align-self: flex-start; display: none; margin: 0.2rem 0 0.4rem 0.4rem; }
        .typing-row.show { display: flex; gap: 3px; align-items: center; background: var(--surface-solid); border: 1px solid var(--border-solid); border-radius: 14px; padding: 0.45rem 0.7rem; }
        .typing-row i { width: 5px; height: 5px; border-radius: 50%; background: var(--text-muted); animation: tp 1s infinite; }
        .typing-row i:nth-child(2) { animation-delay: 0.15s; }
        .typing-row i:nth-child(3) { animation-delay: 0.3s; }
        @keyframes tp { 50% { transform: translateY(-4px); opacity: 0.4; } }

        .composer { display: flex; align-items: flex-end; gap: 6px; padding: 0.6rem 0.7rem calc(0.6rem + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--border); background: var(--surface-solid); }
        .comp-btn { width: 40px; height: 40px; flex: 0 0 40px; border: none; border-radius: 50%; background: var(--bg); color: var(--text-secondary); cursor: pointer; display: grid; place-items: center; font-size: 0.95rem; transition: transform 0.12s; }
        .comp-btn:active { transform: scale(0.92); }
        .comp-btn.rec { background: var(--danger-soft); color: var(--danger); animation: recpulse 1.1s infinite; }
        @keyframes recpulse { 50% { box-shadow: 0 0 0 7px rgba(239, 68, 68, 0.15); } }
        #msgInput {
            flex: 1; min-width: 0; border: 1.5px solid var(--border-solid); border-radius: 20px;
            background: var(--bg); color: var(--text-primary); font-family: inherit;
            font-size: 0.85rem; padding: 0.62rem 0.95rem; outline: none; resize: none; max-height: 110px;
            transition: border-color 0.15s;
        }
        #msgInput:focus { border-color: var(--brand); }
        #sendBtn { background: var(--brand-gradient); color: #fff; }
        .rec-bar { display: none; flex: 1; align-items: center; gap: 0.6rem; background: var(--danger-soft); border-radius: 20px; padding: 0.5rem 0.8rem; }
        .rec-bar.show { display: flex; }
        .rec-bar i.fa-circle { color: var(--danger); font-size: 0.6rem; animation: recpulse 1s infinite; }
        .rec-time { font-size: 0.78rem; font-weight: 800; color: var(--danger); font-variant-numeric: tabular-nums; flex: 1; }

        .sheet-backdrop { position: fixed; inset: 0; background: rgba(2, 6, 23, 0.55); z-index: 60; display: none; align-items: flex-end; justify-content: center; backdrop-filter: blur(3px); }
        .sheet-backdrop.open { display: flex; }
        .sheet { background: var(--surface-solid); width: 100%; max-width: 520px; border-radius: 22px 22px 0 0; padding: 1.1rem 1.1rem 1.5rem; max-height: 82vh; overflow-y: auto; }
        .sheet h3 { font-size: 0.95rem; font-weight: 800; margin-bottom: 0.7rem; display: flex; align-items: center; justify-content: space-between; }
        .sheet h3 button { border: none; background: var(--bg); color: var(--text-secondary); width: 30px; height: 30px; border-radius: 50%; cursor: pointer; }
        .member-row { display: flex; align-items: center; gap: 0.65rem; padding: 0.5rem 0.3rem; }
        .member-row .avatar { width: 38px; height: 38px; flex: 0 0 38px; border-radius: 50%; display: grid; place-items: center; color: #fff; font-weight: 800; font-size: 0.8rem; }
        .role-chip { font-size: 0.52rem; font-weight: 800; padding: 2px 7px; border-radius: 99px; text-transform: uppercase; background: var(--brand-soft); color: var(--brand); }
        .sheet-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin-top: 0.9rem; }
        .sheet-act { border: 1px solid var(--border-solid); background: var(--bg); color: var(--text-secondary); border-radius: 12px; padding: 0.7rem; font-family: inherit; font-size: 0.7rem; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; }
        .sheet-act.danger { background: var(--danger-soft); color: var(--danger); border-color: transparent; }

        .empty-note { padding: 2rem 1rem; text-align: center; color: var(--text-muted); font-size: 0.78rem; }
        @media (min-width: 431px) { .app-shell { border-left: 1px solid var(--glass-border); border-right: 1px solid var(--glass-border); margin: 0 auto; } }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="status-bar"></div>
    <div class="page-content">
        <div class="thread-head">
            <a href="/chat" class="back-circle" style="margin:0"><i class="fas fa-arrow-left"></i></a>
            <div class="thread-avatar" id="threadAvatar">…</div>
            <div class="thread-name">
                <b id="threadTitle">Loading…</b>
                <span id="threadSub"></span>
            </div>
            <button class="icon-btn" id="infoBtn"><i class="fas fa-circle-info"></i></button>
        </div>

        <div class="msgs" id="msgs">
            <div class="empty-note"><i class="fas fa-spinner fa-spin"></i> Loading messages…</div>
        </div>
        <div class="typing-row" id="typingRow"><i></i><i></i><i></i></div>

        <div class="composer">
            <input type="file" id="imgInput" accept="image/*" style="display:none">
            <button class="comp-btn" id="imgBtn" title="Send photo"><i class="fas fa-image"></i></button>
            <div class="rec-bar" id="recBar">
                <i class="fas fa-circle"></i>
                <span class="rec-time" id="recTime">0:00</span>
                <button class="comp-btn" id="recCancel" title="Cancel"><i class="fas fa-trash"></i></button>
            </div>
            <input id="msgInput" type="text" placeholder="Type a message…" autocomplete="off" enterkeyhint="send">
            <button class="comp-btn" id="micBtn" title="Record voice note"><i class="fas fa-microphone"></i></button>
            <button class="comp-btn" id="sendBtn" title="Send"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>
</div>

<div class="sheet-backdrop" id="sheetBackdrop">
    <div class="sheet">
        <h3><span id="sheetTitle">Chat info</span><button onclick="closeSheet()"><i class="fas fa-xmark"></i></button></h3>
        <div id="sheetBody"></div>
        <div class="sheet-actions" id="sheetActions" style="display:none">
            <button class="sheet-act" id="addMemberBtn"><i class="fas fa-user-plus"></i> Add members</button>
            <button class="sheet-act" id="renameBtn"><i class="fas fa-pen"></i> Rename</button>
            <button class="sheet-act danger" id="leaveBtn"><i class="fas fa-right-from-bracket"></i> Leave group</button>
            <button class="sheet-act danger" id="deleteBtn"><i class="fas fa-trash"></i> Delete group</button>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
(function () {
    'use strict';
    var CID = <%- JSON.stringify(convId) %>;
    var MY_ID = <%- JSON.stringify(user.id) %>;

    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return {'&':'&'+'amp;','<':'&'+'lt;','>':'&'+'gt;','"':'&'+'quot;',"'":'&#39;'}[c]; }); }
    function avatarColor(id) { return 'hsl(' + ((id * 137.5) % 360) + ', 62%, 45%)'; }
    function initials(name) { return String(name || '?').trim().split(/\s+/).slice(0, 2).map(function (w) { return w.charAt(0); }).join(''); }
    function fmtTime(v) { var d = new Date(v); return isNaN(d) ? '' : d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' }); }
    function fmtDay(v) { var d = new Date(v); var now = new Date(); if (d.toDateString() === now.toDateString()) return 'Today'; var y = new Date(now); y.setDate(now.getDate() - 1); if (d.toDateString() === y.toDateString()) return 'Yesterday'; return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }); }
    function fmtDur(s) { var m = Math.floor(s / 60); return m + ':' + String(s % 60).padStart(2, '0'); }

    var msgsEl = document.getElementById('msgs');
    var typingTimer = null;
    var info = null;

    var socket = null;
    try {
        socket = io({ transports: ['polling', 'websocket'] });
        socket.on('chat:message', function (data) {
            if (!data || data.conversationId !== CID) return;
            appendMessage(data.message);
            markRead();
        });
        socket.on('chat:typing', function (data) {
            if (!data || data.conversationId !== CID) return;
            var row = document.getElementById('typingRow');
            row.classList.add('show');
            clearTimeout(typingTimer);
            typingTimer = setTimeout(function () { row.classList.remove('show'); }, 2500);
        });
        socket.on('chat:read', function (data) {
            if (!data || data.conversationId !== CID) return;
            document.querySelectorAll('.tick[data-status]').forEach(function (t) { t.className = 'fas fa-check-double tick read'; t.removeAttribute('data-status'); });
        });
        socket.on('chat:members', function () { loadInfo(); });
    } catch (e) {}

    function ticksHtml(m) {
        if (!m.mine) return '';
        var cls = 'fas ' + (m.status === 'sent' ? 'fa-check' : 'fa-check-double') + ' tick' + (m.status === 'read' ? ' read' : '');
        return '<i class="' + cls + '" data-status="' + m.status + '"></i>';
    }

    function voiceBars() {
        var bars = '';
        for (var i = 0; i < 22; i++) {
            var h = 4 + Math.round(Math.abs(Math.sin(i * 1.7)) * 14);
            bars += '<i style="height:' + h + 'px"></i>';
        }
        return bars;
    }

    function messageHtml(m) {
        var html = '';
        var prev = m._prevDay;
        if (prev !== fmtDay(m.created_at)) html += '<div class="day-sep">' + esc(fmtDay(m.created_at)) + '</div>';
        m._prevDay = fmtDay(m.created_at);
        if (!m.mine && info && info.type === 'group') {
            html += '<div class="sender-tag">' + esc(m.sender_name) + '</div>';
        }
        var inner;
        if (m.kind === 'image') {
            inner = '<div class="bubble"><img src="/api/chat/media/' + m.id + '" alt="Photo" loading="lazy" onclick="viewImage(this.src)"></div>';
        } else if (m.kind === 'voice') {
            inner = '<div class="bubble"><div class="voice-bubble">' +
                '<button class="voice-play" onclick="playVoice(this, ' + m.id + ')"><i class="fas fa-play"></i></button>' +
                '<div class="voice-bars">' + voiceBars() + '</div>' +
                '<span class="voice-dur">' + fmtDur(m.media_duration || 0) + '</span>' +
                '</div></div>';
        } else {
            inner = '<div class="bubble">' + esc(m.body) + '</div>';
        }
        html += '<div class="msg ' + (m.mine ? 'mine' : 'theirs') + '">' + inner +
            '<div class="msg-meta' + (m.mine ? '' : ' outside') + '"><span>' + fmtTime(m.created_at) + '</span>' + ticksHtml(m) + '</div></div>';
        return html;
    }

    function renderMessages(messages) {
        msgsEl.innerHTML = '';
        if (!messages.length) {
            msgsEl.innerHTML = '<div class="empty-note">Say hello 👋</div>';
            return;
        }
        var html = '';
        messages.forEach(function (m) { html += messageHtml(m); });
        msgsEl.innerHTML = html;
        msgsEl.scrollTop = msgsEl.scrollHeight;
    }

    function appendMessage(m) {
        var empty = msgsEl.querySelector('.empty-note');
        if (empty) empty.remove();
        msgsEl.insertAdjacentHTML('beforeend', messageHtml(m));
        msgsEl.scrollTop = msgsEl.scrollHeight;
    }

    function loadMessages() {
        fetch('/api/chat/conversations/' + CID + '/messages?read=1', { headers: { Accept: 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.success) { msgsEl.innerHTML = '<div class="empty-note">Could not load messages.</div>'; return; }
                renderMessages(d.messages || []);
            })
            .catch(function () { msgsEl.innerHTML = '<div class="empty-note">Could not load messages.</div>'; });
    }

    function markRead() {
        fetch('/api/chat/conversations/' + CID + '/read', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }).catch(function () {});
    }

    function sendMessage(kind, payload, cb) {
        var fd = new FormData();
        fd.append('kind', kind);
        if (kind === 'text') fd.append('body', payload);
        if (kind === 'voice') { fd.append('media', payload.blob, 'voice.webm'); fd.append('duration', payload.duration); }
        if (kind === 'image') fd.append('media', payload, 'photo.jpg');
        fetch('/api/chat/conversations/' + CID + '/send', { method: 'POST', body: fd })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d.success) { appendMessage(d.message); if (cb) cb(); }
                else Swal.fire({ icon: 'error', title: d.error || 'Could not send', confirmButtonColor: '#2563eb' });
            })
            .catch(function () { Swal.fire({ icon: 'error', title: 'Could not send', confirmButtonColor: '#2563eb' }); });
    }

    var input = document.getElementById('msgInput');
    function submitText() {
        var text = input.value.trim();
        if (!text) return;
        input.value = '';
        sendMessage('text', text);
    }
    document.getElementById('sendBtn').addEventListener('click', submitText);
    input.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); submitText(); } });
    input.addEventListener('input', function () {
        if (socket && input.value.trim()) socket.emit('chat:typing', { conversationId: CID });
    });

    // ---- images ----
    document.getElementById('imgBtn').addEventListener('click', function () { document.getElementById('imgInput').click(); });
    document.getElementById('imgInput').addEventListener('change', function (e) {
        var file = e.target.files[0];
        e.target.value = '';
        if (!file) return;
        var img = new Image();
        img.onload = function () {
            var canvas = document.createElement('canvas');
            var scale = Math.min(1, 1280 / Math.max(img.width, img.height));
            canvas.width = Math.round(img.width * scale);
            canvas.height = Math.round(img.height * scale);
            canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
            canvas.toBlob(function (blob) {
                if (blob) sendMessage('image', blob);
            }, 'image/jpeg', 0.85);
        };
        img.onerror = function () { Swal.fire({ icon: 'error', title: 'Could not read image', confirmButtonColor: '#2563eb' }); };
        img.src = URL.createObjectURL(file);
    });
    window.viewImage = function (src) {
        Swal.fire({ imageUrl: src, imageAlt: 'Photo', showConfirmButton: false, background: '#000' });
    };

    // ---- voice notes ----
    var mediaRecorder = null, chunks = [], recStart = 0, recTimer = null, recording = false;
    var micBtn = document.getElementById('micBtn');
    var recBar = document.getElementById('recBar');
    micBtn.addEventListener('click', function () {
        if (recording) { stopRecording(true); return; }
        if (!navigator.mediaDevices || !window.MediaRecorder) {
            Swal.fire({ icon: 'error', title: 'Recording not supported on this device', confirmButtonColor: '#2563eb' });
            return;
        }
        navigator.mediaDevices.getUserMedia({ audio: true }).then(function (stream) {
            mediaRecorder = new MediaRecorder(stream);
            chunks = [];
            mediaRecorder.ondataavailable = function (e) { if (e.data.size) chunks.push(e.data); };
            mediaRecorder.onstop = function () {
                stream.getTracks().forEach(function (t) { t.stop(); });
                var duration = Math.max(1, Math.round((Date.now() - recStart) / 1000));
                var blob = new Blob(chunks, { type: mediaRecorder.mimeType || 'audio/webm' });
                if (blob.size > 1000) sendMessage('voice', { blob: blob, duration: duration });
            };
            mediaRecorder.start();
            recording = true;
            recStart = Date.now();
            recBar.classList.add('show');
            micBtn.classList.add('rec');
            micBtn.querySelector('i').className = 'fas fa-stop';
            recTimer = setInterval(function () {
                document.getElementById('recTime').textContent = fmtDur(Math.floor((Date.now() - recStart) / 1000));
            }, 500);
        }).catch(function () {
            Swal.fire({ icon: 'error', title: 'Microphone access denied', confirmButtonColor: '#2563eb' });
        });
    });
    document.getElementById('recCancel').addEventListener('click', function () { stopRecording(false); });
    function stopRecording(send) {
        if (!recording) return;
        recording = false;
        clearInterval(recTimer);
        recBar.classList.remove('show');
        micBtn.classList.remove('rec');
        micBtn.querySelector('i').className = 'fas fa-microphone';
        if (!send) { mediaRecorder.onstop = function () { mediaRecorder.stream.getTracks().forEach(function (t) { t.stop(); }); }; }
        mediaRecorder.stop();
    }

    window.playVoice = function (btn, id) {
        var existing = document.getElementById('voiceAudio');
        if (existing) { existing.pause(); existing.remove(); }
        var audio = new Audio('/api/chat/media/' + id);
        audio.id = 'voiceAudio';
        var icon = btn.querySelector('i');
        icon.className = 'fas fa-spinner fa-spin';
        audio.play().then(function () {
            icon.className = 'fas fa-pause';
            audio.onended = function () { icon.className = 'fas fa-play'; };
        }).catch(function () { icon.className = 'fas fa-play'; });
        btn.onclick = function () {
            if (audio.paused) { audio.play(); icon.className = 'fas fa-pause'; }
            else { audio.pause(); icon.className = 'fas fa-play'; }
        };
    };

    // ---- info sheet ----
    function loadInfo() {
        fetch('/api/chat/conversations/' + CID + '/info', { headers: { Accept: 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.success) { window.location.href = '/chat'; return; }
                info = d.conversation;
                info.members = d.members;
                info.my_role = d.my_role;
                var av = document.getElementById('threadAvatar');
                av.className = 'thread-avatar' + (info.type === 'group' ? ' group' : '');
                av.style.background = avatarColor(info.id);
                av.innerHTML = info.type === 'group' ? '<i class="fas fa-users"></i>' : esc(initials(d.members.filter(function (m) { return m.id !== MY_ID; })[0] ? d.members.filter(function (m) { return m.id !== MY_ID; })[0].fullname : '?'));
                document.getElementById('threadTitle').textContent = info.type === 'group' ? info.name : (d.members.filter(function (m) { return m.id !== MY_ID; })[0] || { fullname: 'Conversation' }).fullname;
                document.getElementById('threadSub').textContent = info.type === 'group' ? d.members.length + ' members' : 'Friend chat';
            })
            .catch(function () {});
    }

    window.closeSheet = function () { document.getElementById('sheetBackdrop').classList.remove('open'); };
    document.getElementById('sheetBackdrop').addEventListener('click', function (e) { if (e.target === this) closeSheet(); });

    document.getElementById('infoBtn').addEventListener('click', function () {
        if (!info) return;
        var isAdmin = info.my_role === 'admin';
        var body = '<div>' + info.members.map(function (m) {
            var actions = '';
            if (isAdmin && info.type === 'group' && m.id !== MY_ID) {
                actions = '<button class="p-btn no" style="margin-left:auto;border:none;border-radius:9px;padding:0.4rem 0.6rem;font-weight:800;cursor:pointer;background:var(--danger-soft);color:var(--danger)" onclick="removeMember(' + m.id + ')"><i class="fas fa-user-minus"></i></button>';
            }
            return '<div class="member-row">' +
                '<div class="avatar" style="background:' + avatarColor(m.id) + '">' + esc(initials(m.fullname)) + '</div>' +
                '<div><div style="font-size:0.8rem;font-weight:700">' + esc(m.fullname) + (m.id === MY_ID ? ' (You)' : '') + '</div>' +
                '<div style="font-size:0.6rem;color:var(--text-muted)">Level ' + m.level + '</div></div>' +
                (m.role === 'admin' ? '<span class="role-chip">Admin</span>' : '') + actions + '</div>';
        }).join('') + '</div>';
        document.getElementById('sheetBody').innerHTML = body;
        var actions = document.getElementById('sheetActions');
        actions.style.display = info.type === 'group' ? '' : 'none';
        document.getElementById('addMemberBtn').style.display = isAdmin ? '' : 'none';
        document.getElementById('renameBtn').style.display = isAdmin ? '' : 'none';
        document.getElementById('deleteBtn').style.display = isAdmin ? '' : 'none';
        document.getElementById('sheetTitle').textContent = info.type === 'group' ? info.name : 'Chat info';
        document.getElementById('sheetBackdrop').classList.add('open');
    });

    window.removeMember = function (id) {
        fetch('/api/chat/conversations/' + CID + '/remove-member', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ userId: id }) })
            .then(function (r) { return r.json(); })
            .then(function (d) { if (d.success) { closeSheet(); loadInfo(); } });
    };

    document.getElementById('addMemberBtn').addEventListener('click', function () {
        fetch('/api/friends', { headers: { Accept: 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                var existing = {};
                info.members.forEach(function (m) { existing[m.id] = true; });
                var candidates = (d.friends || []).filter(function (f) { return !existing[f.id]; });
                if (!candidates.length) { Swal.fire({ icon: 'info', title: 'All your friends are already in this group', confirmButtonColor: '#2563eb' }); return; }
                Swal.fire({
                    title: 'Add members',
                    html: '<div style="text-align:left;max-height:260px;overflow-y:auto">' + candidates.map(function (f) {
                        return '<label style="display:flex;align-items:center;gap:8px;padding:6px 4px;font-size:0.85rem"><input type="checkbox" class="swal-member" value="' + f.id + '"> ' + esc(f.fullname) + '</label>';
                    }).join('') + '</div>',
                    showCancelButton: true,
                    confirmButtonText: 'Add',
                    confirmButtonColor: '#2563eb',
                    preConfirm: function () {
                        return Array.prototype.map.call(document.querySelectorAll('.swal-member:checked'), function (el) { return parseInt(el.value, 10); });
                    }
                }).then(function (res) {
                    if (!res.isConfirmed || !res.value.length) return;
                    fetch('/api/chat/conversations/' + CID + '/members', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ userIds: res.value }) })
                        .then(function (r) { return r.json(); })
                        .then(function (d2) { if (d2.success) { closeSheet(); loadInfo(); } });
                });
            });
    });

    document.getElementById('renameBtn').addEventListener('click', function () {
        Swal.fire({
            title: 'Rename group',
            input: 'text',
            inputValue: info.name,
            showCancelButton: true,
            confirmButtonColor: '#2563eb'
        }).then(function (res) {
            if (!res.isConfirmed || !res.value) return;
            fetch('/api/chat/conversations/' + CID + '/rename', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: res.value }) })
                .then(function (r) { return r.json(); })
                .then(function (d) { if (d.success) { closeSheet(); loadInfo(); } });
        });
    });

    document.getElementById('leaveBtn').addEventListener('click', function () {
        Swal.fire({ icon: 'warning', title: 'Leave this group?', showCancelButton: true, confirmButtonColor: '#dc2626' })
            .then(function (res) {
                if (!res.isConfirmed) return;
                fetch('/api/chat/conversations/' + CID + '/leave', { method: 'POST' })
                    .then(function () { window.location.href = '/chat'; });
            });
    });

    document.getElementById('deleteBtn').addEventListener('click', function () {
        Swal.fire({ icon: 'warning', title: 'Delete group for everyone?', text: 'This cannot be undone.', showCancelButton: true, confirmButtonColor: '#dc2626' })
            .then(function (res) {
                if (!res.isConfirmed) return;
                fetch('/api/chat/conversations/' + CID, { method: 'DELETE' })
                    .then(function () { window.location.href = '/chat'; });
            });
    });

    loadInfo();
    loadMessages();
    markRead();
    setInterval(loadMessages, 8000);
})();
</script>
</body>
</html>
