<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alite Admin | Community Hub</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { --brand: #0062ff; --bg: #f8fafc; --text: #0f172a; --border: #e2e8f0; --white: #ffffff; --whatsapp: #25D366; }
        * { box-sizing: border-box; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--text); margin: 0; padding: 20px; }
        
        .admin-container { max-width: 1300px; margin: 0 auto; }
        
        /* Header & Action Bar */
        .admin-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; flex-wrap: wrap; gap: 20px; }
        .admin-header h1 { margin: 0; font-size: 2rem; font-weight: 800; letter-spacing: -1px; }
        .admin-header p { margin: 5px 0 0; color: #64748b; font-weight: 600; }

        /* Stats Cards */
        .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: var(--white); padding: 24px; border-radius: 24px; border: 1px solid var(--border); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
        .stat-card span { display: block; font-size: 0.75rem; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; }
        .stat-card h3 { margin: 8px 0 0; font-size: 2rem; font-weight: 800; }

        /* Dashboard Grid */
        .dashboard-grid { display: grid; grid-template-columns: 350px 1fr; gap: 30px; }

        /* Cards */
        .card { background: var(--white); border-radius: 24px; border: 1px solid var(--border); padding: 25px; height: fit-content; }
        .card h2 { margin-top: 0; font-size: 1.25rem; font-weight: 800; margin-bottom: 20px; }

        /* Form Styling */
        .form-group { margin-bottom: 15px; }
        label { display: block; font-size: 0.75rem; font-weight: 700; margin-bottom: 6px; color: #475569; }
        input { width: 100%; padding: 12px 16px; border-radius: 12px; border: 1px solid var(--border); font-family: inherit; font-weight: 600; outline: none; }
        input:focus { border-color: var(--brand); }

        .btn { display: inline-flex; align-items: center; justify-content: center; padding: 12px 24px; border-radius: 14px; font-weight: 800; cursor: pointer; border: none; transition: 0.2s; text-decoration: none; font-size: 0.95rem; }
        .btn-primary { background: var(--brand); color: white; width: 100%; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgba(0, 98, 255, 0.3); }
        .btn-dark { background: #0f172a; color: white; }

        /* Table Styling */
        .table-wrapper { background: var(--white); border-radius: 24px; border: 1px solid var(--border); overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; text-align: left; min-width: 600px; }
        th { background: #f1f5f9; padding: 16px; font-size: 0.7rem; font-weight: 800; color: #64748b; text-transform: uppercase; }
        td { padding: 16px; font-size: 0.9rem; font-weight: 600; border-bottom: 1px solid #f1f5f9; }
        
        .wa-link { color: var(--whatsapp); text-decoration: none; display: flex; align-items: center; gap: 6px; font-weight: 700; }
        .wa-link:hover { text-decoration: underline; }
        
        .badge { background: #eff6ff; color: var(--brand); padding: 4px 10px; border-radius: 8px; font-size: 0.75rem; font-weight: 700; }
        .other-tag { color: #94a3b8; font-style: italic; font-size: 0.85rem; }

        @media (max-width: 992px) { .dashboard-grid { grid-template-columns: 1fr; } }
    </style>
</head>
<body>

    <div class="admin-container">
        <header class="admin-header">
            <div>
                <h1>Community Dashboard</h1>
                <p>Welcome back, Alite. Monitoring <%= leads.length %> potential members.</p>
            </div>
            <a href="/admin/export-leads" class="btn btn-dark">
                📥 Export Contacts (CSV)
            </a>
        </header>

        <div class="stats-row">
            <div class="stat-card">
                <span>Total Leads</span>
                <h3><%= leads.length %></h3>
            </div>
            <div class="stat-card">
                <span>Active Hubs</span>
                <h3><%= schools.length %></h3>
            </div>
            <div class="stat-card">
                <span>New Today</span>
                <h3>
                    <%= leads.filter(l => new Date(l.created_at).toDateString() === new Date().toDateString()).length %>
                </h3>
            </div>
        </div>

        <div class="dashboard-grid">
            <aside class="card">
                <h2>Add New School</h2>
                <form action="/admin/add-school" method="POST">
                    <div class="form-group">
                        <label>Institution Name</label>
                        <input type="text" name="schoolName" placeholder="e.g. University of Ibadan" required>
                    </div>
                    <div class="form-group">
                        <label>Contact Slug (e.g. UI, UNILAG)</label>
                        <input type="text" name="slug" placeholder="UI" required maxlength="10">
                    </div>
                    <div class="form-group">
                        <label>WhatsApp Group Link</label>
                        <input type="url" name="groupLink" placeholder="https://chat.whatsapp.com/..." required>
                    </div>
                    <button type="submit" class="btn btn-primary">Create Hub Link</button>
                </form>
            </aside>

            <section class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Student Name</th>
                            <th>WhatsApp Number</th>
                            <th>Institution</th>
                            <th>Joined</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (leads.length === 0) { %>
                            <tr>
                                <td colspan="4" style="text-align: center; padding: 40px; color: #94a3b8;">No leads yet. Start sharing your link!</td>
                            </tr>
                        <% } %>
                        <% leads.forEach(lead => { %>
                            <tr>
                                <td style="font-weight: 800;"><%= lead.full_name %></td>
                                <td>
                                    <a href="https://wa.me/<%= lead.whatsapp_number.replace(/\D/g,'') %>" target="_blank" class="wa-link">
                                        <span>💬</span> <%= lead.whatsapp_number %>
                                    </a>
                                </td>
                                <td>
                                    <% if(lead.registered_school) { %>
                                        <span class="badge"><%= lead.registered_school %></span>
                                    <% } else { %>
                                        <span class="other-tag"><%= lead.other_school || 'General Community' %></span>
                                    <% } %>
                                </td>
                                <td style="color: #64748b; font-size: 0.8rem;">
                                    <%= new Date(lead.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </section>
        </div>
    </div>

</body>
</html>