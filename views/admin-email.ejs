<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | Send Email</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root { --brand: #0062ff; --bg: #f0f4f8; --text: #0f172a; --border: #e2e8f0; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
        .main { max-width: 800px; margin: 0 auto; padding: 2rem 1.5rem; }
        h1 { font-size: 1.6rem; font-weight: 800; margin-bottom: 0.25rem; }
        p.desc { color: #64748b; font-weight: 600; margin-bottom: 1.5rem; font-size: 0.85rem; }
        .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 10px; }
        .nav-links { display: flex; gap: 8px; flex-wrap: wrap; }
        .nav-links a { padding: 8px 16px; border-radius: 10px; background: white; color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.78rem; border: 1px solid var(--border); }
        .nav-links a:hover { background: var(--brand); color: white; border-color: var(--brand); }
        .card { background: white; border-radius: 20px; padding: 1.5rem; border: 1px solid var(--border); box-shadow: 0 4px 24px rgba(0,0,0,0.04); }
        .form-group { margin-bottom: 1rem; }
        label { display: block; font-size: 0.72rem; font-weight: 800; color: #64748b; text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.5px; }
        input, select, textarea {
            width: 100%; padding: 12px 14px; border-radius: 12px; border: 1.5px solid var(--border);
            font-family: inherit; font-size: 0.85rem; font-weight: 600; background: #f8fafc; outline: none;
        }
        input:focus, select:focus, textarea:focus { border-color: var(--brand); background: white; }
        textarea { min-height: 200px; resize: vertical; }
        .btn-primary {
            padding: 13px 28px; border-radius: 12px; border: none;
            background: linear-gradient(135deg,#0062ff,#4f46e5); color: white; font-weight: 800; font-size: 0.85rem; cursor: pointer;
        }
        .btn-primary:hover { opacity: 0.95; }
        .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
        .msg { padding: 12px 16px; border-radius: 12px; font-weight: 700; font-size: 0.8rem; margin-bottom: 1rem; }
        .msg.success { background: #dcfce7; color: #15803d; }
        .msg.error { background: #fee2e2; color: #b91c1c; }
        .filter-row { display: flex; gap: 10px; margin-bottom: 1rem; flex-wrap: wrap; }
        .filter-row select { flex: 1; min-width: 150px; }

        @media (max-width: 768px) {
            .main { padding: 1rem; }
            .card { padding: 1rem; }
            .filter-row { flex-direction: column; }
        }
    </style>
</head>
<body>
<div class="main">
    <div class="top-bar">
        <div>
            <h1>Send Email</h1>
            <p class="desc">Send bulk email to students</p>
        </div>
        <div class="nav-links">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/students">Students</a>
            <a href="/admin/ambassadors">Referrals</a>
            <a href="/admin/withdrawals">Withdrawals</a>
            <a href="/admin/groups">Groups</a>
        </div>
    </div>

    <% if (typeof query !== 'undefined' && query && query.msg) { %><div class="msg success"><%= query.msg %></div><% } %>
    <% if (typeof query !== 'undefined' && query && query.error) { %><div class="msg error"><%= query.error %></div><% } %>

    <div class="card">
        <form action="/admin/email/send" method="POST">
            <div class="form-group">
                <label>Filter Recipients</label>
                <div class="filter-row">
                    <select name="filter_type">
                        <option value="">All Users</option>
                        <option value="university">By University</option>
                        <option value="tier">By Tier</option>
                    </select>
                    <select name="filter_value">
                        <option value="">— Select —</option>
                        <optgroup label="Universities">
                            <% if (typeof universities !== 'undefined' && universities) { universities.forEach(function(u) { %>
                                <option value="<%= u.id %>"><%= u.name %></option>
                            <% }); } %>
                        </optgroup>
                        <optgroup label="Tier">
                            <option value="premium">Premium</option>
                            <option value="free">Free</option>
                        </optgroup>
                        <optgroup label="Groups">
                            <% if (typeof groups !== 'undefined' && groups) { groups.forEach(function(g) { %>
                                <option value="<%= g.id %>"><%= g.name %></option>
                            <% }); } %>
                        </optgroup>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label>Subject</label>
                <input type="text" name="subject" placeholder="Email subject line" required maxlength="200">
            </div>
            <div class="form-group">
                <label>Message (HTML supported)</label>
                <textarea name="message" placeholder="Write your email message here... You can use HTML tags." required></textarea>
            </div>
            <button type="submit" class="btn-primary" id="sendBtn" onclick="this.disabled=true;this.textContent='Sending...'"><i class="fas fa-paper-plane"></i> Send Email</button>
        </form>
    </div>
</div>
<script>
(function() {
    var filterType = document.querySelector('select[name="filter_type"]');
    var filterValue = document.querySelector('select[name="filter_value"]');
    filterType.addEventListener('change', function() {
        filterValue.value = '';
    });
})();
</script>
</body>
</html>