<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>Prepium | Study Session</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .status-bar { height: env(safe-area-inset-top, 0px); }
        .page-content { padding: 0 1.5rem; }

        .timer-section { text-align: center; padding: 1.5rem 0; }
        .timer-circle { width: 160px; height: 160px; margin: 0 auto 1rem; position: relative; }
        .timer-circle svg { width: 100%; height: 100%; transform: rotate(-90deg); }
        .timer-circle svg circle { fill: none; stroke-width: 6; stroke-linecap: round; }
        .timer-circle svg .bg-ring { stroke: #f1f5f9; }
        .timer-circle svg .progress-ring { stroke: var(--brand); stroke-dasharray: 440; stroke-dashoffset: 0; transition: stroke-dashoffset 0.5s var(--ease-out); }
        .timer-text { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .timer-text .time { font-size: 2.2rem; font-weight: 800; letter-spacing: -1px; line-height: 1; }
        .timer-text .lbl { font-size: 0.65rem; color: var(--text-sub); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-top: 2px; }

        .timer-controls { display: flex; justify-content: center; gap: 12px; margin-bottom: 0.5rem; }
        .timer-btn { width: 52px; height: 52px; border-radius: 50%; border: none; cursor: pointer; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; transition: var(--transition); }
        .timer-btn:active { transform: scale(0.9); }
        .timer-btn.start-btn { background: var(--brand-gradient); color: white; box-shadow: 0 6px 16px rgba(0, 98, 255, 0.25); }
        .timer-btn.start-btn:hover { transform: scale(1.05); }
        .timer-btn.reset-btn { background: #f1f5f9; color: var(--text-sub); }

        .tab-bar { display: flex; gap: 6px; margin-bottom: 1rem; background: #f1f5f9; border-radius: var(--radius-sm); padding: 4px; }
        .tab-pill { flex: 1; padding: 10px; border-radius: 8px; background: transparent; border: none; cursor: pointer; font-family: inherit; font-weight: 700; font-size: 0.72rem; color: var(--text-sub); transition: var(--transition); display: flex; align-items: center; justify-content: center; gap: 5px; }
        .tab-pill i { font-size: 0.8rem; }
        .tab-pill.active { background: white; color: var(--text-dark); box-shadow: var(--shadow-sm); }

        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .chat-box { background: white; border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; }
        .chat-messages { height: 360px; overflow-y: auto; padding: 14px; }
        .chat-msg { margin-bottom: 10px; display: flex; gap: 8px; }
        .chat-msg.ai { flex-direction: row; }
        .chat-msg.user { flex-direction: row-reverse; }
        .chat-msg .bubble { max-width: 80%; padding: 12px 14px; border-radius: var(--radius-sm); font-size: 0.8rem; font-weight: 500; line-height: 1.5; }
        .chat-msg.ai .bubble { background: var(--bg); border: 1px solid var(--border); }
        .chat-msg.user .bubble { background: var(--brand); color: white; }
        .chat-input-row { display: flex; gap: 8px; padding: 10px; border-top: 1px solid var(--border); }
        .chat-input-row input { flex: 1; padding: 12px 14px; border: 1.5px solid var(--border); border-radius: var(--radius-sm); font-family: inherit; font-size: 0.8rem; font-weight: 600; outline: none; }
        .chat-input-row input:focus { border-color: var(--brand); }
        .chat-input-row button { width: 46px; height: 46px; border-radius: var(--radius-sm); border: none; background: var(--brand-gradient); color: white; cursor: pointer; }

        .notes-area { width: 100%; min-height: 200px; padding: 14px; border: 1.5px solid var(--border); border-radius: var(--radius-sm); font-family: inherit; font-size: 0.82rem; font-weight: 500; line-height: 1.6; resize: vertical; outline: none; }
        .notes-area:focus { border-color: var(--brand); }
        .notes-actions { display: flex; gap: 8px; margin-top: 8px; }
        .notes-actions button { padding: 10px 18px; border-radius: var(--radius-sm); border: none; font-family: inherit; font-weight: 700; font-size: 0.75rem; cursor: pointer; }
        .notes-save { background: var(--brand-gradient); color: white; }
        .notes-load { background: #f1f5f9; color: var(--text-dark); }

        .yt-search-row { display: flex; gap: 8px; margin-bottom: 12px; }
        .yt-search-row input { flex: 1; padding: 12px 14px; border: 1.5px solid var(--border); border-radius: var(--radius-sm); font-family: inherit; font-size: 0.8rem; font-weight: 600; outline: none; }
        .yt-search-row input:focus { border-color: var(--brand); }
        .yt-search-row button { padding: 12px 18px; border-radius: var(--radius-sm); border: none; background: var(--brand-gradient); color: white; font-weight: 700; cursor: pointer; }
        .yt-video { background: white; border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; margin-bottom: 10px; }
        .yt-video iframe { width: 100%; aspect-ratio: 16 / 9; border: none; }
        .yt-video .yt-info { padding: 10px 14px; }
        .yt-video .yt-info h4 { font-size: 0.82rem; font-weight: 700; margin: 0 0 2px; }
        .yt-video .yt-info p { font-size: 0.7rem; color: var(--text-sub); font-weight: 500; margin: 0; }

        .fc-card { background: white; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 2.5rem 1.5rem; text-align: center; min-height: 200px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; transition: var(--transition); margin-bottom: 12px; }
        .fc-card:active { transform: scale(0.98); }
        .fc-card .fc-front { font-size: 1rem; font-weight: 700; }
        .fc-card .fc-back { font-size: 0.9rem; font-weight: 600; color: var(--text-sub); display: none; }
        .fc-card.flipped .fc-front { display: none; }
        .fc-card.flipped .fc-back { display: block; }
        .fc-card .tap-hint { font-size: 0.65rem; color: var(--text-muted); font-weight: 600; margin-top: 16px; }
        .fc-nav { display: flex; gap: 8px; justify-content: center; margin-bottom: 10px; }
        .fc-nav button { padding: 10px 20px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: white; font-family: inherit; font-weight: 700; font-size: 0.75rem; cursor: pointer; color: var(--text-dark); }
        .fc-nav button:active { transform: scale(0.95); }

        .end-session-btn { display: flex; justify-content: center; margin-top: 1rem; }
        .end-session-btn button { padding: 14px 32px; border-radius: var(--radius-sm); border: none; background: var(--danger); color: white; font-weight: 700; font-size: 0.82rem; cursor: pointer; }

        @media (min-width: 431px) { .app-shell { border-left: 1px solid var(--glass-border); border-right: 1px solid var(--glass-border); margin: 0 auto; } }
    </style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="app-shell">
    <div class="status-bar"></div>
    
    <div class="header-nav">
        <a href="/study" class="back-circle"><i class="fas fa-arrow-left"></i></a>
        <div class="header-title"><%= session ? session.course_name : 'Study Session' %></div>
        <div style="width:42px"></div>
    </div>

    <div class="page-content">
        <div class="timer-section">
            <div class="timer-circle">
                <svg viewBox="0 0 160 160">
                    <circle class="bg-ring" cx="80" cy="80" r="70"></circle>
                    <circle class="progress-ring" id="progressRing" cx="80" cy="80" r="70"></circle>
                </svg>
                <div class="timer-text">
                    <div class="time" id="timerDisplay">00:00</div>
                    <div class="lbl" id="timerStateLabel">Ready</div>
                </div>
            </div>
            <div class="timer-controls">
                <button class="timer-btn start-btn" id="startBtn" onclick="toggleTimer()"><i class="fas fa-play"></i></button>
                <button class="timer-btn reset-btn" onclick="resetTimer()"><i class="fas fa-undo"></i></button>
            </div>
        </div>

        <div class="tab-bar">
            <button class="tab-pill active" onclick="switchTab('chat', this)"><i class="fas fa-robot"></i> AI Chat</button>
            <button class="tab-pill" onclick="switchTab('notes', this)"><i class="fas fa-pen"></i> Notes</button>
            <button class="tab-pill" onclick="switchTab('youtube', this)"><i class="fas fa-video"></i> Videos</button>
            <button class="tab-pill" onclick="switchTab('flashcards', this)"><i class="fas fa-layer-group"></i> Cards</button>
            <button class="tab-pill" onclick="switchTab('quiz', this)"><i class="fas fa-question-circle"></i> Quiz</button>
            <button class="tab-pill" onclick="switchTab('summary', this)"><i class="fas fa-list-check"></i> Summary</button>
        </div>

        <!-- AI Chat Tab -->
        <div class="tab-content active" id="tab-chat">
            <div class="chat-box">
                <div class="chat-messages" id="chatMessages">
                    <div class="chat-msg ai">
                        <div class="bubble">
                            <p style="margin:0 0 6px"><strong>Hi, I'm your AI tutor.</strong></p>
                            <p style="margin:0">Ask anything about <strong><%= session ? session.course_name : 'this course' %></strong> and I'll answer in plain text. Type your question below and hit send.</p>
                        </div>
                    </div>
                </div>
                <div class="chat-input-row">
                    <input type="text" id="chatInput" placeholder="Ask a question..." onkeydown="if(event.key==='Enter')sendChat()">
                    <button onclick="sendChat()"><i class="fas fa-paper-plane"></i></button>
                </div>
            </div>
        </div>

        <!-- Notes Tab -->
        <div class="tab-content" id="tab-notes">
            <textarea class="notes-area" id="notesArea" placeholder="Type your notes here..."></textarea>
            <div class="notes-actions">
                <button class="notes-save" onclick="saveNotes()"><i class="fas fa-save"></i> Save Notes</button>
                <button class="notes-load" onclick="loadNotes()"><i class="fas fa-folder-open"></i> Load Notes</button>
            </div>
        </div>

        <!-- YouTube Tab -->
        <div class="tab-content" id="tab-youtube">
            <div class="yt-search-row">
                <input type="text" id="ytSearchInput" placeholder="Search videos..." value="<%= session ? session.course_name : '' %>">
                <button onclick="searchYouTube()"><i class="fas fa-search"></i></button>
            </div>
            <div id="ytResults"></div>
        </div>

        <!-- Flashcards Tab -->
        <div class="tab-content" id="tab-flashcards">
            <div class="fc-nav">
                <button onclick="generateFlashcards()"><i class="fas fa-magic"></i> Generate</button>
                <button onclick="prevFlashcard()"><i class="fas fa-chevron-left"></i></button>
                <button onclick="nextFlashcard()"><i class="fas fa-chevron-right"></i></button>
            </div>
            <div id="fcContainer">
                <div style="text-align:center;padding:2rem;color:var(--text-muted);font-weight:600;font-size:0.8rem;">
                    <i class="fas fa-layer-group" style="font-size:2rem;display:block;margin-bottom:8px;color:#e2e8f0"></i>
                    Generate flashcards to study
                </div>
            </div>
        </div>

        <!-- Quiz Tab -->
        <div class="tab-content" id="tab-quiz">
            <div id="sessionQuizContainer" style="text-align:center;padding:1rem">
                <div style="background:white;border:1px solid var(--border);border-radius:var(--radius-sm);padding:2rem 1.5rem">
                    <i class="fas fa-question-circle" style="font-size:2.2rem;color:#e2e8f0;display:block;margin-bottom:10px"></i>
                    <h3 style="font-size:0.9rem;font-weight:800;margin:0 0 6px">Test yourself</h3>
                    <p style="font-size:0.75rem;color:var(--text-sub);font-weight:600;margin:0 0 14px">Generate a quiz for <strong><%= session ? session.course_name : 'this course' %></strong></p>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center">
                        <button onclick="sessionQuiz(5)" style="padding:10px 20px;border-radius:10px;border:1px solid var(--border);background:white;font-family:inherit;font-weight:700;font-size:0.78rem;cursor:pointer">5 Qs</button>
                        <button onclick="sessionQuiz(10)" style="padding:10px 20px;border-radius:10px;border:1px solid var(--border);background:white;font-family:inherit;font-weight:700;font-size:0.78rem;cursor:pointer">10 Qs</button>
                        <button onclick="sessionQuiz(15)" style="padding:10px 20px;border-radius:10px;border:1px solid var(--border);background:white;font-family:inherit;font-weight:700;font-size:0.78rem;cursor:pointer">15 Qs</button>
                        <button onclick="sessionQuiz(20)" style="padding:10px 20px;border-radius:10px;border:1px solid var(--border);background:white;font-family:inherit;font-weight:700;font-size:0.78rem;cursor:pointer">20 Qs</button>
                    </div>
                    <div style="margin-top:10px">
                        <select id="sq-type" style="padding:8px 12px;border-radius:8px;border:1px solid var(--border);font-family:inherit;font-weight:600;font-size:0.72rem">
                            <option value="mixed">Mixed</option>
                            <option value="multiple_choice">Multiple Choice</option>
                            <option value="theory">Theory</option>
                        </select>
                        <select id="sq-time" style="padding:8px 12px;border-radius:8px;border:1px solid var(--border);font-family:inherit;font-weight:600;font-size:0.72rem;margin-left:6px">
                            <option value="0">Untimed</option>
                            <option value="5">5 min</option>
                            <option value="10">10 min</option>
                            <option value="15">15 min</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Tab -->
        <div class="tab-content" id="tab-summary">
            <div style="background:white;border:1px solid var(--border);border-radius:var(--radius-sm);padding:1rem 1.2rem">
                <h3 style="font-size:0.85rem;font-weight:800;margin:0 0 10px;display:flex;align-items:center;gap:8px"><i class="fas fa-list-check" style="color:var(--brand)"></i> Session Summary</h3>
                <textarea id="summaryArea" placeholder="What did you learn? Write key takeaways here..." style="width:100%;min-height:160px;padding:11px;border:1.5px solid var(--border);border-radius:10px;font-family:inherit;font-size:0.82rem;font-weight:500;line-height:1.6;outline:none;resize:vertical"><%= session ? (session.notes || "").replace(/'/g, "\\'").replace(/\n/g, "\\n") : '' %></textarea>
                <div style="display:flex;gap:8px;margin-top:10px">
                    <button onclick="saveSummary()" style="flex:1;padding:11px;border:none;background:var(--brand-gradient);color:white;border-radius:10px;font-weight:700;font-size:0.78rem;cursor:pointer"><i class="fas fa-save"></i> Save Summary</button>
                    <button onclick="aiSessionSummary()" style="padding:11px 16px;border:none;background:#0f172a;color:white;border-radius:10px;font-weight:700;font-size:0.78rem;cursor:pointer"><i class="fas fa-magic"></i> AI Summarize</button>
                </div>
                <div id="summaryAIResult" style="display:none;margin-top:10px;padding:10px;background:#f1f5f9;border-radius:8px;font-size:0.82rem;line-height:1.55;color:#0f172a"></div>
            </div>
        </div>

        <div class="end-session-btn">
            <button onclick="endSession()"><i class="fas fa-stop-circle"></i> End Study Session</button>
        </div>
    </div>

    <div style="height:40px"></div>

    <%- include('partials/bottom-nav', { activeNav: 'study' }) %>
</div>

<script>
var sessionId = <%= session ? session.id : 0 %>;
var courseId = <%= session ? session.course_id : 0 %>;
var courseName = '<%= session ? session.course_name.replace(/'/g, "\\'") : '' %>';
var timerInterval = null;
var elapsedSeconds = <%= session ? session.elapsed_seconds : 0 %>;
var isRunning = false;
var flips = 0;

document.getElementById('notesArea').value = '<%= session ? (session.notes || "").replace(/'/g, "\\'").replace(/\n/g, "\\n") : '' %>';

function formatTime(secs) {
    var m = Math.floor(secs / 60);
    var s = secs % 60;
    return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
}

function updateTimerDisplay() {
    document.getElementById('timerDisplay').textContent = formatTime(elapsedSeconds);
    var circ = 440 - (elapsedSeconds % 3600) / 3600 * 440;
    document.getElementById('progressRing').style.strokeDashoffset = circ;
}

function toggleTimer() {
    var btn = document.getElementById('startBtn');
    if (isRunning) {
        clearInterval(timerInterval);
        isRunning = false;
        btn.innerHTML = '<i class="fas fa-play"></i>';
        document.getElementById('timerStateLabel').textContent = 'Paused';
    } else {
        isRunning = true;
        btn.innerHTML = '<i class="fas fa-pause"></i>';
        document.getElementById('timerStateLabel').textContent = 'Studying...';
        timerInterval = setInterval(function() {
            elapsedSeconds++;
            updateTimerDisplay();
        }, 1000);
    }
}

function resetTimer() {
    if (timerInterval) clearInterval(timerInterval);
    isRunning = false;
    elapsedSeconds = 0;
    updateTimerDisplay();
    document.getElementById('startBtn').innerHTML = '<i class="fas fa-play"></i>';
    document.getElementById('timerStateLabel').textContent = 'Ready';
}

function switchTab(tab, btn) {
    document.querySelectorAll('.tab-pill').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
    document.getElementById('tab-' + tab).classList.add('active');
}

var chatAbort = null;
function chatEscape(s) {
    return (s == null ? '' : String(s))
        .replace(/&/g, '&')
        .replace(/</g, '<')
        .replace(/>/g, '>')
        .replace(/"/g, '"')
        .replace(/'/g, ''');
}
function chatRender(text) {
    var raw = String(text || '');
    var paras = raw.split(/\n\s*\n/);
    return paras.map(function(p) {
        var t = p.replace(/\s*\n\s*/g, ' ').trim();
        if (!t) return '';
        return '<p style="margin:0 0 8px">' + chatEscape(t) + '</p>';
    }).join('');
}
function chatAppend(role, html) {
    var wrap = document.createElement('div');
    wrap.className = 'chat-msg ' + role;
    var bubble = document.createElement('div');
    bubble.className = 'bubble';
    bubble.innerHTML = html;
    wrap.appendChild(bubble);
    document.getElementById('chatMessages').appendChild(wrap);
    var box = document.getElementById('chatMessages');
    box.scrollTop = box.scrollHeight;
    return wrap;
}

function sendChat() {
    var input = document.getElementById('chatInput');
    var msg = input.value.trim();
    if (!msg) return;
    input.value = '';
    chatAppend('user', chatEscape(msg));
    var pending = chatAppend('ai', '<i class="fas fa-spinner fa-spin"></i> Thinking…');
    if (chatAbort) try { chatAbort.abort(); } catch(e){}
    chatAbort = ('AbortController' in window) ? new AbortController() : null;
    var fetchOpts = { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message: msg, courseId: courseId, courseName: courseName }) };
    if (chatAbort) fetchOpts.signal = chatAbort.signal;
    var clientTimer = setTimeout(function() { try { if (chatAbort) chatAbort.abort(); } catch(e){} }, 55000);
    fetch('/api/study/chat', fetchOpts)
    .then(function(r){ return r.json().catch(function(){ return { success:false, error:'Bad server response (' + r.status + ')' }; }); })
    .then(function(d) {
        pending.remove();
        if (d && d.success && d.reply) chatAppend('ai', chatRender(d.reply));
        else chatAppend('ai', '<p style="color:#dc2626;margin:0">' + chatEscape((d && d.error) ? ('AI error: ' + d.error) : 'Sorry, I could not process that. Please try again.') + '</p>');
    })
    .catch(function(err) {
        pending.remove();
        var msg2 = (err && err.name === 'AbortError') ? 'Request timed out. Tap send again to retry.' : ('AI error: ' + (err && err.message ? err.message : 'network error'));
        chatAppend('ai', '<p style="color:#dc2626;margin:0">' + chatEscape(msg2) + '</p>');
    })
    .finally(function() { clearTimeout(clientTimer); });
}

function escapeHtml(text) {
    return (text || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function saveNotes() {
    var notes = document.getElementById('notesArea').value;
    fetch('/api/study/sessions/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId: sessionId, elapsedSeconds: elapsedSeconds, notes: notes })
    }).then(r => r.json()).then(function(d) {
        if (d.success) Swal.fire({ icon: 'success', title: 'Saved!', timer: 1000, showConfirmButton: false });
        else Swal.fire({ icon: 'error', text: d.error });
    });
}

function loadNotes() {
document.getElementById('notesArea').value = '<%= session ? (session.notes || "").replace(/'/g, "\\'").replace(/\n/g, "\\n") : '' %>';

var sessionAlreadyPrompted = false;
if (!sessionAlreadyPrompted) {
  sessionAlreadyPrompted = true;
  Swal.fire({
    title: 'Start studying?',
    text: 'Do you want to start studying now?',
    icon: 'question',
    showCancelButton: true,
    confirmButtonText: 'Yes, start',
    cancelButtonText: 'Not yet',
    allowOutsideClick: false,
    allowEscapeKey: false
  }).then(function(res) {
    if (res.isConfirmed && !isRunning) toggleTimer();
  });
}

}

function searchYouTube() {
    var q = document.getElementById('ytSearchInput').value.trim() || courseName;
    Swal.fire({ title: 'Searching...', html: 'Looking for videos', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); } });
    fetch('/api/study/youtube/search', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query: q })
    }).then(r => r.json()).then(function(d) {
        var container = document.getElementById('ytResults');
        container.innerHTML = '';
        if (d.success && d.html) {
            container.innerHTML = d.html;
        } else if (d.terms && d.terms.length > 0) {
            d.terms.forEach(function(t) {
                container.innerHTML += '<div class="yt-video">' +
                    '<a href="https://www.youtube.com/results?search_query=' + encodeURIComponent(t) + '" target="_blank" style="display:block;background:#f1f5f9;padding:3rem 1rem;text-align:center;border-radius:8px;text-decoration:none;color:var(--brand);font-weight:700;font-size:0.9rem"><i class="fab fa-youtube" style="font-size:2rem;display:block;margin-bottom:8px"></i> Search YouTube for "' + escapeHtml(t) + '"</a>' +
                    '<div class="yt-info"><h4>' + escapeHtml(t) + '</h4></div></div>';
            });
        } else {
            container.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-muted);font-weight:600;">No videos found</div>';
        }
        Swal.close();
    });
}

var flashcards = [];
var fcIndex = 0;

function generateFlashcards() {
    Swal.fire({ title: 'Generating...', html: 'AI creating flashcards', allowOutsideClick: false, didOpen: function() { Swal.showLoading(); } });
    fetch('/api/study/flashcards/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ courseId: courseId, topicTitle: courseName })
    }).then(r => r.json()).then(function(d) {
        Swal.close();
        if (d.success && d.cards && d.cards.length > 0) {
            flashcards = d.cards;
            fcIndex = 0;
            renderFlashcard();
        } else {
            Swal.fire({ icon: 'error', text: d.error || 'Could not generate flashcards' });
        }
    });
}

var cardGradients = [
    ['#667eea', '#764ba2'], ['#f093fb', '#f5576c'], ['#4facfe', '#00f2fe'],
    ['#43e97b', '#38f9d7'], ['#fa709a', '#fee140'], ['#a18cd1', '#fbc2eb'],
    ['#fccb90', '#d57eeb'], ['#e0c3fc', '#8ec5fc'], ['#30cfd0', '#330867'],
    ['#ffecd2', '#fcb69f'], ['#89f7fe', '#66a6ff'], ['#f5576c', '#ff6f91']
];

function getCardColor(text) {
    var h = 0;
    for (var i = 0; i < (text || '').length; i++) { h = ((h << 5) - h) + text.charCodeAt(i); h |= 0; }
    return cardGradients[Math.abs(h) % cardGradients.length];
}

function cardSvg(c, cs) {
    var ch = (c.front || '?').charAt(0).toUpperCase();
    return '<svg width="100%" height="100" viewBox="0 0 300 100" style="border-radius:14px 14px 0 0;display:block">' +
        '<defs><linearGradient id="sg' + c.id + '" x1="0%" y1="0%" x2="100%" y2="100%">' +
        '<stop offset="0%" style="stop-color:' + cs[0] + '"/>' +
        '<stop offset="100%" style="stop-color:' + cs[1] + '"/></linearGradient></defs>' +
        '<rect width="300" height="100" rx="14" fill="url(#sg' + c.id + ')" opacity="0.12"/>' +
        '<circle cx="230" cy="25" r="35" fill="' + cs[0] + '" opacity="0.06"/>' +
        '<circle cx="60" cy="75" r="25" fill="' + cs[1] + '" opacity="0.06"/>' +
        '<text x="20" y="68" font-family="Plus Jakarta Sans,sans-serif" font-size="52" font-weight="800" fill="' + cs[0] + '" opacity="0.15">' + ch + '</text>' +
        '</svg>';
}

function renderFlashcard() {
    var container = document.getElementById('fcContainer');
    if (flashcards.length === 0) {
        container.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-muted);font-weight:600;">No flashcards</div>';
        return;
    }
    var fc = flashcards[fcIndex];
    var cs = getCardColor(fc.front);
    container.innerHTML = '<div class="fc-card" onclick="this.classList.toggle(\'flipped\')" style="padding:0;overflow:hidden">' +
        cardSvg(fc, cs) +
        '<div style="padding:14px 18px 18px">' +
        '<div class="fc-front" style="font-size:0.98rem;font-weight:700;line-height:1.5;color:var(--text-dark)">' + escapeHtml(fc.front || '(empty)') + '</div>' +
        '<div class="fc-back" style="font-size:0.9rem;font-weight:600;color:var(--text-sub);line-height:1.5">' + escapeHtml(fc.back || '(empty)') + '</div>' +
        '</div>' +
        '<div class="tap-hint" style="padding:0 18px 12px;font-size:0.6rem;color:var(--text-muted);font-weight:600">' + (fcIndex + 1) + '/' + flashcards.length + ' - Tap to flip</div></div>';
}

function nextFlashcard() {
    if (flashcards.length === 0) return;
    fcIndex = (fcIndex + 1) % flashcards.length;
    renderFlashcard();
}

function prevFlashcard() {
    if (flashcards.length === 0) return;
    fcIndex = (fcIndex - 1 + flashcards.length) % flashcards.length;
    renderFlashcard();
}

function sessionQuiz(count) {
    var type = document.getElementById('sq-type') ? document.getElementById('sq-type').value : 'mixed';
    var time = document.getElementById('sq-time') ? parseInt(document.getElementById('sq-time').value) : 0;
    var container = document.getElementById('sessionQuizContainer');
    container.innerHTML = '<div style="text-align:center;padding:2rem"><i class="fas fa-spinner fa-spin" style="font-size:2rem;color:var(--brand)"></i><p style="font-size:0.82rem;font-weight:600;color:var(--text-sub);margin-top:10px">Generating ' + count + ' questions...</p></div>';
    fetch('/api/study/quiz/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ courseId: courseId, topicTitle: courseName, questionType: type, questionCount: count, timeLimit: time })
    }).then(function(r){ return r.json(); }).then(function(d) {
        if (d && d.success && d.attempt) {
            window.location.href = '/study/quiz/' + d.attempt.id;
        } else {
            container.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-sub)">' +
                '<i class="fas fa-exclamation-triangle" style="font-size:2rem;color:var(--danger);display:block;margin-bottom:10px"></i>' +
                '<p style="font-size:0.82rem;font-weight:600">' + ((d && d.error) ? d.error : 'Could not generate quiz') + '</p>' +
                '<button onclick="location.reload()" style="padding:10px 20px;border-radius:10px;border:none;background:var(--brand-gradient);color:white;font-weight:700;cursor:pointer">Try Again</button></div>';
        }
    }).catch(function(err) {
        container.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-sub)"><p style="font-size:0.82rem;font-weight:600;color:var(--danger)">Network error</p><button onclick="location.reload()" style="padding:10px 20px;border-radius:10px;border:none;background:var(--brand-gradient);color:white;font-weight:700;cursor:pointer">Retry</button></div>';
    });
}

function saveSummary() {
    var summary = document.getElementById('summaryArea').value;
    var notes = document.getElementById('notesArea').value;
    var merged = (notes || '') + (summary ? (notes ? '\n\n--- Summary ---\n' + summary : summary) : '');
    fetch('/api/study/sessions/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId: sessionId, elapsedSeconds: elapsedSeconds, notes: merged })
    }).then(function(r){ return r.json(); }).then(function(d) {
        if (d && d.success) Swal.fire({ icon: 'success', title: 'Saved!', timer: 1000, showConfirmButton: false });
        else Swal.fire({ icon: 'error', text: (d && d.error) ? d.error : 'Could not save' });
    });
}

function aiSessionSummary() {
    var notes = document.getElementById('notesArea').value;
    if (!notes || !notes.trim()) return Swal.fire({ icon: 'warning', text: 'Write some notes first before summarizing.' });
    var box = document.getElementById('summaryAIResult');
    box.style.display = 'block';
    box.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Analyzing notes...';
    fetch('/api/study/session/summarize', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ notes: notes, courseName: courseName })
    }).then(function(r){ return r.json().catch(function(){ return { success:false, error:'Bad response' }; }); })
    .then(function(d) {
        if (d && d.success && d.summary) {
            box.innerHTML = '<div style="white-space:pre-wrap">' + (d.summary || '').replace(/&/g,'&').replace(/</g,'<').replace(/>/g,'>') + '</div>';
            var ta = document.getElementById('summaryArea');
            if (ta) ta.value = (ta.value ? ta.value + '\n' : '') + d.summary;
        } else {
            box.innerHTML = '<span style="color:#dc2626">' + ((d && d.error) ? d.error : 'Could not summarize.') + '</span>';
        }
    }).catch(function(err) {
        box.innerHTML = '<span style="color:#dc2626">' + err.message + '</span>';
    });
}

function endSession() {
    var notes = document.getElementById('notesArea').value;
    var mins = Math.max(1, Math.ceil(elapsedSeconds / 60));
    Swal.fire({
        title: 'Session Summary',
        html:
            '<div style="text-align:left;font-size:0.85rem">' +
            '<div style="display:flex;justify-content:space-between;padding:10px 12px;background:#f1f5f9;border-radius:10px;margin-bottom:12px">' +
            '<span style="color:#475569;font-weight:600">Time studied</span>' +
            '<strong style="color:#0f172a">' + mins + ' min</strong></div>' +
            '<div style="font-size:0.78rem;color:#475569;font-weight:700;margin-bottom:6px">Key points to remember</div>' +
            '<textarea id="summaryPoints" placeholder="e.g.&#10;- Definition of Newton&apos;s laws&#10;- Application of derivatives in physics&#10;- Solve 2 practice problems" style="width:100%;min-height:120px;padding:10px;border-radius:10px;border:1.5px solid #cbd5e1;font-family:inherit;font-size:0.85rem;font-weight:500;line-height:1.5;outline:none;resize:vertical"></textarea>' +
            '<div style="display:flex;gap:6px;margin-top:8px">' +
            '<button type="button" id="aiSummarize" style="flex:1;padding:9px 12px;border:none;background:#0f172a;color:white;border-radius:10px;font-weight:700;font-size:0.78rem;cursor:pointer"><i class="fas fa-magic"></i> Auto-extract from notes</button>' +
            '<button type="button" id="aiTipsClose" style="flex:1;padding:9px 12px;border:none;background:#fde68a;color:#92400e;border-radius:10px;font-weight:700;font-size:0.78rem;cursor:pointer"><i class="fas fa-lightbulb"></i> Add motivation</button>' +
            '</div>' +
            '<div id="aiExtracted" style="display:none;margin-top:10px;padding:8px 10px;background:#f1f5f9;border-radius:8px;font-size:0.75rem;color:#475569"></div>' +
            '</div>',
        showCancelButton: true,
        confirmButtonText: 'Save & Exit',
        cancelButtonText: 'Continue Studying',
        showLoaderOnConfirm: true,
        didOpen: function() {
            if (notes && notes.length > 20) {
                var box = document.getElementById('aiExtracted');
                box.style.display = 'block';
                box.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Extracting key points from your notes…';
            }
            document.getElementById('aiSummarize').onclick = function() {
                if (!notes || !notes.trim()) return Swal.fire({ icon: 'warning', text: 'No notes to extract from yet.' });
                var box = document.getElementById('aiExtracted');
                box.style.display = 'block';
                box.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Asking AI to summarize your notes…';
                fetch('/api/study/session/summarize', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ notes: notes, courseName: courseName })
                }).then(function(r){ return r.json().catch(function(){ return { success:false,error:'Bad response' }; }); })
                .then(function(d) {
                    if (d && d.success && d.summary) {
                        var ta = document.getElementById('summaryPoints');
                        ta.value = d.summary;
                        box.innerHTML = '<i class="fas fa-check-circle" style="color:#16a34a"></i> Extracted from your notes.';
                    } else {
                        box.innerHTML = '<i class="fas fa-exclamation-triangle" style="color:#dc2626"></i> ' + ((d && d.error) ? d.error : 'Could not summarize.');
                    }
                }).catch(function(err) {
                    box.innerHTML = '<i class="fas fa-exclamation-triangle" style="color:#dc2626"></i> ' + err.message;
                });
            };
            document.getElementById('aiTipsClose').onclick = function() {
                var ta = document.getElementById('summaryPoints');
                ta.value = (ta.value ? ta.value + '\n' : '') + '- Keep up the momentum — 25 mins tomorrow too.\n- Review key formulas once today.';
                Swal.fire({ icon: 'success', text: 'Added a quick motivation note.', timer: 1200, showConfirmButton: false });
            };
        },
        preConfirm: function() {
            var summary = document.getElementById('summaryPoints').value || '';
            if (timerInterval) clearInterval(timerInterval);
            return fetch('/api/study/sessions/end', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId: sessionId, elapsedSeconds: elapsedSeconds, notes: notes, summary: summary })
            }).then(function(r){ return r.json(); }).then(function(d) {
                if (d && d.success) return d;
                throw new Error((d && d.error) ? d.error : 'Could not save session');
            });
        }
    }).then(function(res) {
        if (res && res.isConfirmed) window.location.href = '/study';
    }).catch(function(err) {
        Swal.fire({ icon: 'error', title: 'Save error', text: err.message });
    });
}
</script>
</body>
</html>
