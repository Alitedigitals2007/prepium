<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <style>
        body { padding-bottom: 120px; overflow-x: hidden; }

        /* Header & Progress */
        .quiz-header { position: sticky; top: 0; background: var(--surface-solid); z-index: 1000; border-bottom: 1px solid var(--border); padding: 12px 16px; box-shadow: var(--shadow-sm); }
        .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        #timer { font-weight: 800; color: var(--brand); background: var(--brand-soft); padding: 6px 14px; border-radius: 10px; border: 1px solid var(--brand-soft); font-variant-numeric: tabular-nums; }
        
        /* Question Palette */
        .palette-container { background: var(--bg); border-radius: 16px; margin-top: 10px; border: 1px solid var(--border-solid); padding: 12px; }
        .palette-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(35px, 1fr)); gap: 6px; max-height: 100px; overflow-y: auto; }
        .q-num { aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; border-radius: 8px; border: 1.5px solid var(--border-solid); font-size: 0.75rem; font-weight: 800; background: var(--surface-solid); cursor: pointer; transition: 0.2s; }
        .q-num.answered { background: var(--success); color: white; border-color: var(--success); }
        .q-num.current { border: 2.5px solid var(--brand); color: var(--brand); background: var(--brand-soft); }

        /* Question Card */
        .question-card { margin: 20px 15px; background: var(--surface-solid); padding: 28px; border-radius: 24px; box-shadow: var(--shadow-md); border: 1px solid var(--border); }
        #subject-label { font-size: 0.7rem; font-weight: 800; color: var(--brand); text-transform: uppercase; margin-bottom: 12px; display: inline-block; background: var(--brand-soft); padding: 4px 10px; border-radius: 6px; }
        #q-text { font-size: 1.15rem; font-weight: 700; line-height: 1.6; margin-bottom: 24px; color: var(--text-primary); }

        /* Options */
        .option-btn { width: 100%; padding: 18px; margin-bottom: 12px; border-radius: 16px; border: 2px solid var(--border); background: var(--surface-solid); text-align: left; font-family: inherit; font-weight: 700; cursor: pointer; transition: 0.2s; display: flex; align-items: center; }
        .option-btn:hover { border-color: var(--brand); background: var(--bg); }
        .option-btn.selected { background: var(--brand); color: white; border-color: var(--brand); box-shadow: var(--shadow-lg); }
        .opt-label { opacity: 0.5; margin-right: 15px; font-weight: 800; font-size: 0.85rem; }
        
        /* Footer Navigation */
        .quiz-footer { position: fixed; bottom: 0; left: 0; right: 0; background: var(--surface-solid); padding: 16px 20px; display: flex; gap: 10px; border-top: 1px solid var(--border); z-index: 1000; }
        .nav-btn { flex: 1; padding: 14px; border-radius: 16px; border: none; font-weight: 800; cursor: pointer; font-family: inherit; transition: 0.2s; }
        .nav-btn:active { transform: scale(0.98); }
        .submit-trigger { background: var(--danger) !important; color: white !important; flex: 0.4; }

        /* Scientific Calculator Overlay */
        #calc-container { position: fixed; bottom: 90px; right: 20px; z-index: 2000; display: flex; flex-direction: column; align-items: flex-end; }
        #calc-toggle { width: 56px; height: 56px; border-radius: 18px; background: var(--text); color: white; border: none; box-shadow: 0 8px 24px rgba(0,0,0,0.2); cursor: pointer; font-size: 1.4rem; display: flex; align-items: center; justify-content: center; }
        #calc-box { width: 300px; background: var(--surface-solid); border-radius: 28px; box-shadow: var(--shadow-xl); border: 1px solid var(--border-solid); padding: 15px; margin-bottom: 15px; display: none; transform-origin: bottom right; animation: popUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
        @keyframes popUp { from { opacity: 0; transform: scale(0.5); } to { opacity: 1; transform: scale(1); } }
        .calc-screen { width: 100%; background: var(--bg); border: 2px solid var(--border); padding: 12px; border-radius: 15px; text-align: right; font-size: 1.4rem; font-weight: 800; color: var(--text-primary); margin-bottom: 10px; outline: none; }
        .calc-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
        .c-btn { padding: 12px 2px; border: none; border-radius: 10px; background: var(--bg); font-weight: 800; cursor: pointer; font-size: 0.85rem; }
        .c-btn.op { color: var(--brand); background: var(--brand-soft); }
        .c-btn.eq { background: var(--brand); color: white; }
    </style>
    <%- include('partials/theme-toggle') %>
</head>
<body>

    <textarea id="raw-questions" style="display: none;"><%= JSON.stringify(quiz.questions) %></textarea>

    <div class="quiz-header">
        <div class="top-bar">
            <span id="progress-text" style="font-weight: 800; font-size: 0.9rem; color: var(--text-secondary);">Loading...</span>
            <div id="timer">00:00</div>
        </div>
        <div class="palette-container">
            <div class="palette-grid" id="palette"></div>
        </div>
    </div>

    <div class="question-card">
        <div id="subject-label">SUBJECT</div>
        <div id="q-text">Select an option to begin.</div>
        <div id="options-container"></div>
    </div>

    <div id="calc-container">
        <div id="calc-box">
            <div style="font-size: 0.6rem; font-weight: 800; color: var(--text-muted); margin-bottom: 8px; display: flex; justify-content: space-between;">
                <span id="unit-indicator" style="color: var(--brand)">DEG</span>
                <span>SCIENTIFIC</span>
            </div>
            <input type="text" id="display" class="calc-screen" readonly value="0">
            <div class="calc-grid">
                <button class="c-btn" onclick="toggleUnit()">DRG</button>
                <button class="c-btn" onclick="sciFunc('sqrt')">âˆš</button>
                <button class="c-btn" onclick="trig('sin')">sin</button>
                <button class="c-btn" style="color:var(--danger)" onclick="clearCalc()">AC</button>
                
                <button class="c-btn" onclick="press('7')">7</button>
                <button class="c-btn" onclick="press('8')">8</button>
                <button class="c-btn" onclick="press('9')">9</button>
                <button class="c-btn op" onclick="press('/')">Ã·</button>
                
                <button class="c-btn" onclick="press('4')">4</button>
                <button class="c-btn" onclick="press('5')">5</button>
                <button class="c-btn" onclick="press('6')">6</button>
                <button class="c-btn op" onclick="press('*')">Ã—</button>
                
                <button class="c-btn" onclick="press('1')">1</button>
                <button class="c-btn" onclick="press('2')">2</button>
                <button class="c-btn" onclick="press('3')">3</button>
                <button class="c-btn op" onclick="press('-')">-</button>
                
                <button class="c-btn" onclick="press('0')">0</button>
                <button class="c-btn" onclick="press('.')">.</button>
                <button class="c-btn" onclick="backspace()">âŒ«</button>
                <button class="c-btn op" onclick="press('+')">+</button>
                
                <button class="c-btn eq" style="grid-column: span 4;" onclick="solve()">=</button>
            </div>
        </div>
        <button id="calc-toggle" onclick="toggleCalc()">ðŸ–©</button>
    </div>

    <form id="submit-form" action="/submit-exam" method="POST" style="display: none;">
        <input type="hidden" name="answers" id="answers-input">
        <input type="hidden" name="timeUsed" id="time-used-input">
    </form>

    <div class="quiz-footer">
        <button class="nav-btn" style="background: var(--bg); color: var(--text-primary);" onclick="changeQuestion(-1)">Back</button>
        <button class="nav-btn submit-trigger" onclick="triggerSubmit()">Submit</button>
        <button class="nav-btn" id="next-btn" style="background: var(--brand); color: white;" onclick="changeQuestion(1)">Next</button>
    </div>

    <script>
        let questions = [];
        try {
            questions = JSON.parse(document.getElementById('raw-questions').value);
        } catch (e) { console.error("Data Load Error"); }

        let currentIndex = 0;
        let userAnswers = new Array(questions.length).fill(null);
        let startTime = Date.now();
        let currentUnit = 'deg';

        /* --- EXAM RENDERING --- */
        async function renderQuestion() {
            const q = questions[currentIndex];
            if (!q) return;

            document.getElementById('progress-text').innerText = `Question ${currentIndex + 1} of ${questions.length}`;
            document.getElementById('subject-label').innerText = q.subject_name || "Examination";
            document.getElementById('q-text').innerHTML = q.question_text || q.question;
            
            const opts = ['a', 'b', 'c', 'd'];
            let html = '';
            opts.forEach(o => {
                const isSelected = userAnswers[currentIndex] === o ? 'selected' : '';
                html += `
                    <button class="option-btn ${isSelected}" onclick="selectOption('${o}')">
                        <span class="opt-label">${o.toUpperCase()}</span>
                        <span>${q['option_' + o]}</span>
                    </button>`;
            });
            
            document.getElementById('options-container').innerHTML = html;
            
            // Handle Next vs Finish text
            const nextBtn = document.getElementById('next-btn');
            if (currentIndex === questions.length - 1) {
                nextBtn.innerText = "Finish";
                nextBtn.style.background = "var(--success)";
            } else {
                nextBtn.innerText = "Next";
                nextBtn.style.background = "var(--brand)";
            }

            updatePalette();
            if (window.MathJax) MathJax.typesetPromise();
        }

        function selectOption(val) {
            userAnswers[currentIndex] = val;
            renderQuestion();
        }

        function changeQuestion(dir) {
            let next = currentIndex + dir;
            if (next >= 0 && next < questions.length) {
                currentIndex = next;
                renderQuestion();
                window.scrollTo(0, 0);
            } else if (next === questions.length) {
                triggerSubmit();
            }
        }

        function jumpTo(i) {
            currentIndex = i;
            renderQuestion();
            window.scrollTo(0, 0);
        }

        function updatePalette() {
            document.getElementById('palette').innerHTML = questions.map((_, i) => {
                let cls = 'q-num' + (userAnswers[i] ? ' answered' : '') + (i === currentIndex ? ' current' : '');
                return `<div class="${cls}" onclick="jumpTo(${i})">${i + 1}</div>`;
            }).join('');
        }

        /* --- SUBMISSION --- */
        function triggerSubmit() {
            if (confirm("Submit your answers and see your results?")) {
                const now = Date.now();
                const totalSeconds = Math.floor((now - startTime) / 1000);
                const m = Math.floor(totalSeconds / 60);
                const s = totalSeconds % 60;
                
                document.getElementById('time-used-input').value = `${m}:${s < 10 ? '0' + s : s}`;
                document.getElementById('answers-input').value = JSON.stringify(userAnswers);
                
                // Disable UI
                document.querySelector('.submit-trigger').innerText = "Processing...";
                document.querySelectorAll('button').forEach(b => b.disabled = true);
                
                document.getElementById('submit-form').submit();
            }
        }

        /* --- TIMER --- */
        function startTimer() {
            const endTime = <%= quiz.endTime.getTime() %>;
            if (!endTime) return;
            
            const timerEl = document.getElementById('timer');

            const timerInt = setInterval(() => {
                const diff = endTime - Date.now();
                
                if (diff <= 0) {
                    clearInterval(timerInt);
                    alert("Time is up! Your answers are being submitted.");
                    triggerSubmit();
                    return;
                }

                const m = Math.floor(diff / 60000);
                const s = Math.floor((diff % 60000) / 1000);
                timerEl.innerText = `${m}:${s < 10 ? '0' + s : s}`;
                
                if (m < 5) timerEl.style.color = "var(--danger)";
            }, 1000);
        }

        /* --- CALCULATOR LOGIC --- */
        function toggleCalc() {
            const box = document.getElementById('calc-box');
            box.style.display = (box.style.display === 'block') ? 'none' : 'block';
        }
        function toggleUnit() {
            currentUnit = currentUnit === 'deg' ? 'rad' : 'deg';
            document.getElementById('unit-indicator').innerText = currentUnit.toUpperCase();
        }
        function press(v) {
            const d = document.getElementById('display');
            if(d.value === "0" || d.value === "Error") d.value = v; else d.value += v;
        }
        function clearCalc() { document.getElementById('display').value = "0"; }
        function backspace() {
            const d = document.getElementById('display');
            d.value = d.value.length > 1 ? d.value.slice(0, -1) : "0";
        }
        function solve() {
            const d = document.getElementById('display');
            try {
                let formula = d.value.replace(/Ã—/g, '*').replace(/Ã·/g, '/');
                let res = eval(formula);
                d.value = Number.isInteger(res) ? res : parseFloat(res.toFixed(6));
            } catch(e) { d.value = "Error"; }
        }
        function sciFunc(type) {
            const d = document.getElementById('display');
            try {
                if(type === 'sqrt') d.value = Math.sqrt(eval(d.value)).toFixed(4);
            } catch(e) { d.value = "Error"; }
        }
        function trig(f) {
            const d = document.getElementById('display');
            try {
                let val = eval(d.value);
                if(currentUnit === 'deg') val = val * (Math.PI/180);
                d.value = Math[f](val).toFixed(6);
            } catch(e) { d.value = "Error"; }
        }

        window.onload = () => { renderQuestion(); startTimer(); };
        

        setInterval(async () => {
        try {
            await fetch('/api/heartbeat');
            console.log('Session connection refreshed successfully.');
        } catch (err) {
            console.error('Heartbeat ping failed:', err);
        }
    }, 300000)
    </script>
    <script src="/js/animations.js"></script>
</body>
</html>